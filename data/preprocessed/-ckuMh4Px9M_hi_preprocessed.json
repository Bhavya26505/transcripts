      "subtitle_ids": [
        176
      ],
      "start": 396.44,
      "end": 400.4,
      "text": "बीच रिटेल पार्टिसिपेशन काफी बढ़ गया है"
    },
    {
      "subtitle_ids": [
        177
      ],
      "start": 398.68,
      "end": 402.599,
      "text": "अब ये तो बात हो गई म्यूचुअल फंड्स और"
    },
    {
      "subtitle_ids": [
        178
      ],
      "start": 400.4,
      "end": 404.4,
      "text": "शेयर मार्केट की अब यहां पर हम एक क्लियर"
    },
    {
      "subtitle_ids": [
        179
      ],
      "start": 402.599,
      "end": 406.479,
      "text": "पिक्चर देखें तो वो यह है कि जो डिपॉजिट्स"
    },
    {
      "subtitle_ids": [
        180
      ],
      "start": 404.4,
      "end": 409.199,
      "text": "है बैंक में आने वाले उसकी ग्रोथ हो रही"
    },
    {
      "subtitle_ids": [
        181
      ],
      "start": 406.479,
      "end": 411.28,
      "text": "है लगभग 11 पर से और जो लोन बैंक्स दे रही"
    },
    {
      "subtitle_ids": [
        182
      ],
      "start": 409.199,
      "end": 413.8,
      "text": "है उसकी ग्रोथ काफी फास्ट है वो है"
    },
    {
      "subtitle_ids": [
        183
      ],
      "start": 411.28,
      "end": 415.4,
      "text": "177.5 तो पिक्चर बड़ी क्लियर है कासा घट"
    },
    {
      "subtitle_ids": [
        184
      ],
      "start": 413.8,
      "end": 417.44,
      "text": "रहा है और वह पूरा पैसा लोग लगा रहे हैं"
    },
    {
      "subtitle_ids": [
        185
      ],
      "start": 415.4,
      "end": 419.16,
      "text": "म्यूचुअल फंड में और शेयर मार्केट में और"
    },
    {
      "subtitle_ids": [
        186
      ],
      "start": 417.44,
      "end": 420.919,
      "text": "वही दूसरी तरफ ज्यादा से ज्यादा लोग लोन"
    },
    {
      "subtitle_ids": [
        187
      ],
      "start": 419.16,
      "end": 422.72,
      "text": "भी ले रहे हैं तो यह बैंक्स के लिए"
    },
    {
      "subtitle_ids": [
        188
      ],
      "start": 420.919,
      "end": 424.68,
      "text": "स्ट्रेस वाली बात है आरबीआई के लिए भी और"
    },
    {
      "subtitle_ids": [
        189
      ],
      "start": 422.72,
      "end": 426.16,
      "text": "गवर्नमेंट के लिए भी इसके चलते कई सारे"
    },
    {
      "subtitle_ids": [
        190
      ],
      "start": 424.68,
      "end": 428.199,
      "text": "लोगों के दिमाग में एक डाउट आ रहा है कि"
    },
    {
      "subtitle_ids": [
        191
      ],
      "start": 426.16,
      "end": 429.68,
      "text": "क्या इसी के चलते सरकार ने लॉन्ग टर्म और"
    },
    {
      "subtitle_ids": [
        192
      ],
      "start": 428.199,
      "end": 431.479,
      "text": "शॉर्ट टर्म कैपिटल गेन टैक्स तो नहीं"
    },
    {
      "subtitle_ids": [
        193
      ],
      "start": 429.68,
      "end": 433.199,
      "text": "बढ़ाया और साथ ही शेयर बाय बैक पर टैक्स"
    },
    {
      "subtitle_ids": [
        194
      ],
      "start": 431.479,
      "end": 434.879,
      "text": "तो नहीं लगाया ताकि ज्यादा से ज्यादा लोग"
    },
    {
      "subtitle_ids": [
        195
      ],
      "start": 433.199,
      "end": 436.879,
      "text": "शेयर मार्केट और म्यूचुअल फंड के बजाय"
    },
    {
      "subtitle_ids": [
        196
      ],
      "start": 434.879,
      "end": 439.08,
      "text": "बैंक में पैसा रखें इसमें आपका क्या विचार"
    },
    {
      "subtitle_ids": [
        197
      ],
      "start": 436.879,
      "end": 440.84,
      "text": "है कमेंट करके जरूर बताइए इसी प्रॉब्लम को"
    },
    {
      "subtitle_ids": [
        198
      ],
      "start": 439.08,
      "end": 442.52,
      "text": "टैकल करने के लिए फिर बैंक्स ने एक आईडिया"
    },
    {
      "subtitle_ids": [
        199
      ],
      "start": 440.84,
      "end": 444.84,
      "text": "लगाई कि क्यों ना जरो अकाउंट बैलेंस"
    },
    {
      "subtitle_ids": [
        200
      ],
      "start": 442.52,
      "end": 446.68,
      "text": "अकाउंट खोले जाए लेकिन इस चीज से बैंक्स"
    },
    {
      "subtitle_ids": [
        201
      ],
      "start": 444.84,
      "end": 448.879,
      "text": "को जितना फायदा हो सकता था उससे ज्यादा"
    },
    {
      "subtitle_ids": [
        202
      ],
      "start": 446.68,
      "end": 450.4,
      "text": "नुकसान ही हो रहा है क्योंकि ज्यादातर लोग"
    },
    {
      "subtitle_ids": [
        203
      ],
      "start": 448.879,
      "end": 452.319,
      "text": "अब इसी टाइप के अकाउंट खुलवा रहे हैं"
    },
    {
      "subtitle_ids": [
        204
      ],
      "start": 450.4,
      "end": 454.879,
      "text": "जिससे बैंक से एक अच्छा खासा इनकम सोर्स"
    },
    {
      "subtitle_ids": [
        205
      ],
      "start": 452.319,
      "end": 456.759,
      "text": "बंद हो सकता है कैसे जानते हैं अब देखिए"
    },
    {
      "subtitle_ids": [
        206
      ],
      "start": 454.879,
      "end": 460.0,
      "text": "बैंक का इंडिया में एक अलग ही इनकम सोर्स"
    },
    {
      "subtitle_ids": [
        207
      ],
      "start": 456.759,
      "end": 461.879,
      "text": "है उसका नाम है मिनिमम मेंटेनेंस बैलेंस"
    },
    {
      "subtitle_ids": [
        208
      ],
      "start": 460.0,
      "end": 463.759,
      "text": "चार्ज और यह कोई छोटा-मोटा इनकम सोर्स"
    },
    {
      "subtitle_ids": [
        209
      ],
      "start": 461.879,
      "end": 468.56,
      "text": "नहीं है स्क्रीन पर आप देखिए कि सिर्फ"
    },
    {
      "subtitle_ids": [
        210
      ],
      "start": 463.759,
      "end": 470.599,
      "text": "2024 में 11 सरकारी बैंक्स ने 22331 करोड़"
    },
    {
      "subtitle_ids": [
        211
      ],
      "start": 468.56,
      "end": 474.159,
      "text": "कमाए हैं सिर्फ मिनिमम बैलेंस अकाउंट"
    },
    {
      "subtitle_ids": [
        212
      ],
      "start": 470.599,
      "end": 477.68,
      "text": "चार्जेस से और पीएनबी ने अकेले 633 करोड़"
    },
    {
      "subtitle_ids": [
        213
      ],
      "start": 474.159,
      "end": 477.68,
      "text": "सोर्स से कमाए हैं जितना तो"
    },
    {
      "subtitle_ids": [
        214
      ],
      "start": 479.639,
      "end": 483.919,
      "text": "के लीडर ने भी रिसेंटली ये सवाल रेज किया"
    },
    {
      "subtitle_ids": [
        215
      ],
      "start": 481.68,
      "end": 485.96,
      "text": "था मिनिमम अकाउंट बैलेंस का जिसके चलते"
    },
    {
      "subtitle_ids": [
        216
      ],
      "start": 483.919,
      "end": 488.039,
      "text": "एसबीआई ने मिनिमम बैलेंस पेनल्टी को बंद"
    },
    {
      "subtitle_ids": [
        217
      ],
      "start": 485.96,
      "end": 490.4,
      "text": "कर दिया है तो अब बस ये टाइम की बात है कि"
    },
    {
      "subtitle_ids": [
        218
      ],
      "start": 488.039,
      "end": 492.159,
      "text": "कब बैंक का ये इनकम सोर्स बंद हो जाएगा"
    },
    {
      "subtitle_ids": [
        219
      ],
      "start": 490.4,
      "end": 493.919,
      "text": "क्योंकि यह कोई रिलायबल इनकम सोर्स नहीं"
    },
    {
      "subtitle_ids": [
        220
      ],
      "start": 492.159,
      "end": 495.879,
      "text": "है और इन सारी चीजों का मतलब यह नहीं है"
    },
    {
      "subtitle_ids": [
        221
      ],
      "start": 493.919,
      "end": 497.759,
      "text": "कि बैंक्स बंद हो जाएगी फर्क बस इतना है"
    },
    {
      "subtitle_ids": [
        222
      ],
      "start": 495.879,
      "end": 500.4,
      "text": "कि जो ट्रेडिशनल तरीका उनका अभी तक चल रहा"
    },
    {
      "subtitle_ids": [
        223
      ],
      "start": 497.759,
      "end": 502.08,
      "text": "था वो उन्हें बदलना पड़ेगा क्योंकि अगर वह"
    },
    {
      "subtitle_ids": [
        224
      ],
      "start": 500.4,
      "end": 504.4,
      "text": "आगे इसी मॉडल को फॉलो करेंगे तो"
    },
    {
      "subtitle_ids": [
        225
      ],
      "start": 502.08,
      "end": 505.919,
      "text": "प्रॉब्लम्स आने वाली है अब इसमें विनर वही"
    },
    {
      "subtitle_ids": [
        226
      ],
      "start": 504.4,
      "end": 508.08,
      "text": "रहेगा जिसके पास बैंक का अच्छा आईटी"
    },
    {
      "subtitle_ids": [
        227
      ],
      "start": 505.919,
      "end": 510.039,
      "text": "इंफ्रास्ट्रक्चर हो फिजिकल ब्रांचेस से"
    },
    {
      "subtitle_ids": [
        228
      ],
      "start": 508.08,
      "end": 511.479,
      "text": "ज्यादा फोकस डिजिटल सुविधा परर हो तो"
    },
    {
      "subtitle_ids": [
        229
      ],
      "start": 510.039,
      "end": 513.24,
      "text": "रिसेंट टाइम में अगर देखें तो बैंक्स"
    },
    {
      "subtitle_ids": [
        230
      ],
      "start": 511.479,
      "end": 515.68,
      "text": "इसीलिए डिजिटल चीजों पर ज्यादा फोकस कर"
    },
    {
      "subtitle_ids": [
        231
      ],
      "start": 513.24,
      "end": 517.36,
      "text": "रही है आईसीआई बैंक हो या फिर फेडरल बैंक"
    },
    {
      "subtitle_ids": [
        232
      ],
      "start": 515.68,
      "end": 520.479,
      "text": "हो इन्होंने कई सारी न्यू बैंक्स के साथ"
    },
    {
      "subtitle_ids": [
        233
      ],
      "start": 517.36,
      "end": 522.719,
      "text": "टाइ अप किया है जैसे कि जुपिटर हो फड मनी"
    },
    {
      "subtitle_ids": [
        234
      ],
      "start": 520.479,
      "end": 522.719,
      "text": "हो"
    },
    {
      "subtitle_ids": [
        235
      ],
      "start": 539.399,
      "end": 543.279,
      "text": "गेंगे लंच तक लंच के बाद में वापस लाइन"
    },
    {
      "subtitle_ids": [
        236
      ],
      "start": 541.6,
      "end": 545.0,
      "text": "में लगेंगे और फिर अपनी बैंक्स की जो"
    },
    {
      "subtitle_ids": [
        237
      ],
      "start": 543.279,
      "end": 546.959,
      "text": "प्रक्रिया है वो पूरी करेंगे आज की जो"
    },
    {
      "subtitle_ids": [
        238
      ],
      "start": 545.0,
      "end": 549.36,
      "text": "जनरेशन है उसमें उतना पेशेंस नहीं है दे"
    },
    {
      "subtitle_ids": [
        239
      ],
      "start": 546.959,
      "end": 551.2,
      "text": "वांट एवरीथिंग डिजिटल तो जो बैंक्स जल्दी"
    },
    {
      "subtitle_ids": [
        240
      ],
      "start": 549.36,
      "end": 553.88,
      "text": "इन चीजों को अडॉप्ट करेगी उसे बेनिफिट"
    },
    {
      "subtitle_ids": [
        241
      ],
      "start": 551.2,
      "end": 555.88,
      "text": "मिलेगा प्लस बैंक्स को अल्टरनेट वेज ऑफ"
    },
    {
      "subtitle_ids": [
        242
      ],
      "start": 553.88,
      "end": 558.16,
      "text": "फंडिंग निकालने पड़ेंगे क्योंकि एक तरफ"
    },
    {
      "subtitle_ids": [
        243
      ],
      "start": 555.88,
      "end": 560.079,
      "text": "कासा नहीं बढ़ रहा है दूसरी तरफ लोन की"
    },
    {
      "subtitle_ids": [
        244
      ],
      "start": 558.16,
      "end": 561.64,
      "text": "ग्रोथ बहुत तेजी से बढ़ रही है यानी अगर"
    },
    {
      "subtitle_ids": [
        245
      ],
      "start": 560.079,
      "end": 563.68,
      "text": "बैंक को बहुत तेजी से बढ़ना है तो ज्यादा"
    },
    {
      "subtitle_ids": [
        246
      ],
      "start": 561.64,
      "end": 565.12,
      "text": "लोन बांटने पड़ेंगे ऑफकोर्स और ज्यादा लोन"
    },
    {
      "subtitle_ids": [
        247
      ],
      "start": 563.68,
      "end": 567.0,
      "text": "बांटने के लिए पैसा कहां से आएगा तो"
    },
    {
      "subtitle_ids": [
        248
      ],
      "start": 565.12,
      "end": 569.6,
      "text": "अल्टरनेट सोर्स ऑफ फंडिंग उन्हें ढूंढनी"
    },
    {
      "subtitle_ids": [
        249
      ],
      "start": 567.0,
      "end": 571.12,
      "text": "पड़ेगी अब यहां पर बैंक का रेपुटेशन का"
    },
    {
      "subtitle_ids": [
        250
      ],
      "start": 569.6,
      "end": 572.68,
      "text": "काम में आएगा क्योंकि अगर किसी बैंक का"
    },
    {
      "subtitle_ids": [
        251
      ],
      "start": 571.12,
      "end": 575.16,
      "text": "रेपुटेशन काफी अच्छा है तो उन्हें"
    },
    {
      "subtitle_ids": [
        252
      ],
      "start": 572.68,
      "end": 577.16,
      "text": "इंटरनेशनल मार्केट में या फिर बाकी जगह से"
    },
    {
      "subtitle_ids": [
        253
      ],
      "start": 575.16,
      "end": 578.72,
      "text": "कम इंटरेस्ट में पैसा मिल सकता है जिससे"
    },
    {
      "subtitle_ids": [
        254
      ],
      "start": 577.16,
      "end": 581.0,
      "text": "वोह ज्यादा इंटरेस्ट रेट पर अपने कस्टमर्स"
    },
    {
      "subtitle_ids": [
        255
      ],
      "start": 578.72,
      "end": 582.839,
      "text": "को दे सकते हैं सो दिस कुड बी अ न्यू मॉडल"
    },
    {
      "subtitle_ids": [
        256
      ],
      "start": 581.0,
      "end": 584.92,
      "text": "जहां पर सबसे ज्यादा बड़े बेनिफिशियरी वो"
    },
    {
      "subtitle_ids": [
        257
      ],
      "start": 582.839,
      "end": 586.64,
      "text": "होंगे जिनका ट्रस्ट फैक्टर सबसे ज्यादा है"
    },
    {
      "subtitle_ids": [
        258
      ],
      "start": 584.92,
      "end": 588.04,
      "text": "मार्केट में तो कासा रेशो मुझे लगता है"
    },
    {
      "subtitle_ids": [
        259
      ],
      "start": 586.64,
      "end": 590.16,
      "text": "आने वाले टाइम में और भी कम होगा जिसके"
    },
    {
      "subtitle_ids": [
        260
      ],
      "start": 588.04,
      "end": 592.12,
      "text": "पीछे सिंपल रीजंस है कि कई सारे लोग शॉर्ट"
    },
    {
      "subtitle_ids": [
        261
      ],
      "start": 590.16,
      "end": 594.04,
      "text": "टर्म डेट फंड में लिक्विड फंड में पैसा"
    },
    {
      "subtitle_ids": [
        262
      ],
      "start": 592.12,
      "end": 596.0,
      "text": "डाल रहे हैं ताकि वो अपने सेविंग अकाउंट"
    },
    {
      "subtitle_ids": [
        263
      ],
      "start": 594.04,
      "end": 597.56,
      "text": "और करंट अकाउंट से बेटर रिटर्न्स कमाए कई"
    },
    {
      "subtitle_ids": [
        264
      ],
      "start": 596.0,
      "end": 599.959,
      "text": "सारे लोग अभी दो मिनट में एफडी कर रहे हैं"
    },
    {
      "subtitle_ids": [
        265
      ],
      "start": 597.56,
      "end": 601.839,
      "text": "ऑनलाइन अगेन एफडी इज अ हाई थिंग फॉर द"
    },
    {
      "subtitle_ids": [
        266
      ],
      "start": 599.959,
      "end": 603.56,
      "text": "बैंक्स बट लोगों के लिए वो भी कन्वेनिएंट"
    },
    {
      "subtitle_ids": [
        267
      ],
      "start": 601.839,
      "end": 605.079,
      "text": "हो गई है 7 दिन की अपडी आती है महीने की"
    },
    {
      "subtitle_ids": [
        268
      ],
      "start": 603.56,
      "end": 606.92,
      "text": "आती है दो महीने की आती है और धीरे-धीरे"
    },
    {
      "subtitle_ids": [
        269
      ],
      "start": 605.079,
      "end": 608.519,
      "text": "फिनो शस का चैनल देखकर काफी सारे लोग"
    },
    {
      "subtitle_ids": [
        270
      ],
      "start": 606.92,
      "end": 610.079,
      "text": "अवेयर हो रहे हैं तो उन्हें पता है कि"
    },
    {
      "subtitle_ids": [
        271
      ],
      "start": 608.519,
      "end": 611.839,
      "text": "हमें अपना पैसा कहां पर इन्वेस्ट करना"
    },
    {
      "subtitle_ids": [
        272
      ],
      "start": 610.079,
      "end": 614.12,
      "text": "चाहिए जहां पर हमें बेटर इंटरेस्ट रेट"
    },
    {
      "subtitle_ids": [
        273
      ],
      "start": 611.839,
      "end": 615.959,
      "text": "मिले और इंफ्लेशन को हम इजली बीट कर पाए"
    },
    {
      "subtitle_ids": [
        274
      ],
      "start": 614.12,
      "end": 618.48,
      "text": "तो इजली हम ये कह सकते हैं कि टफ टाइम फॉर"
    },
    {
      "subtitle_ids": [
        275
      ],
      "start": 615.959,
      "end": 620.6,
      "text": "बैंक्स ये काफी इनोवेट करना पड़ेगा काफी"
    },
    {
      "subtitle_ids": [
        276
      ],
      "start": 618.48,
      "end": 622.64,
      "text": "क्रिएटिव होना पड़ेगा तभी जाकर चीजें आगे"
    },
    {
      "subtitle_ids": [
        277
      ],
      "start": 620.6,
      "end": 624.76,
      "text": "बन पाएगी अदर वाइज सिचुएशन कैन बिकम वेरी"
    },
    {
      "subtitle_ids": [
        278
      ],
      "start": 622.64,
      "end": 626.48,
      "text": "वेरी टफ और जो स्ट्रगल एनबीएफसी को करना"
    },
    {
      "subtitle_ids": [
        279
      ],
      "start": 624.76,
      "end": 627.92,
      "text": "पड़ता है आने वाले टाइम में वही स्ट्रगल"
    },
    {
      "subtitle_ids": [
        280
      ],
      "start": 626.48,
      "end": 630.279,
      "text": "बैंक्स को करना पड़ता है बैंक्स के पास"
    },
    {
      "subtitle_ids": [
        281
      ],
      "start": 627.92,
      "end": 633.2,
      "text": "एनबीएफसी के कंपेरटिवली बेटर चीज क्या है"
    },
    {
      "subtitle_ids": [
        282
      ],
      "start": 630.279,
      "end": 635.76,
      "text": "कासा अगर वही नहीं रहेगा तो बैंक्स आर"
    },
    {
      "subtitle_ids": [
        283
      ],
      "start": 633.2,
      "end": 638.48,
      "text": "नथिंग बट एनबीएफसी जैसे फंक्शन करने"
    },
    {
      "subtitle_ids": [
        284
      ],
      "start": 635.76,
      "end": 640.2,
      "text": "लगेंगे तो इसीलिए बैंक्स को जल्दी नींद से"
    },
    {
      "subtitle_ids": [
        285
      ],
      "start": 638.48,
      "end": 642.519,
      "text": "उठना पड़ेगा कुछ ना कुछ फिगर आउट करना"
    },
    {
      "subtitle_ids": [
        286
      ],
      "start": 640.2,
      "end": 644.56,
      "text": "पड़ेगा और जल्दी इनोवेशन के साथ आगे बढ़ना"
    },
    {
      "subtitle_ids": [
        287
      ],
      "start": 642.519,
      "end": 646.04,
      "text": "पड़ेगा साथ ही इसका यह मतलब नहीं कि बैंक"
    },
    {
      "subtitle_ids": [
        288
      ],
      "start": 644.56,
      "end": 648.079,
      "text": "स्ट्रगल करेगी बैंक्स में बहुत ज्यादा"
    },
    {
      "subtitle_ids": [
        289
      ],
      "start": 646.04,
      "end": 650.68,
      "text": "ग्रोथ लोन इंडस्ट्री इतनी तेजी से बढ़ रही"
    },
    {
      "subtitle_ids": [
        290
      ],
      "start": 648.079,
      "end": 652.88,
      "text": "है कि पूछिए मत तो यहां पर जो बैंक सही"
    },
    {
      "subtitle_ids": [
        291
      ],
      "start": 650.68,
      "end": 654.68,
      "text": "टाइम पर अपॉर्चुनिटी को टैप करेगी और यहां"
    },
    {
      "subtitle_ids": [
        292
      ],
      "start": 652.88,
      "end": 657.36,
      "text": "से सलूशन निकालेगी वो बहुत बड़ा विनर"
    },
    {
      "subtitle_ids": [
        293
      ],
      "start": 654.68,
      "end": 659.279,
      "text": "बनेगी करंट जो बड़ी-बड़ी बैंक्स से वो"
    },
    {
      "subtitle_ids": [
        294
      ],
      "start": 657.36,
      "end": 661.6,
      "text": "साइज कुछ नहीं है उससे भी कई गुना बैंक्स"
    },
    {
      "subtitle_ids": [
        295
      ],
      "start": 659.279,
      "end": 664.519,
      "text": "बढ़ सकती है इतनी तेजी से लोन इंडस्ट्री"
    },
    {
      "subtitle_ids": [
        296
      ],
      "start": 661.6,
      "end": 666.839,
      "text": "बढ़ रही है सो अपॉर्चुनिटी आपके सामने है"
    },
    {
      "subtitle_ids": [
        297
      ],
      "start": 664.519,
      "end": 669.0,
      "text": "प्रॉब्लम आपको पता है सलूशन आपको पता है"
    },
    {
      "subtitle_ids": [
        298
      ],
      "start": 666.839,
      "end": 673.16,
      "text": "अब आपको ऑब्जर्व करना है कि कौन स बैंक"
    },
    {
      "subtitle_ids": [
        299
      ],
      "start": 669.0,
      "end": 673.16,
      "text": "सही तरीके से सलूशन लाती है और इस"
    }
  ]
}