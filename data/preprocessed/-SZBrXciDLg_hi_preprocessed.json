  "segments": [
    {
      "subtitle_ids": [
        1
      ],
      "start": 3.6,
      "end": 8.24,
      "text": "ट्रंप पूरी दुनिया को बना रहा है। पहले तो"
    },
    {
      "subtitle_ids": [
        2
      ],
      "start": 6.08,
      "end": 10.32,
      "text": "डॉनल्ड ट्रंप ने ईरान से अननेसेसरी पंगा"
    },
    {
      "subtitle_ids": [
        3
      ],
      "start": 8.24,
      "end": 12.16,
      "text": "लिया और पूरी दुनिया को एक इकोनमिक"
    },
    {
      "subtitle_ids": [
        4
      ],
      "start": 10.32,
      "end": 14.32,
      "text": "क्राइसिस में डाल दिया। पूरी दुनिया के"
    },
    {
      "subtitle_ids": [
        5
      ],
      "start": 12.16,
      "end": 16.56,
      "text": "स्टॉक मार्केट गिर गए। ऑयल के रूट्स बंद"
    },
    {
      "subtitle_ids": [
        6
      ],
      "start": 14.32,
      "end": 18.8,
      "text": "हो गए। ऑयल एंड एलएनजी क्राइसिस हो गया।"
    },
    {
      "subtitle_ids": [
        7
      ],
      "start": 16.56,
      "end": 20.56,
      "text": "फिर ईरान के पूरे सिविलाइजेशन को खत्म"
    },
    {
      "subtitle_ids": [
        8
      ],
      "start": 18.8,
      "end": 22.4,
      "text": "करने की धमकी देते हैं। कहते हैं कि अगर"
    },
    {
      "subtitle_ids": [
        9
      ],
      "start": 20.56,
      "end": 24.72,
      "text": "स्टेट ऑफ हॉर्मोंस को ईरान ने ओपन नहीं"
    },
    {
      "subtitle_ids": [
        10
      ],
      "start": 22.4,
      "end": 27.039,
      "text": "किया तो ईरान का हर पावर प्लांट और मेजर"
    },
    {
      "subtitle_ids": [
        11
      ],
      "start": 24.72,
      "end": 28.72,
      "text": "ब्रिज को बम से उड़ा देंगे। पूरी दुनिया"
    },
    {
      "subtitle_ids": [
        12
      ],
      "start": 27.039,
      "end": 31.519,
      "text": "एक पैनिकिक मोड में चली जाती है। क्रूड"
    },
    {
      "subtitle_ids": [
        13
      ],
      "start": 28.72,
      "end": 33.68,
      "text": "ऑयल 115 पर पहुंच जाता है। इंडियन मार्केट"
    },
    {
      "subtitle_ids": [
        14
      ],
      "start": 31.519,
      "end": 35.84,
      "text": "भी आज पूरी तैयारी में था कि आज खुलते ही"
    },
    {
      "subtitle_ids": [
        15
      ],
      "start": 33.68,
      "end": 38.48,
      "text": "मैं गिर जाऊं। लेकिन फिर तभी ट्रंप कुछ"
    },
    {
      "subtitle_ids": [
        16
      ],
      "start": 35.84,
      "end": 40.32,
      "text": "ऐसा करते हैं जो वह करते आए हैं। इंडियन"
    },
    {
      "subtitle_ids": [
        17
      ],
      "start": 38.48,
      "end": 42.719,
      "text": "टाइम के हिसाब से सुबह 5:00 बजे न्यूज़"
    },
    {
      "subtitle_ids": [
        18
      ],
      "start": 40.32,
      "end": 44.559,
      "text": "आती है कि वह ईरान को दो हफ्तों का और"
    },
    {
      "subtitle_ids": [
        19
      ],
      "start": 42.719,
      "end": 46.559,
      "text": "एक्सटेंशन देने वाले हैं। यह सब होने के"
    },
    {
      "subtitle_ids": [
        20
      ],
      "start": 44.559,
      "end": 48.719,
      "text": "बाद एक बात तो पर्सनली मेरे मन में क्लियर"
    },
    {
      "subtitle_ids": [
        21
      ],
      "start": 46.559,
      "end": 50.96,
      "text": "है कि डोन्ड ट्रंप मार्केट मैनिपुलेशन कर"
    },
    {
      "subtitle_ids": [
        22
      ],
      "start": 48.719,
      "end": 53.039,
      "text": "रहे हैं। यस, पास्ट में भी डोन्ड ट्रंप पर"
    },
    {
      "subtitle_ids": [
        23
      ],
      "start": 50.96,
      "end": 54.96,
      "text": "सीरियस मार्केट मैनपुलेशन और इंसाइडर"
    },
    {
      "subtitle_ids": [
        24
      ],
      "start": 53.039,
      "end": 56.96,
      "text": "ट्रेडिंग के आरोप लगे हैं। आरोप है कि खुद"
    },
    {
      "subtitle_ids": [
        25
      ],
      "start": 54.96,
      "end": 58.8,
      "text": "के और अपने फैमिली और बिजनेस फ्रेंड्स के"
    },
    {
      "subtitle_ids": [
        26
      ],
      "start": 56.96,
      "end": 60.8,
      "text": "फायदे के लिए पूरी दुनिया को उन्होंने"
    },
    {
      "subtitle_ids": [
        27
      ],
      "start": 58.8,
      "end": 62.32,
      "text": "क्राइसिस में डाला है। और आरोप ऐसे गंभीर"
    },
    {
      "subtitle_ids": [
        28
      ],
      "start": 60.8,
      "end": 64.159,
      "text": "है कि वह दोनों तरफ से मार्केट को"
    },
    {
      "subtitle_ids": [
        29
      ],
      "start": 62.32,
      "end": 65.92,
      "text": "मैनिपुलेट कर रहे हैं। पहले तो वह खुद"
    },
    {
      "subtitle_ids": [
        30
      ],
      "start": 64.159,
      "end": 68.0,
      "text": "क्राइसिस क्रिएट करते हैं और इनके जो"
    },
    {
      "subtitle_ids": [
        31
      ],
      "start": 65.92,
      "end": 70.4,
      "text": "इंसाइडर लोग हैं वह शॉर्ट करके मार्केट"
    },
    {
      "subtitle_ids": [
        32
      ],
      "start": 68.0,
      "end": 72.4,
      "text": "में पैसा बनाते हैं। शॉर्ट करना मतलब जब"
    },
    {
      "subtitle_ids": [
        33
      ],
      "start": 70.4,
      "end": 74.4,
      "text": "आपको लगता है कि मार्केट डाउन जाएगा तो"
    },
    {
      "subtitle_ids": [
        34
      ],
      "start": 72.4,
      "end": 76.4,
      "text": "उसके लिए शॉर्ट पोजीशन ली जाती है जिससे"
    },
    {
      "subtitle_ids": [
        35
      ],
      "start": 74.4,
      "end": 78.0,
      "text": "आप प्रॉफिट कमाते हो। यानी कि आपने शॉर्ट"
    },
    {
      "subtitle_ids": [
        36
      ],
      "start": 76.4,
      "end": 79.759,
      "text": "पोजीशन लेने के बाद जितना ज्यादा मार्केट"
    },
    {
      "subtitle_ids": [
        37
      ],
      "start": 78.0,
      "end": 81.68,
      "text": "या पर्टिकुलर स्टॉक गिरेगा उतना ज्यादा"
    },
    {
      "subtitle_ids": [
        38
      ],
      "start": 79.759,
      "end": 83.52,
      "text": "आपको फायदा मिलेगा। उसके बाद उनके स्टेप"
    },
    {
      "subtitle_ids": [
        39
      ],
      "start": 81.68,
      "end": 85.68,
      "text": "टू है कि क्राइसिस को ठीक करने का नाटक"
    },
    {
      "subtitle_ids": [
        40
      ],
      "start": 83.52,
      "end": 87.759,
      "text": "करो और फिर उनके इंसाइडर सर्कल के लोग"
    },
    {
      "subtitle_ids": [
        41
      ],
      "start": 85.68,
      "end": 89.28,
      "text": "मार्केट को लॉन्ग करके यहां पर पैसा कमाते"
    },
    {
      "subtitle_ids": [
        42
      ],
      "start": 87.759,
      "end": 90.96,
      "text": "हैं। देखिए यह वीडियो तो वैसे लास्ट वीक"
    },
    {
      "subtitle_ids": [
        43
      ],
      "start": 89.28,
      "end": 92.64,
      "text": "ही आने वाली थी लेकिन पिछले हफ्ते में"
    },
    {
      "subtitle_ids": [
        44
      ],
      "start": 90.96,
      "end": 94.4,
      "text": "दो-तीन बार मार्केट मैनपुलेशन जैसी"
    },
    {
      "subtitle_ids": [
        45
      ],
      "start": 92.64,
      "end": 96.24,
      "text": "सिचुएशनंस उन्होंने क्रिएट की है। इसीलिए"
    },
    {
      "subtitle_ids": [
        46
      ],
      "start": 94.4,
      "end": 98.159,
      "text": "सोचा कि इन सारी चीजों को कवर करना जरूरी"
    },
    {
      "subtitle_ids": [
        47
      ],
      "start": 96.24,
      "end": 99.92,
      "text": "है इसलिए आज इस वीडियो को हम ला रहे हैं।"
    },
    {
      "subtitle_ids": [
        48
      ],
      "start": 98.159,
      "end": 101.68,
      "text": "नमस्कार मैं प्रसाद आपका आज के इस वीडियो"
    },
    {
      "subtitle_ids": [
        49
      ],
      "start": 99.92,
      "end": 103.6,
      "text": "में स्वागत करता हूं। तो देखिए ईरान का यह"
    },
    {
      "subtitle_ids": [
        50
      ],
      "start": 101.68,
      "end": 105.28,
      "text": "जो इशू है यह काफी लंबे टाइम से चल रहा"
    },
    {
      "subtitle_ids": [
        51
      ],
      "start": 103.6,
      "end": 107.2,
      "text": "है। दुनिया के सारे मार्केट बहुत ज्यादा"
    },
    {
      "subtitle_ids": [
        52
      ],
      "start": 105.28,
      "end": 109.6,
      "text": "प्रेशर में थे। कोरिया जापान सब मार्केट"
    },
    {
      "subtitle_ids": [
        53
      ],
      "start": 107.2,
      "end": 111.52,
      "text": "10-15% गिरे हुए थे। इंडिया का मार्केट"
    },
    {
      "subtitle_ids": [
        54
      ],
      "start": 109.6,
      "end": 113.6,
      "text": "20th फरवरी से अब तक लगातार गिर रहा है।"
    },
    {
      "subtitle_ids": [
        55
      ],
      "start": 111.52,
      "end": 115.84,
      "text": "इंडिया का लार्ज कैप इंडेक्स अराउंड 12-3%"
    },
    {
      "subtitle_ids": [
        56
      ],
      "start": 113.6,
      "end": 118.479,
      "text": "गिर गया है। वहीं पर स्माल कैप इंडेक्स 18"
    },
    {
      "subtitle_ids": [
        57
      ],
      "start": 115.84,
      "end": 120.159,
      "text": "से 20% तक गिर गया था। लाखों करोड़ों रुपए"
    },
    {
      "subtitle_ids": [
        58
      ],
      "start": 118.479,
      "end": 122.799,
      "text": "मार्केट से स्वाहा हो गए और उसके पीछे का"
    },
    {
      "subtitle_ids": [
        59
      ],
      "start": 120.159,
      "end": 125.04,
      "text": "कारण यह आदमी। जब से आदमी आया है दुनिया"
    },
    {
      "subtitle_ids": [
        60
      ],
      "start": 122.799,
      "end": 126.88,
      "text": "की इकॉनमी को शॉक पर शॉक दिए जा रहा है।"
    },
    {
      "subtitle_ids": [
        61
      ],
      "start": 125.04,
      "end": 128.72,
      "text": "शुरुआत हुई टेररिफ से फिर किसी भी कंट्री"
    },
    {
      "subtitle_ids": [
        62
      ],
      "start": 126.88,
      "end": 131.2,
      "text": "पर अटैक करने की बातें होने लगी और फिर"
    },
    {
      "subtitle_ids": [
        63
      ],
      "start": 128.72,
      "end": 133.04,
      "text": "कभी बेवजह वॉर शुरू करना। अब यहां पर आम"
    },
    {
      "subtitle_ids": [
        64
      ],
      "start": 131.2,
      "end": 134.959,
      "text": "जो लोग हैं उनको यह लगता है कि ट्रंप यह"
    },
    {
      "subtitle_ids": [
        65
      ],
      "start": 133.04,
      "end": 136.64,
      "text": "सन के आदमी है। लेकिन उससे पहले आपको एक"
    },
    {
      "subtitle_ids": [
        66
      ],
      "start": 134.959,
      "end": 138.48,
      "text": "चीज बताना चाहता हूं कि ट्रंप प्रेसिडेंट"
    },
    {
      "subtitle_ids": [
        67
      ],
      "start": 136.64,
      "end": 140.48,
      "text": "होने से पहले एक बिजनेसमैन रह चुके हैं और"
    },
    {
      "subtitle_ids": [
        68
      ],
      "start": 138.48,
      "end": 142.72,
      "text": "वो भी ऐसे वैसे नहीं बल्कि बहुत ही ज्यादा"
    },
    {
      "subtitle_ids": [
        69
      ],
      "start": 140.48,
      "end": 144.64,
      "text": "कंट्रोवर्शियल। इनफैक्ट आपको पता ही होगा"
    },
    {
      "subtitle_ids": [
        70
      ],
      "start": 142.72,
      "end": 146.72,
      "text": "कि डॉन्ड ट्रंप ने अपने बिजनेस करियर में"
    },
    {
      "subtitle_ids": [
        71
      ],
      "start": 144.64,
      "end": 148.4,
      "text": "छह बार बैंकरप्स फाइल की है। यानी छह बार"
    },
    {
      "subtitle_ids": [
        72
      ],
      "start": 146.72,
      "end": 149.92,
      "text": "उन्होंने दिवालिया घोषित किया है। अब यहां"
    },
    {
      "subtitle_ids": [
        73
      ],
      "start": 148.4,
      "end": 152.16,
      "text": "पर सोचने वाली बात यह है कि उसमें से एक"
    },
    {
      "subtitle_ids": [
        74
      ],
      "start": 149.92,
      "end": 154.319,
      "text": "बिजनेस कसीनो का था और कसीनो का बिज़नेस"
    },
    {
      "subtitle_ids": [
        75
      ],
      "start": 152.16,
      "end": 156.4,
      "text": "बैंककरप्ट करना यह भी आप समझ लीजिए हुनर"
    },
    {
      "subtitle_ids": [
        76
      ],
      "start": 154.319,
      "end": 158.08,
      "text": "ही है। लेकिन छह बार बैंकरप्सी घोषित करने"
    },
    {
      "subtitle_ids": [
        77
      ],
      "start": 156.4,
      "end": 161.44,
      "text": "के बावजूद आज डॉनल्ड ट्रंप की जो नेटवर्थ"
    },
    {
      "subtitle_ids": [
        78
      ],
      "start": 158.08,
      "end": 163.92,
      "text": "है वो 6.5 बिलियन है। यानी कि लगभग $600"
    },
    {
      "subtitle_ids": [
        79
      ],
      "start": 161.44,
      "end": 165.76,
      "text": "करोड़ की। तो ऐसा कैसे हुआ? देखिए भले ही"
    },
    {
      "subtitle_ids": [
        80
      ],
      "start": 163.92,
      "end": 167.76,
      "text": "डोनाल्ड ट्रंप बिजनेसमैन अच्छे ना हो"
    },
    {
      "subtitle_ids": [
        81
      ],
      "start": 165.76,
      "end": 169.28,
      "text": "लेकिन वह एक अच्छे मनीपुलेटर जरूर हैं।"
    },
    {
      "subtitle_ids": [
        82
      ],
      "start": 167.76,
      "end": 171.36,
      "text": "उन्हें पता है कि सिस्टम को कैसे अपने"
    },
    {
      "subtitle_ids": [
        83
      ],
      "start": 169.28,
      "end": 173.2,
      "text": "फेवर में यूज करना है। यूएस के बैंककरप्सी"
    },
    {
      "subtitle_ids": [
        84
      ],
      "start": 171.36,
      "end": 175.04,
      "text": "लॉज़ में लूप होल निकाल के उन्होंने ऐसा"
    },
    {
      "subtitle_ids": [
        85
      ],
      "start": 173.2,
      "end": 176.72,
      "text": "खेल रचा कि उनकी बहुत सारी कंपनीज़"
    },
    {
      "subtitle_ids": [
        86
      ],
      "start": 175.04,
      "end": 178.48,
      "text": "बैंककरप्ट तो हो गई पर ट्रंप कभी खुद"
    },
    {
      "subtitle_ids": [
        87
      ],
      "start": 176.72,
      "end": 180.16,
      "text": "बैंकरप्ट नहीं हुए और प्रेसिडेंट होने के"
    },
    {
      "subtitle_ids": [
        88
      ],
      "start": 178.48,
      "end": 182.0,
      "text": "बाद भी उन्होंने अपनी इस एक हैबिट को नहीं"
    },
    {
      "subtitle_ids": [
        89
      ],
      "start": 180.16,
      "end": 184.0,
      "text": "बदला कि पहले वो बैंकरप्ट्स लॉ को"
    },
    {
      "subtitle_ids": [
        90
      ],
      "start": 182.0,
      "end": 185.76,
      "text": "मैनपुलेट करते थे। आज वो मार्केट को"
    },
    {
      "subtitle_ids": [
        91
      ],
      "start": 184.0,
      "end": 187.599,
      "text": "मैनपुलेट करते हैं। और यह मैं ऐसे नहीं कह"
    },
    {
      "subtitle_ids": [
        92
      ],
      "start": 185.76,
      "end": 189.76,
      "text": "रहा कुछ प्रूफ्स के साथ अभी आपको समझाता"
    },
    {
      "subtitle_ids": [
        93
      ],
      "start": 187.599,
      "end": 191.68,
      "text": "हूं। आगे बढ़ने से पहले आपसे एक जरूरी बात"
    },
    {
      "subtitle_ids": [
        94
      ],
      "start": 189.76,
      "end": 193.519,
      "text": "करना चाहूंगा। फिलहाल मार्केट एक करेक्शन"
    },
    {
      "subtitle_ids": [
        95
      ],
      "start": 191.68,
      "end": 195.519,
      "text": "मोड में है और ऐसे टाइम में ज्यादातर"
    },
    {
      "subtitle_ids": [
        96
      ],
      "start": 193.519,
      "end": 197.68,
      "text": "इन्वेस्टर्स डर जाते हैं। लेकिन वैल्यू"
    },
    {
      "subtitle_ids": [
        97
      ],
      "start": 195.519,
      "end": 199.519,
      "text": "इन्वेस्टर्स के लिए यही समय सबसे बड़ी"
    },
    {
      "subtitle_ids": [
        98
      ],
      "start": 197.68,
      "end": 201.84,
      "text": "अपॉर्चुनिटी लेकर आता है। अगर आप सही"
    },
    {
      "subtitle_ids": [
        99
      ],
      "start": 199.519,
      "end": 203.76,
      "text": "रिसर्च के साथ इन्वेस्ट करें तो ऐसे फेसेस"
    },
    {
      "subtitle_ids": [
        100
      ],
      "start": 201.84,
      "end": 205.44,
      "text": "आपको लॉन्ग टर्म वेल्थ बनाने का बेस्ट"
    },
    {
      "subtitle_ids": [
        101
      ],
      "start": 203.76,
      "end": 207.44,
      "text": "चांस देते हैं। लेकिन फिर प्रॉब्लम यह है"
    },
    {
      "subtitle_ids": [
        102
      ],
      "start": 205.44,
      "end": 209.44,
      "text": "कि हर किसी के पास रिसर्च करने का टाइम"
    },
    {
      "subtitle_ids": [
        103
      ],
      "start": 207.44,
      "end": 211.92,
      "text": "नहीं होता। इसी प्रॉब्लम को सॉल्व करने के"
    },
    {
      "subtitle_ids": [
        104
      ],
      "start": 209.44,
      "end": 213.84,
      "text": "लिए हमने ल्च किया है ekash pro। ek pro"
    },
    {
      "subtitle_ids": [
        105
      ],
      "start": 211.92,
      "end": 216.319,
      "text": "में रिसर्च का काम हमारा और इन्वेस्टिंग"
    },
    {
      "subtitle_ids": [
        106
      ],
      "start": 213.84,
      "end": 218.319,
      "text": "का डिसीजन आपका। हर महीने हम आपके लिए वेल"
    },
    {
      "subtitle_ids": [
        107
      ],
      "start": 216.319,
      "end": 220.319,
      "text": "रिसर्च स्टॉक्स आइडेंटिफाई करेंगे और अगर"
    },
    {
      "subtitle_ids": [
        108
      ],
      "start": 218.319,
      "end": 222.64,
      "text": "किसी महीने स्टॉक में ज्यादा करेक्शन आता"
    },
    {
      "subtitle_ids": [
        109
      ],
      "start": 220.319,
      "end": 224.48,
      "text": "है तो उस केस में हम दो स्टॉक्स भी शेयर"
    },
    {
      "subtitle_ids": [
        110
      ],
      "start": 222.64,
      "end": 226.64,
      "text": "कर सकते हैं। इससे आपके इन्वेस्टिंग का"
    },
    {
      "subtitle_ids": [
        111
      ],
      "start": 224.48,
      "end": 228.64,
      "text": "प्रोसेस काफी सिंपल हो जाएगा और हां हम"
    },
    {
      "subtitle_ids": [
        112
      ],
      "start": 226.64,
      "end": 230.56,
      "text": "सेबी रजिस्टर्ड रिसर्च एनालिस्ट हैं। अगर"
    },
    {
      "subtitle_ids": [
        113
      ],
      "start": 228.64,
      "end": 232.48,
      "text": "आप अपना टाइम बचाना चाहते हैं और रिसर्च"
    },
    {
      "subtitle_ids": [
        114
      ],
      "start": 230.56,
      "end": 234.799,
      "text": "का काम एक्सपर्ट्स पर छोड़ना चाहते हैं तो"
    },
    {
      "subtitle_ids": [
        115
      ],
      "start": 232.48,
      "end": 236.319,
      "text": "इकाशे pro आपके लिए है। इस कम्युनिटी में"
    },
    {
      "subtitle_ids": [
        116
      ],
      "start": 234.799,
      "end": 238.319,
      "text": "दो प्लान्स अवेलेबल हैं। सिक्स मंथ्स"
    },
    {
      "subtitle_ids": [
        117
      ],
      "start": 236.319,
      "end": 240.56,
      "text": "प्लान जिसमें आपको छह वेल रिसर्च स्टॉक्स"
    },
    {
      "subtitle_ids": [
        118
      ],
      "start": 238.319,
      "end": 242.239,
      "text": "मिलेंगे और 12 मंथ्स प्लान जिसमें आपको 12"
    },
    {
      "subtitle_ids": [
        119
      ],
      "start": 240.56,
      "end": 244.4,
      "text": "वेल रिसर्च स्टॉक्स मिलेंगे। यह सारे"
    },
    {
      "subtitle_ids": [
        120
      ],
      "start": 242.239,
      "end": 246.159,
      "text": "स्टॉक रिकमेंडेशंस आपको ईमेल के साथ-साथ"
    },
    {
      "subtitle_ids": [
        121
      ],
      "start": 244.4,
      "end": 248.0,
      "text": "WhatsApp के जरिए मिलेंगे। इसे ज्वाइन"
    },
    {
      "subtitle_ids": [
        122
      ],
      "start": 246.159,
      "end": 249.599,
      "text": "करने के लिए सिंपली आप नीचे डिस्क्रिप्शन"
    },
    {
      "subtitle_ids": [
        123
      ],
      "start": 248.0,
      "end": 251.84,
      "text": "और कमेंट बॉक्स में दिए गए लिंक पर क्लिक"
    },
    {
      "subtitle_ids": [
        124
      ],
      "start": 249.599,
      "end": 254.0,
      "text": "कीजिए और फॉर्म फिल कीजिए। और हां, इसी के"
    },
    {
      "subtitle_ids": [
        125
      ],
      "start": 251.84,
      "end": 256.0,
      "text": "साथ आपको हमारी इका टाइम्स कम्युनिटी का"
    },
    {
      "subtitle_ids": [
        126
      ],
      "start": 254.0,
      "end": 257.919,
      "text": "भी फायदा मिलता है। जहां पर हम डेली स्टॉक"
    },
    {
      "subtitle_ids": [
        127
      ],
      "start": 256.0,
      "end": 260.079,
      "text": "मार्केट न्यूज़, इंपॉर्टेंट इवेंट्स पर"
    },
    {
      "subtitle_ids": [
        128
      ],
      "start": 257.919,
      "end": 261.84,
      "text": "हमारी ओपिनियन और सारे मेन बोर्ड आईपीओस"
    },
    {
      "subtitle_ids": [
        129
      ],
      "start": 260.079,
      "end": 264.0,
      "text": "पर डिटेल रिसर्च रिपोर्ट्स प्रोवाइड करते"
    },
    {
      "subtitle_ids": [
        130
      ],
      "start": 261.84,
      "end": 266.08,
      "text": "हैं। तो जो लोग इस मंथ ज्वाइन करेंगे उनके"
    },
    {
      "subtitle_ids": [
        131
      ],
      "start": 264.0,
      "end": 268.0,
      "text": "लिए इका टाइम्स कम्युनिटी बिल्कुल फ्री"
    },
    {
      "subtitle_ids": [
        132
      ],
      "start": 266.08,
      "end": 269.36,
      "text": "रहेगी। तो देर किस बात की? अभी नीचे"
    },
    {
      "subtitle_ids": [
        133
      ],
      "start": 268.0,
      "end": 271.12,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में दी गई"
    },
    {
      "subtitle_ids": [
        134
      ],
      "start": 269.36,
      "end": 272.8,
      "text": "लिंक पर क्लिक करके फॉर्म फिल कीजिए। उसके"
    },
    {
      "subtitle_ids": [
        135
      ],
      "start": 271.12,
      "end": 274.479,
      "text": "बाद हमारी टीम आपसे कनेक्ट करेगी और उसके"
    },
    {
      "subtitle_ids": [
        136
      ],
      "start": 272.8,
      "end": 276.56,
      "text": "बारे में डिटेल इंफॉर्मेशन आपको प्रोवाइड"
    },
    {
      "subtitle_ids": [
        137
      ],
      "start": 274.479,
      "end": 278.32,
      "text": "करेगी। सो सी यू इन द कम्युनिटी। चलिए अब"
    },
    {
      "subtitle_ids": [
        138
      ],
      "start": 276.56,
      "end": 279.919,
      "text": "बढ़ते हैं वीडियो की तरफ। कुछ टाइम पहले"
    },
    {
      "subtitle_ids": [
        139
      ],
      "start": 278.32,
      "end": 281.759,
      "text": "ही डोन्ड ट्रंप पर क्रूड ऑयल के मार्केट"
    },
    {
      "subtitle_ids": [
        140
      ],
      "start": 279.919,
      "end": 284.16,
      "text": "को मैनपुलेट करने का इल्जाम लगा है। देखिए"
    },
    {
      "subtitle_ids": [
        141
      ],
      "start": 281.759,
      "end": 286.08,
      "text": "अभी 23 मार्च यूएस टाइम के हिसाब से सुबह"
    },
    {
      "subtitle_ids": [
        142
      ],
      "start": 284.16,
      "end": 288.24,
      "text": "7:00 बजे के करीब ट्रंप का यह पोस्ट आता"
    },
    {
      "subtitle_ids": [
        143
      ],
      "start": 286.08,
      "end": 290.32,
      "text": "है। इस पोस्ट में लिखा है कि पिछले दो"
    },
    {
      "subtitle_ids": [
        144
      ],
      "start": 288.24,
      "end": 292.639,
      "text": "दिनों में ईरान और यूएसए के बीच में बात"
    },
    {
      "subtitle_ids": [
        145
      ],
      "start": 290.32,
      "end": 294.88,
      "text": "चल रही है कि कैसे वॉर को रोका जाए। जिसके"
    },
    {
      "subtitle_ids": [
        146
      ],
      "start": 292.639,
      "end": 296.88,
      "text": "चलते अगले 5 दिन ईरान के पावर प्लांट्स पर"
    },
    {
      "subtitle_ids": [
        147
      ],
      "start": 294.88,
      "end": 298.56,
      "text": "यूएस कोई भी हमला नहीं करेगा। यानी दुनिया"
    },
    {
      "subtitle_ids": [
        148
      ],
      "start": 296.88,
      "end": 300.639,
      "text": "को यह लगा कि अभी यहां पर सीज फायर हो"
    },
    {
      "subtitle_ids": [
        149
      ],
      "start": 298.56,
      "end": 302.16,
      "text": "जाएगी और फिर कोई हमला वगैरह नहीं होगा।"
    },
    {
      "subtitle_ids": [
        150
      ],
      "start": 300.639,
      "end": 303.919,
      "text": "लेकिन फिर बाद में दुनिया को पता चला कि"
    },
    {
      "subtitle_ids": [
        151
      ],
      "start": 302.16,
      "end": 305.84,
      "text": "यह पोस्ट और कुछ नहीं बल्कि एक बहुत बड़ा"
    },
    {
      "subtitle_ids": [
        152
      ],
      "start": 303.919,
      "end": 307.44,
      "text": "झूठ था। इनफैक्ट ईरान ने रिस्पांस में यह"
    },
    {
      "subtitle_ids": [
        153
      ],
      "start": 305.84,
      "end": 309.12,
      "text": "कहा कि डॉनल्ड ट्रंप से हमारी कोई बातचीत"
    },
    {
      "subtitle_ids": [
        154
      ],
      "start": 307.44,
      "end": 311.44,
      "text": "ही नहीं हुई है। इनफैक्ट यूएस इज"
    },
    {
      "subtitle_ids": [
        155
      ],
      "start": 309.12,
      "end": 313.44,
      "text": "नेगोशिएटिंग विद इटसेल्फ। अब इसके बाद हुआ"
    },
    {
      "subtitle_ids": [
        156
      ],
      "start": 311.44,
      "end": 315.919,
      "text": "यह कि डॉन्ड ट्रंप की पोस्ट के बाद जो"
    },
    {
      "subtitle_ids": [
        157
      ],
      "start": 313.44,
      "end": 318.32,
      "text": "क्रूड ऑयल की प्राइसेस तुरंत 15% गिरकर"
    },
    {
      "subtitle_ids": [
        158
      ],
      "start": 315.919,
      "end": 320.639,
      "text": "$85 पर आई थी, वो वापस फिर से बढ़ने लगी"
    },
    {
      "subtitle_ids": [
        159
      ],
      "start": 318.32,
      "end": 322.16,
      "text": "और $92 पर चली गई। ऐसे में पूरी दुनिया"
    },
    {
      "subtitle_ids": [
        160
      ],
      "start": 320.639,
      "end": 324.32,
      "text": "कंफ्यूजन मोड में थी कि यह क्या हो रहा"
    },
    {
      "subtitle_ids": [
        161
      ],
      "start": 322.16,
      "end": 326.08,
      "text": "है? आखिर फिर डोनल्ड ट्रंप नेगोशिएट किसके"
    },
    {
      "subtitle_ids": [
        162
      ],
      "start": 324.32,
      "end": 328.479,
      "text": "साथ कर रहे हैं? लेकिन बाद में सच सामने"
    },
    {
      "subtitle_ids": [
        163
      ],
      "start": 326.08,
      "end": 330.479,
      "text": "आता है कि यह सब नाटक था और कुछ नहीं।"
    },
    {
      "subtitle_ids": [
        164
      ],
      "start": 328.479,
      "end": 332.32,
      "text": "इनफैक्ट ट्रंप ने यह पोस्ट इसलिए की ताकि"
    },
    {
      "subtitle_ids": [
        165
      ],
      "start": 330.479,
      "end": 334.32,
      "text": "वह मार्केट को खास करके क्रूड ऑयल को"
    },
    {
      "subtitle_ids": [
        166
      ],
      "start": 332.32,
      "end": 337.28,
      "text": "मैनपुलेट कर पाए और इसके अच्छे खासे सबूत"
    },
    {
      "subtitle_ids": [
        167
      ],
      "start": 334.32,
      "end": 339.199,
      "text": "भी हैं। देखिए सुबह 7:05 पर डोन्ड ट्रंप"
    },
    {
      "subtitle_ids": [
        168
      ],
      "start": 337.28,
      "end": 341.28,
      "text": "ने यह पोस्ट की थी और इंटरेस्टिंगली क्रूड"
    },
    {
      "subtitle_ids": [
        169
      ],
      "start": 339.199,
      "end": 343.919,
      "text": "ऑयल के फ्यूचर मार्केट में सिर्फ 15 मिनट"
    },
    {
      "subtitle_ids": [
        170
      ],
      "start": 341.28,
      "end": 345.52,
      "text": "पहले यानी 649 को क्रूड ऑयल के फ्यूचर्स"
    },
    {
      "subtitle_ids": [
        171
      ],
      "start": 343.919,
      "end": 348.479,
      "text": "के ट्रेडिंग के वॉल्यूम में एक बहुत बड़ा"
    },
    {
      "subtitle_ids": [
        172
      ],
      "start": 345.52,
      "end": 350.16,
      "text": "स्पाइक आता है। अबाउट 6200 ब्रेंट एंड"
    },
    {
      "subtitle_ids": [
        173
      ],
      "start": 348.479,
      "end": 351.84,
      "text": "वेस्ट टेक्सस इंटरमीडिएट फ्यूचर"
    },
    {
      "subtitle_ids": [
        174
      ],
      "start": 350.16,
      "end": 354.96,
      "text": "कॉन्ट्रैक्ट्स इस दौरान होते हैं। जिनकी"
    },
    {
      "subtitle_ids": [
        175
      ],
      "start": 351.84,
      "end": 356.72,
      "text": "नोशनल वैल्यू करीब ₹55 करोड़ होती है। अब"
    },
    {
      "subtitle_ids": [
        176
      ],
      "start": 354.96,
      "end": 358.96,
      "text": "आप कहेंगे कि यह तो नॉर्मली तो होता ही"
    },
    {
      "subtitle_ids": [
        177
      ],
      "start": 356.72,
      "end": 360.639,
      "text": "होगा। नहीं। यहां पर डाटा यह कहता है कि"
    },
    {
      "subtitle_ids": [
        178
      ],
      "start": 358.96,
      "end": 362.8,
      "text": "लास्ट के पांच दिन का जो एवरेज वॉल्यूम"
    },
    {
      "subtitle_ids": [
        179
      ],
      "start": 360.639,
      "end": 365.28,
      "text": "देखा जाए तो वह सिर्फ 700 कॉन्ट्रैक्ट्स"
    },
    {
      "subtitle_ids": [
        180
      ],
      "start": 362.8,
      "end": 367.759,
      "text": "के एवरेज का था। अब यहां पर 700 से ट्रंप"
    },
    {
      "subtitle_ids": [
        181
      ],
      "start": 365.28,
      "end": 369.6,
      "text": "की पोस्ट से पहले सीधा 6200 का जंप यहां"
    },
    {
      "subtitle_ids": [
        182
      ],
      "start": 367.759,
      "end": 371.919,
      "text": "पर देखने मिला जो कि एवरेज वॉल्यूम से"
    },
    {
      "subtitle_ids": [
        183
      ],
      "start": 369.6,
      "end": 373.84,
      "text": "लगभग नौ गुना ज्यादा था। इसका एक ही मतलब"
    },
    {
      "subtitle_ids": [
        184
      ],
      "start": 371.919,
      "end": 375.44,
      "text": "निकाला जा सकता है कि कुछ लोगों को डॉन्ड"
    },
    {
      "subtitle_ids": [
        185
      ],
      "start": 373.84,
      "end": 377.039,
      "text": "ट्रंप की इस आने वाली पोस्ट के बारे में"
    },
    {
      "subtitle_ids": [
        186
      ],
      "start": 375.44,
      "end": 378.8,
      "text": "पता था। जिसके चलते उन्होंने पोस्ट से"
    },
    {
      "subtitle_ids": [
        187
      ],
      "start": 377.039,
      "end": 381.039,
      "text": "पहले पोजीशन ली और जैसे ही क्रूड ऑयल की"
    },
    {
      "subtitle_ids": [
        188
      ],
      "start": 378.8,
      "end": 383.12,
      "text": "प्राइसेस 15% गिरी वैसे ही अच्छे खासे"
    },
    {
      "subtitle_ids": [
        189
      ],
      "start": 381.039,
      "end": 385.12,
      "text": "मिलियंस ऑफ डॉलर्स उन्होंने पैसे बनाए और"
    },
    {
      "subtitle_ids": [
        190
      ],
      "start": 383.12,
      "end": 386.88,
      "text": "मार्केट से निकल गए। अब आप कहेंगे कि अगर"
    },
    {
      "subtitle_ids": [
        191
      ],
      "start": 385.12,
      "end": 388.72,
      "text": "खुलेआम मैनपुलेशन हो रहा है तो वहां पर जो"
    },
    {
      "subtitle_ids": [
        192
      ],
      "start": 386.88,
      "end": 390.08,
      "text": "रेगुलेटर है या रेगुलेटरी बोर्ड है वह"
    },
    {
      "subtitle_ids": [
        193
      ],
      "start": 388.72,
      "end": 392.0,
      "text": "क्या कर रहा है? तो देखिए यूएसए में"
    },
    {
      "subtitle_ids": [
        194
      ],
      "start": 390.08,
      "end": 394.16,
      "text": "कमोडिटी फ्यूचर्स ट्रेडिंग कमीशन यानी"
    },
    {
      "subtitle_ids": [
        195
      ],
      "start": 392.0,
      "end": 396.16,
      "text": "सीएफटीसी के अंडर आती है। कोई भी गड़बड़ी"
    },
    {
      "subtitle_ids": [
        196
      ],
      "start": 394.16,
      "end": 397.44,
      "text": "हो तो उस पर एक्शन लेना सीएफटीसी का काम"
    },
    {
      "subtitle_ids": [
        197
      ],
      "start": 396.16,
      "end": 399.039,
      "text": "है। अब सवाल ये आता है कि क्लियर"
    },
    {
      "subtitle_ids": [
        198
      ],
      "start": 397.44,
      "end": 400.8,
      "text": "मैनिपुलेशन जब आम लोगों को दिख रहा है तो"
    },
    {
      "subtitle_ids": [
        199
      ],
      "start": 399.039,
      "end": 402.56,
      "text": "सीएफटीसी एक्शन क्यों नहीं ले रही है? अब"
    },
    {
      "subtitle_ids": [
        200
      ],
      "start": 400.8,
      "end": 404.319,
      "text": "देखिए ट्रंप जो है मैनिपुलेशन के बादशाह"
    },
    {
      "subtitle_ids": [
        201
      ],
      "start": 402.56,
      "end": 406.479,
      "text": "हैं तो उन्होंने क्या किया ये इंटरेस्टिंग"
    },
    {
      "subtitle_ids": [
        202
      ],
      "start": 404.319,
      "end": 409.12,
      "text": "है। उन्होंने क्या किया लास्ट दिसंबर में"
    },
    {
      "subtitle_ids": [
        203
      ],
      "start": 406.479,
      "end": 411.199,
      "text": "अपने एक खास इंसान जिसका नाम है माइकल एस"
    },
    {
      "subtitle_ids": [
        204
      ],
      "start": 409.12,
      "end": 413.28,
      "text": "सेलिक को उन्होंने सीएफटीसी का हेड बना"
    },
    {
      "subtitle_ids": [
        205
      ],
      "start": 411.199,
      "end": 415.12,
      "text": "दिया। यानी कि अब सीएफटीसी ट्रंप पर कोई"
    },
    {
      "subtitle_ids": [
        206
      ],
      "start": 413.28,
      "end": 416.56,
      "text": "एक्शन नहीं लेगी क्योंकि वहां पर ट्रंप का"
    },
    {
      "subtitle_ids": [
        207
      ],
      "start": 415.12,
      "end": 418.479,
      "text": "ही आदमी बैठा हुआ है। यह तो हो गई अब"
    },
    {
      "subtitle_ids": [
        208
      ],
      "start": 416.56,
      "end": 420.08,
      "text": "क्रूड ऑयल की बात लेकिन बात यहीं पर खत्म"
    },
    {
      "subtitle_ids": [
        209
      ],
      "start": 418.479,
      "end": 421.84,
      "text": "नहीं होती है। ट्रंप के फैमिली मेंबर का"
    },
    {
      "subtitle_ids": [
        210
      ],
      "start": 420.08,
      "end": 423.68,
      "text": "कनेक्शन एक प्रेडिक्शन ऐप से भी है जिसका"
    },
    {
      "subtitle_ids": [
        211
      ],
      "start": 421.84,
      "end": 425.599,
      "text": "नाम है पॉली मार्केट जो कि एक गैंबलिंग ऐप"
    },
    {
      "subtitle_ids": [
        212
      ],
      "start": 423.68,
      "end": 427.199,
      "text": "है। आजकल में भी उसके ऐड आने लगे हैं"
    },
    {
      "subtitle_ids": [
        213
      ],
      "start": 425.599,
      "end": 429.039,
      "text": "जिसमें लोग फ्यूचर प्रेडिक्ट करके पैसा"
    },
    {
      "subtitle_ids": [
        214
      ],
      "start": 427.199,
      "end": 431.039,
      "text": "कमाते हैं और इस ऐप में ट्रंप जूनियर का"
    },
    {
      "subtitle_ids": [
        215
      ],
      "start": 429.039,
      "end": 432.88,
      "text": "वेंचर कैपिटल फर्म भी इन्वेस्टर है। पास्ट"
    },
    {
      "subtitle_ids": [
        216
      ],
      "start": 431.039,
      "end": 434.639,
      "text": "में ऐसा देखा गया है कि पॉली मार्केट पर"
    },
    {
      "subtitle_ids": [
        217
      ],
      "start": 432.88,
      "end": 436.639,
      "text": "कुछ अकाउंट्स हैं। वो एकदम सटीक"
    },
    {
      "subtitle_ids": [
        218
      ],
      "start": 434.639,
      "end": 438.4,
      "text": "प्रेडिक्शन करते हैं। अब जब यूएसए ने ईरान"
    },
    {
      "subtitle_ids": [
        219
      ],
      "start": 436.639,
      "end": 440.24,
      "text": "पर अटैक किया तो पूरी दुनिया शॉक में थी"
    },
    {
      "subtitle_ids": [
        220
      ],
      "start": 438.4,
      "end": 442.0,
      "text": "कि यूएस ने ऐसा क्यों किया? लेकिन पॉली"
    },
    {
      "subtitle_ids": [
        221
      ],
      "start": 440.24,
      "end": 443.68,
      "text": "मार्केट पर छह अकाउंट्स ऐसे थे जिन्होंने"
    },
    {
      "subtitle_ids": [
        222
      ],
      "start": 442.0,
      "end": 446.639,
      "text": "100 करोड़ कमाए यह प्रेडिक्ट करके कि"
    },
    {
      "subtitle_ids": [
        223
      ],
      "start": 443.68,
      "end": 448.319,
      "text": "नेक्स्ट 48 आवर्स में यूएस ईरान पर अटैक"
    },
    {
      "subtitle_ids": [
        224
      ],
      "start": 446.639,
      "end": 449.84,
      "text": "करने वाला है। अब इसके बाद सिर्फ यूएस"
    },
    {
      "subtitle_ids": [
        225
      ],
      "start": 448.319,
      "end": 451.919,
      "text": "नहीं बल्कि पूरी दुनिया भर में पॉली"
    },
    {
      "subtitle_ids": [
        226
      ],
      "start": 449.84,
      "end": 453.84,
      "text": "मार्केट पर सवाल उठने लगे और लोगों को भी"
    },
    {
      "subtitle_ids": [
        227
      ],
      "start": 451.919,
      "end": 455.52,
      "text": "लगने लगा कि इस प्लेटफार्म पर कुछ लोग हैं"
    },
    {
      "subtitle_ids": [
        228
      ],
      "start": 453.84,
      "end": 457.36,
      "text": "जिन्हें ट्रंप कोई एक्शन लेने से पहले ही"
    },
    {
      "subtitle_ids": [
        229
      ],
      "start": 455.52,
      "end": 458.88,
      "text": "मैसेज करते हो। अब ये छह लोग कौन हैं जो"
    },
    {
      "subtitle_ids": [
        230
      ],
      "start": 457.36,
      "end": 460.24,
      "text": "बराबर प्रेडिक्शन कर रहे हैं उनकी डिटेल्स"
    },
    {
      "subtitle_ids": [
        231
      ],
      "start": 458.88,
      "end": 461.599,
      "text": "पता करना काफी मुश्किल है और इस"
    },
    {
      "subtitle_ids": [
        232
      ],
      "start": 460.24,
      "end": 463.28,
      "text": "प्लेटफार्म पर मेनली ट्रांजैक्शंस"
    },
    {
      "subtitle_ids": [
        233
      ],
      "start": 461.599,
      "end": 465.44,
      "text": "क्रिप्टो के जरिए होते हैं। तो ट्रैकिंग"
    },
    {
      "subtitle_ids": [
        234
      ],
      "start": 463.28,
      "end": 467.28,
      "text": "इज वेरी टफ। इसी प्लेटफार्म पर एक अकाउंट"
    },
    {
      "subtitle_ids": [
        235
      ],
      "start": 465.44,
      "end": 469.36,
      "text": "होल्डर ने तो एकदम सही प्रेडिक्ट किया था"
    },
    {
      "subtitle_ids": [
        236
      ],
      "start": 467.28,
      "end": 471.44,
      "text": "कि वेनेजुएला के प्रेसिडेंट मधुरो को यूएस"
    },
    {
      "subtitle_ids": [
        237
      ],
      "start": 469.36,
      "end": 473.44,
      "text": "कैप्चर कर लेगा। जिसके बाद उसने तकरीबन"
    },
    {
      "subtitle_ids": [
        238
      ],
      "start": 471.44,
      "end": 475.68,
      "text": "₹400 करोड़ जीते थे। तो अगर देखा जाए तो"
    },
    {
      "subtitle_ids": [
        239
      ],
      "start": 473.44,
      "end": 478.4,
      "text": "पॉली मार्केट ग्लोबल इवेंट्स को प्रेडिक्ट"
    },
    {
      "subtitle_ids": [
        240
      ],
      "start": 475.68,
      "end": 480.479,
      "text": "करने में 90% एक्यूरेट है और यह चीज काफी"
    },
    {
      "subtitle_ids": [
        241
      ],
      "start": 478.4,
      "end": 482.08,
      "text": "अनयूजुअल है। वहीं अगर स्टॉक मार्केट की"
    },
    {
      "subtitle_ids": [
        242
      ],
      "start": 480.479,
      "end": 483.68,
      "text": "बात करें तो डॉन्ड ट्रंप पर दर्जनों बार"
    },
    {
      "subtitle_ids": [
        243
      ],
      "start": 482.08,
      "end": 485.52,
      "text": "ये आरोप हो चुके हैं कि डॉनल्ड ट्रंप"
    },
    {
      "subtitle_ids": [
        244
      ],
      "start": 483.68,
      "end": 487.52,
      "text": "स्टॉक मार्केट को मैनपुलेट करते हैं। भले"
    },
    {
      "subtitle_ids": [
        245
      ],
      "start": 485.52,
      "end": 489.44,
      "text": "ही वो टेरिफ का टाइम हो या फिर रशिया"
    },
    {
      "subtitle_ids": [
        246
      ],
      "start": 487.52,
      "end": 491.36,
      "text": "यूक्रेन वॉर का टाइम हो। सैड रियलिटी यह"
    },
    {
      "subtitle_ids": [
        247
      ],
      "start": 489.44,
      "end": 493.44,
      "text": "है कि दुनिया के सबसे पावरफुल कंट्री का"
    },
    {
      "subtitle_ids": [
        248
      ],
      "start": 491.36,
      "end": 495.12,
      "text": "प्रेसिडेंट आज ऐसी हरकतें कर रहा है और यह"
    },
    {
      "subtitle_ids": [
        249
      ],
      "start": 493.44,
      "end": 496.96,
      "text": "ऐसे देश में हो रहा है जहां पर आम नागरिक"
    },
    {
      "subtitle_ids": [
        250
      ],
      "start": 495.12,
      "end": 498.879,
      "text": "के लिए लॉस काफी स्ट्रिक्ट है। मॉल से कुछ"
    },
    {
      "subtitle_ids": [
        251
      ],
      "start": 496.96,
      "end": 500.4,
      "text": "उठा लो तो एकद साल की जेल यहां पर हो जाती"
    },
    {
      "subtitle_ids": [
        252
      ],
      "start": 498.879,
      "end": 502.08,
      "text": "है और यहां पर प्रेसिडेंट खुद मार्केट"
    },
    {
      "subtitle_ids": [
        253
      ],
      "start": 500.4,
      "end": 503.919,
      "text": "मैनिपुलेशन कर रहा है। पर्सनली मैं"
    },
    {
      "subtitle_ids": [
        254
      ],
      "start": 502.08,
      "end": 505.919,
      "text": "बिल्कुल शॉक नहीं होऊंगा अगर डोनल्ड ट्रंप"
    },
    {
      "subtitle_ids": [
        255
      ],
      "start": 503.919,
      "end": 507.919,
      "text": "प्रेसिडेंसी खत्म होने के बाद घर के बजाय"
    },
    {
      "subtitle_ids": [
        256
      ],
      "start": 505.919,
      "end": 509.599,
      "text": "जेल चले जाए तो। अब यहां पर एक सैड न्यूज़"
    },
    {
      "subtitle_ids": [
        257
      ],
      "start": 507.919,
      "end": 511.919,
      "text": "की आपको याद दिलाता हूं कि ट्रंप को आए"
    },
    {
      "subtitle_ids": [
        258
      ],
      "start": 509.599,
      "end": 514.0,
      "text": "हुए अभी तक सिर्फ 14 टू 15 मंथ्स ही हुए"
    },
    {
      "subtitle_ids": [
        259
      ],
      "start": 511.919,
      "end": 515.599,
      "text": "हैं। अभी 2 साल 9 महीने बाकी है। आज"
    },
    {
      "subtitle_ids": [
        260
      ],
      "start": 514.0,
      "end": 517.519,
      "text": "मार्केट जरूर बढ़ा है। लेकिन पिछले 14"
    },
    {
      "subtitle_ids": [
        261
      ],
      "start": 515.599,
      "end": 519.36,
      "text": "मंथ्स में इंडियन मार्केट जहां था आज वही"
    },
    {
      "subtitle_ids": [
        262
      ],
      "start": 517.519,
      "end": 521.12,
      "text": "है। तो सोचिए अगले 2 साल 10 महीने में"
    },
    {
      "subtitle_ids": [
        263
      ],
      "start": 519.36,
      "end": 522.88,
      "text": "क्या होगा? यह सोच के ही घबराहट होती है।"
    },
    {
      "subtitle_ids": [
        264
      ],
      "start": 521.12,
      "end": 524.88,
      "text": "अब यहां पर खैर जो सीज फायर है वो दो"
    },
    {
      "subtitle_ids": [
        265
      ],
      "start": 522.88,
      "end": 526.88,
      "text": "हफ्ते की है। अब आगे क्या होता है वहां से"
    },
    {
      "subtitle_ids": [
        266
      ],
      "start": 524.88,
      "end": 528.64,
      "text": "एक्साइटमेंट फिर से शुरू हो जाएगी। अगर यह"
    },
    {
      "subtitle_ids": [
        267
      ],
      "start": 526.88,
      "end": 530.959,
      "text": "वॉर फिर से कंटिन्यू रहता है और प्रॉब्लम"
    },
    {
      "subtitle_ids": [
        268
      ],
      "start": 528.64,
      "end": 533.6,
      "text": "बीच में डोन्ड ट्रंप के कुछ और मैनपुलेशन"
    },
    {
      "subtitle_ids": [
        269
      ],
      "start": 530.959,
      "end": 535.279,
      "text": "के मूव्स तो जरूर होंगे। तो ऐसे में तुरंत"
    },
    {
      "subtitle_ids": [
        270
      ],
      "start": 533.6,
      "end": 537.12,
      "text": "एक्साइटमेंट होके सारा पैसा मत डालिए"
    },
    {
      "subtitle_ids": [
        271
      ],
      "start": 535.279,
      "end": 539.04,
      "text": "मार्केट में। जो जो अंडरवैल्यूड स्टॉक्स"
    },
    {
      "subtitle_ids": [
        272
      ],
      "start": 537.12,
      "end": 540.8,
      "text": "हैं प्रॉपर उन्हें ढूंढिए और धीरे-धीरे"
    },
    {
      "subtitle_ids": [
        273
      ],
      "start": 539.04,
      "end": 542.399,
      "text": "थोड़ा-थोड़ा करके उसमें इन्वेस्ट कीजिए।"
    },
    {
      "subtitle_ids": [
        274
      ],
      "start": 540.8,
      "end": 544.08,
      "text": "यही हम कर सकते हैं। ऑलरेडी इन्वेस्टेड है"
    },
    {
      "subtitle_ids": [
        275
      ],
      "start": 542.399,
      "end": 545.92,
      "text": "तो होल्ड कीजिए क्योंकि मार्केट जितना"
    },
    {
      "subtitle_ids": [
        276
      ],
      "start": 544.08,
      "end": 547.68,
      "text": "तेजी से गिरता है उतना ही तेजी से रिकवर"
    },
    {
      "subtitle_ids": [
        277
      ],
      "start": 545.92,
      "end": 549.76,
      "text": "भी होता है। और ट्रंप के इन झूठी चीजों की"
    },
    {
      "subtitle_ids": [
        278
      ],
      "start": 547.68,
      "end": 551.839,
      "text": "मार्केट को एक बार आदत हो गई तो फिर शायद"
    },
    {
      "subtitle_ids": [
        279
      ],
      "start": 549.76,
      "end": 553.6,
      "text": "मार्केट भी उनके हिसाब से चलना बंद हो"
    },
    {
      "subtitle_ids": [
        280
      ],
      "start": 551.839,
      "end": 555.44,
      "text": "जाएगा। बट उसमें थोड़ा टाइम लगेगा। तो अभी"
    },
    {
      "subtitle_ids": [
        281
      ],
      "start": 553.6,
      "end": 557.12,
      "text": "दो वीक्स के टाइम के लिए वॉर रुक गया है।"
    },
    {
      "subtitle_ids": [
        282
      ],
      "start": 555.44,
      "end": 559.36,
      "text": "क्या ट्रंप फिर से मुकर जाएंगे? कमेंट"
    },
    {
      "subtitle_ids": [
        283
      ],
      "start": 557.12,
      "end": 560.959,
      "text": "करके जरूर बताइए। और हां, जाते-जाते pro"
    },
    {
      "subtitle_ids": [
        284
      ],
      "start": 559.36,
      "end": 563.519,
      "text": "कम्युनिटी को जरूर चेक आउट कीजिए। इस बड़ी"
    },
    {
      "subtitle_ids": [
        285
      ],
      "start": 560.959,
      "end": 565.279,
      "text": "ऑफर में आपको pro के साथ टाइम्स भी मिलेगा"
    },
    {
      "subtitle_ids": [
        286
      ],
      "start": 563.519,
      "end": 566.72,
      "text": "जिससे डेली मार्केट में जो भी एक्टिविटीज"
    },
    {
      "subtitle_ids": [
        287
      ],
      "start": 565.279,
      "end": 568.24,
      "text": "हो रही है बड़ी-बड़ी वो आप तक पहुंच ही"
    },
    {
      "subtitle_ids": [
        288
      ],
      "start": 566.72,
      "end": 569.92,
      "text": "जाएगी। साथ ही हर महीने मार्केट की जो"
    },
    {
      "subtitle_ids": [
        289
      ],
      "start": 568.24,
      "end": 572.0,
      "text": "अपोरर्चुनिटीज है स्टॉक अपोरर्चुनिटीज"
    },
    {
      "subtitle_ids": [
        290
      ],
      "start": 569.92,
      "end": 574.0,
      "text": "उसके स्टॉक रिसर्च रिपोर्ट आपको मिलेंगे।"
    },
    {
      "subtitle_ids": [
        291
      ],
      "start": 572.0,
      "end": 575.68,
      "text": "सो डोंट मिस आउट ऑन दिस ओपोरर्चुनिटी लिंक"
    },
    {
      "subtitle_ids": [
        292
      ],
      "start": 574.0,
      "end": 576.959,
      "text": "नीचे दी गई है। तो फिलहाल यहीं पर रुकते"
    },
    {
      "subtitle_ids": [
        293
      ],
      "start": 575.68,
      "end": 581.16,
      "text": "हैं। मिलते हैं अगले वीडियो में। थैंक यू"
    },
    {
      "subtitle_ids": [
        294
      ],
      "start": 576.959,
      "end": 581.16,
      "text": "सो मच। बाय-ब एंड टेक केयर।"
    }
  ]
}