  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.04,
      "end": 4.839,
      "text": "अभी 13 फरवरी को ही पीएम मोदी ने पीएम"
    },
    {
      "subtitle_id": 2,
      "start": 2.56,
      "end": 7.6,
      "text": "सूर्य घर योजना लॉन्च की है जिसके अंदर"
    },
    {
      "subtitle_id": 3,
      "start": 4.839,
      "end": 9.8,
      "text": "आपको ₹ 78000 की सब्सिडी मिल सकती है अगर"
    },
    {
      "subtitle_id": 4,
      "start": 7.6,
      "end": 11.44,
      "text": "आप अपने घर के ऊपर सोलर पैनल लगाते हैं तो"
    },
    {
      "subtitle_id": 5,
      "start": 9.8,
      "end": 13.559,
      "text": "लेकिन जैसे ही स्कीम आई इसके साथ काफी"
    },
    {
      "subtitle_id": 6,
      "start": 11.44,
      "end": 15.48,
      "text": "सारे सवाल भी आ गए कि क्या मैं इस स्कीम"
    },
    {
      "subtitle_id": 7,
      "start": 13.559,
      "end": 17.199,
      "text": "के लिए एलिजिबल हूं अगर हूं तो कितना पैसा"
    },
    {
      "subtitle_id": 8,
      "start": 15.48,
      "end": 20.119,
      "text": "मुझे इन्वेस्ट करना है और कितना सब्सिडी"
    },
    {
      "subtitle_id": 9,
      "start": 17.199,
      "end": 22.76,
      "text": "से आएगा और क्या यह सही में इकोनॉमिक सेंस"
    },
    {
      "subtitle_id": 10,
      "start": 20.119,
      "end": 24.519,
      "text": "बनाता है इस सब्सिडी के साथ जाना अगर हां"
    },
    {
      "subtitle_id": 11,
      "start": 22.76,
      "end": 26.16,
      "text": "तो जो वन टाइम इन्वेस्टमेंट मुझे करनी है"
    },
    {
      "subtitle_id": 12,
      "start": 24.519,
      "end": 28.4,
      "text": "क्या उसके लिए गवर्नमेंट लोन या कुछ"
    },
    {
      "subtitle_id": 13,
      "start": 26.16,
      "end": 30.679,
      "text": "फाइनेंस भी ऑफर कर रही है तो इन सारे"
    },
    {
      "subtitle_id": 14,
      "start": 28.4,
      "end": 32.8,
      "text": "सवालों के जवाब आपको इस वीडियो के एंड तक"
    },
    {
      "subtitle_id": 15,
      "start": 30.679,
      "end": 35.079,
      "text": "मिल जाएंगे हमने काफी डीप रिसर्च इस चीज"
    },
    {
      "subtitle_id": 16,
      "start": 32.8,
      "end": 37.0,
      "text": "पर किया है तो हर एक सवाल आपका जो भी आपके"
    },
    {
      "subtitle_id": 17,
      "start": 35.079,
      "end": 38.64,
      "text": "दिमाग में है उसका जवाब आपको इस वीडियो"
    },
    {
      "subtitle_id": 18,
      "start": 37.0,
      "end": 40.6,
      "text": "में मिल जाएगा इस वीडियो को अपने ज्यादा"
    },
    {
      "subtitle_id": 19,
      "start": 38.64,
      "end": 42.16,
      "text": "से ज्यादा दोस्तों के साथ लोगों के साथ"
    },
    {
      "subtitle_id": 20,
      "start": 40.6,
      "end": 44.239,
      "text": "ग्रुप में अपनी कॉलोनी के सर्कल में"
    },
    {
      "subtitle_id": 21,
      "start": 42.16,
      "end": 45.559,
      "text": "फ्रेंड सर्कल में जरूर शेयर कीजिए ताकि"
    },
    {
      "subtitle_id": 22,
      "start": 44.239,
      "end": 47.68,
      "text": "सभी को स्कीम के बारे में डिटेल"
    },
    {
      "subtitle_id": 23,
      "start": 45.559,
      "end": 49.96,
      "text": "इंफॉर्मेशन मिले और वो एक बेस्ट डिसीजन ले"
    },
    {
      "subtitle_id": 24,
      "start": 47.68,
      "end": 51.68,
      "text": "पाए कि वेदर टू गो विद दिस स्कीम र नॉट"
    },
    {
      "subtitle_id": 25,
      "start": 49.96,
      "end": 53.199,
      "text": "नमस्कार मैं प्रसाद आपका आज के इस वीडियो"
    },
    {
      "subtitle_id": 26,
      "start": 51.68,
      "end": 55.44,
      "text": "में स्वागत करता हूं इस स्कीम के लिए"
    },
    {
      "subtitle_id": 27,
      "start": 53.199,
      "end": 57.64,
      "text": "इंटरम बजट में फाइनेंस मिनिस्टर ने 75"
    },
    {
      "subtitle_id": 28,
      "start": 55.44,
      "end": 60.12,
      "text": "करोड़ का बजट एलोकेट किया है ताकि 1 करोड़"
    },
    {
      "subtitle_id": 29,
      "start": 57.64,
      "end": 62.8,
      "text": "घरों के ऊपर सोलर लगाया जाए और उससे लोग"
    },
    {
      "subtitle_id": 30,
      "start": 60.12,
      "end": 65.479,
      "text": "को 300 यूनिट पर मंथ मुफ्त बिजली का फायदा"
    },
    {
      "subtitle_id": 31,
      "start": 62.8,
      "end": 67.36,
      "text": "हो अब यह 300 यूनिट क्यों व भी आपको आगे"
    },
    {
      "subtitle_id": 32,
      "start": 65.479,
      "end": 71.439,
      "text": "पता चलेगा हालांकि पीएम मोदी का जो स्पीच"
    },
    {
      "subtitle_id": 33,
      "start": 67.36,
      "end": 74.84,
      "text": "था अयोध्या में इस बजट में एक और बहुत"
    },
    {
      "subtitle_id": 34,
      "start": 71.439,
      "end": 79.159,
      "text": "बड़ी योजना की घोषणा हुई है अब बिजली का"
    },
    {
      "subtitle_id": 35,
      "start": 74.84,
      "end": 81.2,
      "text": "बिल भी जीरो करने के लिए हम आगे बढ़ रहे"
    },
    {
      "subtitle_id": 36,
      "start": 79.159,
      "end": 82.479,
      "text": "हैं उसमें उन्होंने इस चीज का जिक्र किया"
    },
    {
      "subtitle_id": 37,
      "start": 81.2,
      "end": 83.96,
      "text": "था तो जिसमें लोगों के मन में भी"
    },
    {
      "subtitle_id": 38,
      "start": 82.479,
      "end": 85.72,
      "text": "क्यूरियोसिटी थी कि एगजैक्टली ये स्कीम"
    },
    {
      "subtitle_id": 39,
      "start": 83.96,
      "end": 87.759,
      "text": "क्या है और क्या कुछ इसके बेनिफिट्स और"
    },
    {
      "subtitle_id": 40,
      "start": 85.72,
      "end": 89.96,
      "text": "बाकी चीजें हैं तो चलिए स्टेप बाय स्टेप"
    },
    {
      "subtitle_id": 41,
      "start": 87.759,
      "end": 91.32,
      "text": "इसे जानते हैं बट इससे पहले कंफ्यूजन कई"
    },
    {
      "subtitle_id": 42,
      "start": 89.96,
      "end": 93.72,
      "text": "सारे लोगों के बीच में है वो यह है कि"
    },
    {
      "subtitle_id": 43,
      "start": 91.32,
      "end": 95.92,
      "text": "2019 में गवर्नमेंट इसी तरह की एक स्कीम"
    },
    {
      "subtitle_id": 44,
      "start": 93.72,
      "end": 97.56,
      "text": "लाई थी जिसका नाम था पीएम सूर्योदय योजना"
    },
    {
      "subtitle_id": 45,
      "start": 95.92,
      "end": 99.439,
      "text": "और अभी जो स्कीम लाई है उसका नाम है पीएम"
    },
    {
      "subtitle_id": 46,
      "start": 97.56,
      "end": 101.32,
      "text": "सूर्य घर मुफ्त बिजली योजना तो दोनों के"
    },
    {
      "subtitle_id": 47,
      "start": 99.439,
      "end": 103.079,
      "text": "बीच में क्या फर्क है नहीं है तो अभी की"
    },
    {
      "subtitle_id": 48,
      "start": 101.32,
      "end": 105.52,
      "text": "जो स्कीम है पीएम सूर्य घर वो पीएम"
    },
    {
      "subtitle_id": 49,
      "start": 103.079,
      "end": 108.399,
      "text": "सूर्योदय का ही अपडेटेड वर्जन है ठीक है"
    },
    {
      "subtitle_id": 50,
      "start": 105.52,
      "end": 110.56,
      "text": "तो दोनों सेम ही है और इस चीज के लिए आपको"
    },
    {
      "subtitle_id": 51,
      "start": 108.399,
      "end": 112.32,
      "text": "जो वेबसाइट यूज़ करनी है वो आप नोट डाउन"
    },
    {
      "subtitle_id": 52,
      "start": 110.56,
      "end": 116.119,
      "text": "कीजिए वह यही वेबसाइट आपको यूज़ करनी है"
    },
    {
      "subtitle_id": 53,
      "start": 112.32,
      "end": 117.64,
      "text": "उसका नाम है पीएम सूर्यो घर jov.in देखिए"
    },
    {
      "subtitle_id": 54,
      "start": 116.119,
      "end": 119.2,
      "text": "जब इस तरह की गवर्नमेंट स्कीम्स आती है तो"
    },
    {
      "subtitle_id": 55,
      "start": 117.64,
      "end": 120.68,
      "text": "कई सारी फेक वेबसाइट मार्केट में आ जाती"
    },
    {
      "subtitle_id": 56,
      "start": 119.2,
      "end": 122.32,
      "text": "है जो कि किसी ना किसी प्रकार आपकी"
    },
    {
      "subtitle_id": 57,
      "start": 120.68,
      "end": 124.039,
      "text": "इंफॉर्मेशन लेने की कोशिश करते हैं और बाद"
    },
    {
      "subtitle_id": 58,
      "start": 122.32,
      "end": 125.799,
      "text": "में आपसे फ्रॉड करने की कोशिश करते हैं एक"
    },
    {
      "subtitle_id": 59,
      "start": 124.039,
      "end": 128.08,
      "text": "चीज ध्यान में रखना गवर्नमेंट वेबसाइट तो"
    },
    {
      "subtitle_id": 60,
      "start": 125.799,
      "end": 129.679,
      "text": "jov.in ही रहेगा और इस स्कीम के लिए सिर्फ"
    },
    {
      "subtitle_id": 61,
      "start": 128.08,
      "end": 131.56,
      "text": "यही वेबसाइट से आपको अप्लाई करना है और"
    },
    {
      "subtitle_id": 62,
      "start": 129.679,
      "end": 133.04,
      "text": "कोई भी वेबसाइट आपको यूज नहीं करनी है अब"
    },
    {
      "subtitle_id": 63,
      "start": 131.56,
      "end": 134.56,
      "text": "इस वेबसाइट पर जाने से पहले हमें ये तो"
    },
    {
      "subtitle_id": 64,
      "start": 133.04,
      "end": 137.04,
      "text": "समझना पड़ेगा कि इसका एलिजिबिलिटी"
    },
    {
      "subtitle_id": 65,
      "start": 134.56,
      "end": 138.599,
      "text": "क्राइटेरिया क्या है तो देखिए सारे इंडिया"
    },
    {
      "subtitle_id": 66,
      "start": 137.04,
      "end": 140.92,
      "text": "के जो सारे रेजिडेंट्स हैं वो स्कीम के"
    },
    {
      "subtitle_id": 67,
      "start": 138.599,
      "end": 143.12,
      "text": "लिए एलिजिबल है दूसरी चीज आपका घर इंडिया"
    },
    {
      "subtitle_id": 68,
      "start": 140.92,
      "end": 145.239,
      "text": "में होना चाहिए और तीसरी चीज आपने अगर कोई"
    },
    {
      "subtitle_id": 69,
      "start": 143.12,
      "end": 147.84,
      "text": "ऑलरेडी पहले सोलर सब्सिडी ली है तो आपको"
    },
    {
      "subtitle_id": 70,
      "start": 145.239,
      "end": 149.56,
      "text": "इस स्कीम का फायदा नहीं होगा अगर आपने कोई"
    },
    {
      "subtitle_id": 71,
      "start": 147.84,
      "end": 151.56,
      "text": "भी सोलर स्कीम का फायदा अभी तक नहीं लिया"
    },
    {
      "subtitle_id": 72,
      "start": 149.56,
      "end": 153.319,
      "text": "है तो आप इस स्कीम का फायदा ले सकते हैं"
    },
    {
      "subtitle_id": 73,
      "start": 151.56,
      "end": 154.959,
      "text": "और चौथी चीज यह है कि प्रधानमंत्री आवास"
    },
    {
      "subtitle_id": 74,
      "start": 153.319,
      "end": 157.239,
      "text": "योजना के अंडर बहुत सारे लोगों ने अपना घर"
    },
    {
      "subtitle_id": 75,
      "start": 154.959,
      "end": 159.4,
      "text": "बनाया था तो वो लोग भी इस चीज का फायदा ले"
    },
    {
      "subtitle_id": 76,
      "start": 157.239,
      "end": 161.68,
      "text": "सकते हैं अब एलिजिबल तो है अब आगे क्या"
    },
    {
      "subtitle_id": 77,
      "start": 159.4,
      "end": 162.519,
      "text": "करना है तो सबसे पहले आपको इस वेबसाइट पर"
    },
    {
      "subtitle_id": 78,
      "start": 161.68,
      "end": 165.68,
      "text": "जाना है"
    },
    {
      "subtitle_id": 79,
      "start": 162.519,
      "end": 168.0,
      "text": "pmgov.in यहां पर आपको रजिस्ट्रेशन करना"
    },
    {
      "subtitle_id": 80,
      "start": 165.68,
      "end": 169.8,
      "text": "है कंज्यूमर रजिस्ट्रेशन रजिस्ट्रेशन के"
    },
    {
      "subtitle_id": 81,
      "start": 168.0,
      "end": 171.12,
      "text": "टाइम आपसे तीन-चार चीजें पूछी जाएगी कौन"
    },
    {
      "subtitle_id": 82,
      "start": 169.8,
      "end": 173.159,
      "text": "से स्टेट से आप हो इलेक्ट्रिसिटी"
    },
    {
      "subtitle_id": 83,
      "start": 171.12,
      "end": 175.0,
      "text": "डिस्ट्रीब्यूशन कंपनी कौन सी है आपका"
    },
    {
      "subtitle_id": 84,
      "start": 173.159,
      "end": 176.48,
      "text": "इलेक्ट्रिसिटी कंज्यूमर नंबर मांगा जाएगा"
    },
    {
      "subtitle_id": 85,
      "start": 175.0,
      "end": 178.28,
      "text": "जो कि आपके इलेक्ट्रिसिटी बिल पर आपको"
    },
    {
      "subtitle_id": 86,
      "start": 176.48,
      "end": 180.319,
      "text": "मिलेगा और आपके कुछ बेसिक डिटेल्स ईमेल"
    },
    {
      "subtitle_id": 87,
      "start": 178.28,
      "end": 181.8,
      "text": "आईडी मोबाइल नंबर आपको डालना ना है उसके"
    },
    {
      "subtitle_id": 88,
      "start": 180.319,
      "end": 183.68,
      "text": "बाद आपको एक फॉर्म फिल अप करना है जहां पर"
    },
    {
      "subtitle_id": 89,
      "start": 181.8,
      "end": 185.64,
      "text": "आपसे पूछा जाएगा कि कौन से टाइप का का"
    },
    {
      "subtitle_id": 90,
      "start": 183.68,
      "end": 187.76,
      "text": "कनेक्शन है सिंगल फेज है या फिर थ्री फेज"
    },
    {
      "subtitle_id": 91,
      "start": 185.64,
      "end": 189.799,
      "text": "है कैटेगरी प्लान कैपेसिटर बाकी चीजें जो"
    },
    {
      "subtitle_id": 92,
      "start": 187.76,
      "end": 192.0,
      "text": "भी आपको इलेक्ट्रिसिटी बिल पर मिल जाएगी"
    },
    {
      "subtitle_id": 93,
      "start": 189.799,
      "end": 194.319,
      "text": "अब ये सारी चीजें सबमिट करने के बाद आपको"
    },
    {
      "subtitle_id": 94,
