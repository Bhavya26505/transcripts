  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.0,
      "end": 4.56,
      "text": "लग्जरी होटल चन हायत को इंडिया में चैने"
    },
    {
      "subtitle_id": 2,
      "start": 2.159,
      "end": 7.12,
      "text": "वाली कंपनी का आईपीओ आ रहा है और इस कंपनी"
    },
    {
      "subtitle_id": 3,
      "start": 4.56,
      "end": 8.88,
      "text": "का नाम है जून परर होटल्स अब इंटरेस्टिंग"
    },
    {
      "subtitle_id": 4,
      "start": 7.12,
      "end": 11.04,
      "text": "चीज यह है कि लग्जरी हॉटल की जो डिमांड है"
    },
    {
      "subtitle_id": 5,
      "start": 8.88,
      "end": 12.799,
      "text": "पिछले टाइम में काफी ज्यादा बढी है तो ऐसे"
    },
    {
      "subtitle_id": 6,
      "start": 11.04,
      "end": 14.32,
      "text": "में अगर हम मेरिट की बात करें जो कि यूएस"
    },
    {
      "subtitle_id": 7,
      "start": 12.799,
      "end": 16.32,
      "text": "लिस्टेड कंपनी है जिसके इंडिया में कई"
    },
    {
      "subtitle_id": 8,
      "start": 14.32,
      "end": 18.119,
      "text": "सारे होटल्स हैं उसके अगर शेयर प्राइस की"
    },
    {
      "subtitle_id": 9,
      "start": 16.32,
      "end": 20.56,
      "text": "पिछले 10 साल की कंपाउंडेड सालाना ग्रोथ"
    },
    {
      "subtitle_id": 10,
      "start": 18.119,
      "end": 22.08,
      "text": "रेट देखें तो वो 27 पर है कंपाउंडेड"
    },
    {
      "subtitle_id": 11,
      "start": 20.56,
      "end": 24.039,
      "text": "सालाना जो कि बहुत ही एक्स्ट्राऑर्डिनरी"
    },
    {
      "subtitle_id": 12,
      "start": 22.08,
      "end": 26.08,
      "text": "है और कुछ इसी तरह की ग्रोथ रिसेंट टाइम"
    },
    {
      "subtitle_id": 13,
      "start": 24.039,
      "end": 28.8,
      "text": "में कुछ प्रीमियम होटल्स को मिल रही है तो"
    },
    {
      "subtitle_id": 14,
      "start": 26.08,
      "end": 30.48,
      "text": "क्या यह सेम चीज जुनी परर पर अप्लाई होगी"
    },
    {
      "subtitle_id": 15,
      "start": 28.8,
      "end": 32.0,
      "text": "यह समझने के लिए हमें इस बिनेस को बहुत"
    },
    {
      "subtitle_id": 16,
      "start": 30.48,
      "end": 34.8,
      "text": "समझना पड़ेगा क्योंकि ये बिजनेस बाकी"
    },
    {
      "subtitle_id": 17,
      "start": 32.0,
      "end": 36.6,
      "text": "बिजनेसेस से थोड़ा मुझे अलग लगता है क्यों"
    },
    {
      "subtitle_id": 18,
      "start": 34.8,
      "end": 38.36,
      "text": "अलग लगता है उसके बारे में बात करेंगे तो"
    },
    {
      "subtitle_id": 19,
      "start": 36.6,
      "end": 40.76,
      "text": "आज के इस वीडियो में जानेंगे कि इस बिजनेस"
    },
    {
      "subtitle_id": 20,
      "start": 38.36,
      "end": 43.0,
      "text": "में सही में ग्रोथ पोटेंशियल है सेकंड चीज"
    },
    {
      "subtitle_id": 21,
      "start": 40.76,
      "end": 44.8,
      "text": "हम जानेंगे कि वैल्यूएशन सही है और तीसरी"
    },
    {
      "subtitle_id": 22,
      "start": 43.0,
      "end": 46.879,
      "text": "चीज हम जानेंगे कि लिस्टिंग इन के क्या"
    },
    {
      "subtitle_id": 23,
      "start": 44.8,
      "end": 48.44,
      "text": "प्रोबेबिलिटीज यहां पर है नमस्कार मैं"
    },
    {
      "subtitle_id": 24,
      "start": 46.879,
      "end": 50.199,
      "text": "प्रसाद आपका आज के इस वीडियो में स्वागत"
    },
    {
      "subtitle_id": 25,
      "start": 48.44,
      "end": 52.52,
      "text": "करता हूं सब हायथ होटल्स आपने कई बार"
    },
    {
      "subtitle_id": 26,
      "start": 50.199,
      "end": 54.48,
      "text": "मुंबई दिल्ली बाकी जगह पर देखे होंगे इनकी"
    },
    {
      "subtitle_id": 27,
      "start": 52.52,
      "end": 56.28,
      "text": "इंडिया में जो प्रेजेंस है इसका सबसे बड़ा"
    },
    {
      "subtitle_id": 28,
      "start": 54.48,
      "end": 58.519,
      "text": "क्रेडिट जाता है राधेश्याम सराफ इस"
    },
    {
      "subtitle_id": 29,
      "start": 56.28,
      "end": 60.719,
      "text": "व्यक्ति को अब आप सोचेंगे कि हायत होटल्स"
    },
    {
      "subtitle_id": 30,
      "start": 58.519,
      "end": 63.199,
      "text": "कॉरपोरेशन यह तो अमेरिका की मल्टीनेशनल"
    },
    {
      "subtitle_id": 31,
      "start": 60.719,
      "end": 65.479,
      "text": "हॉस्पिटैलिटी कंपनी है तो राधेश्याम सराफ"
    },
    {
      "subtitle_id": 32,
      "start": 63.199,
      "end": 67.04,
      "text": "का इससे क्या लेना देना तो देखिए उसके लिए"
    },
    {
      "subtitle_id": 33,
      "start": 65.479,
      "end": 69.72,
      "text": "थोड़ा आपको हिस्ट्री समझनी पड़ेगी इस"
    },
    {
      "subtitle_id": 34,
      "start": 67.04,
      "end": 71.479,
      "text": "कंपनी की जनी पर की देखिए राधेश्याम सराफ"
    },
    {
      "subtitle_id": 35,
      "start": 69.72,
      "end": 73.32,
      "text": "इन्होंने शुरुआत में ट्रेडिंग का बिजनेस"
    },
    {
      "subtitle_id": 36,
      "start": 71.479,
      "end": 74.92,
      "text": "शुरू किया उसके बाद वो नेपाल चले गए वहां"
    },
    {
      "subtitle_id": 37,
      "start": 73.32,
      "end": 76.799,
      "text": "पर उन्होंने ट्रेडिंग का बिजनेस किया और"
    },
    {
      "subtitle_id": 38,
      "start": 74.92,
      "end": 78.68,
      "text": "वहां पर उन्होंने फिर एक हॉटल चैन शुरू की"
    },
    {
      "subtitle_id": 39,
      "start": 76.799,
      "end": 81.2,
      "text": "और इस हॉटल चैन का नाम उन्होंने रखा था यक"
    },
    {
      "subtitle_id": 40,
      "start": 78.68,
      "end": 83.079,
      "text": "एंड यटी औरन लाइटर नोट इस यती का रणवीर"
    },
    {
      "subtitle_id": 41,
      "start": 81.2,
      "end": 85.2,
      "text": "वाली यटी से कोई लेना देना नहीं है फिर"
    },
    {
      "subtitle_id": 42,
      "start": 83.079,
      "end": 88.4,
      "text": "1980 में मिस्टर सराफ ने हायत रीजेंसी की"
    },
    {
      "subtitle_id": 43,
      "start": 85.2,
      "end": 90.28,
      "text": "शुरुआत की दिल्ली में 1982 में एशियन"
    },
    {
      "subtitle_id": 44,
      "start": 88.4,
      "end": 92.32,
      "text": "गेम्स थे उससे 2 साल पहले पहले इन्होंने"
    },
    {
      "subtitle_id": 45,
      "start": 90.28,
      "end": 94.36,
      "text": "कंस्ट्रक्शन शुरू किया और एशियन गेम होने"
    },
    {
      "subtitle_id": 46,
      "start": 92.32,
      "end": 96.439,
      "text": "से पहले कंस्ट्रक्शन पूरा कर दिया ताकि"
    },
    {
      "subtitle_id": 47,
      "start": 94.36,
      "end": 98.799,
      "text": "बहुत सारे जो गेस्ट है वो हॉटल में रह सके"
    },
    {
      "subtitle_id": 48,
      "start": 96.439,
      "end": 100.6,
      "text": "और वहां से हॉटल का रेवेन्यू आए इसके बाद"
    },
    {
      "subtitle_id": 49,
      "start": 98.799,
      "end": 103.04,
      "text": "इन्होंने धीरे-धीरे एक्सपेंशन किया हायत"
    },
    {
      "subtitle_id": 50,
      "start": 100.6,
      "end": 105.92,
      "text": "का दिल्ली मुंबई अहमदाबाद लखनऊ वगैरह"
    },
    {
      "subtitle_id": 51,
      "start": 103.04,
      "end": 108.479,
      "text": "वगैरह तो आज हायत के टोटल सात होटल्स हैं"
    },
    {
      "subtitle_id": 52,
      "start": 105.92,
      "end": 111.36,
      "text": "ऑल ओवर इंडिया अलग-अलग लोकेशंस पर दिल्ली"
    },
    {
      "subtitle_id": 53,
      "start": 108.479,
      "end": 113.92,
      "text": "में दो है मुंबई में एक है अहमदाबाद लखनऊ"
    },
    {
      "subtitle_id": 54,
      "start": 111.36,
      "end": 116.039,
      "text": "हंपी में एक है और एक रायपुर में है तो"
    },
    {
      "subtitle_id": 55,
      "start": 113.92,
      "end": 118.36,
      "text": "जूनिपर हॉटल एक स्ट्रेटेजिक पार्टनरशिप है"
    },
    {
      "subtitle_id": 56,
      "start": 116.039,
      "end": 120.439,
      "text": "राधेश्याम सराफ इनकी कंपनी की जिसका नाम"
    },
    {
      "subtitle_id": 57,
      "start": 118.36,
      "end": 122.399,
      "text": "है सराफ होटल्स लिमिटेड और टू सेज"
    },
    {
      "subtitle_id": 58,
      "start": 120.439,
      "end": 125.079,
      "text": "होल्डिंग लिमिटेड के बीच में और टू सेज"
    },
    {
      "subtitle_id": 59,
      "start": 122.399,
      "end": 127.479,
      "text": "लिमिटेड जो है वह हाय होटल्स कॉरपोरेशन की"
    },
    {
      "subtitle_id": 60,
      "start": 125.079,
      "end": 129.56,
      "text": "अफिटेक कंपनी है तो इस तरह से जूनिपर होटल"
    },
    {
      "subtitle_id": 61,
      "start": 127.479,
      "end": 131.72,
      "text": "एज अ स्ट्रेटेजिक पार्टनरशिप काम करती है"
    },
    {
      "subtitle_id": 62,
      "start": 129.56,
      "end": 133.76,
      "text": "और ऑल ओवर इंडिया जो भी हायत के होटल्स"
    },
    {
      "subtitle_id": 63,
      "start": 131.72,
      "end": 135.519,
      "text": "हैं उन्हें ऑपरेट करती है अगर हम इस कंपनी"
    },
    {
      "subtitle_id": 64,
      "start": 133.76,
      "end": 137.519,
      "text": "को देखें तो कंपनी का लग्जरी हॉटल सेगमेंट"
    },
    {
      "subtitle_id": 65,
      "start": 135.519,
      "end": 139.44,
      "text": "में मार्केट शेयर ना काफी अच्छा है तो अगर"
    },
    {
      "subtitle_id": 66,
      "start": 137.519,
      "end": 142.68,
      "text": "हम दिल्ली के देखें तो अंदाज दिल्ली जो है"
    },
    {
      "subtitle_id": 67,
      "start": 139.44,
      "end": 146.12,
      "text": "इनका होटल उसमें 401 रूम्स है पूरी दिल्ली"
    },
    {
      "subtitle_id": 68,
      "start": 142.68,
      "end": 148.4,
      "text": "में 3300 टोटल लग्जरी रूम्स है उसका 12 पर"
    },
    {
      "subtitle_id": 69,
      "start": 146.12,
      "end": 150.879,
      "text": "जूनिपर के पास है मुंबई की मैं बात करूं"
    },
    {
      "subtitle_id": 70,
      "start": 148.4,
      "end": 153.599,
      "text": "तो मुंबई में भी 54 लग्जरी रूम्स है और"
    },
    {
      "subtitle_id": 71,
      "start": 150.879,
      "end": 155.599,
      "text": "उसमें से 665 जो रूम्स है वो ग्रंड हवेत"
    },
    {
      "subtitle_id": 72,
      "start": 153.599,
      "end": 157.76,
      "text": "मुंबई के पास यानी 12 पर मार्केट शेयर"
    },
    {
      "subtitle_id": 73,
      "start": 155.599,
      "end": 159.959,
      "text": "मुंबई में भी इनका है लखनऊ में इनका"
    },
    {
      "subtitle_id": 74,
      "start": 157.76,
      "end": 162.879,
      "text": "लग्जरी होटल सेगमेंट में 52 पर का मार्केट"
    },
    {
      "subtitle_id": 75,
      "start": 159.959,
      "end": 164.68,
      "text": "शेयर है और अहमदाबाद में 26 का है अगर हम"
    },
    {
      "subtitle_id": 76,
      "start": 162.879,
      "end": 166.4,
      "text": "कंपनी के ऑपरेशनल मैट्रिक देखें तो बिजनेस"
    },
    {
      "subtitle_id": 77,
      "start": 164.68,
      "end": 168.76,
      "text": "के बारे में शायद और बेहतर अंडरस्टैंडिंग"
    },
    {
      "subtitle_id": 78,
      "start": 166.4,
      "end": 172.12,
      "text": "आपको आएगी आप यहां पर देख सकते हैं कि"
    },
    {
      "subtitle_id": 79,
      "start": 168.76,
      "end": 175.56,
      "text": "कंपनी का जो एवरेज रूम रेट है वो पिछले 4"
    },
    {
      "subtitle_id": 80,
      "start": 172.12,
      "end": 177.599,
      "text": "सालों में डबल हो गया है व 5600 से 10000"
    },
    {
      "subtitle_id": 81,
      "start": 175.56,
      "end": 179.12,
      "text": "के ऊपर चला गया है प्राइस आप बढ़ाते कई"
    },
    {
      "subtitle_id": 82,
      "start": 177.599,
      "end": 180.44,
      "text": "बार तो ऑक्युपेंसी रेट कम होने की रिस्क"
    },
    {
      "subtitle_id": 83,
      "start": 179.12,
      "end": 182.68,
      "text": "होती है लेकिन यहां यहां पर वो भी चीज"
    },
    {
      "subtitle_id": 84,
      "start": 180.44,
      "end": 185.44,
      "text": "नहीं है तो ऑक्युपेंसी भी यहां पर बढ़ गई"
    },
    {
      "subtitle_id": 85,
      "start": 182.68,
      "end": 187.84,
      "text": "है अब देखिए 2021 थोड़ा कोविड वाला ईयर था"
    },
    {
      "subtitle_id": 86,
      "start": 185.44,
      "end": 190.36,
      "text": "तो उसे आप मत काउंट कीजिए तो उसके बाद अगर"
    },
    {
      "subtitle_id": 87,
      "start": 187.84,
      "end": 191.92,
      "text": "हम देखें 2022 से तो धीरे-धीरे रिकवरी"
    },
    {
      "subtitle_id": 88,
      "start": 190.36,
      "end": 194.44,
      "text": "यहां पर देखने मिली और फिलहाल जो"
    },
    {
      "subtitle_id": 89,
      "start": 191.92,
      "end": 197.599,
      "text": "ऑक्युपेंसी रेट है वो 70 पर से ज्यादा है"
    },
    {
      "subtitle_id": 90,
      "start": 194.44,
      "end": 200.08,
      "text": "अब शायद आपको ये 70 पर से जो 73 74 के"
    },
    {
      "subtitle_id": 91,
      "start": 197.599,
      "end": 202.48,
      "text": "नंबर्स वो शायद कम लगे लेकिन जब आप बाकी"
    },
    {
      "subtitle_id": 92,
      "start": 200.08,
      "end": 205.08,
      "text": "होटल चेंसी से कंपेयर करते हैं यहां पर तो"
    },
    {
      "subtitle_id": 93,
      "start": 202.48,
      "end": 207.04,
      "text": "आपको पता चलेगा कि इनका जो रेट है अबोव 70"
    },
    {
      "subtitle_id": 94,
      "start": 205.08,
      "end": 208.799,
      "text": "पर का वो काफी अच्छा है तो यहां से आपको"
    },
    {
      "subtitle_id": 95,
      "start": 207.04,
      "end": 211.239,
      "text": "कंपनी की पॉजिटिव साइड तो पता चले लेकिन"
    },
    {
      "subtitle_id": 96,
      "start": 208.799,
      "end": 213.319,
      "text": "हमें नेगेटिव साइड समझना भी बहुत जरूरी है"
    },
    {
      "subtitle_id": 97,
      "start": 211.239,
      "end": 214.959,
      "text": "देखिए लग्जरी सेगमेंट हालांकि देखा जाए"
    },
    {
      "subtitle_id": 98,
      "start": 213.319,
      "end": 216.959,
      "text": "लग्जरी होटल सेगमेंट तो इंडिया में बहुत"
    },
    {
      "subtitle_id": 99,
      "start": 214.959,
      "end": 219.04,
      "text": "सारे लोग जो है लोअर मिडिल क्लास वाले"
    },
    {
      "subtitle_id": 100,
      "start": 216.959,
      "end": 221.04,
      "text": "अप्पर मिडल क्लास में जा रहे हैं अपर मिडल"
    },
    {
      "subtitle_id": 101,
      "start": 219.04,
      "end": 223.239,
      "text": "क्लास वाले रिच क्लास में जा रहे हैं और"
    },
    {
      "subtitle_id": 102,
      "start": 221.04,
      "end": 225.439,
      "text": "ये पॉपुलेशन जो है वो बहुत तेजी से शिफ्ट"
    },
    {
      "subtitle_id": 103,
      "start": 223.239,
      "end": 227.519,
      "text": "होती जा रही है मतलब ऊपर की तरफ ही शिफ्ट"
    },
    {
      "subtitle_id": 104,
      "start": 225.439,
      "end": 229.959,
      "text": "हो रही है इसका फायदा किसे हो रहा है तो"
    },
    {
      "subtitle_id": 105,
      "start": 227.519,
      "end": 231.36,
      "text": "ये जो लग्जरी होटल चेंस है और फिर लग्जरी"
    },
    {
      "subtitle_id": 106,
      "start": 229.959,
      "end": 233.439,
      "text": "ब्रांड्स होंगे अलग-अलग इन्हें बहुत"
    },
    {
      "subtitle_id": 107,
      "start": 231.36,
      "end": 235.92,
      "text": "ज्यादा फायदा हो रहा है और ये विजिबल भी"
    },
    {
      "subtitle_id": 108,
      "start": 233.439,
      "end": 237.64,
      "text": "है तो क्या अभी जो हमारे पास अभी तक डटा"
    },
    {
      "subtitle_id": 109,
      "start": 235.92,
      "end": 239.76,
      "text": "क्या हम इसके बेसिस पर यह कह सकते हैं कि"
    },
    {
      "subtitle_id": 110,
      "start": 237.64,
      "end": 242.36,
      "text": "जून परर होटल्स एक बहुत अच्छी अपॉर्चुनिटी"
    },
    {
      "subtitle_id": 111,
      "start": 239.76,
      "end": 244.879,
      "text": "है तो शायद कंपनी की दूसरी साइड देखने के"
    },
    {
      "subtitle_id": 112,
      "start": 242.36,
      "end": 246.64,
      "text": "बाद आपका व्यू चेंज हो सकता है तो देखिए"
    },
    {
      "subtitle_id": 113,
      "start": 244.879,
      "end": 248.519,
      "text": "एक तो दो चीजें यहां पर सबसे बड़े रेड"
    },
    {
      "subtitle_id": 114,
      "start": 246.64,
      "end": 250.68,
      "text": "फ्लैग्स हैं पहला तो कंपनी एक लॉस मेकिंग"
    },
    {
      "subtitle_id": 115,
      "start": 248.519,
      "end": 252.84,
      "text": "कंपनी है हालांकि लॉस कंपनी का जरूर आप"
    },
    {
      "subtitle_id": 116,
      "start": 250.68,
      "end": 255.079,
      "text": "देख सकते हैं कि कम होते जा रहा है पर"
    },
    {
      "subtitle_id": 117,
      "start": 252.84,
      "end": 257.44,
      "text": "अल्टीमेटली कंपनी एक लॉस मेकिंग कंपनी है"
    },
    {
      "subtitle_id": 118,
      "start": 255.079,
      "end": 259.88,
      "text": "फाइनेंशियल 2020 में कंपनी का लॉस काफी"
    },
    {
      "subtitle_id": 119,
      "start": 257.44,
      "end": 261.799,
      "text": "ज्यादा था 79 करोड़ का फिर वो और बढ़ गया"
    },
    {
      "subtitle_id": 120,
      "start": 259.88,
      "end": 264.28,
      "text": "200 करोड़ के आसपास चला गया और अभी वो"
    },
    {
      "subtitle_id": 121,
      "start": 261.799,
      "end": 266.16,
      "text": "फाइनेंशियल 2023 में 2 करोड़ पर आ चुका है"
    },
    {
      "subtitle_id": 122,
      "start": 264.28,
      "end": 267.84,
      "text": "पर कंपनी अभी भी लॉस मेकिंग ही है लेकिन"
    },
    {
      "subtitle_id": 123,
      "start": 266.16,
      "end": 269.919,
      "text": "इससे भी बड़ा प्रॉब्लम पता है क्या है"
    },
    {
      "subtitle_id": 124,
      "start": 267.84,
      "end": 272.759,
      "text": "कंपनी के ऊपर बहुत बड़ा कर्जा है कर्ज"
    },
    {
      "subtitle_id": 125,
      "start": 269.919,
      "end": 275.16,
      "text": "कितने का तो 2200 करोड़ का कर्ज कंपनी के"
    },
    {
      "subtitle_id": 126,
      "start": 272.759,
      "end": 277.72,
      "text": "पास है तो कंपनी अभी आओ के जरिए ₹1 800"
    },
    {
      "subtitle_id": 127,
      "start": 275.16,
      "end": 280.24,
      "text": "करोड़ रेज करने वाली है बहुत बड़ा यह आईओ"
    },
    {
      "subtitle_id": 128,
      "start": 277.72,
      "end": 282.24,
      "text": "है तो आपको यह लगेगा कि 1800 से क्या होगा"
    },
    {
      "subtitle_id": 129,
      "start": 280.24,
      "end": 284.08,
      "text": "शायद कंपनी का एक्सपेंशन होगा नए होटल्स"
    },
    {
      "subtitle_id": 130,
      "start": 282.24,
      "end": 285.84,
      "text": "और खुले और खुलेंगे क्योंकि सिर्फ सात"
    },
    {
      "subtitle_id": 131,
      "start": 284.08,
      "end": 287.52,
      "text": "होटल से काम नहीं चलेगा कंपनी को और ग्रो"
    },
    {
      "subtitle_id": 132,
      "start": 285.84,
      "end": 289.639,
      "text": "करना है तो ठीक है ऑक्युपेंसी रेट भी"
    },
    {
      "subtitle_id": 133,
      "start": 287.52,
      "end": 293.0,
      "text": "बढ़ाना पड़ेगा उससे भी रेवेन्यू बढ़ेगा 73"
    },
    {
      "subtitle_id": 134,
      "start": 289.639,
      "end": 295.28,
      "text": "74 का ऑक्युपेंसी है यह 80 85 90 जाएगा तो"
    },
    {
      "subtitle_id": 135,
      "start": 293.0,
      "end": 297.52,
      "text": "और रेवेन्यू बढ़ेगा लेकिन फिर एक बार वह"
    },
    {
      "subtitle_id": 136,
      "start": 295.28,
      "end": 299.28,
      "text": "वहां पर रीच हो गया और आपने प्राइस बढ़ाना"
    },
    {
      "subtitle_id": 137,
      "start": 297.52,
      "end": 301.44,
      "text": "भी एक हद तक आप बढ़ा सकते हैं रूम की"
    },
    {
      "subtitle_id": 138,
      "start": 299.28,
      "end": 303.56,
      "text": "प्राइस प्राइसेस वहां पर भी ग्रोथ आपकी थम"
    },
    {
      "subtitle_id": 139,
      "start": 301.44,
      "end": 305.8,
      "text": "जाएगी तो असली ग्रोथ कहां से आएगी आपको नए"
    },
    {
      "subtitle_id": 140,
      "start": 303.56,
      "end": 308.0,
      "text": "होटल्स बनाने पड़ेंगे लेकिन शॉकिंगली ये"
    },
    {
      "subtitle_id": 141,
      "start": 305.8,
      "end": 310.24,
      "text": "जो पैसा आईपीओ के जरिए रेज हो रहा है इसका"
    },
    {
      "subtitle_id": 142,
      "start": 308.0,
      "end": 311.759,
      "text": "उपयोग होटल बनाने के लिए शायद नहीं हो रहा"
    },
    {
      "subtitle_id": 143,
      "start": 310.24,
      "end": 313.639,
      "text": "है क्योंकि इसका उपयोग जो हो रहा है वो"
    },
    {
      "subtitle_id": 144,
      "start": 311.759,
      "end": 316.32,
      "text": "मेनली डेट रीपेमेंट के लिए हो रहा है 1800"
    },
    {
      "subtitle_id": 145,
      "start": 313.639,
      "end": 318.8,
      "text": "करोड़ का आईपीओ है 2200 करोड़ का डेट है"
    },
    {
      "subtitle_id": 146,
      "start": 316.32,
      "end": 320.0,
      "text": "तो आप अगर देखेंगे तो कंपनी मेनली लॉस में"
    },
    {
      "subtitle_id": 147,
      "start": 318.8,
      "end": 321.919,
      "text": "इसलिए भी जा रही है क्योंकि इंटरेस्ट"
    },
    {
      "subtitle_id": 148,
      "start": 320.0,
      "end": 323.72,
      "text": "एक्सपेंसेस काफी तेजी से बढ़ रहे हैं और"
    },
    {
      "subtitle_id": 149,
      "start": 321.919,
      "end": 325.6,
      "text": "उसे कंट्रोल करने के लिए कंपनी भी चाह र"
    },
    {
      "subtitle_id": 150,
      "start": 323.72,
      "end": 328.44,
      "text": "कि हम थोड़ा इंटरेस्ट एक्सपेंसेस पर लगाम"
    },
    {
      "subtitle_id": 151,
      "start": 325.6,
      "end": 330.88,
      "text": "लगाए और इसीलिए पहले डेट रीपेमेंट करते"
    },
    {
      "subtitle_id": 152,
      "start": 328.44,
      "end": 333.4,
      "text": "हैं लेकिन अभी सवाल यह भी है कि एक तो आप"
    },
    {
      "subtitle_id": 153,
      "start": 330.88,
      "end": 334.72,
      "text": "प्रॉफिटेबल नहीं हो पैसा तो आ नहीं रहा है"
    },
    {
      "subtitle_id": 154,
      "start": 333.4,
      "end": 336.759,
      "text": "तो आने वाले टाइम में हॉटेल्स का"
    },
    {
      "subtitle_id": 155,
      "start": 334.72,
      "end": 339.199,
      "text": "एक्सपेंशन आप करेंगे कैसे यह बहुत बड़ा"
    },
    {
      "subtitle_id": 156,
      "start": 336.759,
      "end": 340.8,
      "text": "सवाल यहां पर एक रेज होता है देखिए वीडियो"
    },
    {
      "subtitle_id": 157,
      "start": 339.199,
      "end": 342.56,
      "text": "में आगे बढ़ने से पहले आपको बता दूं कि हम"
    },
    {
      "subtitle_id": 158,
      "start": 340.8,
      "end": 344.12,
      "text": "जब भी किसी आईपीओ का एनालिसिस करते हैं तो"
    },
    {
      "subtitle_id": 159,
      "start": 342.56,
      "end": 346.199,
      "text": "हमारा यह मकसद नहीं होता है कि आपको यह"
    },
    {
      "subtitle_id": 160,
      "start": 344.12,
      "end": 348.24,
      "text": "बताना कि कौन सा आईपीओ अच्छा है और कौन सा"
    },
    {
      "subtitle_id": 161,
      "start": 346.199,
      "end": 350.479,
      "text": "खराब है हमारा यह मकसद होता है कि वह सारी"
    },
    {
      "subtitle_id": 162,
      "start": 348.24,
      "end": 352.4,
      "text": "इंफॉर्मेशन आप तक पहुंचे ताकि आप खुद अपनी"
    },
    {
      "subtitle_id": 163,
      "start": 350.479,
      "end": 354.44,
      "text": "डिसीजन ले पाए कि उस आईपीओ में इन्वेस्ट"
    },
    {
      "subtitle_id": 164,
      "start": 352.4,
      "end": 356.84,
      "text": "करना है या फिर नहीं और इसी चीज को हम"
    },
    {
      "subtitle_id": 165,
      "start": 354.44,
      "end": 358.919,
      "text": "थोड़ा आगे लेकर जा रहे हैं कि अगर आपको"
    },
    {
      "subtitle_id": 166,
      "start": 356.84,
      "end": 360.199,
      "text": "किसी भी स्टॉक को इंडिपेंडेंटली ढूंढना है"
    },
    {
      "subtitle_id": 167,
      "start": 358.919,
      "end": 362.199,
      "text": "किसी भी म्यूचुअल फंड स्कीम को"
    },
    {
      "subtitle_id": 168,
      "start": 360.199,
      "end": 363.68,
      "text": "इंडिपेंडेंटली ढूंढना है तो वो कैसे ढूंढे"
    },
    {
      "subtitle_id": 169,
      "start": 362.199,
      "end": 365.479,
      "text": "और ये सारी चीजें हम बता रहे हैं हमारे"
    },
    {
      "subtitle_id": 170,
      "start": 363.68,
      "end": 368.199,
      "text": "मनी मास्टरी प्रोग्राम में जो होने वाला"
    },
    {
      "subtitle_id": 171,
      "start": 365.479,
      "end": 370.039,
      "text": "है इस संडे यानी 25th फरवरी को शाम 6:00"
    },
    {
      "subtitle_id": 172,
      "start": 368.199,
      "end": 371.68,
      "text": "बजे से 8:00 बजे के बीच तो इंडिपेंडेंटली"
    },
    {
      "subtitle_id": 173,
      "start": 370.039,
      "end": 373.36,
      "text": "स्टॉक्स और म्यूचुअल फंड कैसे ढूंढे इसके"
    },
    {
      "subtitle_id": 174,
      "start": 371.68,
      "end": 375.88,
      "text": "साथ ही यहां पर मैं बात करने वाला हूं कुछ"
    },
    {
      "subtitle_id": 175,
      "start": 373.36,
      "end": 377.52,
      "text": "फ्री ट इन्वेस्टमेंट्स की यानी जनरली लोग"
    },
    {
      "subtitle_id": 176,
      "start": 375.88,
      "end": 379.24,
      "text": "ऐसा कहते हैं कि ज्यादा रिस्क लेने से ही"
    },
    {
      "subtitle_id": 177,
      "start": 377.52,
      "end": 380.919,
      "text": "ज्यादा रिटर्न्स मिलेंगे लेकिन इंडिया में"
    },
    {
      "subtitle_id": 178,
      "start": 379.24,
      "end": 382.759,
      "text": "आज की डेट में ऐसी कई सारी फ्री हिट"
    },
    {
      "subtitle_id": 179,
      "start": 380.919,
      "end": 384.639,
      "text": "इन्वेस्टमेंट अपॉर्चुनिटी हैं जहां पर"
    },
    {
      "subtitle_id": 180,
      "start": 382.759,
      "end": 386.68,
      "text": "आपको लो रिस्क में हाई रिटर्न की"
    },
    {
      "subtitle_id": 181,
      "start": 384.639,
      "end": 388.4,
      "text": "अपॉर्चुनिटी मिलती है यह है बहुत रेयर"
    },
    {
      "subtitle_id": 182,
      "start": 386.68,
      "end": 390.4,
      "text": "लेकिन सभी को पता होना जरूरी है और इनके"
    },
    {
      "subtitle_id": 183,
      "start": 388.4,
      "end": 392.319,
      "text": "बारे में भी इस मनी प्रोग्राम में मैं"
    },
    {
      "subtitle_id": 184,
      "start": 390.4,
      "end": 393.84,
      "text": "डिटेल में बात करने वाला हूं और इस फ्रीड"
    },
    {
      "subtitle_id": 185,
      "start": 392.319,
      "end": 395.44,
      "text": "इन्वेस्टमेंट्स का मैं कैसे फायदा लेता"
    },
    {
      "subtitle_id": 186,
      "start": 393.84,
      "end": 397.08,
      "text": "हूं प्रूफ के साथ मैं आपको इस प्रोग्राम"
    },
    {
      "subtitle_id": 187,
      "start": 395.44,
      "end": 398.8,
      "text": "में दिखा दूंगा तो इस चीज को बिल्कुल भी"
    },
    {
      "subtitle_id": 188,
      "start": 397.08,
      "end": 401.36,
      "text": "मिस मत कीजिए इसे जवाइन करने के लिए लिंक"
    },
    {
      "subtitle_id": 189,
      "start": 398.8,
      "end": 402.72,
      "text": "मैंने नीचे दी गई है सो 199 की नॉमिनल फीज"
    },
    {
      "subtitle_id": 190,
      "start": 401.36,
      "end": 404.599,
      "text": "में आप इस मनी मास्टरी प्रोग्राम को"
    },
    {
      "subtitle_id": 191,
      "start": 402.72,
      "end": 407.199,
      "text": "ज्वाइन कर सकते हैं और मिल सकते हैं मुझसे"
    },
    {
      "subtitle_id": 192,
      "start": 404.599,
      "end": 409.12,
      "text": "लाइव 25th फरवरी को शाम 6:00 बजे से 8:00"
    },
    {
      "subtitle_id": 193,
      "start": 407.199,
      "end": 411.12,
      "text": "बजे के बीच जहां पर मैं इन सारी चीजों के"
    },
    {
      "subtitle_id": 194,
      "start": 409.12,
      "end": 413.28,
      "text": "बारे में आपको बताऊंगा ताकि आप अपने जो"
    },
    {
      "subtitle_id": 195,
      "start": 411.12,
      "end": 415.16,
      "text": "फ्यूचर प्लांस हैं घर खरीदने को हो बाकी"
    },
    {
      "subtitle_id": 196,
      "start": 413.28,
      "end": 416.919,
      "text": "चीजें करने के हो वो इन इन्वेस्टमेंट्स की"
    },
    {
      "subtitle_id": 197,
      "start": 415.16,
      "end": 418.8,
      "text": "मदद से पूरे कर सको चलिए अब बढ़ते हैं"
    },
    {
      "subtitle_id": 198,
      "start": 416.919,
      "end": 420.36,
      "text": "वीडियो की तरफ कंपनी की एक और शॉकिंग चीज"
    },
    {
      "subtitle_id": 199,
      "start": 418.8,
      "end": 421.96,
      "text": "अब देखिए कंपनी प्रॉफिटेबल नहीं है तो हम"
    },
    {
      "subtitle_id": 200,
      "start": 420.36,
      "end": 424.0,
      "text": "प्राइस टू अर्निंग रेशो नहीं निकाल सकते"
    },
    {
      "subtitle_id": 201,
      "start": 421.96,
      "end": 425.96,
      "text": "और ना ही प्राइस टू अर्निंग रेशो से उसे"
    },
    {
      "subtitle_id": 202,
      "start": 424.0,
      "end": 427.639,
      "text": "कंपीटीटर जो कंपनीज है उसे कंपेयर कर सकते"
    },
    {
      "subtitle_id": 203,
      "start": 425.96,
      "end": 429.28,
      "text": "हैं तो हमें क्या करना पड़ेगा भी प्राइस"
    },
    {
      "subtitle_id": 204,
      "start": 427.639,
      "end": 431.039,
      "text": "टू सेल्स रेशो निकालना पड़ेगा देखिए जब भी"
    },
    {
      "subtitle_id": 205,
      "start": 429.28,
      "end": 432.599,
      "text": "कंपनी प्रॉफिटेबल नहीं होती है तो आप"
    },
    {
      "subtitle_id": 206,
      "start": 431.039,
      "end": 434.0,
      "text": "प्राइस टू अर्निंग नहीं निकाल सकते तब"
    },
    {
      "subtitle_id": 207,
      "start": 432.599,
      "end": 435.759,
      "text": "हमें प्राइस टू सेल्स रेशो निकाल के"
    },
    {
      "subtitle_id": 208,
      "start": 434.0,
      "end": 437.919,
      "text": "वैल्युएशन निकालना पड़ता है देखिए प्राइस"
    },
    {
      "subtitle_id": 209,
      "start": 435.759,
      "end": 440.919,
      "text": "टू सेल्स रे इज नॉट अ गुड मेजर बिकॉज कई"
    },
    {
      "subtitle_id": 210,
      "start": 437.919,
      "end": 440.919,
      "text": "सारी ऐसी कंपनी जैसे"
    },
    {
      "subtitle_id": 211,
      "start": 449.4,
      "end": 453.919,
      "text": "देखते हैं तो प्राइस टू सेल्स रेशो को अगर"
    },
    {
      "subtitle_id": 212,
      "start": 451.479,
      "end": 455.72,
      "text": "देखा जाए जो इंडियन होटल्स कंपनी है ताज"
    },
    {
      "subtitle_id": 213,
      "start": 453.919,
      "end": 457.8,
      "text": "वगैरह जो चलाते हैं टाटा ग्रुप की कंपनी"
    },
    {
      "subtitle_id": 214,
      "start": 455.72,
      "end": 459.919,
      "text": "है उसके बाद लेमन ट्री वगैरह है और भी"
    },
    {
      "subtitle_id": 215,
      "start": 457.8,
      "end": 461.919,
      "text": "बाकी होटल्स हैं तो अगर हम देखेंगे तो लेट"
    },
    {
      "subtitle_id": 216,
      "start": 459.919,
      "end": 463.52,
      "text": "के अलावा किसी भी कंपनी का जो प्राइस टू"
    },
    {
      "subtitle_id": 217,
      "start": 461.919,
      "end": 465.4,
      "text": "अर्निंग रेशो है वो जूनि परर होटल से"
    },
    {
      "subtitle_id": 218,
      "start": 463.52,
      "end": 467.72,
      "text": "ज्यादा नहीं है तो यहां पर एक तो आप"
    },
    {
      "subtitle_id": 219,
      "start": 465.4,
      "end": 470.199,
      "text": "प्रॉफिटेबल नहीं है दूसरी जगह आपका प्राइस"
    },
    {
      "subtitle_id": 220,
      "start": 467.72,
      "end": 472.52,
      "text": "टू सेल्स रेशो वन ऑफ द हाईएस्ट में आता है"
    },
    {
      "subtitle_id": 221,
      "start": 470.199,
      "end": 474.159,
      "text": "तो यह कुछ चीज है जो आपको सोचने की जरूरत"
    },
    {
      "subtitle_id": 222,
      "start": 472.52,
      "end": 476.879,
      "text": "है और एक और थोड़ा डेटा पॉइंट मैंने"
    },
    {
      "subtitle_id": 223,
      "start": 474.159,
      "end": 478.96,
      "text": "निकाला यहां पर अभी हायत की जो हायत हॉटल"
    },
    {
      "subtitle_id": 224,
      "start": 476.879,
      "end": 481.0,
      "text": "कॉरपोरेशन जो है वो यूएस में लिस्टेड है"
    },
    {
      "subtitle_id": 225,
      "start": 478.96,
      "end": 483.639,
      "text": "उस उसके अगर मैं रिटर्न्स को देखूं तो"
    },
    {
      "subtitle_id": 226,
      "start": 481.0,
      "end": 486.08,
      "text": "पिछले 5 साल में इस कंपनी ने यूएस में"
    },
    {
      "subtitle_id": 227,
      "start": 483.639,
      "end": 488.56,
      "text": "12.11 पर का रिटर्न दिया है कंपाउंडेड"
    },
    {
      "subtitle_id": 228,
      "start": 486.08,
      "end": 490.36,
      "text": "सालाना और इसी बीच एसएनपी 500 का इन पाच"
    },
    {
      "subtitle_id": 229,
      "start": 488.56,
      "end": 492.879,
      "text": "सालों में जो कंपट सालाना रिटर्न था वो"
    },
    {
      "subtitle_id": 230,
      "start": 490.36,
      "end": 494.44,
      "text": "12.37 का था यानी इंडेक्स ने ज्यादा"
    },
    {
      "subtitle_id": 231,
      "start": 492.879,
      "end": 496.56,
      "text": "रिटर्न दिया है कंपेयर टू दिस कंपनी इन"
    },
    {
      "subtitle_id": 232,
      "start": 494.44,
      "end": 498.639,
      "text": "यूएस तो क्या इंडिया में ये स्टोरी जूनी"
    },
    {
      "subtitle_id": 233,
      "start": 496.56,
      "end": 500.52,
      "text": "परर चेंज कर सकती है टाइम ही बताएगा लेकिन"
    },
    {
      "subtitle_id": 234,
      "start": 498.639,
      "end": 502.199,
      "text": "फिलहाल तो यही डिपेंड करता है कि कंपनी को"
    },
    {
      "subtitle_id": 235,
      "start": 500.52,
      "end": 504.159,
      "text": "अगर बहुत तेज से एक्सपें करना है तो"
    },
    {
      "subtitle_id": 236,
      "start": 502.199,
      "end": 506.68,
      "text": "उन्हें नंबर ऑफ होटल्स बढ़ाने होंगे"
    },
    {
      "subtitle_id": 237,
      "start": 504.159,
      "end": 509.28,
      "text": "क्योंकि पिछले साल ही 2023 में तीन"
    },
    {
      "subtitle_id": 238,
      "start": 506.68,
      "end": 511.319,
      "text": "इंटरनेशनल होटल्स ने अनाउंस किया है कि हम"
    },
    {
      "subtitle_id": 239,
      "start": 509.28,
      "end": 513.12,
      "text": "इंडिया में आ रहे हैं अगर आप मेरिड होटल"
    },
    {
      "subtitle_id": 240,
      "start": 511.319,
      "end": 515.08,
      "text": "को देखते हैं तो दे आर वेरी अग्रेसिव ऑन"
    },
    {
      "subtitle_id": 241,
      "start": 513.12,
      "end": 517.76,
      "text": "इंडिया बहुत तेज से एक्सपेंशन कर रहे हैं"
    },
    {
      "subtitle_id": 242,
      "start": 515.08,
      "end": 520.279,
      "text": "अलग-अलग सेगमेंट्स है उनके उसके जरिए तो"
    },
    {
      "subtitle_id": 243,
      "start": 517.76,
      "end": 522.0,
      "text": "ऐसे में हायथ होटल किस तरह से फाइट कर"
    },
    {
      "subtitle_id": 244,
      "start": 520.279,
      "end": 523.919,
      "text": "पाएगी ये देखना इंटरेस्टिंग रहेगा अब तक"
    },
    {
      "subtitle_id": 245,
      "start": 522.0,
      "end": 526.279,
      "text": "इन्होंने इनकी एक बहुत अच्छी खासियत ही"
    },
    {
      "subtitle_id": 246,
      "start": 523.919,
      "end": 527.76,
      "text": "रही ये रही है कि इन्होंने जहां-जहां पर"
    },
    {
      "subtitle_id": 247,
      "start": 526.279,
      "end": 529.399,
      "text": "मुंबई में दिल्ली में जहां-जहां पर"
    },
    {
      "subtitle_id": 248,
      "start": 527.76,
      "end": 531.44,
      "text": "इन्होंने होटल खोले लोकेशंस बहुत प्यारी"
    },
    {
      "subtitle_id": 249,
      "start": 529.399,
      "end": 533.8,
      "text": "है इसलिए रिस्पांसस भी बहुत अच्छे इन्हें"
    },
    {
      "subtitle_id": 250,
      "start": 531.44,
      "end": 536.6,
      "text": "मिल रहे हैं लेकिन ठीक है एक टाइम में अगर"
    },
    {
      "subtitle_id": 251,
      "start": 533.8,
      "end": 538.6,
      "text": "आपकी रूम ऑक्युपेंसी भर गई रेट जो बढ़ा"
    },
    {
      "subtitle_id": 252,
      "start": 536.6,
      "end": 540.48,
      "text": "रहे हैं आप वो एक लेवल तक आप बढ़ा सकते हो"
    },
    {
      "subtitle_id": 253,
      "start": 538.6,
      "end": 542.0,
      "text": "उसकी बात क्या तो इसीलिए अगर आपको इस"
    },
    {
      "subtitle_id": 254,
      "start": 540.48,
      "end": 544.32,
      "text": "कंपनी में इन्वेस्ट करने की प्लानिंग करनी"
    },
    {
      "subtitle_id": 255,
      "start": 542.0,
      "end": 546.92,
      "text": "है तो सबसे पहले आपको यह देखना पड़ेगा कि"
    },
    {
      "subtitle_id": 256,
      "start": 544.32,
      "end": 549.0,
      "text": "नए होटल्स यह कब खोलेंगे और कैसे खोलेंगे"
    },
    {
      "subtitle_id": 257,
      "start": 546.92,
      "end": 551.6,
      "text": "तो कंपनी का अगर हमने थोड़ा बहुत ओपिनियन"
    },
    {
      "subtitle_id": 258,
      "start": 549.0,
      "end": 553.64,
      "text": "देखे इंटरव्यूज प देखे तो कंपनी बोल रही"
    },
    {
      "subtitle_id": 259,
      "start": 551.6,
      "end": 555.24,
      "text": "है कि हम गोवा में होटल खोलने का प्लान कर"
    },
    {
      "subtitle_id": 260,
      "start": 553.64,
      "end": 557.24,
      "text": "रहे हैं हम हैदराबाद में होटल खोलने का"
    },
    {
      "subtitle_id": 261,
      "start": 555.24,
      "end": 560.079,
      "text": "प्लान करें बिकॉज़ दोनों भी मतलब गोवा"
    },
    {
      "subtitle_id": 262,
      "start": 557.24,
      "end": 561.76,
      "text": "इमर्जिंग टूरिस्ट प्लेस है हैदराबाद एक"
    },
    {
      "subtitle_id": 263,
      "start": 560.079,
      "end": 564.04,
      "text": "बहुत ही इमर्जिंग सिटी है बहुत तेज से"
    },
    {
      "subtitle_id": 264,
      "start": 561.76,
      "end": 565.92,
      "text": "ग्रो कर रही है तो इसेलिए इन दो सिटीज में"
    },
    {
      "subtitle_id": 265,
      "start": 564.04,
      "end": 568.279,
      "text": "जाने का उनका प्लान है लेकिन कब जाएंगे"
    },
    {
      "subtitle_id": 266,
      "start": 565.92,
      "end": 570.36,
      "text": "कैसे जाएंगे इसके बारे में अभी तक कोई भी"
    },
    {
      "subtitle_id": 267,
      "start": 568.279,
      "end": 571.56,
      "text": "जानकारी नहीं है तो इन्वेस्ट करने का अगर"
    },
    {
      "subtitle_id": 268,
      "start": 570.36,
      "end": 574.36,
      "text": "प्लानिंग करेंगे तो ये सारी इंफॉर्मेशन"
    },
    {
      "subtitle_id": 269,
      "start": 571.56,
      "end": 576.32,
      "text": "आपके पास बिफोर हैंड होनी चाहिए ताकि उसके"
    },
    {
      "subtitle_id": 270,
      "start": 574.36,
      "end": 578.6,
      "text": "बेसिस पर ही आप कंपनी की असली ग्रोथ का"
    },
    {
      "subtitle_id": 271,
      "start": 576.32,
      "end": 580.36,
      "text": "अंदाजा लगा सके वैसे ब्रांड नेम इनका बहुत"
    },
    {
      "subtitle_id": 272,
      "start": 578.6,
      "end": 582.04,
      "text": "अच्छा है तो वहां पर इनको ज्यादा स्ट्रगल"
    },
    {
      "subtitle_id": 273,
      "start": 580.36,
      "end": 583.56,
      "text": "नहीं जाएगी तो इनको फिलहाल जरूरत है कि जो"
    },
    {
      "subtitle_id": 274,
      "start": 582.04,
      "end": 585.72,
      "text": "इंडिया की जो बड़ी-बड़ी सिटीज है वहां पर"
    },
    {
      "subtitle_id": 275,
      "start": 583.56,
      "end": 587.399,
      "text": "होटल्स खुलकर अपने बिजनेस को एक्सपें करने"
    },
    {
      "subtitle_id": 276,
      "start": 585.72,
      "end": 589.32,
      "text": "की और बात रही लिस्टिंग गेन की तो ग्रे"
    },
    {
      "subtitle_id": 277,
      "start": 587.399,
      "end": 591.64,
      "text": "मार्केट प्रीमियम कंपनी का सिर्फ ₹10 का"
    },
    {
      "subtitle_id": 278,
      "start": 589.32,
      "end": 593.12,
      "text": "चल रहा है यानी कि कंपनी ने यहां पर मतलब"
    },
    {
      "subtitle_id": 279,
      "start": 591.64,
      "end": 594.8,
      "text": "जिस हिसाब से वैल्यूएशन रखा है तो मुझे"
    },
    {
      "subtitle_id": 280,
      "start": 593.12,
      "end": 596.88,
      "text": "नहीं दिखता कि इन्वेस्टर्स के लिए कुछ"
    },
    {
      "subtitle_id": 281,
      "start": 594.8,
      "end": 599.6,
      "text": "छोड़ा भी है तो कंपनी ने जितना ज्यादा हो"
    },
    {
      "subtitle_id": 282,
      "start": 596.88,
      "end": 601.56,
      "text": "सके वैल्युएशन उतना लगा दिया है और ऑलरेडी"
    },
    {
      "subtitle_id": 283,
      "start": 599.6,
      "end": 602.76,
      "text": "मतलब एक्सपेंशन और ग्रोथ को लेकर काफ़ी"
    },
    {
      "subtitle_id": 284,
      "start": 601.56,
      "end": 604.56,
      "text": "सारे सवाल है इसे भी जितना ज्यादा"
    },
    {
      "subtitle_id": 285,
      "start": 602.76,
      "end": 606.92,
      "text": "वैल्युएशन रखना यह मेरे लिए भी थोड़ा"
    },
    {
      "subtitle_id": 286,
      "start": 604.56,
      "end": 607.92,
      "text": "शॉकिंग ही है तो ओवरऑल अगर जूनिपर होटल्स"
    },
    {
      "subtitle_id": 287,
      "start": 606.92,
      "end": 610.959,
      "text": "को"
    },
    {
      "subtitle_id": 288,
      "start": 607.92,
      "end": 612.8,
      "text": "कंक्लूजन कंपनी के है हात का ब्रांड"
    },
    {
      "subtitle_id": 289,
      "start": 610.959,
      "end": 615.2,
      "text": "इन्हें मिला है और इन्हें पूरा फ्रीडम भी"
    },
    {
      "subtitle_id": 290,
      "start": 612.8,
      "end": 618.24,
      "text": "है हात को और एक्सपें करने का इंडिया में"
    },
    {
      "subtitle_id": 291,
      "start": 615.2,
      "end": 619.76,
      "text": "बट उसके लिए चाहिए पैसे और पैसे तो चाहिए"
    },
    {
      "subtitle_id": 292,
      "start": 618.24,
      "end": 621.72,
      "text": "चाहिए उसके लिए प्रॉफिट कमाना भी जरूरी है"
    },
    {
      "subtitle_id": 293,
      "start": 619.76,
      "end": 623.6,
      "text": "जो कि यहां पर नहीं दिख रहा है दूसरी चीज़"
    },
    {
      "subtitle_id": 294,
      "start": 621.72,
      "end": 625.44,
      "text": "यह है कि कर्ज काफी ज्यादा है तो उसके"
    },
    {
      "subtitle_id": 295,
      "start": 623.6,
      "end": 627.48,
      "text": "घेरे में कंपनी फिलहाल फंस चुकी है और"
    },
    {
      "subtitle_id": 296,
      "start": 625.44,
      "end": 628.76,
      "text": "इसलिए उन्हें आईपीओ लाना पड़ा तो आईपीओ का"
    },
    {
      "subtitle_id": 297,
      "start": 627.48,
      "end": 631.8,
      "text": "गोल यह नहीं है कि बिज़नेस को एक्सपेंड"
    },
    {
      "subtitle_id": 298,
      "start": 628.76,
      "end": 633.079,
      "text": "करना का गोल यह है कर्ज लिया है रिपे करना"
    },
    {
      "subtitle_id": 299,
      "start": 631.8,
      "end": 635.68,
      "text": "मुश्किल जा रहा है क्योंकि प्रॉफिट ही"
    },
    {
      "subtitle_id": 300,
      "start": 633.079,
      "end": 637.519,
      "text": "नहीं है तो दैट इज द मेन प्रॉब्लम तो"
    },
    {
      "subtitle_id": 301,
      "start": 635.68,
      "end": 639.24,
      "text": "कंपनी को शायद इससे बाहर निकलने तो कुछ"
    },
    {
      "subtitle_id": 302,
      "start": 637.519,
      "end": 640.68,
      "text": "अलग कुछ करना पड़ेगा तो आने वाले टाइम में"
    },
    {
      "subtitle_id": 303,
      "start": 639.24,
      "end": 642.839,
      "text": "वो क्या कुछ करते हैं वो डिपेंड करेगा"
    },
    {
      "subtitle_id": 304,
      "start": 640.68,
      "end": 645.32,
      "text": "लेकिन उन्हें बिजनेस ग्रो करने के लिए"
    },
    {
      "subtitle_id": 305,
      "start": 642.839,
      "end": 647.04,
      "text": "नंबर ऑफ होटल्स बढ़ाने पड़ेंगे जो कि अगर"
    },
    {
      "subtitle_id": 306,
      "start": 645.32,
      "end": 649.959,
      "text": "आप देखेंगे ये जो भी होटल्स इन्होंने बनाए"
    },
    {
      "subtitle_id": 307,
      "start": 647.04,
      "end": 653.16,
      "text": "हैं यह पिछले 25 साल सेय बना रहे हैं तो"
    },
    {
      "subtitle_id": 308,
      "start": 649.959,
      "end": 655.44,
      "text": "जो ग्रोथ का जो स्पीड है वह काफी कम है और"
    },
    {
      "subtitle_id": 309,
      "start": 653.16,
      "end": 657.32,
      "text": "यह चीज भी आपको ध्यान में रखनी चाहिए और"
    },
    {
      "subtitle_id": 310,
      "start": 655.44,
      "end": 659.36,
      "text": "वैल्युएशन पॉइंट ऑफ व्यू कुछ खास नहीं है"
    },
    {
      "subtitle_id": 311,
      "start": 657.32,
      "end": 661.079,
      "text": "ग्रे मार्केट प्रीमियम भी कुछ नहीं है तो"
    },
    {
      "subtitle_id": 312,
      "start": 659.36,
      "end": 663.079,
      "text": "आप मुझे अब बताइए कि क्या आप इस आईपीओ में"
    },
    {
      "subtitle_id": 313,
      "start": 661.079,
      "end": 665.56,
      "text": "इन्वेस्ट करना चाहेंगे हां तो क्यों ना तो"
    },
    {
      "subtitle_id": 314,
      "start": 663.079,
      "end": 667.76,
      "text": "क्यों नहीं एक वैलिड रीजन अच्छा खासा रीजन"
    },
    {
      "subtitle_id": 315,
      "start": 665.56,
      "end": 669.0,
      "text": "नीचे कमेंट करके जरूर बताइए और इस आईपीओ"
    },
    {
      "subtitle_id": 316,
      "start": 667.76,
      "end": 670.839,
      "text": "को आपके आईपीओ में इन्वेस्ट करने वाले"
    },
    {
      "subtitle_id": 317,
      "start": 669.0,
      "end": 672.68,
      "text": "दोस्तों के साथ जरूर शेयर कीजिए ताकि उन"
    },
    {
      "subtitle_id": 318,
      "start": 670.839,
      "end": 674.16,
      "text": "तक भी इंफॉर्मेशन पहुंचे बहुत सारे लोग"
    },
    {
      "subtitle_id": 319,
      "start": 672.68,
      "end": 675.76,
      "text": "ब्लाइंड कि आजकल किसी भी आईपीओ में"
    },
    {
      "subtitle_id": 320,
      "start": 674.16,
      "end": 677.92,
      "text": "इन्वेस्ट कर रहे ये सोच कर के आईपीओ मतलब"
    },
    {
      "subtitle_id": 321,
      "start": 675.76,
      "end": 679.839,
      "text": "पैसा बनेगा ही बनेगा लेकिन ऐसी चीज नहीं"
    },
    {
      "subtitle_id": 322,
      "start": 677.92,
      "end": 681.399,
      "text": "है आपको बिजनेस को सही से देखना पड़ेगा"
    },
    {
      "subtitle_id": 323,
      "start": 679.839,
      "end": 683.32,
      "text": "अभी फिलहाल बुल मार्केट चल रहा है तो बुल"
    },
    {
      "subtitle_id": 324,
      "start": 681.399,
      "end": 685.44,
      "text": "मार्केट में कई सारी ऐसी कंपनीज आ जाती है"
    },
    {
      "subtitle_id": 325,
      "start": 683.32,
      "end": 687.279,
      "text": "बीच में जो फंडामेंटली वीक होती है लेकिन"
    },
    {
      "subtitle_id": 326,
      "start": 685.44,
      "end": 689.36,
      "text": "उस बुल मार्केट का फायदा लेकर हाई"
    },
    {
      "subtitle_id": 327,
      "start": 687.279,
      "end": 691.16,
      "text": "वैल्यूएशन पर अपना आईपीओ लाना चाहती है है"
    },
    {
      "subtitle_id": 328,
      "start": 689.36,
      "end": 693.56,
      "text": "तो ऐसी कंपनी से बच के रहना आपका काम है"
    },
    {
      "subtitle_id": 329,
      "start": 691.16,
      "end": 695.519,
      "text": "और इसीलिए हर कंपनी को फंडामेंटली सारे"
    },
    {
      "subtitle_id": 330,
      "start": 693.56,
      "end": 697.2,
      "text": "एंगल से चेक करना आपका काम है और ऐसी"
    },
    {
      "subtitle_id": 331,
      "start": 695.519,
      "end": 698.519,
      "text": "वीडियोस हम फिनो शस बाय प्रसाद पर लाते"
    },
    {
      "subtitle_id": 332,
      "start": 697.2,
      "end": 700.32,
      "text": "रहते हैं तो उसके लिए हमें जरूर"
    },
    {
      "subtitle_id": 333,
      "start": 698.519,
      "end": 702.079,
      "text": "सब्सक्राइब कीजिए और बेल आइकन पर भी क्लिक"
    },
    {
      "subtitle_id": 334,
      "start": 700.32,
      "end": 703.76,
      "text": "कीजिए ताकि आप हमारा एक भी वीडियो मिस ना"
    },
    {
      "subtitle_id": 335,
      "start": 702.079,
      "end": 705.519,
      "text": "करें मिलते हैं अगले वीडियो में थैंक यू"
    },
    {
      "subtitle_id": 336,
      "start": 703.76,
      "end": 707.399,
      "text": "सो मच फॉर वाचिंग दिस वीडियो और जाते-जाते"
    },
    {
      "subtitle_id": 337,
      "start": 705.519,
      "end": 709.44,
      "text": "हमारे मनी मास्टरी प्रोग्राम को जरूर चेक"
    },
    {
      "subtitle_id": 338,
      "start": 707.399,
      "end": 712.2,
      "text": "आउट कीजिए यहां पर हम आपको बनाएंगे एक"
    },
    {
      "subtitle_id": 339,
      "start": 709.44,
      "end": 716.36,
      "text": "इंडिपेंडेंट इन्वेस्टर जिसे आगे चलकर किसी"
    },
    {
      "subtitle_id": 340,
      "start": 712.2,
      "end": 716.36,
      "text": "पर भी डिपेंड रहने की जरूरत नहीं पड़ेगी"
    }
  ]
}