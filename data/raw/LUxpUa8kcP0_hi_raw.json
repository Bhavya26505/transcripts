    {
      "subtitle_id": 206,
      "start": 439.039,
      "end": 443.599,
      "text": "पैसे दे रहे हैं तो उसके रिटर्न में काम"
    },
    {
      "subtitle_id": 207,
      "start": 441.4,
      "end": 445.199,
      "text": "होना चाहिए और टा में वो गारंटी उनको"
    },
    {
      "subtitle_id": 208,
      "start": 443.599,
      "end": 446.919,
      "text": "मिलती है कि पैसा हमारा ऐसा फ्रॉड नहीं"
    },
    {
      "subtitle_id": 209,
      "start": 445.199,
      "end": 448.24,
      "text": "होगा हमारे साथ कोई स्कैम नहीं होगा और ये"
    },
    {
      "subtitle_id": 210,
      "start": 446.919,
      "end": 450.72,
      "text": "जो मैन्युफैक्चरिंग अपॉर्चुनिटी है"
    },
    {
      "subtitle_id": 211,
      "start": 448.24,
      "end": 453.16,
      "text": "सेमीकंडक्टर की उस उसमें भी सेम चीज है तो"
    },
    {
      "subtitle_id": 212,
      "start": 450.72,
      "end": 455.479,
      "text": "उसमें भी अगेन गेम ट्रस्ट का है और इसीलिए"
    },
    {
      "subtitle_id": 213,
      "start": 453.16,
      "end": 457.319,
      "text": "टाटा ने क्विकली डिसाइड किया और अभी जो"
    },
    {
      "subtitle_id": 214,
      "start": 455.479,
      "end": 459.199,
      "text": "तीन सेमीकंडक्टर प्लांट गवर्नमेंट ने"
    },
    {
      "subtitle_id": 215,
      "start": 457.319,
      "end": 461.68,
      "text": "अप्रूव किए है उसमें से दो टाटा ग्रुप के"
    },
    {
      "subtitle_id": 216,
      "start": 459.199,
      "end": 464.44,
      "text": "हैं जिसमें से एक आसाम में बनेगा मोरीगांव"
    },
    {
      "subtitle_id": 217,
      "start": 461.68,
      "end": 467.0,
      "text": "में और दूसरा बनेगा गुजरात में अब इसके"
    },
    {
      "subtitle_id": 218,
      "start": 464.44,
      "end": 468.639,
      "text": "लिए भी जो लागत है वो सारी टाटा सन से आ"
    },
    {
      "subtitle_id": 219,
      "start": 467.0,
      "end": 470.84,
      "text": "रही है जैसे कि मैं आसाम वाला ही उनका"
    },
    {
      "subtitle_id": 220,
      "start": 468.639,
      "end": 473.199,
      "text": "यूनिट ले लूं तो वहां पर एक दिन में 5"
    },
    {
      "subtitle_id": 221,
      "start": 470.84,
      "end": 476.12,
      "text": "करोड़ लगभग 5 करोड़ चिप्स बनेगी जिसके लिए"
    },
    {
      "subtitle_id": 222,
      "start": 473.199,
      "end": 478.44,
      "text": "जो इन्वेस्टमेंट लग रही है वो 27000 करोड़"
    },
    {
      "subtitle_id": 223,
      "start": 476.12,
      "end": 480.4,
      "text": "की है पैसा कहां से आएगा अगेन टाटा सन से"
    },
    {
      "subtitle_id": 224,
      "start": 478.44,
      "end": 482.28,
      "text": "तो इतनी सारी जगह पर अगर पैसा जा रहा है"
    },
    {
      "subtitle_id": 225,
      "start": 480.4,
      "end": 483.8,
      "text": "तो आपको एडिशनल कैपिटल की जरूरत पड़ेगी ही"
    },
    {
      "subtitle_id": 226,
      "start": 482.28,
      "end": 485.72,
      "text": "पड़ेगी क्योंकि पैसा सिर्फ यहां पर नहीं"
    },
    {
      "subtitle_id": 227,
      "start": 483.8,
      "end": 488.759,
      "text": "जा रहा है अभी कुछ ही सालों पहले उन्होंने"
    },
    {
      "subtitle_id": 228,
      "start": 485.72,
      "end": 491.12,
      "text": "लगभग 000 करोड़ टा मोट्स में इन्वेस्ट किए"
    },
    {
      "subtitle_id": 229,
      "start": 488.759,
      "end": 493.84,
      "text": "टा हाउसिंग फाइनेंस 8000 करोड़ रेज कर रहा"
    },
    {
      "subtitle_id": 230,
      "start": 491.12,
      "end": 495.479,
      "text": "है टाटा स से साथ ही टा कैपिटल ₹1 करोड़"
    },
    {
      "subtitle_id": 231,
      "start": 493.84,
      "end": 496.96,
      "text": "रेज कर रहा है तो इतनी सारी जो कैपिटल की"
    },
    {
      "subtitle_id": 232,
      "start": 495.479,
      "end": 498.68,
      "text": "रिक्वायरमेंट है ये सिर्फ डिविडेंड से तो"
    },
    {
      "subtitle_id": 233,
      "start": 496.96,
      "end": 500.52,
      "text": "होगी नहीं और अगर मैं टा s का आपको"
    },
    {
      "subtitle_id": 234,
      "start": 498.68,
      "end": 501.96,
      "text": "स्ट्रक्चर दिखाऊं कि अल्टीमेटली पैसा कहां"
    },
    {
      "subtitle_id": 235,
      "start": 500.52,
      "end": 503.52,
      "text": "से आ रहा है तो मेन सोर्स इनका डिविडेंड"
    },
    {
      "subtitle_id": 236,
      "start": 501.96,
      "end": 505.199,
      "text": "ही है तो इसलिए बहुत ज्यादा अग्रेसिव है"
    },
    {
      "subtitle_id": 237,
      "start": 503.52,
      "end": 507.479,
      "text": "इसलिए इन्होंने डेट लेना शुरू किया और ये"
    },
    {
      "subtitle_id": 238,
      "start": 505.199,
      "end": 510.199,
      "text": "आप इनके नेट डेट का ग्राफ देख सकते हैं कि"
    },
    {
      "subtitle_id": 239,
      "start": 507.479,
      "end": 512.68,
      "text": "कितना ज्यादा ये कर्ज ले रहे हैं तो 2016"
    },
    {
      "subtitle_id": 240,
      "start": 510.199,
      "end": 514.8,
      "text": "में ये नंबर्स 5000 करोड़ के करीब था फिर"
    },
    {
      "subtitle_id": 241,
      "start": 512.68,
      "end": 517.24,
      "text": "2017 में डबल से ये ज्यादा हो गया फिर"
    },
    {
      "subtitle_id": 242,
      "start": 514.8,
      "end": 519.519,
      "text": "धीरे-धीरे बढ़कर ये 26000 करोड़ तक चला"
    },
    {
      "subtitle_id": 243,
      "start": 517.24,
      "end": 521.76,
      "text": "गया था 2022 में बाद में इन्होंने इसे"
    },
    {
      "subtitle_id": 244,
      "start": 519.519,
      "end": 524.48,
      "text": "थोड़ा कम किया है और अब क्या आरबीआई क्या"
