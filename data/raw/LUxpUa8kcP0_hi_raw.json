    {
      "subtitle_id": 268,
      "start": 573.24,
      "end": 577.0,
      "text": "नहीं है और इसी चक्कर में इनके थोड़े"
    },
    {
      "subtitle_id": 269,
      "start": 574.72,
      "end": 579.079,
      "text": "कॉन्फ्लेट भी हुए थे सायरस मिस्ट्री और"
    },
    {
      "subtitle_id": 270,
      "start": 577.0,
      "end": 581.279,
      "text": "मिस्ट्री फैमिली से अगर आपको याद हो तो और"
    },
    {
      "subtitle_id": 271,
      "start": 579.079,
      "end": 583.32,
      "text": "उस पर हमने एक वीडियो भी बनाया था कि कौन"
    },
    {
      "subtitle_id": 272,
      "start": 581.279,
      "end": 584.92,
      "text": "सही कौन गलत तो सीधी बात करो तो टाटा सस"
    },
    {
      "subtitle_id": 273,
      "start": 583.32,
      "end": 587.0,
      "text": "को ज्यादा इंटरफेरेंस पसंद नहीं है और"
    },
    {
      "subtitle_id": 274,
      "start": 584.92,
      "end": 588.8,
      "text": "उनका काफी सारा फोकस वो फिलैंथरोपी पर भी"
    },
    {
      "subtitle_id": 275,
      "start": 587.0,
      "end": 591.12,
      "text": "है और वो भी किसी एंगल से वो मिस नहीं"
    },
    {
      "subtitle_id": 276,
      "start": 588.8,
      "end": 593.12,
      "text": "होने देना चाहते हैं बिकॉज़ अगर पब्लिक"
    },
    {
      "subtitle_id": 277,
      "start": 591.12,
      "end": 595.16,
      "text": "कंपनी बनानी है तो जो ट्रस्ट है उनको अपनी"
    },
    {
      "subtitle_id": 278,
      "start": 593.12,
      "end": 597.32,
      "text": "शेर होल्डिंग कम करके पब्लिक को देनी"
    },
    {
      "subtitle_id": 279,
      "start": 595.16,
      "end": 599.839,
      "text": "पड़ेगी जिसके अगेन टाटा संस फेवर में नहीं"
    },
    {
      "subtitle_id": 280,
      "start": 597.32,
      "end": 601.76,
      "text": "है तो इसीलिए टाटा संस अब हर कोई कोशिश कर"
    },
    {
      "subtitle_id": 281,
      "start": 599.839,
      "end": 603.72,
      "text": "रही है कि इस आईपीओ को कैसे अवॉइड किया जा"
    },
    {
      "subtitle_id": 282,
      "start": 601.76,
      "end": 607.519,
      "text": "सकता है तो ऐसे में टाटा सस के पास दो"
    },
    {
      "subtitle_id": 283,
      "start": 603.72,
      "end": 609.959,
      "text": "सॉल्यूशन है कि उन्हें अपना जो एसेट है व"
    },
    {
      "subtitle_id": 284,
      "start": 607.519,
      "end": 611.959,
      "text": "100 करोड़ से कम करना पड़ेगा साथ ही जो"
    },
    {
      "subtitle_id": 285,
      "start": 609.959,
      "end": 613.6,
      "text": "पब्लिक फंड है वो कोई रेज नहीं करना"
    },
    {
      "subtitle_id": 286,
      "start": 611.959,
      "end": 615.88,
      "text": "पड़ेगा तो पब्लिक फंड इनका काफी सारा"
    },
    {
      "subtitle_id": 287,
      "start": 613.6,
      "end": 618.12,
      "text": "बॉन्ड के जरिए आया है तो यह कोशिश कर रहे"
    },
    {
      "subtitle_id": 288,
      "start": 615.88,
      "end": 620.44,
      "text": "हैं कि बॉन्ड के जरिए सारा बॉन्ड क्लियर"
    },
    {
      "subtitle_id": 289,
      "start": 618.12,
      "end": 622.24,
      "text": "करके बैलेंस शीट क्लियर कर देते हैं साथ"
    },
    {
      "subtitle_id": 290,
      "start": 620.44,
      "end": 624.88,
      "text": "ही किसी तरह का पब्लिक फंड भी अपने पास"
    },
    {
      "subtitle_id": 291,
      "start": 622.24,
      "end": 627.399,
      "text": "नहीं रखते जिसके बाद व एनबीएफसी कैटेगरी"
    },
    {
      "subtitle_id": 292,
      "start": 624.88,
      "end": 629.8,
      "text": "इज नहीं होंगे और यह एक तरीका है जिससे वह"
    },
    {
      "subtitle_id": 293,
      "start": 627.399,
      "end": 631.839,
      "text": "इस आईपीओ को अवॉइड कर सकते हैं अब देखिए"
    },
    {
      "subtitle_id": 294,
      "start": 629.8,
      "end": 633.6,
      "text": "किसी कारण टा s को आईओ लाना ही पड़ता है"
    },
    {
      "subtitle_id": 295,
      "start": 631.839,
      "end": 635.72,
      "text": "तो एक्चुअली लोगों के लिए तो लॉटरी होगी"
    },
    {
      "subtitle_id": 296,
      "start": 633.6,
      "end": 638.44,
      "text": "क्योंकि यह ऐसा ग्रुप है जो हमेशा जो"
    },
    {
      "subtitle_id": 297,
      "start": 635.72,
      "end": 641.0,
      "text": "इन्वेस्टर्स हैं उनके लिए एक डिस्काउंट"
    },
    {
      "subtitle_id": 298,
      "start": 638.44,
      "end": 642.88,
      "text": "रखता है टेबल पर ताकि सब लोग उस चीज का"
    },
    {
      "subtitle_id": 299,
      "start": 641.0,
      "end": 644.639,
      "text": "फायदा ले सके जो कि बहुत रेयर है इंडिया"
    },
    {
      "subtitle_id": 300,
      "start": 642.88,
      "end": 646.24,
      "text": "में क्योंकि हर एक प्रमोटर यही चाहता है"
    },
    {
      "subtitle_id": 301,
      "start": 644.639,
      "end": 648.399,
      "text": "कि मेरा शेयर ज्यादा से ज्यादा भाव में"
    },
    {
      "subtitle_id": 302,
      "start": 646.24,
      "end": 650.12,
      "text": "बिके ताकि मैं ज्यादा पैसा कमाऊं बट टाटा"
    },
    {
      "subtitle_id": 303,
      "start": 648.399,
      "end": 652.0,
      "text": "ग्रुप इज एक्सेप्शन तो ओवरऑल ये सारा"
    },
    {
      "subtitle_id": 304,
      "start": 650.12,
      "end": 653.76,
      "text": "मामला है अब कई सारे लोगों को क्या लग रहा"
    },
    {
      "subtitle_id": 305,
      "start": 652.0,
      "end": 655.72,
      "text": "है कि टीसीएस में कंपनी शेयर बेच रही है"
    },
    {
      "subtitle_id": 306,
      "start": 653.76,
      "end": 657.76,
      "text": "मतलब शायद कंपनी का कॉन्फिडेंस बहुत कम हो"
    },
    {
      "subtitle_id": 307,
      "start": 655.72,
      "end": 660.12,
      "text": "गया है वैसा नहीं है तो एक तो इनको"
    },
    {
      "subtitle_id": 308,
      "start": 657.76,
      "end": 662.16,
      "text": "डिपेंडेंसी ज्यादा रखनी नहीं है और अगर"
    },
    {
      "subtitle_id": 309,
      "start": 660.12,
      "end": 664.279,
      "text": "मैं टीसीएस की बात करूं तो ग्रोथ तो"
    },
    {
      "subtitle_id": 310,
      "start": 662.16,
      "end": 666.12,
      "text": "ऑफकोर्स थोड़ी स्लो डाउन तो हो गई है"
    },
    {
      "subtitle_id": 311,
      "start": 664.279,
      "end": 668.2,
      "text": "लेकिन मजबूरी में अभी इन्हें बेचना पड़"
    },
    {
      "subtitle_id": 312,
      "start": 666.12,
      "end": 670.76,
      "text": "रहा है उनका ऐसा कोई इंटेंशन नहीं कि इसको"
    },
    {
      "subtitle_id": 313,
      "start": 668.2,
      "end": 672.88,
      "text": "बेच के पब्लिक को दे दो और खुद बाहर निकल"
    },
    {
      "subtitle_id": 314,
      "start": 670.76,
      "end": 674.88,
      "text": "जाओ तो इंटेंशन इनके बड़े क्लियर है कि"
    },
    {
      "subtitle_id": 315,
      "start": 672.88,
      "end": 677.36,
      "text": "एनबीएफसी का ये जो टैग है ये हटाना चाहते"
    },
    {
      "subtitle_id": 316,
      "start": 674.88,
      "end": 679.079,
      "text": "हैं इसके लिए शायद इन्हें जरूरत पड़ी तो"
    },
    {
      "subtitle_id": 317,
      "start": 677.36,
      "end": 681.92,
      "text": "और भी थोड़ा बहुत टीसीएस का स्टेक बेचने"
    },
    {
      "subtitle_id": 318,
      "start": 679.079,
      "end": 683.8,
      "text": "की जरूरत पड़ सकती है और अपना जो 20 20000"
    },
    {
      "subtitle_id": 319,
      "start": 681.92,
      "end": 685.44,
      "text": "करोड़ का जो नेट डेट है वो जल्द से जल्द"
    },
    {
      "subtitle_id": 320,
      "start": 683.8,
      "end": 687.88,
      "text": "वो क्लियर करने की कोशिश कर रहे हैं ताकि"
    },
    {
      "subtitle_id": 321,
      "start": 685.44,
      "end": 689.92,
      "text": "इस एनबीएफसी टैक्स से वो बाहर निकले तो आई"
    },
    {
      "subtitle_id": 322,
      "start": 687.88,
      "end": 691.44,
      "text": "होप आपको सारी चीजें क्लियर हो गई होंगी"
    },
    {
      "subtitle_id": 323,
      "start": 689.92,
      "end": 693.04,
      "text": "तो इसी तरह के शेयर मार्केट वीडियोस को"
    },
    {
      "subtitle_id": 324,
      "start": 691.44,
      "end": 694.44,
      "text": "डिटेल में समझने के लिए चैनल को जरूर"
    },
    {
      "subtitle_id": 325,
      "start": 693.04,
      "end": 696.0,
      "text": "सब्सक्राइब कीजिए और बेल आइकॉन पर भी"
    },
    {
      "subtitle_id": 326,
      "start": 694.44,
      "end": 698.2,
      "text": "क्लिक कीजिए और इस वीडियो को ज्यादा से"
    },
    {
      "subtitle_id": 327,
      "start": 696.0,
      "end": 699.959,
      "text": "ज्यादा शेयर कीजिए ताकि बाकी लोगों को भी"
    },
    {
      "subtitle_id": 328,
      "start": 698.2,
      "end": 702.16,
      "text": "क्या चल रहा है टीसीएस में और टा ग्रुप"
    },
    {
      "subtitle_id": 329,
      "start": 699.959,
      "end": 703.88,
      "text": "में यह पता चल सके जाते-जाते एम को जरूर"
    },
    {
      "subtitle_id": 330,
      "start": 702.16,
      "end": 705.32,
      "text": "चेक आउट कीजिए अगर इन केस फ्यूचर में आपको"
    },
    {
      "subtitle_id": 331,
      "start": 703.88,
      "end": 707.079,
      "text": "पर्सनल लोन लेने की जरूरत पड़ती है तो"
    },
    {
      "subtitle_id": 332,
      "start": 705.32,
      "end": 708.92,
      "text": "उससे एक जरूर बेटर ऑप्शन आपके पास यह"
    },
    {
      "subtitle_id": 333,
      "start": 707.079,
      "end": 712.16,
      "text": "रहेगा मिलते हैं अगले वीडियो में थैंक यू"
    },
    {
      "subtitle_id": 334,
      "start": 708.92,
      "end": 712.16,
      "text": "सो मच फॉर वाचिंग दिस वीडियो"
    }
  ]
}