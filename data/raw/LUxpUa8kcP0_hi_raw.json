    {
      "subtitle_id": 245,
      "start": 521.76,
      "end": 526.6,
      "text": "बोल रहा है कि आप इस हिसाब से आपके करंट"
    },
    {
      "subtitle_id": 246,
      "start": 524.48,
      "end": 528.12,
      "text": "स्ट्रक्चर के अनुसार आप एक एनबीएफसी में"
    },
    {
      "subtitle_id": 247,
      "start": 526.6,
      "end": 530.72,
      "text": "कैटेगरी इज होते हो तो आरबीआई की जो"
    },
    {
      "subtitle_id": 248,
      "start": 528.12,
      "end": 532.959,
      "text": "फ्रेमवर्क है नहीं उसके अनुसार टाटा सस एक"
    },
    {
      "subtitle_id": 249,
      "start": 530.72,
      "end": 536.08,
      "text": "अपर लेयर एनबीएफसी में कैटेगरी इज होता है"
    },
    {
      "subtitle_id": 250,
      "start": 532.959,
      "end": 538.24,
      "text": "और सबसे मतलब इससे भी शायद टा s को कोई"
    },
    {
      "subtitle_id": 251,
      "start": 536.08,
      "end": 540.48,
      "text": "दिक्कत नहीं थी लेकिन इसके साथ एक कंडीशन"
    },
    {
      "subtitle_id": 252,
      "start": 538.24,
      "end": 542.68,
      "text": "आती है कि जो भी अपर लेयर एनबीएफसी हैं"
    },
    {
      "subtitle_id": 253,
      "start": 540.48,
      "end": 544.88,
      "text": "उन्हें 3 साल के अंदर लिस्ट होना होगा"
    },
    {
      "subtitle_id": 254,
      "start": 542.68,
      "end": 547.24,
      "text": "स्टॉक एक्सचेंज पर अब यहां पर प्रॉब्लम यह"
