  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.04,
      "end": 5.92,
      "text": "फिलहाल मार्केट में जो सबसे हॉट स्टॉक है"
    },
    {
      "subtitle_id": 2,
      "start": 1.76,
      "end": 9.36,
      "text": "वह है आईआरएफसी यह 1 साल में पिछले 445 पर"
    },
    {
      "subtitle_id": 3,
      "start": 5.92,
      "end": 11.92,
      "text": "स्टॉक बढ़ गया है और 15060 के आसपास अभी"
    },
    {
      "subtitle_id": 4,
      "start": 9.36,
      "end": 14.4,
      "text": "ट्रेड कर रहा है इसी बीच बहुत सारे लोग अब"
    },
    {
      "subtitle_id": 5,
      "start": 11.92,
      "end": 16.119,
      "text": "इसे 150 160 170 की प्राइस पर खरीद रहे"
    },
    {
      "subtitle_id": 6,
      "start": 14.4,
      "end": 18.92,
      "text": "हैं और कई सारे लोगों ने इसका टारगेट अब"
    },
    {
      "subtitle_id": 7,
      "start": 16.119,
      "end": 21.88,
      "text": "सोच लिया है कि यह 600 700 जाएगा तो इस"
    },
    {
      "subtitle_id": 8,
      "start": 18.92,
      "end": 23.8,
      "text": "लेवल से भी 4 टू 5x पैसा बन सकता है पर"
    },
    {
      "subtitle_id": 9,
      "start": 21.88,
      "end": 26.119,
      "text": "क्या यह रियली हो सकता है इसके बारे में"
    },
    {
      "subtitle_id": 10,
      "start": 23.8,
      "end": 28.64,
      "text": "बात करेंगे कितना पोटेंशियल है फंडामेंटली"
    },
    {
      "subtitle_id": 11,
      "start": 26.119,
      "end": 31.0,
      "text": "मतलब कुछ लोग बोल रहे हैं कि अभी भी बहुत"
    },
    {
      "subtitle_id": 12,
      "start": 28.64,
      "end": 33.76,
      "text": "पोटेंशियल है आईआरएफसी में और भी बहुत"
    },
    {
      "subtitle_id": 13,
      "start": 31.0,
      "end": 35.92,
      "text": "मल्टीबैगर ये बन सकता है लेकिन कुछ लोगों"
    },
    {
      "subtitle_id": 14,
      "start": 33.76,
      "end": 37.48,
      "text": "का फिर यह भी मानना है कि ऑलरेडी इसका"
    },
    {
      "subtitle_id": 15,
      "start": 35.92,
      "end": 39.6,
      "text": "वैल्युएशन काफी ज्यादा हो गया है तो क्या"
    },
    {
      "subtitle_id": 16,
      "start": 37.48,
      "end": 41.039,
      "text": "यह रियलिटी है तो वैल्युएशन की भी बात आती"
    },
    {
      "subtitle_id": 17,
      "start": 39.6,
      "end": 42.64,
      "text": "है तो क्या है ना कि कई बार ऐसे कुछ"
    },
    {
      "subtitle_id": 18,
      "start": 41.039,
      "end": 44.879,
      "text": "स्टॉक्स होते हैं जिनका वैल्युएशन थोड़ा"
    },
    {
      "subtitle_id": 19,
      "start": 42.64,
      "end": 47.0,
      "text": "ज्यादा भी होता है लेकिन उनकी कंसिस्टेंट"
    },
    {
      "subtitle_id": 20,
      "start": 44.879,
      "end": 49.12,
      "text": "ग्रोथ की वजह से कभी ना कभी वैल्युएशन को"
    },
    {
      "subtitle_id": 21,
      "start": 47.0,
      "end": 51.12,
      "text": "जस्टिफाई कर लेते हैं तो क्या आईआरएफसी"
    },
    {
      "subtitle_id": 22,
      "start": 49.12,
      "end": 52.8,
      "text": "ऐसा कर पाएगा बड़ा सवाल है तो आज के इस"
    },
    {
      "subtitle_id": 23,
      "start": 51.12,
      "end": 55.16,
      "text": "वीडियो में इन्हीं सारे सवालों का डिटेल"
    },
    {
      "subtitle_id": 24,
      "start": 52.8,
      "end": 56.76,
      "text": "जवाब आपको मिल जाएगा नमस्कार मैं प्रसाद"
    },
    {
      "subtitle_id": 25,
      "start": 55.16,
      "end": 58.32,
      "text": "आपका आज के इस वीडियो में स्वागत करता हूं"
    },
    {
      "subtitle_id": 26,
      "start": 56.76,
      "end": 60.68,
      "text": "देखिए आईआरएफसी की अगर मैं बात करूं तो"
    },
    {
      "subtitle_id": 27,
      "start": 58.32,
      "end": 61.92,
      "text": "इसके पॉजिटिव सभी को पता है कि गवर्नमेंट"
    },
    {
      "subtitle_id": 28,
      "start": 60.68,
      "end": 63.6,
      "text": "का जो रेलवे का एक्सपेंडिचर है वो"
    },
    {
      "subtitle_id": 29,
      "start": 61.92,
      "end": 65.04,
      "text": "कंटीन्यूअसली बढ़ रहा है आप देख सकते हैं"
    },
    {
      "subtitle_id": 30,
      "start": 63.6,
      "end": 67.36,
      "text": "पिछले 5 साल में ही कितनी तेजी से"
    },
    {
      "subtitle_id": 31,
      "start": 65.04,
      "end": 69.479,
      "text": "एक्सपेंडिचर बढ़ा है इनफैक्ट पिछले एक साल"
    },
    {
      "subtitle_id": 32,
      "start": 67.36,
      "end": 71.799,
      "text": "में ही जो न्यू लाइंस है रेलवे की डबलिंग"
    },
    {
      "subtitle_id": 33,
      "start": 69.479,
      "end": 74.119,
      "text": "है ट्रैफिक फैसिलिटी है बाकी चीजें वो"
    },
    {
      "subtitle_id": 34,
      "start": 71.799,
      "end": 76.64,
      "text": "बहुत तेजी से ग्रो कर रही है और इन सारी"
    },
    {
      "subtitle_id": 35,
      "start": 74.119,
      "end": 78.479,
      "text": "चीजों का फायदा देखिए जब भी रेलवे रिलेटेड"
    },
    {
      "subtitle_id": 36,
      "start": 76.64,
      "end": 80.159,
      "text": "अभी वंदे भारत का भी चल रहा है कि स्लीपर"
    },
    {
      "subtitle_id": 37,
      "start": 78.479,
      "end": 82.32,
      "text": "कोचेस वगैरह आ रहे हैं अब ये सभी को पता"
    },
    {
      "subtitle_id": 38,
      "start": 80.159,
      "end": 85.0,
      "text": "है जिसकी वजह से लोग अभी आईआरएफसी पर टूट"
    },
    {
      "subtitle_id": 39,
      "start": 82.32,
      "end": 87.28,
      "text": "पड़े हैं तो क्या ये मोमेंटम बना रहेगा तो"
    },
    {
      "subtitle_id": 40,
      "start": 85.0,
      "end": 88.96,
      "text": "एक शॉकिंग चीज जो रिसेंटली ये हुई है कि"
    },
    {
      "subtitle_id": 41,
      "start": 87.28,
      "end": 90.4,
      "text": "अगर आप आईआरपीसी के पिछले एक साल के"
    },
    {
      "subtitle_id": 42,
      "start": 88.96,
      "end": 92.28,
      "text": "फाइनेंशियल्स देखें"
    },
    {
      "subtitle_id": 43,
      "start": 90.4,
      "end": 94.079,
      "text": "तो उसमें ग्रोथ अभी उतनी नहीं हो रही है"
    },
    {
      "subtitle_id": 44,
      "start": 92.28,
      "end": 96.799,
      "text": "जितनी कि पहले हो रही थी पहले कितनी हो"
    },
    {
      "subtitle_id": 45,
      "start": 94.079,
      "end": 98.799,
      "text": "रही थी तो 2025 पर की कंपनी की ग्रोथ"
    },
    {
      "subtitle_id": 46,
      "start": 96.799,
      "end": 100.799,
      "text": "लगातार चल रही थी रेवेन्यू में भी प्रॉफिट"
    },
    {
      "subtitle_id": 47,
      "start": 98.799,
      "end": 102.2,
      "text": "में भी लेकिन अचानक वो नहीं हो रही है और"
    },
    {
      "subtitle_id": 48,
      "start": 100.799,
      "end": 104.079,
      "text": "कंपनी का तो यह भी मानना है कि अगले"
    },
    {
      "subtitle_id": 49,
      "start": 102.2,
      "end": 106.52,
      "text": "दो-तीन क्वार्टर में वो नहीं होगी ऐसा"
    },
    {
      "subtitle_id": 50,
      "start": 104.079,
      "end": 109.36,
      "text": "क्यों और कब शुरू होगी इंटरेस्टिंग सवाल"
    },
    {
      "subtitle_id": 51,
      "start": 106.52,
      "end": 111.2,
      "text": "है तो देखिए आईआरएफसी के मैनेजमेंट की"
    },
    {
      "subtitle_id": 52,
      "start": 109.36,
      "end": 112.479,
      "text": "बड़ी क्लेरिटी है मतलब उसकी भी उनको दात"
    },
    {
      "subtitle_id": 53,
      "start": 111.2,
      "end": 114.24,
      "text": "देनी पड़ेगी कि उन्हें इस चीज की"
    },
    {
      "subtitle_id": 54,
      "start": 112.479,
      "end": 115.719,
      "text": "अंडरस्टैंडिंग है तो उनका यह मानना है कि"
    },
    {
      "subtitle_id": 55,
      "start": 114.24,
      "end": 117.36,
      "text": "हमारा ये अनुमान है कि आने वाले कुछ"
    },
    {
      "subtitle_id": 56,
      "start": 115.719,
      "end": 119.32,
      "text": "क्वार्टर्स में उतना बिजनेस अच्छा नहीं"
    },
    {
      "subtitle_id": 57,
      "start": 117.36,
      "end": 121.84,
      "text": "आएगा क्योंकि गवर्नमेंट क्या करती है"
    },
    {
      "subtitle_id": 58,
      "start": 119.32,
      "end": 124.28,
      "text": "लोकसभा के इलेक्शंस आते हैं तब गवर्नमेंट"
    },
    {
      "subtitle_id": 59,
      "start": 121.84,
      "end": 126.24,
      "text": "फोकस उन स्कीम्स पर करती है जिसका फायदा"
    },
    {
      "subtitle_id": 60,
      "start": 124.28,
      "end": 128.119,
      "text": "सीधे लोगों तक पहुंचता है ताकि लोगों को"
    },
    {
      "subtitle_id": 61,
      "start": 126.24,
      "end": 130.84,
      "text": "इंप्रेस किया जा सके और उससे ऑफकोर्स"
    },
    {
      "subtitle_id": 62,
      "start": 128.119,
      "end": 133.239,
      "text": "इलेक्शन है तो वोटिंग में भी उसका बेनिफिट"
    },
    {
      "subtitle_id": 63,
      "start": 130.84,
      "end": 135.92,
      "text": "मिलता है तो उस पर्टिकुलर पीरियड में जब"
    },
    {
      "subtitle_id": 64,
      "start": 133.239,
      "end": 138.2,
      "text": "तक नई सरकार नहीं आ जाती तब तक जो इलेक्शन"
    },
    {
      "subtitle_id": 65,
      "start": 135.92,
      "end": 140.08,
      "text": "के पहले के छ आठ महीने होते हैं उसमें जो"
    },
    {
      "subtitle_id": 66,
      "start": 138.2,
      "end": 142.0,
      "text": "कैपिटल एक्सपेंडिचर होता है रेलवेज में"
    },
    {
      "subtitle_id": 67,
      "start": 140.08,
      "end": 144.8,
      "text": "पर्टिकुलर तो आईआरएफसी का मानना है कि"
    },
    {
      "subtitle_id": 68,
      "start": 142.0,
      "end": 147.08,
      "text": "वहां पर थोड़ी बहुत कमी रहेगी और इसी वजह"
    },
    {
      "subtitle_id": 69,
      "start": 144.8,
      "end": 148.92,
      "text": "से जो ग्रोथ रहेगी अगले दो क्वार्टर्स में"
    },
    {
      "subtitle_id": 70,
      "start": 147.08,
      "end": 150.599,
      "text": "भी वो थोड़ी कम रहेगी तो उनका ये मानना है"
    },
    {
      "subtitle_id": 71,
      "start": 148.92,
      "end": 152.92,
      "text": "कि इलेक्शन होने के बाद गवर्मेंट फॉर्म हो"
    },
    {
      "subtitle_id": 72,
      "start": 150.599,
      "end": 154.8,
      "text": "जाएगी तो उसके बाद फिर से इस तरह की ग्रोथ"
    },
    {
      "subtitle_id": 73,
      "start": 152.92,
      "end": 157.08,
      "text": "हम एक्सपेक्ट कर सकते हैं यानी बिजनेस की"
    },
    {
      "subtitle_id": 74,
      "start": 154.8,
      "end": 159.0,
      "text": "जो ग्रोथ है फिलहाल रुकी है लेकिन कंपनी"
    },
    {
      "subtitle_id": 75,
      "start": 157.08,
      "end": 161.68,
      "text": "का मानना है कि फिर से वापस आएगी और मुझे"
    },
    {
      "subtitle_id": 76,
      "start": 159.0,
      "end": 163.84,
      "text": "भी यह लगता है कि ये वापस आएगी और मतलब"
    },
    {
      "subtitle_id": 77,
      "start": 161.68,
      "end": 165.64,
      "text": "अबोव 15 पर की ग्रोथ कंपनी कंटिन्यू कर"
    },
    {
      "subtitle_id": 78,
      "start": 163.84,
      "end": 167.519,
      "text": "सकती है आने वाले टाइम में लेकिन फिलहाल"
    },
    {
      "subtitle_id": 79,
      "start": 165.64,
      "end": 169.36,
      "text": "कंपनी का जो बिजनेस चल रहा है उस हिसाब से"
    },
    {
      "subtitle_id": 80,
      "start": 167.519,
      "end": 172.239,
      "text": "क्या कंपनी का वैल्युएशन फिर ऐसा है कि"
    },
    {
      "subtitle_id": 81,
      "start": 169.36,
      "end": 174.64,
      "text": "150 के शेयर प्राइस 00 00 जा सकती है आने"
    },
    {
      "subtitle_id": 82,
      "start": 172.239,
      "end": 176.76,
      "text": "वाले नियर टर्म फ्यूचर में तो उसके लिए"
    },
    {
      "subtitle_id": 83,
      "start": 174.64,
      "end": 178.599,
      "text": "हमें कुछ चीजें देखनी पड़ेगी जैसे कि आप"
    },
    {
      "subtitle_id": 84,
      "start": 176.76,
      "end": 180.959,
      "text": "देख सकते हैं कि अगर मैं आपको पी रेशो का"
    },
    {
      "subtitle_id": 85,
      "start": 178.599,
      "end": 184.08,
      "text": "ये ग्राफ दिखाऊं तो कंपनी का जो पी रेशो"
    },
    {
      "subtitle_id": 86,
      "start": 180.959,
      "end": 186.56,
      "text": "था जो 4 5 6 7 या 10 के नीचे ही था वह भी"
    },
    {
      "subtitle_id": 87,
      "start": 184.08,
      "end": 189.159,
      "text": "बहुत बढ़ के चला गया 30 के पार तो क्या यह"
    },
    {
      "subtitle_id": 88,
      "start": 186.56,
      "end": 191.04,
      "text": "सही है तो देखिए अगर 30 पर का कोई कंपनी"
    },
    {
      "subtitle_id": 89,
      "start": 189.159,
      "end": 193.239,
      "text": "पी मांग रही है और उस तरह की ग्रोथ दिखा"
    },
    {
      "subtitle_id": 90,
      "start": 191.04,
      "end": 195.92,
      "text": "रही है 30 पर की बिजनेस में तो फेयर है"
    },
    {
      "subtitle_id": 91,
      "start": 193.239,
      "end": 198.28,
      "text": "लेकिन यहां पर फिलहाल कुछ टाइम के लिए जो"
    },
    {
      "subtitle_id": 92,
      "start": 195.92,
      "end": 199.76,
      "text": "ग्रोथ है वो धीमी हो गई है तो आने वाले"
    },
    {
      "subtitle_id": 93,
      "start": 198.28,
      "end": 201.92,
      "text": "टाइम में अगर आप ये एक्सपेक्ट कर रहे हैं"
    },
    {
      "subtitle_id": 94,
      "start": 199.76,
      "end": 203.68,
      "text": "कि शेयर प्राइस और ज्यादा बढ़ेगी तो पी"
    },
    {
      "subtitle_id": 95,
      "start": 201.92,
      "end": 205.56,
