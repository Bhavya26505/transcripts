      "subtitle_id": 191,
      "start": 406.84,
      "end": 410.52,
      "text": "शेयर प्राइस उसी डायरेक्शन में जाएगी तो"
    },
    {
      "subtitle_id": 192,
      "start": 408.599,
      "end": 412.56,
      "text": "फिलहाल तो वैसा कुछ नहीं हो रहा है कंपनी"
    },
    {
      "subtitle_id": 193,
      "start": 410.52,
      "end": 414.24,
      "text": "के अगर फंडामेंटल्स की बात करें तो एकदम"
    },
    {
      "subtitle_id": 194,
      "start": 412.56,
      "end": 417.24,
      "text": "स्ट्रांग ग्रोथ तो यहां पर नहीं आ रही है"
    },
    {
      "subtitle_id": 195,
      "start": 414.24,
      "end": 419.639,
      "text": "तो दोज हु हैव बट एट हायर लेवल तो आपको"
    },
    {
      "subtitle_id": 196,
      "start": 417.24,
      "end": 421.319,
      "text": "काफी लंबे टाइम तक वेट करना पड़ेगा इस्ट"
    },
    {
      "subtitle_id": 197,
      "start": 419.639,
      "end": 423.72,
      "text": "को जस्टिफाई करने के लिए क्योंकि आपने जो"
    },
    {
      "subtitle_id": 198,
      "start": 421.319,
      "end": 425.44,
      "text": "टारगेट लिए काफी बार 400 500 के क्विकली"
    },
    {
      "subtitle_id": 199,
      "start": 423.72,
      "end": 427.4,
      "text": "हो जाएगा तो बहुत सारे लोग क्या करते हैं"
    },
    {
      "subtitle_id": 200,
      "start": 425.44,
      "end": 429.319,
      "text": "कि अचानक से कोई शेयर प्राइस 52 एक हाई टच"
    },
    {
      "subtitle_id": 201,
      "start": 427.4,
      "end": 430.879,
      "text": "कर लेते तो उसमें एंटर करते यह सोच के कि"
    },
    {
      "subtitle_id": 202,
      "start": 429.319,
      "end": 432.72,
      "text": "आगे चलके भी वो जर्नी शुरू होगी लेकिन"
    },
    {
      "subtitle_id": 203,
      "start": 430.879,
      "end": 434.68,
      "text": "आपको यह देखना पड़ेगा कि क्या बिजनेस की"
    },
    {
      "subtitle_id": 204,
      "start": 432.72,
      "end": 436.68,
      "text": "ग्रोथ उस तरह से जारी है या नहीं अगर"
    },
    {
      "subtitle_id": 205,
      "start": 434.68,
      "end": 438.72,
      "text": "लॉन्ग टर्म में कंपनी 20 पर की ग्रोथ से"
    },
    {
      "subtitle_id": 206,
      "start": 436.68,
      "end": 440.44,
      "text": "बढ़ रही है तो आपकी जो इन्वेस्टिंग ग्रोथ"
    },
    {
      "subtitle_id": 207,
      "start": 438.72,
      "end": 442.72,
      "text": "है उस कंपनी से आने वाली शेयर से आने वाली"
    },
    {
      "subtitle_id": 208,
      "start": 440.44,
      "end": 444.4,
      "text": "वो भी 20 30 पर ही आएगी वहां पर अगर आपके"
    },
    {
      "subtitle_id": 209,
      "start": 442.72,
      "end": 445.919,
      "text": "एक्सपेक्टेशन है कि बिज़नेस 10 पर से बढ़"
    },
    {
      "subtitle_id": 210,
      "start": 444.4,
      "end": 447.56,
      "text": "रहा है मुझे 50 पर के रिटर्न्स मिलने"
    },
    {
      "subtitle_id": 211,
      "start": 445.919,
      "end": 449.479,
      "text": "चाहिए तो कहीं ना कहीं आपके एक्सपेक्टशंस"
    },
    {
      "subtitle_id": 212,
      "start": 447.56,
      "end": 451.52,
      "text": "गलत है तो बस इन्हीं सारी चीजों से से"
    },
    {
      "subtitle_id": 213,
      "start": 449.479,
      "end": 453.4,
      "text": "आपको अपडेट करना था कि बहुत सारा यूफोरिया"
    },
    {
      "subtitle_id": 214,
      "start": 451.52,
      "end": 455.0,
      "text": "चल रहा है मार्केट में हर कोई आईआरएफसी"
    },
    {
      "subtitle_id": 215,
      "start": 453.4,
      "end": 457.12,
      "text": "आरएफसी कर रहा है और रेलवे के स्टॉक्स में"
    },
    {
      "subtitle_id": 216,
      "start": 455.0,
      "end": 458.72,
      "text": "इन्वेस्ट कर रहा है बट आपको बिजनेस"
    },
    {
      "subtitle_id": 217,
      "start": 457.12,
      "end": 460.639,
      "text": "फंडामेंटल्स देखने हैं और उस हिसाब से"
    },
    {
      "subtitle_id": 218,
      "start": 458.72,
      "end": 462.319,
      "text": "अपनी डिसीजन लेनी है अगर आप इन्वेस्टमेंट"
    },
    {
      "subtitle_id": 219,
      "start": 460.639,
      "end": 464.199,
      "text": "कर भी रहे हैं तो आपके पास यह क्लेरिटी"
    },
    {
      "subtitle_id": 220,
      "start": 462.319,
      "end": 466.96,
      "text": "होनी चाहिए कि बिज़नेस अगर बोल रहा है कि"
    },
    {
      "subtitle_id": 221,
      "start": 464.199,
      "end": 470.039,
      "text": "टाइम लगेगा तो बहुत लंबा टाइम 3 4 5 साल 8"
    },
    {
      "subtitle_id": 222,
      "start": 466.96,
      "end": 472.56,
      "text": "साल रुकने का मेरे अंदर वो एक पेशेंस होना"
    },
    {
      "subtitle_id": 223,
      "start": 470.039,
      "end": 475.08,
      "text": "चाहिए क्योंकि मतलब मुझे लगता है कि अगर"
    },
    {
      "subtitle_id": 224,
      "start": 472.56,
      "end": 477.4,
      "text": "फिर से एंडिया गवर्नमेंट फॉर्म हो जाती है"
    },
    {
      "subtitle_id": 225,
      "start": 475.08,
      "end": 479.44,
      "text": "तो अगेन गवर्नमेंट विल फोकस अ लॉट ऑन द"
    },
    {
      "subtitle_id": 226,
      "start": 477.4,
      "end": 481.84,
      "text": "रेलवे इंफ्रास्ट्रक्चर जो कि इनका है कि"
    },
    {
      "subtitle_id": 227,
      "start": 479.44,
      "end": 484.44,
      "text": "फास्ट रेलवे बनाना है कॉरिडॉर बनाने हैं"
    },
    {
      "subtitle_id": 228,
      "start": 481.84,
      "end": 486.56,
      "text": "बाकी चीजें मतलब फ्रेट कॉरिडॉर बनाना है"
    },
    {
      "subtitle_id": 229,
      "start": 484.44,
      "end": 488.24,
      "text": "तो ग्रोथ तो है वहां पर और आरएफसी अकेली"
    },
    {
      "subtitle_id": 230,
      "start": 486.56,
      "end": 491.159,
      "text": "ऐसी कंपनी है जो इंडियन रेलवेज को लोन दे"
    },
    {
      "subtitle_id": 231,
      "start": 488.24,
      "end": 493.159,
      "text": "सकती है लीज पर एसेट्स दे सकती है फायदा"
    },
    {
      "subtitle_id": 232,
      "start": 491.159,
      "end": 495.639,
      "text": "तो जैसे-जैसे ये एक्सपेंडिचर बढ़ता चला"
    },
    {
      "subtitle_id": 233,
      "start": 493.159,
      "end": 497.599,
      "text": "जाएगा कुछ एस्टिमेट्स ये बता रहे हैं कि"
    },
    {
      "subtitle_id": 234,
      "start": 495.639,
      "end": 500.08,
      "text": "आने वाले फाइनेंशियल ईयर में जो कैपिटल"
    },
    {
      "subtitle_id": 235,
      "start": 497.599,
      "end": 501.72,
      "text": "एक्सपेंडिचर है वो और 2025 से बढ़ेगा तो"
    },
    {
      "subtitle_id": 236,
      "start": 500.08,
      "end": 503.4,
      "text": "उसका डायरेक्ट फायदा आरएफसी को होता है"
    },
    {
      "subtitle_id": 237,
      "start": 501.72,
      "end": 505.479,
      "text": "बाकी रेलवे स्टॉक्स तो किसी को हो या ना"
    },
    {
      "subtitle_id": 238,
      "start": 503.4,
      "end": 507.0,
      "text": "हो आईआरएफसी को जरूर होता है और मुझे लगता"
    },
    {
      "subtitle_id": 239,
      "start": 505.479,
      "end": 508.56,
      "text": "है ग्रोथ स्टोरी बहुत लंबे टाइम के लिए"
    },
    {
      "subtitle_id": 240,
      "start": 507.0,
      "end": 510.44,
      "text": "जारी रहेगी क्योंकि इंफ्रास्ट्रक्चर काफी"
    },
    {
      "subtitle_id": 241,
      "start": 508.56,
      "end": 512.0,
      "text": "वीक है इंडिया का और किसी भी इकॉनमी को"
    },
    {
      "subtitle_id": 242,
      "start": 510.44,
      "end": 514.0,
      "text": "अगर तेजी से ग्रो करना है तो सबसे पहला"
    },
    {
      "subtitle_id": 243,
      "start": 512.0,
      "end": 515.76,
      "text": "फोकस उनका इंफ्रास्ट्रक्चर पर होना चाहिए"
    },
    {
      "subtitle_id": 244,
      "start": 514.0,
      "end": 517.0,
      "text": "और अभी इंडिया में वो हो रहा है और आने"
    },
    {
      "subtitle_id": 245,
      "start": 515.76,
      "end": 518.8,
      "text": "वाले टाइम में उसके रिजल्ट भी हमें"
    },
    {
      "subtitle_id": 246,
      "start": 517.0,
      "end": 520.039,
      "text": "दिखेंगे बट इस ग्रोथ स्टोरी का पार्ट होने"
    },
    {
      "subtitle_id": 247,
      "start": 518.8,
      "end": 521.719,
      "text": "के लिए बहुत सारे लोगों ने ऐसे स्टॉक्स"
    },
    {
      "subtitle_id": 248,
      "start": 520.039,
      "end": 523.68,
      "text": "में इन्वेस्ट किया जो कि अच्छा भी है बस"
    },
    {
      "subtitle_id": 249,
      "start": 521.719,
      "end": 525.48,
      "text": "यहां पर थोड़ी बहुत ये कुछ अपडेट्स थी जो"
    },
    {
      "subtitle_id": 250,
      "start": 523.68,
      "end": 527.92,
      "text": "मैं चाहता था कि सभी तक पहुंचे ताकि आप एक"
    },
    {
      "subtitle_id": 251,
      "start": 525.48,
      "end": 529.48,
      "text": "बेटर डिसीजन ले पाए तो आज बस रुकता हूं"
    },
    {
      "subtitle_id": 252,
      "start": 527.92,
      "end": 531.12,
      "text": "यहीं पर नेक्स्ट वीडियो में किस स्टॉक के"
    },
    {
      "subtitle_id": 253,
      "start": 529.48,
      "end": 532.959,
      "text": "बारे में हमें बात करनी चाहिए नीचे कमेंट"
    },
    {
      "subtitle_id": 254,
      "start": 531.12,
      "end": 534.36,
      "text": "करके जरूर बताइए और जाते-जाते हमारे मनी"
    },
    {
      "subtitle_id": 255,
      "start": 532.959,
      "end": 535.839,
      "text": "मास्टर प्रोग्राम को जरूर चेक आउट कीजिए"
    },
    {
      "subtitle_id": 256,
      "start": 534.36,
      "end": 537.72,
      "text": "यहां पर काफी प्रैक्टिकल प्रोसेस के बारे"
    },
    {
      "subtitle_id": 257,
      "start": 535.839,
      "end": 539.959,
      "text": "में हम बात करने वाले हैं जो आपको एक"
    },
    {
      "subtitle_id": 258,
      "start": 537.72,
      "end": 541.72,
      "text": "इंडिपेंडेंट इन्वेस्टर बना सकते अगर आप"
    },
    {
      "subtitle_id": 259,
      "start": 539.959,
      "end": 543.16,
      "text": "शेयर मार्केट डिटेल में सीखना चाहते हैं"
    },
    {
      "subtitle_id": 260,
      "start": 541.72,
      "end": 544.76,
      "text": "तो हमारे चैनल को जरूर सब्सक्राइब कीजिए"
    },
    {
      "subtitle_id": 261,
      "start": 543.16,
      "end": 546.36,
      "text": "और बेल आइकॉन पर भी क्लिक कीजिए और फिर"
    },
    {
      "subtitle_id": 262,
      "start": 544.76,
      "end": 547.76,
      "text": "इसी तरह की वीडियोस की नोटिफिकेशन आपको"
    },
    {
      "subtitle_id": 263,
      "start": 546.36,
      "end": 552.0,
      "text": "मिलती रहेगी मिलते हैं अगली वीडियो में"
    },
    {
      "subtitle_id": 264,
      "start": 547.76,
      "end": 552.0,
      "text": "थैंक यू सो मच फॉर वाचिंग दिस वीडियो"
    }
  ]
}