  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.04,
      "end": 4.24,
      "text": "आपने मुटी की कभी ना कभी कोई जींस खरीदी"
    },
    {
      "subtitle_id": 2,
      "start": 2.159,
      "end": 6.919,
      "text": "होगी या कोई ना कोई आउटलेट तो जरूर देखा"
    },
    {
      "subtitle_id": 3,
      "start": 4.24,
      "end": 8.96,
      "text": "होगा लेकिन इस आईपीओ को आने से पहले तक तो"
    },
    {
      "subtitle_id": 4,
      "start": 6.919,
      "end": 11.28,
      "text": "मुझे भी यह लग रहा था कि ये कंपनी बाहर की"
    },
    {
      "subtitle_id": 5,
      "start": 8.96,
      "end": 13.0,
      "text": "है लेकिन शॉकिंगली ये कंपनी इंडियन है"
    },
    {
      "subtitle_id": 6,
      "start": 11.28,
      "end": 16.119,
      "text": "क्रीडो ब्रांड्स मार्केटिंग लिमिटेड ये"
    },
    {
      "subtitle_id": 7,
      "start": 13.0,
      "end": 17.88,
      "text": "कंपनी मुफ मेसर ये ब्रांड चलाती है अब"
    },
    {
      "subtitle_id": 8,
      "start": 16.119,
      "end": 19.16,
      "text": "इसकी जो शुरुआत है वो बहुत ही इंटरेस्टिंग"
    },
    {
      "subtitle_id": 9,
      "start": 17.88,
      "end": 22.16,
      "text": "है उसके बारे में तो हम बात करेंगे ही"
    },
    {
      "subtitle_id": 10,
      "start": 19.16,
      "end": 24.48,
      "text": "करेंगे पर साथ ही अब हम देख रहे हैं कि"
    },
    {
      "subtitle_id": 11,
      "start": 22.16,
      "end": 26.32,
      "text": "लेफ्ट्स राइट्स सब जगह से आईपीओ आ रहे हैं"
    },
    {
      "subtitle_id": 12,
      "start": 24.48,
      "end": 28.279,
      "text": "तो क्या ये आईपीओ ओ वैल्यूड है या फिर"
    },
    {
      "subtitle_id": 13,
      "start": 26.32,
      "end": 30.16,
      "text": "अंडर वैल्यूड है यहां पर लिस्टिंग गन के"
    },
    {
      "subtitle_id": 14,
      "start": 28.279,
      "end": 32.04,
      "text": "क्या चांसेस हैं और कंपनी का जो पूरा"
    },
    {
      "subtitle_id": 15,
      "start": 30.16,
      "end": 33.84,
      "text": "बिजनेस मॉडल है वो कैसे वर्क करता है और"
    },
    {
      "subtitle_id": 16,
      "start": 32.04,
      "end": 35.6,
      "text": "क्या कुछ बिजनेस पोटेंशियल इस बिजनेस में"
    },
    {
      "subtitle_id": 17,
      "start": 33.84,
      "end": 38.0,
      "text": "है इन सारी चीजों के बारे में इस वीडियो"
    },
    {
      "subtitle_id": 18,
      "start": 35.6,
      "end": 39.92,
      "text": "में हम बात करेंगे नमस्कार मैं प्रसाद"
    },
    {
      "subtitle_id": 19,
      "start": 38.0,
      "end": 42.28,
      "text": "आपका आज के इस वीडियो में स्वागत करता हूं"
    },
    {
      "subtitle_id": 20,
      "start": 39.92,
      "end": 45.32,
      "text": "देखिए पिछले 2 साल में 42 पर की रेवेन्यू"
    },
    {
      "subtitle_id": 21,
      "start": 42.28,
      "end": 47.399,
      "text": "ग्रोथ और 374 की प्रॉफिट ग्रोथ देने वाली"
    },
    {
      "subtitle_id": 22,
      "start": 45.32,
      "end": 49.52,
      "text": "इस कंपनी की शुरुआत जो हुई थी वो बहुत ही"
    },
    {
      "subtitle_id": 23,
      "start": 47.399,
      "end": 51.92,
      "text": "सामान्य सी थी इस कंपनी की शुरुआत की"
    },
    {
      "subtitle_id": 24,
      "start": 49.52,
      "end": 54.079,
      "text": "मिस्टर कमल खुशलानी ने मिस्टर खुशलानी कोई"
    },
    {
      "subtitle_id": 25,
      "start": 51.92,
      "end": 55.92,
      "text": "बिजनेस फैमिली से नहीं आते थे शुरुआत में"
    },
    {
      "subtitle_id": 26,
      "start": 54.079,
      "end": 58.719,
      "text": "इन्होंने कैसेट कंपनीज में काम किया फिर"
    },
    {
      "subtitle_id": 27,
      "start": 55.92,
      "end": 60.559,
      "text": "उन्होंने 1992 में ₹1000000 उधार लेकर"
    },
    {
      "subtitle_id": 28,
      "start": 58.719,
      "end": 62.6,
      "text": "अपना एक बिजनेस शुरू किया और उस कंपनी का"
    },
    {
      "subtitle_id": 29,
      "start": 60.559,
      "end": 64.199,
      "text": "नाम था मिस्टर एंड मिस्टर शर्ट कंपनी और"
    },
    {
      "subtitle_id": 30,
      "start": 62.6,
      "end": 66.6,
      "text": "फिर इस कंपनी के जरिए उन्होंने अपनी"
    },
    {
      "subtitle_id": 31,
      "start": 64.199,
      "end": 68.799,
      "text": "फॉर्मल एंट्री की एरेल बिजनेस में जिससे"
    },
    {
      "subtitle_id": 32,
      "start": 66.6,
      "end": 70.52,
      "text": "काफी कुछ सक्सेस भी मिला लेकिन 1998 में"
    },
    {
      "subtitle_id": 33,
      "start": 68.799,
      "end": 72.52,
      "text": "उन्होंने एक ट्रेंड ऑब्जर्व किया उस दौरान"
    },
    {
      "subtitle_id": 34,
      "start": 70.52,
      "end": 74.479,
      "text": "कुछ-कुछ होता है और कई सारी ऐसी मूवीज आई"
    },
    {
      "subtitle_id": 35,
      "start": 72.52,
      "end": 76.92,
      "text": "जिन्होंने वेस्टर्न फैशन को काफी पॉपुलर"
    },
    {
      "subtitle_id": 36,
      "start": 74.479,
      "end": 78.88,
      "text": "इज किया जिसका रिजल्ट यह था कि उस टाइम से"
    },
    {
      "subtitle_id": 37,
      "start": 76.92,
      "end": 80.72,
      "text": "धीरे-धीरे वेस्टर्न फैशन की जो डिमांड थी"
    },
    {
      "subtitle_id": 38,
      "start": 78.88,
      "end": 82.759,
      "text": "वो बहुत ज्यादा बढ़ने लगी और इस डिमांड को"
    },
    {
      "subtitle_id": 39,
      "start": 80.72,
      "end": 84.759,
      "text": "मिस्टर खुशलानी ने बहुत जल्दी टैप कर लिया"
    },
    {
      "subtitle_id": 40,
      "start": 82.759,
      "end": 86.56,
      "text": "और उन्हें एक आईडिया तो थी कि यह कुछ बड़ी"
    },
    {
      "subtitle_id": 41,
      "start": 84.759,
      "end": 89.36,
      "text": "चीज बनने वाली है इसलिए उन्होंने अपना"
    },
    {
      "subtitle_id": 42,
      "start": 86.56,
      "end": 91.24,
      "text": "पूरा फोकस इसी चीज पर लगाकर 1998 में मुफी"
    },
    {
      "subtitle_id": 43,
      "start": 89.36,
      "end": 92.92,
      "text": "को लॉन्च किया किया अब देखिए शुरुआत उनकी"
    },
    {
      "subtitle_id": 44,
      "start": 91.24,
      "end": 95.04,
      "text": "काफी स्ट्रगल भरी थी खुद ही अपनी बाइक पर"
    },
    {
      "subtitle_id": 45,
      "start": 92.92,
      "end": 96.759,
      "text": "ही वेयरहाउस में फैब्रिक लेकर जाते थे"
    },
    {
      "subtitle_id": 46,
      "start": 95.04,
      "end": 99.52,
      "text": "उसके बाद जो भी फाइनल प्रोडक्ट है अपनी"
    },
    {
      "subtitle_id": 47,
      "start": 96.759,
      "end": 101.759,
      "text": "बाइक पर ही उसे लेकर बेचते थे इनका कोई"
    },
    {
      "subtitle_id": 48,
      "start": 99.52,
      "end": 104.079,
      "text": "शॉप नहीं था ना ही कोई एंप्लॉयज थे तो"
    },
    {
      "subtitle_id": 49,
      "start": 101.759,
      "end": 106.079,
      "text": "अकेले-अकेले ही सब कुछ मैनेज करते थे"
    },
    {
      "subtitle_id": 50,
      "start": 104.079,
      "end": 107.84,
      "text": "लेकिन जल्द ही इनके जो प्रोडक्ट्स हैं"
    },
    {
      "subtitle_id": 51,
      "start": 106.079,
      "end": 109.719,
      "text": "उन्हें बहुत अच्छा रिस्पांस मिलने लगा"
    },
    {
      "subtitle_id": 52,
      "start": 107.84,
      "end": 111.64,
      "text": "जिसके बाद इनका बिज़नेस बढ़ने लगा लेकिन"
    },
    {
      "subtitle_id": 53,
      "start": 109.719,
      "end": 114.04,
      "text": "इनके बिजनेस का जो सबसे इंपॉर्टेंट"
    },
    {
      "subtitle_id": 54,
      "start": 111.64,
      "end": 116.36,
      "text": "इफ्लेक्शन पॉइंट है वो तब आया जब इन्होंने"
    },
    {
      "subtitle_id": 55,
      "start": 114.04,
      "end": 118.039,
      "text": "स्ट्रेज जींस लॉन्च की देखिए स्ट्रेच जीन"
    },
    {
      "subtitle_id": 56,
      "start": 116.36,
      "end": 120.2,
      "text": "आजकल तो बहुत कॉमन है लेकिन उस टाइम बहुत"
    },
    {
      "subtitle_id": 57,
      "start": 118.039,
      "end": 122.439,
      "text": "ही लिमिटेड कंपनीज प्रोवाइड करती थी और"
    },
    {
      "subtitle_id": 58,
      "start": 120.2,
      "end": 124.52,
      "text": "उसमें से एक मुफी थी अब देखिए मुफी ने"
    },
    {
      "subtitle_id": 59,
      "start": 122.439,
      "end": 127.24,
      "text": "अपनी ब्रांड"
    },
    {
      "subtitle_id": 60,
      "start": 124.52,
      "end": 129.28,
      "text": "पोजीशंस ड्रेसिंग होती है ना उसे मुफी"
    },
    {
      "subtitle_id": 61,
      "start": 127.24,
      "end": 131.4,
      "text": "कहते हैं अगर आपके किसी आर्मी ऑफिसर से"
    },
    {
      "subtitle_id": 62,
      "start": 129.28,
      "end": 133.76,
      "text": "बातचीत होती रहती है तो आपने यह वर्ड कभी"
    },
    {
      "subtitle_id": 63,
      "start": 131.4,
      "end": 135.519,
      "text": "ना कभी तो सुना ही होगा अब देखिए मुफी का"
    },
    {
      "subtitle_id": 64,
      "start": 133.76,
      "end": 137.28,
      "text": "जो मीनिंग है यह बहुत कम लोगों को पता है"
    },
    {
      "subtitle_id": 65,
      "start": 135.519,
      "end": 139.36,
      "text": "इसलिए ज्यादातर लोगों को यही लगता था कि"
    },
    {
      "subtitle_id": 66,
      "start": 137.28,
      "end": 141.319,
      "text": "यह कोई यूएस वगैरह की कंपनी है लेकिन है"
    },
    {
      "subtitle_id": 67,
      "start": 139.36,
      "end": 143.48,
      "text": "ये पूरी तरह से इंडियन अपना जो फैब्रिक है"
    },
    {
      "subtitle_id": 68,
      "start": 141.319,
      "end": 145.28,
      "text": "यह इंडियन कंपनी से ही सोर्स करते हैं साथ"
    },
    {
      "subtitle_id": 69,
      "start": 143.48,
      "end": 147.04,
      "text": "ही मैन्युफैक्चरिंग के लिए इंडियन कंपनीज"
    },
    {
      "subtitle_id": 70,
      "start": 145.28,
      "end": 148.879,
      "text": "को ही आउटसोर्स करते हैं चीजें और"
    },
    {
      "subtitle_id": 71,
      "start": 147.04,
      "end": 150.84,
      "text": "छोटी-छोटी चीजें से बटन है और बाकी"
    },
    {
      "subtitle_id": 72,
      "start": 148.879,
      "end": 152.84,
      "text": "एक्सेसरीज हैं वो भी ये इंडिया से ही"
    },
    {
      "subtitle_id": 73,
      "start": 150.84,
      "end": 154.44,
      "text": "सोर्स करते हैं तो पूरी आप बोल सकते हैं"
    },
    {
      "subtitle_id": 74,
      "start": 152.84,
      "end": 156.72,
      "text": "कि मेड इन इंडिया इनके प्रोडक्ट्स हैं"
    },
    {
      "subtitle_id": 75,
      "start": 154.44,
      "end": 158.28,
      "text": "लेकिन पोजिशनिंग वेस्टर्न कंपनी की तरह है"
    },
    {
      "subtitle_id": 76,
      "start": 156.72,
      "end": 159.8,
      "text": "तो अपनी अच्छी प्रोडक्ट क्वालिटी और अपनी"
    },
    {
      "subtitle_id": 77,
      "start": 158.28,
      "end": 162.0,
      "text": "अच्छी ब्रांड पोजिशनिंग का इन्हें काफी"
    },
    {
      "subtitle_id": 78,
      "start": 159.8,
      "end": 164.08,
      "text": "फायदा मिला है जिसके चलते कंपनी के यहां"
    },
    {
      "subtitle_id": 79,
      "start": 162.0,
      "end": 166.08,
      "text": "600 डायरेक्ट एंप्लॉयज हैं और 2000"
    },
    {
      "subtitle_id": 80,
      "start": 164.08,
      "end": 168.08,
      "text": "इनडायरेक्ट एंप्लॉयज है अब सवाल ये आता है"
    },
    {
      "subtitle_id": 81,
      "start": 166.08,
      "end": 170.239,
      "text": "कि कंपनी अपना बिजनेस करती कैसे है जो"
    },
    {
      "subtitle_id": 82,
      "start": 168.08,
      "end": 172.68,
      "text": "कंपनी का जो मेन रेवेन्यू वो आता है ईओ से"
    },
    {
      "subtitle_id": 83,
      "start": 170.239,
      "end": 175.0,
      "text": "ईओ माने एक्सक्लूसिव ब्रांड आउटलेट यानी"
    },
    {
      "subtitle_id": 84,
      "start": 172.68,
      "end": 176.959,
      "text": "अपने मॉल में या फिर कई जगह पर मफ के"
    },
    {
      "subtitle_id": 85,
      "start": 175.0,
      "end": 179.28,
      "text": "डेडिकेटेड आउटलेट्स देखे होंगे तो देखिए"
    },
    {
      "subtitle_id": 86,
      "start": 176.959,
      "end": 182.159,
      "text": "इनके 404 एक्सक्लूसिव ब्रांड आउटलेट्स हैं"
    },
    {
      "subtitle_id": 87,
      "start": 179.28,
      "end": 183.92,
      "text": "1300 132 मल्टी ब्रांड आउटलेट्स हैं 71"
    },
    {
      "subtitle_id": 88,
      "start": 182.159,
      "end": 185.799,
      "text": "लार्ज फॉर्मेट स्टोर्स में भी ये अवेलेबल"
    },
    {
      "subtitle_id": 89,
      "start": 183.92,
      "end": 187.4,
      "text": "है साथ ही जो ऑनलाइन ई-कॉमर्स वेबसाइट्स"
    },
    {
      "subtitle_id": 90,
      "start": 185.799,
      "end": 188.84,
      "text": "हैं वहां पर भी इनके प्रोडक्ट आपको आसानी"
    },
    {
      "subtitle_id": 91,
      "start": 187.4,
      "end": 190.56,
      "text": "से मिल जाएंगे अब देखिए कंपनी के"
    },
    {
      "subtitle_id": 92,
      "start": 188.84,
      "end": 192.159,
      "text": "प्रोडक्ट्स ऑफलाइन मॉडल के जरिए भी बेचे"
    },
    {
      "subtitle_id": 93,
      "start": 190.56,
      "end": 193.959,
      "text": "जा रहे हैं ऑनलाइन मॉडल के जरिए भी बेचे"
    },
    {
      "subtitle_id": 94,
      "start": 192.159,
      "end": 196.2,
      "text": "जा रहे हैं असली बिज़नेस कहां से आ रहा है"
    },
    {
      "subtitle_id": 95,
      "start": 193.959,
      "end": 198.239,
      "text": "तो कंपनी का आप देख सकते हैं मोर दन 50 पर"
    },
    {
      "subtitle_id": 96,
      "start": 196.2,
      "end": 200.2,
      "text": "जो रेवेन्यू है वो एक्सले ब्रांड आउटलेट"
    },
    {
      "subtitle_id": 97,
      "start": 198.239,
      "end": 202.159,
      "text": "से ही आता है लेकिन इस फाइनेंशियल ईयर के"
    },
    {
      "subtitle_id": 98,
      "start": 200.2,
      "end": 204.4,
      "text": "अब शुरुआत के तीन महीनों में कंपनी का जो"
    },
    {
      "subtitle_id": 99,
      "start": 202.159,
      "end": 206.84,
      "text": "ऑनलाइन सेल्स है उसमें काफी बढ़ोतरी पाई"
    },
    {
      "subtitle_id": 100,
      "start": 204.4,
      "end": 208.56,
      "text": "गई और अब फिलहाल कंपनी का 13 रेवेन्यू"
    },
    {
      "subtitle_id": 101,
      "start": 206.84,
      "end": 210.959,
      "text": "ऑनलाइन बिजनेस से आ रहा है यानी जो"
    },
    {
      "subtitle_id": 102,
      "start": 208.56,
      "end": 212.68,
      "text": "ई-कॉमर्स वेबसाइट्स हैं वहां से आ रहा है"
    },
    {
      "subtitle_id": 103,
      "start": 210.959,
      "end": 214.36,
      "text": "अगर हम कंपनी के फाइनेंशियल्स पर नजर"
    },
    {
      "subtitle_id": 104,
      "start": 212.68,
      "end": 216.08,
      "text": "डालें तो कंपनी के फाइनेंशियल्स यहां पर"
    },
    {
      "subtitle_id": 105,
      "start": 214.36,
      "end": 218.159,
      "text": "बहुत तेजी से बढ़ रहे हैं पिछले 2 सालों"
    },
    {
      "subtitle_id": 106,
      "start": 216.08,
      "end": 220.48,
      "text": "में कंपनी का जो रेवेन्यू है वो कंपाउंडेड"
    },
    {
      "subtitle_id": 107,
      "start": 218.159,
      "end": 223.48,
      "text": "सालाना 42 से और जो प्रॉफिट है वो"
    },
    {
      "subtitle_id": 108,
      "start": 220.48,
      "end": 225.2,
      "text": "कंपाउंडेड सालाना 374 से बढ़ा है तो अब"
    },
    {
      "subtitle_id": 109,
      "start": 223.48,
      "end": 227.04,
      "text": "सवाल ये आता है कि क्या ये जो ग्रोथ चल"
    },
    {
      "subtitle_id": 110,
      "start": 225.2,
      "end": 228.56,
      "text": "रही है ये एक सस्टेनेबल ग्रोथ है या फिर"
    },
    {
      "subtitle_id": 111,
      "start": 227.04,
      "end": 231.239,
      "text": "एक टेंपररी ग्रोथ है बिकॉज़ कई सारी"
    },
    {
      "subtitle_id": 112,
      "start": 228.56,
      "end": 232.959,
      "text": "कंपनीज हमें ऐसी दिखती है जो बराबर आई"
    },
    {
      "subtitle_id": 113,
      "start": 231.239,
      "end": 234.84,
      "text": "आईपीओ के टाइम में बहुत तेजी से ग्रो करने"
    },
    {
      "subtitle_id": 114,
      "start": 232.959,
      "end": 236.76,
      "text": "लगती है तो क्या ये इसमें से एक है इसके"
    },
    {
      "subtitle_id": 115,
      "start": 234.84,
      "end": 238.68,
      "text": "लिए हमें थोड़े बिजनेस की इनसाइट्स को"
    },
    {
      "subtitle_id": 116,
      "start": 236.76,
      "end": 240.64,
      "text": "देखना पड़ेगा कंपनी की प्रॉफिट मार्जिंस"
    },
    {
      "subtitle_id": 117,
      "start": 238.68,
      "end": 242.72,
      "text": "पर भी आप ध्यान देंगे ना तो कंपीटीटर्स के"
    },
    {
      "subtitle_id": 118,
      "start": 240.64,
      "end": 244.92,
      "text": "कंपैरेटिव कंपनी के जो प्रॉफिट मार्जिंस"
    },
    {
      "subtitle_id": 119,
      "start": 242.72,
      "end": 248.72,
      "text": "है वो सबसे ज्यादा है अब ऐसा क्यों तो"
    },
    {
      "subtitle_id": 120,
      "start": 244.92,
      "end": 248.72,
      "text": "देखिए अब यह जो कंपनी है बिजनेस चलाने में"
    },
    {
      "subtitle_id": 121,
      "start": 269.72,
      "end": 273.8,
      "text": "कर दो मुफ ने भी यही किया है दूसरी"
    },
    {
      "subtitle_id": 122,
      "start": 272.24,
      "end": 275.84,
      "text": "इंपॉर्टेंट चीज यहां पर यह होती है कॉस्ट"
    },
    {
      "subtitle_id": 123,
      "start": 273.8,
      "end": 277.8,
      "text": "बचाने में वो है जस्ट इन टाइम जस्ट इन"
    },
    {
      "subtitle_id": 124,
      "start": 275.84,
      "end": 280.96,
      "text": "टाइम एक मैन्युफैक्चरिंग स्ट्रेटेजी है"
    },
    {
      "subtitle_id": 125,
      "start": 277.8,
      "end": 280.96,
      "text": "पहले क्या होता था मतलब"
    },
    {
      "subtitle_id": 126,
      "start": 299.72,
      "end": 303.28,
      "text": "कि आप जो डिमांड चल रही है उसके अनुसार"
    },
    {
      "subtitle_id": 127,
      "start": 301.759,
      "end": 304.759,
      "text": "प्रोडक्ट्स बनाते हैं इसलिए आपको"
    },
    {
      "subtitle_id": 128,
      "start": 303.28,
      "end": 306.96,
      "text": "इन्वेंटरी की ज्यादा जरूरत नहीं पड़ती और"
    },
    {
      "subtitle_id": 129,
      "start": 304.759,
      "end": 309.24,
      "text": "आपकी कॉस्ट सेविंग बहुत हो जाती है तो मफ"
    },
    {
      "subtitle_id": 130,
      "start": 306.96,
      "end": 310.96,
      "text": "स्मार्टली इन दोनों चीजों को फॉलो करती है"
    },
    {
      "subtitle_id": 131,
      "start": 309.24,
      "end": 312.919,
      "text": "जिससे उनकी जो प्रॉफिट मार्जिन है वो भी"
    },
    {
      "subtitle_id": 132,
      "start": 310.96,
      "end": 314.84,
      "text": "बेहतर है अब देखिए आप में से बहुत सारे"
    },
    {
      "subtitle_id": 133,
      "start": 312.919,
      "end": 317.199,
      "text": "लोग पूछते हैं कि जो आईपीओ वीडियो आप"
    },
    {
      "subtitle_id": 134,
      "start": 314.84,
      "end": 319.28,
      "text": "बनाते हैं उसका रिसर्च आप कैसे करते हैं"
    },
    {
      "subtitle_id": 135,
      "start": 317.199,
      "end": 321.28,
      "text": "इंफॉर्मेशन कहां से लाते हैं देखिए अगर"
    },
    {
      "subtitle_id": 136,
      "start": 319.28,
      "end": 323.52,
      "text": "आपको सही से बताऊं तो पहले मैं सारा ये"
    },
    {
      "subtitle_id": 137,
      "start": 321.28,
      "end": 325.44,
      "text": "रिसर्च वगैरह अकेला करता था अब अभी जैसे"
    },
    {
      "subtitle_id": 138,
      "start": 323.52,
      "end": 327.24,
      "text": "ऐसे हम आगे बढ़े हैं हमारी एक रिसर्च टीम"
    },
    {
      "subtitle_id": 139,
      "start": 325.44,
      "end": 329.88,
      "text": "भी है लेकिन फिर भी काफी सारी इंफॉर्मेशन"
    },
    {
      "subtitle_id": 140,
      "start": 327.24,
      "end": 332.28,
      "text": "ऐसी होती है जिससे हमें ढूंढना नहीं पड़ता"
    },
    {
      "subtitle_id": 141,
      "start": 329.88,
      "end": 334.52,
      "text": "वो हमारे पास आ जाती है अब यह कैसे होता"
    },
    {
      "subtitle_id": 142,
      "start": 332.28,
      "end": 336.8,
      "text": "है तो देखिए मेरे जो काफी सारे फ्रेंड्स"
    },
    {
      "subtitle_id": 143,
      "start": 334.52,
      "end": 338.4,
      "text": "हैं वो इन्वेस्टर हैं तो जब भी कोई आईपीओ"
    },
    {
      "subtitle_id": 144,
      "start": 336.8,
      "end": 340.6,
      "text": "आता है तो उनके काफी सारे सवाल आते हैं"
    },
    {
      "subtitle_id": 145,
      "start": 338.4,
      "end": 342.68,
      "text": "वैल्यूएशन क्या होगा फ्यूचर प्रोस्पेक्ट्स"
    },
    {
      "subtitle_id": 146,
      "start": 340.6,
      "end": 344.6,
      "text": "क्या है वगैरह वगैरह ऐसा क्यों ऐसा ही"
    },
    {
      "subtitle_id": 147,
      "start": 342.68,
      "end": 346.16,
      "text": "क्यों साथ ही हमारे जो फाइनेंस क्लब है"
    },
    {
      "subtitle_id": 148,
      "start": 344.6,
      "end": 348.08,
      "text": "उसमें काफी सारे सवाल आ जाते हैं जब भी"
    },
    {
      "subtitle_id": 149,
      "start": 346.16,
      "end": 349.8,
      "text": "कोई आईपीओ आ जाता है तो और साथ ही काफी"
    },
    {
      "subtitle_id": 150,
      "start": 348.08,
      "end": 351.759,
      "text": "सारे लोग वहां पर आईपीओ रिलेटेड ऐसी-ऐसी"
    },
    {
      "subtitle_id": 151,
      "start": 349.8,
      "end": 353.639,
      "text": "इंफॉर्मेशन शेयर करते हैं जो काफी यूनिक"
    },
    {
      "subtitle_id": 152,
      "start": 351.759,
      "end": 355.56,
      "text": "होती है तो इसलिए हमें इंफॉर्मेशन ढूंढनी"
    },
    {
      "subtitle_id": 153,
      "start": 353.639,
      "end": 357.639,
      "text": "नहीं पड़ती काफी बार वो हमारे पास आ जाती"
    },
    {
      "subtitle_id": 154,
      "start": 355.56,
      "end": 359.96,
      "text": "है अब पिछले कुछ टाइम से हमने जो फाइनेंस"
    },
    {
      "subtitle_id": 155,
      "start": 357.639,
      "end": 361.639,
      "text": "क्लब है वो सभी के लिए ओपन किया है यानी"
    },
    {
      "subtitle_id": 156,
      "start": 359.96,
      "end": 363.84,
      "text": "आप भी उस फाइनेंस क्लब में जॉइन कर सकते"
    },
    {
      "subtitle_id": 157,
      "start": 361.639,
      "end": 365.52,
      "text": "हैं और जो इंफॉर्मेशन आ रही है और एक"
    },
    {
      "subtitle_id": 158,
      "start": 363.84,
      "end": 367.4,
      "text": "स्मार्ट फाइनेंस इन्वेस्टर्स की कम्युनिटी"
    },
    {
      "subtitle_id": 159,
      "start": 365.52,
      "end": 369.4,
      "text": "का फायदा ले सकते हैं जहां पर आईपीओ"
    },
    {
      "subtitle_id": 160,
      "start": 367.4,
      "end": 371.52,
      "text": "रिलेटेड सवाल इंफॉर्मेशन तो आपको मिलेगी"
    },
    {
      "subtitle_id": 161,
      "start": 369.4,
      "end": 373.759,
      "text": "ही मिलेगी साथ ही आप अपने सवाल भी यहां पर"
    },
    {
      "subtitle_id": 162,
      "start": 371.52,
      "end": 375.479,
      "text": "पूछ सकते हैं वीकली क्यू सेशन में और"
    },
    {
      "subtitle_id": 163,
      "start": 373.759,
      "end": 377.319,
      "text": "क्विज वगैरह काफी सारी इंटरेस्टिंग चीजें"
    },
    {
      "subtitle_id": 164,
      "start": 375.479,
      "end": 378.96,
      "text": "यहां पर चलती रहती है तो इसका फायदा यह"
    },
    {
      "subtitle_id": 165,
      "start": 377.319,
      "end": 381.08,
      "text": "होगा कि आपको हर बार इंफॉर्मेशन तक नहीं"
    },
    {
      "subtitle_id": 166,
      "start": 378.96,
      "end": 383.039,
      "text": "जाना पड़ेगा इंफॉर्मेशन आप तक आती रहेगी"
    },
    {
      "subtitle_id": 167,
      "start": 381.08,
      "end": 384.88,
      "text": "इस क्लब को जॉइन करने के लिए कुछ खास लंबी"
    },
    {
      "subtitle_id": 168,
      "start": 383.039,
      "end": 386.72,
      "text": "प्रोसेस नहीं है सिंपली आपको एक फ्री"
    },
    {
      "subtitle_id": 169,
      "start": 384.88,
      "end": 388.16,
      "text": "डीमेट अकाउंट ओपन करना है और इस फाइनेंस"
    },
    {
      "subtitle_id": 170,
      "start": 386.72,
      "end": 389.639,
      "text": "क्लब को जवाइन करने की लिंक आपको नीचे"
    },
    {
      "subtitle_id": 171,
      "start": 388.16,
      "end": 391.68,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में मिल"
    },
    {
      "subtitle_id": 172,
      "start": 389.639,
      "end": 393.68,
      "text": "जाएगी अब सवाल यह आता है कि कंपनी की जो"
    },
    {
      "subtitle_id": 173,
      "start": 391.68,
      "end": 395.639,
      "text": "सडन ग्रोथ हुई है रेवेन्यू और प्रॉफिट में"
    },
    {
      "subtitle_id": 174,
      "start": 393.68,
      "end": 397.52,
      "text": "वो किस वजह से हुई है तो यहां पर हमने कुछ"
    },
    {
      "subtitle_id": 175,
      "start": 395.639,
      "end": 399.28,
      "text": "डाटा निकाला जिसमें हमने देखा कि कि कंपनी"
    },
    {
      "subtitle_id": 176,
      "start": 397.52,
      "end": 401.639,
      "text": "के जो एक्सक्लूसिव ब्रांड आउटलेट है उनका"
    },
    {
      "subtitle_id": 177,
      "start": 399.28,
      "end": 403.199,
      "text": "जो रेवेन्यू है आप देखेंगे वो लगातार बढ़"
    },
    {
      "subtitle_id": 178,
      "start": 401.639,
      "end": 405.199,
      "text": "रहा है और बहुत तेजी से बढ़ रहा है एक"
    },
    {
      "subtitle_id": 179,
      "start": 403.199,
      "end": 408.199,
      "text": "आउटलेट से इन्हें पहले करीब 40 लाख का सेल"
    },
    {
      "subtitle_id": 180,
      "start": 405.199,
      "end": 410.12,
      "text": "आता था फिर ये 50 लाख हो गया और अभी 75"
    },
    {
      "subtitle_id": 181,
      "start": 408.199,
      "end": 412.0,
      "text": "लाख पर आ गया है यानी ये चीज बहुत फास्ट"
    },
    {
      "subtitle_id": 182,
      "start": 410.12,
      "end": 414.56,
      "text": "ग्रो कर रही है लेकिन इंटरेस्टिंग चीज यह"
    },
    {
      "subtitle_id": 183,
      "start": 412.0,
      "end": 416.36,
      "text": "है कि यहां पर जो एवरेज बिल है उसकी साइज"
    },
    {
      "subtitle_id": 184,
      "start": 414.56,
      "end": 421.0,
      "text": "भी बढ़ रही है एवरेज बिल की साइज"
    },
    {
      "subtitle_id": 185,
      "start": 416.36,
      "end": 423.039,
      "text": "फाइनेंशियल र 2021 में लगभग ₹ थी वो अब ₹"
    },
    {
      "subtitle_id": 186,
      "start": 421.0,
      "end": 424.479,
      "text": "के भी ऊपर चली गई है अब यह क्यों हुआ"
    },
    {
      "subtitle_id": 187,
      "start": 423.039,
      "end": 426.16,
      "text": "क्योंकि कंपनी की जो प्रोडक्ट है उसकी"
    },
    {
      "subtitle_id": 188,
      "start": 424.479,
      "end": 427.759,
      "text": "प्राइसिंग भी धीरे-धीरे बढ़ती चली गई"
    },
    {
      "subtitle_id": 189,
      "start": 426.16,
      "end": 429.759,
      "text": "लेकिन इस बढ़ती हुई प्राइस की वजह से"
    },
    {
      "subtitle_id": 190,
      "start": 427.759,
      "end": 431.84,
      "text": "कस्टमर के बिहेवियर पर कोई फर्क नहीं पड़ा"
    },
    {
      "subtitle_id": 191,
      "start": 429.759,
      "end": 433.24,
      "text": "कस्टमर अभी भी इंटरेस्टेड है इसलिए कंपनी"
    },
    {
      "subtitle_id": 192,
      "start": 431.84,
      "end": 435.039,
      "text": "की जो स्ट्रेटेजी है धीरे-धीरे प्राइस"
    },
    {
      "subtitle_id": 193,
      "start": 433.24,
      "end": 438.039,
      "text": "बढ़ाने की वो वर्कआउट कर रही है और इसी"
    },
    {
      "subtitle_id": 194,
      "start": 435.039,
      "end": 440.319,
      "text": "वजह से कंपनी की जो बिलिंग है ऑन एन एवरेज"
    },
    {
      "subtitle_id": 195,
      "start": 438.039,
      "end": 442.319,
      "text": "पर यूजर के बेसिस पर वो बढ़ रही है जिसका"
    },
    {
      "subtitle_id": 196,
      "start": 440.319,
      "end": 443.84,
      "text": "फायदा कंपनी को रिवेन्यू में मिल रहा है"
    },
    {
      "subtitle_id": 197,
      "start": 442.319,
      "end": 446.84,
      "text": "तो यानी"
    },
    {
      "subtitle_id": 198,
      "start": 443.84,
      "end": 446.84,
      "text": "एजिस्टिफाई"
    },
    {
      "subtitle_id": 199,
      "start": 446.919,
      "end": 451.52,
      "text": "है और धीरे-धीरे और भी आउटलेट्स ऐड करने"
    },
    {
      "subtitle_id": 200,
      "start": 449.8,
      "end": 453.919,
      "text": "की कोशिश कर रही है अब यहां पर क्या सारी"
    },
    {
      "subtitle_id": 201,
      "start": 451.52,
      "end": 455.44,
      "text": "चीजें पॉजिटिव ही पॉजिटिव है देखिए फिश"
    },
    {
      "subtitle_id": 202,
      "start": 453.919,
      "end": 457.56,
      "text": "वीडियो बना रही है तो दोनों साइड आपको"
    },
    {
      "subtitle_id": 203,
      "start": 455.44,
      "end": 458.919,
      "text": "मिलेंगे ही मिलेंगे देखने अगर हम नेगेटिव"
    },
    {
      "subtitle_id": 204,
      "start": 457.56,
      "end": 460.879,
      "text": "साइड की बात करें तो कंपनी के जो"
    },
    {
      "subtitle_id": 205,
      "start": 458.919,
      "end": 464.4,
      "text": "प्रमोटर्स हैं उनका जो शेयर है अभी फिलहाल"
    },
    {
      "subtitle_id": 206,
      "start": 460.879,
      "end": 466.4,
      "text": "कंपनी में वोह 66.66 है लेकिन इस आईपीओ"
    },
    {
      "subtitle_id": 207,
      "start": 464.4,
      "end": 468.159,
      "text": "में वह अपना अच्छा खासा स्टेक बेच रहे हैं"
    },
    {
      "subtitle_id": 208,
      "start": 466.4,
      "end": 470.639,
      "text": "और इस आईपीओ के बाद जो प्रमोटर्स की शेयर"
    },
    {
      "subtitle_id": 209,
      "start": 468.159,
      "end": 472.639,
      "text": "होल्डिंग है वो आएगी 53.6 पर यानी"
    },
    {
      "subtitle_id": 210,
      "start": 470.639,
      "end": 475.039,
      "text": "प्रमोटर्स 13 पर से अपना स्टेक बेच रहे"
    },
    {
      "subtitle_id": 211,
      "start": 472.639,
      "end": 478.199,
      "text": "हैं इंटरेस्टिंग चीज यह है कि यह कंप्लीट"
    },
    {
      "subtitle_id": 212,
      "start": 475.039,
      "end": 480.039,
      "text": "ऑफर फॉर सेल है यानी जो भी पैसा आप इस"
    },
    {
      "subtitle_id": 213,
      "start": 478.199,
      "end": 481.639,
      "text": "कंपनी में अभी इन्वेस्ट करें आईपीओ में वो"
    },
    {
      "subtitle_id": 214,
      "start": 480.039,
      "end": 483.599,
      "text": "सारा का सारा कंपनी के प्रमोटर्स के जेब"
    },
    {
      "subtitle_id": 215,
      "start": 481.639,
      "end": 485.08,
      "text": "में जाएगा तो कंपनी को इसमें से कोई भी एक"
    },
    {
      "subtitle_id": 216,
      "start": 483.599,
      "end": 486.639,
      "text": "रुपया भी नहीं मिलेगा अपना बिजनेस ग्रो"
    },
    {
      "subtitle_id": 217,
      "start": 485.08,
      "end": 488.199,
      "text": "करने के लिए या फिर बाकी चीजों के लिए अब"
    },
    {
      "subtitle_id": 218,
      "start": 486.639,
      "end": 489.759,
      "text": "यहां पर हमने ये पता करने की बहुत कोशिश"
    },
    {
      "subtitle_id": 219,
      "start": 488.199,
      "end": 491.56,
      "text": "की कि एगजैक्टली क्यों कंपनी के प्रमोटर्स"
    },
    {
      "subtitle_id": 220,
      "start": 489.759,
      "end": 493.68,
      "text": "अपना स्टेक बेचना चाहते हैं लेकिन कोई खास"
    },
    {
      "subtitle_id": 221,
      "start": 491.56,
      "end": 495.599,
      "text": "रीजन हमें मिला नहीं है अ लेकिन मेरे"
    },
    {
      "subtitle_id": 222,
      "start": 493.68,
      "end": 497.24,
      "text": "हिसाब से एक बहुत बड़ा नेगेटिव पॉइंट है"
    },
    {
      "subtitle_id": 223,
      "start": 495.599,
      "end": 499.52,
      "text": "जब अ कोई प्रमोटर अपनी कंपनी से इतना"
    },
    {
      "subtitle_id": 224,
      "start": 497.24,
      "end": 501.72,
      "text": "अच्छा खासा स्टेक बेचता है तो ऑफकोर्स वो"
    },
    {
      "subtitle_id": 225,
      "start": 499.52,
      "end": 503.52,
      "text": "एक रेड फ्लैग होता है जबकि वो बिजनेस इतनी"
    },
    {
      "subtitle_id": 226,
      "start": 501.72,
      "end": 505.0,
      "text": "तेजी से आगे बढ़ रहा है तो इतनी फास्ट"
    },
    {
      "subtitle_id": 227,
      "start": 503.52,
      "end": 507.28,
      "text": "ग्रोइंग कंपनी में प्रमोटर्स को अच्छा"
    },
    {
      "subtitle_id": 228,
      "start": 505.0,
      "end": 509.4,
      "text": "खासा स्टेक बेचना ये मतलब बहुत ही रेयर"
    },
    {
      "subtitle_id": 229,
      "start": 507.28,
      "end": 511.72,
      "text": "चीज है कंपनी के कंपीटीटर्स देखते हैं आद"
    },
    {
      "subtitle_id": 230,
      "start": 509.4,
      "end": 514.039,
      "text": "बरला फैशन एंड रिटेल गो फैशन है अरविंद है"
    },
    {
      "subtitle_id": 231,
      "start": 511.72,
      "end": 515.68,
      "text": "या फिर केवल किरण क्लॉथिंग है तो इन सब"
    },
    {
      "subtitle_id": 232,
      "start": 514.039,
      "end": 518.159,
      "text": "में आप देखेंगे कि जो रेवेन्यू और प्रॉफिट"
    },
    {
      "subtitle_id": 233,
      "start": 515.68,
      "end": 521.839,
      "text": "ग्रोथ है वो मुफी से कम ही है और फिर भी"
    },
    {
      "subtitle_id": 234,
      "start": 518.159,
      "end": 524.519,
      "text": "प्रमोटर अच्छा खासा स्टेक बेच रहे हैं सो"
    },
    {
      "subtitle_id": 235,
      "start": 521.839,
      "end": 526.36,
      "text": "दैट्ची के बारे में जो कि है वैल्यूएशन कि"
    },
    {
      "subtitle_id": 236,
      "start": 524.519,
      "end": 528.16,
      "text": "क्या वैल्युएशन कंपनी का सही है तो अगर हम"
    },
    {
      "subtitle_id": 237,
      "start": 526.36,
      "end": 530.48,
      "text": "सिंपली पी रेशो को देखते हैं तो कंपनी का"
    },
    {
      "subtitle_id": 238,
      "start": 528.16,
      "end": 532.36,
      "text": "जो आईपीओ आ रहा है वो 22.9 के पी रेशो पर"
    },
    {
      "subtitle_id": 239,
      "start": 530.48,
      "end": 534.44,
      "text": "आ रहा है जबकि कंपनी के जो बाकी"
    },
    {
      "subtitle_id": 240,
      "start": 532.36,
      "end": 536.68,
      "text": "कंपीटीटर्स हैं उनके पी रेशो कुछ इस तरह"
    },
    {
      "subtitle_id": 241,
      "start": 534.44,
      "end": 538.839,
      "text": "के हैं इसमें सिर्फ अरविंद का 22 के नीचे"
    },
    {
      "subtitle_id": 242,
      "start": 536.68,
      "end": 541.12,
      "text": "है बाकी सबका ज्यादा है तो हम कह सकते हैं"
    },
    {
      "subtitle_id": 243,
      "start": 538.839,
      "end": 543.0,
      "text": "कि वैल्यूएशन इनका फेयर है रीजनेबल लग रहा"
    },
    {
      "subtitle_id": 244,
      "start": 541.12,
      "end": 545.0,
      "text": "है कोई ज्यादा वैल्यूएशन ये मांग नहीं रहे"
    },
    {
      "subtitle_id": 245,
      "start": 543.0,
      "end": 546.64,
      "text": "मतलब अभी तो बुल रन चल रहा है आईपीओ का तो"
    },
    {
      "subtitle_id": 246,
      "start": 545.0,
      "end": 548.92,
      "text": "ऑफकोर्स कई सारी कंपनी जैसे हमने लास्ट"
    },
    {
      "subtitle_id": 247,
      "start": 546.64,
      "end": 551.64,
      "text": "कंपनी की भी बात की थी जिन्होंने काफी हाई"
    },
    {
      "subtitle_id": 248,
      "start": 548.92,
      "end": 553.44,
      "text": "पी रखा था मथ माइक्रो फिन ने लेकिन यहां"
    },
    {
      "subtitle_id": 249,
      "start": 551.64,
      "end": 555.32,
      "text": "पर ऐसी चीज नहीं है रीजनेबल वैल्युएशन लग"
    },
    {
      "subtitle_id": 250,
      "start": 553.44,
      "end": 557.92,
      "text": "रहा है अगर ग्रे मार्केट प्रीमियम की बात"
    },
    {
      "subtitle_id": 251,
      "start": 555.32,
      "end": 560.04,
      "text": "करें तो आज इसका ग्रे मार्केट प्रीमियम 40"
    },
    {
      "subtitle_id": 252,
      "start": 557.92,
      "end": 562.04,
      "text": "पर के करीब चल रहा है जो कि ठीक है अच्छा"
    },
    {
      "subtitle_id": 253,
      "start": 560.04,
      "end": 563.92,
      "text": "है लेकिन देखिए लिस्टिंग इन की जब बात आती"
    },
    {
      "subtitle_id": 254,
      "start": 562.04,
      "end": 565.24,
      "text": "है तो दो चीजें इंपॉर्टेंट है ग्रे"
    },
    {
      "subtitle_id": 255,
      "start": 563.92,
      "end": 568.32,
      "text": "मार्केट प्रीमियम अच्छा होना ही होना"
    },
    {
      "subtitle_id": 256,
      "start": 565.24,
      "end": 570.12,
      "text": "चाहिए एटलीस्ट 30 पर का कंपनी पहले दो दिन"
    },
    {
      "subtitle_id": 257,
      "start": 568.32,
      "end": 573.24,
      "text": "में एटलीस्ट 8 टू नान टाइम सब्सक्राइब"
    },
    {
      "subtitle_id": 258,
      "start": 570.12,
      "end": 576.56,
      "text": "होनी चाहिए ओवरऑल अगर यह दोनों चीजें सही"
    },
    {
      "subtitle_id": 259,
      "start": 573.24,
      "end": 578.839,
      "text": "जाती है तो डटा ये कहता है कि 99 पर टाइम"
    },
    {
      "subtitle_id": 260,
      "start": 576.56,
      "end": 580.8,
      "text": "लिस्टिंग इन अच्छा मिलता है लेकिन अगर ये"
    },
    {
      "subtitle_id": 261,
      "start": 578.839,
      "end": 582.8,
      "text": "दोनों फैक्टर ऐसे नहीं होते तो फिर"
    },
    {
      "subtitle_id": 262,
      "start": 580.8,
      "end": 585.0,
      "text": "प्रॉब्लम हो जाती है तो ये दोनों चीजें आप"
    },
    {
      "subtitle_id": 263,
      "start": 582.8,
      "end": 586.56,
      "text": "ट्रैक कीजिए और उसके बाद लिस्टिंग गेन के"
    },
    {
      "subtitle_id": 264,
      "start": 585.0,
      "end": 588.519,
      "text": "लिए एंटर करना या नहीं करना है इसके इसका"
    },
    {
      "subtitle_id": 265,
      "start": 586.56,
      "end": 590.2,
      "text": "डिसीजन लीजिए अब अगर आप लॉन्ग टर्म"
    },
    {
      "subtitle_id": 266,
      "start": 588.519,
      "end": 592.24,
      "text": "इन्वेस्टर है तो आप सोचेंगे कि हमारे लिए"
    },
    {
      "subtitle_id": 267,
      "start": 590.2,
      "end": 594.64,
      "text": "यहां पर क्या है तो देखिए मुफ ना उन लोगों"
    },
    {
      "subtitle_id": 268,
      "start": 592.24,
      "end": 598.079,
      "text": "को टारगेट करते जो यंग है इंडिया के जो"
    },
    {
      "subtitle_id": 269,
      "start": 594.64,
      "end": 600.04,
      "text": "मिडियन एज है इंडियंस का वो 28 के करीब है"
    },
    {
      "subtitle_id": 270,
      "start": 598.079,
      "end": 601.92,
      "text": "अगर आप चाइना का देखें देखेंगे 38 है यूएस"
    },
    {
      "subtitle_id": 271,
      "start": 600.04,
      "end": 604.519,
      "text": "का 38 है यूरोप में कुछ कंट्रीज का"
    },
    {
      "subtitle_id": 272,
      "start": 601.92,
      "end": 607.56,
      "text": "देखेंगे वो 40 के करीब है साउथ कोरिया का"
    },
    {
      "subtitle_id": 273,
      "start": 604.519,
      "end": 609.8,
      "text": "44 है तो ऐसे में यंग पॉपुलेशन यहां पर है"
    },
    {
      "subtitle_id": 274,
      "start": 607.56,
      "end": 611.399,
      "text": "तो इन जैसे जो बिजनेस हैं एटलीस्ट अगले"
    },
    {
      "subtitle_id": 275,
      "start": 609.8,
      "end": 613.24,
      "text": "कुछ सालों में इनके लिए काफी अच्छा"
    },
    {
      "subtitle_id": 276,
      "start": 611.399,
      "end": 614.72,
      "text": "पोटेंशियल है और दूसरी इंटरेस्टिंग चीज"
    },
    {
      "subtitle_id": 277,
      "start": 613.24,
      "end": 617.72,
      "text": "मैं यहां पर यह बताना चाहूंगा कि जो पर"
    },
    {
      "subtitle_id": 278,
      "start": 614.72,
      "end": 621.079,
      "text": "कैपिटा फाइनल कंजमपट्टी चर है यानी एक"
    },
    {
      "subtitle_id": 279,
      "start": 617.72,
      "end": 623.0,
      "text": "व्यक्ति कितना सालाना अपनी ऑल सारी जो"
    },
    {
      "subtitle_id": 280,
      "start": 621.079,
      "end": 625.12,
      "text": "अपनी नीड्स है उस पर कितना खर्च कर रहा है"
    },
    {
      "subtitle_id": 281,
      "start": 623.0,
      "end": 629.959,
      "text": "सालाना तो उसका नंबर लगातार बढ़ रहा है"
    },
    {
      "subtitle_id": 282,
      "start": 625.12,
      "end": 632.6,
      "text": "2015 में ये $75 था अभी $87 पर चला गया है"
    },
    {
      "subtitle_id": 283,
      "start": 629.959,
      "end": 634.68,
      "text": "अब यह क्यों हो रहा है क्योंकि इंडिया में"
    },
    {
      "subtitle_id": 284,
      "start": 632.6,
      "end": 636.2,
      "text": "जो लोअर मिडिल क्लास से अपर मिडिल क्लास"
    },
    {
      "subtitle_id": 285,
      "start": 634.68,
      "end": 639.04,
      "text": "में लोग बहुत फास्ट ट्रांसफॉर्म हो रहे"
    },
    {
      "subtitle_id": 286,
      "start": 636.2,
      "end": 641.32,
      "text": "हैं अब यंग जनरेशन है वर्किंग जनरेशन है"
    },
    {
      "subtitle_id": 287,
      "start": 639.04,
      "end": 642.88,
      "text": "हमारी 80 पर पॉपुलेशन 50 से कम है तो"
    },
    {
      "subtitle_id": 288,
      "start": 641.32,
      "end": 644.44,
      "text": "ऑलमोस्ट सारा का सारा वर्किंग पॉपुलेशन"
    },
    {
      "subtitle_id": 289,
      "start": 642.88,
      "end": 646.24,
      "text": "हमारे पास है इससे फायदा य हो रहा है कि"
    },
    {
      "subtitle_id": 290,
      "start": 644.44,
      "end": 648.079,
      "text": "लोगों की इनकम भी बढ़ रही है और इसी वजह"
    },
    {
      "subtitle_id": 291,
      "start": 646.24,
      "end": 650.12,
      "text": "से जो एक्सपेंडिचर है वोह भी बढ़ता जा रहा"
    },
    {
      "subtitle_id": 292,
      "start": 648.079,
      "end": 652.079,
      "text": "है और इसका फायदा अप्रल कंपनीज को होता है"
    },
    {
      "subtitle_id": 293,
      "start": 650.12,
      "end": 653.639,
      "text": "अगर आप अप्रल कंपनीज की ग्रोथ की बात करें"
    },
    {
      "subtitle_id": 294,
      "start": 652.079,
      "end": 655.2,
      "text": "तो यह पूरी इंडस्ट्री बहुत तेजी से ग्रो"
    },
    {
      "subtitle_id": 295,
      "start": 653.639,
      "end": 657.32,
      "text": "कर रही है तो यह था क्रेडो ब्रांड्स"
    },
    {
      "subtitle_id": 296,
      "start": 655.2,
      "end": 659.8,
      "text": "मार्केटिंग का कंप्लीट आईपीओ एनालिसिस जो"
    },
    {
      "subtitle_id": 297,
      "start": 657.32,
      "end": 661.56,
      "text": "मफी मेंसर बनाती है तो आप क्या कर रहे हैं"
    },
    {
      "subtitle_id": 298,
      "start": 659.8,
      "end": 663.72,
      "text": "अप्लाई कर रहे हैं नहीं कर रहे रीजन क्या"
    },
    {
      "subtitle_id": 299,
      "start": 661.56,
      "end": 665.44,
      "text": "है नीचे कमेंट करके जरूर बताइए अगला कौन"
    },
    {
      "subtitle_id": 300,
      "start": 663.72,
      "end": 667.519,
      "text": "सा आईपीओ हमें एनालिस करना चाहिए नीचे"
    },
    {
      "subtitle_id": 301,
      "start": 665.44,
      "end": 669.6,
      "text": "कमेंट करके जरूर बताइए हम उसे भी कवर करने"
    },
    {
      "subtitle_id": 302,
      "start": 667.519,
      "end": 671.639,
      "text": "की कोशिश करेंगे अभी रिसेंटली आईआरडीए का"
    },
    {
      "subtitle_id": 303,
      "start": 669.6,
      "end": 674.04,
      "text": "आईपीओ आया था उसके बाद शेयर प्राइस बहुत"
    },
    {
      "subtitle_id": 304,
      "start": 671.639,
      "end": 675.88,
      "text": "क्रेजी बढ़ रही है तो ऐसा क्यों हो रहा है"
    },
    {
      "subtitle_id": 305,
      "start": 674.04,
      "end": 677.72,
      "text": "आईआरडीए में उस पर एक डिटेल वीडियो हम"
    },
    {
      "subtitle_id": 306,
      "start": 675.88,
      "end": 679.76,
      "text": "जल्दी लेकर आ रहे हैं अगले दो-तीन दिनों"
    },
    {
      "subtitle_id": 307,
      "start": 677.72,
      "end": 681.12,
      "text": "में ही तो उसे भी जरूर देखिएगा और इसी तरह"
    },
    {
      "subtitle_id": 308,
      "start": 679.76,
      "end": 682.72,
      "text": "की वीडियोस के लिए हमें जरूर सब्सक्राइब"
    },
    {
      "subtitle_id": 309,
      "start": 681.12,
      "end": 684.519,
      "text": "कीजिए और बेल आइकॉन पर भी क्लिक कीजिए और"
    },
    {
      "subtitle_id": 310,
      "start": 682.72,
      "end": 686.079,
      "text": "जाते जाते फाइनेंस लब को भी जरूर चेक आउट"
    },
    {
      "subtitle_id": 311,
      "start": 684.519,
      "end": 687.8,
      "text": "कीजिए लिंक नीचे डिस्क्रिप्शन और कमेंट"
    },
    {
      "subtitle_id": 312,
      "start": 686.079,
      "end": 690.959,
      "text": "बॉक्स में दी गई है मिलते हैं अगले वीडियो"
    },
    {
      "subtitle_id": 313,
      "start": 687.8,
      "end": 690.959,
      "text": "में थैंक यू सो मच फॉर वा"
    }
  ]
}