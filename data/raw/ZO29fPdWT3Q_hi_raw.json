  "parsing_issues": [],
  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.0,
      "end": 4.64,
      "text": "अदानी ग्रुप के बाद हिंडन बर्ग रिसर्च ने"
    },
    {
      "subtitle_id": 2,
      "start": 2.32,
      "end": 6.56,
      "text": "सेबी के चेयर पर्सन माधवी पुरी बूझ पर कई"
    },
    {
      "subtitle_id": 3,
      "start": 4.64,
      "end": 8.96,
      "text": "सारे सीरियस एलिगेशंस लगाए हैं एलिगेशंस"
    },
    {
      "subtitle_id": 4,
      "start": 6.56,
      "end": 10.96,
      "text": "बहुत ज्यादा सीरियस है इसलिए हर जगह"
    },
    {
      "subtitle_id": 5,
      "start": 8.96,
      "end": 12.639,
      "text": "अफरातफरी मची है तो इन एलिगेशंस को मैं"
    },
    {
      "subtitle_id": 6,
      "start": 10.96,
      "end": 14.12,
      "text": "तीन पार्ट में डिवाइड करके आपको बता दूंगा"
    },
    {
      "subtitle_id": 7,
      "start": 12.639,
      "end": 15.719,
      "text": "बहुत ही आसान भाषा में जिससे आपको पता"
    },
    {
      "subtitle_id": 8,
      "start": 14.12,
      "end": 17.48,
      "text": "चलेगा कि आखिर यह पूरा मामला क्या है तो"
    },
    {
      "subtitle_id": 9,
      "start": 15.719,
      "end": 19.6,
      "text": "चलिए बिना किसी देरी के शुरू करते हैं"
    },
    {
      "subtitle_id": 10,
      "start": 17.48,
      "end": 21.56,
      "text": "नमस्कार मैं प्रसाद आपका आज के इस वीडियो"
    },
    {
      "subtitle_id": 11,
      "start": 19.6,
      "end": 23.56,
      "text": "में स्वागत करता हूं तो सबसे पहला एलिगेशन"
    },
    {
      "subtitle_id": 12,
      "start": 21.56,
      "end": 26.119,
      "text": "हिंडन बर्ग रिसर्च ने कहा कि एक फंड है"
    },
    {
      "subtitle_id": 13,
      "start": 23.56,
      "end": 27.92,
      "text": "जिसका नाम है जीडी ओएफ ग्लोबल डायनामिक"
    },
    {
      "subtitle_id": 14,
      "start": 26.119,
      "end": 29.84,
      "text": "अपॉर्चुनिटी फंड हिंडन बर्ग रिसर्च के"
    },
    {
      "subtitle_id": 15,
      "start": 27.92,
      "end": 32.16,
      "text": "अनुसार यह एक ऐसा फंड है जिसे गौतम अदानी"
    },
    {
      "subtitle_id": 16,
      "start": 29.84,
      "end": 34.399,
      "text": "के भाई विनोद अदानी ऑपरेट करते हैं और इस"
    },
    {
      "subtitle_id": 17,
      "start": 32.16,
      "end": 36.239,
      "text": "फंड की मदद से वो शेयर प्राइसेस मैनिपुलेट"
    },
    {
      "subtitle_id": 18,
      "start": 34.399,
      "end": 37.92,
      "text": "करते हैं अदानी ग्रुप की कंपनीज की अब ये"
    },
    {
      "subtitle_id": 19,
      "start": 36.239,
      "end": 39.64,
      "text": "कितना सच है कितना नहीं इसके लिए उन्होंने"
    },
    {
      "subtitle_id": 20,
      "start": 37.92,
      "end": 41.32,
      "text": "फाइनेंशियल टाइम्स को भी कोट किया है और"
    },
    {
      "subtitle_id": 21,
      "start": 39.64,
      "end": 42.92,
      "text": "यह बताया कि फाइनेंशियल टाइम्स ने भी अपनी"
    },
    {
      "subtitle_id": 22,
      "start": 41.32,
      "end": 45.079,
      "text": "इन्वेस्टिगेशन में यह बताया कि विनोद"
    },
    {
      "subtitle_id": 23,
      "start": 42.92,
      "end": 47.6,
      "text": "अदानी बाहर बैठ के कुछ फंड्स के जरिए जो"
    },
    {
      "subtitle_id": 24,
      "start": 45.079,
      "end": 49.32,
      "text": "मोरिशियस बेस्ड है बर्मुडा बेस्ड है उनके"
    },
    {
      "subtitle_id": 25,
      "start": 47.6,
      "end": 51.68,
      "text": "जरिए अदानी ग्रुप के स्टॉक्स में"
    },
    {
      "subtitle_id": 26,
      "start": 49.32,
      "end": 54.199,
      "text": "बड़े-बड़े ट्रेड्स करते हैं अब उसमें से"
    },
    {
      "subtitle_id": 27,
      "start": 51.68,
      "end": 57.0,
      "text": "एक फंड है जीडीओ एफ ऐसा नमक रिसर्च का"
    },
    {
      "subtitle_id": 28,
      "start": 54.199,
      "end": 58.879,
      "text": "कहना है और ये जो जीडीएफ है ये अपना काफी"
    },
    {
      "subtitle_id": 29,
      "start": 57.0,
      "end": 61.6,
      "text": "सारा पैसा एक और फंड में डालता है जिसका"
    },
    {
      "subtitle_id": 30,
      "start": 58.879,
      "end": 63.84,
      "text": "नाम है आईपी प्लस फंड वन अगेन यह आईपी"
    },
    {
      "subtitle_id": 31,
      "start": 61.6,
      "end": 65.88,
      "text": "प्लस फंड वन भी अदानी स्टॉक्स में ट्रेड"
    },
    {
      "subtitle_id": 32,
      "start": 63.84,
      "end": 68.08,
      "text": "करता है बहुत बड़ी मात्रा में अब यहां पर"
    },
    {
      "subtitle_id": 33,
      "start": 65.88,
      "end": 69.96,
      "text": "सबसे सीरियस एलिगेशन यह है हिंडन बग"
    },
    {
      "subtitle_id": 34,
      "start": 68.08,
      "end": 72.68,
      "text": "रिसर्च का कि माधवी पुरी बुज और उनके"
    },
    {
      "subtitle_id": 35,
      "start": 69.96,
      "end": 74.84,
      "text": "हस्बैंड धवल बुज दोनों ने इन दोनों फंड्स"
    },
    {
      "subtitle_id": 36,
      "start": 72.68,
      "end": 76.36,
      "text": "में इन्वेस्टमेंट किए है और वो सिर्फ यहां"
    },
    {
      "subtitle_id": 37,
      "start": 74.84,
      "end": 77.88,
      "text": "पर नहीं रुके इन्होंने उसके बाद ये कुछ"
    },
    {
      "subtitle_id": 38,
      "start": 76.36,
      "end": 80.04,
      "text": "स्क्रीनशॉट्स डाले हैं जो आप स्क्रीन पर"
    },
    {
      "subtitle_id": 39,
      "start": 77.88,
      "end": 82.36,
      "text": "देख सकते हो जहां पर धवल बूज के पास कितने"
    },
    {
      "subtitle_id": 40,
      "start": 80.04,
      "end": 84.439,
      "text": "नंबर ऑफ शेयर्स हैं उनकी नेट एसेट वैल्यू"
    },
    {
      "subtitle_id": 41,
      "start": 82.36,
      "end": 86.24,
      "text": "कितनी है और उसकी परफॉर्मेंस क्या है इसके"
    },
    {
      "subtitle_id": 42,
      "start": 84.439,
      "end": 88.0,
      "text": "डिटेल्स आप देख सकते हो अब सवाल आता है कि"
    },
    {
      "subtitle_id": 43,
      "start": 86.24,
      "end": 90.24,
      "text": "ये डिटेल्स हिडन बर्क रिसर्च के पास आई"
    },
    {
      "subtitle_id": 44,
      "start": 88.0,
      "end": 92.52,
      "text": "कहां से तो उनका कहना है कि ये डिटेल एक"
    },
    {
      "subtitle_id": 45,
      "start": 90.24,
      "end": 94.479,
      "text": "विसल ब्लोर ने उनके साथ शेयर की है अब"
    },
    {
      "subtitle_id": 46,
      "start": 92.52,
      "end": 97.079,
      "text": "उसको कोई वेरिफिकेशन अब तक हुआ नहीं है कि"
    },
    {
      "subtitle_id": 47,
      "start": 94.479,
      "end": 98.759,
      "text": "वो सही है या फिर नहीं है या फिर एडिटेड"
    },
    {
      "subtitle_id": 48,
      "start": 97.079,
      "end": 100.479,
      "text": "है व्हाट एवर इट इज इसके साथ-साथ माधवी"
    },
    {
      "subtitle_id": 49,
      "start": 98.759,
      "end": 102.119,
      "text": "पूरी बूज का जो प्राइवेट जीमल अकाउंट है"
    },
    {
      "subtitle_id": 50,
      "start": 100.479,
      "end": 103.72,
      "text": "उसके जरिए इस फंड के जो यूनिट्स उन्होंने"
    },
    {
      "subtitle_id": 51,
      "start": 102.119,
      "end": 105.52,
      "text": "रिडीम किए उसके भी स्क्रीनशॉट्स यहां पर"
    },
    {
      "subtitle_id": 52,
      "start": 103.72,
      "end": 108.2,
      "text": "डाले गए हैं तो अपने इस एलिगेशन की मदद से"
    },
    {
      "subtitle_id": 53,
      "start": 105.52,
      "end": 110.28,
      "text": "हिंडन बर्क रिसर्च यह कहना चाहता है कि जो"
    },
    {
      "subtitle_id": 54,
      "start": 108.2,
      "end": 112.56,
      "text": "ऑफशोर फंड्स है अदानी के उनका प्रॉपर"
    },
    {
      "subtitle_id": 55,
      "start": 110.28,
      "end": 113.88,
      "text": "इन्वेस्टिगेशन नहीं किया गया था और यह चीज"
    },
    {
      "subtitle_id": 56,
      "start": 112.56,
      "end": 115.799,
      "text": "उन्होंने यहां पर सुप्रीम कोर्ट को भी"
    },
    {
      "subtitle_id": 57,
      "start": 113.88,
      "end": 117.84,
      "text": "कोर्ट अनकोट करके बताया है कि सुप्रीम"
    },
    {
      "subtitle_id": 58,
      "start": 115.799,
      "end": 120.039,
      "text": "कोर्ट ने भी बताया है कि सेबी वाज ब्लैंक"
    },
    {
      "subtitle_id": 59,
      "start": 117.84,
      "end": 122.64,
      "text": "सेबी और भी डिटेल में रिसर्च कर सकती थी"
    },
    {
      "subtitle_id": 60,
      "start": 120.039,
      "end": 124.64,
      "text": "अदानी का ऑफशोर फंड्स का जो नहीं किया गया"
    },
    {
      "subtitle_id": 61,
      "start": 122.64,
      "end": 126.32,
      "text": "तो हिंडन मक रिसर्च का ये आरोप है कि ये"
    },
    {
      "subtitle_id": 62,
      "start": 124.64,
      "end": 128.479,
      "text": "इसलिए नहीं किया गया क्योंकि सेबी चेयर"
    },
    {
      "subtitle_id": 63,
      "start": 126.32,
      "end": 130.239,
      "text": "पर्सन जो है उनकी खुद की इन्वेस्टमेंट उन"
    },
    {
      "subtitle_id": 64,
      "start": 128.479,
      "end": 132.04,
      "text": "फंड्स में थी अब अगेन यहां पर क्या सच"
    },
    {
      "subtitle_id": 65,
      "start": 130.239,
      "end": 133.879,
      "text": "क्या झूठ ये तो टाइम ही बताएगा अब इसी बीच"
    },
    {
      "subtitle_id": 66,
      "start": 132.04,
      "end": 136.04,
      "text": "एक और इंटरेस्टिंग चीज रिवील हुई है जो कि"
    },
    {
      "subtitle_id": 67,
      "start": 133.879,
      "end": 138.2,
      "text": "और भी ज्यादा शॉकिंग है कि ये जो फंड्स है"
    },
    {
      "subtitle_id": 68,
      "start": 136.04,
      "end": 140.64,
      "text": "ये आईएफएल वेल मैनेजमेंट के फंड्स हैं"
    },
    {
      "subtitle_id": 69,
      "start": 138.2,
      "end": 142.64,
      "text": "जिसका नाम बदलकर अभी 361 रखा गया है और जो"
    },
    {
      "subtitle_id": 70,
      "start": 140.64,
      "end": 144.76,
      "text": "कि पब्लिकली लिस्टेड कंपनी है अब यहां पर"
    },
    {
      "subtitle_id": 71,
      "start": 142.64,
      "end": 148.0,
      "text": "आईएफएल की बात आई है तो हिंडन बर्ग रिसर्च"
    },
    {
      "subtitle_id": 72,
      "start": 144.76,
      "end": 150.72,
      "text": "ने इस पर भी आरोप लगाए कि जो ये 361 है इन"
    },
    {
      "subtitle_id": 73,
      "start": 148.0,
      "end": 152.8,
      "text": "पर वायर कार्ड जो कि जर्मन कंपनी थी वहां"
    },
    {
      "subtitle_id": 74,
      "start": 150.72,
      "end": 155.239,
      "text": "पर एक बहुत बड़ा फ्रॉड हुआ था तो उस टाइम"
    },
    {
      "subtitle_id": 75,
      "start": 152.8,
      "end": 157.2,
      "text": "भी आईएफएल वेल्ड मैनेजमेंट यानी 361 पर"
    },
    {
      "subtitle_id": 76,
      "start": 155.239,
      "end": 159.44,
      "text": "आरोप हुए थे कि उन्होंने उस टाइम भी फ्रॉड"
    },
    {
      "subtitle_id": 77,
      "start": 157.2,
      "end": 161.879,
      "text": "किया था तो यहां पर सिर्फ माधवी पूरी बूझ"
    },
    {
      "subtitle_id": 78,
      "start": 159.44,
      "end": 163.959,
      "text": "नहीं बल्कि हिंडन बर्क रिसर्च ने आईएफएल"
    },
    {
      "subtitle_id": 79,
      "start": 161.879,
      "end": 166.48,
      "text": "वेल्थ मैनेजमेंट यानी 361 पर भी आरोप"
    },
    {
      "subtitle_id": 80,
      "start": 163.959,
      "end": 168.08,
      "text": "लगाया है कि वो भी गलत चीजों में इवॉल्वड"
    },
    {
      "subtitle_id": 81,
      "start": 166.48,
      "end": 170.4,
      "text": "है अब यह था हिंडन बर्ग का सबसे मेन"
    },
    {
      "subtitle_id": 82,
      "start": 168.08,
      "end": 172.519,
      "text": "एलिगेशन जो सेकंड एलिगेशन है जो काफी"
    },
    {
      "subtitle_id": 83,
      "start": 170.4,
      "end": 174.959,
      "text": "सीरियस है वो यह है कि यह स्क्रीनशॉट से"
    },
    {
      "subtitle_id": 84,
      "start": 172.519,
      "end": 176.56,
      "text": "आप देख सकते हो कि यहां पर हिंडन बर्ग"
    },
    {
      "subtitle_id": 85,
      "start": 174.959,
      "end": 178.2,
      "text": "रिसर्च ने एक्चुअली स्क्रीनशॉट डाला है"
    },
    {
      "subtitle_id": 86,
      "start": 176.56,
      "end": 179.8,
      "text": "जहां पर उन्होंने बताया है कि सेबी चीफ"
    },
    {
      "subtitle_id": 87,
      "start": 178.2,
      "end": 181.56,
      "text": "सेज हर फेवरेट इन्वेस्टमेंट प्रोडक्ट"
    },
    {
      "subtitle_id": 88,
      "start": 179.8,
      "end": 183.64,
      "text": "प्रोडक्ट विल इक्वल द साइज ऑफ इंडियाज"
    },
    {
      "subtitle_id": 89,
      "start": 181.56,
      "end": 185.76,
      "text": "इक्विटी मार्केट अब ये फेवरेट प्रोडक्ट"
    },
    {
      "subtitle_id": 90,
      "start": 183.64,
      "end": 187.56,
      "text": "कौन सा है तो आरई आईटी इन विट्स और"
    },
    {
      "subtitle_id": 91,
      "start": 185.76,
      "end": 189.76,
      "text": "म्युनिसिपल बंड्स हिडन बर्ग रिसर्च यहीं"
    },
    {
      "subtitle_id": 92,
      "start": 187.56,
      "end": 191.84,
      "text": "पर नहीं रुकी उन्होंने यह भी कहा कि आरई"
    },
    {
      "subtitle_id": 93,
      "start": 189.76,
      "end": 194.36,
      "text": "आईटी रिलेटेड कई सारे रिफॉर्म्स आए हैं"
    },
    {
      "subtitle_id": 94,
      "start": 191.84,
      "end": 196.0,
      "text": "रिसेंटली जब से माधवी पुरी बुज सेबी के"
    },
    {
      "subtitle_id": 95,
      "start": 194.36,
      "end": 198.4,
      "text": "चेयर पर्सन बनी है अब यहां पर इन्होंने"
    },
    {
      "subtitle_id": 96,
      "start": 196.0,
      "end": 199.799,
      "text": "डॉट्स कनेक्ट करते-करते एक कंक्लूजन दिया"
    },
    {
      "subtitle_id": 97,
      "start": 198.4,
      "end": 202.28,
      "text": "है जिस पर मैं जल्दी आता हूं यहां पर"
    },
    {
      "subtitle_id": 98,
      "start": 199.799,
      "end": 204.0,
      "text": "इन्होंने कहा है कि ब्लैन एक बहुत बड़ी"
    },
    {
      "subtitle_id": 99,
      "start": 202.28,
      "end": 206.04,
      "text": "कंपनी है रियल एस्टेट इन्वेस्टमेंट में और"
    },
    {
      "subtitle_id": 100,
      "start": 204.0,
      "end": 207.92,
      "text": "कई सारे आरई आईटी के आईपीओ रिसेंटली आए"
    },
    {
      "subtitle_id": 101,
      "start": 206.04,
      "end": 209.92,
      "text": "हैं और उसमें से कई सारे आईआईटी जो थे दे"
    },
    {
      "subtitle_id": 102,
      "start": 207.92,
      "end": 211.84,
      "text": "वर स्पॉन्सर्ड बाय ब्लैन अब जो ब्लैकस्टर"
    },
    {
      "subtitle_id": 103,
      "start": 209.92,
      "end": 213.959,
      "text": "है उसके जो एडवाइजर है वो है धवल बुज जो"
    },
    {
      "subtitle_id": 104,
      "start": 211.84,
      "end": 215.56,
      "text": "कि सेबी चेयर पर्सन के हस्बैंड है अब यहां"
    },
    {
      "subtitle_id": 105,
      "start": 213.959,
      "end": 217.08,
      "text": "पर सीरियस एलिगेशन ये लगाया कि क्योंकि"
    },
    {
      "subtitle_id": 106,
      "start": 215.56,
      "end": 218.48,
      "text": "उनके हस्बैंड ब्लैक स्टन के एडवाइजर हैं"
    },
    {
      "subtitle_id": 107,
      "start": 217.08,
      "end": 220.4,
      "text": "तो ब्लैक स्टन को फायदा पहुंचाने के लिए"
    },
    {
      "subtitle_id": 108,
      "start": 218.48,
      "end": 222.04,
      "text": "माधवी पुरी पूछ ने ये कुछ रिफॉर्म्स लाए"
    },
    {
      "subtitle_id": 109,
      "start": 220.4,
      "end": 223.599,
      "text": "जिससे अल्टीमेटली ब्लैक स्टम को फायदा"
    },
    {
      "subtitle_id": 110,
      "start": 222.04,
      "end": 224.959,
      "text": "मिले उनके हस्बैंड को फायदा मिले वीडियो"
    },
    {
      "subtitle_id": 111,
      "start": 223.599,
      "end": 227.2,
      "text": "में आगे बढ़ने से पहले आपको क्विकली बता"
    },
    {
      "subtitle_id": 112,
      "start": 224.959,
      "end": 229.12,
      "text": "दूं कि बहुत सारे लोग इस तरह के रिपोर्ट्स"
    },
    {
      "subtitle_id": 113,
      "start": 227.2,
      "end": 230.799,
      "text": "के बेसिस पर तुरंत पोजीशंस ले लेते हैं तो"
    },
    {
      "subtitle_id": 114,
      "start": 229.12,
      "end": 232.439,
      "text": "मेरा ये मानना है कि कोई भी पोजीशन लेने"
    },
    {
      "subtitle_id": 115,
      "start": 230.799,
      "end": 234.28,
      "text": "से पहले आपको उस कंपनी का प्रॉपर"
    },
    {
      "subtitle_id": 116,
      "start": 232.439,
      "end": 236.12,
      "text": "फंडामेंटल एनालिसिस करना चाहिए उसका"
    },
    {
      "subtitle_id": 117,
      "start": 234.28,
      "end": 238.079,
      "text": "प्रॉपर फॉरेंसिक एनालिसिस करना चाहिए अगर"
    },
    {
      "subtitle_id": 118,
      "start": 236.12,
      "end": 239.799,
      "text": "आपको कुछ गड़बड़ वगैरह उसमें ढूंढनी है तो"
    },
    {
      "subtitle_id": 119,
      "start": 238.079,
      "end": 242.04,
      "text": "और ये सारी चीजें हमने सीखा ई हमारी"
    },
    {
      "subtitle_id": 120,
      "start": 239.799,
      "end": 243.519,
      "text": "फंडामेंटल एनालिसिस 2.0 कोर्स में जिसकी"
    },
    {
      "subtitle_id": 121,
      "start": 242.04,
      "end": 245.12,
      "text": "फिलहाल प्री बुकिंग चल रही है और इस"
    },
    {
      "subtitle_id": 122,
      "start": 243.519,
      "end": 247.28,
      "text": "इंडिपेंडेंस डे ऑफर डे विथ लाइफ टाइम"
    },
    {
      "subtitle_id": 123,
      "start": 245.12,
      "end": 249.159,
      "text": "वैलिडिटी आपको ₹ 77000 का एक कोर्स मिलेगा"
    },
    {
      "subtitle_id": 124,
      "start": 247.28,
      "end": 250.92,
      "text": "मात्र 2919 में तो अगर आपको"
    },
    {
      "subtitle_id": 125,
      "start": 249.159,
      "end": 252.64,
      "text": "इन्वेस्टिगेटिव रिसर्च करनी है फॉरेंसिक"
    },
    {
      "subtitle_id": 126,
      "start": 250.92,
      "end": 254.36,
      "text": "एनालिसिस में जाना है और फंडामेंटली"
    },
    {
      "subtitle_id": 127,
      "start": 252.64,
      "end": 256.239,
      "text": "स्ट्रांग स्टॉक्स ढूंढने हैं तो स्टार्ट"
    },
    {
      "subtitle_id": 128,
      "start": 254.36,
      "end": 258.079,
      "text": "से बेसिक एकदम बिगनर से लेकर एडवांस लेवल"
    },
    {
      "subtitle_id": 129,
      "start": 256.239,
      "end": 259.519,
      "text": "तक सारी चीजें इस कोर्स में कवर्ड है लिंक"
    },
    {
      "subtitle_id": 130,
      "start": 258.079,
      "end": 261.519,
      "text": "नीचे डिस्क्रिप्शन और कमेंट बॉक्स में दी"
    },
    {
      "subtitle_id": 131,
      "start": 259.519,
      "end": 263.16,
      "text": "गई है और इस ऑफर के मात्र चार दिन बचे हैं"
    },
    {
      "subtitle_id": 132,
      "start": 261.519,
      "end": 265.08,
      "text": "और तीसरा एलिगेशन लगाया मुझे लगता है वो"
    },
    {
      "subtitle_id": 133,
      "start": 263.16,
      "end": 267.16,
      "text": "सिर्फ नाम के लिए लगाया गया है वो यह है"
    },
    {
      "subtitle_id": 134,
      "start": 265.08,
      "end": 269.68,
      "text": "कि माधवी पूरी बूझ के एक कंसल्टिंग कंपनी"
    },
    {
      "subtitle_id": 135,
      "start": 267.16,
      "end": 272.56,
      "text": "है जो सिंगापुर से चलती है जिसमें उनकी 19"
    },
    {
      "subtitle_id": 136,
      "start": 269.68,
      "end": 273.88,
      "text": "% शेयर होल्डिंग थी 2022 तक जिसको"
    },
    {
      "subtitle_id": 137,
      "start": 272.56,
      "end": 275.44,
      "text": "उन्होंने बाद में अपने हस्बैंड को शेयर"
    },
    {
      "subtitle_id": 138,
      "start": 273.88,
      "end": 277.16,
      "text": "ट्रांसफर कर दी तो उसके बारे में उन्होंने"
    },
    {
      "subtitle_id": 139,
      "start": 275.44,
      "end": 279.12,
      "text": "बताया कि उनकी सैलरी से चार गुना ज्यादा"
    },
    {
      "subtitle_id": 140,
      "start": 277.16,
      "end": 281.28,
      "text": "पैसा उस कंसल्टिंग एज अ रिवेन्यू उन्होंने"
    },
    {
      "subtitle_id": 141,
      "start": 279.12,
      "end": 282.96,
      "text": "कमाया है बट आई थिंक वो बस लगाने के लिए"
    },
    {
      "subtitle_id": 142,
      "start": 281.28,
      "end": 284.84,
      "text": "लगाने वाला एलिगेशन लग रहा है तो यहां पर"
    },
    {
      "subtitle_id": 143,
      "start": 282.96,
      "end": 286.72,
      "text": "ये तीन मेन एलिगेशन हिंडन मक रिसर्च ने"
    },
    {
      "subtitle_id": 144,
      "start": 284.84,
      "end": 289.12,
      "text": "मार्वी पूरी बुच पर लगाए हैं अब यहां पर"
    },
    {
      "subtitle_id": 145,
      "start": 286.72,
      "end": 290.919,
      "text": "दो सिनेरियो है कि क्या ये एलिगेशंस सही"
    },
    {
      "subtitle_id": 146,
      "start": 289.12,
      "end": 293.479,
      "text": "में सीरियस एलिगेशंस है ये एक पहला सवाल"
    },
    {
      "subtitle_id": 147,
      "start": 290.919,
      "end": 295.919,
      "text": "है या फिर क्योंकि सेबी ने क्या किया है"
    },
    {
      "subtitle_id": 148,
      "start": 293.479,
      "end": 297.96,
      "text": "कि रिसेंटली जब से इन्होंने अदानी पर अटैक"
    },
    {
      "subtitle_id": 149,
      "start": 295.919,
      "end": 299.96,
      "text": "करना शुरू किया उसके बाद सेबी ने ये फाइंड"
    },
    {
      "subtitle_id": 150,
      "start": 297.96,
      "end": 301.759,
      "text": "आउट किया कि हिंडन बर्क रिसर्च ने अपनी"
    },
    {
      "subtitle_id": 151,
      "start": 299.96,
      "end": 303.479,
      "text": "रिपोर्ट पब्लिश करने से पहले अदानी के"
    },
    {
      "subtitle_id": 152,
      "start": 301.759,
      "end": 304.88,
      "text": "शेयर शॉर्ट किए थे और रिपोर्ट पब्लिश होने"
    },
    {
      "subtitle_id": 153,
      "start": 303.479,
      "end": 306.759,
      "text": "के बाद भी उन्होंने कुछ पोजीशन अदानी"
    },
    {
      "subtitle_id": 154,
      "start": 304.88,
      "end": 308.6,
      "text": "ग्रुप में ली थी जिसके लिए सेबी ने हिंडन"
    },
    {
      "subtitle_id": 155,
      "start": 306.759,
      "end": 311.28,
      "text": "बर्ग रिसर्च को एक शो कॉज नोटिस भेजा था"
    },
    {
      "subtitle_id": 156,
      "start": 308.6,
      "end": 313.4,
      "text": "तो क्या ये उसके लिए एक रिवेंज है ये तो"
    },
    {
      "subtitle_id": 157,
      "start": 311.28,
      "end": 315.16,
      "text": "खैर टाइम ही बताएगा कि क्या सही क्या गलत"
    },
    {
      "subtitle_id": 158,
      "start": 313.4,
      "end": 316.919,
      "text": "मैं ये आप पर छोड़ देता हूं लेकिन जो भी"
    },
    {
      "subtitle_id": 159,
      "start": 315.16,
      "end": 318.6,
      "text": "रिसर्च में सारी इंफॉर्मेशन थी आसान से"
    },
    {
      "subtitle_id": 160,
      "start": 316.919,
      "end": 320.639,
      "text": "आसान भाषा में मैंने आपको समझाने की कोशिश"
    },
    {
      "subtitle_id": 161,
      "start": 318.6,
      "end": 322.28,
      "text": "की आई होप सारी चीजें आपके लिए क्लियर हैं"
    },
    {
      "subtitle_id": 162,
      "start": 320.639,
      "end": 324.16,
      "text": "अब आप कमेंट में बताइए कि आपको क्या लगता"
    },
    {
      "subtitle_id": 163,
      "start": 322.28,
      "end": 325.88,
      "text": "है और आगे किस तरह से गवर्नमेंट को इस चीज"
    },
    {
      "subtitle_id": 164,
      "start": 324.16,
      "end": 327.36,
      "text": "को लेकर जाना चाहिए मिलते हैं अगले वीडियो"
    },
    {
      "subtitle_id": 165,
      "start": 325.88,
      "end": 328.88,
      "text": "में थैंक यू सो मच फॉर वाचिंग दिस वीडियो"
    },
    {
      "subtitle_id": 166,
      "start": 327.36,
      "end": 330.919,
      "text": "और जाने से पहले हमारा फंडामेंटल एनालिसिस"
    },
    {
      "subtitle_id": 167,
      "start": 328.88,
      "end": 334.44,
      "text": "को जरूर चेक आउट लिंक नीचे डिस्क्रिप्शन"
    },
    {
      "subtitle_id": 168,
      "start": 330.919,
      "end": 334.44,
      "text": "और कमेंट बॉक्स में दी गई है"
    }
  ]
}