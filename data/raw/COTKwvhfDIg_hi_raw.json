      "subtitle_id": 290,
      "start": 688.36,
      "end": 691.76,
      "text": "क्योंकि मोबाइल म फैक्चरिंग की अगर बात"
    },
    {
      "subtitle_id": 291,
      "start": 690.12,
      "end": 693.72,
      "text": "करें इंडिया में तो कंपनी की मोनोपोली चल"
    },
    {
      "subtitle_id": 292,
      "start": 691.76,
      "end": 695.8,
      "text": "रही है तो मोबाइल ईएमएस मार्केट में उनका"
    },
    {
      "subtitle_id": 293,
      "start": 693.72,
      "end": 698.32,
      "text": "60 पर मार्केट शेयर है एलईडी टेलीविजन"
    },
    {
      "subtitle_id": 294,
      "start": 695.8,
      "end": 699.72,
      "text": "कंपोनेंट में 50 पर और बाकी अलग-अलग चीजों"
    },
    {
      "subtitle_id": 295,
      "start": 698.32,
      "end": 701.639,
      "text": "में क्या कुछ मार्केट शेयर है आप स्क्रीन"
    },
    {
      "subtitle_id": 296,
      "start": 699.72,
      "end": 703.32,
      "text": "पर देख सकते हो तो रिसेंट टाइम में बहुत"
    },
    {
      "subtitle_id": 297,
      "start": 701.639,
      "end": 705.44,
      "text": "अच्छी परफॉर्मेंस आई है लोगों की"
    },
    {
      "subtitle_id": 298,
      "start": 703.32,
      "end": 707.48,
      "text": "एक्सपेक्टेशन है कि बहुत तेजी की ग्रोथ"
    },
    {
      "subtitle_id": 299,
      "start": 705.44,
      "end": 709.24,
      "text": "यानी पिछले एक साल में 100 100% की ग्रोथ"
    },
    {
      "subtitle_id": 300,
      "start": 707.48,
      "end": 711.04,
      "text": "चल रही है तो लोगों का ये एक्सपेक्टेशन है"
    },
    {
      "subtitle_id": 301,
      "start": 709.24,
      "end": 714.36,
      "text": "कि आने वाले टाइम में भी ये चलता रहेगा"
    },
    {
      "subtitle_id": 302,
      "start": 711.04,
      "end": 717.88,
      "text": "अगर ऐसा होता है तो 180 190 का जो पीई है"
    },
    {
      "subtitle_id": 303,
      "start": 714.36,
      "end": 720.0,
      "text": "वो सस्टेन कर पाएगा लेकिन अगर 100 से 50"
    },
    {
      "subtitle_id": 304,
      "start": 717.88,
      "end": 723.16,
      "text": "पर पर भी ये ग्रोथ आ जाती है 50 पर भी"
    },
    {
      "subtitle_id": 305,
      "start": 720.0,
      "end": 725.76,
      "text": "बहुत अच्छा है लेकिन 190 के पी के लिए 50"
    },
    {
      "subtitle_id": 306,
      "start": 723.16,
      "end": 728.279,
      "text": "पर की ग्रोथ सफिशिएंट नहीं है तो फिर वहां"
    },
    {
      "subtitle_id": 307,
      "start": 725.76,
      "end": 730.12,
      "text": "से चीजें प्रॉब्लम में आ सकती है तो ओवरऑल"
    },
    {
      "subtitle_id": 308,
      "start": 728.279,
      "end": 732.279,
      "text": "अगर इसे सराइज किया जाए तो अच्छे सेगमेंट"
    },
    {
      "subtitle_id": 309,
      "start": 730.12,
      "end": 733.76,
      "text": "में कंपनी काम कर रही है और एक तरह से एक"
    },
    {
      "subtitle_id": 310,
      "start": 732.279,
      "end": 735.32,
      "text": "सनराइज है इंडिया के लिए क्योंकि"
    },
    {
      "subtitle_id": 311,
      "start": 733.76,
      "end": 737.12,
      "text": "मैन्युफैक्चरिंग इंडिया में उतना चल नहीं"
    },
    {
      "subtitle_id": 312,
      "start": 735.32,
      "end": 738.88,
      "text": "रहा था काफी लंबे टाइम तक इलेक्ट्रॉनिक"
    },
    {
      "subtitle_id": 313,
      "start": 737.12,
      "end": 740.839,
      "text": "सेगमेंट की अगर बात करें तो तो वहां पर"
    },
    {
      "subtitle_id": 314,
      "start": 738.88,
      "end": 744.32,
      "text": "कंपनी काफी बहुत बढ़िया तरीके से परफॉर्म"
    },
    {
      "subtitle_id": 315,
      "start": 740.839,
      "end": 744.32,
      "text": "कर रही है फाइनेंशियलीईएक्सप्रेस"
    },
    {
      "subtitle_id": 316,
      "start": 749.399,
      "end": 754.0,
      "text": "कि कंपनी अबोव 100% की ही ग्रोथ दिखाए अगर"
    },
    {
      "subtitle_id": 317,
      "start": 751.92,
      "end": 756.519,
      "text": "ऐसा नहीं होता है तो आपके लिए गलत प्राइस"
    },
    {
      "subtitle_id": 318,
      "start": 754.0,
      "end": 758.04,
      "text": "पॉइंट की बाइंग हो सकती है तो ऐसे में अगर"
    },
    {
      "subtitle_id": 319,
      "start": 756.519,
      "end": 760.12,
      "text": "आपको आने वाले टाइम में अगर कोई डीप"
    },
    {
      "subtitle_id": 320,
      "start": 758.04,
      "end": 762.04,
      "text": "डिस्काउंट ऐसी इस तरह की कंपनीज में मिलता"
    },
    {
      "subtitle_id": 321,
      "start": 760.12,
      "end": 764.32,
      "text": "है तो वहां पर आप अपॉर्चुनिटी ढूंढने की"
    },
    {
      "subtitle_id": 322,
      "start": 762.04,
      "end": 765.279,
      "text": "कोशिश कर सकते हो तो फिलहाल हम यही रुकते"
    },
    {
      "subtitle_id": 323,
      "start": 764.32,
      "end": 766.959,
      "text": "हैं आशा करते हैं कि इंडिया की"
    },
    {
      "subtitle_id": 324,
      "start": 765.279,
      "end": 768.279,
      "text": "मैन्युफैक्चरिंग इंडस्ट्री और क्या कुछ चल"
    },
    {
      "subtitle_id": 325,
      "start": 766.959,
      "end": 769.6,
      "text": "रहा है बहुत सारे लोगों को ये पता नहीं है"
    },
    {
      "subtitle_id": 326,
      "start": 768.279,
      "end": 771.519,
      "text": "कि मैन्युफैक्चरिंग इंडस्ट्री में इंडिया"
    },
    {
      "subtitle_id": 327,
      "start": 769.6,
      "end": 773.44,
      "text": "में क्या कुछ चल रहा है तो न ने लिम्स"
    },
    {
      "subtitle_id": 328,
      "start": 771.519,
      "end": 775.32,
      "text": "आपको जरूर दे दिया होगा कि यहां पर काफी"
    },
    {
      "subtitle_id": 329,
      "start": 773.44,
      "end": 776.56,
      "text": "बड़ी चीजें हो रही हैं और हम अभी"
    },
    {
      "subtitle_id": 330,
      "start": 775.32,
      "end": 778.32,
      "text": "छोटे-मोटे प्लेयर्स नहीं बड़े-बड़े"
    },
    {
      "subtitle_id": 331,
      "start": 776.56,
      "end": 780.0,
      "text": "प्लेयर्स के साथ भी काम कर रहे हैं और"
    },
    {
      "subtitle_id": 332,
      "start": 778.32,
      "end": 781.959,
      "text": "सिर्फ असेंबली नहीं हम पूरी"
    },
    {
      "subtitle_id": 333,
      "start": 780.0,
      "end": 783.88,
      "text": "मैन्युफैक्चरिंग भी कर रहे हैं तो आशा"
    },
    {
      "subtitle_id": 334,
      "start": 781.959,
      "end": 785.72,
      "text": "करता हूं कि न के बारे में पूरी क्लियर"
    },
    {
      "subtitle_id": 335,
      "start": 783.88,
      "end": 787.48,
      "text": "पिक्चर आपके सामने भी आ गई होगी वीडियो"
    },
    {
      "subtitle_id": 336,
      "start": 785.72,
      "end": 789.76,
      "text": "पसंद आता है तो जरूर वीडियो को लाइक कीजिए"
    },
    {
      "subtitle_id": 337,
      "start": 787.48,
      "end": 792.32,
      "text": "शेयर कीजिए अपने दोस्तों के साथ और"
    },
    {
      "subtitle_id": 338,
      "start": 789.76,
      "end": 794.36,
      "text": "जाते-जाते हमारे कमो ऑफर्स को जरूर चेक"
    },
    {
      "subtitle_id": 339,
      "start": 792.32,
      "end": 796.32,
      "text": "आउट कीजिए क्योंकि इसके बस आखिरी तीन दिन"
    },
    {
      "subtitle_id": 340,
      "start": 794.36,
      "end": 798.04,
      "text": "बचे हैं तो ऑफर खत्म होने से पहले जरूर"
    },
    {
      "subtitle_id": 341,
      "start": 796.32,
      "end": 800.199,
      "text": "ऑफर का फायदा लें क्योंकि इस प्राइस में"
    },
    {
      "subtitle_id": 342,
      "start": 798.04,
      "end": 802.16,
      "text": "बाद में आपको यह कोर्सेस कभी नहीं मिलेंगे"
    },
    {
      "subtitle_id": 343,
      "start": 800.199,
      "end": 805.6,
      "text": "सो डोंट मिस आउट ऑन दिस अपॉर्चुनिटी टेक"
    },
    {
      "subtitle_id": 344,
      "start": 802.16,
      "end": 805.6,
      "text": "केयर बाय बाय"
    }
  ]
}