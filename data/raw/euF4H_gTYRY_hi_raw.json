    {
      "subtitle_id": 81,
      "start": 169.68,
      "end": 174.56,
      "text": "था अगले दिन फिर से मार्केट 2 पर से गिर"
    },
    {
      "subtitle_id": 82,
      "start": 172.08,
      "end": 177.519,
      "text": "गया और फिर आने वाले टाइम में भी मोर और"
    },
    {
      "subtitle_id": 83,
      "start": 174.56,
      "end": 180.04,
      "text": "लेस गिरावट जारी रही तो 2019 का जो बजट था"
    },
    {
      "subtitle_id": 84,
      "start": 177.519,
      "end": 182.12,
      "text": "वह थोड़ा अलग था थोड़ा डिफरेंट था और वहां"
    },
    {
      "subtitle_id": 85,
      "start": 180.04,
      "end": 183.84,
      "text": "पर वो जो बजट था वह मार्केट को इंप्रेस"
    },
    {
      "subtitle_id": 86,
      "start": 182.12,
      "end": 185.799,
      "text": "नहीं कर पाया इसलिए मार्केट काफी ज्यादा"
    },
    {
      "subtitle_id": 87,
      "start": 183.84,
      "end": 188.84,
      "text": "गिर गया लेकिन मार्केट के खराब रिएक्शन के"
    },
    {
      "subtitle_id": 88,
      "start": 185.799,
      "end": 191.159,
      "text": "बाद ही वह सरकार लाने में कामयाब हुए थे"
    },
    {
      "subtitle_id": 89,
      "start": 188.84,
      "end": 193.84,
      "text": "एक आखिरी डाटा देख लेते हैं 2004-5 का और"
    },
    {
      "subtitle_id": 90,
      "start": 191.159,
      "end": 197.319,
      "text": "उस इंटरम बजट को पेश किया था लेट जसवंत"
    },
    {
      "subtitle_id": 91,
      "start": 193.84,
      "end": 199.56,
      "text": "सिंह ने 4 फरवरी 2004 को यहां पर भी बजट"
    },
    {
      "subtitle_id": 92,
      "start": 197.319,
      "end": 201.239,
      "text": "के दिन मार्केट 3 पर से बढ़ गया था अगले"
    },
    {
      "subtitle_id": 93,
      "start": 199.56,
      "end": 203.36,
      "text": "दिन मार्केट डाउन था लेकिन उसके तीन-चार"
