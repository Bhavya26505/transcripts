    {
      "subtitle_id": 94,
      "start": 201.239,
      "end": 205.319,
      "text": "दिन बाद मार्केट लगातार बढ़ता रहा तो यहां"
    },
    {
      "subtitle_id": 95,
      "start": 203.36,
      "end": 207.76,
      "text": "पर एक चीज हमें समझ में आई कि 10 में से"
    },
    {
      "subtitle_id": 96,
      "start": 205.319,
      "end": 209.799,
      "text": "आठ केसेस में मार्केट पॉजिटिवली रिएक्ट"
    },
    {
      "subtitle_id": 97,
      "start": 207.76,
      "end": 211.319,
      "text": "करता है बिकॉज़ गवर्नमेंट पर भी प्रेशर"
    },
    {
      "subtitle_id": 98,
      "start": 209.799,
      "end": 213.239,
      "text": "रहता है कि अगर हम लोगों को यहां पर"
    },
    {
      "subtitle_id": 99,
      "start": 211.319,
      "end": 215.28,
      "text": "इंप्रेस नहीं कर पाए तो सरकार बनाने में"
    },
    {
      "subtitle_id": 100,
      "start": 213.239,
      "end": 217.2,
      "text": "हमें मुश्किलों का सामना करना पड़ सकता है"
    },
    {
      "subtitle_id": 101,
      "start": 215.28,
      "end": 219.2,
      "text": "अब अगला सवाल ये आता है कि जनरली वो कौन"
    },
    {
      "subtitle_id": 102,
      "start": 217.2,
      "end": 220.959,
      "text": "से सेक्टर्स होते हैं जिन पर इलेक्शन ईयर"
    },
    {
      "subtitle_id": 103,
      "start": 219.2,
      "end": 222.599,
      "text": "में सबसे ज्यादा फोकस किया जाता है यह"
    },
    {
      "subtitle_id": 104,
      "start": 220.959,
      "end": 224.68,
      "text": "बड़ा इंटरेस्टिंग सवाल है और उसका जवाब भी"
    },
    {
      "subtitle_id": 105,
      "start": 222.599,
      "end": 226.56,
      "text": "बड़ा इंटरेस्टिंग है तो हमने इसका भी डाटा"
    },
    {
      "subtitle_id": 106,
      "start": 224.68,
      "end": 229.319,
      "text": "निकाला हर बजट ईयर का और डेटा बड़ा"
    },
    {
      "subtitle_id": 107,
      "start": 226.56,
      "end": 231.239,
      "text": "इंटरेस्टिंग है 201920 के एंटरिंग बजट में"
    },
    {
      "subtitle_id": 108,
      "start": 229.319,
      "end": 233.079,
      "text": "गवर्नमेंट ने चार सेक्टर्स पर ज्यादा फोकस"
    },
    {
      "subtitle_id": 109,
      "start": 231.239,
      "end": 235.079,
      "text": "किया था और वो चार सेक्टर्स थे बैंकिंग"
    },
    {
      "subtitle_id": 110,
      "start": 233.079,
      "end": 237.84,
      "text": "रियल एस्टेट रेलवे और इंफ्रास्ट्रक्चर"
    },
    {
      "subtitle_id": 111,
      "start": 235.079,
      "end": 239.68,
      "text": "2014-15 के बजट में तीन सेक्टर्स पर सबसे"
    },
    {
      "subtitle_id": 112,
      "start": 237.84,
      "end": 241.56,
      "text": "ज्यादा फोकस किया गया था और वो थे"
    },
    {
      "subtitle_id": 113,
      "start": 239.68,
      "end": 244.2,
      "text": "इंश्योरेंस बैंकिंग और कमोडिटी"
    },
    {
      "subtitle_id": 114,
      "start": 241.56,
      "end": 246.0,
      "text": "डेरिवेटिव्स फिर 2019 के इंटरम बजट में दो"
    },
    {
      "subtitle_id": 115,
      "start": 244.2,
      "end": 248.84,
      "text": "सेक्टर्स पर सबसे ज्यादा फोकस किया गया था"
    },
    {
      "subtitle_id": 116,
      "start": 246.0,
      "end": 251.28,
      "text": "वह थे एक थे पीएसयू यानी गवर्नमेंट कंपनीज"
    },
    {
      "subtitle_id": 117,
      "start": 248.84,
      "end": 253.2,
      "text": "और दूसरा था बैंकिंग और 2004-5 के एंटरिंग"
    },
    {
      "subtitle_id": 118,
      "start": 251.28,
      "end": 255.76,
      "text": "बजट में दो सेक्टर पर सबसे ज्यादा फोकस"
    },
    {
      "subtitle_id": 119,
      "start": 253.2,
      "end": 258.079,
      "text": "किया गया था डिफेंस और बैंकिंग अब आप मुझे"
    },
    {
      "subtitle_id": 120,
      "start": 255.76,
      "end": 259.959,
      "text": "बताइए कि इन सारे डाटा में आपको एक कॉमन"
    },
    {
      "subtitle_id": 121,
      "start": 258.079,
      "end": 261.639,
      "text": "चीज़ क्या लगी तो आपने शायद पता कर लिया"
    },
    {
      "subtitle_id": 122,
      "start": 259.959,
      "end": 264.08,
      "text": "होगा तो कॉमन चीज़ यह है कि लगभग हर"
    },
    {
      "subtitle_id": 123,
      "start": 261.639,
      "end": 266.28,
      "text": "इलेक्शन ईयर में जो भी बजट आते हैं उसमें"
    },
    {
      "subtitle_id": 124,
      "start": 264.08,
      "end": 268.52,
      "text": "बहुत ज्यादा फोकस बैंकिंग सेक्टर पर किया"
    },
    {
      "subtitle_id": 125,
      "start": 266.28,
      "end": 270.36,
      "text": "जाता है लेकिन फिर क्या इस चीज से बैंकिंग"
    },
    {
      "subtitle_id": 126,
      "start": 268.52,
      "end": 272.6,
      "text": "सेक्टर के स्टॉक्स बजट के दिन या उसके बाद"
    },
    {
      "subtitle_id": 127,
      "start": 270.36,
      "end": 274.52,
      "text": "बढ़ते हैं यह देखना भी जरूरी रहेगा तो"
    },
    {
      "subtitle_id": 128,
      "start": 272.6,
      "end": 277.199,
      "text": "अगेन यहां पर हमने थोड़ी डटा क्रंचिंग की"
    },
    {
      "subtitle_id": 129,
      "start": 274.52,
      "end": 279.36,
      "text": "और उसके बाद हमें यह पता चला कि 201920 का"
    },
    {
      "subtitle_id": 130,
      "start": 277.199,
      "end": 281.639,
      "text": "जो बजट था उसमें बजट के दिन तो बैंक"
    },
    {
      "subtitle_id": 131,
      "start": 279.36,
      "end": 283.56,
      "text": "निफ्टी गिर गया था लेकिन उसके अगले दो-तीन"
    },
    {
      "subtitle_id": 132,
      "start": 281.639,
      "end": 285.72,
      "text": "दिन में उसने रिकवरी कर ली थी यानी कुछ"
    },
    {
      "subtitle_id": 133,
      "start": 283.56,
      "end": 288.32,
      "text": "खास बेनिफिट बैंक निफ्टी को नहीं मिला था"
    },
    {
      "subtitle_id": 134,
      "start": 285.72,
      "end": 290.039,
      "text": "उसके पहले की बात करें 2014-15 के बजट की"
    },
    {
      "subtitle_id": 135,
      "start": 288.32,
      "end": 291.919,
      "text": "तो यहां पर बैंक निफ्टी की परफॉर्मेंस"
    },
    {
      "subtitle_id": 136,
      "start": 290.039,
      "end": 295.12,
      "text": "बहुत आउटस्टैंडिंग थी बजट के दिन भी और"
    },
    {
      "subtitle_id": 137,
      "start": 291.919,
      "end": 297.12,
      "text": "उसके बाद भी 2019 की बात करें तो वह बात"
    },
    {
      "subtitle_id": 138,
      "start": 295.12,
      "end": 298.919,
      "text": "नहीं करना बेहतर है तो उस टाइम कुछ ही"
    },
    {
      "subtitle_id": 139,
      "start": 297.12,
      "end": 300.96,
      "text": "दिनों में बैंकिंग सेक्टर के स्टॉक्स 15"
    },
    {
      "subtitle_id": 140,
      "start": 298.919,
      "end": 303.12,
      "text": "पर से ज्यादा गिर गए थे बस पाछ दिनों के"
    },
    {
      "subtitle_id": 141,
      "start": 300.96,
      "end": 304.919,
      "text": "अंदर ही और 2004-5 का जो बैंक निफ्टी का"
    },
    {
      "subtitle_id": 142,
      "start": 303.12,
      "end": 306.84,
      "text": "डटा है वो नहीं है क्योंकि बैंक निफ्टी तब"
    },
    {
      "subtitle_id": 143,
      "start": 304.919,
      "end": 308.52,
      "text": "तक नहीं बना था तो यहां पर कंक्लूजन में"
    },
    {
      "subtitle_id": 144,
      "start": 306.84,
      "end": 311.199,
      "text": "हम क्या कह सकते हैं तो यह कह सकते हैं कि"
    },
    {
      "subtitle_id": 145,
      "start": 308.52,
      "end": 313.639,
      "text": "10 में से आठ बार निफ्टी की परफॉर्मेंस"
    },
    {
      "subtitle_id": 146,
      "start": 311.199,
      "end": 315.199,
      "text": "बजट के दिन और उसके बाद अच्छी होती है एक"
    },
    {
      "subtitle_id": 147,
      "start": 313.639,
      "end": 317.0,
      "text": "सेक्टर जिस पर सबसे ज्यादा फोकस होता है"
    },
    {
      "subtitle_id": 148,
      "start": 315.199,
      "end": 318.68,
      "text": "वो होता है बैंकिंग सेक्टर लेकिन बैंक"
    },
    {
      "subtitle_id": 149,
      "start": 317.0,
      "end": 320.8,
      "text": "निफ्टी की परफॉर्मेंस उतनी खास नहीं होती"
    },
    {
      "subtitle_id": 150,
      "start": 318.68,
      "end": 322.24,
      "text": "है ना ही बजट के दिन ना ही उसके बाद ये भी"
    },
    {
      "subtitle_id": 151,
      "start": 320.8,
      "end": 323.8,
      "text": "चीज हमें देखने मिली तो चीजें देखना"
    },
    {
      "subtitle_id": 152,
      "start": 322.24,
      "end": 325.8,
      "text": "इंटरेस्टिंग रहेगा लेकिन एक चीज आपको बता"
    },
    {
      "subtitle_id": 153,
      "start": 323.8,
      "end": 327.24,
      "text": "दूं कि फिलहाल बैंकिंग सेक्टर जो इंडिया"
    },
    {
      "subtitle_id": 154,
      "start": 325.8,
      "end": 329.08,
      "text": "का है उसका जो प्राइस टू अर्निंग रेशियो"
    },
    {
      "subtitle_id": 155,
      "start": 327.24,
      "end": 331.28,
      "text": "है वो लगभग अपने ऑल टाइम लो को हीट कर रहा"
    },
    {
      "subtitle_id": 156,
      "start": 329.08,
      "end": 333.639,
      "text": "है यानी ऑन एन एवरेज बैंकिंग सेक्टर का जो"
    },
    {
      "subtitle_id": 157,
      "start": 331.28,
      "end": 335.72,
      "text": "पी रेशो है वो 15 के करीब अप्रोच हो रहा"
    },
    {
      "subtitle_id": 158,
      "start": 333.639,
      "end": 337.919,
      "text": "है वो बहुत लो है कंपेयर्ड टू पास्ट"
    },
    {
      "subtitle_id": 159,
      "start": 335.72,
      "end": 339.759,
      "text": "परफॉर्मेंस ऑफ द पी रेशो बाकी अगर हम"
    },
    {
      "subtitle_id": 160,
      "start": 337.919,
      "end": 341.52,
      "text": "रेलवेज की बात करें जिस पर भी काफी फोकस"
    },
    {
      "subtitle_id": 161,
      "start": 339.759,
      "end": 343.039,
      "text": "होता है गवर्नमेंट कंपनीज की बात करें"
    },
    {
      "subtitle_id": 162,
      "start": 341.52,
      "end": 344.919,
      "text": "इंफ्रास्ट्रक्चर की बात करें डिफेंस की"
    },
    {
      "subtitle_id": 163,
      "start": 343.039,
      "end": 346.479,
      "text": "बात करें तो ये स्टॉक्स पिछले छ आठ महीनों"
    },
    {
      "subtitle_id": 164,
      "start": 344.919,
      "end": 349.0,
      "text": "में बहुत ज्यादा बढ़ चुके हैं रेलवेज की"
    },
    {
      "subtitle_id": 165,
      "start": 346.479,
      "end": 351.24,
      "text": "तो मतलब सबको ही पता है कहानी बहुत ज्यादा"
    },
    {
      "subtitle_id": 166,
      "start": 349.0,
      "end": 353.72,
      "text": "स्टॉक्स बढ़ चुके हैं कई सारी कंपनीज ऐसी"
    },
    {
      "subtitle_id": 167,
      "start": 351.24,
      "end": 355.12,
      "text": "कि जिनके अगर पी रेशो उनका 30 का होना"
    },
    {
      "subtitle_id": 168,
      "start": 353.72,
      "end": 357.08,
      "text": "चाहिए 40 का होना चाहिए तो वो 70-80"
    },
    {
      "subtitle_id": 169,
      "start": 355.12,
      "end": 359.08,
      "text": "अप्रोच कर रहा है कुछ का 100 के ऊपर भी"
    },
    {
      "subtitle_id": 170,
      "start": 357.08,
      "end": 361.4,
      "text": "चला गया है सो मेरा जो प्री बजट का फोकस"
    },
    {
      "subtitle_id": 171,
      "start": 359.08,
      "end": 363.479,
      "text": "है वो ओवरऑल मार्केट पर है और साथ ही"
    },
    {
      "subtitle_id": 172,
      "start": 361.4,
      "end": 365.52,
      "text": "बैंकिंग सेक्टर पर भी रहेगा क्योंकि वो ऑल"
    },
    {
      "subtitle_id": 173,
      "start": 363.479,
      "end": 366.96,
      "text": "टाइम लो को अप्रोच कर रहे हैं और इसमें भी"
    },
    {
      "subtitle_id": 174,
      "start": 365.52,
      "end": 369.12,
      "text": "देखना इंटरेस्टिंग रहेगा कि बैंकिंग"
    },
    {
      "subtitle_id": 175,
      "start": 366.96,
      "end": 370.84,
      "text": "सेक्टर के लिए इस बजट में खास क्या निकल"
    },
    {
      "subtitle_id": 176,
      "start": 369.12,
      "end": 372.639,
      "text": "कर आता है साथ ही आपको बता दूं कि जो"
    },
    {
      "subtitle_id": 177,
      "start": 370.84,
      "end": 375.24,
      "text": "रिपब्लिक डे ऑफर है बहुत ही लिमिटेड टाइम"
    },
    {
      "subtitle_id": 178,
      "start": 372.639,
      "end": 377.28,
      "text": "ऑफर है ऐसी ऑफर आपको जल्दी नहीं मिलेगी तो"
    },
    {
      "subtitle_id": 179,
      "start": 375.24,
      "end": 378.96,
      "text": "इस ऑफर को बिल्कुल भी मिस ना करें लिंक"
    },
    {
      "subtitle_id": 180,
      "start": 377.28,
      "end": 381.039,
      "text": "आपको नीचे डिस्क्रिप्शन और कमेंट बॉक्स"
    },
    {
      "subtitle_id": 181,
      "start": 378.96,
      "end": 383.0,
      "text": "में दी गई है तो इस बजट में आपकी"
    },
    {
      "subtitle_id": 182,
      "start": 381.039,
      "end": 384.84,
      "text": "स्ट्रेटेजी क्या रहने वाली है और इस डाटा"
    },
    {
      "subtitle_id": 183,
      "start": 383.0,
      "end": 386.639,
      "text": "की मदद से आप क्या कुछ स्ट्रेटजी करने"
    },
    {
      "subtitle_id": 184,
      "start": 384.84,
      "end": 388.16,
      "text": "वाले हो लगाने वाले हो उसके बारे में भी"
    },
    {
      "subtitle_id": 185,
      "start": 386.639,
      "end": 390.08,
      "text": "आप कमेंट सेक्शन में कमेंट करके जरूर"
    },
    {
      "subtitle_id": 186,
      "start": 388.16,
      "end": 391.599,
      "text": "बताइए मिलते हैं अगले वीडियो थैंक यू सो"
    },
    {
      "subtitle_id": 187,
      "start": 390.08,
      "end": 393.44,
      "text": "मच फॉर वाचिंग दिस वीडियो आपके जो भी"
    },
    {
      "subtitle_id": 188,
      "start": 391.599,
      "end": 395.4,
      "text": "इन्वेस्टर दोस्त हैं उनके साथ यह डटा और"
    },
    {
      "subtitle_id": 189,
      "start": 393.44,
      "end": 398.639,
      "text": "यह वीडियो जरूर शेयर कीजिए ताकि वो भी एक"
    },
    {
      "subtitle_id": 190,
      "start": 395.4,
      "end": 398.639,
      "text": "बेटर डिसीजन ले पाए"
    }
  ]
}