  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.16,
      "end": 4.4,
      "text": "अभी कुछ ही दिनों बाद बजट आ रहा है और जो"
    },
    {
      "subtitle_id": 2,
      "start": 2.72,
      "end": 6.64,
      "text": "इलेक्शन ईयर के बजट होते हैं ना वोह थोड़े"
    },
    {
      "subtitle_id": 3,
      "start": 4.4,
      "end": 9.599,
      "text": "खास होते हैं खास इसलिए क्योंकि कोई भी"
    },
    {
      "subtitle_id": 4,
      "start": 6.64,
      "end": 11.639,
      "text": "गवर्नमेंट लोगों को डिसइंटर चाहती इलेक्शन"
    },
    {
      "subtitle_id": 5,
      "start": 9.599,
      "end": 13.559,
      "text": "से पहले और इसीलिए बहुत बड़े-बड़े प्रॉमिस"
    },
    {
      "subtitle_id": 6,
      "start": 11.639,
      "end": 15.2,
      "text": "यहां पर होते हैं और उन प्रॉमिस के चलते"
    },
    {
      "subtitle_id": 7,
      "start": 13.559,
      "end": 17.8,
      "text": "स्टॉक मार्केट भी एक पर्टिकुलर तरीके से"
    },
    {
      "subtitle_id": 8,
      "start": 15.2,
      "end": 20.359,
      "text": "उसे रिएक्ट करता है और इसीलिए हमने क्या"
    },
    {
      "subtitle_id": 9,
      "start": 17.8,
      "end": 22.64,
      "text": "किया है कि जितने भी पिछले 20-2 साल थे"
    },
    {
      "subtitle_id": 10,
      "start": 20.359,
      "end": 25.0,
      "text": "उनका एनालिसिस किया और उसमें जितने भी"
    },
    {
      "subtitle_id": 11,
      "start": 22.64,
      "end": 27.199,
      "text": "इलेक्शंस हुए उसमें हमने एक डटा पाया कि"
    },
    {
      "subtitle_id": 12,
      "start": 25.0,
      "end": 29.279,
      "text": "उस टाइम गवर्नमेंट ने किन सेक्टर्स पर"
    },
    {
      "subtitle_id": 13,
      "start": 27.199,
      "end": 31.359,
      "text": "फोकस किया और फिर मार्केट ने उस बजट को"
    },
    {
      "subtitle_id": 14,
      "start": 29.279,
      "end": 32.8,
      "text": "कैसे रिएक्ट किया ये सारी चीजें आज के इस"
    },
    {
      "subtitle_id": 15,
      "start": 31.359,
      "end": 34.84,
      "text": "वीडियो में हम डिटेल में बात करने वाले"
    },
    {
      "subtitle_id": 16,
      "start": 32.8,
      "end": 37.079,
      "text": "हैं कि कौन सा वह सेक्टर है जो हर बजट में"
    },
    {
      "subtitle_id": 17,
      "start": 34.84,
      "end": 38.76,
      "text": "कॉमन रहा है पिछले 20-2 साल में और"
    },
    {
      "subtitle_id": 18,
      "start": 37.079,
      "end": 41.28,
      "text": "इलेक्शन ईयर में जनरली मार्केट कैसे"
    },
    {
      "subtitle_id": 19,
      "start": 38.76,
      "end": 44.28,
      "text": "परफॉर्म करता है बजट डे के दिन बजट डे के"
    },
    {
      "subtitle_id": 20,
      "start": 41.28,
      "end": 46.239,
      "text": "बाद और बजट डे से पहले नमस्कार मैं प्रसाद"
    },
    {
      "subtitle_id": 21,
      "start": 44.28,
      "end": 47.719,
      "text": "आपका आज के इस वीडियो में स्वागत करता हूं"
    },
    {
      "subtitle_id": 22,
      "start": 46.239,
      "end": 51.44,
      "text": "वीडियो में आगे बढ़ने से पहले आपको बता"
    },
    {
      "subtitle_id": 23,
      "start": 47.719,
      "end": 53.48,
      "text": "दूं कि आपको हमारे ₹1 700 के छह एनिमेटेड"
    },
    {
      "subtitle_id": 24,
      "start": 51.44,
      "end": 55.76,
      "text": "शेयर मार्केट कोर्सेस बिल्कुल फ्री में"
    },
    {
      "subtitle_id": 25,
      "start": 53.48,
      "end": 57.719,
      "text": "मिल सकते हैं इस स्पेशल रिपब्लिक डे ऑफर"
    },
    {
      "subtitle_id": 26,
      "start": 55.76,
      "end": 59.559,
      "text": "में यहां पर आपको हमारा स्टॉक मार्केट फॉर"
    },
    {
      "subtitle_id": 27,
      "start": 57.719,
      "end": 61.44,
      "text": "बिगनर स्टॉक मार्केट फॉर इंटरमीडिएट"
    },
    {
      "subtitle_id": 28,
      "start": 59.559,
      "end": 63.68,
      "text": "वैल्यू व इन्वेस्टिंग बेसिक्स ऑफ फ्यूचर"
    },
    {
      "subtitle_id": 29,
      "start": 61.44,
      "end": 65.439,
      "text": "ऑप्शन बेसिक्स ऑफ टेक्निकल एनालिसिस और द"
    },
    {
      "subtitle_id": 30,
      "start": 63.68,
      "end": 67.6,
      "text": "कंप्लीट गाइड टू म्यूचुअल फंड ये छह"
    },
    {
      "subtitle_id": 31,
      "start": 65.439,
      "end": 69.24,
      "text": "एनिमेटेड कोर्सेस फ्री में मिलेंगे इन"
    },
    {
      "subtitle_id": 32,
      "start": 67.6,
      "end": 70.88,
      "text": "कोर्सेस को आप तक फ्री में लाने के लिए"
    },
    {
      "subtitle_id": 33,
      "start": 69.24,
      "end": 72.92,
      "text": "हमने कुछ कंपनी से टाई अप किया है जिसकी"
    },
    {
      "subtitle_id": 34,
      "start": 70.88,
      "end": 74.56,
      "text": "वजह से ये पॉसिबल हो पाया है इसे पाने के"
    },
    {
      "subtitle_id": 35,
      "start": 72.92,
      "end": 76.52,
      "text": "लिए सिर्फ आपको एक सिंपल सी स्टेप फॉलो"
    },
    {
      "subtitle_id": 36,
      "start": 74.56,
      "end": 78.0,
      "text": "करनी है नीचे दिए गए स्टॉक ब्रोकर्स में"
    },
    {
      "subtitle_id": 37,
      "start": 76.52,
      "end": 80.04,
      "text": "से किसी भी एक स्टॉक ब्रोकर के साथ आपको"
    },
    {
      "subtitle_id": 38,
      "start": 78.0,
      "end": 82.24,
      "text": "यहां पर फ्री डीमेट अकाउंट ओपन करना है और"
    },
    {
      "subtitle_id": 39,
      "start": 80.04,
      "end": 84.72,
      "text": "उसके बाद 48 आवर्स के अंदर यह कोर्स आपको"
    },
    {
      "subtitle_id": 40,
      "start": 82.24,
      "end": 86.32,
      "text": "मिल जाएगा अकाउंट ओपन करने के बाद आपको इन"
    },
    {
      "subtitle_id": 41,
      "start": 84.72,
      "end": 88.88,
      "text": "दो नंबर्स पर"
    },
    {
      "subtitle_id": 42,
      "start": 86.32,
      "end": 90.92,
      "text": "whatsapp2 आवर्स के अंदर ही आपको कोर्स का"
    },
    {
      "subtitle_id": 43,
      "start": 88.88,
      "end": 92.479,
      "text": "एक्सेस मिल जाएगा और यह जो हमारे कोर्सेस"
    },
    {
      "subtitle_id": 44,
      "start": 90.92,
      "end": 94.96,
      "text": "हैं यह स्पेशली क्यूरेटेड एनिमेटेड"
    },
    {
      "subtitle_id": 45,
      "start": 92.479,
      "end": 96.56,
      "text": "कोर्सेस हैं और यह कोर्सेस हमारे फाउंडेशन"
    },
    {
      "subtitle_id": 46,
      "start": 94.96,
      "end": 98.439,
      "text": "कोर्स ऑन स्टॉक मार्केट और द कंप्लीट"
    },
    {
      "subtitle_id": 47,
      "start": 96.56,
      "end": 100.36,
      "text": "फंडामेंटल एनालिसिस कोर्स से अलग है जो"
    },
    {
      "subtitle_id": 48,
      "start": 98.439,
      "end": 102.04,
      "text": "आपको बहुत आसानी से सारे कांसेप्ट समझा"
    },
    {
      "subtitle_id": 49,
      "start": 100.36,
      "end": 103.6,
      "text": "देंगे जिससे आप बड़ी आसानी से शेयर"
    },
    {
      "subtitle_id": 50,
      "start": 102.04,
      "end": 105.64,
      "text": "मार्केट हो या फिर म्यूचुअल फंड सीख"
    },
    {
      "subtitle_id": 51,
      "start": 103.6,
      "end": 107.68,
      "text": "पाएंगे यह ऑफर बहुत ही लिमिटेड टाइम के"
    },
    {
      "subtitle_id": 52,
      "start": 105.64,
      "end": 109.52,
      "text": "लिए है तो आज ही इसके लिए प्रोसीड कीजिए"
    },
    {
      "subtitle_id": 53,
      "start": 107.68,
      "end": 111.36,
      "text": "चलिए अब आगे बढ़ते हैं देखिए जो इलेक्शन"
    },
    {
      "subtitle_id": 54,
      "start": 109.52,
      "end": 113.88,
      "text": "ईयर के जो बजट होते हैं वो फुल फ्लेजेन"
    },
    {
      "subtitle_id": 55,
      "start": 111.36,
      "end": 115.719,
      "text": "बजट नहीं होते हैं उसे इंटरम बजट कहा जाता"
    },
    {
      "subtitle_id": 56,
      "start": 113.88,
      "end": 117.56,
      "text": "है और जो फुल फ्लेज बजट होता है वो"
    },
    {
      "subtitle_id": 57,
      "start": 115.719,
      "end": 120.56,
      "text": "इलेक्शन के बाद इलेक्शन रिजल्ट के बाद आता"
    },
    {
      "subtitle_id": 58,
      "start": 117.56,
      "end": 122.52,
      "text": "है तो 201920 का जो इलेक्शन के पहले का"
    },
    {
      "subtitle_id": 59,
      "start": 120.56,
      "end": 125.6,
      "text": "इंटरम बजट आया था उसे रिप्रेजेंट किया था"
    },
    {
      "subtitle_id": 60,
      "start": 122.52,
      "end": 127.399,
      "text": "मिस्टर पियूष गोयल ने 1 फरवरी 2019 को अब"
    },
    {
      "subtitle_id": 61,
      "start": 125.6,
      "end": 129.239,
      "text": "इस बजट में उन्होंने किन सेक्टर्स पर फोकस"
    },
    {
      "subtitle_id": 62,
      "start": 127.399,
      "end": 131.08,
      "text": "किया वो मैं थोड़ा आपको बाद में बताता हूं"
    },
    {
      "subtitle_id": 63,
      "start": 129.239,
      "end": 133.92,
      "text": "पहले मार्केट ने इसको कैसे रिएक्ट किया ये"
    },
    {
      "subtitle_id": 64,
      "start": 131.08,
      "end": 136.0,
      "text": "देख लेते हैं तो 201920 का जो बजट था उसे"
    },
    {
      "subtitle_id": 65,
      "start": 133.92,
      "end": 138.64,
      "text": "मार्केट ने बहुत पॉजिटिवली रिएक्ट किया था"
    },
    {
      "subtitle_id": 66,
      "start": 136.0,
      "end": 140.72,
      "text": "और मार्केट बजट के दिन काफी बढ़ गया उसके"
    },
    {
      "subtitle_id": 67,
      "start": 138.64,
      "end": 143.08,
      "text": "बाद अगले तीन-चार दिनों तक मार्केट लगातार"
    },
    {
      "subtitle_id": 68,
      "start": 140.72,
      "end": 145.2,
      "text": "बढ़ता चला गया अब बढ़ते हैं 2014 के"
    },
    {
      "subtitle_id": 69,
      "start": 143.08,
      "end": 147.08,
      "text": "इलेक्शन के पहले के इंटरम बजट की तरफ कि"
    },
    {
      "subtitle_id": 70,
      "start": 145.2,
      "end": 150.599,
      "text": "क्या यहां पर भी सेम ही हुआ था तो मिस्टर"
    },
    {
      "subtitle_id": 71,
      "start": 147.08,
      "end": 152.72,
      "text": "पी चिदंबरम ने 17 फरवरी 2014 को यह बजट"
    },
    {
      "subtitle_id": 72,
      "start": 150.599,
      "end": 154.4,
      "text": "पेश किया था तो यहां पर भी कुछ सिमिलर"
    },
    {
      "subtitle_id": 73,
      "start": 152.72,
      "end": 155.959,
      "text": "चीजें हमें देखने मिली कि बजट के दिन"
    },
    {
      "subtitle_id": 74,
      "start": 154.4,
      "end": 157.8,
      "text": "मार्केट बढ़ गया और उसके अगले दो-चार"
    },
    {
      "subtitle_id": 75,
      "start": 155.959,
      "end": 160.36,
      "text": "दिनों तक मार्केट काफी अच्छा बढ़ गया"
    },
    {
      "subtitle_id": 76,
      "start": 157.8,
      "end": 162.959,
      "text": "लेकिन वही पर अगर हम 2019 के इंटरम बजट की"
    },
    {
      "subtitle_id": 77,
      "start": 160.36,
      "end": 165.239,
      "text": "बात करें जैसे मिस्टर प्रणव मुखर्जी ने 16"
    },
    {
      "subtitle_id": 78,
      "start": 162.959,
      "end": 167.72,
      "text": "फरवरी 2009 को रिप्रेजेंट किया था तो"
    },
    {
      "subtitle_id": 79,
      "start": 165.239,
      "end": 169.68,
      "text": "चीजें यहां पर थोड़ी अलग है यहां पर बजट"
    },
    {
      "subtitle_id": 80,
      "start": 167.72,
      "end": 172.08,
      "text": "के दिन ही 3 पर से ज्यादा मार्केट गिर गया"
