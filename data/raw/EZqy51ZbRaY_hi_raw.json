  "segments": [
    {
      "subtitle_id": 1,
      "start": 2.96,
      "end": 8.24,
      "text": "अंग्रेजी में एक कहावत है कि द हाउस ऑलवेज"
    },
    {
      "subtitle_id": 2,
      "start": 5.92,
      "end": 10.48,
      "text": "विंस। मतलब कसीनो में चाहे कुछ लोग पैसे"
    },
    {
      "subtitle_id": 3,
      "start": 8.24,
      "end": 13.44,
      "text": "जीत भी जाए लेकिन एंड में सबसे ज्यादा"
    },
    {
      "subtitle_id": 4,
      "start": 10.48,
      "end": 15.28,
      "text": "पैसा कसीनo का ओनर ही कमाता है। सिमिलरली"
    },
    {
      "subtitle_id": 5,
      "start": 13.44,
      "end": 17.279,
      "text": "स्टॉक मार्केट के फ्यूचर्स एंड ऑप्शंस में"
    },
    {
      "subtitle_id": 6,
      "start": 15.28,
      "end": 19.6,
      "text": "भी सेम चीज होती हुई दिखाई दे रही है।"
    },
    {
      "subtitle_id": 7,
      "start": 17.279,
      "end": 21.68,
      "text": "रिटेल ट्रेडर्स आते हैं, लिवरेज लेते हैं,"
    },
    {
      "subtitle_id": 8,
      "start": 19.6,
      "end": 24.16,
      "text": "एक्सपायरी पर बेड्स लगाते हैं। कुछ लोग"
    },
    {
      "subtitle_id": 9,
      "start": 21.68,
      "end": 26.4,
      "text": "इसमें जीत जाते हैं तो 90% से भी ज्यादा"
    },
    {
      "subtitle_id": 10,
      "start": 24.16,
      "end": 29.119,
      "text": "लोग पैसा गवा देते हैं। लेकिन यहां पर कोई"
    },
    {
      "subtitle_id": 11,
      "start": 26.4,
      "end": 31.119,
      "text": "भी जीते या हारे एक बिजनेस ऐसा है जिससे"
    },
    {
      "subtitle_id": 12,
      "start": 29.119,
      "end": 34.16,
      "text": "इस पूरी चीज का बहुत ज्यादा फायदा मिलता"
    },
    {
      "subtitle_id": 13,
      "start": 31.119,
      "end": 37.28,
      "text": "है और वो है स्टॉक एक्सचेंज बिनेस जैसे कि"
    },
    {
      "subtitle_id": 14,
      "start": 34.16,
      "end": 39.76,
      "text": "बीएसई। कोई फर्क नहीं पड़ता। भले ही 99%"
    },
    {
      "subtitle_id": 15,
      "start": 37.28,
      "end": 42.16,
      "text": "लोग पैसा गवाए। बीएसई स्टिल मेक्स अ लॉट"
    },
    {
      "subtitle_id": 16,
      "start": 39.76,
      "end": 44.719,
      "text": "ऑफ़ मनी। और यही कारण है कि जहां सेंसेक्स"
    },
    {
      "subtitle_id": 17,
      "start": 42.16,
      "end": 46.64,
      "text": "ने लास्ट 5 सालों में 8.5% का सीएजीआर"
    },
    {
      "subtitle_id": 18,
      "start": 44.719,
      "end": 48.64,
      "text": "रिटर्न दिया है, वहीं बीएसई ने क्या आप"
    },
    {
      "subtitle_id": 19,
      "start": 46.64,
      "end": 52.0,
      "text": "गेस कर सकते हो कितना पैसा बना है पिछले 5"
    },
    {
      "subtitle_id": 20,
      "start": 48.64,
      "end": 53.68,
      "text": "सालों में? कंपाउंडेड सालाना ₹19% का। मैं"
    },
    {
      "subtitle_id": 21,
      "start": 52.0,
      "end": 55.44,
      "text": "सीएजीआर रिटर्न्स की बात कर रहा हूं। इसे"
    },
    {
      "subtitle_id": 22,
      "start": 53.68,
      "end": 57.68,
      "text": "आसान भाषा में अगर समझाऊं तो अगर आप ₹1"
    },
    {
      "subtitle_id": 23,
      "start": 55.44,
      "end": 61.039,
      "text": "लाख स्टॉक में इन्वेस्ट करते 5 साल पहले"
    },
    {
      "subtitle_id": 24,
      "start": 57.68,
      "end": 63.199,
      "text": "तो वो बन जाते सीधे ₹50 लाख। ₹1 लाख के 50"
    },
    {
      "subtitle_id": 25,
      "start": 61.039,
      "end": 65.119,
      "text": "लाख 5 साल में। और अगर आप ₹2 लाख इन्वेस्ट"
    },
    {
      "subtitle_id": 26,
      "start": 63.199,
      "end": 67.28,
      "text": "करते हो तो सीधा करोड़पति बन जाते और"
    },
    {
      "subtitle_id": 27,
      "start": 65.119,
      "end": 69.439,
      "text": "पिछले कुछ समय से यह स्टॉक लगातार ऊपर जा"
    },
    {
      "subtitle_id": 28,
      "start": 67.28,
      "end": 71.52,
      "text": "रहा है। पिछले 1 महीने में यहां पर 20% से"
    },
    {
      "subtitle_id": 29,
      "start": 69.439,
      "end": 73.28,
      "text": "भी ज्यादा की तेजी नजर आई है। जिसके चलते"
    },
    {
      "subtitle_id": 30,
      "start": 71.52,
      "end": 74.88,
      "text": "बहुत सारे लोग जानना चाहते हैं कि आखिर"
    },
    {
      "subtitle_id": 31,
      "start": 73.28,
      "end": 76.799,
      "text": "ऐसा बीएसई के साथ क्या हो रहा है जिसके"
    },
    {
      "subtitle_id": 32,
      "start": 74.88,
      "end": 78.799,
      "text": "चलते उसकी शेयर प्राइस इतनी तेजी से बढ़"
    },
    {
      "subtitle_id": 33,
      "start": 76.799,
      "end": 80.64,
      "text": "रही है। और दूसरा क्या बीएसई आने वाले"
    },
    {
      "subtitle_id": 34,
      "start": 78.799,
      "end": 82.56,
      "text": "टाइम में भी इतनी तेजी से ऊपर जाएगा? और"
    },
    {
      "subtitle_id": 35,
      "start": 80.64,
      "end": 84.64,
      "text": "क्या अगर हम आज ₹1 लाख इन्वेस्ट करते हैं"
    },
    {
      "subtitle_id": 36,
      "start": 82.56,
      "end": 86.56,
      "text": "बीएसई में तो 5 साल में भी बीएसई इसी तरह"
    },
    {
      "subtitle_id": 37,
      "start": 84.64,
      "end": 88.56,
      "text": "के रिटर्न्स देगा जैसे पिछले 5 सालों में"
    },
    {
      "subtitle_id": 38,
      "start": 86.56,
      "end": 90.479,
      "text": "दिए हैं। सारे सवालों के जवाब आपको"
    },
    {
      "subtitle_id": 39,
      "start": 88.56,
      "end": 91.92,
      "text": "मिलेंगे आज के इस वीडियो में। नमस्कार,"
    },
    {
      "subtitle_id": 40,
      "start": 90.479,
      "end": 94.0,
      "text": "मैं प्रसाद आपका आज के इस वीडियो में"
    },
    {
      "subtitle_id": 41,
      "start": 91.92,
      "end": 95.759,
      "text": "स्वागत करता हूं। अब सबसे पहले बात करते"
    },
    {
      "subtitle_id": 42,
      "start": 94.0,
      "end": 97.439,
      "text": "हैं रिसेंट प्राइस ग्रोथ की। तो देखिए"
    },
    {
      "subtitle_id": 43,
      "start": 95.759,
      "end": 99.28,
      "text": "शेयर प्राइस में ये जो रिसेंट ग्रोथ दिखाई"
    },
    {
      "subtitle_id": 44,
      "start": 97.439,
      "end": 101.92,
      "text": "दे रही है, यह आई है क्वार्टर 4 के"
    },
    {
      "subtitle_id": 45,
      "start": 99.28,
      "end": 104.56,
      "text": "रिजल्ट्स के बाद। मार्च 2026 क्वार्टर के"
    },
    {
      "subtitle_id": 46,
      "start": 101.92,
      "end": 106.56,
      "text": "रेवेन्यू की बात करें तो वो तकरीबन 85% से"
    },
    {
      "subtitle_id": 47,
      "start": 104.56,
      "end": 108.479,
      "text": "बढ़ा है ईयर ऑन ईयर। वहीं पर प्रॉफिट"
    },
    {
      "subtitle_id": 48,
      "start": 106.56,
      "end": 111.84,
      "text": "आफ्टर टैक्स यानी पैट की बात करें तो वो"
    },
    {
      "subtitle_id": 49,
      "start": 108.479,
      "end": 114.72,
      "text": "भी 795 करोड़ तक पहुंच गया है फ्रॉम 494"
    },
    {
      "subtitle_id": 50,
      "start": 111.84,
      "end": 116.88,
      "text": "करोड़। यानी यहां पर अभी ईयर ऑन ईयर 60%"
    },
    {
      "subtitle_id": 51,
      "start": 114.72,
      "end": 119.28,
      "text": "की ग्रोथ। और फिलहाल देखा जाए तो कंपनी की"
    },
    {
      "subtitle_id": 52,
      "start": 116.88,
      "end": 120.719,
      "text": "शेयर प्राइस पल-पल बढ़ती जा रही है। फिर"
    },
    {
      "subtitle_id": 53,
      "start": 119.28,
      "end": 123.2,
      "text": "एक सवाल तो दिमाग में आ ही जाता है कि"
    },
    {
      "subtitle_id": 54,
      "start": 120.719,
      "end": 125.119,
      "text": "पिछले एक साल में सेंसेक्स 9% नेगेटिव में"
    },
    {
      "subtitle_id": 55,
      "start": 123.2,
      "end": 127.119,
      "text": "है। पिछले 2ाई साल से शेयर मार्केट"
    },
    {
      "subtitle_id": 56,
      "start": 125.119,
      "end": 128.72,
      "text": "डायरेक्टली फ्लैट है। वहां पर बीएसई में"
    },
    {
      "subtitle_id": 57,
      "start": 127.119,
      "end": 130.479,
      "text": "ऐसा क्या हो रहा है? जहां पर इकॉनमी"
    },
    {
      "subtitle_id": 58,
      "start": 128.72,
      "end": 132.319,
      "text": "प्रॉब्लम में है। एफआईआई मार्केट छोड़कर"
    },
    {
      "subtitle_id": 59,
      "start": 130.479,
      "end": 134.959,
      "text": "जा रहे हैं। स्टॉक मार्केट में लोग आने को"
    },
    {
      "subtitle_id": 60,
      "start": 132.319,
      "end": 137.76,
      "text": "तैयार नहीं है। ऐसे में बीएसई जमकर पैसा"
    },
    {
      "subtitle_id": 61,
      "start": 134.959,
      "end": 139.92,
      "text": "कैसे छाप रही है? और ऐसा वैसा नहीं 70-80%"
    },
    {
      "subtitle_id": 62,
      "start": 137.76,
      "end": 142.0,
      "text": "से अपना बिजनेस ग्रो कर रही है। यह कैसे"
    },
    {
      "subtitle_id": 63,
      "start": 139.92,
      "end": 144.0,
      "text": "हुआ? इसके लिए आपको सबसे पहले गैंबलिंग"
    },
    {
      "subtitle_id": 64,
      "start": 142.0,
      "end": 146.319,
      "text": "करने वाले लोगों की साइकोलॉजी समझनी होगी"
    },
    {
      "subtitle_id": 65,
      "start": 144.0,
      "end": 148.4,
      "text": "कि गैंबलर्स ऑलवेज फाइंड अवे। यानी आप"
    },
    {
      "subtitle_id": 66,
      "start": 146.319,
      "end": 150.72,
      "text": "गैंबलिंग करने वालों को जितना रोकना चाहो"
    },
    {
      "subtitle_id": 67,
      "start": 148.4,
      "end": 152.56,
      "text": "रोको। पर वो कोई ना कोई तरीका निकाल ही"
    },
    {
      "subtitle_id": 68,
      "start": 150.72,
      "end": 154.72,
      "text": "लेते हैं गैंबलिंग करने का। तो देखिए जो"
    },
    {
      "subtitle_id": 69,
      "start": 152.56,
      "end": 156.64,
      "text": "बीएसई और एनएससी है साथ ही कई सारे जो"
    },
    {
      "subtitle_id": 70,
      "start": 154.72,
      "end": 158.72,
      "text": "ब्रोकर्स हैं जैसे कि Zerodha Anjal 1"
    },
    {
      "subtitle_id": 71,
      "start": 156.64,
      "end": 160.16,
      "text": "इनकी ज्यादातर कमाई तब नहीं होती जब आप"
    },
    {
      "subtitle_id": 72,
      "start": 158.72,
      "end": 162.0,
      "text": "लॉन्ग टर्म इन्वेस्टिंग करते हो या"
    },
    {
      "subtitle_id": 73,
      "start": 160.16,
      "end": 165.28,
      "text": "म्यूच्यूल फंड में एसआईपी करते हो तो।"
    },
    {
      "subtitle_id": 74,
      "start": 162.0,
      "end": 167.599,
      "text": "इनकी मेजोरिटी यानी करीबन 70- 80% कमाई तब"
    },
    {
      "subtitle_id": 75,
      "start": 165.28,
      "end": 169.28,
      "text": "होती है जब आप फ्यूचर्स एंड ऑप्शंस में"
    },
    {
      "subtitle_id": 76,
      "start": 167.599,
      "end": 171.04,
      "text": "ट्रेड करते हो। यानी इनकी मेन कमाई"
    },
    {
      "subtitle_id": 77,
      "start": 169.28,
      "end": 172.4,
      "text": "ट्रेडिंग से है। जबकि हमें यह क्लियरली"
    },
    {
      "subtitle_id": 78,
      "start": 171.04,
      "end": 175.04,
      "text": "पता है कि मेजॉरिटी ऑफ ट्रेडर्स"
    },
    {
      "subtitle_id": 79,
      "start": 172.4,
      "end": 177.12,
      "text": "प्रिसाइजली 93% ट्रेडर्स मार्केट में पैसा"
    },
    {
      "subtitle_id": 80,
      "start": 175.04,
      "end": 178.959,
      "text": "खोते ही खोते हैं। और यहीं पर ट्रेडिंग से"
    },
    {
      "subtitle_id": 81,
      "start": 177.12,
      "end": 181.44,
      "text": "कंसिस्टेंट पैसा सबसे ज्यादा कौन कमाता"
    },
    {
      "subtitle_id": 82,
      "start": 178.959,
      "end": 183.599,
      "text": "है? तो एक्सचेंजेस और ब्रोकर्स। और इसीलिए"
    },
    {
      "subtitle_id": 83,
      "start": 181.44,
      "end": 185.28,
      "text": "फिनोवेशंस हमेशा अवेयरनेस पर काम कर रहा"
    },
    {
      "subtitle_id": 84,
      "start": 183.599,
      "end": 187.12,
      "text": "है कि ज्यादा से ज्यादा लोगों को लॉन्ग"
    },
    {
      "subtitle_id": 85,
      "start": 185.28,
      "end": 188.64,
      "text": "टर्म इन्वेस्टिंग की तरफ लेकर आओ। लेकिन"
    },
    {
      "subtitle_id": 86,
      "start": 187.12,
      "end": 190.159,
      "text": "फिर रियलिटी यह भी है कि लॉन्ग टर्म"
    },
    {
      "subtitle_id": 87,
      "start": 188.64,
      "end": 191.84,
      "text": "इन्वेस्टिंग सुनने में जितनी आसान लगती"
    },
    {
      "subtitle_id": 88,
      "start": 190.159,
      "end": 193.76,
      "text": "है, उतनी होती नहीं है। क्योंकि कंपनी"
    },
    {
      "subtitle_id": 89,
      "start": 191.84,
      "end": 195.84,
      "text": "एनालाइज करते वक्त बहुत सारी चीजें देखनी"
    },
    {
      "subtitle_id": 90,
      "start": 193.76,
      "end": 197.92,
      "text": "पड़ती है। मैनेजमेंट कैसा है? कोई रेड"
    },
    {
      "subtitle_id": 91,
      "start": 195.84,
      "end": 199.68,
      "text": "फ्लैग तो नहीं है? ग्रोथ सस्टेनेबल है या"
    },
    {
      "subtitle_id": 92,
      "start": 197.92,
      "end": 201.36,
      "text": "नहीं? फ्यूचर अपोरर्चुनिटीज कैसी है?"
    },
    {
      "subtitle_id": 93,
      "start": 199.68,
      "end": 203.36,
      "text": "वैल्यू्यूएशन अट्रैक्टिव है या नहीं?"
    },
    {
      "subtitle_id": 94,
      "start": 201.36,
      "end": 205.84,
      "text": "लेकिन यह सारा काम टाइम कंज्यूमिंग भी है"
    },
    {
      "subtitle_id": 95,
      "start": 203.36,
      "end": 207.92,
      "text": "और ट्रिकी भी। कई बार अपने ऑफिस, बिजनेस"
    },
    {
      "subtitle_id": 96,
      "start": 205.84,
      "end": 210.0,
      "text": "या स्टडीज की वजह से लोग प्रॉपर्ली रिसर्च"
    },
    {
      "subtitle_id": 97,
      "start": 207.92,
      "end": 211.92,
      "text": "नहीं कर पाते और फिर सिर्फ ऊपर ऊपर से"
    },
    {
      "subtitle_id": 98,
      "start": 210.0,
      "end": 213.599,
      "text": "नंबर्स देखकर इन्वेस्ट करते हैं। इसी"
    },
    {
      "subtitle_id": 99,
      "start": 211.92,
      "end": 215.84,
      "text": "प्रॉब्लम को सॉल्व करने के लिए हमने ल्च"
    },
    {
      "subtitle_id": 100,
      "start": 213.599,
      "end": 218.0,
      "text": "किया है ekhi pro। यहां रिसर्च का काम"
    },
    {
      "subtitle_id": 101,
      "start": 215.84,
      "end": 220.08,
      "text": "हमारा और फाइनल इन्वेस्टिंग डिसीजन आपका।"
    },
    {
      "subtitle_id": 102,
      "start": 218.0,
      "end": 222.0,
      "text": "हर महीने हम आपके लिए वेल रिसर्च स्टॉक"
    },
    {
      "subtitle_id": 103,
      "start": 220.08,
      "end": 223.28,
      "text": "आइडेंटिफाई करेंगे और अगर मार्केट में"
    },
    {
      "subtitle_id": 104,
      "start": 222.0,
      "end": 225.12,
      "text": "ज्यादा करेक्शन या एक्सेप्शनल"
    },
    {
      "subtitle_id": 105,
      "start": 223.28,
      "end": 226.799,
      "text": "अपॉर्चुनिटीज दिखती है तो कुछ मंथ्स में"
    },
    {
      "subtitle_id": 106,
      "start": 225.12,
      "end": 228.56,
      "text": "आपको हम दो स्टॉक रिसर्च रिपोर्ट्स भी"
    },
    {
      "subtitle_id": 107,
      "start": 226.799,
      "end": 230.319,
      "text": "प्रोवाइड करेंगे। इससे आपकी इन्वेस्टिंग"
    },
    {
      "subtitle_id": 108,
      "start": 228.56,
      "end": 232.239,
      "text": "की जो प्रोसेस है वो काफी सिंपल और टाइम"
    },
    {
      "subtitle_id": 109,
      "start": 230.319,
      "end": 234.08,
      "text": "एफिशिएंट हो जाएगी। और हां हम सेबी"
    },
    {
      "subtitle_id": 110,
      "start": 232.239,
      "end": 236.08,
      "text": "रजिस्टर्ड रिसर्च एनालिस्ट हैं। तो अगर आप"
    },
    {
      "subtitle_id": 111,
      "start": 234.08,
      "end": 238.64,
      "text": "अपना टाइम बचाना चाहते हो और रिसर्च का"
    },
    {
      "subtitle_id": 112,
      "start": 236.08,
      "end": 240.4,
      "text": "काम एक्सपर्ट्स पर छोड़ना चाहते हो तो इका"
    },
    {
      "subtitle_id": 113,
      "start": 238.64,
      "end": 242.0,
      "text": "आपके लिए है। इस कम्युनिटी में दो प्लान्स"
    },
    {
      "subtitle_id": 114,
      "start": 240.4,
      "end": 243.68,
      "text": "हैं सिक्स मंथ्स का और 12 मंथ्स का और"
    },
    {
      "subtitle_id": 115,
      "start": 242.0,
      "end": 245.599,
      "text": "सारे रिकमेंडेशंस और रिसर्च रिपोर्ट्स"
    },
    {
      "subtitle_id": 116,
      "start": 243.68,
      "end": 247.599,
      "text": "आपको WhatsApp के थ्रू मिलेंगे। और फिलहाल"
    },
    {
      "subtitle_id": 117,
      "start": 245.599,
      "end": 249.519,
      "text": "हमारी यहां पर बहुत बड़ी लॉन्च ऑफर चल रही"
    },
    {
      "subtitle_id": 118,
      "start": 247.599,
      "end": 251.04,
      "text": "है जिसका आप जरूर फायदा उठाइए नीचे"
    },
    {
      "subtitle_id": 119,
      "start": 249.519,
      "end": 253.2,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में दिया हुआ"
    },
    {
      "subtitle_id": 120,
      "start": 251.04,
      "end": 254.64,
      "text": "फॉर्म फिल करके जिसके बाद हमारी टीम आपसे"
    },
    {
      "subtitle_id": 121,
      "start": 253.2,
      "end": 256.4,
      "text": "कनेक्ट करके इस ऑफर के बारे में और इस"
    },
    {
      "subtitle_id": 122,
      "start": 254.64,
      "end": 257.84,
      "text": "प्लान के बारे में आपको समझा देगी। हमने"
    },
    {
      "subtitle_id": 123,
      "start": 256.4,
      "end": 259.759,
      "text": "इस कम्युनिटी को अभी रिसेंटली स्टार्ट"
    },
    {
      "subtitle_id": 124,
      "start": 257.84,
      "end": 261.759,
      "text": "किया है और 1000 से ज्यादा लोग ऑलरेडी इस"
    },
    {
      "subtitle_id": 125,
      "start": 259.759,
      "end": 263.68,
      "text": "कम्युनिटी का हिस्सा बन चुके हैं। सो सी"
    },
    {
      "subtitle_id": 126,
      "start": 261.759,
      "end": 265.6,
      "text": "यू देयर इन eksh pro। तो चलिए अब बढ़ते"
    },
    {
      "subtitle_id": 127,
      "start": 263.68,
      "end": 267.6,
      "text": "हैं वीडियो की तरफ। तो एक चीज तो हमें पता"
    },
    {
      "subtitle_id": 128,
      "start": 265.6,
      "end": 269.68,
      "text": "चल गई है कि मार्केट के रिटर्न्स और बीएसई"
    },
    {
      "subtitle_id": 129,
      "start": 267.6,
      "end": 271.52,
      "text": "का रिटर्न कनेक्टेड नहीं है। और एक चीज तो"
    },
    {
      "subtitle_id": 130,
      "start": 269.68,
      "end": 273.12,
      "text": "आपने ऑब्जर्व की होगी कि सेबी और सरकार"
    },
    {
      "subtitle_id": 131,
      "start": 271.52,
      "end": 274.8,
      "text": "लगातार एक चीज ट्राई कर रहे हैं कि"
    },
    {
      "subtitle_id": 132,
      "start": 273.12,
      "end": 276.88,
      "text": "फ्यूचर्स एंड ऑप्शंस की ट्रेडिंग देश में"
    },
    {
      "subtitle_id": 133,
      "start": 274.8,
      "end": 278.72,
      "text": "कम हो। तो ऐसा कैसे हो रहा है कि सेबी एक"
    },
    {
      "subtitle_id": 134,
      "start": 276.88,
      "end": 281.199,
      "text": "तरफ नए-नए रेस्ट्रिकशंस यहां पर लगा रही"
    },
    {
      "subtitle_id": 135,
      "start": 278.72,
      "end": 283.28,
      "text": "है। वहीं दूसरी तरफ बीएसई जो मेजॉरिटी"
    },
    {
      "subtitle_id": 136,
      "start": 281.199,
      "end": 285.6,
      "text": "पैसा फ्यूचर्स एंड ऑप्शन से कमाती है वो"
    },
    {
      "subtitle_id": 137,
      "start": 283.28,
      "end": 287.52,
      "text": "ऑल टाइम हाई प्रॉफिट बुक कर रही है। तो सच"
    },
    {
      "subtitle_id": 138,
      "start": 285.6,
      "end": 289.6,
      "text": "क्या है? तो सच यह है कि गैंबलिंग करने"
    },
    {
      "subtitle_id": 139,
      "start": 287.52,
      "end": 291.68,
      "text": "वाले हमेशा रास्ता निकालते हैं। कैसा"
    },
    {
      "subtitle_id": 140,
      "start": 289.6,
      "end": 293.52,
      "text": "रास्ता निकालते हैं? बताता हूं। तो देखिए"
    },
    {
      "subtitle_id": 141,
      "start": 291.68,
      "end": 296.08,
      "text": "बहुत सारे रिटेलर्स को लॉस हो रहा है। यह"
    },
    {
      "subtitle_id": 142,
      "start": 293.52,
      "end": 297.919,
      "text": "कहकर सेबी और सरकार बीच में आती है। नए-नए"
    },
    {
      "subtitle_id": 143,
      "start": 296.08,
      "end": 300.24,
      "text": "रूल्स लाती है। जैसे कि ओनली वन वीक"
    },
    {
      "subtitle_id": 144,
      "start": 297.919,
      "end": 302.479,
      "text": "एक्सपायरी अलाउड पर एक्सचेंज। लॉट साइज भी"
    },
    {
      "subtitle_id": 145,
      "start": 300.24,
      "end": 304.72,
      "text": "बढ़ा देते हैं। हायर मार्जिन ऑन एक्सपायरी"
    },
    {
      "subtitle_id": 146,
      "start": 302.479,
      "end": 306.639,
      "text": "डे और बाकी कई सारे टैक्सेस भी यहां पर हर"
    },
    {
      "subtitle_id": 147,
      "start": 304.72,
      "end": 308.32,
      "text": "साल लगाए जा रहे हैं। और इस चीज का सबसे"
    },
    {
      "subtitle_id": 148,
      "start": 306.639,
      "end": 311.28,
      "text": "ज्यादा फायदा पता है किसे हुआ? एनएससी"
    },
    {
      "subtitle_id": 149,
      "start": 308.32,
      "end": 313.36,
      "text": "बीएसई दोनों को नहीं सिर्फ बीएसई को। कैसे"
    },
    {
      "subtitle_id": 150,
      "start": 311.28,
      "end": 315.199,
      "text": "बताता हूं। तो देखिए इंडिया का ऑलमोस्ट"
    },
    {
      "subtitle_id": 151,
      "start": 313.36,
      "end": 317.44,
      "text": "पूरा का पूरा फीचर्स ऑन ऑप्शंस मार्केट"
    },
    {
      "subtitle_id": 152,
      "start": 315.199,
      "end": 319.36,
      "text": "एनएससी डोमिनेट कर रही थी। निफ्टी और बैंक"
    },
    {
      "subtitle_id": 153,
      "start": 317.44,
      "end": 321.28,
      "text": "निफ्टी ऑप्शंस इनकी मनोपली मार्केट में चल"
    },
    {
      "subtitle_id": 154,
      "start": 319.36,
      "end": 323.199,
      "text": "रही थी। बीएसई का जो डेरिवेटिव्स बिजनेस"
    },
    {
      "subtitle_id": 155,
      "start": 321.28,
      "end": 325.44,
      "text": "का पोर्शन था वो ऑलमोस्ट निल था ज़ीरो था।"
    },
    {
      "subtitle_id": 156,
      "start": 323.199,
      "end": 327.759,
      "text": "मोस्ट ट्रेडर्स एनएससी ही प्रेफर करते थे।"
    },
    {
      "subtitle_id": 157,
      "start": 325.44,
      "end": 330.08,
      "text": "लेकिन जब यह नए रूल्स आए जैसे कि ओनली वन"
    },
    {
      "subtitle_id": 158,
      "start": 327.759,
      "end": 332.16,
      "text": "वीकली एक्सपायरी अलाउड पर एक्सचेंज तो इस"
    },
    {
      "subtitle_id": 159,
      "start": 330.08,
      "end": 334.24,
      "text": "एक रूल का सबसे ज्यादा फायदा हुआ बीएसई"
    },
    {
      "subtitle_id": 160,
      "start": 332.16,
      "end": 336.24,
      "text": "को। क्योंकि बीएसई के पास कुछ खोने को तो"
    },
    {
      "subtitle_id": 161,
      "start": 334.24,
      "end": 338.4,
      "text": "नहीं था लेकिन पाने के लिए बहुत कुछ था।"
    },
    {
      "subtitle_id": 162,
      "start": 336.24,
      "end": 340.639,
      "text": "जबकि एनएससी मल्टीपल वीकली ऑप्शन से पैसा"
    },
    {
      "subtitle_id": 163,
      "start": 338.4,
      "end": 342.96,
      "text": "बना रही थी। जैसे कि मंडे मिड कैप निफ्टी"
    },
    {
      "subtitle_id": 164,
      "start": 340.639,
      "end": 344.8,
      "text": "एक्सपायरी, ट्यूसडे फिन निफ्टी एक्सपायरी,"
    },
    {
      "subtitle_id": 165,
      "start": 342.96,
      "end": 346.88,
      "text": "वेडनेसडे बैंक निफ्टी की एक्सपायरी और"
    },
    {
      "subtitle_id": 166,
      "start": 344.8,
      "end": 348.479,
      "text": "थर्सडे निफ्टी की एक्सपायरी। तो इस रूल के"
    },
    {
      "subtitle_id": 167,
      "start": 346.88,
      "end": 350.32,
      "text": "बाद दोनों एक्सचेंजेस को एक ही वीकली"
    },
    {
      "subtitle_id": 168,
      "start": 348.479,
      "end": 352.639,
      "text": "एक्सपायरी इंडेक्स अलाउड था और वह भी या"
    },
    {
      "subtitle_id": 169,
      "start": 350.32,
      "end": 354.4,
      "text": "तो ट्यूसडे या फिर थर्सडे। तो एनएससी ने"
    },
    {
      "subtitle_id": 170,
      "start": 352.639,
      "end": 356.479,
      "text": "निफ्ट्टी 50 इंडेक्स को चुना जिसकी"
    },
    {
      "subtitle_id": 171,
      "start": 354.4,
      "end": 358.479,
      "text": "एक्सपायरी थर्सडे को थी और बीएसई ने"
    },
    {
      "subtitle_id": 172,
      "start": 356.479,
      "end": 360.08,
      "text": "ससेक्स को चुना जिसकी एक्सपायरी ट्यूसडे"
    },
    {
      "subtitle_id": 173,
      "start": 358.479,
      "end": 362.08,
      "text": "को थी। अब ज्यादातर ट्रेडिंग तो पहले"
    },
    {
      "subtitle_id": 174,
      "start": 360.08,
      "end": 363.919,
      "text": "एनएससी पर होती थी लेकिन अब सिर्फ एक ही"
    },
    {
      "subtitle_id": 175,
      "start": 362.08,
      "end": 365.919,
      "text": "इंडेक्स था एनएससी पर। तो जो ट्रेडिंग"
    },
    {
      "subtitle_id": 176,
      "start": 363.919,
      "end": 367.759,
      "text": "करने वाले थे वो तो रुकने वाले नहीं थे।"
    },
    {
      "subtitle_id": 177,
      "start": 365.919,
      "end": 369.28,
      "text": "ऊपर से बीएसई भी अपने ससेक्स वीकली"
    },
    {
      "subtitle_id": 178,
      "start": 367.759,
      "end": 371.52,
      "text": "एक्सपायरी कॉन्ट्रैक्ट्स को अग्रेसिवली"
    },
    {
      "subtitle_id": 179,
      "start": 369.28,
      "end": 373.52,
      "text": "पुश करने लगे। रिटेलर्स भी जो बैंक निफ्टी"
    },
    {
      "subtitle_id": 180,
      "start": 371.52,
      "end": 375.36,
      "text": "वीकली पर ट्रेड कर रहे थे उसमें से बहुत"
    },
    {
      "subtitle_id": 181,
      "start": 373.52,
      "end": 377.199,
      "text": "सारे लोग बीएसई की तरफ शिफ्ट हो गए"
    },
    {
      "subtitle_id": 182,
      "start": 375.36,
      "end": 379.28,
      "text": "क्योंकि यहां पर रिटेलर्स छोटे से अमाउंट"
    },
    {
      "subtitle_id": 183,
      "start": 377.199,
      "end": 381.44,
      "text": "से भी ट्रेड कर सकते थे और इस अग्रेशन का"
    },
    {
      "subtitle_id": 184,
      "start": 379.28,
      "end": 384.4,
      "text": "असर दिख भी रहा है। नोशनल फ्यूचर्स एंड"
    },
    {
      "subtitle_id": 185,
      "start": 381.44,
      "end": 386.72,
      "text": "ऑप्शन टर्नओवर में बीएसई ऑलरेडी 55%"
    },
    {
      "subtitle_id": 186,
      "start": 384.4,
      "end": 388.8,
      "text": "मार्केट शेयर लेके एनएससी से भी आगे बढ़"
    },
    {
      "subtitle_id": 187,
      "start": 386.72,
      "end": 390.96,
      "text": "चुका है। और सबसे शॉकिंग पार्ट इन जस्ट"
    },
    {
      "subtitle_id": 188,
      "start": 388.8,
      "end": 394.479,
      "text": "थ्री इयर्स सेंसेक्स का ऑप्शंस प्रीमियम"
    },
    {
      "subtitle_id": 189,
      "start": 390.96,
      "end": 396.4,
      "text": "टर्नओवर 2 करोड़ से 33000 करोड़ पर चला"
    },
    {
      "subtitle_id": 190,
      "start": 394.479,
      "end": 398.4,
      "text": "गया है। इन शॉर्ट जो रिटेल ट्रेडर्स हैं"
    },
    {
      "subtitle_id": 191,
      "start": 396.4,
      "end": 400.4,
      "text": "वह बीएसए वीकली ऑप्शंस पर हेवीली"
    },
    {
      "subtitle_id": 192,
      "start": 398.4,
      "end": 402.479,
      "text": "स्पेकुलेट कर रहे हैं। बीएसए ने भी एक"
    },
    {
      "subtitle_id": 193,
      "start": 400.4,
      "end": 405.199,
      "text": "बहुत बड़ा एम यहां पर रखा है कि वह 200"
    },
    {
      "subtitle_id": 194,
      "start": 402.479,
      "end": 407.52,
      "text": "ब्रोकर्स और 200 एफपीआई को अगले 5 साल में"
    },
    {
      "subtitle_id": 195,
      "start": 405.199,
      "end": 409.28,
      "text": "ऑनबोर्ड करेंगे। तो जो रूल इन शॉर्ट रिटेल"
    },
    {
      "subtitle_id": 196,
      "start": 407.52,
      "end": 411.6,
      "text": "ट्रेडर्स को रोकने के लिए बनाया गया था"
    },
    {
      "subtitle_id": 197,
      "start": 409.28,
      "end": 413.84,
      "text": "उसका सबसे ज्यादा फायदा बीएसई ने ले लिया।"
    },
    {
      "subtitle_id": 198,
      "start": 411.6,
      "end": 416.4,
      "text": "और यही रीज़न है कि उनका रेवेन्यू फिर 85%"
    },
    {
      "subtitle_id": 199,
      "start": 413.84,
      "end": 418.08,
      "text": "से बढ़ा और प्रॉफिट आफ्टर टैक्स 60% से।"
    },
    {
      "subtitle_id": 200,
      "start": 416.4,
      "end": 420.24,
      "text": "तो यहां पर आपके दिमाग में एक सवाल जरूर"
    },
    {
      "subtitle_id": 201,
      "start": 418.08,
      "end": 422.24,
      "text": "आएगा कि अगर नोशनल फ्यूचर ऑप्शन टर्नओवर"
    },
    {
      "subtitle_id": 202,
      "start": 420.24,
      "end": 423.84,
      "text": "में बीएसई एनएससी से आगे बढ़ चुका है।"
    },
    {
      "subtitle_id": 203,
      "start": 422.24,
      "end": 426.08,
      "text": "रेवेन्यू ग्रोथ और प्रॉफिट भी जबरदस्त"
    },
    {
      "subtitle_id": 204,
      "start": 423.84,
      "end": 428.16,
      "text": "स्पीड से आगे बढ़ रहे हैं तो क्या हम अभी"
    },
    {
      "subtitle_id": 205,
      "start": 426.08,
      "end": 429.84,
      "text": "बीएसई में इन्वेस्ट कर सकते हैं? तो देखिए"
    },
    {
      "subtitle_id": 206,
      "start": 428.16,
      "end": 431.68,
      "text": "आपको बीएसई में इन्वेस्ट करना चाहिए या"
    },
    {
      "subtitle_id": 207,
      "start": 429.84,
      "end": 433.68,
      "text": "फिर नहीं इसके लिए आपको दो चीजें समझनी"
    },
    {
      "subtitle_id": 208,
      "start": 431.68,
      "end": 435.84,
      "text": "होगी। उसके बाद आपको खुद पता चल जाएगा।"
    },
    {
      "subtitle_id": 209,
      "start": 433.68,
      "end": 438.24,
      "text": "पहली कि जस्ट बिकॉज़ नोशनल टर्नओवर में"
    },
    {
      "subtitle_id": 210,
      "start": 435.84,
      "end": 440.0,
      "text": "बीएसई आगे बढ़ गया है एनएससी से। इसका यह"
    },
    {
      "subtitle_id": 211,
      "start": 438.24,
      "end": 442.0,
      "text": "मतलब नहीं है कि BSE एनएससी से ज्यादा"
    },
    {
      "subtitle_id": 212,
      "start": 440.0,
      "end": 444.96,
      "text": "पैसा कमा रहा है। क्योंकि एनएससी स्टिल"
    },
    {
      "subtitle_id": 213,
      "start": 442.0,
      "end": 446.8,
      "text": "होल्ड्स 86.8% ओवरऑल फ्यूचर्स एंड ऑप्शंस"
    },
    {
      "subtitle_id": 214,
      "start": 444.96,
      "end": 448.639,
      "text": "प्रीमियम टर्नओवर शेयर। जिसका मतलब यह है"
    },
    {
      "subtitle_id": 215,
      "start": 446.8,
      "end": 450.72,
      "text": "कि जो रियल प्रीमियम मनी है और सीरियस"
    },
    {
      "subtitle_id": 216,
      "start": 448.639,
      "end": 452.88,
      "text": "लिक्विडिटी है वो अभी भी एनएससी में ही"
    },
    {
      "subtitle_id": 217,
      "start": 450.72,
      "end": 454.88,
      "text": "है। और बीएससी पर जो लोग ज्यादातर ट्रेड"
    },
    {
      "subtitle_id": 218,
      "start": 452.88,
      "end": 456.96,
      "text": "कर रहे हैं वो रिटेलर्स हैं। वही एनएससी"
    },
    {
      "subtitle_id": 219,
      "start": 454.88,
      "end": 459.039,
      "text": "पर बड़ी-बड़ी इंस्टीटशंस, अल्गो ट्रेडर्स"
    },
    {
      "subtitle_id": 220,
      "start": 456.96,
      "end": 461.44,
      "text": "और प्रोफेशनल पार्टिसिपेट करते हैं। और"
    },
    {
      "subtitle_id": 221,
      "start": 459.039,
      "end": 464.479,
      "text": "यही रीजन है कि फाइनेंसियल ईयर 2026 में"
    },
    {
      "subtitle_id": 222,
      "start": 461.44,
      "end": 466.8,
      "text": "बीएसई का प्रॉफिट कितना था? 2487 करोड़"
    },
    {
      "subtitle_id": 223,
      "start": 464.479,
      "end": 469.28,
      "text": "का। आप मुझे बताइए एनएससी का कितना होगा?"
    },
    {
      "subtitle_id": 224,
      "start": 466.8,
      "end": 471.28,
      "text": "10,000 करोड़। अब यह तो हो गई पहली बात।"
    },
    {
      "subtitle_id": 225,
      "start": 469.28,
      "end": 473.28,
      "text": "अब दूसरी बात समझते हैं कि चाहे ब्रोकिंग"
    },
    {
      "subtitle_id": 226,
      "start": 471.28,
      "end": 475.68,
      "text": "बिज़नेस हो या फिर स्टॉक एक्सचेंज।"
    },
    {
      "subtitle_id": 227,
      "start": 473.28,
      "end": 477.759,
      "text": "रेगुलेटर का इन पर बहुत बड़ा प्रभाव होता"
    },
    {
      "subtitle_id": 228,
      "start": 475.68,
      "end": 479.599,
      "text": "है। आज अगर सेबी देखें कि अभी भी रिटेलर्स"
    },
    {
      "subtitle_id": 229,
      "start": 477.759,
      "end": 481.44,
      "text": "फ्यूचर ऑप्शन में हेवीली ट्रेड कर रहे हैं"
    },
    {
      "subtitle_id": 230,
      "start": 479.599,
      "end": 483.52,
      "text": "तो वह और नए रूल्स ला सकते हैं।"
    },
    {
      "subtitle_id": 231,
      "start": 481.44,
      "end": 486.08,
      "text": "कॉन्ट्रैक्ट साइज और बढ़ा सकते हैं जिससे"
    },
    {
      "subtitle_id": 232,
      "start": 483.52,
      "end": 488.479,
      "text": "अगेन एक शिफ्ट आ सकता है। इस बार तो बीएसई"
    },
    {
      "subtitle_id": 233,
      "start": 486.08,
      "end": 490.08,
      "text": "जीती है पर कल कोई नया रूल आया तो कोई और"
    },
    {
      "subtitle_id": 234,
      "start": 488.479,
      "end": 491.68,
      "text": "भी जीत सकता है। और फिलहाल अगर"
    },
    {
      "subtitle_id": 235,
      "start": 490.08,
      "end": 494.16,
      "text": "वैल्यू्यूएशन की बात करें तो वह भी कोई"
    },
    {
      "subtitle_id": 236,
      "start": 491.68,
      "end": 495.919,
      "text": "सस्ता नहीं है। बीएसई फिलहाल 70 के पीई पर"
    },
    {
      "subtitle_id": 237,
      "start": 494.16,
      "end": 497.919,
      "text": "ट्रेड कर रहा है। चारों तरफ बीएसई की"
    },
    {
      "subtitle_id": 238,
      "start": 495.919,
      "end": 499.84,
      "text": "ग्रोथ की बातें हो रही है। ग्रोथ के सपने"
    },
    {
      "subtitle_id": 239,
      "start": 497.919,
      "end": 501.84,
      "text": "दिख रहे हैं। तो जिस सेबी के एक रूल ने"
    },
    {
      "subtitle_id": 240,
      "start": 499.84,
      "end": 504.08,
      "text": "बीएसई को आज एक स्ट्रांग प्लेयर बना दिया"
    },
    {
      "subtitle_id": 241,
      "start": 501.84,
      "end": 506.8,
      "text": "वही हो सकता है कि सेबी का कोई और रूल"
    },
    {
      "subtitle_id": 242,
      "start": 504.08,
      "end": 508.72,
      "text": "बीएसई को कमजोर भी बना दे। तो बीएसई के"
    },
    {
      "subtitle_id": 243,
      "start": 506.8,
      "end": 510.4,
      "text": "पिछले 5 साल की जो ग्रोथ रही है वो आने"
    },
    {
      "subtitle_id": 244,
      "start": 508.72,
      "end": 512.479,
      "text": "वाले 5 सालों में रहेगी कि नहीं रहेगी ये"
    },
    {
      "subtitle_id": 245,
      "start": 510.4,
      "end": 514.56,
      "text": "दो चीजों पर निर्भर है। पहला तो कि सेबी"
    },
    {
      "subtitle_id": 246,
      "start": 512.479,
      "end": 517.36,
      "text": "और सरकार के नए रूल्स सेबी के अगेंस्ट में"
    },
    {
      "subtitle_id": 247,
      "start": 514.56,
      "end": 519.12,
      "text": "ना जाए और दूसरा रिटेलर्स जो कि बीएसई का"
    },
    {
      "subtitle_id": 248,
      "start": 517.36,
      "end": 520.8,
      "text": "सबसे बड़ा क्लाइंट बेस बन रहा है वो"
    },
    {
      "subtitle_id": 249,
      "start": 519.12,
      "end": 522.719,
      "text": "फ्यूचर्स एंड ऑप्शंस में गैंबलिंग करते"
    },
    {
      "subtitle_id": 250,
      "start": 520.8,
      "end": 524.72,
      "text": "रहे। और जैसे कि मैंने आपको अभी बताया कि"
    },
    {
      "subtitle_id": 251,
      "start": 522.719,
      "end": 526.959,
      "text": "प्रीमियम के मामले में अभी भी गेम एनएससी"
    },
    {
      "subtitle_id": 252,
      "start": 524.72,
      "end": 528.32,
      "text": "के पास है। तो वहां से भी बीएसई और कोशिश"
    },
    {
      "subtitle_id": 253,
      "start": 526.959,
      "end": 530.399,
      "text": "करके इंस्टीट्यूशनल इन्वेस्टर्स को"
    },
    {
      "subtitle_id": 254,
      "start": 528.32,
      "end": 532.8,
      "text": "अट्रैक्ट करके अपना बिजनेस बढ़ा सकते हैं।"
    },
    {
      "subtitle_id": 255,
      "start": 530.399,
      "end": 534.48,
      "text": "तो स्कोप बहुत है। दिक्कत बस रेगुलेटर की"
    },
    {
      "subtitle_id": 256,
      "start": 532.8,
      "end": 536.56,
      "text": "है, सरकार की है। और यहां पर तो मुझे"
    },
    {
      "subtitle_id": 257,
      "start": 534.48,
      "end": 538.48,
      "text": "क्लियरली लगता है कि जो रिटेलर्स हैं वो"
    },
    {
      "subtitle_id": 258,
      "start": 536.56,
      "end": 540.08,
      "text": "तो ट्रेडिंग करने से रुकने नहीं वाले। तो"
    },
    {
      "subtitle_id": 259,
      "start": 538.48,
      "end": 541.92,
      "text": "उसके बारे में चिंता करने की आपको जरूरत"
    },
    {
      "subtitle_id": 260,
      "start": 540.08,
      "end": 544.0,
      "text": "नहीं है। इंस्टीट्यूशनल इन्वेस्टर्स को भी"
    },
    {
      "subtitle_id": 261,
      "start": 541.92,
      "end": 546.48,
      "text": "आने वाले टाइम में बीएसई अट्रैक्ट कर सकती"
    },
    {
      "subtitle_id": 262,
      "start": 544.0,
      "end": 549.12,
      "text": "है। लेकिन असली दिक्कत वही है कि अगर सीबी"
    },
    {
      "subtitle_id": 263,
      "start": 546.48,
      "end": 550.88,
      "text": "कोई नया रूल लाती है तो फिर तकलीफ बन सकती"
    },
    {
      "subtitle_id": 264,
      "start": 549.12,
      "end": 552.56,
      "text": "है। तो आई होप बीएसई की केस आपके लिए अब"
    },
    {
      "subtitle_id": 265,
      "start": 550.88,
      "end": 554.32,
      "text": "क्रिस्टल क्लियर है। तो फिलहाल यहीं पर"
    },
    {
      "subtitle_id": 266,
      "start": 552.56,
      "end": 556.16,
      "text": "रुकते हैं। नेक्स्ट वीडियो किस कंपनी पर"
    },
    {
      "subtitle_id": 267,
      "start": 554.32,
      "end": 557.92,
      "text": "बनाएं कमेंट करके जरूर बताइए क्योंकि यह"
    },
    {
      "subtitle_id": 268,
      "start": 556.16,
      "end": 560.399,
      "text": "वीडियो भी आपके रिक्वेस्ट पर ही बनाया गया"
    },
    {
      "subtitle_id": 269,
      "start": 557.92,
      "end": 562.08,
      "text": "है। और जाते-जाते इका की ऑफर को जरूर चेक"
    },
    {
      "subtitle_id": 270,
      "start": 560.399,
      "end": 564.0,
      "text": "आउट कीजिए। लिंक आपको नीचे डिस्क्रिप्शन"
    },
    {
      "subtitle_id": 271,
      "start": 562.08,
      "end": 566.08,
      "text": "और कमेंट बॉक्स में मिल जाएगी। सो सी यू"
    },
    {
      "subtitle_id": 272,
      "start": 564.0,
      "end": 567.68,
      "text": "देर एंड मिलते हैं अगले वीडियो में। और"
    },
    {
      "subtitle_id": 273,
      "start": 566.08,
      "end": 569.839,
      "text": "अगर आपने अब तक सब्सक्राइब नहीं किया है"
    },
    {
      "subtitle_id": 274,
      "start": 567.68,
      "end": 571.839,
      "text": "चैनल को प्लीज सब्सक्राइब क्योंकि इसी तरह"
    },
    {
      "subtitle_id": 275,
      "start": 569.839,
      "end": 573.92,
      "text": "का क्वालिटी कंटेंट और क्वालिटी रिसर्च हम"
    },
    {
      "subtitle_id": 276,
      "start": 571.839,
      "end": 576.0,
      "text": "आसान भाषा में आपके लिए लाते रहते हैं।"
    },
    {
      "subtitle_id": 277,
      "start": 573.92,
      "end": 577.76,
      "text": "एंड यह एक हमारे लिए एक मोटिवेशन भी रहता"
    },
    {
      "subtitle_id": 278,
      "start": 576.0,
      "end": 579.6,
      "text": "है जब आप चैनल को सब्सक्राइब करते हो और"
    },
    {
      "subtitle_id": 279,
      "start": 577.76,
      "end": 581.36,
      "text": "कुछ कमेंट में लिखते हो तो। सब्सक्राइब"
    },
    {
      "subtitle_id": 280,
      "start": 579.6,
      "end": 582.959,
      "text": "जरूर कीजिए और बेल आइकॉन पर भी क्लिक"
    },
    {
      "subtitle_id": 281,
      "start": 581.36,
      "end": 585.12,
      "text": "कीजिए ताकि हमारे हर क्वालिटी वीडियो के"
    },
    {
      "subtitle_id": 282,
      "start": 582.959,
      "end": 586.32,
      "text": "नोटिफिकेशंस आप तक टाइम टू टाइम पहुंचे।"
    },
    {
      "subtitle_id": 283,
      "start": 585.12,
      "end": 588.08,
      "text": "तो शेयर मार्केट में इन्वेस्ट करें और"
