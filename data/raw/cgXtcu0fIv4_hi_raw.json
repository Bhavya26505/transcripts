  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.199,
      "end": 4.12,
      "text": "नाम तो याद नहीं आ रहा है लेकिन किसी"
    },
    {
      "subtitle_id": 2,
      "start": 1.68,
      "end": 6.879,
      "text": "समझदार ने कहा था कि अगर आप समय के साथ"
    },
    {
      "subtitle_id": 3,
      "start": 4.12,
      "end": 10.76,
      "text": "नहीं बदलेंगे तो समय ही आपको बदल देगा और"
    },
    {
      "subtitle_id": 4,
      "start": 6.879,
      "end": 10.76,
      "text": "बिजनेस की दुनिया में एगजैक्टली यही हुआ"
    },
    {
      "subtitle_id": 5,
      "start": 12.22,
      "end": 21.799,
      "text": "[संगीत]"
    },
    {
      "subtitle_id": 6,
      "start": 25.88,
      "end": 31.439,
      "text": "nokia1 ना एक डब्बा टिप्पर वेयर का जरूर"
    },
    {
      "subtitle_id": 7,
      "start": 28.56,
      "end": 33.52,
      "text": "होगा जो लिया होगा 10 15 साल पहले पर अब"
    },
    {
      "subtitle_id": 8,
      "start": 31.439,
      "end": 35.32,
      "text": "तक भी अच्छे से चल रहा होगा जनरली"
    },
    {
      "subtitle_id": 9,
      "start": 33.52,
      "end": 37.719,
      "text": "ब्रांड्स पर मीम्स बनते हैं उनके बैड"
    },
    {
      "subtitle_id": 10,
      "start": 35.32,
      "end": 39.52,
      "text": "प्रोडक्ट्स या सर्विसेस की वजह से जैसे कि"
    },
    {
      "subtitle_id": 11,
      "start": 37.719,
      "end": 41.8,
      "text": "हमने वर्ल्ड्स फोर्थ लार्जेस्ट ईवी कंपनी"
    },
    {
      "subtitle_id": 12,
      "start": 39.52,
      "end": 44.6,
      "text": "एक्सक्लूडिंग चाइना यानी ला की केस में"
    },
    {
      "subtitle_id": 13,
      "start": 41.8,
      "end": 46.28,
      "text": "देखा जब काफी सारी ओला स्कूटी में आग लग"
    },
    {
      "subtitle_id": 14,
      "start": 44.6,
      "end": 48.44,
      "text": "गई तो लोगों ने इसके बारे में काफी सारी"
    },
    {
      "subtitle_id": 15,
      "start": 46.28,
      "end": 51.64,
      "text": "मीम्स बनाई पर टप्परवेयर की केस में"
    },
    {
      "subtitle_id": 16,
      "start": 48.44,
      "end": 54.079,
      "text": "बिल्कुल उल्टा था जैसे nokia1 पर कई सारी"
    },
    {
      "subtitle_id": 17,
      "start": 51.64,
      "end": 57.12,
      "text": "मीम्स बनती थी वैसे ही टप्परवेयर के"
    },
    {
      "subtitle_id": 18,
      "start": 54.079,
      "end": 59.199,
      "text": "ड्यूरेबल पर कई सारी मीम्स बनती थी इसके"
    },
    {
      "subtitle_id": 19,
      "start": 57.12,
      "end": 61.199,
      "text": "अलावा टप्परवेयर के साथ देसी मॉम्स का जो"
    },
    {
      "subtitle_id": 20,
      "start": 59.199,
      "end": 62.879,
      "text": "रिलेशन था वह काफी अलग था अपने बच्चों"
    },
    {
      "subtitle_id": 21,
      "start": 61.199,
      "end": 65.4,
      "text": "जितना ही ध्यान वो टप्परवेयर के डिब्बों"
    },
    {
      "subtitle_id": 22,
      "start": 62.879,
      "end": 67.56,
      "text": "पर देती थी और इसीलिए जैसे न्यूज़ बाहर आई"
    },
    {
      "subtitle_id": 23,
      "start": 65.4,
      "end": 69.759,
      "text": "कि टप्परवेयर बैंकर स फाइल कर रही है यह"
    },
    {
      "subtitle_id": 24,
      "start": 67.56,
      "end": 71.92,
      "text": "मीम्स काफी वायरल हो रही है जिसमें देसी"
    },
    {
      "subtitle_id": 25,
      "start": 69.759,
      "end": 73.439,
      "text": "मॉम्स काफी शौक में है अब इस न्यूज़ के"
    },
    {
      "subtitle_id": 26,
      "start": 71.92,
      "end": 74.92,
      "text": "बाद बहुत सारे लोग सदमे में हैं क्योंकि"
    },
    {
      "subtitle_id": 27,
      "start": 73.439,
      "end": 77.04,
      "text": "उन्हें लग रहा है कि टप्परवेयर के डिब्बे"
    },
    {
      "subtitle_id": 28,
      "start": 74.92,
      "end": 79.32,
      "text": "यहां से आगे मिलना बंद हो जाएंगे पर यह"
    },
    {
      "subtitle_id": 29,
      "start": 77.04,
      "end": 81.32,
      "text": "पूरी सच्चाई नहीं है इसके बारे में हम एंड"
    },
    {
      "subtitle_id": 30,
      "start": 79.32,
      "end": 83.119,
      "text": "में डिटेल में बात करेंगे इसके अलावा एक"
    },
    {
      "subtitle_id": 31,
      "start": 81.32,
      "end": 85.24,
      "text": "और सवाल सभी के दिमाग में जरूर आया होगा"
    },
    {
      "subtitle_id": 32,
      "start": 83.119,
      "end": 87.4,
      "text": "कि अगर कंपनी इतनी अच्छी है प्रोडक्ट्स"
    },
    {
      "subtitle_id": 33,
      "start": 85.24,
      "end": 90.159,
      "text": "इतने अच्छे हैं तो कंपनी को बैंकर से फाइल"
    },
    {
      "subtitle_id": 34,
      "start": 87.4,
      "end": 91.72,
      "text": "करने की नौबत क्यों आई उसके साथ ही ट टपर"
    },
    {
      "subtitle_id": 35,
      "start": 90.159,
      "end": 93.439,
      "text": "वेयर की कैसे शुरुआत हुई कैसे यह ब्रांड"
    },
    {
      "subtitle_id": 36,
      "start": 91.72,
      "end": 95.2,
      "text": "घर-घर तक पहुंचा उसके बारे में भी वीडियो"
    },
    {
      "subtitle_id": 37,
      "start": 93.439,
      "end": 96.759,
      "text": "में हमने डिटेल में बात की है और उसके"
    },
    {
      "subtitle_id": 38,
      "start": 95.2,
      "end": 99.159,
      "text": "अलावा हम यह भी बात करेंगे कि टप्परवेयर"
    },
    {
      "subtitle_id": 39,
      "start": 96.759,
      "end": 100.759,
      "text": "को आखिर बैंकर से क्यों फाइल करनी पड़े इन"
    },
    {
      "subtitle_id": 40,
      "start": 99.159,
      "end": 102.6,
      "text": "सारी चीजों के बारे में आज हम डिटेल में"
    },
    {
      "subtitle_id": 41,
      "start": 100.759,
      "end": 104.399,
      "text": "बात करने वाले हैं तो अंत तक जरूर बने"
    },
    {
      "subtitle_id": 42,
      "start": 102.6,
      "end": 106.399,
      "text": "रहिए और वीडियो शुरू करने से पहले आपसे"
    },
    {
      "subtitle_id": 43,
      "start": 104.399,
      "end": 108.56,
      "text": "रिक्वेस्ट करना चाहता हूं कि आप हमारी"
    },
    {
      "subtitle_id": 44,
      "start": 106.399,
      "end": 110.2,
      "text": "वीडियोस को रेगुलरली देखते हो तो वीडियो"
    },
    {
      "subtitle_id": 45,
      "start": 108.56,
      "end": 112.079,
      "text": "देखते देखते जरूर चैनल को सब्सक्राइब"
    },
    {
      "subtitle_id": 46,
      "start": 110.2,
      "end": 114.24,
      "text": "कीजिए और साथ ही इस घंटी को भी दबाइए"
    },
    {
      "subtitle_id": 47,
      "start": 112.079,
      "end": 116.56,
      "text": "क्योंकि घंटी दबाओगे तो ही प्रसाद मिलेगा"
    },
    {
      "subtitle_id": 48,
      "start": 114.24,
      "end": 118.399,
      "text": "अच्छा दबा दी तो चलिए शुरू करते हैं"
    },
    {
      "subtitle_id": 49,
      "start": 116.56,
      "end": 120.64,
      "text": "नमस्कार मैं प्रसाद आपका आज के इस वीडियो"
    },
    {
      "subtitle_id": 50,
      "start": 118.399,
      "end": 122.399,
      "text": "में स्वागत करता हूं वीडियो में आगे बढ़ने"
    },
    {
      "subtitle_id": 51,
      "start": 120.64,
      "end": 124.64,
      "text": "से पहले आपको बता दूं कि अभी अक्टूबर के"
    },
    {
      "subtitle_id": 52,
      "start": 122.399,
      "end": 126.039,
      "text": "सेकंड वीक से हमारी एफएमवीए यानी"
    },
    {
      "subtitle_id": 53,
      "start": 124.64,
      "end": 127.719,
      "text": "फाइनेंशियल मॉडलिंग एंड वैल्युएशन"
    },
    {
      "subtitle_id": 54,
      "start": 126.039,
      "end": 129.84,
      "text": "मेंटरशिप की नेक्स्ट बैच शुरू होने वाली"
    },
    {
      "subtitle_id": 55,
      "start": 127.719,
      "end": 131.16,
      "text": "है इसमें एनरोल करने की लिंक आपको नीचे"
    },
    {
      "subtitle_id": 56,
      "start": 129.84,
      "end": 134.12,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में मिल"
    },
    {
      "subtitle_id": 57,
      "start": 131.16,
      "end": 136.08,
      "text": "जाएगी ये एक 100% ऑनलाइन बैच है न महीने"
    },
    {
      "subtitle_id": 58,
      "start": 134.12,
      "end": 137.879,
      "text": "का कोर्स है जो कंप्लीट वीकेंड कोर्स है"
    },
    {
      "subtitle_id": 59,
      "start": 136.08,
      "end": 140.239,
      "text": "जिसे आप बड़ी आसानी से वीकेंड में अटेंड"
    },
    {
      "subtitle_id": 60,
      "start": 137.879,
      "end": 141.84,
      "text": "करके कंप्लीट कर सकते हो जो आपको कंपनी के"
    },
    {
      "subtitle_id": 61,
      "start": 140.239,
      "end": 143.959,
      "text": "फाइनेंशियल प्रोजेक्शंस करने में यानी"
    },
    {
      "subtitle_id": 62,
      "start": 141.84,
      "end": 145.76,
      "text": "फाइनेंशियल मॉडलिंग करने में मदद करेगा"
    },
    {
      "subtitle_id": 63,
      "start": 143.959,
      "end": 147.72,
      "text": "डीसीएफ मेथड जिससे हम कंपनी की एग्जैक्ट"
    },
    {
      "subtitle_id": 64,
      "start": 145.76,
      "end": 149.48,
      "text": "वैल्यू निकालते हैं यानी कि शेयर प्राइस"
    },
    {
      "subtitle_id": 65,
      "start": 147.72,
      "end": 151.64,
      "text": "तो हमें पता है कंपनी की एग्जैक्ट वैल्यू"
    },
    {
      "subtitle_id": 66,
      "start": 149.48,
      "end": 154.48,
      "text": "क्या है ₹1 का शेयर्स है तो उसकी वैल्यू"
    },
    {
      "subtitle_id": 67,
      "start": 151.64,
      "end": 156.36,
      "text": "₹10 है या फिर 80 है यह पता करने के लिए"
    },
    {
      "subtitle_id": 68,
      "start": 154.48,
      "end": 158.48,
      "text": "जो डीसीएफ हम इस्तेमाल करते हैं उसे"
    },
    {
      "subtitle_id": 69,
      "start": 156.36,
      "end": 160.48,
      "text": "कैलकुलेट करना हम यहां पर सीखेंगे और इसके"
    },
    {
      "subtitle_id": 70,
      "start": 158.48,
      "end": 162.64,
      "text": "अलावा फाइनेंस की फील्ड में इन डेफ नॉलेज"
    },
    {
      "subtitle_id": 71,
      "start": 160.48,
      "end": 164.879,
      "text": "के लिए यह कोर्स आपको बहुत काम में आएगा"
    },
    {
      "subtitle_id": 72,
      "start": 162.64,
      "end": 166.56,
      "text": "तो अगर आपको फाइनेंस में करियर करना है या"
    },
    {
      "subtitle_id": 73,
      "start": 164.879,
      "end": 168.879,
      "text": "फिर इन्वेस्टमेंट की वर्ल्ड में इन डेप्थ"
    },
    {
      "subtitle_id": 74,
      "start": 166.56,
      "end": 170.92,
      "text": "नॉलेज हासिल करना है तो यह आपके लिए बेस्ट"
    },
    {
      "subtitle_id": 75,
      "start": 168.879,
      "end": 172.4,
      "text": "अपॉर्चुनिटी है एफएमवीए में रजिस्टर करने"
    },
    {
      "subtitle_id": 76,
      "start": 170.92,
      "end": 174.879,
      "text": "की लिंक आपको नीचे डिस्क्रिप्शन और कमेंट"
    },
    {
      "subtitle_id": 77,
      "start": 172.4,
      "end": 177.36,
      "text": "बॉक्स में मिल जाएगी और रजिस्टर करने के"
    },
    {
      "subtitle_id": 78,
      "start": 174.879,
      "end": 178.92,
      "text": "बाद अगर आप क्वालीफाई हो जाते हैं तो"
    },
    {
      "subtitle_id": 79,
      "start": 177.36,
      "end": 181.08,
      "text": "हमारी टीम आपसे कांटेक्ट करके आपको"
    },
    {
      "subtitle_id": 80,
      "start": 178.92,
      "end": 183.48,
      "text": "काउंसलिंग सेशन की लिंक भेज देगी देखिए"
    },
    {
      "subtitle_id": 81,
      "start": 181.08,
      "end": 185.959,
      "text": "जनरली हमें ऐसा लगता है कि इनोवेशंस तब"
    },
    {
      "subtitle_id": 82,
      "start": 183.48,
      "end": 189.12,
      "text": "होते हैं जब देश और दुनिया में शांति हो"
    },
    {
      "subtitle_id": 83,
      "start": 185.959,
      "end": 191.2,
      "text": "राइट रॉन्ग अगर आप ह्यूमन हिस्ट्री को"
    },
    {
      "subtitle_id": 84,
      "start": 189.12,
      "end": 193.799,
      "text": "झांक कर देखें तो आपको पता चलेगा कि जो"
    },
    {
      "subtitle_id": 85,
      "start": 191.2,
      "end": 195.959,
      "text": "बड़े-बड़े इन्वेंशन और इनोवेशंस हैं उनका"
    },
    {
      "subtitle_id": 86,
      "start": 193.799,
      "end": 197.879,
      "text": "कहीं ना कहीं वॉर से काफी लेना देना था"
    },
    {
      "subtitle_id": 87,
      "start": 195.959,
      "end": 200.0,
      "text": "फॉर एग्जांपल आप वायरलेस कम्युनिकेशन की"
    },
    {
      "subtitle_id": 88,
      "start": 197.879,
      "end": 202.12,
      "text": "बात करो तो उसकी डेवलपमेंट वर्ल्ड वॉर व"
    },
    {
      "subtitle_id": 89,
      "start": 200.0,
      "end": 204.0,
      "text": "के दौरान हुई आप रडार की बात कर लो आप"
    },
    {
      "subtitle_id": 90,
      "start": 202.12,
      "end": 206.4,
      "text": "कंप्यूटर की बात कर लो या फिर न्यूक्लियर"
    },
    {
      "subtitle_id": 91,
      "start": 204.0,
      "end": 208.239,
      "text": "एनर्जी और जेट इंजन की बात कर लो इन सब का"
    },
    {
      "subtitle_id": 92,
      "start": 206.4,
      "end": 210.239,
      "text": "डेवलपमेंट वर्ल्ड वॉर 2 में हुआ है"
    },
    {
      "subtitle_id": 93,
      "start": 208.239,
      "end": 212.159,
      "text": "स्क्रीन पर जो आप पूरी लिस्ट देख रहे हो"
    },
    {
      "subtitle_id": 94,
      "start": 210.239,
      "end": 214.68,
      "text": "ये सारे वो इंवेंशंस है जो वर्ल्ड वॉर के"
    },
    {
      "subtitle_id": 95,
