    {
      "subtitle_id": 190,
      "start": 391.6,
      "end": 395.919,
      "text": "जाता है और ग्रोथ के नंबर में फॉल होता है"
    },
    {
      "subtitle_id": 191,
      "start": 393.759,
      "end": 397.759,
      "text": "तो एक शार्प करेक्शन उस स्टॉक में आ सकता"
    },
    {
      "subtitle_id": 192,
      "start": 395.919,
      "end": 401.28,
      "text": "है। अब आप गेस कीजिए कि ये कितना हो गया"
    },
    {
      "subtitle_id": 193,
      "start": 397.759,
      "end": 403.28,
      "text": "था? 113 अक्टूबर 2024 में हो गया था 113"
    },
    {
      "subtitle_id": 194,
      "start": 401.28,
      "end": 405.6,
      "text": "अभी प्राइस आधे से ज्यादा गिरने के बाद यह"
    },
    {
      "subtitle_id": 195,
      "start": 403.28,
      "end": 407.6,
      "text": "43 पर है। यानी कि एवी बाय एबिड हमें अभी"
    },
    {
      "subtitle_id": 196,
      "start": 405.6,
      "end": 409.36,
      "text": "भी यही बता रहा है कि कंपनी इज़ स्टिल"
    },
    {
      "subtitle_id": 197,
      "start": 407.6,
      "end": 411.039,
      "text": "क्वाइट ओवरवैल्यूड। तो इस रेशियो को"
    },
    {
      "subtitle_id": 198,
      "start": 409.36,
      "end": 413.44,
      "text": "मेंटेन करने के लिए या तो शेयर प्राइस को"
    },
    {
      "subtitle_id": 199,
      "start": 411.039,
      "end": 415.52,
      "text": "गिरना पड़ेगा या फिर कंपनी को अपने"
    },
    {
      "subtitle_id": 200,
      "start": 413.44,
      "end": 417.36,
      "text": "एबिड्डा को यानी मोटा-मोटी ग्रॉस प्रॉफिट"
    },
    {
      "subtitle_id": 201,
      "start": 415.52,
      "end": 419.199,
      "text": "को तेजी से बढ़ाना पड़ेगा। उसकी ग्रोथ"
    },
    {
      "subtitle_id": 202,
      "start": 417.36,
      "end": 421.599,
      "text": "बहुत तेजी से करनी पड़ेगी। अगर कुछ और"
    },
    {
      "subtitle_id": 203,
      "start": 419.199,
      "end": 423.28,
      "text": "फिगर्स पर ध्यान दी जाए ट्रेंड की जो ZDO"
    },
    {
      "subtitle_id": 204,
      "start": 421.599,
      "end": 426.639,
      "text": "चलाती है तो एवरेज रेवेन्यू पर स्क्वायर"
    },
    {
      "subtitle_id": 205,
      "start": 423.28,
      "end": 428.639,
      "text": "फीट इनका 15.7% ईयर ऑन ईयर कम हुआ है। यह"
    },
    {
      "subtitle_id": 206,
      "start": 426.639,
      "end": 430.56,
      "text": "तीसरा लगातार क्वार्टर है जहां पर यह नंबर"
    },
    {
      "subtitle_id": 207,
      "start": 428.639,
      "end": 432.16,
      "text": "लगातार गिर रहा है। यह एक क्लियर साइन है"
    },
    {
      "subtitle_id": 208,
      "start": 430.56,
      "end": 434.639,
      "text": "कि जो भी ग्रोथ उन्हें मिल रही है वो"
    },
    {
      "subtitle_id": 209,
      "start": 432.16,
      "end": 436.639,
      "text": "स्टोर एडिशन की वजह से हो रही है ना कि पर"
    },
    {
      "subtitle_id": 210,
      "start": 434.639,
      "end": 438.4,
      "text": "स्टोर बेसिस का रेवेन्यू बढ़ने से। यानी"
    },
    {
      "subtitle_id": 211,
      "start": 436.639,
      "end": 440.24,
      "text": "अगर आज की तारीख में ट्रेंड नए शोरूम"
    },
    {
      "subtitle_id": 212,
      "start": 438.4,
      "end": 442.08,
      "text": "खोलना बंद कर दे तो उनकी रेवेन्यू लगभग"
    },
    {
      "subtitle_id": 213,
      "start": 440.24,
      "end": 444.16,
      "text": "फ्लैट हो सकती है। क्योंकि उनका जो पर"
    },
    {
      "subtitle_id": 214,
      "start": 442.08,
      "end": 446.0,
      "text": "स्टोर सेल है वह लगातार कम होते जा रहा"
    },
    {
      "subtitle_id": 215,
      "start": 444.16,
      "end": 447.68,
      "text": "है। यानी उनके लगातार उनको ब्रांचेस"
    },
    {
      "subtitle_id": 216,
      "start": 446.0,
      "end": 449.52,
      "text": "बढ़ानी पड़ेगी। शोरूम्स बढ़ाते ही रहने"
    },
    {
      "subtitle_id": 217,
      "start": 447.68,
      "end": 451.36,
      "text": "पड़ेंगे। अगर ग्रो करना है तो और पर्सनली"
    },
    {
      "subtitle_id": 218,
      "start": 449.52,
      "end": 453.039,
      "text": "मुझे नहीं लगता कि इसका कारण यह है कि अब"
    },
    {
      "subtitle_id": 219,
      "start": 451.36,
      "end": 455.12,
      "text": "लोग जुड़ियो से कपड़े नहीं लेना चाहते।"
    },
    {
      "subtitle_id": 220,
      "start": 453.039,
      "end": 457.12,
      "text": "इसका मोस्ट प्रोबेबल कारण है जिसे बिज़नेस"
    },
    {
      "subtitle_id": 221,
      "start": 455.12,
      "end": 459.36,
      "text": "की दुनिया में मार्केट कैनबलाइजेशन कहते"
    },
    {
      "subtitle_id": 222,
      "start": 457.12,
      "end": 461.599,
      "text": "हैं। यानी पहले आपके नजदीक एक जुड़ियो"
    },
    {
      "subtitle_id": 223,
      "start": 459.36,
      "end": 463.599,
      "text": "स्टोर हुआ करता था। उस एरिया के 100%"
    },
    {
      "subtitle_id": 224,
      "start": 461.599,
      "end": 465.44,
      "text": "सेल्स उस एक स्टोर में होती थी। अब"
    },
    {
      "subtitle_id": 225,
      "start": 463.599,
      "end": 467.12,
      "text": "जुड़ियो ने दो-तीन स्टोर और खोल दिए एरिया"
    },
    {
      "subtitle_id": 226,
      "start": 465.44,
      "end": 469.919,
      "text": "में। लोग अपने पास वाले स्टोर में जाने"
    },
    {
      "subtitle_id": 227,
      "start": 467.12,
      "end": 471.52,
      "text": "लगे और सेल तीन स्टोर में बढ़ गई। अब इसका"
    },
    {
      "subtitle_id": 228,
      "start": 469.919,
      "end": 473.52,
      "text": "यह मतलब नहीं है कि ट्रेंड कोई अच्छी"
    },
    {
      "subtitle_id": 229,
      "start": 471.52,
      "end": 475.28,
      "text": "कंपनी नहीं है। इनफैक्ट रिसर्च के दौरान"
    },
    {
      "subtitle_id": 230,
      "start": 473.52,
      "end": 477.36,
      "text": "हमें एक इंटरेस्टिंग चीज पता चली जिससे"
    },
    {
      "subtitle_id": 231,
      "start": 475.28,
      "end": 478.96,
      "text": "पता चलता है कि कैसे ट्रेंड Tata ब्रांड"
    },
    {
      "subtitle_id": 232,
      "start": 477.36,
      "end": 480.8,
      "text": "को अच्छे से इस्तेमाल कर रहा है। क्योंकि"
    },
    {
      "subtitle_id": 233,
      "start": 478.96,
      "end": 482.72,
      "text": "अगर आप कंपनी का आरओसी यानी रिटर्न ऑन"
    },
    {
      "subtitle_id": 234,
      "start": 480.8,
      "end": 484.639,
      "text": "कैपिटल एंप्लॉयड देखेंगे जो हमें यह बताता"
    },
    {
      "subtitle_id": 235,
      "start": 482.72,
      "end": 486.319,
      "text": "है कि कितने एफिशिएंटली कंपनी अपनी कैपिटल"
    },
    {
      "subtitle_id": 236,
      "start": 484.639,
      "end": 488.479,
      "text": "को इस्तेमाल कर रही है और उस पर रिटर्न ला"
    },
    {
      "subtitle_id": 237,
      "start": 486.319,
      "end": 491.039,
      "text": "रही है। तो कंपनी का आरओसी इस क्लोज टू 30"
    },
    {
      "subtitle_id": 238,
      "start": 488.479,
      "end": 493.199,
      "text": "35% जो बहुत अच्छा है जिसमें कंपनी का"
    },
    {
      "subtitle_id": 239,
      "start": 491.039,
      "end": 495.28,
      "text": "बोरोइंग कैपिटल है वो मोस्टली लीज़ है और"
    },
    {
      "subtitle_id": 240,
      "start": 493.199,
      "end": 497.12,
      "text": "एक्चुअल बोरोइंग जो है जो लोन वगैरह इनके"
    },
    {
      "subtitle_id": 241,
      "start": 495.28,
      "end": 499.68,
      "text": "वो नहीं के बराबर है। अगर लीड्स को हटा"
    },
    {
      "subtitle_id": 242,
      "start": 497.12,
      "end": 501.68,
      "text": "दें तो कंपनी के आरओसी इज़ क्लोज टू 45%"
    },
    {
      "subtitle_id": 243,
      "start": 499.68,
      "end": 503.44,
      "text": "दैट्स अब्सोलुटली फैंटास्टिक नंबर। यानी"
    },
    {
      "subtitle_id": 244,
      "start": 501.68,
      "end": 505.52,
      "text": "बिज़नेस में यह ₹100 अगर इन्वेस्ट कर रहे"
    },
    {
      "subtitle_id": 245,
      "start": 503.44,
      "end": 507.12,
      "text": "हैं तो एक साल में यह 45% के रिटर्न्स"
    },
    {
      "subtitle_id": 246,
      "start": 505.52,
      "end": 509.039,
      "text": "निकाल पा रहे हैं। और ऐसा क्यों कर पा रहे"
    },
    {
      "subtitle_id": 247,
      "start": 507.12,
      "end": 511.12,
      "text": "हैं? क्योंकि एक तो यह अपने स्टोर्स लीज़"
    },
    {
      "subtitle_id": 248,
      "start": 509.039,
      "end": 513.36,
      "text": "पर लेते हैं। और सेकंड यह माल लेते हैं।"
    },
    {
      "subtitle_id": 249,
      "start": 511.12,
      "end": 515.039,
      "text": "वह सारा उधारी पर लेते हैं। फिर वह माल की"
    },
    {
      "subtitle_id": 250,
      "start": 513.36,
      "end": 517.039,
      "text": "चर्निंग भी बहुत फास्ट होती है। यानी"
    },
    {
      "subtitle_id": 251,
      "start": 515.039,
      "end": 519.279,
      "text": "स्टोर्स में माल आने के बाद जल्दी फटाफट"
    },
    {
      "subtitle_id": 252,
      "start": 517.039,
      "end": 520.959,
      "text": "बिक जाता है। क्योंकि कस्टमर भी वह यूथ है"
    },
    {
      "subtitle_id": 253,
      "start": 519.279,
      "end": 522.959,
      "text": "जिन्हें नए ट्रेंड्स चाहिए। नई चीजें"
    },
    {
      "subtitle_id": 254,
      "start": 520.959,
      "end": 524.56,
      "text": "पहनने का शौक है। तो यह सब इसलिए भी कर"
    },
    {
      "subtitle_id": 255,
      "start": 522.959,
      "end": 526.16,
      "text": "पाते हैं कि Tata ग्रुप की कंपनी है। तो"
    },
    {
      "subtitle_id": 256,
      "start": 524.56,
      "end": 527.68,
      "text": "मैन्युफैक्चरर्स भी इन्हें क्रेडिट पीरियड"
    },
    {
      "subtitle_id": 257,
      "start": 526.16,
      "end": 529.6,
      "text": "अच्छा खासा देते हैं। ट्रस्ट है भाई। पैसा"
    },
    {
      "subtitle_id": 258,
      "start": 527.68,
      "end": 531.519,
      "text": "डूबेगा ऐसी बात नहीं है। वो उनको भी पता"
    },
    {
      "subtitle_id": 259,
      "start": 529.6,
      "end": 533.36,
      "text": "है। तो उसी Tata ब्रांड का फायदा यह अलग"
    },
    {
      "subtitle_id": 260,
      "start": 531.519,
      "end": 534.959,
      "text": "तरीके से लेते हैं। तो इट्स अ गुड बिज़नेस।"
    },
    {
      "subtitle_id": 261,
      "start": 533.36,
      "end": 536.959,
      "text": "क्वालिटी में काफी सारी कंप्लेंट कई बार"
    },
    {
      "subtitle_id": 262,
      "start": 534.959,
      "end": 539.36,
      "text": "आती है कि तीन-चार वॉश में टीशर्ट लूज हो"
    },
    {
      "subtitle_id": 263,
      "start": 536.959,
      "end": 541.2,
      "text": "जाता है। पर यार ₹10 ₹200 में तीन-चार बार"
    },
    {
      "subtitle_id": 264,
      "start": 539.36,
      "end": 542.88,
      "text": "यूज़ वाली चीजें मिलती है। ज्यादा लॉन्ग"
    },
    {
      "subtitle_id": 265,
      "start": 541.2,
      "end": 544.72,
      "text": "टर्म तो आप एक्सपेक्ट नहीं कर सकते। सो"
    },
    {
      "subtitle_id": 266,
      "start": 542.88,
      "end": 547.2,
      "text": "इट्स अ गुड बिज़नेस बट वैल्यूएशन यार मुझे"
    },
    {
      "subtitle_id": 267,
      "start": 544.72,
      "end": 548.959,
      "text": "बहुत ज्यादा हैवी लगता है। अब सवाल यह आता"
    },
    {
      "subtitle_id": 268,
      "start": 547.2,
      "end": 551.12,
      "text": "है कि ऐसी चीजों में रिटेल इन्वेस्टर्स ही"
    },
    {
      "subtitle_id": 269,
      "start": 548.959,
      "end": 553.04,
      "text": "कैसे आगे आ जाते हैं? जब भी इस तरह के"
    },
    {
      "subtitle_id": 270,
      "start": 551.12,
      "end": 555.04,
      "text": "लॉसेस होते हो। तो देखिए मार्केट में आप"
    },
    {
      "subtitle_id": 271,
      "start": 553.04,
      "end": 557.279,
      "text": "एक चीज समझ लीजिए कि अगर किसी शेयर के"
    },
    {
      "subtitle_id": 272,
      "start": 555.04,
      "end": 559.279,
      "text": "बारे में आप अपने आसपास सोशल मीडिया पर या"
    },
    {
      "subtitle_id": 273,
      "start": 557.279,
      "end": 561.36,
      "text": "Telegram ग्रुप पर सुन रहे हो तो आप तुरंत"
    },
    {
      "subtitle_id": 274,
      "start": 559.279,
      "end": 563.2,
      "text": "सतर्क हो जाइए क्योंकि वो चीज सबको पता चल"
    },
    {
      "subtitle_id": 275,
      "start": 561.36,
      "end": 565.2,
      "text": "चुकी है। मतलब वो अंडरवैल्यूड अब नहीं"
    },
    {
      "subtitle_id": 276,
      "start": 563.2,
      "end": 567.279,
      "text": "रहे। वह जो मैसेजेस होते हैं, वह लाखों"
    },
    {
      "subtitle_id": 277,
      "start": 565.2,
      "end": 569.6,
      "text": "लोगों से गुजर कर आप तक पहुंचते हैं। फिर"
    },
    {
      "subtitle_id": 278,
      "start": 567.279,
      "end": 572.0,
      "text": "लोग एक साथ उस शेयर पर टूट पड़ते हैं। तब"
    },
    {
      "subtitle_id": 279,
      "start": 569.6,
      "end": 573.44,
      "text": "वह ₹100 का शेयर ₹5,000 पर पहुंचने में"
    },
    {
      "subtitle_id": 280,
      "start": 572.0,
      "end": 575.12,
      "text": "टाइम नहीं लगता। तो ऐसे स्टॉक में"
    },
    {
      "subtitle_id": 281,
      "start": 573.44,
      "end": 576.959,
      "text": "इन्वेस्ट करें जिसकी ज्यादा चर्चा नहीं चल"
    },
    {
      "subtitle_id": 282,
      "start": 575.12,
      "end": 579.12,
      "text": "रही हो जिसके बारे में लोग डरे हुए हो।"
    },
    {
      "subtitle_id": 283,
      "start": 576.959,
      "end": 580.959,
      "text": "फंडामेंटल्स अच्छे हैं। इस तरह की कंपनीज़"
    },
    {
      "subtitle_id": 284,
      "start": 579.12,
      "end": 582.48,
      "text": "आपको जनरली ढूंढनी पड़ेगी। लोगों के"
    },
    {
      "subtitle_id": 285,
      "start": 580.959,
      "end": 584.16,
      "text": "क्राउड के थोड़ा आपको ऑोजिट ही करना"
    },
    {
      "subtitle_id": 286,
      "start": 582.48,
      "end": 586.08,
      "text": "पड़ेगा। अगर आपको मार्केट में पैसा कमाना"
    },
    {
      "subtitle_id": 287,
      "start": 584.16,
      "end": 587.519,
      "text": "है तो। क्राउड की तरह करेंगे तो आप भी"
    },
    {
      "subtitle_id": 288,
      "start": 586.08,
      "end": 588.88,
      "text": "उन्हीं उन्हीं में शामिल हो जाएंगे और"
    },
    {
      "subtitle_id": 289,
      "start": 587.519,
      "end": 590.72,
      "text": "उन्हीं की तरह आप रिटर्न्स नहीं कमा"
    },
    {
      "subtitle_id": 290,
      "start": 588.88,
      "end": 592.64,
      "text": "पाएंगे। पर प्रॉपर रिसर्च या वैल्यू्यूएशन"
    },
    {
      "subtitle_id": 291,
      "start": 590.72,
      "end": 595.04,
      "text": "निकालने के लिए अगर आपके पास टाइम नहीं है"
    },
    {
      "subtitle_id": 292,
      "start": 592.64,
      "end": 596.8,
      "text": "तो इका की कम्युनिटी आपके लिए है जिसकी"
    },
    {
      "subtitle_id": 293,
      "start": 595.04,
      "end": 599.04,
      "text": "लिंक आपको नीचे डिस्क्रिप्शन और कमेंट"
    },
    {
      "subtitle_id": 294,
      "start": 596.8,
      "end": 600.88,
      "text": "बॉक्स में मिल जाएगी और स्पेशल थैंक्स टू"
    },
    {
      "subtitle_id": 295,
      "start": 599.04,
      "end": 602.64,
      "text": "ग्रो जिनकी वजह से हम यह वीडियो बहुत"
    },
    {
      "subtitle_id": 296,
      "start": 600.88,
      "end": 604.08,
      "text": "अच्छी फ्रीक्वेंसी के साथ बना पा रहे हैं।"
    },
    {
      "subtitle_id": 297,
      "start": 602.64,
      "end": 605.68,
      "text": "तो चलिए मिलते हैं ऐसे इंटरेस्टिंग अगले"
    },
    {
      "subtitle_id": 298,
      "start": 604.08,
      "end": 607.279,
      "text": "वीडियो में। कोई स्पेसिफिक टॉपिक आपके"
    },
    {
      "subtitle_id": 299,
      "start": 605.68,
      "end": 609.68,
      "text": "दिमाग में होगा नीचे कमेंट करके जरूर"
    },
    {
      "subtitle_id": 300,
      "start": 607.279,
      "end": 612.16,
      "text": "बताइए और मिलते हैं तो तब तक के लिए बाय-ब"
    },
    {
      "subtitle_id": 301,
      "start": 609.68,
      "end": 612.16,
      "text": "एंड टेक केयर।"
    }
  ]
}