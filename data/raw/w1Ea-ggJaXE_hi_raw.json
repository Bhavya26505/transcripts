  "segments": [
    {
      "subtitle_id": 1,
      "start": 1.199,
      "end": 7.279,
      "text": "वॉलस्ट्रीट में एक बहुत पुरानी कहावत है"
    },
    {
      "subtitle_id": 2,
      "start": 3.6,
      "end": 9.599,
      "text": "कि ट्रीज डोंट ग्रो टू द स्काई। यानी पेड़"
    },
    {
      "subtitle_id": 3,
      "start": 7.279,
      "end": 11.84,
      "text": "आसमान पर ग्रो नहीं करते। उसे ग्रो करने"
    },
    {
      "subtitle_id": 4,
      "start": 9.599,
      "end": 13.759,
      "text": "के लिए जमीन पर आना पड़ता है। और स्टॉक"
    },
    {
      "subtitle_id": 5,
      "start": 11.84,
      "end": 15.92,
      "text": "मार्केट की दुनिया में कहें तो जो स्टॉक"
    },
    {
      "subtitle_id": 6,
      "start": 13.759,
      "end": 17.92,
      "text": "उसकी अर्निंग से भी ज्यादा ऊपर चला जाता"
    },
    {
      "subtitle_id": 7,
      "start": 15.92,
      "end": 20.72,
      "text": "है। यानी उसकी प्रॉफिट ग्रोथ से भी बहुत"
    },
    {
      "subtitle_id": 8,
      "start": 17.92,
      "end": 23.119,
      "text": "ज्यादा ऊपर चला जाता है। उसे नीचे आना ही"
    },
    {
      "subtitle_id": 9,
      "start": 20.72,
      "end": 25.039,
      "text": "है। बिकॉज़ ग्रेविटी सभी चीजों पर अप्लाई"
    },
    {
      "subtitle_id": 10,
      "start": 23.119,
      "end": 27.439,
      "text": "होती है। ऐसा एक बहुत अच्छा उदाहरण है"
    },
    {
      "subtitle_id": 11,
      "start": 25.039,
      "end": 29.359,
      "text": "ट्रेंड का जो 5 साल पहले करीब ₹600 के"
    },
    {
      "subtitle_id": 12,
      "start": 27.439,
      "end": 31.599,
      "text": "करीब ट्रेड हो रहा था। और फिर बढ़ते-बढ़ते"
    },
    {
      "subtitle_id": 13,
      "start": 29.359,
      "end": 33.44,
      "text": "यह लास्ट ईयर 8,000 के भी ऊपर चला गया। और"
    },
    {
      "subtitle_id": 14,
      "start": 31.599,
      "end": 36.079,
      "text": "फिर सबको यही लग रहा था कि यह 10,000 के"
    },
    {
      "subtitle_id": 15,
      "start": 33.44,
      "end": 38.32,
      "text": "भी ऊपर जाएगा और 15,20,000 पे रुक जाएगा।"
    },
    {
      "subtitle_id": 16,
      "start": 36.079,
      "end": 40.559,
      "text": "लेकिन तभी ग्रेविटी ने अपना कमाल दिखाया"
    },
    {
      "subtitle_id": 17,
      "start": 38.32,
      "end": 42.96,
      "text": "और वो शेयर गिरने लगा। गिरते-गिरते पहुंच"
    },
    {
      "subtitle_id": 18,
      "start": 40.559,
      "end": 45.28,
      "text": "गया है ₹4,000 पर और फिलहाल ये अपने ऑल"
    },
    {
      "subtitle_id": 19,
      "start": 42.96,
      "end": 47.12,
      "text": "टाइम हाई से ऑलमोस्ट 50% डाउन है और कंपनी"
    },
    {
      "subtitle_id": 20,
      "start": 45.28,
      "end": 49.36,
      "text": "की मार्केट वैल्यू कितनी कम हुई है? तो,"
    },
    {
      "subtitle_id": 21,
      "start": 47.12,
      "end": 51.76,
      "text": "आप सुन के चौंक जाएंगे। ₹1.5 लाख करोड़।"
    },
    {
      "subtitle_id": 22,
      "start": 49.36,
      "end": 53.28,
      "text": "हां, ₹1.5 लाख करोड़ खा। अब यह नुकसान"
    },
    {
      "subtitle_id": 23,
      "start": 51.76,
      "end": 55.12,
      "text": "पर्टिकुलरली उन्हीं लोगों को हुआ है जो"
    },
    {
      "subtitle_id": 24,
      "start": 53.28,
      "end": 57.28,
      "text": "पिछले एकद सालों में ट्रेंड में इन्वेस्ट"
    },
    {
      "subtitle_id": 25,
      "start": 55.12,
      "end": 59.199,
      "text": "करने लगे। यह सोचकर कि यह स्टॉक उनके लिए"
    },
    {
      "subtitle_id": 26,
      "start": 57.28,
      "end": 62.0,
      "text": "बहुत बड़ा मल्टीबैगर साबित होगा। उन्होंने"
    },
    {
      "subtitle_id": 27,
      "start": 59.199,
      "end": 65.199,
      "text": "सोचा कि 600 से 5 साल में 8000 पर चला गया"
    },
    {
      "subtitle_id": 28,
      "start": 62.0,
      "end": 67.52,
      "text": "है तो अगले 5 सालों में 8000 से 400 80000"
    },
    {
      "subtitle_id": 29,
      "start": 65.199,
      "end": 69.2,
      "text": "चला जाएगा। लेकिन हुआ बिल्कुल उल्टा। अब"
    },
    {
      "subtitle_id": 30,
      "start": 67.52,
      "end": 71.2,
      "text": "सवाल यह है कि आखिर ऐसा मार्केट में क्या"
    },
    {
      "subtitle_id": 31,
      "start": 69.2,
      "end": 73.119,
      "text": "हुआ कि शेयर की प्राइस सीधी आधी हो गई। और"
    },
    {
      "subtitle_id": 32,
      "start": 71.2,
      "end": 75.04,
      "text": "मार्केट में अकेला शेयर नहीं था जिसके साथ"
    },
    {
      "subtitle_id": 33,
      "start": 73.119,
      "end": 77.119,
      "text": "ऐसा हुआ था। मार्केट में पिछले साल काफी"
    },
    {
      "subtitle_id": 34,
      "start": 75.04,
      "end": 79.04,
      "text": "सारे ऐसे शेयर्स रहे हैं जिनमें काफी तेजी"
    },
    {
      "subtitle_id": 35,
      "start": 77.119,
      "end": 81.2,
      "text": "से गिरावट हुई है। और फिर आखिर में यह भी"
    },
    {
      "subtitle_id": 36,
      "start": 79.04,
      "end": 83.04,
      "text": "बात करेंगे कि रिटेलर्स ही ऐसी चीजों में"
    },
    {
      "subtitle_id": 37,
      "start": 81.2,
      "end": 84.72,
      "text": "आगे कैसे आ जाते हैं? क्यों फंस जाता है?"
    },
    {
      "subtitle_id": 38,
      "start": 83.04,
      "end": 87.119,
      "text": "बिफोर स्टार्टिंग द वीडियो आई वुड लाइक टू"
    },
    {
      "subtitle_id": 39,
      "start": 84.72,
      "end": 88.96,
      "text": "थैंक आवर चैनल पार्टनर G इंडिया का सबसे"
    },
    {
      "subtitle_id": 40,
      "start": 87.119,
      "end": 91.36,
      "text": "बड़ा ब्रोकर है। जहां पर आप स्टॉक,"
    },
    {
      "subtitle_id": 41,
      "start": 88.96,
      "end": 93.04,
      "text": "म्यूच्यूल फंड लगभग सारे एसेट क्लासेस में"
    },
    {
      "subtitle_id": 42,
      "start": 91.36,
      "end": 94.88,
      "text": "इन्वेस्ट कर सकते हो, ट्रेड कर सकते हो।"
    },
    {
      "subtitle_id": 43,
      "start": 93.04,
      "end": 96.64,
      "text": "और जितना इनका सिंपल यूआई यूx है उतना"
    },
    {
      "subtitle_id": 44,
      "start": 94.88,
      "end": 98.88,
      "text": "सिंपल आपको कहीं नहीं मिलेगा। तो Play या"
    },
    {
      "subtitle_id": 45,
      "start": 96.64,
      "end": 100.64,
      "text": "App Store पर जाकर G का ऐप जरूर चेक आउट"
    },
    {
      "subtitle_id": 46,
      "start": 98.88,
      "end": 102.4,
      "text": "करिए। देखिए ट्रेंड का शेयर ऑलरेडी नीचे"
    },
    {
      "subtitle_id": 47,
      "start": 100.64,
      "end": 104.079,
      "text": "जा रहा था। तभी कुछ दिनों पहले उनका"
    },
    {
      "subtitle_id": 48,
      "start": 102.4,
      "end": 107.6,
      "text": "क्वार्टर 3 का रिजल्ट आया। रिजल्ट में"
    },
    {
      "subtitle_id": 49,
      "start": 104.079,
      "end": 110.399,
      "text": "उनका क्वार्टर 3 का रेवेन्यू था 5220 करोड़"
    },
    {
      "subtitle_id": 50,
      "start": 107.6,
      "end": 112.88,
      "text": "जो लास्ट ईयर के क्वार्टर 3 से 17% यानी"
    },
    {
      "subtitle_id": 51,
      "start": 110.399,
      "end": 115.2,
      "text": "17% अप था। अब आपको लग रहा होगा कि ग्रोथ"
    },
    {
      "subtitle_id": 52,
      "start": 112.88,
      "end": 117.2,
      "text": "लाइक 17% इज गुड। मार्केट में अच्छी ग्रोथ"
    },
    {
      "subtitle_id": 53,
      "start": 115.2,
      "end": 118.799,
      "text": "कंसीडर की जाती है। लेकिन अगर आप ट्रेंड"
    },
    {
      "subtitle_id": 54,
      "start": 117.2,
      "end": 120.479,
      "text": "के बारे में भी ऐसा ही सोच रहे हैं तो आप"
    },
    {
      "subtitle_id": 55,
      "start": 118.799,
      "end": 122.24,
      "text": "गलत है क्योंकि यह ग्रोथ ट्रेंड जैसी"
    },
    {
      "subtitle_id": 56,
      "start": 120.479,
      "end": 124.079,
      "text": "कंपनी के लिए बिल्कुल भी अच्छी नहीं है।"
    },
    {
      "subtitle_id": 57,
      "start": 122.24,
      "end": 126.799,
      "text": "जैसे ही यह न्यूज़ बाहर आई ट्रेंड की शेयर"
    },
    {
      "subtitle_id": 58,
      "start": 124.079,
      "end": 128.64,
      "text": "प्राइस 8% से गिर गई और 13,000 करोड़ की"
    },
    {
      "subtitle_id": 59,
      "start": 126.799,
      "end": 130.8,
      "text": "मार्केट वैल्यू सिर्फ एक दिन में धुआं हो"
    },
    {
      "subtitle_id": 60,
      "start": 128.64,
      "end": 132.8,
      "text": "गई। अब सवाल यह है कि डिसेंट ग्रोथ के"
    },
    {
      "subtitle_id": 61,
      "start": 130.8,
      "end": 135.04,
      "text": "बावजूद भी शेयर प्राइस लगातार क्यों गिर"
    },
    {
      "subtitle_id": 62,
      "start": 132.8,
      "end": 137.44,
      "text": "रही है? और इसका जवाब जुड़ा है एक ऐसी चीज"
    },
    {
      "subtitle_id": 63,
      "start": 135.04,
      "end": 139.44,
      "text": "से जिसे ज्यादातर रिटेल इन्वेस्टर्स चेक"
    },
    {
      "subtitle_id": 64,
      "start": 137.44,
      "end": 141.599,
      "text": "ही नहीं करते हैं। कंपनी का वैल्यू्यूएशन।"
    },
    {
      "subtitle_id": 65,
      "start": 139.44,
      "end": 143.44,
      "text": "देखिए करीब 1 डेढ़ साल पहले जब ट्रेंड"
    },
    {
      "subtitle_id": 66,
      "start": 141.599,
      "end": 145.12,
      "text": "अपने पीक पर था तब भी मैंने ट्रेंड पर एक"
    },
    {
      "subtitle_id": 67,
      "start": 143.44,
      "end": 146.959,
      "text": "वीडियो बनाई थी और जिसमें मैंने बात की थी"
    },
    {
      "subtitle_id": 68,
      "start": 145.12,
      "end": 149.2,
      "text": "कि ट्रेंड का स्केल ही कंपनी का इतना बड़ा"
    },
    {
      "subtitle_id": 69,
      "start": 146.959,
      "end": 151.44,
      "text": "हो गया है कि यहां से अगेन डबल होना इज"
    },
    {
      "subtitle_id": 70,
      "start": 149.2,
      "end": 153.04,
      "text": "वेरी टफ। तो ऑफ कोर्स थोड़े एक्सपेंसिव"
    },
    {
      "subtitle_id": 71,
      "start": 151.44,
      "end": 154.56,
      "text": "लेवल्स हैं। लेकिन अगर कोई एंटर कर रहा है"
    },
    {
      "subtitle_id": 72,
      "start": 153.04,
      "end": 156.4,
      "text": "तो आपको मेक श्योर करना पड़ेगा कि कंपनी"
    },
    {
      "subtitle_id": 73,
      "start": 154.56,
      "end": 159.12,
      "text": "बहुत तेजी से यहां से बढ़े ही बढ़े। लेकिन"
    },
    {
      "subtitle_id": 74,
      "start": 156.4,
      "end": 161.44,
      "text": "अगर वो नहीं बढ़ती है 80 90% की स्पीड से"
    },
    {
      "subtitle_id": 75,
      "start": 159.12,
      "end": 163.12,
      "text": "यहां से एनुअली तो फिर आपके लिए बहुत बड़ी"
    },
    {
      "subtitle_id": 76,
      "start": 161.44,
      "end": 164.56,
      "text": "प्रॉब्लम क्रिएट हो सकती है। और मैंने ये"
    },
    {
      "subtitle_id": 77,
      "start": 163.12,
      "end": 167.28,
      "text": "चीज ऐसे ही नहीं कही थी कि कंपनी का"
    },
    {
      "subtitle_id": 78,
      "start": 164.56,
      "end": 169.12,
      "text": "वैल्यू्यूएशन वाज़ एब्सोलुटली इनसेन। अब"
    },
    {
      "subtitle_id": 79,
      "start": 167.28,
      "end": 170.8,
      "text": "ज़्यादातर रिटेलर यह चीज़ समझ नहीं पाते"
    },
    {
      "subtitle_id": 80,
      "start": 169.12,
      "end": 172.4,
      "text": "क्योंकि वैल्यू्यूएशन निकालना थोड़ा ट्रिकी"
    },
    {
      "subtitle_id": 81,
      "start": 170.8,
      "end": 174.0,
      "text": "होता है क्योंकि यहां पर डिफरेंट-डिफरेंट"
    },
    {
      "subtitle_id": 82,
      "start": 172.4,
      "end": 175.599,
      "text": "वैल्यू्यूएशन मैट्रिक्स आपको देखने पड़ते"
    },
    {
      "subtitle_id": 83,
      "start": 174.0,
      "end": 177.44,
      "text": "हैं। मैं वन बाय वन आसान भाषा में आपको"
    },
    {
      "subtitle_id": 84,
      "start": 175.599,
      "end": 178.959,
      "text": "समझाने की कोशिश करता हूं सारे के सारे।"
    },
    {
      "subtitle_id": 85,
      "start": 177.44,
      "end": 180.72,
      "text": "वीडियो में आगे बढ़ने से पहले आपको बता"
    },
    {
      "subtitle_id": 86,
      "start": 178.959,
      "end": 182.56,
      "text": "दूं कि बहुत सारे लोग इन्वेस्ट तो करना"
    },
    {
      "subtitle_id": 87,
      "start": 180.72,
      "end": 184.64,
      "text": "चाहते हैं लेकिन ये सब रिसर्च करना,"
    },
    {
      "subtitle_id": 88,
      "start": 182.56,
      "end": 186.64,
      "text": "वैल्यू्यूएशन करना इसके लिए टाइम नहीं दे"
    },
    {
      "subtitle_id": 89,
      "start": 184.64,
      "end": 189.04,
      "text": "पाते। और ऐसे ही बिजी लोगों के लिए वी हैव"
    },
    {
      "subtitle_id": 90,
      "start": 186.64,
      "end": 190.8,
      "text": "लॉन्च्ड EK Pro जिसमें मेरी टीम आपका काम"
    },
    {
      "subtitle_id": 91,
      "start": 189.04,
      "end": 192.239,
      "text": "बिल्कुल आसान करेगी। वह अच्छे शेयर्स"
    },
    {
      "subtitle_id": 92,
      "start": 190.8,
      "end": 194.0,
      "text": "ढूंढेगी। उन पर रिसर्च करेगी,"
    },
    {
      "subtitle_id": 93,
      "start": 192.239,
      "end": 195.36,
