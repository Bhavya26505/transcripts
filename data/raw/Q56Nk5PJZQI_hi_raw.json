  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.0,
      "end": 4.16,
      "text": "अभी दो दिन पहले हमने Tata कैपिटल पर"
    },
    {
      "subtitle_id": 2,
      "start": 1.92,
      "end": 5.759,
      "text": "वीडियो बनाया उनके आईपीओ पर और सारे"
    },
    {
      "subtitle_id": 3,
      "start": 4.16,
      "end": 7.52,
      "text": "कमेंट्स में यही बोल रहे थे कि LG"
    },
    {
      "subtitle_id": 4,
      "start": 5.759,
      "end": 8.96,
      "text": "इलेक्ट्रॉनिक्स पर बनाइए। वैसे कोई प्लान"
    },
    {
      "subtitle_id": 5,
      "start": 7.52,
      "end": 11.04,
      "text": "नहीं था हमारा कमेंट्स ज्यादा आए तो"
    },
    {
      "subtitle_id": 6,
      "start": 8.96,
      "end": 13.04,
      "text": "रिसर्च टीम ने भी सीरियसली ले लिया बात को"
    },
    {
      "subtitle_id": 7,
      "start": 11.04,
      "end": 14.559,
      "text": "उठा ली डीआरएच पे रिसर्च शुरू किया। शुरू"
    },
    {
      "subtitle_id": 8,
      "start": 13.04,
      "end": 16.56,
      "text": "करते ही पहली चीज जो पता चली वो बड़ी"
    },
    {
      "subtitle_id": 9,
      "start": 14.559,
      "end": 18.32,
      "text": "इंटरेस्टिंग है और शॉकिंग भी कि कंपनी के"
    },
    {
      "subtitle_id": 10,
      "start": 16.56,
      "end": 20.64,
      "text": "आईपीओ डॉक्यूमेंट्स खुद कह रहे हैं कि जिस"
    },
    {
      "subtitle_id": 11,
      "start": 18.32,
      "end": 22.8,
      "text": "पैरेंट कंपनी पर LG इलेक्ट्रॉनिक्स इंडिया"
    },
    {
      "subtitle_id": 12,
      "start": 20.64,
      "end": 25.519,
      "text": "पूरी तरह से डिपेंड है उसी पैरेंट कंपनी"
    },
    {
      "subtitle_id": 13,
      "start": 22.8,
      "end": 27.119,
      "text": "के साथ इस कंपनी का कोई भी एक्सक्लूसिव"
    },
    {
      "subtitle_id": 14,
      "start": 25.519,
      "end": 28.88,
      "text": "एग्रीमेंट नहीं है। इसका मतलब क्या है?"
    },
    {
      "subtitle_id": 15,
      "start": 27.119,
      "end": 30.4,
      "text": "समझ रहे हो आप? मतलब IPO डॉक्यूमेंट यहां"
    },
    {
      "subtitle_id": 16,
      "start": 28.88,
      "end": 32.719,
      "text": "पर खुद कह रहे हैं कि फ्यूचर में यह"
    },
    {
      "subtitle_id": 17,
      "start": 30.4,
      "end": 34.96,
      "text": "पैरेंट कंपनी इंडिया में किसी भी कंपिटिट"
    },
    {
      "subtitle_id": 18,
      "start": 32.719,
      "end": 36.96,
      "text": "को खड़ा कर सकती है LG Electronics इंडिया"
    },
    {
      "subtitle_id": 19,
      "start": 34.96,
      "end": 38.48,
      "text": "के खिलाफ। तो इतना बोल्ड और ट्रांसपेरेंट"
    },
    {
      "subtitle_id": 20,
      "start": 36.96,
      "end": 40.399,
      "text": "स्टेटमेंट मिलना आईपीओ डॉक्यूमेंट में"
    },
    {
      "subtitle_id": 21,
      "start": 38.48,
      "end": 42.0,
      "text": "बड़ा रेयर है। जनरली कोई ऐसे बताता नहीं"
    },
    {
      "subtitle_id": 22,
      "start": 40.399,
      "end": 43.52,
      "text": "है। तो यहां पर क्रेडिट तो देना पड़ेगा"
    },
    {
      "subtitle_id": 23,
      "start": 42.0,
      "end": 45.2,
      "text": "इन्हें ट्रांसपेरेंसी के लिए। सही मायने"
    },
    {
      "subtitle_id": 24,
      "start": 43.52,
      "end": 47.28,
      "text": "में वो ट्रांसपेरेंसी इन्होंने रखी है। और"
    },
    {
      "subtitle_id": 25,
      "start": 45.2,
      "end": 49.6,
      "text": "मेरे हिसाब से आईपीओ जो है वो दवाई की तरह"
    },
    {
      "subtitle_id": 26,
      "start": 47.28,
      "end": 51.76,
      "text": "है। बिना सोचे समझे लोगे तो साइड इफेक्ट्स"
    },
    {
      "subtitle_id": 27,
      "start": 49.6,
      "end": 53.84,
      "text": "हो सकते हैं। और इसी आईपीओ के डीआरएचपी का"
    },
    {
      "subtitle_id": 28,
      "start": 51.76,
      "end": 55.6,
      "text": "डिटेल्ड एनालिसिस और जबरदस्त सिंपल"
    },
    {
      "subtitle_id": 29,
      "start": 53.84,
      "end": 57.039,
      "text": "एक्सप्लेनेशन आज मैं आपके सामने लेकर आया"
    },
    {
      "subtitle_id": 30,
      "start": 55.6,
      "end": 59.12,
      "text": "हूं। अब देखिए ये चीज़ खत्म नहीं होती तो"
    },
    {
      "subtitle_id": 31,
      "start": 57.039,
      "end": 61.12,
      "text": "अगली चीज़ पता चली है कि जो भी इस आईपीओ से"
    },
    {
      "subtitle_id": 32,
      "start": 59.12,
      "end": 62.96,
      "text": "प्रोसीडिंग मिलेगी जो भी पैसा आ रहा है वो"
    },
    {
      "subtitle_id": 33,
      "start": 61.12,
      "end": 64.96,
      "text": "कंपनी अपने एक्सपेंशन के लिए या फिर कंपनी"
    },
    {
      "subtitle_id": 34,
      "start": 62.96,
      "end": 66.96,
      "text": "अपने फायदे के लिए यूज़ नहीं करने वाली। ये"
    },
    {
      "subtitle_id": 35,
      "start": 64.96,
      "end": 68.799,
      "text": "सारा पैसा कंपनी के जो प्रमोटर्स हैं उनके"
    },
    {
      "subtitle_id": 36,
      "start": 66.96,
      "end": 71.04,
      "text": "पास जा रहा है। यानी कंपनी को इस आईपीओ का"
    },
    {
      "subtitle_id": 37,
      "start": 68.799,
      "end": 72.96,
      "text": "या फिर इन पैसों का कुछ भी फायदा नहीं है।"
    },
    {
      "subtitle_id": 38,
      "start": 71.04,
      "end": 75.76,
      "text": "एग्जैक्टली सेम चीज जो Hyundai इंडिया ने"
    },
    {
      "subtitle_id": 39,
      "start": 72.96,
      "end": 77.759,
      "text": "की कि सारा पैसा प्रमोटर्स के पास चला गया"
    },
    {
      "subtitle_id": 40,
      "start": 75.76,
      "end": 79.52,
      "text": "जो साउथ कोरिया में बैठे हैं। कंपनी में"
    },
    {
      "subtitle_id": 41,
      "start": 77.759,
      "end": 81.2,
      "text": "कुछ भी इन्वेस्ट नहीं हुआ और वहां पर तो"
    },
    {
      "subtitle_id": 42,
      "start": 79.52,
      "end": 83.52,
      "text": "बिज़नेस प्रॉस्पेक्ट्स भी काफी ढीले ढाले"
    },
    {
      "subtitle_id": 43,
      "start": 81.2,
      "end": 85.119,
      "text": "से थे। इस कंपनी में कैसे है? आज के इस"
    },
    {
      "subtitle_id": 44,
      "start": 83.52,
      "end": 86.24,
      "text": "वीडियो में करेंगे बात। इसके साथ ही इनके"
    },
    {
      "subtitle_id": 45,
      "start": 85.119,
      "end": 88.0,
      "text": "प्रोडक्ट मैन्युफैक्चरिंग, इनका"
    },
    {
      "subtitle_id": 46,
      "start": 86.24,
      "end": 89.92,
      "text": "फाइनेंसियल ओवरव्यू, रिस्क फ़ैक्टर्स"
    },
    {
      "subtitle_id": 47,
      "start": 88.0,
      "end": 92.56,
      "text": "क्या-क्या इनके रेट फ्लैग्स हैं और साथ ही"
    },
    {
      "subtitle_id": 48,
      "start": 89.92,
      "end": 94.32,
      "text": "कंपनी का वैल्यूएशन कि क्या यह आईपीओ पैसा"
    },
    {
      "subtitle_id": 49,
      "start": 92.56,
      "end": 96.24,
      "text": "लगाने लायक भी है? इन सारी चीजों का"
    },
    {
      "subtitle_id": 50,
      "start": 94.32,
      "end": 98.0,
      "text": "एनालिसिस आज के वीडियो में हो जाएगा।"
    },
    {
      "subtitle_id": 51,
      "start": 96.24,
      "end": 100.079,
      "text": "नमस्कार, मैं प्रसाद आपका आज के इस वीडियो"
    },
    {
      "subtitle_id": 52,
      "start": 98.0,
      "end": 101.92,
      "text": "में स्वागत करता हूं। तो सबसे पहली बात LG"
    },
    {
      "subtitle_id": 53,
      "start": 100.079,
      "end": 104.0,
      "text": "का नाम सबने सुना होगा। आप आपके घर में"
    },
    {
      "subtitle_id": 54,
      "start": 101.92,
      "end": 105.92,
      "text": "कभी ना कभी इनका प्रोडक्ट्स जरूर होगा।"
    },
    {
      "subtitle_id": 55,
      "start": 104.0,
      "end": 108.24,
      "text": "लेकिन जो LG इलेक्ट्रॉनिक्स India LED की"
    },
    {
      "subtitle_id": 56,
      "start": 105.92,
      "end": 109.6,
      "text": "स्टोरी है वह बड़ी इंटरेस्टिंग है। 1997"
    },
    {
      "subtitle_id": 57,
      "start": 108.24,
      "end": 111.36,
      "text": "में यह कंपनी स्टार्ट हुई LG"
    },
    {
      "subtitle_id": 58,
      "start": 109.6,
      "end": 113.6,
      "text": "इलेक्ट्रॉनिक्स के अंडर जो कि साउथ कोरिया"
    },
    {
      "subtitle_id": 59,
      "start": 111.36,
      "end": 115.92,
      "text": "की कंपनी है। इंडिया के हर शहर हर गांव"
    },
    {
      "subtitle_id": 60,
      "start": 113.6,
      "end": 117.52,
      "text": "में LG अपने रेफ्रिजरेटर्स, एसी, वाशिंग"
    },
    {
      "subtitle_id": 61,
      "start": 115.92,
      "end": 119.92,
      "text": "मशीन, टीवी इन जैसे प्रोडक्ट्स के लिए"
    },
    {
      "subtitle_id": 62,
      "start": 117.52,
      "end": 121.52,
      "text": "जाना जाता है। 28 साल का तजुर्बा इन्हें"
    },
    {
      "subtitle_id": 63,
      "start": 119.92,
      "end": 123.52,
      "text": "है। इंडिया में सबसे वाइडेस्ट"
    },
    {
      "subtitle_id": 64,
      "start": 121.52,
      "end": 126.079,
      "text": "डिस्ट्रीब्यूशन नेटवर्क है। 35,000 से"
    },
    {
      "subtitle_id": 65,
      "start": 123.52,
      "end": 128.16,
      "text": "ज्यादा बी टू सी टच पॉइंट्स और 106 सर्विस"
    },
    {
      "subtitle_id": 66,
      "start": 126.079,
      "end": 130.0,
      "text": "सेंटर्स इनके हैं। बड़ा कमाल का काम है।"
    },
    {
      "subtitle_id": 67,
      "start": 128.16,
      "end": 131.52,
      "text": "और मेक इन इंडिया के चलती कंपनी फिलहाल"
    },
    {
      "subtitle_id": 68,
      "start": 130.0,
      "end": 133.12,
      "text": "इंडिया में ही मैन्युफैक्चरिंग पर काफी"
    },
    {
      "subtitle_id": 69,
      "start": 131.52,
      "end": 134.64,
      "text": "ज्यादा फोकस कर रही है। अब अगली चीज"
    },
    {
      "subtitle_id": 70,
      "start": 133.12,
      "end": 136.64,
      "text": "प्रोडक्ट्स तो इनके बहुत सारे हैं लेकिन"
    },
    {
      "subtitle_id": 71,
      "start": 134.64,
      "end": 139.12,
      "text": "इनका मार्केट शेयर कितना है? तो पैनल टीवी"
    },
    {
      "subtitle_id": 72,
      "start": 136.64,
      "end": 141.84,
      "text": "में इनका 27.5% का मार्केट शेयर है।"
    },
    {
      "subtitle_id": 73,
      "start": 139.12,
      "end": 144.08,
      "text": "वाशिंग मशीन में तो ये 33% पर है। उसके"
    },
    {
      "subtitle_id": 74,
      "start": 141.84,
      "end": 146.0,
      "text": "बाद जो फ्रिज है आपका वहां पर भी लगभग 30%"
    },
    {
      "subtitle_id": 75,
      "start": 144.08,
      "end": 148.319,
      "text": "इनका मार्केट शेयर है। कन्वेक्शन"
    },
    {
      "subtitle_id": 76,
      "start": 146.0,
      "end": 150.239,
      "text": "माइक्रोवेव ओवन है। इसमें इनका 50% से"
    },
    {
      "subtitle_id": 77,
      "start": 148.319,
      "end": 151.84,
      "text": "ज्यादा मार्केट शेयर है। मोनोपोली पकड़ लो"
    },
    {
      "subtitle_id": 78,
      "start": 150.239,
      "end": 153.92,
      "text": "आप। स्टेनलेस स्टील टैंक वाले वाटर"
    },
    {
      "subtitle_id": 79,
      "start": 151.84,
      "end": 156.4,
      "text": "प्यूरीिफायर है। उसमें 40% मार्केट शेयर"
    },
    {
      "subtitle_id": 80,
      "start": 153.92,
      "end": 158.16,
      "text": "है और एसी में इनका फिलहाल 20% का मार्केट"
    },
    {
      "subtitle_id": 81,
      "start": 156.4,
      "end": 160.16,
      "text": "शेयर है। यानी जो जो प्रोडक्ट्स ये ला रहे"
    },
    {
      "subtitle_id": 82,
      "start": 158.16,
      "end": 162.08,
      "text": "हैं वहां पर तबाही मचा रहे हैं। तो ऐसे"
    },
    {
      "subtitle_id": 83,
      "start": 160.16,
      "end": 164.64,
      "text": "में आपको यही लगेगा कि अगर मैं रेवेन्यू"
    },
    {
      "subtitle_id": 84,
      "start": 162.08,
      "end": 166.48,
      "text": "वाइज जाऊं तो LG इलेक्ट्रॉनिक्स का"
    },
    {
      "subtitle_id": 85,
      "start": 164.64,
      "end": 168.319,
      "text": "रेवेन्यू इंडिया में सबसे ज्यादा होगा।"
    },
    {
      "subtitle_id": 86,
      "start": 166.48,
      "end": 170.48,
      "text": "लेकिन ऐसा नहीं है। यहां पर आप इस चार्ट"
    },
    {
      "subtitle_id": 87,
      "start": 168.319,
      "end": 173.2,
      "text": "में देख सकते हो Samsung यहां पर काफी ऊपर"
    },
    {
      "subtitle_id": 88,
      "start": 170.48,
      "end": 176.16,
      "text": "है और Samsung और LG के बीच का फासला काफी"
    },
    {
      "subtitle_id": 89,
      "start": 173.2,
      "end": 178.319,
      "text": "ज्यादा है। और ज्यादा किस लिए? तो Samsung"
    },
    {
      "subtitle_id": 90,
      "start": 176.16,
      "end": 180.4,
      "text": "स्मार्टफोन से बहुत ज्यादा रेवेन्यू जनरेट"
    },
    {
      "subtitle_id": 91,
      "start": 178.319,
      "end": 181.84,
      "text": "करता है जो कि LG नहीं करता। तो LG"
    },
    {
      "subtitle_id": 92,
      "start": 180.4,
      "end": 184.56,
      "text": "इलेक्ट्रॉनिक्स इंडिया आता है दो नंबर पे"
    },
    {
      "subtitle_id": 93,
      "start": 181.84,
      "end": 186.64,
      "text": "फिर आता है God फिर आता हैवels एंड सो ऑन"
    },
    {
      "subtitle_id": 94,
      "start": 184.56,
      "end": 188.08,
      "text": "सो फोर्थ। अगर इनके बिजनेस मॉडल की बात"
    },
    {
      "subtitle_id": 95,
