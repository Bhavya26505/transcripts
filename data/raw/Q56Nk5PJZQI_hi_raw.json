    {
      "subtitle_id": 289,
      "start": 570.32,
      "end": 574.16,
      "text": "में चाहे तो यह कंपनी LG इलेक्ट्रॉनिक्स"
    },
    {
      "subtitle_id": 290,
      "start": 572.48,
      "end": 575.44,
      "text": "इंडिया को भी कमपीट कर सकती है अपने खुद"
