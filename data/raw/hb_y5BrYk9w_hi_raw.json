    {
      "subtitle_id": 187,
      "start": 394.44,
      "end": 398.4,
      "text": "में पैसा डाल रहे इसमें से कई सारे लोग"
    },
    {
      "subtitle_id": 188,
      "start": 396.039,
      "end": 400.599,
      "text": "पहले नॉर्मल अपना जो मेन मार्केट है उसमें"
    },
    {
      "subtitle_id": 189,
      "start": 398.4,
      "end": 402.919,
      "text": "पैसा लगाते थे वहां पर उन्हें पता चला कि"
