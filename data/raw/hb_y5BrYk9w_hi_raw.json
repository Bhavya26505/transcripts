      "subtitle_id": 146,
      "start": 306.8,
      "end": 312.199,
      "text": "वह 11 करोड़ का था 2023 आते-आते वो 18.8"
    },
    {
      "subtitle_id": 147,
      "start": 310.28,
      "end": 313.72,
      "text": "करोड़ तक पहुंच गया तो मैं अगर आपसे पूछूं"
    },
    {
      "subtitle_id": 148,
      "start": 312.199,
      "end": 315.68,
      "text": "कि यह कैसी ग्रोथ है तो आप कहेंगे यह"
