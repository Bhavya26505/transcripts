  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.32,
      "end": 4.52,
      "text": "एक होती है काल्पनिक दुनिया और एक होती है"
    },
    {
      "subtitle_id": 2,
      "start": 2.399,
      "end": 6.44,
      "text": "वास्तविक दुनिया वैसे तो ये दोनों अलग-अलग"
    },
    {
      "subtitle_id": 3,
      "start": 4.52,
      "end": 8.08,
      "text": "होती है लेकिन ऐसे में आईपीओ के कुछ"
    },
    {
      "subtitle_id": 4,
      "start": 6.44,
      "end": 10.4,
      "text": "रिसेंट ट्रेंड्स को देखा जाए तो ऐसा लगता"
    },
    {
      "subtitle_id": 5,
      "start": 8.08,
      "end": 12.08,
      "text": "है कि काल्पनिक दुनिया और वास्तविक दुनिया"
    },
    {
      "subtitle_id": 6,
      "start": 10.4,
      "end": 13.679,
      "text": "दोनों एक ही है जैसे कि अगर आप"
    },
    {
      "subtitle_id": 7,
      "start": 12.08,
      "end": 15.44,
      "text": "इन्वेस्टमेंट वर्ल्ड से हैं तो आपने यह"
    },
    {
      "subtitle_id": 8,
      "start": 13.679,
      "end": 17.119,
      "text": "जसपाल भट्टी का पीपी वटर बॉल्स वाला"
    },
    {
      "subtitle_id": 9,
      "start": 15.44,
      "end": 19.119,
      "text": "वीडियो तो जरूर देखा होगा इस वीडियो में"
    },
    {
      "subtitle_id": 10,
      "start": 17.119,
      "end": 21.0,
      "text": "गोलगप्पे बेचने वाला ठेला आईपीओ लेकर आता"
    },
    {
      "subtitle_id": 11,
      "start": 19.119,
      "end": 23.439,
      "text": "है और लोग उसमें भी पैसा लगा देते हैं"
    },
    {
      "subtitle_id": 12,
      "start": 21.0,
      "end": 26.32,
      "text": "क्यों यार कुछ भी हो तू अप्लाई कर दे"
    },
    {
      "subtitle_id": 13,
      "start": 23.439,
      "end": 28.4,
      "text": "प्रसाद का अंदाजा कभी गलत नहीं होता और"
    },
    {
      "subtitle_id": 14,
      "start": 26.32,
      "end": 31.039,
      "text": "कुछ ही दिनों में पीपी वटर बॉल्स के ₹10"
    },
    {
      "subtitle_id": 15,
      "start": 28.4,
      "end": 33.36,
      "text": "के शेयर ₹1 के हो जाते हैं जिसके चलते लोग"
    },
    {
      "subtitle_id": 16,
      "start": 31.039,
      "end": 35.48,
      "text": "और पैसा लगाते हैं और आखिर में उनके पैसे"
    },
    {
      "subtitle_id": 17,
      "start": 33.36,
      "end": 39.04,
      "text": "डूब जाते हैं अब यह तो काल्पनिक दुनिया है"
    },
    {
      "subtitle_id": 18,
      "start": 35.48,
      "end": 40.6,
      "text": "इसका रियलिटी से क्या लेना देना राइट रंग"
    },
    {
      "subtitle_id": 19,
      "start": 39.04,
      "end": 42.64,
      "text": "ये स्क्रीन पर न्यूज़ देखिए यह है"
    },
    {
      "subtitle_id": 20,
      "start": 40.6,
      "end": 44.92,
      "text": "वास्तविक दुनिया यह एक कंपनी है जिसका नाम"
    },
    {
      "subtitle_id": 21,
      "start": 42.64,
      "end": 47.12,
      "text": "है रिसोर्सफुल ऑटोमोबाइल्स लिमिटेड यह"
    },
    {
      "subtitle_id": 22,
      "start": 44.92,
      "end": 49.48,
      "text": "बाइक डीलरशिप का काम करती है मात्र दो"
    },
    {
      "subtitle_id": 23,
      "start": 47.12,
      "end": 52.12,
      "text": "शोरूम हैं आठ एंप्लॉयज हैं फाइनेंशियल"
    },
    {
      "subtitle_id": 24,
      "start": 49.48,
      "end": 54.32,
      "text": "2023 में 20 करोड़ का इनका सेल्स था और 40"
    },
    {
      "subtitle_id": 25,
      "start": 52.12,
      "end": 56.12,
      "text": "लाख का प्रॉफिट यह कंपनी अपना एसएमई आईपीओ"
    },
    {
      "subtitle_id": 26,
      "start": 54.32,
      "end": 58.039,
      "text": "लाती हैं 12 करोड़ का और सब्सक्रिप्शन"
    },
    {
      "subtitle_id": 27,
      "start": 56.12,
      "end": 60.719,
      "text": "कितना आता है स्क्रीन पर देखिए रिटेल"
    },
    {
      "subtitle_id": 28,
      "start": 58.039,
      "end": 62.559,
      "text": "इन्वेस्टर्स इसे 496 टाइम सब्सक्राइब कर"
    },
    {
      "subtitle_id": 29,
      "start": 60.719,
      "end": 65.239,
      "text": "देते हैं लगभग"
    },
    {
      "subtitle_id": 30,
      "start": 62.559,
      "end": 68.159,
      "text": "4770 करोड़ का कुल मिलाकर सब्सक्रिप्शन आ"
    },
    {
      "subtitle_id": 31,
      "start": 65.239,
      "end": 70.84,
      "text": "जाता है ₹ करोड़ के आईपीओ को इन नंबर्स को"
    },
    {
      "subtitle_id": 32,
      "start": 68.159,
      "end": 72.28,
      "text": "देखकर आप कह सकते हो कंप्लीट मैडस और अगर"
    },
    {
      "subtitle_id": 33,
      "start": 70.84,
      "end": 74.24,
      "text": "आपको लग रहा है कि ये बस इक्का दुक्का"
    },
    {
      "subtitle_id": 34,
      "start": 72.28,
      "end": 76.56,
      "text": "एग्जांपल्स है तो मैं आपको बता दूं कि आप"
    },
    {
      "subtitle_id": 35,
      "start": 74.24,
      "end": 79.08,
      "text": "गलत हो ये एक ट्रेंड बनते जा रहा है जिसकी"
    },
    {
      "subtitle_id": 36,
      "start": 76.56,
      "end": 80.72,
      "text": "बात होनी बहुत जरूरी है तो बात करेंगे"
    },
    {
      "subtitle_id": 37,
      "start": 79.08,
      "end": 82.88,
      "text": "डिटेल में कि क्या ये जो ट्रेंड है लॉन्ग"
    },
    {
      "subtitle_id": 38,
      "start": 80.72,
      "end": 84.68,
      "text": "टर्म में सस्टेनेबल है और ये चीजें एसएमई"
    },
    {
      "subtitle_id": 39,
      "start": 82.88,
      "end": 86.4,
      "text": "मार्केट में ही क्यों हो रही है इसके बारे"
    },
    {
      "subtitle_id": 40,
      "start": 84.68,
      "end": 88.079,
      "text": "में भी आज हम विस्तार में जानने की कोशिश"
    },
    {
      "subtitle_id": 41,
      "start": 86.4,
      "end": 90.079,
      "text": "करेंगे और हां अंदाजे से कोई बात नहीं"
    },
    {
      "subtitle_id": 42,
      "start": 88.079,
      "end": 92.0,
      "text": "होगी हमेशा की तरह इनोवेशंस पर रिसर्च"
    },
    {
      "subtitle_id": 43,
      "start": 90.079,
      "end": 93.88,
      "text": "बेस्ड और डेटा बेस्ड बातें हो गी क्योंकि"
    },
    {
      "subtitle_id": 44,
      "start": 92.0,
      "end": 96.119,
      "text": "यह प्रसाद उस काल्पनिक दुनिया की प्रसाद"
    },
    {
      "subtitle_id": 45,
      "start": 93.88,
      "end": 98.04,
      "text": "से बिल्कुल अलग है तो चलिए शुरू करते हैं"
    },
    {
      "subtitle_id": 46,
      "start": 96.119,
      "end": 100.36,
      "text": "नमस्कार मैं प्रसाद आपका आज के इस वीडियो"
    },
    {
      "subtitle_id": 47,
      "start": 98.04,
      "end": 102.479,
      "text": "में स्वागत करता हूं अब यह तो एक था शोरूम"
    },
    {
      "subtitle_id": 48,
      "start": 100.36,
      "end": 104.079,
      "text": "वाला ऐसे ही एक नहीं कई एग्जांपल आपको"
    },
    {
      "subtitle_id": 49,
      "start": 102.479,
      "end": 106.479,
      "text": "रिसेंट टाइम में मिल जाएंगे जैसे एक"
    },
    {
      "subtitle_id": 50,
      "start": 104.079,
      "end": 108.479,
      "text": "एग्जांपल बताऊं आपको तो वो था ब्रोच लाइफ"
    },
    {
      "subtitle_id": 51,
      "start": 106.479,
      "end": 110.479,
      "text": "केयर हॉस्पिटल का अब जो ब्रोच लाइफ केयर"
    },
    {
      "subtitle_id": 52,
      "start": 108.479,
      "end": 112.6,
      "text": "हॉस्पिटल है नाम सुनके आपको क्या लगा ये"
    },
    {
      "subtitle_id": 53,
      "start": 110.479,
      "end": 114.479,
      "text": "कोई बड़ा सा हॉस्पिटल होगा मस्त इनके भाई"
    },
    {
      "subtitle_id": 54,
      "start": 112.6,
      "end": 116.96,
      "text": "की 20-25 ब्रांचेस होगी उससे ज्यादा होगी"
    },
    {
      "subtitle_id": 55,
      "start": 114.479,
      "end": 118.52,
      "text": "अलग-अलग लोकेशंस पर हज 2000 इनके बेडस"
    },
    {
      "subtitle_id": 56,
      "start": 116.96,
      "end": 120.759,
      "text": "होंगे तो अगर आप कुछ इस तरह का सोच रहे"
    },
    {
      "subtitle_id": 57,
      "start": 118.52,
      "end": 123.039,
      "text": "हैं तो अभी रुक जाइए लेट शो यू द डाटा यह"
    },
    {
      "subtitle_id": 58,
      "start": 120.759,
      "end": 125.119,
      "text": "मात्र 26 बेड वाला एक हॉस्पिटल था जो आपको"
    },
    {
      "subtitle_id": 59,
      "start": 123.039,
      "end": 127.799,
      "text": "मुंबई पुणे जैसे शहरों में हर कॉलोनी में"
    },
    {
      "subtitle_id": 60,
      "start": 125.119,
      "end": 131.319,
      "text": "मिल जाएगा इन्हें मात्र ₹ करोड़ रेज करने"
    },
    {
      "subtitle_id": 61,
      "start": 127.799,
      "end": 133.12,
      "text": "थे लेकिन सब्सक्रिप्शन मिला ₹ 40 करोड़ का"
    },
    {
      "subtitle_id": 62,
      "start": 131.319,
      "end": 134.84,
      "text": "और भी ढेरों सारे एग्जांपल्स आपको इसमें"
    },
    {
      "subtitle_id": 63,
      "start": 133.12,
      "end": 137.0,
      "text": "मिल जाएंगे इस स्क्रीन पर आप फोटो देख"
    },
    {
      "subtitle_id": 64,
      "start": 134.84,
      "end": 139.12,
      "text": "लीजिए यह अहमदाबाद बेस्ड बॉस पैकेजिंग नाम"
    },
    {
      "subtitle_id": 65,
      "start": 137.0,
      "end": 141.64,
      "text": "की कंपनी का ऑफिस है हालत आप कंपनी की देख"
    },
    {
      "subtitle_id": 66,
      "start": 139.12,
      "end": 143.68,
      "text": "सकते हो यह कंपनी पैकेजिंग लेबलिंग वगैरह"
    },
    {
      "subtitle_id": 67,
      "start": 141.64,
      "end": 146.0,
      "text": "की मशीन सप्लाई करती है भला ही प्लास्टर"
    },
    {
      "subtitle_id": 68,
      "start": 143.68,
      "end": 148.239,
      "text": "बिखर रहा है पन भी उड़ रहा है पर किस्मत"
    },
    {
      "subtitle_id": 69,
      "start": 146.0,
      "end": 150.599,
      "text": "चमक रही है क्यों क्योंकि रिसेंटली इस"
    },
    {
      "subtitle_id": 70,
      "start": 148.239,
      "end": 153.72,
      "text": "कंपनी ने अपना आईपीओ लाया है जो साइज था 8"
    },
    {
      "subtitle_id": 71,
      "start": 150.599,
      "end": 155.56,
      "text": "करोड़ का बीड्स आती है 1000 करोड़ की मतलब"
    },
    {
      "subtitle_id": 72,
      "start": 153.72,
      "end": 157.599,
      "text": "आप सोच के देखिए कि ₹1 करोड़ का प्रॉफिट"
    },
    {
      "subtitle_id": 73,
      "start": 155.56,
      "end": 159.76,
      "text": "है कंपनी का और 1000 करोड़ की बीडिंग आती"
    },
    {
      "subtitle_id": 74,
      "start": 157.599,
      "end": 161.36,
      "text": "है अब इस आईपीओ से आने वाला पैसा कंपनी"
    },
    {
      "subtitle_id": 75,
      "start": 159.76,
      "end": 163.56,
      "text": "कहां पर इन्वेस्ट करने वाली है तो वही"
    },
    {
      "subtitle_id": 76,
      "start": 161.36,
      "end": 165.4,
      "text": "पुरानी वाली स्टोरी कंपनी के ऊपर 3 करोड़"
    },
    {
      "subtitle_id": 77,
      "start": 163.56,
      "end": 167.239,
      "text": "का कर्जा है जिसे चुकता करने के लिए कंपनी"
    },
    {
      "subtitle_id": 78,
      "start": 165.4,
      "end": 169.0,
      "text": "आईपीओ के पैसों का इस्तेमाल करेगी डोंट"
    },
    {
      "subtitle_id": 79,
      "start": 167.239,
      "end": 170.959,
      "text": "गेट मी रॉन्ग छोटी से छोटी कंपनी को भी"
    },
    {
      "subtitle_id": 80,
      "start": 169.0,
      "end": 172.92,
      "text": "अधिकार है अपना एसए में आईपीओ लाने का"
    },
    {
      "subtitle_id": 81,
      "start": 170.959,
      "end": 174.68,
      "text": "लेकिन आपको उसके फंडामेंटल्स भी देखने"
    },
    {
      "subtitle_id": 82,
      "start": 172.92,
      "end": 176.04,
      "text": "पड़ेंगे यहां पर कंपनी की गलती नहीं"
    },
    {
      "subtitle_id": 83,
      "start": 174.68,
      "end": 177.76,
      "text": "उन्होंने एसए में आईपीओ लाया यहां पर"
    },
    {
      "subtitle_id": 84,
      "start": 176.04,
      "end": 179.84,
      "text": "लोगों को समझना पड़ेगा कि किसमें इन्वेस्ट"
    },
    {
      "subtitle_id": 85,
      "start": 177.76,
      "end": 181.599,
      "text": "करना है और किसमें नहीं यह दो तीन"
    },
    {
      "subtitle_id": 86,
      "start": 179.84,
      "end": 183.319,
      "text": "एग्जांपल तो मैंने गिना दिए ऐसी दर्जनों"
    },
    {
      "subtitle_id": 87,
      "start": 181.599,
      "end": 185.12,
      "text": "कंपनीज है अब सब पे बात करूंगा तो ये"
    },
    {
      "subtitle_id": 88,
      "start": 183.319,
      "end": 188.2,
      "text": "वीडियो पूरी एक घंटे की हो जाएगी कहीं एक"
    },
    {
      "subtitle_id": 89,
      "start": 185.12,
      "end": 190.239,
      "text": "छोटा सा vfx3 करोड़ का आईपीओ लाता है उसे"
    },
    {
      "subtitle_id": 90,
      "start": 188.2,
      "end": 192.08,
      "text": "14000 करोड़ का सब्सक्रिप्शन मिल जाता है"
    },
    {
      "subtitle_id": 91,
      "start": 190.239,
      "end": 194.2,
      "text": "और सब लिस्टिंग एन का चक्कर है एएमए में"
    },
    {
      "subtitle_id": 92,
      "start": 192.08,
      "end": 196.239,
      "text": "50 60 पर का लिस्टिंग एन रिटर्न मिलना तो"
    },
    {
      "subtitle_id": 93,
      "start": 194.2,
      "end": 198.239,
      "text": "बहुत ही मामूली बात हो गई है आपने अक्षय"
    },
    {
      "subtitle_id": 94,
      "start": 196.239,
      "end": 200.68,
      "text": "कुमार का ये डायलॉग तो सुना ही होगा कि 21"
    },
    {
      "subtitle_id": 95,
      "start": 198.239,
      "end": 203.36,
      "text": "दिन में पैसा डबल अब ये तो पुराना डायलॉग"
