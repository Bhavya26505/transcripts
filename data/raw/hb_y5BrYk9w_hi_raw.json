    {
      "subtitle_id": 138,
      "start": 288.4,
      "end": 293.16,
      "text": "इस चीज को सपोर्ट नहीं करते बिकॉज़ अगर"
    },
    {
      "subtitle_id": 139,
      "start": 291.039,
      "end": 295.28,
      "text": "6000 पर की ग्रोथ है तो वो भी जस्टिफाइड"
    },
    {
      "subtitle_id": 140,
      "start": 293.16,
      "end": 297.639,
      "text": "है अगर फंडामेंटल्स उसे सपोर्ट करते हैं"
