    {
      "subtitle_id": 124,
      "start": 255.319,
      "end": 260.0,
      "text": "चल रहा है बीएससी का एक इंडेक्स है जिसका"
    },
    {
      "subtitle_id": 125,
      "start": 257.12,
      "end": 261.479,
      "text": "नाम है एसएनपी बीए एसएमई आईपीओ अब निफ्टी"
