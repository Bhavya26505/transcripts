    {
      "subtitle_id": 190,
      "start": 400.599,
      "end": 404.759,
      "text": "आईपीओ में क्विकली पैसा बनता है लेकिन मेन"
    },
    {
      "subtitle_id": 191,
      "start": 402.919,
      "end": 406.919,
      "text": "मार्केट में फिर ऐसा होने लगा कि आईपीओ की"
    },
    {
      "subtitle_id": 192,
      "start": 404.759,
      "end": 408.88,
      "text": "संख्या बहुत कम थी और लगाने वाले बहुत"
    },
    {
      "subtitle_id": 193,
      "start": 406.919,
      "end": 411.4,
      "text": "ज्यादा थे तो इसीलिए इन लोगों ने अपना"
    },
    {
      "subtitle_id": 194,
      "start": 408.88,
      "end": 413.319,
      "text": "मोर्चा पूरा एएमए की तरफ शिफ्ट कर लिया कि"
    },
    {
      "subtitle_id": 195,
      "start": 411.4,
      "end": 414.96,
      "text": "यहां पर हम अब अपॉर्चुनिटी ढूंढते हैं और"
    },
    {
      "subtitle_id": 196,
      "start": 413.319,
      "end": 417.16,
      "text": "फिर एक हर्ड मेंटालिटी की तरह हर कोई"
    },
    {
      "subtitle_id": 197,
      "start": 414.96,
      "end": 419.12,
      "text": "एसएमई आईपीओ पर जाकर टूटने लगा यहां पर"
    },
    {
      "subtitle_id": 198,
      "start": 417.16,
      "end": 420.44,
      "text": "जाना है एसए आईपीओ मुझे लगा क्योंकि मैं"
    },
    {
      "subtitle_id": 199,
      "start": 419.12,
      "end": 422.12,
      "text": "देखता हूं कई सारे लोग ऐसे हैं जिन्हें"
    },
    {
      "subtitle_id": 200,
      "start": 420.44,
      "end": 424.0,
      "text": "शेयर मार्केट कैसे चलता है पता नहीं है पर"
    },
    {
      "subtitle_id": 201,
      "start": 422.12,
      "end": 425.479,
      "text": "वो ऐसे में आईपीओ में पैसा लगाते हैं"
    },
    {
      "subtitle_id": 202,
      "start": 424.0,
      "end": 427.24,
      "text": "क्योंकि उन्हें ये बताया गया कि यहां पर"
    },
    {
      "subtitle_id": 203,
      "start": 425.479,
      "end": 429.36,
      "text": "लिस्टिंग एन मिला तो तुम्हारा पैसा डबल हो"
    },
    {
      "subtitle_id": 204,
      "start": 427.24,
      "end": 430.879,
      "text": "सकता है वो भी सिर्फ 810 दिन में इन्हीं"
    },
    {
      "subtitle_id": 205,
      "start": 429.36,
      "end": 433.039,
      "text": "सारी चीजों को देखकर मुझे एक अंग्रेजी"
    },
    {
      "subtitle_id": 206,
      "start": 430.879,
      "end": 435.599,
      "text": "कहावत याद आती है बुल मार्केट्स आर बोर्न"
    },
    {
      "subtitle_id": 207,
      "start": 433.039,
      "end": 438.12,
      "text": "ऑन पेसिम ज्म ग्रो ऑन स्केप्टिसिजम मच्योर"
    },
    {
      "subtitle_id": 208,
      "start": 435.599,
      "end": 440.199,
      "text": "ऑन ऑप्टिमिस एंड डाई ऑन यूफोरिया अगर हम"
    },
    {
      "subtitle_id": 209,
      "start": 438.12,
      "end": 442.44,
      "text": "एसएमई मार्केट का करंट फेज देखें तो हम"
    },
    {
      "subtitle_id": 210,
      "start": 440.199,
      "end": 444.72,
      "text": "बिल्कुल यूफोरिया पर आ गए हैं कब पिक आउट"
    },
    {
      "subtitle_id": 211,
      "start": 442.44,
      "end": 446.879,
      "text": "करेंगे कोई नहीं बता सकता क्योंकि मार्केट"
    },
    {
      "subtitle_id": 212,
      "start": 444.72,
      "end": 449.72,
      "text": "ये शॉर्ट टर्म में रैशनल ही होता है लेकिन"
    },
    {
      "subtitle_id": 213,
      "start": 446.879,
      "end": 451.879,
      "text": "परमानेंट नहीं तो इसका यह मतलब नहीं कि"
    },
    {
      "subtitle_id": 214,
      "start": 449.72,
      "end": 453.84,
      "text": "सारे एसएम आईपीओ खराब हैं फंडामेंटल्स"
    },
    {
      "subtitle_id": 215,
      "start": 451.879,
      "end": 455.68,
      "text": "उसके स्ट्रांग हैं जो भी ग्रोथ है उसे अगर"
    },
    {
      "subtitle_id": 216,
      "start": 453.84,
      "end": 457.639,
      "text": "फंडामेंटल सपोर्ट करें तो कोई बात नहीं"
    },
    {
      "subtitle_id": 217,
      "start": 455.68,
      "end": 459.84,
      "text": "लेकिन अनफॉर्चूनेटली मेजॉरिटी केसेस में"
    },
    {
      "subtitle_id": 218,
      "start": 457.639,
      "end": 461.84,
      "text": "ऐसा नहीं हो रहा है और यह जो आईपीओ आ रहे"
    },
    {
      "subtitle_id": 219,
      "start": 459.84,
      "end": 464.68,
      "text": "हैं उसमें रेगुलर एक्सचेंज की जगह कंपनीज"
    },
    {
      "subtitle_id": 220,
      "start": 461.84,
      "end": 467.319,
      "text": "आईपीओ ला रही है बीएसी एसएमई या फिर एनएसी"
    },
    {
      "subtitle_id": 221,
      "start": 464.68,
      "end": 469.4,
      "text": "इमर्ज पर इसे एज सच तो कोई इशू नहीं है बट"
    },
    {
      "subtitle_id": 222,
      "start": 467.319,
      "end": 471.759,
      "text": "इस रूट का सहारा लेकर कुछ कंपनीज जिसके"
    },
    {
      "subtitle_id": 223,
      "start": 469.4,
      "end": 474.08,
      "text": "बिजनेस मॉडल और नंबर अच्छे नहीं है वो भी"
    },
    {
      "subtitle_id": 224,
      "start": 471.759,
      "end": 475.8,
      "text": "आईपीओ ला रहे हैं व्हिच इज कंसर्न नहीं अब"
    },
    {
      "subtitle_id": 225,
      "start": 474.08,
      "end": 478.08,
      "text": "यह जो प्रॉब्लम है सिर्फ आपने नहीं बल्कि"
    },
    {
      "subtitle_id": 226,
      "start": 475.8,
      "end": 480.28,
      "text": "सेबी और स्टॉक एक्सचेंज ने भी ऑब्जर्व"
    },
    {
      "subtitle_id": 227,
      "start": 478.08,
      "end": 482.479,
      "text": "किया जिसके बाद अभी एक सितंबर से एक रूल"
    },
    {
      "subtitle_id": 228,
      "start": 480.28,
      "end": 484.759,
      "text": "लागू होगा जिसके अनुसार अगर किसी कंपनी को"
    },
    {
      "subtitle_id": 229,
      "start": 482.479,
      "end": 487.12,
      "text": "एनएसी इमर्ज प्लेटफार्म पर लिस्ट होना है"
    },
    {
      "subtitle_id": 230,
      "start": 484.759,
      "end": 488.759,
      "text": "तो मिनिमम लास्ट के तीन में से 2 साल उनका"
    },
    {
      "subtitle_id": 231,
      "start": 487.12,
      "end": 490.879,
      "text": "जो फ्री कैश फ्लो टू इक्विटी है वो"
    },
    {
      "subtitle_id": 232,
      "start": 488.759,
      "end": 493.039,
      "text": "पॉजिटिव होना चाहिए व्हिच इज एक्चुअली गुड"
    },
    {
      "subtitle_id": 233,
      "start": 490.879,
      "end": 495.479,
      "text": "थिंग लेकिन इसमें अगर अकाउंटिंग रिलेटेड"
    },
    {
      "subtitle_id": 234,
      "start": 493.039,
      "end": 497.36,
      "text": "कुछ प्रॉब्लम हो जाती है तो वो पता करना"
    },
    {
      "subtitle_id": 235,
      "start": 495.479,
      "end": 500.199,
      "text": "इन कंपनीज में बहुत छोटी कंपनीज में बहुत"
    },
    {
      "subtitle_id": 236,
      "start": 497.36,
      "end": 502.08,
      "text": "टफ है इसके अलावा 90 पर का कैप भी लगाया"
    },
    {
      "subtitle_id": 237,
      "start": 500.199,
      "end": 503.919,
      "text": "गया है फर्स्ट डे लिस्टिंग प्राइस पर ये"
    },
    {
      "subtitle_id": 238,
      "start": 502.08,
      "end": 506.199,
      "text": "कोई मैजिक सलूशन नहीं है बट इट विल हेल्प"
    },
    {
      "subtitle_id": 239,
      "start": 503.919,
      "end": 508.08,
      "text": "टू रिड्यूस दिस यूफोरिया टू सम एक्सटेंट"
    },
    {
      "subtitle_id": 240,
      "start": 506.199,
      "end": 510.8,
      "text": "तो अगर आप एसए आईपीओ में इन्वेस्ट करते"
    },
    {
      "subtitle_id": 241,
      "start": 508.08,
      "end": 513.279,
      "text": "हैं तो फंडामेंटल्स को अच्छे से समझिए डीप"
    },
    {
      "subtitle_id": 242,
      "start": 510.8,
      "end": 515.279,
      "text": "में जाइए और फिर देखिए कि कंपनी सस्टेनेबल"
    },
    {
      "subtitle_id": 243,
      "start": 513.279,
      "end": 517.479,
      "text": "है या नहीं क्योंकि रिसेंटली ऐसे कई सारे"
    },
    {
      "subtitle_id": 244,
      "start": 515.279,
      "end": 519.519,
      "text": "मामले आए हैं जहां पर कंपनीज ने काफी कुछ"
    },
    {
      "subtitle_id": 245,
      "start": 517.479,
      "end": 521.56,
      "text": "दिखाया फाइनेंशियल्स में बट एक्चुअल में"
    },
    {
      "subtitle_id": 246,
      "start": 519.519,
      "end": 523.399,
      "text": "कंपनी के पास वैसा कुछ नहीं था तो ये एक"
    },
    {
      "subtitle_id": 247,
      "start": 521.56,
      "end": 525.64,
      "text": "बहुत ही रिस्की गेम है तो अगर आपका ज्यादा"
    },
    {
      "subtitle_id": 248,
      "start": 523.399,
      "end": 529.04,
      "text": "बड़ा रिस्क एपेटाइट नहीं है तो बेटर है कि"
    },
    {
      "subtitle_id": 249,
      "start": 525.64,
      "end": 530.72,
      "text": "आप एसएमई मार्केट से 10 कदम दूर ही रहे"
    },
    {
      "subtitle_id": 250,
      "start": 529.04,
      "end": 532.64,
      "text": "क्योंकि रिसेंटली अभी एक मीटअप में मुझे"
    },
    {
      "subtitle_id": 251,
      "start": 530.72,
      "end": 534.399,
      "text": "कुछ एक दो लोग मिले जिनका सवाल था एसएमई"
    },
    {
      "subtitle_id": 252,
      "start": 532.64,
      "end": 536.08,
      "text": "आईपीओ से रिलेटेड जिन्होंने एक दो आईपीओ"
    },
    {
      "subtitle_id": 253,
      "start": 534.399,
      "end": 537.839,
      "text": "के लिए अप्लाई किया था मैंने उनसे पूछा कि"
    },
    {
      "subtitle_id": 254,
      "start": 536.08,
      "end": 539.959,
      "text": "ठीक है यह सारा फाइनेंशियल्स तो सही है"
    },
    {
      "subtitle_id": 255,
      "start": 537.839,
      "end": 542.24,
      "text": "क्या तुम कंपनी को जानते हो कि वह क्या"
    },
    {
      "subtitle_id": 256,
      "start": 539.959,
      "end": 544.16,
      "text": "करती है वह कहां पर है तो ज्यादातर लोगों"
    },
    {
      "subtitle_id": 257,
      "start": 542.24,
      "end": 546.36,
      "text": "को यह चीजें नहीं पता और क्योंकि एएए का"
    },
    {
      "subtitle_id": 258,
      "start": 544.16,
      "end": 548.88,
      "text": "मार्केट उतना रेगुलेटेड नहीं है जितना कि"
    },
    {
      "subtitle_id": 259,
      "start": 546.36,
      "end": 551.24,
      "text": "मेन मार्केट है तो यहां पर जो मैनिपुलेशन"
    },
    {
      "subtitle_id": 260,
      "start": 548.88,
      "end": 553.04,
      "text": "है उसके चांसेस बहुत ज्यादा होते हैं तो"
    },
    {
      "subtitle_id": 261,
      "start": 551.24,
      "end": 554.92,
      "text": "इसलिए मेरी तो यही राय होगी कि मेनली मेन"
    },
    {
      "subtitle_id": 262,
      "start": 553.04,
      "end": 556.64,
      "text": "मार्केट में इन्वेस्ट कीजिए और रिस्क लेना"
    },
    {
      "subtitle_id": 263,
      "start": 554.92,
      "end": 558.8,
      "text": "ही है तो अपने टोटल पोर्टफोलियो का थोड़ा"
    },
    {
      "subtitle_id": 264,
      "start": 556.64,
      "end": 561.0,
      "text": "बहुत परसेंट नेगलिजिबल ही आप रख सकते हो"
    },
    {
      "subtitle_id": 265,
      "start": 558.8,
      "end": 562.64,
      "text": "बिकॉज दिस इज वेरी रिस्की मतलब रिस्की इन"
    },
    {
      "subtitle_id": 266,
      "start": 561.0,
      "end": 564.399,
      "text": "टर्म्स ऑफ कि यहां पर कुछ गड़बड़ हो गई तो"
    },
    {
      "subtitle_id": 267,
      "start": 562.64,
      "end": 566.399,
      "text": "आपका पूरा का पूरा पैसा जा सकता है इस तरह"
    },
    {
      "subtitle_id": 268,
      "start": 564.399,
      "end": 568.48,
      "text": "का ये मार्केट है तो आज यहीं पर रुकते हैं"
    },
    {
      "subtitle_id": 269,
      "start": 566.399,
      "end": 570.56,
      "text": "ऐसे ही रिसर्च और डेटाबेस वीडियोस के लिए"
    },
    {
      "subtitle_id": 270,
      "start": 568.48,
      "end": 572.0,
      "text": "जरूर चैनल को सब्सक्राइब कीजिए बेल आइकॉन"
    },
    {
      "subtitle_id": 271,
      "start": 570.56,
      "end": 573.959,
      "text": "पर क्लिक कीजिए ताकि इस तरह के वीडियोस के"
    },
    {
      "subtitle_id": 272,
      "start": 572.0,
      "end": 575.92,
      "text": "नोटिफिकेशंस आपको मिलते रहे और वीडियो को"
    },
    {
      "subtitle_id": 273,
      "start": 573.959,
      "end": 577.8,
      "text": "लाइक जरूर दबाइए ताकि आपके जो लाइक्स हैं"
    },
    {
      "subtitle_id": 274,
      "start": 575.92,
      "end": 579.68,
      "text": "हमारी रिसर्च टीम को और मोटिवेट करते हैं"
    },
    {
      "subtitle_id": 275,
      "start": 577.8,
      "end": 581.72,
      "text": "और बेटर रिसर्च करने के लिए और जाते-जाते"
    },
    {
      "subtitle_id": 276,
      "start": 579.68,
      "end": 583.279,
      "text": "हमारा फंडामेंटल एलिसिस 2.0 भी जरूर चेक"
    },
    {
      "subtitle_id": 277,
      "start": 581.72,
      "end": 584.959,
      "text": "आउट कीजिए बहुत ही इंटरेस्टिंग कोर्स है"
    },
    {
      "subtitle_id": 278,
      "start": 583.279,
      "end": 587.12,
      "text": "बहुत ही पॉजिटिव इसके फीडबैक्स है लिंक"
    },
    {
      "subtitle_id": 279,
      "start": 584.959,
      "end": 588.76,
      "text": "नीचे कमेंट बॉक्स में दी गई है मिलते हैं"
    },
    {
      "subtitle_id": 280,
      "start": 587.12,
      "end": 591.64,
      "text": "अगले वीडियो में थैंक यू सो मच फॉर वाचिंग"
    },
    {
      "subtitle_id": 281,
      "start": 588.76,
      "end": 591.64,
      "text": "दिस वीडियो"
    }
  ]
}