    {
      "subtitle_id": 149,
      "start": 313.72,
      "end": 317.8,
      "text": "अच्छी बात है लेकिन आपको बता दूं कि"
    },
    {
      "subtitle_id": 150,
      "start": 315.68,
      "end": 319.96,
      "text": "अनफॉर्चूनेटली इस कंपनी के बारे में ये एक"
