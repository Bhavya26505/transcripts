  "parsing_issues": [],
  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.8,
      "end": 5.52,
      "text": "आज के इस वीडियो की शुरुआत हम एक ट्वीट से"
    },
    {
      "subtitle_id": 2,
      "start": 3.28,
      "end": 7.44,
      "text": "करेंगे जो कि मिस्टर आशीष कछुलिया ने किया"
    },
    {
      "subtitle_id": 3,
      "start": 5.52,
      "end": 8.96,
      "text": "है। मिस्टर आशीष कचोलिया आप में से"
    },
    {
      "subtitle_id": 4,
      "start": 7.44,
      "end": 11.04,
      "text": "ज्यादातर लोगों ने नाम सुना ही होगा जो"
    },
    {
      "subtitle_id": 5,
      "start": 8.96,
      "end": 13.04,
      "text": "इंडियन स्टॉक मार्केट के सबसे सक्सेसफुल"
    },
    {
      "subtitle_id": 6,
      "start": 11.04,
      "end": 16.16,
      "text": "लोग हैं। उनमें से एक मिस्टर कचोलिया"
    },
    {
      "subtitle_id": 7,
      "start": 13.04,
      "end": 18.24,
      "text": "जिनका पोर्टफोलियो सप्टेंबर 2024 में लगभग"
    },
    {
      "subtitle_id": 8,
      "start": 16.16,
      "end": 21.119,
      "text": "3500 करोड़ का था। बाद में मार्केट"
    },
    {
      "subtitle_id": 9,
      "start": 18.24,
      "end": 24.16,
      "text": "करेक्शन के चलते उनका पोर्टफोलियो उस हाई"
    },
    {
      "subtitle_id": 10,
      "start": 21.119,
      "end": 26.56,
      "text": "से 35% नीचे आया और फिर उनकी जो नेटवर्थ"
    },
    {
      "subtitle_id": 11,
      "start": 24.16,
      "end": 28.56,
      "text": "करंट है वह 2300 करोड़ के आसपास है। आज"
    },
    {
      "subtitle_id": 12,
      "start": 26.56,
      "end": 30.32,
      "text": "सुबह सवा5 बजे उन्होंने एक ट्वीट किया कि"
    },
    {
      "subtitle_id": 13,
      "start": 28.56,
      "end": 32.88,
      "text": "मार्केट के साथ जो सबसे बड़ी प्रॉब्लम है"
    },
    {
      "subtitle_id": 14,
      "start": 30.32,
      "end": 35.6,
      "text": "वो यह है कि सबसे बड़ी अपॉर्चुनिटी तब आती"
    },
    {
      "subtitle_id": 15,
      "start": 32.88,
      "end": 37.76,
      "text": "है जब हम सबसे ज्यादा डरे हुए होते हैं।"
    },
    {
      "subtitle_id": 16,
      "start": 35.6,
      "end": 40.079,
      "text": "अब लग रहा है कि स्माल कैप का जो बेयर रन"
    },
    {
      "subtitle_id": 17,
      "start": 37.76,
      "end": 42.079,
      "text": "है वो ऑफिशियली खत्म हो चुका है डॉन्ड"
    },
    {
      "subtitle_id": 18,
      "start": 40.079,
      "end": 44.0,
      "text": "ट्रंप के इंडिया के साथ ट्रेड डील साइन"
    },
    {
      "subtitle_id": 19,
      "start": 42.079,
      "end": 46.879,
      "text": "करने के बाद और जब फिर सुबह मार्केट ओपन"
    },
    {
      "subtitle_id": 20,
      "start": 44.0,
      "end": 49.52,
      "text": "हुआ तो लगभग 5-5% से मेन इंडाइससेस अप थे।"
    },
    {
      "subtitle_id": 21,
      "start": 46.879,
      "end": 51.68,
      "text": "जैसे दिन थोड़ा आगे बढ़ता चला गया थोड़ा"
    },
    {
      "subtitle_id": 22,
      "start": 49.52,
      "end": 54.719,
      "text": "नीचे वह आ गया है। बट अभी भी वीडियो"
    },
    {
      "subtitle_id": 23,
      "start": 51.68,
      "end": 56.8,
      "text": "रिकॉर्ड करते टाइम लगभग 3% मिड कैप अप है"
    },
    {
      "subtitle_id": 24,
      "start": 54.719,
      "end": 58.32,
      "text": "और जो लार्ज कैप इंडाइससेस है वो 2 2.5%"
    },
    {
      "subtitle_id": 25,
      "start": 56.8,
      "end": 60.239,
      "text": "अप है। तो आज के इस वीडियो में हम बात"
    },
    {
      "subtitle_id": 26,
      "start": 58.32,
      "end": 62.399,
      "text": "करेंगे कि क्या यहां से मार्केट की रिकवरी"
    },
    {
      "subtitle_id": 27,
      "start": 60.239,
      "end": 64.0,
      "text": "शुरू हो जाएगी? जैसे कि मिस्टर कचोलिया कह"
    },
    {
      "subtitle_id": 28,
      "start": 62.399,
      "end": 66.0,
      "text": "रहे हैं और साथ ही इस ट्रेड डील की भी हम"
    },
    {
      "subtitle_id": 29,
      "start": 64.0,
      "end": 67.6,
      "text": "बात करेंगे। इस डील के पॉजिटिव्स की सभी"
    },
    {
      "subtitle_id": 30,
      "start": 66.0,
      "end": 69.68,
      "text": "लोग बात कर रहे हैं। इसके कुछ नेगेटिव्स"
    },
    {
      "subtitle_id": 31,
      "start": 67.6,
      "end": 71.04,
      "text": "भी हो सकते हैं कुछ पर्टिकुलर सेक्टर्स के"
    },
    {
      "subtitle_id": 32,
      "start": 69.68,
      "end": 72.479,
      "text": "लिए। तो उनके बारे में भी आज हम बात"
    },
    {
      "subtitle_id": 33,
      "start": 71.04,
      "end": 73.92,
      "text": "करेंगे। देखिए पिछले डेढ़ सालों से"
    },
    {
      "subtitle_id": 34,
      "start": 72.479,
      "end": 75.439,
      "text": "मार्केट में कुछ नहीं हो रहा है। पिछले"
    },
    {
      "subtitle_id": 35,
      "start": 73.92,
      "end": 77.439,
      "text": "डेढ़ सालों में स्माल कैप इंडेक्स बहुत"
    },
    {
      "subtitle_id": 36,
      "start": 75.439,
      "end": 79.759,
      "text": "ज्यादा गिर गया। मिड कैप इंडेक्स भी अच्छा"
    },
    {
      "subtitle_id": 37,
      "start": 77.439,
      "end": 82.0,
      "text": "खासा करेक्ट हुआ। लार्ज कैप इंडेक्स था जो"
    },
    {
      "subtitle_id": 38,
      "start": 79.759,
      "end": 83.52,
      "text": "लगातार बढ़ता रहा। लेकिन फिर जैसे-जैसे"
    },
    {
      "subtitle_id": 39,
      "start": 82.0,
      "end": 85.6,
      "text": "आने वाले क्वार्टर्स आने लगे तो थर्ड"
    },
    {
      "subtitle_id": 40,
      "start": 83.52,
      "end": 87.28,
      "text": "क्वार्टर के एंड में यह पता चला कि लार्ज"
    },
    {
      "subtitle_id": 41,
      "start": 85.6,
      "end": 89.2,
      "text": "कैप में भी अर्निंग्स की प्रॉब्लम आ रही"
    },
    {
      "subtitle_id": 42,
      "start": 87.28,
      "end": 90.64,
      "text": "है कि कंपनीज़ को जिस तरह की ग्रोथ दिखानी"
    },
    {
      "subtitle_id": 43,
      "start": 89.2,
      "end": 92.4,
      "text": "चाहिए। उस तरह की ग्रोथ वहां पर"
    },
    {
      "subtitle_id": 44,
      "start": 90.64,
      "end": 94.4,
      "text": "पर्टिकुलरली लार्ज कैप कंपनीज़ में नहीं आ"
    },
    {
      "subtitle_id": 45,
      "start": 92.4,
      "end": 96.0,
      "text": "रही है। उसके बाद मार्केट लगातार गिरता"
    },
    {
      "subtitle_id": 46,
      "start": 94.4,
      "end": 98.4,
      "text": "रहा। पहले तो पिछला पूरा साल तो हमारा"
    },
    {
      "subtitle_id": 47,
      "start": 96.0,
      "end": 100.799,
      "text": "टेरिफ में चला गया कि ट्रंप ने पहले 25%"
    },
    {
      "subtitle_id": 48,
      "start": 98.4,
      "end": 102.88,
      "text": "का टेरिफ लगाया। फिर बाद में एडिशनल 25%"
    },
    {
      "subtitle_id": 49,
      "start": 100.799,
      "end": 104.96,
      "text": "लगाया और उसी के साथ-साथ फिर एफआईआई साथ"
    },
    {
      "subtitle_id": 50,
      "start": 102.88,
      "end": 106.96,
      "text": "में भाग रहे थे। रूपी हमारा जो है काफी"
    },
    {
      "subtitle_id": 51,
      "start": 104.96,
      "end": 109.2,
      "text": "वीक होता जा रहा है और ऐसे में लोगों की"
    },
    {
      "subtitle_id": 52,
      "start": 106.96,
      "end": 111.28,
      "text": "जो नजरें थी वह बजट पर थी कि शायद यहां पर"
    },
    {
      "subtitle_id": 53,
      "start": 109.2,
      "end": 113.52,
      "text": "बजट बहुत बढ़िया आए तो वहां से मार्केट"
    },
    {
      "subtitle_id": 54,
      "start": 111.28,
      "end": 115.84,
      "text": "में एक रिकवरी आए लेकिन रिकवरी"
    },
    {
      "subtitle_id": 55,
      "start": 113.52,
      "end": 117.84,
      "text": "अनएक्सेक्टेड चीज से आई है। बजट तो काफी"
    },
    {
      "subtitle_id": 56,
      "start": 115.84,
      "end": 119.759,
      "text": "बुरा रहा तो उस हिसाब से मार्केट भी उस"
    },
    {
      "subtitle_id": 57,
      "start": 117.84,
      "end": 121.36,
      "text": "दिन गिरा और फिर कल रात यहां पर न्यूज़ आई"
    },
    {
      "subtitle_id": 58,
      "start": 119.759,
      "end": 124.0,
      "text": "जहां पर ट्वीट के जरिए प्राइम मिनिस्टर"
    },
    {
      "subtitle_id": 59,
      "start": 121.36,
      "end": 125.92,
      "text": "मोदी और और यूएस प्रेसिडेंट डोनल्ड ट्रंप"
    },
    {
      "subtitle_id": 60,
      "start": 124.0,
      "end": 128.399,
      "text": "ने ट्वीट करके बताया कि हमारे बीच डील हुई"
    },
    {
      "subtitle_id": 61,
      "start": 125.92,
      "end": 130.72,
      "text": "है। जिसके चलते जो एडिशनल 25% है वो तो हम"
    },
    {
      "subtitle_id": 62,
      "start": 128.399,
      "end": 133.52,
      "text": "हटा रहे हैं। उसके साथ जो नॉर्मल 25 है वो"
    },
    {
      "subtitle_id": 63,
      "start": 130.72,
      "end": 136.56,
      "text": "भी 18% पे आएगा। मतलब इफेक्टिवली 50% से"
    },
    {
      "subtitle_id": 64,
      "start": 133.52,
      "end": 139.44,
      "text": "हम 18% पर आए हैं। अब यहां पर 18% के लिए"
    },
    {
      "subtitle_id": 65,
      "start": 136.56,
      "end": 141.84,
      "text": "अच्छी बात ये है कि अगर हम बाकी कंट्रीज"
    },
    {
      "subtitle_id": 66,
      "start": 139.44,
      "end": 143.599,
      "text": "को देखें जो यूएस को बहुत बड़ी मात्रा में"
    },
    {
      "subtitle_id": 67,
      "start": 141.84,
      "end": 145.92,
      "text": "एक्सपोर्ट करते हैं तो उसमें चाइना आता"
    },
    {
      "subtitle_id": 68,
      "start": 143.599,
      "end": 147.84,
      "text": "है। चाइना पर 30% का टेररिफ फिलहाल लगा"
    },
    {
      "subtitle_id": 69,
      "start": 145.92,
      "end": 149.12,
      "text": "हुआ है। फिर चाइना प्लस वन पॉलिसी की हम"
    },
    {
      "subtitle_id": 70,
      "start": 147.84,
      "end": 151.36,
      "text": "बात करते हैं। बहुत सारी कंट्रीज चाइना"
    },
    {
      "subtitle_id": 71,
      "start": 149.12,
      "end": 153.04,
      "text": "प्लस वन पॉलिसी को देख रहे थे कि और चाइना"
    },
    {
      "subtitle_id": 72,
      "start": 151.36,
      "end": 154.8,
      "text": "के साथ-साथ एक दो कंट्रीज ऐसी देखे जहां"
    },
    {
      "subtitle_id": 73,
      "start": 153.04,
      "end": 156.8,
      "text": "से हम इंपोर्ट कर पाए। ऐसे में वियतनाम का"
    },
    {
      "subtitle_id": 74,
      "start": 154.8,
      "end": 158.8,
      "text": "नाम काफी ऊपर आ रहा था। वियतनाम पर फिलहाल"
    },
    {
      "subtitle_id": 75,
      "start": 156.8,
      "end": 160.72,
      "text": "जो टेरिफ है वह 20% का है तो इंडिया से"
    },
    {
      "subtitle_id": 76,
      "start": 158.8,
      "end": 163.2,
      "text": "ज्यादा ही है। मेक्सिको पर 25 है।"
    },
    {
      "subtitle_id": 77,
      "start": 160.72,
      "end": 165.599,
      "text": "बांग्लादेश पर 20 है और ब्राजील ऐसा है"
    },
    {
      "subtitle_id": 78,
      "start": 163.2,
      "end": 167.2,
      "text": "जिस पर काफी कम है। 10% 10 लोएस्ट है यूएस"
    },
    {
      "subtitle_id": 79,
      "start": 165.599,
      "end": 169.36,
      "text": "का जो किसी कंट्री पर वो लगाता है। तो"
    },
    {
      "subtitle_id": 80,
      "start": 167.2,
      "end": 170.959,
      "text": "ओवरऑल देखा जाए तो एक बेटर लेवल पर पोजीशन"
    },
    {
      "subtitle_id": 81,
      "start": 169.36,
      "end": 172.56,
      "text": "पर हम आ गए। हां ठीक है। काउंटर करने के"
    },
    {
      "subtitle_id": 82,
      "start": 170.959,
      "end": 175.44,
      "text": "लिए हम ये बोल सकते हैं कि कोरिया और कई"
    },
    {
      "subtitle_id": 83,
      "start": 172.56,
      "end": 177.76,
      "text": "सारी कंट्रीज हैं जिन पर 15% है। लेकिन"
    },
    {
      "subtitle_id": 84,
      "start": 175.44,
      "end": 179.44,
      "text": "ठीक है। एक्सपोर्ट मार्केट में ओवरऑल"
    },
    {
      "subtitle_id": 85,
      "start": 177.76,
      "end": 181.28,
      "text": "मैन्युफैक्चरिंग ले लो बाकी चीजें ले लो।"
    },
    {
      "subtitle_id": 86,
      "start": 179.44,
      "end": 183.12,
      "text": "तो उसमें हमारा चाइना और वियतनाम से काफी"
    },
    {
      "subtitle_id": 87,
      "start": 181.28,
      "end": 184.959,
      "text": "ज्यादा लेना देना है। तो उससे तो फिलहाल"
    },
    {
      "subtitle_id": 88,
      "start": 183.12,
      "end": 186.64,
      "text": "हम कम है। ये अच्छी बात है। आने वाले टाइम"
    },
    {
      "subtitle_id": 89,
      "start": 184.959,
      "end": 187.84,
      "text": "में ये और ज्यादा कम होगा तो और बेटर"
    },
    {
      "subtitle_id": 90,
      "start": 186.64,
      "end": 189.519,
      "text": "होगा। और हां वीडियो में आगे बढ़ने से"
    },
    {
      "subtitle_id": 91,
      "start": 187.84,
      "end": 191.36,
      "text": "पहले क्विकली आपको बता दूं कि अगर आप"
    },
    {
      "subtitle_id": 92,
      "start": 189.519,
      "end": 193.44,
      "text": "वैल्यू्यूएशन निकालने में कहीं पर स्ट्रगल"
    },
    {
      "subtitle_id": 93,
      "start": 191.36,
      "end": 195.04,
      "text": "कर रहे हैं कि कौन सी कंपनी अंडरवैल्यूड"
    },
    {
      "subtitle_id": 94,
      "start": 193.44,
      "end": 196.48,
      "text": "है, कौन सी ओवरवैल्यूड है, यह आपको समझ"
    },
    {
      "subtitle_id": 95,
      "start": 195.04,
      "end": 197.92,
      "text": "में नहीं आता है। और साथ ही आप बहुत"
    },
    {
      "subtitle_id": 96,
      "start": 196.48,
      "end": 199.44,
      "text": "ज्यादा सीरियस है वैल्यू्यूएशन को सीखने"
    },
    {
      "subtitle_id": 97,
      "start": 197.92,
      "end": 201.28,
      "text": "के लिए, पर्टिकुलरली वैल्यू इन्वेस्टिंग"
    },
    {
      "subtitle_id": 98,
      "start": 199.44,
      "end": 203.2,
      "text": "को सीखने के लिए। तो हमारा 3 मंथ्स वीकेंड"
    },
    {
      "subtitle_id": 99,
      "start": 201.28,
      "end": 204.56,
      "text": "प्रोग्राम वैल्यू इन्वेस्टिंग कोहड आपके"
    },
    {
      "subtitle_id": 100,
      "start": 203.2,
      "end": 206.64,
      "text": "लिए है। जहां पर आप वैल्यू इन्वेस्टिंग की"
    },
    {
      "subtitle_id": 101,
      "start": 204.56,
      "end": 208.239,
      "text": "सातों की सातों स्ट्रेटजीस जिसमें सिगारb"
    },
    {
      "subtitle_id": 102,
      "start": 206.64,
      "end": 210.08,
      "text": "स्ट्रेटजी से लेकर डीसीएफ यानी"
    },
    {
      "subtitle_id": 103,
      "start": 208.239,
      "end": 212.319,
      "text": "डिस्काउंटेड कैश फ्लो स्ट्रेटजी तक सारी"
    },
    {
      "subtitle_id": 104,
      "start": 210.08,
      "end": 214.159,
      "text": "स्ट्रेटजीस कवर की गई है। बहुत ही डिटेल"
    },
    {
      "subtitle_id": 105,
      "start": 212.319,
      "end": 215.599,
      "text": "में जो एक आम इंसान को भी बड़े आसानी से"
    },
    {
      "subtitle_id": 106,
      "start": 214.159,
      "end": 217.2,
      "text": "समझ में आए। यह पूरा एक प्रैक्टिकल"
    },
    {
      "subtitle_id": 107,
      "start": 215.599,
      "end": 219.76,
      "text": "प्रोग्राम है जिसमें कोई थ्योरी की हम बात"
    },
    {
      "subtitle_id": 108,
      "start": 217.2,
      "end": 221.519,
      "text": "नहीं करते। 100% अप्लाई करके आपको बताते"
    },
    {
      "subtitle_id": 109,
      "start": 219.76,
      "end": 222.959,
      "text": "हैं। तो अगर आप बहुत सीरियस हैं वैल्यू"
    },
    {
      "subtitle_id": 110,
      "start": 221.519,
      "end": 224.48,
      "text": "स्टिंग को सीखने के लिए तो यह मौका"
    },
    {
      "subtitle_id": 111,
      "start": 222.959,
      "end": 225.68,
      "text": "बिल्कुल मत गवाइए। इसके लिए आपको सिंपली"
    },
    {
      "subtitle_id": 112,
      "start": 224.48,
      "end": 227.28,
      "text": "एक फॉर्म फिल करना है जो नीचे"
    },
    {
      "subtitle_id": 113,
      "start": 225.68,
      "end": 229.44,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में दिया हुआ"
    },
    {
      "subtitle_id": 114,
      "start": 227.28,
      "end": 231.12,
      "text": "है। तो सी यू देयर एंड चलिए अब बढ़ते हैं"
    },
    {
      "subtitle_id": 115,
      "start": 229.44,
      "end": 232.879,
      "text": "वीडियो की तरफ। अभी जो डील की जो टाइमिंग"
    },
    {
      "subtitle_id": 116,
      "start": 231.12,
      "end": 234.56,
      "text": "है यह भी बड़ी इंटरेस्टिंग है। देखिए यूएस"
    },
    {
      "subtitle_id": 117,
      "start": 232.879,
      "end": 236.159,
      "text": "ने क्लियरली कहा था कि आपको रशिया से ऑइल"
    },
    {
      "subtitle_id": 118,
      "start": 234.56,
      "end": 237.92,
      "text": "नहीं लेना है और साथ ही उनका यह भी कहना"
    },
    {
      "subtitle_id": 119,
      "start": 236.159,
      "end": 239.519,
      "text": "था कि हम कुछ एग्रीकल्चर प्रोडक्ट्स और"
    },
    {
      "subtitle_id": 120,
      "start": 237.92,
      "end": 241.04,
      "text": "डेयरी प्रोडक्ट्स इंडिया को एक्सपोर्ट"
    },
    {
      "subtitle_id": 121,
      "start": 239.519,
      "end": 242.48,
      "text": "करना चाहते हैं। अब इंडिया शुरुआत में"
    },
    {
      "subtitle_id": 122,
      "start": 241.04,
      "end": 243.84,
      "text": "दोनों चीजों के लिए नहीं कह रहा था। लेकिन"
    },
    {
      "subtitle_id": 123,
      "start": 242.48,
      "end": 246.72,
      "text": "धीरे-धीरे इन्होंने फिर कहा कि ठीक है"
    },
    {
      "subtitle_id": 124,
      "start": 243.84,
      "end": 249.28,
      "text": "रशिया वाला मामला क्योंकि रशिया में जब यह"
    },
    {
      "subtitle_id": 125,
      "start": 246.72,
      "end": 250.959,
      "text": "रशिया यूक्रेन वॉर शुरू हुआ तो डिस्काउंट"
    },
    {
      "subtitle_id": 126,
      "start": 249.28,
      "end": 253.12,
      "text": "हमें काफी ज्यादा मिल रहा था और वो"
    },
    {
      "subtitle_id": 127,
      "start": 250.959,
      "end": 255.28,
      "text": "डिस्काउंट लगभग 70% से धीरे-धीरे कम होता"
    },
    {
      "subtitle_id": 128,
      "start": 253.12,
      "end": 256.799,
      "text": "चला गया लेकिन फिर भी वो फायदेमंदी था।"
    },
    {
      "subtitle_id": 129,
      "start": 255.28,
      "end": 258.56,
      "text": "ऑयल मार्केटिंग कंपनीज़ के लिए ले लो,"
    },
    {
      "subtitle_id": 130,
      "start": 256.799,
      "end": 261.04,
      "text": "Reliance Industries के लिए ले लो। इसीलिए"
    },
    {
      "subtitle_id": 131,
      "start": 258.56,
      "end": 262.88,
      "text": "अगर आप आईओCL, BPC, HPCL इनकी प्रॉफिट"
    },
    {
      "subtitle_id": 132,
      "start": 261.04,
      "end": 264.72,
      "text": "ग्रोथ देखेंगे तो वो काफी ज्यादा है।"
    },
    {
      "subtitle_id": 133,
      "start": 262.88,
      "end": 266.56,
      "text": "रेवेन्यू ग्रोथ नहीं है क्योंकि प्रॉफिट"
    },
    {
      "subtitle_id": 134,
      "start": 264.72,
      "end": 268.4,
      "text": "मार्जिन बढ़ गई। सस्ते में ऑयल मिल रहा"
    },
    {
      "subtitle_id": 135,
      "start": 266.56,
      "end": 270.24,
      "text": "था। तो जो भी फायदा था वो गवर्नमेंट और"
    },
    {
      "subtitle_id": 136,
      "start": 268.4,
      "end": 271.52,
      "text": "ऑयल मार्केटिंग कंपनीज़ को मिला। मेनली"
    },
    {
      "subtitle_id": 137,
      "start": 270.24,
      "end": 273.12,
      "text": "लोगों तक आया नहीं। लोगों तक तो वही"
    },
    {
      "subtitle_id": 138,
      "start": 271.52,
      "end": 274.88,
      "text": "प्राइस खैर लेकिन इंडिया बड़ा क्लियर था"
    },
    {
      "subtitle_id": 139,
      "start": 273.12,
      "end": 277.6,
      "text": "कि एग्री प्रोडक्ट्स डेयरी प्रोडक्ट्स हम"
    },
    {
      "subtitle_id": 140,
      "start": 274.88,
      "end": 280.24,
      "text": "लाएंगे तो दो चीजें होगी। एक तो हमारे जो"
    },
    {
      "subtitle_id": 141,
      "start": 277.6,
      "end": 282.24,
      "text": "किसान हैं हमारे ही काफी डेयरी इनपुट है।"
    },
    {
      "subtitle_id": 142,
      "start": 280.24,
      "end": 284.0,
      "text": "हमारा ही काफी एग्री इनपुट है। वहां पर"
    },
    {
      "subtitle_id": 143,
      "start": 282.24,
      "end": 285.68,
      "text": "इंपैक्ट होगा। उनकी प्राइस कम हो जाएगी तो"
    },
    {
      "subtitle_id": 144,
      "start": 284.0,
      "end": 287.44,
      "text": "फार्मर्स अफेक्ट होंगे और हम बचपन से"
    },
    {
      "subtitle_id": 145,
      "start": 285.68,
      "end": 289.919,
      "text": "देखते हैं कि कृषि प्रधान देश है। तो ऐसे"
    },
    {
      "subtitle_id": 146,
      "start": 287.44,
      "end": 292.0,
      "text": "में फार्मर्स अफेक्ट होंगे तो इकॉनमी पर"
    },
    {
      "subtitle_id": 147,
      "start": 289.919,
      "end": 293.84,
      "text": "भी इंपैक्ट होगा और इसीलिए डील जो है काफी"
    },
    {
      "subtitle_id": 148,
      "start": 292.0,
      "end": 295.36,
      "text": "लंबे टाइम से स्टक थी। डिस्कशन हो रहा था"
    },
    {
      "subtitle_id": 149,
      "start": 293.84,
      "end": 296.96,
      "text": "लेकिन आगे बढ़ नहीं पा रहा था। तो ऐसे में"
    },
    {
      "subtitle_id": 150,
      "start": 295.36,
      "end": 299.28,
      "text": "मुझे लगता है कि एक मास्टर स्ट्रोक यहां"
    },
    {
      "subtitle_id": 151,
      "start": 296.96,
      "end": 300.72,
      "text": "पर यह था कि इंडियन गवर्नमेंट ने बीच में"
    },
    {
      "subtitle_id": 152,
      "start": 299.28,
      "end": 303.36,
      "text": "फिर न्यूजीलैंड के साथ फ्री ट्रेड"
    },
    {
      "subtitle_id": 153,
      "start": 300.72,
      "end": 305.199,
      "text": "एग्रीमेंट किया मार्च 2025 में। फिर 2025"
    },
    {
      "subtitle_id": 154,
      "start": 303.36,
      "end": 307.36,
      "text": "के एंड में यूके के साथ फ्री ट्रेड"
    },
    {
      "subtitle_id": 155,
      "start": 305.199,
      "end": 308.96,
      "text": "एग्रीमेंट किया और यूएसए वाज़ वाचिंग ऑल"
    },
    {
      "subtitle_id": 156,
      "start": 307.36,
      "end": 310.72,
      "text": "दिस। और थोड़ा लेफ्ट आउट तो उन्होंने"
    },
    {
      "subtitle_id": 157,
      "start": 308.96,
      "end": 313.12,
      "text": "महसूस किया ही होगा अपने को। लेकिन सबसे"
    },
    {
      "subtitle_id": 158,
      "start": 310.72,
      "end": 315.28,
      "text": "बड़ा शौक उनको आया कि हमारे रिपब्लिक डे"
    },
    {
      "subtitle_id": 159,
      "start": 313.12,
      "end": 316.639,
      "text": "पर ईयू को हमने प्राधान्य दिया। यूरोपियन"
    },
    {
      "subtitle_id": 160,
      "start": 315.28,
      "end": 319.28,
      "text": "यूनियन के बड़े-बड़े लीडर्स को हमने"
    },
    {
      "subtitle_id": 161,
      "start": 316.639,
      "end": 321.84,
      "text": "बुलाया। उनके साथ फिर एक डील साइन की 26"
    },
    {
      "subtitle_id": 162,
      "start": 319.28,
      "end": 324.32,
      "text": "अगले दिन यानी 27 जनवरी को जिसे मार्केट"
    },
    {
      "subtitle_id": 163,
      "start": 321.84,
      "end": 326.08,
      "text": "किया गया बार-बार कि मदर ऑफ ऑल डील्स और"
    },
    {
      "subtitle_id": 164,
      "start": 324.32,
      "end": 328.32,
      "text": "जितनी भी डील्स होंगी उसकी मतलब 20 साल से"
    },
    {
      "subtitle_id": 165,
      "start": 326.08,
      "end": 330.639,
      "text": "हमारी ये डील अटकी हुई है। इससे बड़ी"
    },
    {
      "subtitle_id": 166,
      "start": 328.32,
      "end": 332.4,
      "text": "डील्स तो हो ही नहीं सकती और अगर आप"
    },
    {
      "subtitle_id": 167,
      "start": 330.639,
      "end": 334.479,
      "text": "देखेंगे डोनाल्ड ट्रंप को और उनके"
    },
    {
      "subtitle_id": 168,
      "start": 332.4,
      "end": 337.12,
      "text": "बिहेवियर को तो आप समझेंगे कि वो हारना"
    },
    {
      "subtitle_id": 169,
      "start": 334.479,
      "end": 339.12,
      "text": "नहीं चाहते। वह एनी हाउ मतलब वह किसी भी"
    },
    {
      "subtitle_id": 170,
      "start": 337.12,
      "end": 341.12,
      "text": "हद तक जा सकते हैं सिर्फ इसलिए कि हारना"
    },
    {
      "subtitle_id": 171,
      "start": 339.12,
      "end": 344.32,
      "text": "नहीं है क्योंकि वह हमेशा जितनातना पसंद"
    },
    {
      "subtitle_id": 172,
      "start": 341.12,
      "end": 346.32,
      "text": "करते हैं। और जो नोबल पीस प्राइज के लिए"
    },
    {
      "subtitle_id": 173,
      "start": 344.32,
      "end": 348.24,
      "text": "उन्होंने जो काफी कुछ चीजें की उसे आप समझ"
    },
    {
      "subtitle_id": 174,
      "start": 346.32,
      "end": 350.639,
      "text": "सकते हो और फिर मदर ऑफ ऑल द डील्स के बाद"
    },
    {
      "subtitle_id": 175,
      "start": 348.24,
      "end": 352.56,
      "text": "फिर बाद में जोरों शोरों से डिस्कशन फिर"
    },
    {
      "subtitle_id": 176,
      "start": 350.639,
      "end": 354.479,
      "text": "से शुरू हुआ और फिर उसके चार-प दिन बाद ही"
    },
    {
      "subtitle_id": 177,
      "start": 352.56,
      "end": 356.56,
      "text": "अभी अनाउंसमेंट आई। इंडिया ने यूएस के साथ"
    },
    {
      "subtitle_id": 178,
      "start": 354.479,
      "end": 358.24,
      "text": "एक डील साइन की है। अब डील के कुछ"
    },
    {
      "subtitle_id": 179,
      "start": 356.56,
      "end": 360.08,
      "text": "पॉजिटिव्स तो काफी ज्यादा है लेकिन"
    },
    {
      "subtitle_id": 180,
      "start": 358.24,
      "end": 361.759,
      "text": "नेगेटिव्स भी अच्छे खासे हैं। इस डील में"
    },
    {
      "subtitle_id": 181,
      "start": 360.08,
      "end": 363.84,
      "text": "हम क्या-क्या करने वाले हैं? तो हम वहां"
    },
    {
      "subtitle_id": 182,
      "start": 361.759,
      "end": 365.919,
      "text": "से एनर्जी और पेट्रोलियम प्रोडक्ट्स"
    },
    {
      "subtitle_id": 183,
      "start": 363.84,
      "end": 368.0,
      "text": "खरीदने वाले हैं वेनेजुएला से और यूएस से।"
    },
    {
      "subtitle_id": 184,
      "start": 365.919,
      "end": 370.479,
      "text": "तो करेंटली हम रशिया से ले रहे थे तो"
    },
    {
      "subtitle_id": 185,
      "start": 368.0,
      "end": 372.96,
      "text": "दो-तीन प्रॉब्लम्स तो आई है। जो वेनेजुएला"
    },
    {
      "subtitle_id": 186,
      "start": 370.479,
      "end": 375.28,
      "text": "का ऑइल है क्रूड ऑयल वो थोड़ा डर्टी और"
    },
    {
      "subtitle_id": 187,
      "start": 372.96,
      "end": 376.96,
      "text": "चीप माना जाता है। बाकी रशिया की क्वालिटी"
    },
    {
      "subtitle_id": 188,
      "start": 375.28,
      "end": 378.8,
      "text": "से कंपेयर किया जाए तो। साथ ही कुछ लोगों"
    },
    {
      "subtitle_id": 189,
      "start": 376.96,
      "end": 381.36,
      "text": "का यह भी कहना है कि रशिया से जो ऑइल आता"
    },
    {
      "subtitle_id": 190,
      "start": 378.8,
      "end": 383.919,
      "text": "है सो 20 आवर की जर्नी करके आता है। वही"
    },
    {
      "subtitle_id": 191,
      "start": 381.36,
      "end": 386.319,
      "text": "वेनेजुएला से जो आएगा वो कुछ और छोटी-मोटी"
    },
    {
      "subtitle_id": 192,
      "start": 383.919,
      "end": 387.759,
      "text": "प्रोसेसिंग करके लगभग 50-56 आवर्स उसको"
    },
    {
      "subtitle_id": 193,
      "start": 386.319,
      "end": 389.68,
      "text": "लगेंगे इंडिया पहुंचने में। तो ऑइल"
    },
    {
      "subtitle_id": 194,
      "start": 387.759,
      "end": 391.199,
      "text": "प्राइसेस का जो बेनिफिट था शायद वह भी हम"
    },
    {
      "subtitle_id": 195,
      "start": 389.68,
      "end": 392.88,
      "text": "खो रहे हैं क्योंकि क्वालिटी भी उतनी"
    },
    {
      "subtitle_id": 196,
      "start": 391.199,
      "end": 394.639,
      "text": "अच्छी नहीं है Venazu के ऑयल की। साथ ही"
    },
    {
      "subtitle_id": 197,
      "start": 392.88,
      "end": 396.319,
      "text": "भारत यूएस से डिफेंस प्रोडक्ट्स खरीदेगा"
    },
    {
      "subtitle_id": 198,
      "start": 394.639,
      "end": 397.6,
      "text": "और टेलीकॉम प्रोडक्ट्स इलेक्ट्रॉनिक्स और"
    },
    {
      "subtitle_id": 199,
      "start": 396.319,
      "end": 399.28,
      "text": "साथ ही टेक प्रोडक्ट्स भी वहां से"
    },
    {
      "subtitle_id": 200,
      "start": 397.6,
      "end": 401.759,
      "text": "खरीदेगा। ओवरऑल देखा जाए तो हाफ अ"
    },
    {
      "subtitle_id": 201,
      "start": 399.28,
      "end": 403.759,
      "text": "ट्रिलियन डॉलर यानी कि लगभग $45 लाख करोड़"
    },
    {
      "subtitle_id": 202,
      "start": 401.759,
      "end": 405.36,
      "text": "के जो प्रोडक्ट्स हैं हम यूएस से खरीदने"
    },
    {
      "subtitle_id": 203,
      "start": 403.759,
      "end": 407.199,
      "text": "वाले हैं। और साथ ही वहां के कई सारे"
    },
    {
      "subtitle_id": 204,
      "start": 405.36,
      "end": 409.12,
      "text": "प्रोडक्ट्स इंडिया में आएंगे जिन पर कुछ"
    },
    {
      "subtitle_id": 205,
      "start": 407.199,
      "end": 410.88,
      "text": "पर ड्यूटी नहीं लगेगी। कुछ पर कम हो सकती"
    },
    {
      "subtitle_id": 206,
      "start": 409.12,
      "end": 413.28,
      "text": "है। जैसे लग्जरी कार्स की बात करें जो"
    },
    {
      "subtitle_id": 207,
      "start": 410.88,
      "end": 415.28,
      "text": "यूरोप से आती थी उन पर 110% की इंपोर्ट"
    },
    {
      "subtitle_id": 208,
      "start": 413.28,
      "end": 417.039,
      "text": "ड्यूटी लगती थी जो कम करके उन्होंने 40%"
    },
    {
      "subtitle_id": 209,
      "start": 415.28,
      "end": 418.4,
      "text": "की। अब यूएस के लिए भी ऐसा एक-दो सेक्टर"
    },
    {
      "subtitle_id": 210,
      "start": 417.039,
      "end": 420.4,
      "text": "में हुआ तो इंडिया में एक-दो सेक्टर"
    },
    {
      "subtitle_id": 211,
      "start": 418.4,
      "end": 422.319,
      "text": "इंपैक्ट करेंगे। बट फिलहाल के लिए अच्छी"
    },
    {
      "subtitle_id": 212,
      "start": 420.4,
      "end": 424.319,
      "text": "बात यह है कि एक्सपोर्ट हमारा फिर से ओपन"
    },
    {
      "subtitle_id": 213,
      "start": 422.319,
      "end": 426.72,
      "text": "होगा और साथ ही इस एक्सपोर्ट मतलब यह"
    },
    {
      "subtitle_id": 214,
      "start": 424.319,
      "end": 428.88,
      "text": "अच्छा हुआ मुझे लगता है कि यूएस का यू नो"
    },
    {
      "subtitle_id": 215,
      "start": 426.72,
      "end": 431.12,
      "text": "प्रॉब्लम हो गया जिसकी वजह से हमने और"
    },
    {
      "subtitle_id": 216,
      "start": 428.88,
      "end": 432.479,
      "text": "चारप कंट्रीज यूरोपियन यूनियन के साथ भी"
    },
    {
      "subtitle_id": 217,
      "start": 431.12,
      "end": 434.16,
      "text": "डील कर दिया और बहुत अच्छी डील है उनके"
    },
    {
      "subtitle_id": 218,
      "start": 432.479,
      "end": 435.84,
      "text": "साथ। सो उससे काफी ज्यादा फायदा मिलेगा।"
    },
    {
      "subtitle_id": 219,
      "start": 434.16,
      "end": 437.52,
      "text": "हालांकि उतना चेयर मिला नहीं मार्केट से"
    },
    {
      "subtitle_id": 220,
      "start": 435.84,
      "end": 439.759,
      "text": "उन चीजों के लिए बट लॉन्ग टर्म पॉइंट ऑफ"
    },
    {
      "subtitle_id": 221,
      "start": 437.52,
      "end": 441.44,
      "text": "व्यू वो बहुत अच्छी डील है इयू के साथ और"
    },
    {
      "subtitle_id": 222,
      "start": 439.759,
      "end": 443.12,
      "text": "वो लॉन्ग टर्म चली गई। ऐसा नहीं कि ट्रंप"
    },
    {
      "subtitle_id": 223,
      "start": 441.44,
      "end": 444.88,
      "text": "जैसे कि अभी क्या बोला, चार दिन बाद क्या"
    },
    {
      "subtitle_id": 224,
      "start": 443.12,
      "end": 446.4,
      "text": "बोला और एक और इंटरेस्टिंग बात मैं आपको"
    },
    {
      "subtitle_id": 225,
      "start": 444.88,
      "end": 448.16,
      "text": "बताना यहां पर चाहता हूं कि जनरली क्या"
    },
    {
      "subtitle_id": 226,
      "start": 446.4,
      "end": 449.84,
      "text": "होता है ट्रेड डील का ऑफिशियल डॉक्यूमेंट"
    },
    {
      "subtitle_id": 227,
      "start": 448.16,
      "end": 451.44,
      "text": "साइन होता है और उसके बाद अनाउंसमेंट की"
    },
    {
      "subtitle_id": 228,
      "start": 449.84,
      "end": 453.599,
      "text": "जाती है। लेकिन यहां पर पहले अनाउंसमेंट"
    },
    {
      "subtitle_id": 229,
      "start": 451.44,
      "end": 455.039,
      "text": "की गई है। ऑफिशियल डॉक्यूमेंट अभी साइन"
    },
    {
      "subtitle_id": 230,
      "start": 453.599,
      "end": 457.039,
      "text": "होने बाकी है। अब ट्रंप उसके लिए इंडिया"
    },
    {
      "subtitle_id": 231,
      "start": 455.039,
      "end": 459.12,
      "text": "आके साइन करेंगे या फिर और कुछ होता है वो"
    },
    {
      "subtitle_id": 232,
      "start": 457.039,
      "end": 460.8,
      "text": "अब देखना पड़ेगा और डॉक्यूमेंट में भी जो"
    },
    {
      "subtitle_id": 233,
      "start": 459.12,
      "end": 462.72,
      "text": "चीजें बोली गई है वही होती है या फिर तब"
    },
    {
      "subtitle_id": 234,
      "start": 460.8,
      "end": 464.16,
      "text": "तक वापस कुछ चीजें बदल जाती है। तो वो भी"
    },
    {
      "subtitle_id": 235,
      "start": 462.72,
      "end": 466.0,
      "text": "थोड़ी एक चीजें इंटरेस्टिंग रहेगी। तो ये"
    },
    {
      "subtitle_id": 236,
      "start": 464.16,
      "end": 467.68,
      "text": "तो हो गई ट्रेड की बातें। अगर हम स्टॉक"
    },
    {
      "subtitle_id": 237,
      "start": 466.0,
      "end": 469.44,
      "text": "मार्केट की बात करें तो मार्केट को क्या"
    },
    {
      "subtitle_id": 238,
      "start": 467.68,
      "end": 471.36,
      "text": "है कि लंबे टाइम से कुछ ना कुछ एक राहत"
    },
    {
      "subtitle_id": 239,
      "start": 469.44,
      "end": 473.12,
      "text": "चाहिए थी और एक बड़ी राहत यहां पर आ गई।"
    },
    {
      "subtitle_id": 240,
      "start": 471.36,
      "end": 475.12,
      "text": "इसीलिए हमने देखा कि एक विस्फोट हुआ।"
    },
    {
      "subtitle_id": 241,
      "start": 473.12,
      "end": 477.44,
      "text": "सुबह-सुबह अचानक से मार्केट ने बहुत तेजी"
    },
    {
      "subtitle_id": 242,
      "start": 475.12,
      "end": 480.0,
      "text": "से रिकवरी दिखाई और मार्केट काफी तेजी से"
    },
    {
      "subtitle_id": 243,
      "start": 477.44,
      "end": 481.759,
      "text": "अभी आगे की ओर बढ़ चुका है। ऑलरेडी हमने"
    },
    {
      "subtitle_id": 244,
      "start": 480.0,
      "end": 484.16,
      "text": "देखा कि बहुत सारे सेक्टर्स काफी ज्यादा"
    },
    {
      "subtitle_id": 245,
      "start": 481.759,
      "end": 486.08,
      "text": "गिर चुके थे। पिछले चारप महीनों में और"
    },
    {
      "subtitle_id": 246,
      "start": 484.16,
      "end": 487.919,
      "text": "पिछले दो महीनों से मैं लगातार यह कहते आ"
    },
    {
      "subtitle_id": 247,
      "start": 486.08,
      "end": 489.44,
      "text": "रहा हूं कि मार्केट में अपॉर्चुनिटीज़ बन"
    },
    {
      "subtitle_id": 248,
      "start": 487.919,
      "end": 491.759,
      "text": "रही है। मार्केट गिर रहा है। गिर रहा है।"
    },
    {
      "subtitle_id": 249,
      "start": 489.44,
      "end": 495.199,
      "text": "अपोरर्चुनिटीज़ आप धीरे-धीरे खरीदिए। एक"
    },
    {
      "subtitle_id": 250,
      "start": 491.759,
      "end": 497.36,
      "text": "साथ मत जाइए। बट 2026 इज़ अ ईयर ऑफ परचेस।"
    },
    {
      "subtitle_id": 251,
      "start": 495.199,
      "end": 499.039,
      "text": "उस तरह के कुछ डिस्काउंट्स रहे हैं। ऐसा"
    },
    {
      "subtitle_id": 252,
      "start": 497.36,
      "end": 500.879,
      "text": "नहीं कि आज का मार्केट ऊपर चला गया तो"
    },
    {
      "subtitle_id": 253,
      "start": 499.039,
      "end": 502.879,
      "text": "सारे डिस्काउंट्स चले गए। अभी भी आप"
    },
    {
      "subtitle_id": 254,
      "start": 500.879,
      "end": 505.28,
      "text": "देखेंगे पिछले 3 महीने में जो गिरावट हुई"
    },
    {
      "subtitle_id": 255,
      "start": 502.879,
      "end": 508.879,
      "text": "है उसका बस मतलब बहुत सारे स्टॉक्स और"
    },
    {
      "subtitle_id": 256,
      "start": 505.28,
      "end": 511.599,
      "text": "सेक्टर 20% 30% से गिरे हैं। अब आज"
    },
    {
      "subtitle_id": 257,
      "start": 508.879,
      "end": 514.88,
      "text": "हालांकि 4 1% से रिकवर हुए हैं। बट अ बिग"
    },
    {
      "subtitle_id": 258,
      "start": 511.599,
      "end": 517.839,
      "text": "रिकवरी स्टिल पेंडिंग। तो अभी भी मतलब जो"
    },
    {
      "subtitle_id": 259,
      "start": 514.88,
      "end": 520.159,
      "text": "ऑप्शन है, चांस है वह गया नहीं है। तो ऐसे"
    },
    {
      "subtitle_id": 260,
      "start": 517.839,
      "end": 521.68,
      "text": "में मतलब जैसे-जैसे आप भी मार्केट को"
    },
    {
      "subtitle_id": 261,
      "start": 520.159,
      "end": 524.48,
      "text": "ऑब्जर्व कीजिए क्या होता है, क्या नहीं"
    },
    {
      "subtitle_id": 262,
      "start": 521.68,
      "end": 526.64,
      "text": "होता है और यहां पर एक इन्वेस्टमेंट"
    },
    {
      "subtitle_id": 263,
      "start": 524.48,
      "end": 528.16,
      "text": "प्लानिंग से एक डिस्काउंटेड स्टॉक्स को"
    },
    {
      "subtitle_id": 264,
      "start": 526.64,
      "end": 529.68,
      "text": "ढूंढने की कोशिश कीजिए जो अंडरवैल्यूड"
    },
    {
      "subtitle_id": 265,
      "start": 528.16,
      "end": 531.76,
      "text": "आपको लग रहे हैं। फंडामेंटली काफी"
    },
    {
      "subtitle_id": 266,
      "start": 529.68,
      "end": 533.839,
      "text": "स्ट्रांग है। क्योंकि फिर ऐसा टाइम एक बार"
    },
    {
      "subtitle_id": 267,
      "start": 531.76,
      "end": 535.68,
      "text": "हाथ से गया तो आता नहीं है। ऐसा स्माल कैप"
    },
    {
      "subtitle_id": 268,
      "start": 533.839,
      "end": 537.839,
      "text": "में सिमिलर टाइम 2022 में आया था। मुझे"
    },
    {
      "subtitle_id": 269,
      "start": 535.68,
      "end": 540.16,
      "text": "याद है जब रशिया यूक्रेन वॉर शुरू हो गया"
    },
    {
      "subtitle_id": 270,
      "start": 537.839,
      "end": 541.839,
      "text": "था फरवरी में। तब भी स्माल कैप काफी"
    },
    {
      "subtitle_id": 271,
      "start": 540.16,
      "end": 545.2,
      "text": "ज्यादा घिरे और फिर स्माल कैप में आप"
    },
    {
      "subtitle_id": 272,
      "start": 541.839,
      "end": 547.36,
      "text": "देखोगे तो 2023 में बड़ी तगड़ी रिकवरी थी"
    },
    {
      "subtitle_id": 273,
      "start": 545.2,
      "end": 551.92,
      "text": "और फिर काफी सारा पैसा उस टाइम स्माल कैप"
    },
    {
      "subtitle_id": 274,
      "start": 547.36,
      "end": 554.08,
      "text": "में बनाया गया। 2023 24 देन 24 के एंड से"
    },
    {
      "subtitle_id": 275,
      "start": 551.92,
      "end": 557.2,
      "text": "फिर स्माल कैप गिरने लगे। 25 तो पूरा डाउन"
    },
    {
      "subtitle_id": 276,
      "start": 554.08,
      "end": 559.839,
      "text": "थे। अभी 26 में अगर वो रिकवर होते आ गए या"
    },
    {
      "subtitle_id": 277,
      "start": 557.2,
      "end": 562.24,
      "text": "फिर 27 में रिकवर होते हैं। तो उससे पहले"
    },
    {
      "subtitle_id": 278,
      "start": 559.839,
      "end": 564.16,
      "text": "आपको थोड़ा एक यू नो डिस्काउंट परचेसिंग"
    },
    {
      "subtitle_id": 279,
      "start": 562.24,
      "end": 566.24,
      "text": "करनी पड़ेगी। क्योंकि बहुत सारी कंपनीज़ जो"
    },
    {
      "subtitle_id": 280,
      "start": 564.16,
      "end": 568.0,
      "text": "हेवीली गिरी है। एक कंपनी पर मैंने लास्ट"
    },
    {
      "subtitle_id": 281,
      "start": 566.24,
      "end": 569.68,
      "text": "टाइम भी कहा था कि कुछ कंपनीज़ हैं जिन पर"
    },
    {
      "subtitle_id": 282,
      "start": 568.0,
      "end": 571.92,
      "text": "मैं भी नजर रख रहा हूं। कुछ रिन्यूएबल"
    },
    {
      "subtitle_id": 283,
      "start": 569.68,
      "end": 574.0,
      "text": "सेक्टर से है। कुछ डाटा सेंटर सेक्टर से"
    },
    {
      "subtitle_id": 284,
      "start": 571.92,
      "end": 575.519,
      "text": "है। कुछ हाउसिंग फाइनेंस सेक्टर से है। एक"
    },
    {
      "subtitle_id": 285,
      "start": 574.0,
      "end": 578.16,
      "text": "नाम मैं आपको बता दूं तो Bajaj Housing"
    },
    {
      "subtitle_id": 286,
      "start": 575.519,
      "end": 580.24,
      "text": "Housing Finance तो अभी तक मैंने कोई"
    },
    {
      "subtitle_id": 287,
      "start": 578.16,
      "end": 582.72,
      "text": "पोजीशन नहीं ली है। बट जस्ट टू टेल यू कि"
    },
    {
      "subtitle_id": 288,
      "start": 580.24,
      "end": 584.8,
      "text": "यह वही स्टॉक है जो 70-80 के पीई पर ट्रेड"
    },
    {
      "subtitle_id": 289,
      "start": 582.72,
      "end": 586.72,
      "text": "हो रहा था। आज 30 के पीई पर आ गया है।"
    },
    {
      "subtitle_id": 290,
      "start": 584.8,
      "end": 588.72,
      "text": "काफी शार्प करेक्शन हमें देखने मिला है।"
    },
    {
      "subtitle_id": 291,
      "start": 586.72,
      "end": 591.2,
      "text": "काफी ओवरवैल्यूड था जब 70-80 पे था। तो ऑफ"
    },
    {
      "subtitle_id": 292,
      "start": 588.72,
      "end": 592.959,
      "text": "कोर्स लुकिंग एट द ग्रोथ जो 25 30% की"
    },
    {
      "subtitle_id": 293,
      "start": 591.2,
      "end": 594.56,
      "text": "उनकी चल रही है। बट ये है कि उस तरह के"
    },
    {
      "subtitle_id": 294,
      "start": 592.959,
      "end": 596.16,
      "text": "ऑप्शंस मतलब आने वाले टाइम में एक्सपेक्ट"
    },
    {
      "subtitle_id": 295,
      "start": 594.56,
      "end": 598.0,
      "text": "करते हैं कि और ज्यादा कुछ ना कुछ वहां पर"
    },
    {
      "subtitle_id": 296,
      "start": 596.16,
      "end": 599.6,
      "text": "हो। तो इस तरह आप भी ओपोरर्चुनिटी को जरूर"
    },
    {
      "subtitle_id": 297,
      "start": 598.0,
      "end": 601.2,
      "text": "ढूंढिए। इस पर्टिकुलर मार्केट में थोड़ा"
    },
    {
      "subtitle_id": 298,
      "start": 599.6,
      "end": 603.2,
      "text": "टाइम स्पेंड करने की जरूरत है। ऐसा यह"
    },
    {
      "subtitle_id": 299,
      "start": 601.2,
      "end": 605.04,
      "text": "मार्केट है। यहां पर थोड़ी पढ़ाई करोगे।"
    },
    {
      "subtitle_id": 300,
      "start": 603.2,
      "end": 607.44,
      "text": "पढ़ाई मतलब थोड़ा डीप में जाइए, रिसर्च"
    },
    {
      "subtitle_id": 301,
      "start": 605.04,
      "end": 609.839,
      "text": "कीजिए। उनके कॉन्फ्रेंस कॉल देखिए, सुनिए,"
    },
    {
      "subtitle_id": 302,
      "start": 607.44,
      "end": 611.839,
      "text": "ग्रोथ के बारे में समझिए। वैल्यू्यूएशन के"
    },
    {
      "subtitle_id": 303,
      "start": 609.839,
      "end": 613.92,
      "text": "बारे में समझिए। और जो जो अंडरवैलड उन्हें"
    },
    {
      "subtitle_id": 304,
      "start": 611.839,
      "end": 616.48,
      "text": "पिक करके यह टाइम पे अगर आप बैठ गए और"
    },
    {
      "subtitle_id": 305,
      "start": 613.92,
      "end": 618.48,
      "text": "उन्हें लेकर आप बैठो 510 साल एंड देन द"
    },
    {
      "subtitle_id": 306,
      "start": 616.48,
      "end": 620.399,
      "text": "रियल मैजिक विल हैपन। और अगेन मैं कहूंगा"
    },
    {
      "subtitle_id": 307,
      "start": 618.48,
      "end": 621.6,
      "text": "कि ऐसे टाइम बार-बार आते नहीं है। एक साथ"
    },
    {
      "subtitle_id": 308,
      "start": 620.399,
      "end": 622.88,
      "text": "भी आपको इन्वेस्ट नहीं करना है कि सारा"
    },
    {
      "subtitle_id": 309,
      "start": 621.6,
      "end": 625.2,
      "text": "पैसा एक साथ डाल दिया, फिर मार्केट और"
    },
    {
      "subtitle_id": 310,
      "start": 622.88,
      "end": 627.36,
      "text": "गिरा दो। फिर पछतावा यार थोड़ा और मुझे"
    },
    {
      "subtitle_id": 311,
      "start": 625.2,
      "end": 629.839,
      "text": "रखना चाहिए था। स्टेप बाय स्टेप आप कर"
    },
    {
      "subtitle_id": 312,
      "start": 627.36,
      "end": 632.24,
      "text": "सकते हो। लेकिन बस बने रहिए और इसी मैसेज"
    },
    {
      "subtitle_id": 313,
      "start": 629.839,
      "end": 633.68,
      "text": "के साथ में वीडियो को आज समाप्त करता हूं।"
    },
    {
      "subtitle_id": 314,
      "start": 632.24,
      "end": 635.6,
      "text": "मिलते हैं अगले वीडियो में। कुछ भी डाउट"
    },
    {
      "subtitle_id": 315,
      "start": 633.68,
      "end": 637.36,
      "text": "रहेगा आपको नीचे कमेंट करके जरूर बताइए।"
    },
    {
      "subtitle_id": 316,
      "start": 635.6,
      "end": 639.2,
      "text": "आई विल ट्राई टू सॉल्व। और नेक्स्ट किस"
    },
    {
      "subtitle_id": 317,
      "start": 637.36,
      "end": 641.519,
      "text": "चीज पर हमें बात करनी चाहिए कमेंट करके"
    },
    {
      "subtitle_id": 318,
      "start": 639.2,
      "end": 643.279,
      "text": "जरूर बताइए। सी यू देर। बट राइट नाउ अगर"
    },
    {
      "subtitle_id": 319,
      "start": 641.519,
      "end": 644.72,
      "text": "देखा जाए कंक्लूड किया जाए तो वी आर गोइंग"
    },
    {
      "subtitle_id": 320,
      "start": 643.279,
      "end": 646.8,
      "text": "इन अ वेरी वेरीरी गुड डायरेक्शन राइट"
    },
    {
      "subtitle_id": 321,
      "start": 644.72,
      "end": 648.959,
      "text": "डायरेक्शन। तो ओवरऑल देखा जाए तो ग्लोबल"
    },
    {
      "subtitle_id": 322,
      "start": 646.8,
      "end": 651.2,
      "text": "ट्रेड में हम बहुत स्ट्रांग पोजीशन अपनी"
    },
    {
      "subtitle_id": 323,
      "start": 648.959,
      "end": 653.04,
      "text": "बना रहे हैं लगभग हर कंट्री के साथ और भी"
    },
    {
      "subtitle_id": 324,
      "start": 651.2,
      "end": 656.399,
      "text": "कई सारी कंट्रीज के साथ हमारी बात चल रही"
    },
    {
      "subtitle_id": 325,
      "start": 653.04,
      "end": 658.399,
      "text": "है। कॉमर्स मिनिस्टर मिस्टर गोयल अलग-अलग"
    },
    {
      "subtitle_id": 326,
      "start": 656.399,
      "end": 661.36,
      "text": "देशों में जा रहे हैं। बात कर रहे हैं। तो"
    },
    {
      "subtitle_id": 327,
      "start": 658.399,
      "end": 663.2,
      "text": "अच्छी बात है। इंडियन बिनेसेस इसका फायदा"
    },
    {
      "subtitle_id": 328,
      "start": 661.36,
      "end": 664.959,
      "text": "ले रहे हैं 1101%। तो मुझे लगता है"
    },
    {
      "subtitle_id": 329,
      "start": 663.2,
      "end": 666.64,
      "text": "इन्वेस्टर्स को भी पीछे नहीं रहना चाहिए।"
    },
    {
      "subtitle_id": 330,
      "start": 664.959,
      "end": 668.48,
      "text": "कंपनीज़ को ढूंढिए। बहुत सारी कंपनीज़ हैं"
    },
    {
      "subtitle_id": 331,
      "start": 666.64,
      "end": 670.56,
      "text": "जो लंबे टाइम से कभी थी नहीं डिस्काउंट"
    },
    {
      "subtitle_id": 332,
      "start": 668.48,
      "end": 673.76,
      "text": "में। अभी रियल टाइम अभी आ रही है। तो"
    },
    {
      "subtitle_id": 333,
      "start": 670.56,
      "end": 675.68,
      "text": "ध्यान रखिए उनको पकड़िए और बने रहिए। सो सी"
    },
    {
      "subtitle_id": 334,
      "start": 673.76,
      "end": 677.68,
      "text": "यू देर एंड तो मिलते हैं अगली वीडियो में।"
    },
    {
      "subtitle_id": 335,
      "start": 675.68,
      "end": 679.6,
      "text": "सी यू देर बाय-बाय एंड जाते-जाते हमारे"
    },
    {
      "subtitle_id": 336,
      "start": 677.68,
      "end": 681.6,
      "text": "वैल्यू इन कोहोट को भी जरूर चेक आउट"
    },
    {
      "subtitle_id": 337,
      "start": 679.6,
      "end": 683.519,
      "text": "कीजिए। लिंक नीचे डिस्क्रिप्शन और कमेंट"
    },
    {
      "subtitle_id": 338,
      "start": 681.6,
      "end": 684.959,
      "text": "बॉक्स में दी गई है। करेंटली अंडरवैलड"
    },
    {
      "subtitle_id": 339,
      "start": 683.519,
      "end": 686.48,
      "text": "स्टॉक्स को ढूंढने का इससे बेटर टाइम हो"
    },
    {
      "subtitle_id": 340,
      "start": 684.959,
      "end": 688.0,
      "text": "नहीं सकता क्योंकि ये बार-बार आती नहीं"
    },
    {
      "subtitle_id": 341,
      "start": 686.48,
      "end": 690.0,
      "text": "ऑपरेशन एक बार गई है तो फिर तीन-तीन"
    },
    {
      "subtitle_id": 342,
      "start": 688.0,
      "end": 692.72,
      "text": "चार-चार पांच-प साल नहीं आती है। तो डोंट"
    },
    {
      "subtitle_id": 343,
      "start": 690.0,
      "end": 694.88,
      "text": "मिस आउट ऑन देम। एंड मिलते हैं फिर वीआईसी"
    },
    {
      "subtitle_id": 344,
      "start": 692.72,
      "end": 697.839,
      "text": "के लेक्चर नंबर वन में। फॉर्म दिया गया है"
    },
    {
      "subtitle_id": 345,
      "start": 694.88,
      "end": 697.839,
      "text": "नीचे डिस्क्रिप्शन में और कमेंट बॉक्स"
    }
  ]
}