  "parsing_issues": [],
  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.08,
      "end": 4.48,
      "text": "फॉर्मर यूएस सेक्रेटरी ऑफ स्टेट हेनरी"
    },
    {
      "subtitle_id": 2,
      "start": 2.0,
      "end": 6.799,
      "text": "किसिंगर ने यह कहा था कि टू बी एनिमी ऑफ द"
    },
    {
      "subtitle_id": 3,
      "start": 4.48,
      "end": 9.599,
      "text": "यूनाइटेड स्टेट्स कैन बी डेंजरस बट टू बी"
    },
    {
      "subtitle_id": 4,
      "start": 6.799,
      "end": 11.92,
      "text": "अ फ्रेंड इज फैटल। यानी यूएसए का दुश्मन"
    },
    {
      "subtitle_id": 5,
      "start": 9.599,
      "end": 14.96,
      "text": "बनना तो खतरनाक है लेकिन उससे भी ज्यादा"
    },
    {
      "subtitle_id": 6,
      "start": 11.92,
      "end": 17.119,
      "text": "खतरनाक कोई चीज है तो वो है यूएसए का"
    },
    {
      "subtitle_id": 7,
      "start": 14.96,
      "end": 19.039,
      "text": "दोस्त बनना। क्योंकि यूएस की हिस्ट्री आप"
    },
    {
      "subtitle_id": 8,
      "start": 17.119,
      "end": 20.8,
      "text": "उठा कर देख लो। इन्होंने साउथ वियतनाम को"
    },
    {
      "subtitle_id": 9,
      "start": 19.039,
      "end": 22.8,
      "text": "पहले मिलिट्री सपोर्ट वगैरह दिया। फिर"
    },
    {
      "subtitle_id": 10,
      "start": 20.8,
      "end": 24.8,
      "text": "जैसे ही नॉर्थ वियतनाम जीतने लगा यह वहां"
    },
    {
      "subtitle_id": 11,
      "start": 22.8,
      "end": 26.64,
      "text": "से भाग गए। इन्होंने इराक में कूड्स के"
    },
    {
      "subtitle_id": 12,
      "start": 24.8,
      "end": 28.88,
      "text": "साथ ऐसा किया। इनके फेवरेट कंट्री"
    },
    {
      "subtitle_id": 13,
      "start": 26.64,
      "end": 31.119,
      "text": "पाकिस्तान के साथ भी इन्होंने 1971 में"
    },
    {
      "subtitle_id": 14,
      "start": 28.88,
      "end": 32.88,
      "text": "ऐसा ही किया। इन्होंने अफगानिस्तान में भी"
    },
    {
      "subtitle_id": 15,
      "start": 31.119,
      "end": 35.44,
      "text": "वैसा ही किया और अब लगता है कि मिस्टर"
    },
    {
      "subtitle_id": 16,
      "start": 32.88,
      "end": 37.12,
      "text": "डॉनल्ड ट्रंप इंडिया के साथ भी कुछ ऐसा ही"
    },
    {
      "subtitle_id": 17,
      "start": 35.44,
      "end": 38.96,
      "text": "प्लान कर रहे हैं। आपको याद होगा जब डॉन्ड"
    },
    {
      "subtitle_id": 18,
      "start": 37.12,
      "end": 41.04,
      "text": "ट्रंप इंडिया आए थे तब अहमदाबाद में"
    },
    {
      "subtitle_id": 19,
      "start": 38.96,
      "end": 43.52,
      "text": "इंडियंस ने कितना जंगी उनका स्वागत किया"
    },
    {
      "subtitle_id": 20,
      "start": 41.04,
      "end": 45.76,
      "text": "था। इतना ही नहीं इलेक्शन के टाइम तो"
    },
    {
      "subtitle_id": 21,
      "start": 43.52,
      "end": 48.399,
      "text": "लोगों ने उनके लिए हवन किए। उनके लिए"
    },
    {
      "subtitle_id": 22,
      "start": 45.76,
      "end": 50.16,
      "text": "उपवास भी किए ताकि ट्रंप इलेक्शन जीत जाए।"
    },
    {
      "subtitle_id": 23,
      "start": 48.399,
      "end": 52.32,
      "text": "लेकिन आज वही डोन्ड ट्रंप जो इंडिया को"
    },
    {
      "subtitle_id": 24,
      "start": 50.16,
      "end": 54.399,
      "text": "अपना दोस्त मानते थे। वह एक के बाद एक"
    },
    {
      "subtitle_id": 25,
      "start": 52.32,
      "end": 56.559,
      "text": "इंडिया के खिलाफ ऐसे डिसीजंस ले रहे हैं"
    },
    {
      "subtitle_id": 26,
      "start": 54.399,
      "end": 59.12,
      "text": "जो कोई अपने दुश्मन के खिलाफ भी ना ले।"
    },
    {
      "subtitle_id": 27,
      "start": 56.559,
      "end": 62.0,
      "text": "पहले उन्होंने 25% का टेरिफ लगाया। फिर"
    },
    {
      "subtitle_id": 28,
      "start": 59.12,
      "end": 63.84,
      "text": "उससे भी मन नहीं भरा तो 25% का और एडिशनल"
    },
    {
      "subtitle_id": 29,
      "start": 62.0,
      "end": 65.439,
      "text": "टेरिफ लगा दिया। जिससे आज इंडिया की कई"
    },
    {
      "subtitle_id": 30,
      "start": 63.84,
      "end": 68.64,
      "text": "सारी इंडस्ट्रीज जैसे कि जेम्स एंड"
    },
    {
      "subtitle_id": 31,
      "start": 65.439,
      "end": 70.56,
      "text": "ज्वेलरी, गारमेंट, श्रिम्स एटसेट्रा बहुत"
    },
    {
      "subtitle_id": 32,
      "start": 68.64,
      "end": 72.799,
      "text": "बड़े प्रॉब्लम में फंस गए हैं। लेकिन उनका"
    },
    {
      "subtitle_id": 33,
      "start": 70.56,
      "end": 75.28,
      "text": "दिल यहीं पर भी नहीं भरा क्योंकि अब वो एक"
    },
    {
      "subtitle_id": 34,
      "start": 72.799,
      "end": 77.439,
      "text": "ऐसा बिल लाने जा रहे हैं जिससे वह पूरे"
    },
    {
      "subtitle_id": 35,
      "start": 75.28,
      "end": 79.6,
      "text": "इंडिया की आईटी सेक्टर को बर्बाद करना"
    },
    {
      "subtitle_id": 36,
      "start": 77.439,
      "end": 81.759,
      "text": "चाहते हैं। यस आप यह न्यूज़ देखिए इस बिल"
    },
    {
      "subtitle_id": 37,
      "start": 79.6,
      "end": 83.84,
      "text": "के बारे में। इस बिल का नाम है हायर यानी"
    },
    {
      "subtitle_id": 38,
      "start": 81.759,
      "end": 86.4,
      "text": "कि हल्टिंग इंटरनेशनल रीलोकेशन ऑफ"
    },
    {
      "subtitle_id": 39,
      "start": 83.84,
      "end": 88.479,
      "text": "एंप्लॉयमेंट एक्ट। और इस बिल का एकमात्र"
    },
    {
      "subtitle_id": 40,
      "start": 86.4,
      "end": 90.88,
      "text": "मकसद है कि इंडियन आउटसोर्सिंग कंपनीज़ को"
    },
    {
      "subtitle_id": 41,
      "start": 88.479,
      "end": 92.88,
      "text": "खत्म करना या फिर उन्हें प्रॉब्लम में"
    },
    {
      "subtitle_id": 42,
      "start": 90.88,
      "end": 95.119,
      "text": "लाना। अगर यह एक्ट आ जाता है तो इंडियन"
    },
    {
      "subtitle_id": 43,
      "start": 92.88,
      "end": 97.92,
      "text": "आईटी इंडस्ट्री जिसके साइज क्लोज टू $300"
    },
    {
      "subtitle_id": 44,
      "start": 95.119,
      "end": 99.759,
      "text": "बिलियन की है और जो इंडिया में 50 लाख से"
    },
    {
      "subtitle_id": 45,
      "start": 97.92,
      "end": 101.759,
      "text": "ज्यादा लोगों को एंप्लॉयमेंट देती है, उस"
    },
    {
      "subtitle_id": 46,
      "start": 99.759,
      "end": 104.4,
      "text": "पर काफी हद तक एक बड़ा क्वेश्चन मार्क आ"
    },
    {
      "subtitle_id": 47,
      "start": 101.759,
      "end": 106.32,
      "text": "सकता है। तो क्या है यह हायर एक्ट? और इस"
    },
    {
      "subtitle_id": 48,
      "start": 104.4,
      "end": 108.079,
      "text": "एक्ट का इंडियन आईटी आउटसोर्सिंग"
    },
    {
      "subtitle_id": 49,
      "start": 106.32,
      "end": 109.92,
      "text": "इंडस्ट्री पर कितना बड़ा इंपैक्ट होगा?"
    },
    {
      "subtitle_id": 50,
      "start": 108.079,
      "end": 111.6,
      "text": "साथ ही इसका आईटी सेक्टर में जॉब करने"
    },
    {
      "subtitle_id": 51,
      "start": 109.92,
      "end": 113.36,
      "text": "वालों पर क्या इंपैक्ट होगा। इसके अलावा"
    },
    {
      "subtitle_id": 52,
      "start": 111.6,
      "end": 115.759,
      "text": "हम यह भी देखेंगे कि वह कौन से आईटी"
    },
    {
      "subtitle_id": 53,
      "start": 113.36,
      "end": 117.92,
      "text": "कंपनीज़ हैं जिनका सबसे ज्यादा रेवेन्यू"
    },
    {
      "subtitle_id": 54,
      "start": 115.759,
      "end": 119.84,
      "text": "यूएसए से आता है और इस एक्ट का सबसे"
    },
    {
      "subtitle_id": 55,
      "start": 117.92,
      "end": 121.6,
      "text": "ज्यादा नुकसान उन्हें हो सकता है। तो बात"
    },
    {
      "subtitle_id": 56,
      "start": 119.84,
      "end": 123.36,
      "text": "करते हैं आज के इस वीडियो में डिटेल में।"
    },
    {
      "subtitle_id": 57,
      "start": 121.6,
      "end": 126.64,
      "text": "नमस्कार, मैं प्रसाद आपका आज के इस वीडियो"
    },
    {
      "subtitle_id": 58,
      "start": 123.36,
      "end": 129.44,
      "text": "में स्वागत करता हूं। बात है फिफ्थ सितंबर"
    },
    {
      "subtitle_id": 59,
      "start": 126.64,
      "end": 131.76,
      "text": "2025 की। यूएस सेनेटर बर्नियर मोरिनो"
    },
    {
      "subtitle_id": 60,
      "start": 129.44,
      "end": 134.08,
      "text": "प्रपोज करते हैं यूएसए का हायर एक्ट। यह"
    },
    {
      "subtitle_id": 61,
      "start": 131.76,
      "end": 136.879,
      "text": "एक्ट क्या है? तो यह बेसिकली एक धमकी है"
    },
    {
      "subtitle_id": 62,
      "start": 134.08,
      "end": 138.959,
      "text": "यूएस कंपनीज़ को कि आप अपना काम बाहर"
    },
    {
      "subtitle_id": 63,
      "start": 136.879,
      "end": 141.52,
      "text": "कंट्री की कंपनीज़ को आउटसोर्स ना करें।"
    },
    {
      "subtitle_id": 64,
      "start": 138.959,
      "end": 144.0,
      "text": "पर्टिकुलरली इंडियन कंपनीज़ को। अब इसके"
    },
    {
      "subtitle_id": 65,
      "start": 141.52,
      "end": 146.8,
      "text": "अंदर तीन मेजर चीजों पर बात की गई है कि"
    },
    {
      "subtitle_id": 66,
      "start": 144.0,
      "end": 149.36,
      "text": "25% एक्साइज टैक्स लगेगा ऑन आउटसोर्सिंग"
    },
    {
      "subtitle_id": 67,
      "start": 146.8,
      "end": 151.599,
      "text": "पेमेंट्स। यानी कि ये सीधा 25% का एक्साइज"
    },
    {
      "subtitle_id": 68,
      "start": 149.36,
      "end": 153.84,
      "text": "टैक्स लगाने वाले हैं उन कंपनीज़ पर जो"
    },
    {
      "subtitle_id": 69,
      "start": 151.599,
      "end": 156.72,
      "text": "अपना काम इंडियन कंपनीज़ को आउटसोर्स"
    },
    {
      "subtitle_id": 70,
      "start": 153.84,
      "end": 158.8,
      "text": "करेंगे। दूसरा कि यह जो 25% का चार्ज लगने"
    },
    {
      "subtitle_id": 71,
      "start": 156.72,
      "end": 160.879,
      "text": "वाला है उसके ऊपर कंपनीज़ को कोई डिडक्शन"
    },
    {
      "subtitle_id": 72,
      "start": 158.8,
      "end": 163.68,
      "text": "नहीं मिलेगा। यानी कि यूएसए ऑलरेडी"
    },
    {
      "subtitle_id": 73,
      "start": 160.879,
      "end": 166.4,
      "text": "कॉरपोरेशंस को 21% का टैक्स लगाती है।"
    },
    {
      "subtitle_id": 74,
      "start": 163.68,
      "end": 169.599,
      "text": "उसके ऊपर 25% का यह टैक्स यानी कुल मिलाकर"
    },
    {
      "subtitle_id": 75,
      "start": 166.4,
      "end": 172.56,
      "text": "46% तक यह टैक्स जा सकता है। अब यहां पर"
    },
    {
      "subtitle_id": 76,
      "start": 169.599,
      "end": 174.8,
      "text": "ये जो 25% एक्साइज टैक्स है यहां से जो भी"
    },
    {
      "subtitle_id": 77,
      "start": 172.56,
      "end": 176.8,
      "text": "पैसा आएगा उसका यह क्या करेंगे? तो उसे यह"
    },
    {
      "subtitle_id": 78,
      "start": 174.8,
      "end": 178.879,
      "text": "डोमेस्टिक वर्कफोर्स फंड नाम से एक फंड"
    },
    {
      "subtitle_id": 79,
      "start": 176.8,
      "end": 180.64,
      "text": "बनाएंगे और उस फंड में डाल देंगे। अब इन"
    },
    {
      "subtitle_id": 80,
      "start": 178.879,
      "end": 182.8,
      "text": "पैसों से यह लोकल्स को ट्रेन करेंगे"
    },
    {
      "subtitle_id": 81,
      "start": 180.64,
      "end": 184.319,
      "text": "अलग-अलग चीजों में। ऐसे इनिशिएटिव्स में"
    },
    {
      "subtitle_id": 82,
      "start": 182.8,
      "end": 186.56,
      "text": "लगाएंगे जिससे यूएस की कंपनीज़ को"
    },
    {
      "subtitle_id": 83,
      "start": 184.319,
      "end": 188.879,
      "text": "आउटसोर्सिंग ना करनी पड़े। यानी इन शॉर्ट"
    },
    {
      "subtitle_id": 84,
      "start": 186.56,
      "end": 190.56,
      "text": "25% का टैक्स लगाएंगे। उस पर कोई टैक्स"
    },
    {
      "subtitle_id": 85,
      "start": 188.879,
      "end": 192.239,
      "text": "डिडक्शन नहीं मिलेगा और जो भी पैसा आएगा"
    },
    {
      "subtitle_id": 86,
      "start": 190.56,
      "end": 194.319,
      "text": "उसको आउटसोर्सिंग को बंद करने में"
    },
    {
      "subtitle_id": 87,
      "start": 192.239,
      "end": 196.0,
      "text": "लगाएंगे। अब यह तो बात हो गई हायर एक्ट"
    },
    {
      "subtitle_id": 88,
      "start": 194.319,
      "end": 197.92,
      "text": "की। वीडियो में आगे बढ़ने से पहले एक"
    },
    {
      "subtitle_id": 89,
      "start": 196.0,
      "end": 200.0,
      "text": "सूचना देना चाहूंगा कि 3 मंथ लॉन्ग वैल्यू"
    },
    {
      "subtitle_id": 90,
      "start": 197.92,
      "end": 201.68,
      "text": "इन्वेस्टिंग कोहट की बैच इज लॉन्चिंग सून।"
    },
    {
      "subtitle_id": 91,
      "start": 200.0,
      "end": 203.36,
      "text": "तो जिन्हें अभी तक नहीं पता उनके लिए मैं"
    },
    {
      "subtitle_id": 92,
      "start": 201.68,
      "end": 205.36,
      "text": "प्रोग्राम के हाईलाइट्स की बात करूं तो यह"
    },
    {
      "subtitle_id": 93,
      "start": 203.36,
      "end": 207.36,
      "text": "12 वीक लॉन्ग ऑनलाइन प्रोग्राम है जो"
    },
    {
      "subtitle_id": 94,
      "start": 205.36,
      "end": 209.44,
      "text": "वीकेंड्स में कंडक्ट होगा ताकि प्रोफेशनल"
    },
    {
      "subtitle_id": 95,
      "start": 207.36,
      "end": 210.959,
      "text": "भी बड़े आसानी से इसे अटेंड कर पाए। इस"
