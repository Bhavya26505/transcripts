      "subtitle_id": 188,
      "start": 395.36,
      "end": 400.08,
      "text": "HCL। HCL का भी 64% रेवेन्यू यूएस से आता"
    },
    {
      "subtitle_id": 189,
      "start": 398.56,
      "end": 403.28,
      "text": "है और उसके बाद Tech Mahindra है जिसका"
    },
    {
      "subtitle_id": 190,
      "start": 400.08,
      "end": 405.28,
      "text": "49.2% रेवेन्यू सिर्फ यूएस से आता है।"
    },
    {
      "subtitle_id": 191,
      "start": 403.28,
      "end": 407.759,
      "text": "यानी कि अगर आप देखेंगे तो हर बड़ी कंपनी"
    },
    {
      "subtitle_id": 192,
      "start": 405.28,
      "end": 410.319,
      "text": "का एटलीस्ट 50% रेवेन्यू आज यूएस से आ रहा"
    },
    {
      "subtitle_id": 193,
      "start": 407.759,
      "end": 412.8,
      "text": "है और जो छोटी-मोटी कंपनीज़ हैं वो भी काफी"
    },
    {
      "subtitle_id": 194,
      "start": 410.319,
      "end": 415.039,
      "text": "हैवीली डिपेंडेंट है यूएस पर। यानी एक चीज"
    },
    {
      "subtitle_id": 195,
      "start": 412.8,
      "end": 416.8,
      "text": "तो सिंपल है कि अगर यह एक्ट आ जाता है तो"
    },
    {
      "subtitle_id": 196,
      "start": 415.039,
      "end": 418.72,
      "text": "इन कंपनीज़ में काम करने वाले लोगों पर"
    },
    {
      "subtitle_id": 197,
      "start": 416.8,
      "end": 421.44,
      "text": "काफी एक अच्छा खासा इंपैक्ट हो जाएगा। अब"
    },
    {
      "subtitle_id": 198,
      "start": 418.72,
      "end": 424.96,
      "text": "इसमें देखने वाली बात यह भी है कि क्या यह"
    },
    {
      "subtitle_id": 199,
      "start": 421.44,
      "end": 427.039,
      "text": "सिर्फ 25% रहेगा आने के बाद या फिर ट्रंप"
    },
    {
      "subtitle_id": 200,
      "start": 424.96,
      "end": 429.52,
      "text": "का और एक ईगो हर्ट हो जाएगा जिसके बाद ये"
    },
    {
      "subtitle_id": 201,
      "start": 427.039,
      "end": 431.039,
      "text": "25 को और बढ़ाएंगे और पता नहीं। तो मुझे"
    },
    {
      "subtitle_id": 202,
      "start": 429.52,
      "end": 433.599,
      "text": "लगता है जल्द से जल्द यहां पर इंडियन"
    },
    {
      "subtitle_id": 203,
      "start": 431.039,
      "end": 436.16,
      "text": "गवर्नमेंट को इंटरवीन करने की जरूरत है।"
    },
    {
      "subtitle_id": 204,
      "start": 433.599,
      "end": 438.08,
      "text": "अगर यह नहीं होता है आज अगर आप देखेंगे तो"
    },
    {
      "subtitle_id": 205,
      "start": 436.16,
      "end": 439.919,
      "text": "इंडिया जो ग्रोथ स्टोरी है उसमें आईटी"
    },
    {
      "subtitle_id": 206,
      "start": 438.08,
      "end": 442.16,
      "text": "सेक्टर का बहुत बड़ा योगदान है। क्योंकि"
    },
    {
      "subtitle_id": 207,
      "start": 439.919,
      "end": 444.08,
      "text": "ये वो लोग हैं जो अच्छी सैलरी कमाते हैं।"
    },
    {
      "subtitle_id": 208,
      "start": 442.16,
      "end": 445.919,
      "text": "जब किसी को 4 साल 5 साल आईटी सेक्टर में"
    },
    {
      "subtitle_id": 209,
      "start": 444.08,
      "end": 448.24,
      "text": "हो जाते हैं तो कंपेयर कंपेयर टू अदर"
    },
    {
      "subtitle_id": 210,
      "start": 445.919,
      "end": 449.759,
      "text": "सेक्टर्स दे मेक वेरी गुड मनी। तो इससे"
    },
    {
      "subtitle_id": 211,
      "start": 448.24,
      "end": 451.599,
      "text": "इंडिया की प्रोस्पेरिटी इंडिया की ग्रोथ"
    },
    {
      "subtitle_id": 212,
      "start": 449.759,
      "end": 453.12,
      "text": "में उनका काफी सारा कंट्रीब्यूशन है और"
    },
    {
      "subtitle_id": 213,
      "start": 451.599,
      "end": 455.039,
      "text": "यहां पर यह एक्ट आ जाता है तो ग्रोथ पर तो"
    },
    {
      "subtitle_id": 214,
      "start": 453.12,
      "end": 457.28,
      "text": "असर पड़ेगा ही क्योंकि ये जो आईटी कंपनीज"
    },
    {
      "subtitle_id": 215,
      "start": 455.039,
      "end": 459.599,
      "text": "हैं जो भी टॉप आईटी कंपनीज़ की मैं बात कर"
    },
    {
      "subtitle_id": 216,
      "start": 457.28,
      "end": 461.68,
      "text": "रहा हूं वो ऑलरेडी स्ट्रगल कर रही है"
    },
    {
      "subtitle_id": 217,
      "start": 459.599,
      "end": 463.68,
      "text": "बिकॉज़ ऑलरेडी वो सैचुरेशन पॉइंट पर आ गई"
    },
    {
      "subtitle_id": 218,
      "start": 461.68,
      "end": 465.44,
      "text": "है। उनकी ग्रोथ 10-12% से ज्यादा हो नहीं"
    },
    {
      "subtitle_id": 219,
      "start": 463.68,
      "end": 467.36,
      "text": "रही है। ऐसे में अगर इस तरह के एक्ट हो"
    },
    {
      "subtitle_id": 220,
      "start": 465.44,
      "end": 469.68,
      "text": "जाते हैं तो डीग्रोथ होने के चांसेस हैं"
    },
    {
      "subtitle_id": 221,
      "start": 467.36,
      "end": 472.16,
      "text": "और उससे लोगों की जॉब और एंप्लॉयमेंट पर"
    },
    {
      "subtitle_id": 222,
      "start": 469.68,
      "end": 474.08,
      "text": "भी काफी बड़ा सवाल खड़ा हो जाएगा। क्योंकि"
    },
    {
      "subtitle_id": 223,
      "start": 472.16,
      "end": 475.84,
      "text": "ऑलरेडी एंप्लॉयमेंट एक ऐसा इशू है जिसमें"
    },
    {
      "subtitle_id": 224,
      "start": 474.08,
      "end": 477.919,
      "text": "इंडिया ऑलरेडी स्ट्रगल कर रहा है। इसमें"
    },
    {
      "subtitle_id": 225,
      "start": 475.84,
      "end": 481.199,
      "text": "अगर आईटी सेक्टर में भी प्रॉब्लम आ गई तो"
    },
    {
      "subtitle_id": 226,
      "start": 477.919,
      "end": 482.72,
      "text": "प्रॉब्लम बहुत ज्यादा बढ़ेगी और एक यू नो"
    },
    {
      "subtitle_id": 227,
      "start": 481.199,
      "end": 484.8,
      "text": "इसका एक रिपल इफेक्ट होगा जो बाकी"
    },
    {
      "subtitle_id": 228,
      "start": 482.72,
      "end": 486.639,
      "text": "सेक्टर्स पर भी धीरे-धीरे पड़ने लगेगा।"
    },
    {
      "subtitle_id": 229,
      "start": 484.8,
      "end": 488.24,
      "text": "जैसे कि रियलस्टेट पर क्योंकि यही लोग हैं"
    },
    {
      "subtitle_id": 230,
      "start": 486.639,
      "end": 490.24,
      "text": "जो काफी भारी मात्रा में रियलस्टेट"
    },
    {
      "subtitle_id": 231,
      "start": 488.24,
      "end": 492.16,
      "text": "फ्लैट्स और बाकी चीजों में भी इन्वेस्ट"
    },
    {
      "subtitle_id": 232,
      "start": 490.24,
      "end": 494.319,
      "text": "करते हैं। ऐसे में कंक्लूजन क्या निकलता"
    },
    {
      "subtitle_id": 233,
      "start": 492.16,
      "end": 496.479,
      "text": "है? तो कंक्लूजन यह निकलता है कि यह शायद"
    },
    {
      "subtitle_id": 234,
      "start": 494.319,
      "end": 498.879,
      "text": "होने ही वाला था। जब भी किसी कंट्री की"
    },
    {
      "subtitle_id": 235,
      "start": 496.479,
      "end": 500.639,
      "text": "किसी एक कंट्री पर इतनी ज्यादा निर्भरता"
    },
    {
      "subtitle_id": 236,
      "start": 498.879,
      "end": 502.879,
      "text": "हो जाती है, डिपेंडेंसी हो जाती है, तो इस"
    },
    {
      "subtitle_id": 237,
      "start": 500.639,
      "end": 504.8,
      "text": "तरह की चीजें आज ना कल होने के चांसेस बढ़"
    },
    {
      "subtitle_id": 238,
      "start": 502.879,
      "end": 506.72,
      "text": "जाते हैं। आज हमारा सर्विस सेक्टर एक ही"
    },
    {
      "subtitle_id": 239,
      "start": 504.8,
      "end": 508.879,
      "text": "होड़ में लगा रहता है कि कैसे यूएस में"
    },
    {
      "subtitle_id": 240,
      "start": 506.72,
      "end": 510.479,
      "text": "पैसा बनाया जाए, कैसे यूएस में क्लाइंट्स"
    },
    {
      "subtitle_id": 241,
      "start": 508.879,
      "end": 512.08,
      "text": "ढूंढे जाए। चाइना ने भी इनिशियली"
    },
    {
      "subtitle_id": 242,
      "start": 510.479,
      "end": 513.68,
      "text": "मैन्युफैक्चरिंग और यूएस को एक्सपोर्ट"
    },
    {
      "subtitle_id": 243,
      "start": 512.08,
      "end": 515.76,
      "text": "करना शुरू किया था। लेकिन बाद में"
    },
    {
      "subtitle_id": 244,
      "start": 513.68,
      "end": 517.12,
      "text": "उन्होंने रिसर्च पर काफी ज्यादा फोकस किया"
    },
    {
      "subtitle_id": 245,
      "start": 515.76,
      "end": 518.719,
      "text": "और रिजल्ट यह कि आज वो बैटरी"
    },
    {
      "subtitle_id": 246,
      "start": 517.12,
      "end": 520.32,
      "text": "मैन्युफैक्चरिंग जैसी चीजों में वर्ल्ड"
    },
    {
      "subtitle_id": 247,
      "start": 518.719,
      "end": 522.08,
      "text": "में नंबर वन बन गए हैं। इलेक्ट्रिक"
    },
    {
      "subtitle_id": 248,
      "start": 520.32,
      "end": 524.399,
      "text": "ऑटोमोबाइल सेक्टर में भी Tes्ला के"
    },
    {
      "subtitle_id": 249,
      "start": 522.08,
      "end": 526.88,
      "text": "साथ-साथ चाइनीस कंपनीज़ जैसे कि बीवाईडी और"
    },
    {
      "subtitle_id": 250,
      "start": 524.399,
      "end": 528.64,
      "text": "Neo दुनिया भर में यूएस को तगड़ी कंपटीशन"
    },
    {
      "subtitle_id": 251,
      "start": 526.88,
      "end": 530.16,
      "text": "दे रहे हैं। इसी तरह आप साउथ कोरिया को"
    },
    {
      "subtitle_id": 252,
      "start": 528.64,
      "end": 531.76,
      "text": "देख लो। पहले उनकी इकॉनमी बेसिक"
    },
    {
      "subtitle_id": 253,
      "start": 530.16,
      "end": 533.44,
      "text": "एक्सपोर्ट्स पर डिपेंडेंट थी। लेकिन"
    },
    {
      "subtitle_id": 254,
      "start": 531.76,
      "end": 535.2,
      "text": "उन्होंने धीरे-धीरे सेमीकंडक्टर और"
    },
    {
      "subtitle_id": 255,
      "start": 533.44,
      "end": 537.92,
      "text": "इलेक्ट्रॉनिक्स रिसर्च में इन्वेस्ट किया"
    },
    {
      "subtitle_id": 256,
      "start": 535.2,
      "end": 539.839,
      "text": "और आज Samsung और एस के हनिक्स ग्लोबल चिप"
    },
    {
      "subtitle_id": 257,
      "start": 537.92,
      "end": 542.16,
      "text": "लीडर्स हैं। ताइवान में इसी अप्रोच से आगे"
    },
    {
      "subtitle_id": 258,
      "start": 539.839,
      "end": 544.399,
      "text": "निकला। टीएसएमसी जैसी कंपनीज ने इतनी"
    },
    {
      "subtitle_id": 259,
      "start": 542.16,
      "end": 546.48,
      "text": "रिसर्च और इनोवेशन की कि आज पूरी दुनिया"
    },
    {
      "subtitle_id": 260,
      "start": 544.399,
      "end": 548.48,
      "text": "में सबसे एडवांस सेमीकंडक्टर चिप्स वही"
    },
    {
      "subtitle_id": 261,
      "start": 546.48,
      "end": 550.56,
      "text": "बनाते हैं। लेकिन ऑन द अदर हैंड इंडिया की"
    },
    {
      "subtitle_id": 262,
      "start": 548.48,
      "end": 553.2,
      "text": "सर्विस कंपनी ने ना तो ज्यादा रिसर्च किया"
    },
    {
      "subtitle_id": 263,
      "start": 550.56,
      "end": 555.36,
      "text": "ना ही ज्यादा इनोवेशन। इनका फोकस था कि"
    },
    {
      "subtitle_id": 264,
      "start": 553.2,
      "end": 557.44,
      "text": "अपनी सर्विज प्रोवाइड करके अमेरिकन कंपनीज़"
    },
    {
      "subtitle_id": 265,
      "start": 555.36,
      "end": 559.519,
      "text": "को और अमेरिका कैसे बनाएं और इसी के चलते"
    },
    {
      "subtitle_id": 266,
      "start": 557.44,
      "end": 562.08,
      "text": "कहावत भी मशहूर हो गई है कि पढ़ेगा इंडिया"
    },
    {
      "subtitle_id": 267,
      "start": 559.519,
      "end": 563.68,
      "text": "तभी आगे बढ़ेगा अमेरिका। तो व्हाट शुड वी"
    },
    {
      "subtitle_id": 268,
      "start": 562.08,
      "end": 565.519,
      "text": "डू? तो मुझे लगता है कि गवर्नमेंट को यहां"
    },
    {
      "subtitle_id": 269,
      "start": 563.68,
      "end": 567.04,
      "text": "पर सर्विस सेक्टर पर ध्यान देना चाहिए।"
    },
    {
      "subtitle_id": 270,
      "start": 565.519,
      "end": 568.959,
      "text": "जैसे कि अभी हमने देखा कि रिसेंटली"
    },
    {
      "subtitle_id": 271,
      "start": 567.04,
      "end": 571.2,
      "text": "गवर्नमेंट का मेक इन इंडिया फोकस था। तो"
    },
    {
      "subtitle_id": 272,
      "start": 568.959,
      "end": 572.88,
      "text": "कुछ सेक्टर जैसे डिफेंस वगैरह में उसका"
    },
    {
      "subtitle_id": 273,
      "start": 571.2,
      "end": 574.56,
      "text": "इंपैक्ट दिख रहा है। बाकी सेक्टर्स में"
    },
    {
      "subtitle_id": 274,
      "start": 572.88,
      "end": 576.24,
      "text": "उतना नहीं हो रहा है। आने वाले टाइम में"
    },
    {
      "subtitle_id": 275,
      "start": 574.56,
      "end": 578.32,
      "text": "शायद सेमीकंडक्टर में देखने मिले लेकिन"
    },
    {
      "subtitle_id": 276,
      "start": 576.24,
      "end": 579.92,
      "text": "मैन्युफैक्चरिंग के साथ-साथ सर्विस सेक्टर"
    },
    {
      "subtitle_id": 277,
      "start": 578.32,
      "end": 581.68,
      "text": "पर भी गवर्नमेंट को बहुत ज्यादा फोकस करना"
    },
    {
      "subtitle_id": 278,
      "start": 579.92,
      "end": 583.519,
      "text": "चाहिए क्योंकि यहां से बहुत ज्यादा जॉब्स"
    },
    {
      "subtitle_id": 279,
      "start": 581.68,
      "end": 585.12,
      "text": "निकल कर आ रही है। क्योंकि आईटी सेक्टर जो"
    },
    {
      "subtitle_id": 280,
      "start": 583.519,
      "end": 586.88,
      "text": "है इंडिया का वो इंडिया की एक सबसे बड़ी"
    },
    {
      "subtitle_id": 281,
      "start": 585.12,
      "end": 588.48,
      "text": "स्ट्रेंथ है जो हर साल बिलियन डॉलर के"
    },
    {
      "subtitle_id": 282,
      "start": 586.88,
      "end": 590.16,
      "text": "एक्सपोर्ट्स करती है और लाखों में जॉब्स"
    },
    {
      "subtitle_id": 283,
      "start": 588.48,
      "end": 592.08,
      "text": "भी क्रिएट करती है। पर चैलेंज ये है कि"
    },
    {
      "subtitle_id": 284,
      "start": 590.16,
      "end": 593.92,
      "text": "हमारा आईटी सेक्टर आउटसोर्सिंग और सपोर्ट"
    },
    {
      "subtitle_id": 285,
      "start": 592.08,
      "end": 595.92,
      "text": "तक ही लिमिटेड है। रिसर्च, प्रोडक्ट"
    },
    {
      "subtitle_id": 286,
      "start": 593.92,
      "end": 597.839,
      "text": "इनोवेशन और अपने ग्लोबल ब्रांड्स बनाने पर"
    },
    {
      "subtitle_id": 287,
      "start": 595.92,
      "end": 599.6,
      "text": "इंडिया का उतना फोकस नहीं है। आज भी आप"
    },
    {
      "subtitle_id": 288,
      "start": 597.839,
      "end": 601.76,
      "text": "देखेंगे कि जितने भी टेक प्रोडक्ट्स हम"
    },
    {
      "subtitle_id": 289,
      "start": 599.6,
      "end": 603.6,
      "text": "यूज करते हैं बहुत ही कम ऐसे हैं जो"
    },
    {
      "subtitle_id": 290,
      "start": 601.76,
      "end": 605.839,
      "text": "इंडिया से बने हैं। अगर हमारे पास इतनी"
    },
    {
      "subtitle_id": 291,
      "start": 603.6,
      "end": 607.76,
      "text": "बड़ी आईटी पावर है तो आइडियली हमें तगड़े"
    },
    {
      "subtitle_id": 292,
      "start": 605.839,
      "end": 609.44,
      "text": "प्रोडक्ट्स बनाने चाहिए थे लेकिन ऐसा नहीं"
    },
    {
      "subtitle_id": 293,
      "start": 607.76,
      "end": 611.44,
      "text": "हो रहा है क्योंकि वो इंडिया का फोकस"
    },
    {
      "subtitle_id": 294,
      "start": 609.44,
      "end": 614.32,
      "text": "एरिया ही नहीं है। लेकिन मुझे लगता है कि"
    },
    {
      "subtitle_id": 295,
      "start": 611.44,
      "end": 616.079,
      "text": "अब वक्त आ गया है। जब तक ट्रंप है इस तरह"
    },
    {
      "subtitle_id": 296,
      "start": 614.32,
      "end": 618.079,
      "text": "की चीजें चलती रहेगी। मुझे लगता है"
    },
    {
      "subtitle_id": 297,
      "start": 616.079,
      "end": 619.6,
      "text": "उन्होंने जो 25% का टेरिफ शुरुआत में"
    },
    {
      "subtitle_id": 298,
      "start": 618.079,
      "end": 622.399,
      "text": "लगाया इंडियन प्रोडक्ट्स की इंपोर्ट पर"
    },
    {
      "subtitle_id": 299,
      "start": 619.6,
      "end": 623.92,
      "text": "बाद में ईगो हर्ट हुआ तो 50% कर दिया।"
    },
    {
      "subtitle_id": 300,
      "start": 622.399,
      "end": 625.279,
      "text": "लेकिन मुझे ऐसा लगता है कि उन्हें ऐसा अब"
    },
    {
      "subtitle_id": 301,
      "start": 623.92,
      "end": 627.12,
      "text": "लग रहा है कि उससे ज्यादा फर्क नहीं पड़"
    },
    {
      "subtitle_id": 302,
      "start": 625.279,
      "end": 629.279,
      "text": "रहा इंडिया को क्योंकि इंडिया अब रिसेंटली"
    },
    {
      "subtitle_id": 303,
      "start": 627.12,
      "end": 631.519,
      "text": "चाइना के नजदीक जाने की कोशिश कर रही है।"
    },
    {
      "subtitle_id": 304,
      "start": 629.279,
      "end": 633.12,
      "text": "रशिया के नजदीक तो है ही। तो मुझे लगता है"
    },
    {
      "subtitle_id": 305,
      "start": 631.519,
      "end": 634.8,
      "text": "ट्रंप को अभी दिख रहा है कि शायद इन"
    },
    {
      "subtitle_id": 306,
      "start": 633.12,
      "end": 636.959,
      "text": "सेक्टर से काम नहीं चलेगा तो हमें आईटी"
    },
    {
      "subtitle_id": 307,
      "start": 634.8,
      "end": 638.959,
      "text": "सेक्टर पर वार करना पड़ेगा। शायद वहां से"
    },
    {
      "subtitle_id": 308,
      "start": 636.959,
      "end": 641.279,
      "text": "कुछ निकल जाए और इस तरह की ये चीजें दिख"
    },
    {
      "subtitle_id": 309,
      "start": 638.959,
      "end": 643.279,
      "text": "रही है और एक तो इंडियन गवर्नमेंट को जल्द"
    },
    {
      "subtitle_id": 310,
      "start": 641.279,
      "end": 645.2,
      "text": "से जल्द इंटरवीन करना पड़ेगा। लेकिन बहुत"
    },
    {
      "subtitle_id": 311,
      "start": 643.279,
      "end": 647.519,
      "text": "लंबे समय तक आप इस चीज को रोक नहीं सकते"
    },
    {
      "subtitle_id": 312,
      "start": 645.2,
      "end": 650.24,
      "text": "हो क्योंकि डिपेंडेंसी इंडियन आईटी सेक्टर"
    },
    {
      "subtitle_id": 313,
      "start": 647.519,
      "end": 651.76,
      "text": "की यूएस पर बहुत-बहुत ज्यादा है और ऑलरेडी"
    },
    {
      "subtitle_id": 314,
      "start": 650.24,
      "end": 653.36,
      "text": "ये सैचुरेशन हो गया है। मार्केट में ग्रोथ"
    },
    {
      "subtitle_id": 315,
      "start": 651.76,
      "end": 655.12,
      "text": "तो हो नहीं रही है। तो जल्द से जल्द"
    },
    {
      "subtitle_id": 316,
      "start": 653.36,
      "end": 657.279,
      "text": "इंडिया को रिसर्च इनोवेशन की तरफ जाना"
    },
    {
      "subtitle_id": 317,
      "start": 655.12,
      "end": 659.04,
      "text": "पड़ेगा और साथ ही अपना पोर्टफोलियो जो है"
    },
    {
      "subtitle_id": 318,
      "start": 657.279,
      "end": 661.2,
      "text": "वो डवर्सिफाई भी करना पड़ेगा जल्द से"
    },
    {
      "subtitle_id": 319,
      "start": 659.04,
      "end": 663.04,
      "text": "जल्द। अदरवाइज यह चलता रहेगा। आज 25%"
    },
    {
      "subtitle_id": 320,
      "start": 661.2,
      "end": 667.399,
      "text": "एक्साइज टैक्स की बात कर रहे हैं। कल शायद"
    },
    {
      "subtitle_id": 321,
      "start": 663.04,
      "end": 667.399,
      "text": "100% की हो पुणे नोस।"
    }
  ]
}