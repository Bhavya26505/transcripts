  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.16,
      "end": 4.4,
      "text": "लाइफ में समस्या है या फिर समस्या में"
    },
    {
      "subtitle_id": 2,
      "start": 2.24,
      "end": 6.48,
      "text": "लाइफ। ऐसा कहने पर मजबूर हो गए हैं Tata"
    },
    {
      "subtitle_id": 3,
      "start": 4.4,
      "end": 9.12,
      "text": "Motors के शेयर होल्डर्स। यस, यह वही Tata"
    },
    {
      "subtitle_id": 4,
      "start": 6.48,
      "end": 11.04,
      "text": "Motors है जो कोविड के समय ₹65 पर ट्रेड"
    },
    {
      "subtitle_id": 5,
      "start": 9.12,
      "end": 13.36,
      "text": "हो रही थी और विद इन फोर इयर्स कंपनी के"
    },
    {
      "subtitle_id": 6,
      "start": 11.04,
      "end": 15.12,
      "text": "शेयर प्राइस ₹1100 के भी ऊपर चली गई। यह"
    },
    {
      "subtitle_id": 7,
      "start": 13.36,
      "end": 16.8,
      "text": "अमेजिंग ग्रोथ देखिए बहुत सारे लोगों ने"
    },
    {
      "subtitle_id": 8,
      "start": 15.12,
      "end": 19.439,
      "text": "इस कंपनी में इन्वेस्ट करना शुरू किया"
    },
    {
      "subtitle_id": 9,
      "start": 16.8,
      "end": 21.279,
      "text": "लेकिन मिला क्या? निराशा ही निराशा। आप"
    },
    {
      "subtitle_id": 10,
      "start": 19.439,
      "end": 23.439,
      "text": "देख सकते हो कि 1 साल पहले Tata Motors के"
    },
    {
      "subtitle_id": 11,
      "start": 21.279,
      "end": 25.92,
      "text": "शेयर्स ₹1100 के करीब ट्रेड हो रहे थे। आज"
    },
    {
      "subtitle_id": 12,
      "start": 23.439,
      "end": 28.48,
      "text": "वह ट्रेड हो रहे हैं ₹650 के करीब। यानी"
    },
    {
      "subtitle_id": 13,
      "start": 25.92,
      "end": 30.16,
      "text": "सीधा 40% का डाउनफॉल। लास्ट टाइम जब हमने"
    },
    {
      "subtitle_id": 14,
      "start": 28.48,
      "end": 32.32,
      "text": "Tata Motors के फंडामेंटल्स पर वीडियो"
    },
    {
      "subtitle_id": 15,
      "start": 30.16,
      "end": 34.32,
      "text": "बनाई थी तब लोगों का कहना था कि पूरा"
    },
    {
      "subtitle_id": 16,
      "start": 32.32,
      "end": 36.0,
      "text": "मार्केट ही डाउन है। इसलिए Tata Motors भी"
    },
    {
      "subtitle_id": 17,
      "start": 34.32,
      "end": 38.239,
      "text": "डाउन है। लेकिन अभी तो यह बड़ी बात है"
    },
    {
      "subtitle_id": 18,
      "start": 36.0,
      "end": 40.399,
      "text": "क्योंकि मार्केट फरवरी मार्च के डाउनफॉल"
    },
    {
      "subtitle_id": 19,
      "start": 38.239,
      "end": 42.559,
      "text": "के बाद अब रिकवर होने लगा है। लेकिन Tata"
    },
    {
      "subtitle_id": 20,
      "start": 40.399,
      "end": 44.079,
      "text": "Motors उल्टा और ज्यादा गिरता जा रहा है।"
    },
    {
      "subtitle_id": 21,
      "start": 42.559,
      "end": 46.32,
      "text": "तो सवाल यह है कि ऐसा क्यों हो रहा है कि"
    },
    {
      "subtitle_id": 22,
      "start": 44.079,
      "end": 48.239,
      "text": "रिटेल इन्वेस्टर्स की सबसे चहीती कंपनी अब"
    },
    {
      "subtitle_id": 23,
      "start": 46.32,
      "end": 50.48,
      "text": "वैसा परफॉर्म नहीं कर रही है जैसा रिटेल"
    },
    {
      "subtitle_id": 24,
      "start": 48.239,
      "end": 52.559,
      "text": "इन्वेस्टर्स उनसे उम्मीद लगा रहे हैं। इस"
    },
    {
      "subtitle_id": 25,
      "start": 50.48,
      "end": 54.64,
      "text": "वीडियो को बनाने से पहले हमने Tata मोटर्स"
    },
    {
      "subtitle_id": 26,
      "start": 52.559,
      "end": 56.8,
      "text": "की हर एक सेगमेंट को खंगाला और उस सेगमेंट"
    },
    {
      "subtitle_id": 27,
      "start": 54.64,
      "end": 58.48,
      "text": "में कैसा परफॉर्मेंस चल रहा है? नंबर्स"
    },
    {
      "subtitle_id": 28,
      "start": 56.8,
      "end": 60.32,
      "text": "क्या कहते हैं? अगर नंबर्स गिर रहे हैं,"
    },
    {
      "subtitle_id": 29,
      "start": 58.48,
      "end": 62.16,
      "text": "तो क्यों गिर रहे हैं? चैलेंजेस क्या है?"
    },
    {
      "subtitle_id": 30,
      "start": 60.32,
      "end": 64.4,
      "text": "और क्या इन चैलेंजेस से Tata Motors उभर"
    },
    {
      "subtitle_id": 31,
      "start": 62.16,
      "end": 67.2,
      "text": "पाएगी और यू टर्न लेगी परफॉर्मेंस में या"
    },
    {
      "subtitle_id": 32,
      "start": 64.4,
      "end": 69.04,
      "text": "फिर यह चीज हमेशा ऐसी ही जारी रहेगी। इन"
    },
    {
      "subtitle_id": 33,
      "start": 67.2,
      "end": 70.64,
      "text": "सारी चीजों की क्लेरिटी आपको इस वीडियो"
    },
    {
      "subtitle_id": 34,
      "start": 69.04,
      "end": 72.159,
      "text": "में मिलने वाली है और इस वीडियो को देखने"
    },
    {
      "subtitle_id": 35,
      "start": 70.64,
      "end": 74.56,
      "text": "के बाद Tata Motors के अंदर एग्जैक्टली"
    },
    {
      "subtitle_id": 36,
      "start": 72.159,
      "end": 76.4,
      "text": "क्या चल रहा है सारी इंफॉर्मेशन आपको मिल"
    },
    {
      "subtitle_id": 37,
      "start": 74.56,
      "end": 77.68,
      "text": "जाएगी। नमस्कार, मैं प्रसाद आपका आज के इस"
    },
    {
      "subtitle_id": 38,
      "start": 76.4,
      "end": 79.36,
      "text": "वीडियो में स्वागत करता हूं। हो मेक श्योर"
    },
    {
      "subtitle_id": 39,
      "start": 77.68,
      "end": 80.96,
      "text": "कीजिए कि आपने चैनल को सब्सक्राइब किया हो"
    },
    {
      "subtitle_id": 40,
      "start": 79.36,
      "end": 82.799,
      "text": "और साथ ही सब्सक्राइब बटन के बाजू में जो"
    },
    {
      "subtitle_id": 41,
      "start": 80.96,
      "end": 84.159,
      "text": "जॉइ बटन है उसे भी जरूर एक्सप्लोर कीजिए"
    },
    {
      "subtitle_id": 42,
      "start": 82.799,
      "end": 86.08,
      "text": "जहां पर हमने बनाई अपनी प्रीमियम"
    },
    {
      "subtitle_id": 43,
      "start": 84.159,
      "end": 88.159,
      "text": "कम्युनिटी और जहां पर हम कुछ एक्सक्लूसिव"
    },
    {
      "subtitle_id": 44,
      "start": 86.08,
      "end": 90.24,
      "text": "स्टॉक रिलेटेड वीडियोस अपलोड करते हैं। तो"
    },
    {
      "subtitle_id": 45,
      "start": 88.159,
      "end": 92.079,
      "text": "उसे भी जरूर चेक आउट कीजिए। सबसे बड़ा वहम"
    },
    {
      "subtitle_id": 46,
      "start": 90.24,
      "end": 94.079,
      "text": "जो है वो यह है कि Tata Motors का नाम तो"
    },
    {
      "subtitle_id": 47,
      "start": 92.079,
      "end": 96.079,
      "text": "Tata Motors पर इनके नाम पे मत जाना"
    },
    {
      "subtitle_id": 48,
      "start": 94.079,
      "end": 97.92,
      "text": "क्योंकि इस नाम के खाने के दांत अलग और"
    },
    {
      "subtitle_id": 49,
      "start": 96.079,
      "end": 99.52,
      "text": "दिखाने के दांत अलग हैं। अब मैं आपको ऐसा"
    },
    {
      "subtitle_id": 50,
      "start": 97.92,
      "end": 101.36,
      "text": "क्यों कह रहा हूं यह बस आपको 2 मिनट में"
    },
    {
      "subtitle_id": 51,
      "start": 99.52,
      "end": 103.2,
      "text": "पता चल जाएगा। तो यह है Tata Motors का"
    },
    {
      "subtitle_id": 52,
      "start": 101.36,
      "end": 104.88,
      "text": "रेवेन्यू चार्ट। आप क्लियरली देख पाएंगे"
    },
    {
      "subtitle_id": 53,
      "start": 103.2,
      "end": 107.84,
      "text": "कि Tata Motors का मोस्ट ऑफ द रिवन्यू"
    },
    {
      "subtitle_id": 54,
      "start": 104.88,
      "end": 109.84,
      "text": "कहां से आ रहा है। इनफैक्ट 71% रेवेन्यू"
    },
    {
      "subtitle_id": 55,
      "start": 107.84,
      "end": 111.68,
      "text": "सिर्फ और सिर्फ Jaguar Land Rover यानी कि"
    },
    {
      "subtitle_id": 56,
      "start": 109.84,
      "end": 114.159,
      "text": "JLR से आ रहा है। फिर बाकी का इनके"
    },
    {
      "subtitle_id": 57,
      "start": 111.68,
      "end": 116.479,
      "text": "कमर्शियल व्हीकल से आता है 17% और पैसेंजर"
    },
    {
      "subtitle_id": 58,
      "start": 114.159,
      "end": 118.56,
      "text": "व्हीकल से आता है मात्र 11% यानी कि Tata"
    },
    {
      "subtitle_id": 59,
      "start": 116.479,
      "end": 120.079,
      "text": "Motors का नाम तो यहां पर Tata Motors है"
    },
    {
      "subtitle_id": 60,
      "start": 118.56,
      "end": 122.24,
      "text": "लेकिन सही मायने में कंपनी का नाम क्या"
    },
    {
      "subtitle_id": 61,
      "start": 120.079,
      "end": 124.0,
      "text": "होना चाहिए था? Jaguar Land Rover और"
    },
    {
      "subtitle_id": 62,
      "start": 122.24,
      "end": 125.52,
      "text": "इनफैक्ट सिर्फ Land Rover होना चाहिए था।"
    },
    {
      "subtitle_id": 63,
      "start": 124.0,
      "end": 127.2,
      "text": "और यह बात भी ध्यान देने वाली है कि आने"
    },
    {
      "subtitle_id": 64,
      "start": 125.52,
      "end": 129.36,
      "text": "वाले टाइम में कंपनी का डीमर्जर हो रहा"
    },
    {
      "subtitle_id": 65,
      "start": 127.2,
      "end": 131.12,
      "text": "है। जिसके चलते कंपनी का रेवेन्यू मिक्स"
    },
    {
      "subtitle_id": 66,
      "start": 129.36,
      "end": 132.959,
      "text": "पूरी तरह से बदलने वाला है। वह भी आपको"
    },
    {
      "subtitle_id": 67,
      "start": 131.12,
      "end": 134.72,
      "text": "आने वाले 2-4 मिनट में समझ में आ जाएगा।"
    },
    {
      "subtitle_id": 68,
      "start": 132.959,
      "end": 136.879,
      "text": "अब यह तो बात हो गई कहां से पैसा आ रहा है"
    },
    {
      "subtitle_id": 69,
      "start": 134.72,
      "end": 139.04,
      "text": "लेकिन तकलीफ कहां पर है? वही तो मेन"
    },
    {
      "subtitle_id": 70,
      "start": 136.879,
      "end": 140.959,
      "text": "प्रॉब्लम है। उसे समझते हैं। तो मैं बता"
    },
    {
      "subtitle_id": 71,
      "start": 139.04,
      "end": 142.879,
      "text": "दूं कि अनफॉर्चूनेटली हर एक सेगमेंट में"
    },
    {
      "subtitle_id": 72,
      "start": 140.959,
      "end": 145.12,
      "text": "तकलीफ है। और इनफैक्ट तो अब तो तकलीफ है।"
    },
    {
      "subtitle_id": 73,
      "start": 142.879,
      "end": 147.04,
      "text": "सेगमेंट से बाहर से भी आने लगी है। कैसे?"
    },
    {
      "subtitle_id": 74,
      "start": 145.12,
      "end": 148.72,
      "text": "तो चलिए वन बाय वन बता देता हूं। अगर आप"
    },
    {
      "subtitle_id": 75,
      "start": 147.04,
      "end": 150.959,
      "text": "कंपनी का कमर्शियल व्हीकल का बिजनेस"
    },
    {
      "subtitle_id": 76,
      "start": 148.72,
      "end": 153.599,
      "text": "देखोगे तो 2020 में वहां से आने वाला"
    },
    {
      "subtitle_id": 77,
      "start": 150.959,
      "end": 155.76,
      "text": "रेवेन्यू ₹36,000 करोड़ था जो अभी बढ़कर"
    },
    {
      "subtitle_id": 78,
      "start": 153.599,
      "end": 158.64,
      "text": "75,000 करोड़ हो चुका है। इनफैक्ट यह"
    },
    {
      "subtitle_id": 79,
      "start": 155.76,
      "end": 160.8,
      "text": "बिज़नेस 2020 से 2023 इन 3 सालों में ही"
    },
    {
      "subtitle_id": 80,
      "start": 158.64,
      "end": 163.04,
      "text": "डबल हो गया। लेकिन अभी अगर देखें तो पिछले"
    },
    {
      "subtitle_id": 81,
      "start": 160.8,
      "end": 165.36,
      "text": "12 क्वार्टर से लिटरली इस बिजनेस में कुछ"
    },
    {
      "subtitle_id": 82,
      "start": 163.04,
      "end": 167.2,
      "text": "भी ग्रोथ नहीं है। यानी कि ग्रोथ अभी पूरी"
    },
    {
      "subtitle_id": 83,
      "start": 165.36,
      "end": 169.28,
      "text": "तरह से थम गई है। 12 क्वार्टर से कुछ नहीं"
    },
    {
      "subtitle_id": 84,
      "start": 167.2,
      "end": 171.599,
      "text": "हो रहा है। अब वही सिलसिला बरकरार भी होता"
    },
    {
      "subtitle_id": 85,
      "start": 169.28,
      "end": 173.44,
      "text": "तो भी अच्छा था। लेकिन पैसेंजर व्हीकल"
    },
    {
      "subtitle_id": 86,
      "start": 171.599,
      "end": 175.76,
      "text": "इनका जो सेगमेंट है जहां पर कार्स वार्स"
    },
    {
      "subtitle_id": 87,
      "start": 173.44,
      "end": 177.76,
      "text": "यह बनाती है जो आपको काफी बार दिखती भी"
    },
    {
      "subtitle_id": 88,
      "start": 175.76,
      "end": 179.519,
      "text": "होंगी आजकल Nexon और बाकी चीजें यहां पर"
    },
    {
      "subtitle_id": 89,
      "start": 177.76,
      "end": 181.92,
      "text": "सेल्स जो है वह कंटीन्यूअसली गिर रहा है।"
    },
    {
      "subtitle_id": 90,
      "start": 179.519,
      "end": 183.599,
      "text": "अभी फाइनेंसियल ईयर 2026 के पहले क्वार्टर"
    },
    {
      "subtitle_id": 91,
      "start": 181.92,
      "end": 186.0,
      "text": "में इनका इस सेगमेंट से आने वाला क्वार्टर"
    },
    {
      "subtitle_id": 92,
      "start": 183.599,
      "end": 188.0,
      "text": "ऑन क्वार्टर रेवेन्यू 10% से गिर चुका है।"
    },
    {
      "subtitle_id": 93,
      "start": 186.0,
      "end": 190.08,
      "text": "और फिलहाल Tata Motors के मार्केट शेयर की"
    },
    {
      "subtitle_id": 94,
      "start": 188.0,
      "end": 192.319,
      "text": "बात करें तो वह भी लगातार गिर रहा है और"
    },
    {
      "subtitle_id": 95,
      "start": 190.08,
      "end": 194.08,
      "text": "इसी के चलते Mahindra का मार्केट शेयर अब"
    },
    {
      "subtitle_id": 96,
      "start": 192.319,
      "end": 196.4,
      "text": "Tata Motors से बढ़ गया है। यानी कि"
    },
