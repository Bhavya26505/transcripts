      "start": 651.2,
      "end": 654.56,
      "text": "इन्होंने एक पॉलिटिकल केस काफी बड़ा"
    },
    {
      "subtitle_id": 307,
      "start": 652.64,
      "end": 656.24,
      "text": "पॉलिटिकल केस भी हैंडल किया है। इसको मैं"
