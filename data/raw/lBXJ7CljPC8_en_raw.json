    {
      "subtitle_id": 302,
      "start": 642.959,
      "end": 647.68,
      "text": "यानी कि रेस्टोरेंट्स अब सर्विस चार्ज लगा"
    },
    {
      "subtitle_id": 303,
      "start": 645.12,
      "end": 649.839,
      "text": "सकेंगे जब तक इस केस का फाइनल फैसला नहीं"
