      "text": "A huge problem can be created for"
    },
    {
      "subtitle_id": 297,
      "start": 672.88,
      "end": 675.959,
      "text": "So whatever decision has to be taken the company"
    },
    {
      "subtitle_id": 298,
      "start": 674.44,
      "end": 677.92,
      "text": "You check the quarterly results of"
    },
    {
      "subtitle_id": 299,
      "start": 675.959,
      "end": 679.44,
      "text": "Not good since last three quarters"
    },
    {
      "subtitle_id": 300,
      "start": 677.92,
      "end": 681.519,
      "text": "December quarter results are still out"
    },
    {
      "subtitle_id": 301,
      "start": 679.44,
      "end": 683.88,
      "text": "टाइम में आ ही जाएगा जनवरी के मिड तक तो"
    },
    {
      "subtitle_id": 302,
      "start": 681.519,
      "end": 685.639,
      "text": "उसे देखिए और कंपनी के कॉन कॉल भी सुनिए"
    },
    {
      "subtitle_id": 303,
      "start": 683.88,
      "end": 687.56,
      "text": "कि कंपनी के क्या प्लांस है किस स्पीड से"
    },
    {
      "subtitle_id": 304,
      "start": 685.639,
      "end": 689.399,
      "text": "कंपनी बढ़ सकती है कंपनी का मैनेजमेंट भी"
    },
    {
      "subtitle_id": 305,
      "start": 687.56,
      "end": 691.44,
      "text": "इसके बारे में कुछ नंबर्स बताते हैं तो तो"
