    {
      "subtitle_id": 30,
      "start": 67.52,
      "end": 71.04,
      "text": "और आप बाकी बड़े इन्वेस्टर्स के"
    },
    {
      "subtitle_id": 31,
      "start": 68.96,
      "end": 72.88,
      "text": "पोर्टफोलियो भी देखेंगे तो सिमिलर हालत ही"
    },
    {
      "subtitle_id": 32,
      "start": 71.04,
      "end": 74.96,
      "text": "आपको वहां पर भी दिखेगी। अब यहां पर एक"
    },
    {
      "subtitle_id": 33,
      "start": 72.88,
      "end": 76.799,
      "text": "चीज गौर करने वाली है कि ओवरऑल इंडियन"
    },
    {
      "subtitle_id": 34,
      "start": 74.96,
      "end": 80.0,
      "text": "मार्केट देखा जाए पर्टिकुलरली स्माल कैप"
    },
    {
      "subtitle_id": 35,
      "start": 76.799,
      "end": 81.759,
      "text": "सेगमेंट, मिड कैप सेगमेंट ये सितेंबर 2024"
    },
    {
      "subtitle_id": 36,
      "start": 80.0,
      "end": 83.28,
      "text": "से गिर रहे हैं। लेकिन तब लार्ज कैप"
    },
    {
      "subtitle_id": 37,
      "start": 81.759,
      "end": 87.439,
      "text": "इंडेक्स उतना गिर नहीं रहा था। लेकिन"
    },
    {
      "subtitle_id": 38,
      "start": 83.28,
      "end": 90.56,
      "text": "सेंसेक्स जो अभी सेकंड जनवरी को 85762"
    },
    {
      "subtitle_id": 39,
      "start": 87.439,
      "end": 93.2,
      "text": "पर था वो अभी फिलहाल 71948"
    },
    {
      "subtitle_id": 40,
      "start": 90.56,
      "end": 95.68,
      "text": "पर आ चुका है। यानी पिछले 3 महीनों में यह"
    },
    {
      "subtitle_id": 41,
      "start": 93.2,
      "end": 97.52,
      "text": "भी 16% से गिर चुका है। तो अगेन यहां पर"
    },
    {
      "subtitle_id": 42,
      "start": 95.68,
      "end": 99.68,
      "text": "सिर्फ आप नहीं हो पूरा मार्केट यहां पर"
    },
    {
      "subtitle_id": 43,
      "start": 97.52,
      "end": 101.6,
      "text": "गिर चुका है। इसी के बीच हमारे जो दो मॉडल"
    },
    {
      "subtitle_id": 44,
      "start": 99.68,
      "end": 104.479,
      "text": "पोर्टफोलियोस हैं जिन्हें आप स्माल केस पर"
    },
    {
      "subtitle_id": 45,
      "start": 101.6,
      "end": 106.159,
      "text": "खरीद सकते हो वो भी यहां पर 20% प्लस डाउन"
    },
    {
      "subtitle_id": 46,
      "start": 104.479,
      "end": 108.399,
      "text": "है। अब यहां पर मैं आपको कुछ इंटरेस्टिंग"
    },
    {
      "subtitle_id": 47,
      "start": 106.159,
      "end": 111.119,
      "text": "चीज बताने वाला हूं आज कि जहां पर हर एक"
    },
    {
      "subtitle_id": 48,
      "start": 108.399,
      "end": 113.439,
      "text": "चीज मार्केट में 20-25% कुछ-कुछ ज्यादा भी"
    },
    {
      "subtitle_id": 49,
      "start": 111.119,
      "end": 116.96,
      "text": "गिरी है। वहीं पर मेरा जो पोर्टफोलियो है"
    },
    {
      "subtitle_id": 50,
      "start": 113.439,
      "end": 118.64,
      "text": "वो फिलहाल लगभग 5% डाउन है जो कि मार्केट"
    },
    {
      "subtitle_id": 51,
      "start": 116.96,
      "end": 120.0,
      "text": "से काफी कम है। अब यहां पर मेरे जो"
    },
    {
      "subtitle_id": 52,
      "start": 118.64,
      "end": 121.68,
      "text": "पोर्टफोलियो में स्टॉक्स है जो मैंने 6"
    },
    {
      "subtitle_id": 53,
      "start": 120.0,
      "end": 123.439,
      "text": "महीना पहले 7 महीना पहले 8 महीना पहले"
    },
    {
      "subtitle_id": 54,
      "start": 121.68,
      "end": 125.52,
      "text": "मतलब मेरा जो रिसेंट पोर्टफोलियो है जो"
    },
    {
      "subtitle_id": 55,
      "start": 123.439,
      "end": 128.399,
      "text": "मैंने रिसेंटली खरीदा है 7 आठ महीने पहले"
    },
    {
      "subtitle_id": 56,
      "start": 125.52,
      "end": 129.92,
      "text": "वो स्टॉक्स भी 2025% गिरे लेकिन बावजूद"
    },
    {
      "subtitle_id": 57,
      "start": 128.399,
      "end": 131.84,
      "text": "उसके मेरा पोर्टफोलियो उतना नहीं गिरा है"
    },
    {
      "subtitle_id": 58,
      "start": 129.92,
      "end": 134.0,
      "text": "5% गिरा है। अब ये चीज मैंने कैसे की?"
    },
    {
      "subtitle_id": 59,
      "start": 131.84,
      "end": 135.92,
      "text": "इसका जवाब है बीडब्ल्यूटी बॉट्स यानी कि"
    },
    {
      "subtitle_id": 60,
      "start": 134.0,
      "end": 137.92,
      "text": "बाय व्हेन देयर इज़ ब्लड ऑन द स्ट्रिप। अब"
    },
    {
      "subtitle_id": 61,
      "start": 135.92,
      "end": 141.12,
      "text": "देखिए अभी हम फिलहाल जिस फज़ में है वो है"
    },
    {
      "subtitle_id": 62,
      "start": 137.92,
      "end": 142.959,
      "text": "बेयर रन। जहां पर मार्केट आटे गिर रहा है"
    },
    {
      "subtitle_id": 63,
      "start": 141.12,
      "end": 144.959,
      "text": "और बेयर रन की खास बात यह है कि यह"
    },
    {
      "subtitle_id": 64,
      "start": 142.959,
      "end": 146.64,
      "text": "बार-बार जल्दी आता नहीं है। यानी कि बेयर"
    },
    {
      "subtitle_id": 65,
      "start": 144.959,
      "end": 148.48,
      "text": "रन का फायदा लेने के लिए इन्वेस्टर्स को"
    },
    {
      "subtitle_id": 66,
      "start": 146.64,
      "end": 150.64,
      "text": "जो अपॉर्चुनिटीज चुननी है उसके लिए ज्यादा"
    },
    {
      "subtitle_id": 67,
      "start": 148.48,
      "end": 153.04,
      "text": "बड़ी टाइम फ्रेम नहीं मिलती। और बेयर रन"
    },
    {
      "subtitle_id": 68,
      "start": 150.64,
      "end": 156.64,
      "text": "की दूसरी खास बात यह है कि जितना फास्ट"
    },
    {
      "subtitle_id": 69,
      "start": 153.04,
      "end": 158.16,
      "text": "डाउनफॉल उतनी ही फास्ट रिकवरी। डाटा के"
    },
    {
      "subtitle_id": 70,
      "start": 156.64,
      "end": 160.319,
      "text": "साथ आपको बताता हूं। अगर स्माल कैप"
    },
    {
      "subtitle_id": 71,
      "start": 158.16,
      "end": 162.319,
      "text": "इंडेक्स की बात करें तो जितना स्माल कैप"
    },
    {
      "subtitle_id": 72,
      "start": 160.319,
      "end": 164.64,
      "text": "इंडेक्स अभी गिर रहा है, उतना ही यह स्माल"
    },
    {
      "subtitle_id": 73,
      "start": 162.319,
      "end": 167.68,
      "text": "कैप इंडेक्स 2022 में गिरा था। जैसे कि"
    },
    {
      "subtitle_id": 74,
      "start": 164.64,
      "end": 171.68,
      "text": "जनवरी 2022 में निफ्टी स्माल कैप 100"
    },
    {
      "subtitle_id": 75,
      "start": 167.68,
      "end": 174.8,
      "text": "11900 पर था जो 2022 का जून महीना आते-आते"
    },
    {
      "subtitle_id": 76,
      "start": 171.68,
      "end": 177.44,
      "text": "8200 पर आ गया था। यानी यहां पर 30% ये"
    },
    {
      "subtitle_id": 77,
      "start": 174.8,
      "end": 180.319,
      "text": "गिर गया था। लेकिन फिर आप जून 2022 से"
    },
    {
      "subtitle_id": 78,
      "start": 177.44,
      "end": 182.56,
      "text": "लेकर जून 2024 इन दो सालों के स्माल कैप"
    },
    {
      "subtitle_id": 79,
      "start": 180.319,
      "end": 185.2,
      "text": "इंडेक्स के रिटर्न्स देखोगे तो वो है"
    },
    {
      "subtitle_id": 80,
      "start": 182.56,
      "end": 187.76,
      "text": "1120% के यानी डबल से ज्यादा पैसा"
    },
    {
      "subtitle_id": 81,
      "start": 185.2,
      "end": 189.68,
      "text": "इन्वेस्टर्स का हो गया। सेम चीज हमने 2022"
    },
    {
      "subtitle_id": 82,
      "start": 187.76,
      "end": 193.2,
      "text": "के बेयर रन में देखी थी। जो सेंसेक्स जो"
    },
    {
      "subtitle_id": 83,
      "start": 189.68,
      "end": 196.56,
      "text": "फरवरी 2020 में 41,000 पर था। अप्रैल"
    },
    {
      "subtitle_id": 84,
      "start": 193.2,
      "end": 200.0,
      "text": "महीना आते-आते 27,500 पर चला गया। कितना"
    },
    {
      "subtitle_id": 85,
      "start": 196.56,
      "end": 204.0,
      "text": "गिरा? लगभग 33% और उसके बाद 2 साल में"
    },
    {
      "subtitle_id": 86,
      "start": 200.0,
      "end": 207.2,
      "text": "यानी अप्रैल 2020 से लेकर अप्रैल 2022 इन"
    },
    {
      "subtitle_id": 87,
      "start": 204.0,
      "end": 209.44,
      "text": "2 सालों में इस सेंसेक्स ने 116% के"
    },
    {
      "subtitle_id": 88,
      "start": 207.2,
      "end": 211.36,
      "text": "रिटर्न्स दिए। अब देखिए एग्जैक्ट बॉटम कोई"
    },
    {
      "subtitle_id": 89,
      "start": 209.44,
      "end": 214.879,
      "text": "नहीं पता कर सकता। मान लेते हैं कि आप उसे"
    },
    {
      "subtitle_id": 90,
      "start": 211.36,
      "end": 216.879,
      "text": "27,500 की बजाय 3,000 पर ले लेते तो भी"
    },
    {
      "subtitle_id": 91,
      "start": 214.879,
      "end": 218.72,
      "text": "आपका पैसा सिर्फ 2 साल में डबल हो जाता।"
    },
    {
      "subtitle_id": 92,
      "start": 216.879,
      "end": 221.44,
      "text": "सिमिलरली स्माल कैप में भी आप एग्जैक्ट"
    },
    {
      "subtitle_id": 93,
      "start": 218.72,
      "end": 223.68,
      "text": "बॉटम ना करके 8,200 के बजाय 10,000 पर उसे"
    },
    {
      "subtitle_id": 94,
      "start": 221.44,
      "end": 225.2,
      "text": "खरीदते। तो यह ब्यूटी है बीडब्ल्यूटी"
    },
    {
      "subtitle_id": 95,
      "start": 223.68,
      "end": 226.879,
      "text": "बॉट्स की यानी कि बाय व्हेन देयर इज अ"
    },
    {
      "subtitle_id": 96,
      "start": 225.2,
      "end": 229.04,
      "text": "ब्लड ऑन द स्ट्रीट। अब आप कह सकते हो यहां"
    },
    {
      "subtitle_id": 97,
      "start": 226.879,
      "end": 230.959,
      "text": "पर कि 2020 की बात तो पुरानी हो गई आज का"
    },
    {
      "subtitle_id": 98,
      "start": 229.04,
      "end": 232.879,
      "text": "क्या? तो उसी तरह की अपॉर्चुनिटीज आज"
    },
    {
      "subtitle_id": 99,
      "start": 230.959,
      "end": 234.4,
      "text": "मार्केट में आ गई है। पिछले डेढ़ सालों से"
    },
    {
      "subtitle_id": 100,
      "start": 232.879,
      "end": 236.799,
      "text": "तो मार्केट काफी गिर ही रहा था थोड़ा"
    },
    {
      "subtitle_id": 101,
      "start": 234.4,
      "end": 239.36,
      "text": "छोटा-मोटा लेकिन अभी वॉर की वजह से वो जो"
    },
    {
      "subtitle_id": 102,
      "start": 236.799,
      "end": 241.12,
      "text": "फॉल था वो काफी स्टीफ हो गया है और इसी के"
    },
    {
      "subtitle_id": 103,
      "start": 239.36,
      "end": 243.36,
      "text": "चलते काफी अच्छी अपॉर्चुनिटीज़ फिलहाल"
    },
    {
      "subtitle_id": 104,
      "start": 241.12,
      "end": 245.12,
      "text": "मार्केट में आ गई है। ऑफ कोर्स शायद बॉटम"
    },
    {
      "subtitle_id": 105,
      "start": 243.36,
      "end": 246.879,
      "text": "इससे भी नीचे हो लेकिन अभी भी जो"
    },
    {
      "subtitle_id": 106,
      "start": 245.12,
      "end": 248.879,
      "text": "वैल्यूएशंस है वो काफी अच्छे हैं। तो अगर"
    },
    {
      "subtitle_id": 107,
      "start": 246.879,
      "end": 250.239,
      "text": "आप मार्केट के एवरेज रिटर्न्स को बीट करना"
    },
    {
      "subtitle_id": 108,
      "start": 248.879,
      "end": 252.319,
      "text": "चाहते हो तो इसी तरह के बेयर रन"
    },
    {
      "subtitle_id": 109,
      "start": 250.239,
      "end": 254.239,
      "text": "अपोरर्चुनिटीज़ आपको ढूंढनी पड़ेगी और उसमें"
    },
    {
      "subtitle_id": 110,
      "start": 252.319,
      "end": 256.32,
      "text": "इन्वेस्ट भी करना पड़ेगा। अगर आप खुद से"
    },
    {
      "subtitle_id": 111,
      "start": 254.239,
      "end": 257.759,
      "text": "इन्वेस्ट कर रहे हो तो मेक श्योर कीजिए कि"
    },
    {
      "subtitle_id": 112,
      "start": 256.32,
      "end": 259.44,
      "text": "आपके जो स्टॉक्स है वह फंडामेंटली"
    },
    {
      "subtitle_id": 113,
      "start": 257.759,
      "end": 261.44,
      "text": "स्ट्रांग होने चाहिए और वैल्यू्यूएशन वाइज"
    },
    {
      "subtitle_id": 114,
      "start": 259.44,
      "end": 263.28,
      "text": "भी। नहीं तो इस बॉटम का आपको कुछ फायदा"
    },
    {
      "subtitle_id": 115,
      "start": 261.44,
      "end": 265.44,
      "text": "नहीं होगा। और जो चीज मैंने आपको बताई कि"
    },
    {
      "subtitle_id": 116,
      "start": 263.28,
      "end": 267.199,
      "text": "मेरे पोर्टफोलियो के स्टॉक्स 20-25% डाउन"
    },
    {
      "subtitle_id": 117,
      "start": 265.44,
      "end": 269.36,
      "text": "है लेकिन मेरा पोर्टफोलियो 5% डाउन है।"
    },
    {
      "subtitle_id": 118,
      "start": 267.199,
      "end": 270.96,
      "text": "ऐसा कैसे? ऐसा इसलिए क्योंकि पिछले कुछ"
    },
    {
      "subtitle_id": 119,
      "start": 269.36,
      "end": 272.88,
      "text": "हफ्तों से मैं अपने जो पोर्टफोलियो के"
    },
    {
      "subtitle_id": 120,
      "start": 270.96,
      "end": 275.36,
      "text": "स्टॉक्स हैं उनमें लगातार रीइन्वेस्ट कर"
    },
    {
      "subtitle_id": 121,
      "start": 272.88,
      "end": 278.0,
      "text": "रहा हूं। जिससे जो मार्केट में जो डाउनफॉल"
    },
    {
      "subtitle_id": 122,
      "start": 275.36,
      "end": 279.919,
      "text": "आया है जो 20-25% का डिस्काउंट उन स्टॉक्स"
    },
    {
      "subtitle_id": 123,
      "start": 278.0,
      "end": 281.759,
      "text": "में मुझे मिल रहा है उसका फायदा मुझे मिल"
    },
    {
      "subtitle_id": 124,
      "start": 279.919,
      "end": 283.6,
      "text": "सके। और इसीलिए जो लॉसेस है वह थोड़े"
    },
    {
      "subtitle_id": 125,
      "start": 281.759,
      "end": 285.52,
      "text": "एवरेज होकर कम हो चुके हैं। यहां से आगे"
    },
    {
      "subtitle_id": 126,
      "start": 283.6,
      "end": 287.44,
      "text": "मार्केट जितना गिरता चला जाएगा मेरा गोल"
    },
    {
      "subtitle_id": 127,
      "start": 285.52,
      "end": 289.52,
      "text": "यही है कि उसे और खरीदते चला जाऊं मैं"
    },
    {
      "subtitle_id": 128,
      "start": 287.44,
      "end": 291.6,
      "text": "ताकि जो डिस्काउंट है उसका फायदा मुझे मिल"
    },
    {
      "subtitle_id": 129,
      "start": 289.52,
      "end": 293.52,
      "text": "सके। तो आपका जो भी पोर्टफोलियो है आप भी"
    },
    {
      "subtitle_id": 130,
      "start": 291.6,
      "end": 295.759,
      "text": "यहां पर फोकस कर सकते हो इस बॉटम फिशिंग"
    },
    {
      "subtitle_id": 131,
      "start": 293.52,
      "end": 297.28,
      "text": "करने के लिए। अगर आपने ऑलरेडी हमारे स्मॉल"
    },
    {
      "subtitle_id": 132,
      "start": 295.759,
      "end": 299.04,
      "text": "केसेस में इन्वेस्ट किया है जो अभी"
    },
    {
      "subtitle_id": 133,
      "start": 297.28,
      "end": 301.759,
      "text": "करेंटली एक्चुअली हमारा स्टार्टिंग पॉइंट"
    },
    {
      "subtitle_id": 134,
      "start": 299.04,
      "end": 304.16,
      "text": "से ही मार्केट फॉल होना शुरू हुआ सप्टेंबर"
    },
    {
      "subtitle_id": 135,
      "start": 301.759,
      "end": 306.08,
      "text": "2025 से। तो ये काफी अच्छे डिस्काउंट्स"
    },
    {
      "subtitle_id": 136,
      "start": 304.16,
      "end": 308.479,
      "text": "में चल रहे हैं। तो उन स्मॉल केसेस में आप"
    },
    {
      "subtitle_id": 137,
      "start": 306.08,
      "end": 310.88,
      "text": "पैसा और इन्वेस्ट कीजिए ताकि इस बॉटम"
    },
    {
      "subtitle_id": 138,
      "start": 308.479,
      "end": 312.24,
      "text": "प्राइसिंग का आपको फायदा मिल सके। और अगर"
    },
    {
      "subtitle_id": 139,
      "start": 310.88,
      "end": 313.6,
      "text": "आप भी हमारे मॉडल पोर्टफोलियोज़ में"
    },
    {
      "subtitle_id": 140,
      "start": 312.24,
      "end": 315.52,
      "text": "इंटरेस्टेड हैं और उसमें इन्वेस्ट करना"
    },
    {
      "subtitle_id": 141,
      "start": 313.6,
      "end": 317.199,
      "text": "चाहते हैं तो उसके फॉर्म की लिंक आपको पिन"
    },
    {
      "subtitle_id": 142,
      "start": 315.52,
      "end": 319.12,
      "text": "कमेंट और डिस्क्रिप्शन में मिल जाएगी।"
    },
    {
      "subtitle_id": 143,
      "start": 317.199,
      "end": 320.8,
      "text": "क्योंकि यहां पर मार्केट 20% डाउन है।"
    },
    {
      "subtitle_id": 144,
      "start": 319.12,
      "end": 323.28,
      "text": "बड़े-बड़े इन्वेस्टर्स के पोर्टफोलियोस"
    },
    {
      "subtitle_id": 145,
      "start": 320.8,
      "end": 324.96,
      "text": "यहां पर 40-50% डाउन है। तो बेसिकली यू आर"
    },
    {
      "subtitle_id": 146,
      "start": 323.28,
      "end": 327.12,
      "text": "गेटिंग स्टॉक्स एट वेरी-वेरी डीप"
    },
    {
      "subtitle_id": 147,
      "start": 324.96,
      "end": 329.039,
      "text": "डिस्काउंट। और इस तरह की ओपोरर्चुनिटीज"
    },
    {
      "subtitle_id": 148,
      "start": 327.12,
      "end": 331.12,
      "text": "बार-बार नहीं आती है। अगर लार्ज कैप"
    },
    {
      "subtitle_id": 149,
      "start": 329.039,
      "end": 333.28,
      "text": "इंडेक्स की बात करें फॉर एग्जांपल तो 2020"
    },
    {
      "subtitle_id": 150,
      "start": 331.12,
      "end": 336.08,
      "text": "के बाद इस तरह का फॉल 6 साल बाद आया है।"
    },
    {
      "subtitle_id": 151,
      "start": 333.28,
      "end": 337.6,
      "text": "अब 2026 के बाद वो कब आएगा पता नहीं लेकिन"
    },
    {
      "subtitle_id": 152,
      "start": 336.08,
      "end": 339.199,
      "text": "बहुत ज्यादा टाइम इस दौरान चला जाता है।"
    },
    {
      "subtitle_id": 153,
      "start": 337.6,
      "end": 340.8,
      "text": "तो बार-बार इस तरह की अपॉर्चुनिटीज नहीं"
    },
    {
      "subtitle_id": 154,
      "start": 339.199,
      "end": 342.96,
      "text": "आती। एंड आई एम प्रीटी श्योर कि जितना"
    },
    {
      "subtitle_id": 155,
      "start": 340.8,
      "end": 345.199,
      "text": "फास्ट ये डाउनफॉल चल रहा है उतनी ही फास्ट"
    },
    {
      "subtitle_id": 156,
      "start": 342.96,
      "end": 346.88,
      "text": "रिकवरी भी होगी। अब यहां पर मार्केट फॉल"
    },
    {
      "subtitle_id": 157,
      "start": 345.199,
      "end": 349.12,
      "text": "को लेकर कई सारे लोग कंफ्यूज हैं कि चल"
    },
    {
      "subtitle_id": 158,
      "start": 346.88,
      "end": 350.88,
      "text": "क्या रहा है? अब वॉर तो लंबे टाइम से चल"
    },
    {
      "subtitle_id": 159,
      "start": 349.12,
      "end": 353.039,
      "text": "रहा है लेकिन मार्केट फिर भी धनाधन गिर"
    },
    {
      "subtitle_id": 160,
      "start": 350.88,
      "end": 354.8,
      "text": "रहा है। तो देखिए वॉर तो एक रीज़न है ही"
    },
    {
      "subtitle_id": 161,
      "start": 353.039,
      "end": 356.8,
      "text": "लेकिन दूसरा रीज़न आपको एक बताता हूं"
    },
    {
      "subtitle_id": 162,
      "start": 354.8,
      "end": 358.56,
      "text": "इंटरेस्टिंग वो है कि एफआईआई की बातें तो"
    },
    {
      "subtitle_id": 163,
      "start": 356.8,
      "end": 361.12,
      "text": "हम लंबे टाइम से कर रहे हैं लेकिन एफआईआई"
    },
    {
      "subtitle_id": 164,
      "start": 358.56,
      "end": 362.8,
      "text": "ने इस मार्च मंथ में रिकॉर्ड ब्रेकिंग सेल"
    },
    {
      "subtitle_id": 165,
      "start": 361.12,
      "end": 364.56,
      "text": "किया है। अब तक के सारे मंथली रिकॉर्ड"
    },
    {
      "subtitle_id": 166,
      "start": 362.8,
      "end": 367.52,
      "text": "इन्होंने तोड़ दिए हैं। मार्च मंथ में"
    },
    {
      "subtitle_id": 167,
      "start": 364.56,
      "end": 370.08,
      "text": "इन्होंने ₹1.14 लाख के शेयर्स बेचे हैं।"
    },
    {
      "subtitle_id": 168,
      "start": 367.52,
      "end": 372.88,
      "text": "इनका जो पिछला सबसे हाईएस्ट रिकॉर्ड था वह"
    },
    {
      "subtitle_id": 169,
      "start": 370.08,
      "end": 374.88,
      "text": "अक्टूबर 2024 का था। जहां से मार्केट"
    },
    {
      "subtitle_id": 170,
      "start": 372.88,
      "end": 377.12,
      "text": "गिरना शुरू हुआ उस मंथ में उन्होंने"
    },
    {
      "subtitle_id": 171,
      "start": 374.88,
      "end": 378.96,
      "text": "94,000 करोड़ के शेयर्स बेचे थे। तो ये जो"
    },
    {
      "subtitle_id": 172,
      "start": 377.12,
      "end": 380.72,
      "text": "एफआईआई सेल कर रहे हैं जो वॉर है उसका"
    },
    {
      "subtitle_id": 173,
      "start": 378.96,
      "end": 382.4,
      "text": "शॉर्ट टर्म इंपैक्ट रहेगा। कोरोना में भी"
    },
    {
      "subtitle_id": 174,
      "start": 380.72,
      "end": 384.639,
      "text": "हमने देखा कि शॉर्ट टर्म में इंपैक्ट था।"
    },
    {
      "subtitle_id": 175,
      "start": 382.4,
      "end": 386.88,
      "text": "इकॉनमी थोड़ी सी रुक गई थी लेकिन बाद में"
    },
    {
      "subtitle_id": 176,
      "start": 384.639,
      "end": 388.479,
      "text": "जो रिकवरी थी वो भी उतनी ही फास्ट थी। तो"
    },
    {
      "subtitle_id": 177,
      "start": 386.88,
      "end": 390.08,
      "text": "बहुत सारे लोग यहां पर गलती करते हैं कि"
    },
    {
      "subtitle_id": 178,
      "start": 388.479,
      "end": 391.84,
      "text": "मार्केट गिर जाता है तो बेचते हैं। लेकिन"
    },
    {
      "subtitle_id": 179,
      "start": 390.08,
      "end": 393.68,
      "text": "कोई भी बड़े इन्वेस्टर जिनके भी मैंने नाम"
    },
    {
      "subtitle_id": 180,
      "start": 391.84,
      "end": 395.52,
      "text": "लिए। फिर आशीष कचुलिया हो उसमें मिश्रा"
    },
    {
      "subtitle_id": 181,
      "start": 393.68,
      "end": 397.28,
      "text": "आशीष धवन हो, विजय केडिया हो, सुनील"
    },
    {
      "subtitle_id": 182,
      "start": 395.52,
      "end": 399.12,
      "text": "सिंघानिया हो किसी को आप बेचते हुए नहीं"
    },
    {
      "subtitle_id": 183,
      "start": 397.28,
      "end": 400.88,
      "text": "देखेंगे। ऐसे मार्केट में और खरीदते हुए"
    },
    {
      "subtitle_id": 184,
      "start": 399.12,
      "end": 402.319,
      "text": "देखेंगे। सबके पोर्टफोलियोस डाउन है। उनको"
    },
    {
      "subtitle_id": 185,
      "start": 400.88,
      "end": 404.319,
      "text": "पता है कि रिकवरी होने में थोड़ा टाइम"
    },
    {
      "subtitle_id": 186,
      "start": 402.319,
      "end": 406.8,
      "text": "लगेगा। बट व्हाट दे विल बी फोकसिंग ऑन"
    },
    {
      "subtitle_id": 187,
      "start": 404.319,
      "end": 408.639,
      "text": "राइट नाउ और कैसे मैं खरीद सकता हूं। तो"
    },
    {
      "subtitle_id": 188,
      "start": 406.8,
      "end": 410.0,
      "text": "ऑफ कोर्स आपके भी कुछ प्रॉब्लम्स होंगे।"
    },
    {
      "subtitle_id": 189,
      "start": 408.639,
      "end": 411.68,
      "text": "किसी के पास कैश नहीं होगा, किसी के पास"
    },
    {
      "subtitle_id": 190,
      "start": 410.0,
      "end": 413.84,
      "text": "कुछ नहीं होगा। लेकिन यही टाइम होता है"
    },
    {
      "subtitle_id": 191,
      "start": 411.68,
      "end": 415.36,
      "text": "यहां पर आपको कहीं करेज दिखाना होता है और"
    },
    {
      "subtitle_id": 192,
      "start": 413.84,
      "end": 417.039,
      "text": "इन्वेस्टमेंट्स करनी होती है। क्योंकि फिर"
    },
    {
      "subtitle_id": 193,
      "start": 415.36,
      "end": 418.56,
      "text": "मार्केट जब ऊपर चला जाता है तो बुल"
    },
    {
      "subtitle_id": 194,
      "start": 417.039,
      "end": 420.639,
      "text": "मार्केट में इन्वेस्ट करने के लिए आम लोग"
    },
    {
      "subtitle_id": 195,
      "start": 418.56,
      "end": 422.8,
      "text": "तो आ ही जाते हैं। लेकिन ऐसे बेयर मार्केट"
    },
    {
      "subtitle_id": 196,
      "start": 420.639,
      "end": 425.36,
      "text": "में अगर आप इन्वेस्ट करते हो तो वही चीज"
    },
    {
      "subtitle_id": 197,
      "start": 422.8,
      "end": 427.44,
      "text": "आपको एक आम इन्वेस्टर से अलग करेगी एंड"
    },
    {
      "subtitle_id": 198,
      "start": 425.36,
      "end": 428.96,
      "text": "एवरेज मार्केट से बेटर रिटर्न्स भी दिला"
    },
    {
      "subtitle_id": 199,
      "start": 427.44,
      "end": 430.4,
      "text": "देगी। अब जनरली YouTube पर इस तरह के"
    },
    {
      "subtitle_id": 200,
      "start": 428.96,
      "end": 432.24,
      "text": "वीडियोस आते नहीं है। सारे वीडियोस ऐसे ही"
    },
    {
      "subtitle_id": 201,
      "start": 430.4,
      "end": 433.68,
      "text": "आते हैं कि मैंने कैसा पैसा डबल किया, फोर"
    },
    {
      "subtitle_id": 202,
      "start": 432.24,
      "end": 435.68,
      "text": "टाइम्स किया। नेगेटिव रिटर्न्स हो गए तो"
    },
    {
      "subtitle_id": 203,
      "start": 433.68,
      "end": 437.919,
      "text": "उसकी कोई बात नहीं होती। बट लेकिन यहां पर"
    },
    {
      "subtitle_id": 204,
      "start": 435.68,
      "end": 440.24,
      "text": "जो है मैं वो दिखाना चाहता था और चाहता था"
    },
    {
      "subtitle_id": 205,
      "start": 437.919,
      "end": 442.479,
      "text": "कि आप भी इस चीज से सीखिए। कैसे इस बॉटम"
    },
    {
      "subtitle_id": 206,
      "start": 440.24,
      "end": 444.16,
      "text": "मार्केट में इन्वेस्ट करके आप भी अपने डीप"
    },
    {
      "subtitle_id": 207,
      "start": 442.479,
      "end": 445.919,
      "text": "डिस्काउंट्स लेते हो। कैसे लॉसेस भी आपके"
    },
    {
      "subtitle_id": 208,
      "start": 444.16,
      "end": 447.599,
      "text": "एवरेज हो जाते हैं वो भी चीज़ सीखने जैसी"
    },
    {
      "subtitle_id": 209,
      "start": 445.919,
      "end": 448.96,
      "text": "है। बट कंडीशन यही है कि आपके स्टॉक्स"
    },
    {
      "subtitle_id": 210,
      "start": 447.599,
      "end": 451.12,
      "text": "फंडामेंटली स्ट्रांग होने चाहिए।"
    },
    {
      "subtitle_id": 211,
      "start": 448.96,
      "end": 453.12,
      "text": "वैल्यू्यूएशन वाइज़ सही होने चाहिए। तभी"
    },
    {
      "subtitle_id": 212,
      "start": 451.12,
      "end": 454.639,
      "text": "आपको इस चीज का फायदा मिलेगा। तो आई होप"
    },
    {
      "subtitle_id": 213,
      "start": 453.12,
      "end": 456.72,
      "text": "यहां पर मैसेज आपके लिए काफी क्लियर हो"
    },
    {
      "subtitle_id": 214,
      "start": 454.639,
      "end": 458.4,
      "text": "गया होगा। तो फिलहाल यहीं पर रुकते हैं।"
    },
    {
      "subtitle_id": 215,
      "start": 456.72,
      "end": 460.24,
      "text": "एंड अगर आप हमारे मॉडल पोर्टफोलियोस को"
    },
    {
      "subtitle_id": 216,
      "start": 458.4,
      "end": 462.4,
      "text": "चेक आउट करना चाहते हो तो नीचे दिए गए"
    },
    {
      "subtitle_id": 217,
      "start": 460.24,
      "end": 464.0,
      "text": "लिंक पर क्लिक करके चेक आउट कर सकते हो।"
    },
    {
      "subtitle_id": 218,
      "start": 462.4,
      "end": 465.759,
      "text": "और फिलहाल हमारे स्टक्स के मॉडल"
    },
    {
      "subtitle_id": 219,
      "start": 464.0,
      "end": 467.68,
      "text": "पोर्टफोलियोस को सब्सक्राइब करने पर आपको"
    },
    {
      "subtitle_id": 220,
      "start": 465.759,
      "end": 469.68,
      "text": "हमारा म्यूचल फंड पोर्टफोलियो फ्री में"
    },
    {
      "subtitle_id": 221,
      "start": 467.68,
      "end": 471.36,
      "text": "मिल रहा है। तो इस ऑफर का भी जरूर फायदा"
    },
    {
      "subtitle_id": 222,
      "start": 469.68,
      "end": 472.96,
      "text": "लें। लिंक नीचे डिस्क्रिप्शन और कमेंट"
    },
    {
      "subtitle_id": 223,
      "start": 471.36,
      "end": 474.639,
      "text": "बॉक्स में दी गई है। फिलहाल यहीं पर रुकते"
    },
    {
      "subtitle_id": 224,
      "start": 472.96,
      "end": 476.56,
      "text": "हैं और अगले वीडियो में बात करेंगे कि अगर"
    },
    {
      "subtitle_id": 225,
      "start": 474.639,
      "end": 478.319,
      "text": "यह इसी तरह की सिचुएशनंस जारी रही वॉर की"
    },
    {
      "subtitle_id": 226,
      "start": 476.56,
      "end": 480.319,
      "text": "तो क्या यहां पर लॉकडाउन जैसी सिचुएशन हो"
    },
    {
      "subtitle_id": 227,
      "start": 478.319,
      "end": 484.44,
      "text": "सकती है जैसा फिलीपींस और पाकिस्तान जैसी"
    },
    {
      "subtitle_id": 228,
      "start": 480.319,
      "end": 484.44,
      "text": "कंट्रीज में फिलहाल हो रहा है।"
    }
  ]
}