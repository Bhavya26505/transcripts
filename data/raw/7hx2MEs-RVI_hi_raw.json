    {
      "subtitle_id": 19,
      "start": 40.16,
      "end": 46.559,
      "text": "है। यानी 55% से गिर चुका है। मिस्टर आशीष"
    },
    {
      "subtitle_id": 20,
      "start": 43.52,
      "end": 49.28,
      "text": "धवन 4400 से 1600 पर इनका पोर्टफोलियो आ"
