    {
      "subtitle_id": 22,
      "start": 49.28,
      "end": 52.719,
      "text": "है। मिस्टर विजय केड़िया मतलब स्टॉक"
    },
    {
      "subtitle_id": 23,
      "start": 51.12,
      "end": 54.559,
      "text": "मार्केट में जब भी कोई बात हो तो विजय"
    },
    {
      "subtitle_id": 24,
      "start": 52.719,
      "end": 57.199,
      "text": "केड़िया की बात होती ही होती है। लगभग 1"
    },
    {
      "subtitle_id": 25,
      "start": 54.559,
      "end": 60.48,
      "text": "साल पहले इनका पोर्टफोलियो 1896 करोड़ का"
