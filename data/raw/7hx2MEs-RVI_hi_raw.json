      "subtitle_id": 13,
      "start": 27.439,
      "end": 31.439,
      "text": "रिटर्न्स की बात करूं तो आप चौंक जाएंगे।"
    },
    {
      "subtitle_id": 14,
      "start": 29.599,
      "end": 33.28,
      "text": "मिस्टर आशीष कचुलिया अगर इनका पोर्टफोलियो"
    },
    {
      "subtitle_id": 15,
      "start": 31.439,
      "end": 35.2,
      "text": "देखा जाए जो ट्रेंड वेबसाइट पर रेगुलरली"
    },
    {
      "subtitle_id": 16,
      "start": 33.28,
      "end": 37.36,
      "text": "अपडेट होता है। मिस्टर आशीष कचुलिया का"
    },
    {
      "subtitle_id": 17,
      "start": 35.2,
      "end": 40.16,
      "text": "पोर्टफोलियो जो करीब एक साल पहले 4000"
    },
    {
      "subtitle_id": 18,
      "start": 37.36,
      "end": 43.52,
      "text": "करोड़ पर था वो भी 1800 करोड़ पर आ चुका"
