  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.04,
      "end": 4.24,
      "text": "राज कुंद्र की एक और डर्टी पिक्चर सामने"
    },
    {
      "subtitle_id": 2,
      "start": 1.719,
      "end": 6.12,
      "text": "आई है जिसमें ईडी ने राज कुंद्र की 97"
    },
    {
      "subtitle_id": 3,
      "start": 4.24,
      "end": 8.4,
      "text": "करोड़ की प्रॉपर्टीज को जप्त कर लिया है"
    },
    {
      "subtitle_id": 4,
      "start": 6.12,
      "end": 10.08,
      "text": "इसमें उनका पुणे का बंगलो है शिल्पा"
    },
    {
      "subtitle_id": 5,
      "start": 8.4,
      "end": 12.679,
      "text": "शेट्टी के नाम का फ्लैट है जुहू के पॉश"
    },
    {
      "subtitle_id": 6,
      "start": 10.08,
      "end": 15.759,
      "text": "एरिया में और बाकी जो शेयर्स वगैरह है वो"
    },
    {
      "subtitle_id": 7,
      "start": 12.679,
      "end": 17.92,
      "text": "सारे अटैच कर दिए हैं अब देखिए राजकु वैसे"
    },
    {
      "subtitle_id": 8,
      "start": 15.759,
      "end": 20.56,
      "text": "तो हर बार किसी ना किसी चीज में फंसते"
    },
    {
      "subtitle_id": 9,
      "start": 17.92,
      "end": 22.76,
      "text": "रहते ही है पहले आईएल बेटिंग का मामला था"
    },
    {
      "subtitle_id": 10,
      "start": 20.56,
      "end": 24.48,
      "text": "फिर 2021 में तीन महीने वो जेल में थे"
    },
    {
      "subtitle_id": 11,
      "start": 22.76,
      "end": 26.279,
      "text": "जिसके बाद उन्होंने वो नकाब वकाव पहनना"
    },
    {
      "subtitle_id": 12,
      "start": 24.48,
      "end": 28.08,
      "text": "शुरू किया था अब उसके बारे में बताने की"
    },
    {
      "subtitle_id": 13,
      "start": 26.279,
      "end": 30.24,
      "text": "जरूरत नहीं है सभी को पता ही है लेकिन अब"
    },
    {
      "subtitle_id": 14,
      "start": 28.08,
      "end": 31.92,
      "text": "यह कुछ नया मामला है अब देखिए यहां पर"
    },
    {
      "subtitle_id": 15,
      "start": 30.24,
      "end": 33.76,
      "text": "हेडलाइंस देखकर आपको पूरा मामला समझ में"
    },
    {
      "subtitle_id": 16,
      "start": 31.92,
      "end": 36.92,
      "text": "नहीं आएगा क्योंकि हेडलाइंस के छुपाए एक"
    },
    {
      "subtitle_id": 17,
      "start": 33.76,
      "end": 39.68,
      "text": "बहुत बड़ा राज और राज है 6600 करोड़ के"
    },
    {
      "subtitle_id": 18,
      "start": 36.92,
      "end": 42.0,
      "text": "स्कैम का तो क्या है यह 6600 करोड़ का"
    },
    {
      "subtitle_id": 19,
      "start": 39.68,
      "end": 43.76,
      "text": "स्कैम और इसका राज कुंदरा से क्या लेना"
    },
    {
      "subtitle_id": 20,
      "start": 42.0,
      "end": 46.079,
      "text": "देना है जानते हैं आज के इस वीडियो में"
    },
    {
      "subtitle_id": 21,
      "start": 43.76,
      "end": 47.84,
      "text": "डिटेल में नमस्कार मैं प्रसाद आपका आज के"
    },
    {
      "subtitle_id": 22,
      "start": 46.079,
      "end": 49.64,
      "text": "इस वीडियो में स्वागत करता हूं हम देखते"
    },
    {
      "subtitle_id": 23,
      "start": 47.84,
      "end": 51.52,
      "text": "हैं कि भारत में जब भी कोई फैमिली एक साथ"
    },
    {
      "subtitle_id": 24,
      "start": 49.64,
      "end": 53.079,
      "text": "बैठती है तो किस बारे में बात करते हैं तो"
    },
    {
      "subtitle_id": 25,
      "start": 51.52,
      "end": 54.76,
      "text": "मोस्टली वो क्रिकेट के बारे में बात"
    },
    {
      "subtitle_id": 26,
      "start": 53.079,
      "end": 57.199,
      "text": "करेंगे या फिर पॉलिटिक्स के बारे में बात"
    },
    {
      "subtitle_id": 27,
      "start": 54.76,
      "end": 60.559,
      "text": "करेंगे या फिर ऐसे ही मस्ती मजाक करेंगे"
    },
    {
      "subtitle_id": 28,
      "start": 57.199,
      "end": 62.92,
      "text": "लेकिन ये एक ऐसी फैमिली है जो जब-जब एक"
    },
    {
      "subtitle_id": 29,
      "start": 60.559,
      "end": 64.92,
      "text": "साथ बैठती थी वह इसके बारे में सोचती थी"
    },
    {
      "subtitle_id": 30,
      "start": 62.92,
      "end": 67.56,
      "text": "कि कैसे ज्यादा से ज्यादा लोगों को ठगा"
    },
    {
      "subtitle_id": 31,
      "start": 64.92,
      "end": 69.92,
      "text": "जाए और इस फैमिली का नाम था द भारद्वाज"
    },
    {
      "subtitle_id": 32,
      "start": 67.56,
      "end": 72.52,
      "text": "फैमिली द भारद्वाज फैमिली के जो सबसे बड़े"
    },
    {
      "subtitle_id": 33,
      "start": 69.92,
      "end": 74.52,
      "text": "मेंबर थे पिताजी वो उनका नाम था महेंद्र"
    },
    {
      "subtitle_id": 34,
      "start": 72.52,
      "end": 77.0,
      "text": "भारद्वाज उनके जो बेटे थे उसका नाम था"
    },
    {
      "subtitle_id": 35,
      "start": 74.52,
      "end": 78.92,
      "text": "अमित भारद्वाज और ये अमित भारद्वाज इस"
    },
    {
      "subtitle_id": 36,
      "start": 77.0,
      "end": 80.479,
      "text": "पूरे चीज का मास्टरमाइंड था था इसलिए"
    },
    {
      "subtitle_id": 37,
      "start": 78.92,
      "end": 82.84,
      "text": "क्योंकि अमित भारद्वाज की डेथ हुई है"
    },
    {
      "subtitle_id": 38,
      "start": 80.479,
      "end": 85.799,
      "text": "कार्डियक अरेस्ट की वजह से अब अमित के दो"
    },
    {
      "subtitle_id": 39,
      "start": 82.84,
      "end": 88.52,
      "text": "और भाई थे अजय और विवेक यह सारे लोग इसमें"
    },
    {
      "subtitle_id": 40,
      "start": 85.799,
      "end": 90.56,
      "text": "इवॉल्व थे तो यह जो सारे लोग हैं इनके कुछ"
    },
    {
      "subtitle_id": 41,
      "start": 88.52,
      "end": 92.399,
      "text": "रिलेटिव्स और इनके तीन दोस्त इन्होंने"
    },
    {
      "subtitle_id": 42,
      "start": 90.56,
      "end": 94.68,
      "text": "मिलकर सोचा कि एक बहुत बड़ा स्कैम करते"
    },
    {
      "subtitle_id": 43,
      "start": 92.399,
      "end": 97.24,
      "text": "हैं लेकिन फिर घर की औरतों ने सोचा कि हम"
    },
    {
      "subtitle_id": 44,
      "start": 94.68,
      "end": 99.6,
      "text": "ही पीछे क्यों रहे तो ऐसे में अजय की जो"
    },
    {
      "subtitle_id": 45,
      "start": 97.24,
      "end": 101.399,
      "text": "पत्नी है सिंपी उन्होंने भी सोचा कि मैं"
    },
    {
      "subtitle_id": 46,
      "start": 99.6,
      "end": 102.799,
      "text": "भी इसमें इंवॉल्व होंगी और बड़े लेवल पर"
    },
    {
      "subtitle_id": 47,
      "start": 101.399,
      "end": 104.68,
      "text": "इस स्कैम को करूंगी तो इस तरह से इस"
    },
    {
      "subtitle_id": 48,
      "start": 102.799,
      "end": 106.479,
      "text": "फैमिली पूरी तरह से डिटरमिन थी प्रॉपर"
    },
    {
      "subtitle_id": 49,
      "start": 104.68,
      "end": 108.759,
      "text": "इनके पास विजन था प्रॉपर एकदम"
    },
    {
      "subtitle_id": 50,
      "start": 106.479,
      "end": 110.479,
      "text": "प्रिपेरेडनेस था और फिर इन्होंने डिसाइड"
    },
    {
      "subtitle_id": 51,
      "start": 108.759,
      "end": 112.0,
      "text": "किया कि चलो बड़े लेवल पर स्कैम करते हैं"
    },
    {
      "subtitle_id": 52,
      "start": 110.479,
      "end": 113.52,
      "text": "तो अमित को बहुत अच्छे से यहां पर पता था"
    },
    {
      "subtitle_id": 53,
      "start": 112.0,
      "end": 115.36,
      "text": "कि इंडिया में अगर आपको बहुत बड़े लेवल पर"
    },
    {
      "subtitle_id": 54,
      "start": 113.52,
      "end": 117.719,
      "text": "स्कैम करना है तो पहले आपको ट्रस्ट जीतना"
    },
    {
      "subtitle_id": 55,
      "start": 115.36,
      "end": 120.36,
      "text": "होगा तो इसलिए पढ़ लिखकर ये फोस में जॉब"
    },
    {
      "subtitle_id": 56,
      "start": 117.719,
      "end": 121.759,
      "text": "करता है जॉब करने के बाद ये फिर क्रिप्टो"
    },
    {
      "subtitle_id": 57,
      "start": 120.36,
      "end": 123.68,
      "text": "करेंसी का जैसे ही इंडिया में बूम आने"
    },
    {
      "subtitle_id": 58,
      "start": 121.759,
      "end": 125.92,
      "text": "लगता है तब क्रिप्टो करेंसी पर तीन"
    },
    {
      "subtitle_id": 59,
      "start": 123.68,
      "end": 127.439,
      "text": "किताबें लिखता है जिससे लोगों को यह पता"
    },
    {
      "subtitle_id": 60,
      "start": 125.92,
      "end": 129.239,
      "text": "चले कि मैं क्रिप्टो करेंसी का एक बहुत"
    },
    {
      "subtitle_id": 61,
      "start": 127.439,
      "end": 131.2,
      "text": "बड़ा एक्सपर्ट हूं और साथ ही ये जो"
    },
    {
      "subtitle_id": 62,
      "start": 129.239,
      "end": 133.36,
      "text": "इवेंट्स है बुक लॉन्च के वहां पर बुलाता"
    },
    {
      "subtitle_id": 63,
      "start": 131.2,
      "end": 135.44,
      "text": "है बड़े-बड़े सेलिब्रिटीज को जिससे लोगों"
    },
    {
      "subtitle_id": 64,
      "start": 133.36,
      "end": 138.28,
      "text": "को तो यह पता चलता है कि यह कोई ब बहुत"
    },
    {
      "subtitle_id": 65,
      "start": 135.44,
      "end": 140.48,
      "text": "बड़ी व्यक्ति है जो जिसका बहुत बड़े-बड़े"
    },
    {
      "subtitle_id": 66,
      "start": 138.28,
      "end": 143.12,
      "text": "सेलिब्रिटीज के साथ उठना बैठना है जिसके"
    },
    {
      "subtitle_id": 67,
      "start": 140.48,
      "end": 144.959,
      "text": "बाद लोग धीरे-धीरे अमित पर भरोसा करना"
    },
    {
      "subtitle_id": 68,
      "start": 143.12,
      "end": 147.319,
      "text": "शुरू करते हैं तब इस फैमिली को लगता है कि"
    },
    {
      "subtitle_id": 69,
      "start": 144.959,
      "end": 149.12,
      "text": "दिस इज द राइट टाइम टू स्टार्ट अ स्कैम"
    },
    {
      "subtitle_id": 70,
      "start": 147.319,
      "end": 151.2,
      "text": "बहुत बढ़िया टाइमिंग आ गया है अभी काम"
    },
    {
      "subtitle_id": 71,
      "start": 149.12,
      "end": 153.08,
      "text": "शुरू करना पड़ेगा तभी यह फैमिली सिंगापुर"
    },
    {
      "subtitle_id": 72,
      "start": 151.2,
      "end": 155.959,
      "text": "में कंपनी शुरू करते जिसका नाम होता है वन"
    },
    {
      "subtitle_id": 73,
      "start": 153.08,
      "end": 158.239,
      "text": "वेरिएबल और 2015 जब हर कोई बिटकॉइन की बात"
    },
    {
      "subtitle_id": 74,
      "start": 155.959,
      "end": 160.44,
      "text": "कर रहा था ऐसे में यह लच करते हैं गेन"
    },
    {
      "subtitle_id": 75,
      "start": 158.239,
      "end": 163.28,
      "text": "बिटकॉइन नाम का एक प्रोडक्ट प्रोडक्ट बड़ा"
    },
    {
      "subtitle_id": 76,
      "start": 160.44,
      "end": 166.159,
      "text": "ही सिंपल था आपको अपने पास जो बिटकॉइन है"
    },
    {
      "subtitle_id": 77,
      "start": 163.28,
      "end": 168.36,
      "text": "वह उन्हें देने हैं ठीक है गेन बिटकॉइन"
    },
    {
      "subtitle_id": 78,
      "start": 166.159,
      "end": 170.879,
      "text": "वालों को फिर उसके बदले में वह आपको देंगे"
    },
    {
      "subtitle_id": 79,
      "start": 168.36,
      "end": 172.519,
      "text": "10 पर का रिटर्न अब अच्छी बात है कि बैंक"
    },
    {
      "subtitle_id": 80,
      "start": 170.879,
      "end": 174.68,
      "text": "आपको 6 पर का रिटर्न दे रही है एडी पर"
    },
    {
      "subtitle_id": 81,
      "start": 172.519,
      "end": 178.28,
      "text": "आपको 10 पर के रिटर्न मिल रहे हैं पर"
    },
    {
      "subtitle_id": 82,
      "start": 174.68,
      "end": 181.0,
      "text": "सुनिए 6 पर रिटर्न सालाना नहीं 6 पर"
    },
    {
      "subtitle_id": 83,
      "start": 178.28,
      "end": 183.44,
      "text": "रिटर्न हर महीने साल के हो गए 120 पर के"
    },
    {
      "subtitle_id": 84,
      "start": 181.0,
      "end": 185.159,
      "text": "रिटर्न एंड दैट इज अ वेरी वेरी बिग अमाउंट"
    },
    {
      "subtitle_id": 85,
      "start": 183.44,
      "end": 188.2,
      "text": "अब देखिए इसमें ऐसा था कि यह जो पूरी"
    },
    {
      "subtitle_id": 86,
      "start": 185.159,
      "end": 190.959,
      "text": "स्कीम 18 मंथ्स तक ही चलेगी 18 मंथ्स में"
    },
    {
      "subtitle_id": 87,
      "start": 188.2,
      "end": 192.84,
      "text": "आपको हर महीने 10 % मिलेगा यानी कि 18"
    },
    {
      "subtitle_id": 88,
      "start": 190.959,
      "end": 194.319,
      "text": "महीने में आपको मिले 180 पर के रिटर्न्स"
    },
    {
      "subtitle_id": 89,
      "start": 192.84,
      "end": 196.159,
      "text": "तो 18 मंथ्स के बाद आपने जो बिटकॉइन"
    },
    {
      "subtitle_id": 90,
      "start": 194.319,
      "end": 197.76,
      "text": "उन्हें दिया था वो आपको वापस मिल जाएगा या"
    },
    {
      "subtitle_id": 91,
      "start": 196.159,
      "end": 200.08,
      "text": "फिर अगर आपने उन्हें पैसे दिए हैं जिसके"
    },
    {
      "subtitle_id": 92,
      "start": 197.76,
      "end": 201.959,
      "text": "ऊपर वो आपको 10 पर की रिटर्न देंगे वो"
    },
    {
      "subtitle_id": 93,
      "start": 200.08,
      "end": 204.08,
      "text": "इनिशियल जो अमाउंट आपने सबमिट की थी वो भी"
    },
    {
      "subtitle_id": 94,
      "start": 201.959,
      "end": 206.28,
      "text": "आपको वापस मिल जाएगी तो इस तरह का ये"
    },
    {
      "subtitle_id": 95,
      "start": 204.08,
      "end": 207.959,
      "text": "स्कैम था अब आप देखेंगे कि ये तो प्राइमा"
    },
    {
      "subtitle_id": 96,
      "start": 206.28,
      "end": 211.04,
      "text": "फसी देखकर ही लग रहा है कि ये बहुत बड़ा"
    },
    {
      "subtitle_id": 97,
      "start": 207.959,
      "end": 214.04,
      "text": "स्कैम है तो कोई इसमें क्यों फसे का"
    },
    {
      "subtitle_id": 98,
      "start": 211.04,
      "end": 216.519,
      "text": "रंग स्कीम में 1 लाख से ज्यादा लोगों ने"
    },
    {
      "subtitle_id": 99,
      "start": 214.04,
      "end": 218.159,
      "text": "इन्वेस्ट किया है लोगों ने अमित भारद्वाज"
    },
    {
      "subtitle_id": 100,
      "start": 216.519,
      "end": 220.439,
      "text": "के जो एक्सपर्ट की इमेज है उस पर भरोसा"
    },
    {
      "subtitle_id": 101,
      "start": 218.159,
      "end": 222.599,
      "text": "करके इन्वेस्ट करना शुरू किया क्योंकि इस"
    },
    {
      "subtitle_id": 102,
      "start": 220.439,
      "end": 224.36,
      "text": "स्कीम में भी बाकी पजी स्कीम्स की तरह"
    },
    {
      "subtitle_id": 103,
      "start": 222.599,
      "end": 226.68,
      "text": "शुरुआत में जो लोगों ने इन्वेस्ट किया उन"
    },
    {
      "subtitle_id": 104,
      "start": 224.36,
      "end": 229.239,
      "text": "सब लोगों को 10 10 पर रिटर्न आना शुरू हुआ"
    },
    {
      "subtitle_id": 105,
      "start": 226.68,
      "end": 231.84,
      "text": "तो लोग सोच रहे थे कि अगर ₹ लाख पे हमें"
    },
    {
      "subtitle_id": 106,
      "start": 229.239,
      "end": 234.04,
      "text": "महीने का 00 शुरू हो रहा है तो उसमें क्या"
    },
    {
      "subtitle_id": 107,
      "start": 231.84,
      "end": 236.079,
      "text": "गलत बात है तो लोगों ने किसी और से उधार"
    },
    {
      "subtitle_id": 108,
      "start": 234.04,
      "end": 238.64,
      "text": "लिया किसी ने अपनी सारी प्रॉपर्टीज वगैरह"
    },
    {
      "subtitle_id": 109,
      "start": 236.079,
      "end": 240.64,
      "text": "बेचकर पैसा डाला तो माना जा रहा है कि"
    },
    {
      "subtitle_id": 110,
      "start": 238.64,
      "end": 242.4,
      "text": "1000 करोड़ से भी ज्यादा का ये स्कैम है"
    },
    {
      "subtitle_id": 111,
      "start": 240.64,
      "end": 244.319,
      "text": "अब सवाल यह आता है कि इसका राजकु से क्या"
    },
    {
      "subtitle_id": 112,
      "start": 242.4,
      "end": 245.799,
      "text": "लेना देना तो आते हैं वहां पर भी अब"
    },
    {
      "subtitle_id": 113,
      "start": 244.319,
      "end": 247.76,
      "text": "वीडियो में आगे बढ़ने से पहले आपको बता"
    },
    {
      "subtitle_id": 114,
      "start": 245.799,
      "end": 249.84,
      "text": "दूं कि बहुत सारे लोग जो इन स्कैम्स में"
    },
    {
      "subtitle_id": 115,
      "start": 247.76,
      "end": 251.799,
      "text": "फंसते हैं उसका मेन रीजन यह होता है कि इन"
    },
    {
      "subtitle_id": 116,
      "start": 249.84,
      "end": 253.72,
      "text": "लोगों को इन्वेस्टमेंट्स कैसे काम करती है"
    },
    {
      "subtitle_id": 117,
      "start": 251.799,
      "end": 255.76,
      "text": "पता ही नहीं होता है इन्हें नहीं पता होता"
    },
    {
      "subtitle_id": 118,
      "start": 253.72,
      "end": 257.959,
      "text": "कि म्यूचुअल फंड कैसे काम करता है कितने"
    },
    {
      "subtitle_id": 119,
      "start": 255.76,
      "end": 259.72,
      "text": "रिटर्न्स वहां पर मिलते हैं शेयर मार्केट"
    },
    {
      "subtitle_id": 120,
      "start": 257.959,
      "end": 261.759,
      "text": "कैसे काम करता है कितने एग्जैक्ट रिटर्न"
    },
    {
      "subtitle_id": 121,
      "start": 259.72,
      "end": 263.199,
      "text": "वहां पर मिलते हैं इसीलिए जब कोई व्यक्ति"
    },
    {
      "subtitle_id": 122,
      "start": 261.759,
      "end": 265.16,
      "text": "इन्हे आकर बोलता है कि मैं आपको इतने"
    },
    {
      "subtitle_id": 123,
      "start": 263.199,
      "end": 266.84,
      "text": "रिटर्न दूंगा ये तुरंत भरोसा कर लेते हैं"
    },
    {
      "subtitle_id": 124,
      "start": 265.16,
      "end": 269.4,
      "text": "क्योंकि रिटर्न्स का कैलकुलेशन इन्हें"
    },
    {
      "subtitle_id": 125,
      "start": 266.84,
      "end": 271.639,
      "text": "नहीं पता होता तो यही सारी चीजें सीखने की"
    },
    {
      "subtitle_id": 126,
      "start": 269.4,
      "end": 273.96,
      "text": "सभी को जरूरत है बीट म्यूचुअल फंड बीट"
    },
    {
      "subtitle_id": 127,
      "start": 271.639,
      "end": 275.96,
      "text": "स्टॉक मार्केट अब सवाल यह आता है कि सीखें"
    },
    {
      "subtitle_id": 128,
      "start": 273.96,
      "end": 278.36,
      "text": "कहां से शुरुआत कहां से करें तो इसके लिए"
    },
    {
      "subtitle_id": 129,
      "start": 275.96,
      "end": 280.56,
      "text": "हमने आपके लिए बनाए हैं सिक्स एनिमेटेड"
    },
    {
      "subtitle_id": 130,
      "start": 278.36,
      "end": 282.8,
      "text": "शेयर मार्केट एंड म्यूचुअल फंड कोर्सेस"
    },
    {
      "subtitle_id": 131,
      "start": 280.56,
      "end": 284.56,
      "text": "जहां पर आप म्यूचुअल फंड और शेयर मार्केट"
    },
    {
      "subtitle_id": 132,
      "start": 282.8,
      "end": 287.24,
      "text": "को बेसिक से समझ सकते हैं एक बिगनर भी"
    },
    {
      "subtitle_id": 133,
      "start": 284.56,
      "end": 289.36,
      "text": "बड़ी आसानी से सारी चीजें समझ सकता है और"
    },
    {
      "subtitle_id": 134,
      "start": 287.24,
      "end": 291.68,
      "text": "इसीलिए स्पेशली हमने एनिमेटेड यह कोर्सेस"
    },
    {
      "subtitle_id": 135,
      "start": 289.36,
      "end": 294.759,
      "text": "बनाए हैं ताकि कोई भी बड़े आसानी से चीजें"
    },
    {
      "subtitle_id": 136,
      "start": 291.68,
      "end": 296.6,
      "text": "सीख सके 21700 के जो कोर्सेस हैं आपको"
    },
    {
      "subtitle_id": 137,
      "start": 294.759,
      "end": 298.199,
      "text": "फ्री में मिल सकते हैं उसके लिए सिंपली"
    },
    {
      "subtitle_id": 138,
      "start": 296.6,
      "end": 300.08,
      "text": "आपको नीचे डिस्क्रिप्शन और कमेंट बॉक्स"
    },
    {
      "subtitle_id": 139,
      "start": 298.199,
      "end": 301.6,
      "text": "में दी गई लिंक पर क्लिक करके किसी भी एक"
    },
    {
      "subtitle_id": 140,
      "start": 300.08,
      "end": 303.28,
      "text": "ब्रोकर के साथ अपना फ्री इन्वेस्टमेंट"
    },
    {
      "subtitle_id": 141,
      "start": 301.6,
      "end": 305.12,
      "text": "अकाउंट ओपन करना पड़ेगा यह फ्री"
    },
    {
      "subtitle_id": 142,
      "start": 303.28,
      "end": 307.8,
      "text": "इन्वेस्टमेंट अकाउंट ओपन होने के बाद आपको"
    },
    {
      "subtitle_id": 143,
      "start": 305.12,
      "end": 307.8,
      "text": "इन दो नंबर पर"
    },
    {
      "subtitle_id": 144,
      "start": 329.8,
      "end": 334.12,
      "text": "तो 2017 में हुआ यह कि बिटकॉइन की"
    },
    {
      "subtitle_id": 145,
      "start": 332.28,
      "end": 336.08,
      "text": "प्राइसेस अचानक से बहुत तेजी से गिरने लगी"
    },
    {
      "subtitle_id": 146,
      "start": 334.12,
      "end": 337.72,
      "text": "तो लगभग 50 पर बिटकॉइन की प्राइस गिरने की"
    },
    {
      "subtitle_id": 147,
      "start": 336.08,
      "end": 339.72,
      "text": "वजह से काफी सारे लोगों का कॉन्फिडेंस"
    },
    {
      "subtitle_id": 148,
      "start": 337.72,
      "end": 341.96,
      "text": "नहीं था बिटकॉइन पर इसलिए उन्होंने नया"
    },
    {
      "subtitle_id": 149,
      "start": 339.72,
      "end": 344.12,
      "text": "पैसा अमित के पास देना बंद कर दिया अब"
    },
    {
      "subtitle_id": 150,
      "start": 341.96,
      "end": 346.039,
      "text": "आपके पास जब आप पनजी स्कीम चला रहे हैं तो"
    },
    {
      "subtitle_id": 151,
      "start": 344.12,
      "end": 347.919,
      "text": "आपका मेन गेम तो यही है कि आप नए लोगों से"
    },
    {
      "subtitle_id": 152,
      "start": 346.039,
      "end": 350.16,
      "text": "पैसा लेंगे और पुराने लोगों को बांटेंगे"
    },
    {
      "subtitle_id": 153,
      "start": 347.919,
      "end": 353.199,
      "text": "नए लोगों से पैसा नष्ट बंद हुआ मतलब आपका"
    },
    {
      "subtitle_id": 154,
      "start": 350.16,
      "end": 355.44,
      "text": "स्कैम क्लोज करने का टाइम आ गया तो 2017"
    },
    {
      "subtitle_id": 155,
      "start": 353.199,
      "end": 357.12,
      "text": "में इस मुकाम पर यह स्कैम आ गया कि अब यह"
    },
    {
      "subtitle_id": 156,
      "start": 355.44,
      "end": 359.24,
      "text": "बंद करना पड़ेगा और जितने पैसे हैं वो"
    },
    {
      "subtitle_id": 157,
      "start": 357.12,
      "end": 360.199,
      "text": "लेकर भागना पड़ेगा तो इस बीच इन्होंने जो"
    },
    {
      "subtitle_id": 158,
      "start": 359.24,
      "end": 362.96,
      "text": "करोड़"
    },
    {
      "subtitle_id": 159,
      "start": 360.199,
      "end": 364.8,
      "text": "बनाए थे वो इन्होंने उससे अलग-अलग कंट्रीज"
    },
    {
      "subtitle_id": 160,
      "start": 362.96,
      "end": 366.96,
      "text": "में प्रॉपर्टीज खरीद ली और काफी सारे जो"
    },
    {
      "subtitle_id": 161,
      "start": 364.8,
      "end": 368.919,
      "text": "बिटकॉइन है वह ई वॉलेट में ही रख दिए ताकि"
    },
    {
      "subtitle_id": 162,
      "start": 366.96,
      "end": 370.479,
      "text": "किसी को पता ना चले कैश में पैसे रखेंगे"
    },
    {
      "subtitle_id": 163,
      "start": 368.919,
      "end": 372.56,
      "text": "इतने बड़े ट्रांजैक्शंस होंगे तो कभी ना"
    },
    {
      "subtitle_id": 164,
      "start": 370.479,
      "end": 374.759,
      "text": "कभी पकड़े जाएंगे इसकी अमित को अच्छे से"
    },
    {
      "subtitle_id": 165,
      "start": 372.56,
      "end": 376.8,
      "text": "समझते इसलिए अमित ने वो गलती नहीं की और"
    },
    {
      "subtitle_id": 166,
      "start": 374.759,
      "end": 378.96,
      "text": "इसलिए इंटरेस्टिंग बात यह है कि आज भी"
    },
    {
      "subtitle_id": 167,
      "start": 376.8,
      "end": 381.28,
      "text": "काफी सारे जो बिटकॉइन ई वॉलेट में रखे हैं"
    },
    {
      "subtitle_id": 168,
      "start": 378.96,
      "end": 383.919,
      "text": "वो किस ई वॉलेट में हैं कैसे उन्हें लाया"
    },
    {
      "subtitle_id": 169,
      "start": 381.28,
      "end": 386.759,
      "text": "जाए यह ईडी को भी अभी फिलहाल तक नहीं पता"
    },
    {
      "subtitle_id": 170,
      "start": 383.919,
      "end": 388.919,
      "text": "चला है फिर 2017 में जब यह स्कैम करके"
    },
    {
      "subtitle_id": 171,
      "start": 386.759,
      "end": 391.16,
      "text": "सारे लोग भाग गए तो उससे पहले ईडी ने इनको"
    },
    {
      "subtitle_id": 172,
      "start": 388.919,
      "end": 392.88,
      "text": "दबोच लिया और पकड़ के इन पर इन्वेस्टिगेशन"
    },
    {
      "subtitle_id": 173,
      "start": 391.16,
      "end": 395.12,
      "text": "शुरू किया तो इन्वेस्टिगेशन में पता चला"
    },
    {
      "subtitle_id": 174,
      "start": 392.88,
      "end": 397.16,
      "text": "कि इसमें सिर्फ अमित भारद्वाज नहीं पूरी"
    },
    {
      "subtitle_id": 175,
      "start": 395.12,
      "end": 399.24,
      "text": "की पूरी फैमिली शामिल है तो फिर ईडी ने इस"
    },
    {
      "subtitle_id": 176,
      "start": 397.16,
      "end": 401.56,
      "text": "पर इन्वेस्ट डीप इन्वेस्टिगेशन शुरू किया"
    },
    {
      "subtitle_id": 177,
      "start": 399.24,
      "end": 403.36,
      "text": "2017 से लेकर अब तक तो ये सारे"
    },
    {
      "subtitle_id": 178,
      "start": 401.56,
      "end": 405.84,
      "text": "इन्वेस्टिगेशन करते-करते ईडी के टीम के"
    },
    {
      "subtitle_id": 179,
      "start": 403.36,
      "end": 407.759,
      "text": "हाथ में एक बहुत बड़ी डिटेल आई डिटेल क्या"
    },
    {
      "subtitle_id": 180,
      "start": 405.84,
      "end": 410.36,
      "text": "थी एक शॉकिंग मतलब टर्निंग पॉइंट आया"
    },
    {
      "subtitle_id": 181,
      "start": 407.759,
      "end": 413.4,
      "text": "इन्वेस्टिगेशन में कि अमित भारद्वाज ने"
    },
    {
      "subtitle_id": 182,
      "start": 410.36,
      "end": 415.0,
      "text": "285 बिट कॉइंस किसी को भेजे थे फिर ईडी ने"
    },
    {
      "subtitle_id": 183,
      "start": 413.4,
      "end": 417.039,
      "text": "उस पर काम करना शुरू किया तो उन्हें पता"
    },
    {
      "subtitle_id": 184,
      "start": 415.0,
      "end": 419.24,
      "text": "चला कि तो ये जो 285 बिटकॉइन है जिसकी"
    },
    {
      "subtitle_id": 185,
      "start": 417.039,
      "end": 421.319,
      "text": "वर्थ आज 150 करोड़ से भी ज्यादा है उसे एक"
    },
    {
      "subtitle_id": 186,
      "start": 419.24,
      "end": 424.28,
      "text": "बहुत बड़े बिजनेसमैन को भेजा गया अब ये"
    },
    {
      "subtitle_id": 187,
      "start": 421.319,
      "end": 426.68,
      "text": "बिजनेसमैन कौन है एनी केसेस ऑफकोर्स राज"
    },
    {
      "subtitle_id": 188,
      "start": 424.28,
      "end": 428.44,
      "text": "कुंद्र अब यह पता चलने के बाद ईडी ने"
    },
    {
      "subtitle_id": 189,
      "start": 426.68,
      "end": 430.56,
      "text": "तुरंत राज कुंद्रा पर एक्शन लेना शुरू"
    },
    {
      "subtitle_id": 190,
      "start": 428.44,
      "end": 432.56,
      "text": "किया और उसकी जो प्रॉपर्टीज है उन्हें"
    },
    {
      "subtitle_id": 191,
      "start": 430.56,
      "end": 434.56,
      "text": "अटैच करना शुरू किया लगभग 97 करोड़ की"
    },
    {
      "subtitle_id": 192,
      "start": 432.56,
      "end": 436.44,
      "text": "प्रॉपर्टीज को अटैच किया गया है बाकी और"
    },
    {
      "subtitle_id": 193,
      "start": 434.56,
      "end": 438.039,
      "text": "प्रॉपर्टीज को अटैच करना शुरू है लेकिन"
    },
    {
      "subtitle_id": 194,
      "start": 436.44,
      "end": 440.039,
      "text": "आखिर बचा नहीं अभी ज्यादा कुछ तो राज"
    },
    {
      "subtitle_id": 195,
      "start": 438.039,
      "end": 442.68,
      "text": "कुंदरा को ये बिटकॉइन क्यों भेजे गए तो"
    },
    {
      "subtitle_id": 196,
      "start": 440.039,
      "end": 445.199,
      "text": "इसके दो साइड्स हैं आप जिसकी सुनना चाहे"
    },
    {
      "subtitle_id": 197,
      "start": 442.68,
      "end": 447.36,
      "text": "उसकी सुनिए डी का ये कहना है कि जो 285"
    },
    {
      "subtitle_id": 198,
      "start": 445.199,
      "end": 449.039,
      "text": "बिटकॉइन है भारद्वाज फैमिली ने राज"
    },
    {
      "subtitle_id": 199,
      "start": 447.36,
      "end": 450.52,
      "text": "कुंद्रा को मनी लरिंग के लिए भेजे और जिस"
    },
    {
      "subtitle_id": 200,
      "start": 449.039,
      "end": 452.44,
      "text": "तरह का ट्र ट्रैक रिकॉर्ड राज कुंदरा का"
    },
    {
      "subtitle_id": 201,
      "start": 450.52,
      "end": 454.28,
      "text": "है उससे ईडी को बहुत ज्यादा कॉन्फिडेंस है"
    },
    {
      "subtitle_id": 202,
      "start": 452.44,
      "end": 455.879,
      "text": "कि ये मनी लरिंग का ही मामला है वहीं पर"
    },
    {
      "subtitle_id": 203,
      "start": 454.28,
      "end": 457.8,
      "text": "राज कुंदरा का यह कहना है कि अमित"
    },
    {
      "subtitle_id": 204,
      "start": 455.879,
      "end": 460.16,
      "text": "भारद्वाज ने इन्वेस्टर्स को बताया था कि"
    },
    {
      "subtitle_id": 205,
      "start": 457.8,
      "end": 462.039,
      "text": "मेरा यूक्रेन में एक बहुत बड़ा फार्म है"
    },
    {
      "subtitle_id": 206,
      "start": 460.16,
      "end": 464.0,
      "text": "जहां पर हम माइनिंग करते हैं बिटकॉइन"
    },
    {
      "subtitle_id": 207,
      "start": 462.039,
      "end": 466.0,
      "text": "फार्म जहां पर हम माइनिंग करते हैं तो"
    },
    {
      "subtitle_id": 208,
      "start": 464.0,
      "end": 467.759,
      "text": "उसके लिए उसने मुझे ये भेजा था ऐसा राज"
    },
    {
      "subtitle_id": 209,
      "start": 466.0,
      "end": 469.44,
      "text": "कुंदरा का कहना है हालांकि जब भारद्वाज"
    },
    {
      "subtitle_id": 210,
      "start": 467.759,
      "end": 471.039,
      "text": "फैमिली इस पूरी चीज को प्रमोट कर रही थी"
    },
    {
      "subtitle_id": 211,
      "start": 469.44,
      "end": 473.319,
      "text": "तो उन्होंने क्या किया कि अमित भारद्वाज"
    },
    {
      "subtitle_id": 212,
      "start": 471.039,
      "end": 475.039,
      "text": "चाइना गया वहां पर बड़ी-बड़ी जो माइनिंग"
    },
    {
      "subtitle_id": 213,
      "start": 473.319,
      "end": 477.0,
      "text": "कंपनीज है बिटकॉइन माइनिंग कंपनीज उसने"
    },
    {
      "subtitle_id": 214,
      "start": 475.039,
      "end": 478.68,
      "text": "उसे विजिट किया उसके साथ फोटो निकाले और"
    },
    {
      "subtitle_id": 215,
      "start": 477.0,
      "end": 480.84,
      "text": "ये बताए कि ये मेरी माइनिंग कंपनीज है जो"
    },
    {
      "subtitle_id": 216,
      "start": 478.68,
      "end": 482.599,
      "text": "चाइना में चल रही है यूक्रेन में मैं एक"
    },
    {
      "subtitle_id": 217,
      "start": 480.84,
      "end": 484.199,
      "text": "और बना रहा हूं तो राज कुंदरा ने कहा कि"
    },
    {
      "subtitle_id": 218,
      "start": 482.599,
      "end": 486.8,
      "text": "जो यूक्रेन वाला सीन है वो मैं ही करके"
    },
    {
      "subtitle_id": 219,
      "start": 484.199,
      "end": 488.639,
      "text": "देने वाला था और इसीलिए मेरे पास वो 285"
    },
    {
      "subtitle_id": 220,
      "start": 486.8,
      "end": 490.639,
      "text": "बिट कॉइंस है और वहीं पर दूसरी तरफ"
    },
    {
      "subtitle_id": 221,
      "start": 488.639,
      "end": 493.4,
      "text": "भारद्वाज फैमिली है उस पर हजारों केसेस है"
    },
    {
      "subtitle_id": 222,
      "start": 490.639,
      "end": 495.479,
      "text": "ल ओवर इंडिया अलग-अलग डिफरेंट सिटीज में"
    },
    {
      "subtitle_id": 223,
      "start": 493.4,
      "end": 497.12,
      "text": "क्योंकि इन्होंने जो 10-10 पर का लालच"
    },
    {
      "subtitle_id": 224,
      "start": 495.479,
      "end": 499.0,
      "text": "देकर लोगों का पैसा लिया था उनके बिटकॉइन"
    },
    {
      "subtitle_id": 225,
      "start": 497.12,
      "end": 500.759,
      "text": "लिए थे वो आज तक वापस नहीं किए हैं इनके"
    },
    {
      "subtitle_id": 226,
      "start": 499.0,
      "end": 502.84,
      "text": "नाम पर कंप्लेंट्स ही कंप्लेंट्स है तो"
    },
    {
      "subtitle_id": 227,
      "start": 500.759,
      "end": 504.919,
      "text": "ईडी ने छापे मारकर इनसे 70 करोड़ की"
    },
    {
      "subtitle_id": 228,
      "start": 502.84,
      "end": 506.72,
      "text": "प्रॉपर्टीज तो अटैच करवा ली लेकिन स्कैम"
    },
    {
      "subtitle_id": 229,
      "start": 504.919,
      "end": 509.039,
      "text": "तो बहुत बड़ा है तो बाकी पैसा कहां से"
    },
    {
      "subtitle_id": 230,
      "start": 506.72,
      "end": 510.72,
      "text": "वसूल होगा तो प्रॉब्लम यह है कि काफी सारा"
    },
    {
      "subtitle_id": 231,
      "start": 509.039,
      "end": 512.919,
      "text": "पैसा इन्होंने ई वॉलेट में रखा है जो"
    },
    {
      "subtitle_id": 232,
      "start": 510.72,
      "end": 515.399,
      "text": "बिटकॉइन है वो ईई वॉलेट में रखे हैं और"
    },
    {
      "subtitle_id": 233,
      "start": 512.919,
      "end": 517.279,
      "text": "उसकी डिटेल्स ना कोई दे रहा है ना कोई ईडी"
    },
    {
      "subtitle_id": 234,
      "start": 515.399,
      "end": 520.12,
      "text": "को बता रहा है तो अभी सबसे बड़ा सवाल है"
    },
    {
      "subtitle_id": 235,
      "start": 517.279,
      "end": 522.279,
      "text": "कि क्या ये ई वॉलेट ईडी तक पहुंचेगा ईडी"
    },
    {
      "subtitle_id": 236,
      "start": 520.12,
      "end": 524.12,
      "text": "को पता चलेगा और फिर फाइनल सबसे बड़ा सवाल"
    },
    {
      "subtitle_id": 237,
      "start": 522.279,
      "end": 526.279,
      "text": "कि जिन लोगों ने इस स्कीम में पैसा डाला"
    },
    {
      "subtitle_id": 238,
      "start": 524.12,
      "end": 528.399,
      "text": "था क्या उन्हें कभी अपना पैसा मिल पाएगा"
    },
    {
      "subtitle_id": 239,
      "start": 526.279,
      "end": 529.76,
      "text": "कमेंट करके आप जरूर बताइए लेकिन मेजॉरिटी"
    },
    {
      "subtitle_id": 240,
      "start": 528.399,
      "end": 531.32,
      "text": "चीजों में हम यही देखते हैं कि जब भी आप"
    },
    {
      "subtitle_id": 241,
      "start": 529.76,
      "end": 533.24,
      "text": "इस तरह की चीजों में फंसते हैं लालच को"
    },
    {
      "subtitle_id": 242,
      "start": 531.32,
      "end": 536.279,
      "text": "देखकर तो ज्यादातर टाइम आपको अपना पैसा"
    },
    {
      "subtitle_id": 243,
      "start": 533.24,
      "end": 538.48,
      "text": "नहीं मिलता है यही हिस्ट्री बता दी है और"
    },
    {
      "subtitle_id": 244,
      "start": 536.279,
      "end": 540.279,
      "text": "यही अब तक होते आ रहा है तो यह आपको ही"
    },
    {
      "subtitle_id": 245,
      "start": 538.48,
      "end": 542.32,
      "text": "सावधान होना है इसमें कोई और समझाने नहीं"
    },
    {
      "subtitle_id": 246,
      "start": 540.279,
      "end": 544.24,
      "text": "आएगा देखिए हालांकि लालच एक ऐसी चीज है कि"
    },
    {
      "subtitle_id": 247,
      "start": 542.32,
      "end": 546.72,
      "text": "उसके सामने आदमी को कुछ नहीं दिखता है आज"
    },
    {
      "subtitle_id": 248,
      "start": 544.24,
      "end": 548.48,
      "text": "भी ऑल ओवर इंडिया हजारों ऐसी पज स्कीम्स"
    },
    {
      "subtitle_id": 249,
      "start": 546.72,
      "end": 550.279,
      "text": "चल रही हैं जिसमें इसी तरह के प्रॉमिस किए"
    },
    {
      "subtitle_id": 250,
      "start": 548.48,
      "end": 551.64,
      "text": "जा रहे हैं लोग आग बंद करके इन्वेस्ट कर"
    },
    {
      "subtitle_id": 251,
      "start": 550.279,
      "end": 553.16,
      "text": "रहे हैं क्योंकि उनके रिलेटिव्स को अब तक"
    },
    {
      "subtitle_id": 252,
      "start": 551.64,
      "end": 555.399,
      "text": "पैसे मिल रहे हैं क्योंकि वो शुरुआती"
    },
    {
      "subtitle_id": 253,
      "start": 553.16,
      "end": 558.24,
      "text": "लोगों में से एक है सो मोड अस ऑपरेंडी वही"
    },
    {
      "subtitle_id": 254,
      "start": 555.399,
      "end": 560.079,
      "text": "है कुछ और नया नहीं कर रहे पर हां यही सब"
    },
    {
      "subtitle_id": 255,
      "start": 558.24,
      "end": 561.519,
      "text": "चल रहा है तो इन सारी चीजों को अवॉइड करने"
    },
    {
      "subtitle_id": 256,
      "start": 560.079,
      "end": 563.2,
      "text": "के लिए खुद अवेयर बनना जरूरी है और उसके"
    },
    {
      "subtitle_id": 257,
      "start": 561.519,
      "end": 565.76,
      "text": "लिए जरूर आप चैनल को सब्सक्राइब करें और"
    },
    {
      "subtitle_id": 258,
      "start": 563.2,
      "end": 567.32,
      "text": "साथ ही बेल आइकन पर भी क्लिक करें और अपने"
    },
    {
      "subtitle_id": 259,
      "start": 565.76,
      "end": 569.36,
      "text": "दोस्तों के साथ भी इस वीडियो को जरूर शेयर"
    },
    {
      "subtitle_id": 260,
      "start": 567.32,
      "end": 571.399,
      "text": "करें ताकि इस तरह की चीजों से वो भी अवेयर"
    },
    {
      "subtitle_id": 261,
      "start": 569.36,
      "end": 573.16,
      "text": "रहे और फ्यूचर में ऐसे किसी भी झांसे में"
    },
    {
      "subtitle_id": 262,
      "start": 571.399,
      "end": 575.399,
      "text": "वो ना आए और अपनी जो वैल्युएबल अर्निंग्स"
    },
    {
      "subtitle_id": 263,
      "start": 573.16,
      "end": 579.64,
      "text": "है वो ना गवाए तो मिलते हैं अगले वीडियो"
    },
    {
      "subtitle_id": 264,
      "start": 575.399,
      "end": 579.64,
      "text": "में थैंक यू सो मच फॉर वाचिंग दिस वीडियो"
    }
  ]
}