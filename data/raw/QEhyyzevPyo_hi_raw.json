    {
      "subtitle_id": 141,
      "start": 301.08,
      "end": 304.96,
      "text": "उन्होंने इस कंपनी में शॉर्ट पोजीशन ली है"
    },
    {
      "subtitle_id": 142,
      "start": 303.24,
      "end": 307.24,
      "text": "यह मीडिया में जाते हैं अखबारों में"
    },
    {
      "subtitle_id": 143,
      "start": 304.96,
      "end": 309.32,
      "text": "इंटरव्यू देते हैं रिपोर्ट निकालते हैं और"
