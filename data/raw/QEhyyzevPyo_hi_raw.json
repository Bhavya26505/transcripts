    {
      "subtitle_id": 174,
      "start": 370.12,
      "end": 373.72,
      "text": "एडवर्टाइजमेंट और प्रमोशन वीडियो में जो"
    },
    {
      "subtitle_id": 175,
      "start": 371.8,
      "end": 375.84,
      "text": "ट्रक चलती हुई दिखाई गई थी वो चल नहीं रही"
    },
    {
      "subtitle_id": 176,
      "start": 373.72,
      "end": 378.319,
      "text": "थी बल्कि लुड़क रही थी क्योंकि ये लोग एक"
    },
    {
      "subtitle_id": 177,
      "start": 375.84,
      "end": 380.36,
      "text": "ट्रक को स्लोप वाले रोड पर लेकर गए और उसे"
    },
    {
      "subtitle_id": 178,
      "start": 378.319,
      "end": 381.88,
      "text": "पीछे से धक्का दिया और जैसे ही ये ट्रक"
    },
    {
      "subtitle_id": 179,
      "start": 380.36,
      "end": 383.919,
      "text": "नीचे जाने लगा उस स्लोप की वजह से"
