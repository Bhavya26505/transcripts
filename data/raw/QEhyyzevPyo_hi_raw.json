    {
      "subtitle_id": 153,
      "start": 326.199,
      "end": 329.84,
      "text": "कंप्लीट हो जाती है तो रिसर्च रिपोर्ट"
    },
    {
      "subtitle_id": 154,
      "start": 327.759,
      "end": 331.56,
      "text": "पब्लिश करने से पहले ये शॉर्ट पोजीशन ले"
    },
    {
      "subtitle_id": 155,
      "start": 329.84,
      "end": 333.36,
      "text": "लेते हैं फिर रिपोर्ट पब्लिश करते हैं"
    },
    {
      "subtitle_id": 156,
      "start": 331.56,
      "end": 335.44,
      "text": "जिसके बाद शेयर प्राइस गिर जाती है और"
