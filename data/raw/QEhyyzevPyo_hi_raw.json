    {
      "subtitle_id": 182,
      "start": 386.039,
      "end": 389.68,
      "text": "पता चली तो उन्होंने कंपनीज के एक्स"
    },
    {
      "subtitle_id": 183,
      "start": 387.68,
      "end": 391.4,
      "text": "एंप्लॉई से बात की तब जाक इन चीजों को का"
    },
    {
      "subtitle_id": 184,
      "start": 389.68,
      "end": 392.8,
      "text": "खुलासा हो इतना ही नहीं निकोला के फाउंडर"
    },
    {
      "subtitle_id": 185,
      "start": 391.4,
      "end": 394.88,
      "text": "ने बताया था कि उनका जो मैन्युफैक्चरिंग"
    },
    {
      "subtitle_id": 186,
      "start": 392.8,
      "end": 397.16,
      "text": "प्लांट है वो पूरा सोलर पर चलता है और"
    },
    {
      "subtitle_id": 187,
      "start": 394.88,
      "end": 399.479,
      "text": "उनके छत पर सारे सोलर पैनल्स लगे हैं और"
    },
    {
      "subtitle_id": 188,
      "start": 397.16,
      "end": 401.96,
      "text": "आप देख सकते हो कि छत पर कोई भी सोलर पैनल"
    },
    {
      "subtitle_id": 189,
      "start": 399.479,
      "end": 403.96,
      "text": "नहीं है सो यस यू कैन हेट हिंडन बग पर"
    },
    {
      "subtitle_id": 190,
      "start": 401.96,
      "end": 406.319,
      "text": "इनकी जो क्रिएटिविटी है काम करने का तरीका"
    },
    {
      "subtitle_id": 191,
      "start": 403.96,
      "end": 408.479,
      "text": "है वो जरूर बहुत ही काबिले तारीफ है भले"
    },
    {
      "subtitle_id": 192,
      "start": 406.319,
      "end": 410.96,
      "text": "ही इनके एंप्लॉई सिर्फ एक डजन हो पर ये"
    },
    {
      "subtitle_id": 193,
      "start": 408.479,
      "end": 413.08,
      "text": "इतनी ताकत रखते हैं कि आपका प्राइवेट ईमेल"
    },
    {
      "subtitle_id": 194,
      "start": 410.96,
      "end": 415.599,
      "text": "का स्क्रीनशॉट ये निकाल ले यू नो व्हाट आई"
    },
    {
      "subtitle_id": 195,
      "start": 413.08,
      "end": 417.56,
      "text": "एम सेइंग आखरी पॉइंट हिंडन बग पैसे कैसे"
    },
    {
      "subtitle_id": 196,
      "start": 415.599,
      "end": 419.36,
      "text": "कमाता है तो इसके दो तरीके हैं पहला यह"
    },
    {
      "subtitle_id": 197,
      "start": 417.56,
      "end": 421.52,
      "text": "खुद शॉर्ट पोजीशन लेते हैं रिपोर्ट पब्लिश"
    },
    {
      "subtitle_id": 198,
      "start": 419.36,
      "end": 423.479,
      "text": "कर करने से पहले रिपोर्ट आने के बाद"
    },
    {
      "subtitle_id": 199,
      "start": 421.52,
      "end": 425.36,
      "text": "ऑफकोर्स बड़ा एक्सपोज होता है शेयर प्राइस"
    },
    {
      "subtitle_id": 200,
      "start": 423.479,
      "end": 427.08,
      "text": "गिर जाती है वहां से पैसे कमाते हैं दूसरा"
    },
    {
      "subtitle_id": 201,
      "start": 425.36,
      "end": 429.28,
      "text": "है कि यह किसी हेज फंड को अपनी रिपोर्ट"
    },
    {
      "subtitle_id": 202,
      "start": 427.08,
      "end": 431.12,
      "text": "बेच देते हैं ऑन अ कमीशन बेसिस जैसे कि"
    },
    {
      "subtitle_id": 203,
      "start": 429.28,
      "end": 433.68,
      "text": "अदानी की रिपोर्ट रिलीज होने से दो महीने"
    },
    {
      "subtitle_id": 204,
      "start": 431.12,
      "end": 435.879,
      "text": "पहले ही हिंडन बग ने किंगडम कैपिटल को 30"
    },
    {
      "subtitle_id": 205,
      "start": 433.68,
      "end": 438.56,
      "text": "पर कमीशन पर यह रिपोर्ट बेज दी थी जिससे"
    },
    {
      "subtitle_id": 206,
      "start": 435.879,
      "end": 440.319,
      "text": "हिंडन बग ने लगभग ₹ करोड़ कमा लिए थे और"
    },
    {
      "subtitle_id": 207,
      "start": 438.56,
      "end": 442.24,
      "text": "इनके जो एक्सपेंसेस है वो भी काफी बड़े"
    },
    {
      "subtitle_id": 208,
      "start": 440.319,
      "end": 444.28,
      "text": "होते हैं क्योंकि जो विसल ब्लोअर है जो"
    },
    {
      "subtitle_id": 209,
      "start": 442.24,
      "end": 446.4,
      "text": "इनको खुफिया इंफॉर्मेशन देते हैं वो भी"
    },
    {
      "subtitle_id": 210,
      "start": 444.28,
      "end": 448.24,
      "text": "अच्छा खासा पैसा मांगते हैं तो यह शॉर्ट"
    },
    {
      "subtitle_id": 211,
      "start": 446.4,
      "end": 450.56,
      "text": "सेलिंग का बिजनेस बहुत बड़ा है जिसमें"
    },
    {
      "subtitle_id": 212,
      "start": 448.24,
      "end": 452.96,
      "text": "हिंडन बग जैसी कंपनीज तो सिर्फ एक प्यादे"
    },
    {
      "subtitle_id": 213,
      "start": 450.56,
      "end": 455.16,
      "text": "की तरह काम करती है किंग कोई और होते हैं"
    },
    {
      "subtitle_id": 214,
      "start": 452.96,
      "end": 457.56,
      "text": "किंग होते हैं हेज फंड्स के मालिक जैसे कि"
    },
    {
      "subtitle_id": 215,
      "start": 455.16,
      "end": 459.479,
      "text": "फॉर एग्जांपल जिम चैनस जिन्होंने एरन को"
    },
    {
      "subtitle_id": 216,
      "start": 457.56,
      "end": 461.56,
      "text": "शॉर्ट किया था जॉन पॉलसन जिन्होंने"
    },
    {
      "subtitle_id": 217,
      "start": 459.479,
      "end": 463.919,
      "text": "हाउसिंग मार्केट को शॉर्ट किया था 2008"
    },
    {
      "subtitle_id": 218,
      "start": 461.56,
      "end": 466.0,
      "text": "में इन्होंने एक ट्रेड में ही लगभग 00"
    },
    {
      "subtitle_id": 219,
      "start": 463.919,
      "end": 467.879,
      "text": "करोड़ कमाए थे और इसके अलावा और भी कई"
    },
    {
      "subtitle_id": 220,
      "start": 466.0,
      "end": 470.08,
      "text": "सारे हेच फंड्स हैं जो इस तरह का काम करते"
    },
    {
      "subtitle_id": 221,
      "start": 467.879,
      "end": 471.879,
      "text": "हैं ये जितने भी मैंने नाम लिए हर किसी पर"
    },
    {
      "subtitle_id": 222,
      "start": 470.08,
      "end": 473.8,
      "text": "एक डेडिकेटेड वीडियो बन सकता है ऐसी कुछ"
    },
    {
      "subtitle_id": 223,
      "start": 471.879,
      "end": 476.0,
      "text": "कहानियां है इनकी तो आई होप वीडियो आपको"
    },
    {
      "subtitle_id": 224,
      "start": 473.8,
      "end": 477.759,
      "text": "पसंद आया होगा तो इस पूरे हिंडन बग सागा"
    },
    {
      "subtitle_id": 225,
      "start": 476.0,
      "end": 479.879,
      "text": "पर आपका क्या कहना है नीचे कमेंट करके"
    },
    {
      "subtitle_id": 226,
      "start": 477.759,
      "end": 482.24,
      "text": "जरूर बताइए और जाते-जाते हमारे फंडामेंटल"
    },
    {
      "subtitle_id": 227,
      "start": 479.879,
      "end": 484.319,
      "text": "एलिस 2.0 को जरूर चेक आउट कीजिए क्योंकि"
    },
    {
      "subtitle_id": 228,
      "start": 482.24,
      "end": 486.319,
      "text": "इस ऑफर के बस आखिरी चंद घंटे बाकी हैं"
    },
    {
      "subtitle_id": 229,
      "start": 484.319,
      "end": 489.24,
      "text": "जहां पर ₹ 77000 का यह कोर्स आपको मिल रहा"
    },
    {
      "subtitle_id": 230,
      "start": 486.319,
      "end": 491.319,
      "text": "है मात्र ₹1 में लाइफ टाइम एक्सेस के साथ"
    },
    {
      "subtitle_id": 231,
      "start": 489.24,
      "end": 494.12,
      "text": "सर्टिफिकेट के साथ और बहुत ही डिटेल"
    },
    {
      "subtitle_id": 232,
      "start": 491.319,
      "end": 496.159,
      "text": "लेक्चर के साथ इस ऑफर के बस चंद घंटे बाकी"
    },
    {
      "subtitle_id": 233,
      "start": 494.12,
      "end": 499.56,
      "text": "हैं तो ऑफर खत्म होने से पहले जरूर इस ऑफर"
    },
    {
      "subtitle_id": 234,
      "start": 496.159,
      "end": 499.56,
      "text": "का फायदा लें"
    }
  ]
}