    {
      "subtitle_id": 131,
      "start": 281.52,
      "end": 285.16,
      "text": "शेयर की प्राइस नीचे चली जाती है लेकिन"
    },
    {
      "subtitle_id": 132,
      "start": 283.44,
      "end": 287.56,
      "text": "शॉर्ट सेलिंग में भी दो टाइप की कंपनीज"
