    {
      "subtitle_id": 157,
      "start": 333.36,
      "end": 337.12,
      "text": "हिंडन बर्ग रिसर्च को प्रॉफिट हो जाता है"
    },
    {
      "subtitle_id": 158,
      "start": 335.44,
      "end": 339.6,
      "text": "एक रिपोर्ट जो उन्होंने निकाली थी वो सबसे"
    },
    {
      "subtitle_id": 159,
      "start": 337.12,
      "end": 341.759,
      "text": "अजीबोगरीब फ्रॉड था निकोला मोटर्स करके एक"
