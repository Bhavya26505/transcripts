      "subtitle_id": 150,
      "start": 320.319,
      "end": 324.4,
      "text": "दर्जनों कंपनीज के रिपोर्ट निकाल चुके हैं"
    },
    {
      "subtitle_id": 151,
      "start": 322.24,
      "end": 326.199,
      "text": "जिसमें क्लोज टू 80 पर रिपोर्ट सही साबित"
    },
    {
      "subtitle_id": 152,
      "start": 324.4,
      "end": 327.759,
      "text": "हुई है तो जब भी इनकी रिसर्च रिपोर्ट"
