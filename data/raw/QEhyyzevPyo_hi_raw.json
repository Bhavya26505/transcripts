    {
      "subtitle_id": 129,
      "start": 277.56,
      "end": 281.52,
      "text": "बग शॉर्ट सेलिंग करके प्रॉफिट कमाती है"
    },
    {
      "subtitle_id": 130,
      "start": 279.36,
      "end": 283.44,
      "text": "शॉर्ट सेलिंग में प्रॉफिट तब बनता है जब"
