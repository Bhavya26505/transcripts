    {
      "subtitle_id": 133,
      "start": 285.16,
      "end": 289.28,
      "text": "होती हैं एक पैसिव शॉर्ट सेलिंग कंपनीज"
    },
    {
      "subtitle_id": 134,
      "start": 287.56,
      "end": 290.919,
      "text": "जहां पर कंपनी शॉर्ट सेलिंग की पोजीशन"
    },
    {
      "subtitle_id": 135,
      "start": 289.28,
      "end": 292.639,
      "text": "लेती है और एक्सपेक्ट करती है कि शेयर"
    },
    {
      "subtitle_id": 136,
      "start": 290.919,
      "end": 294.84,
      "text": "प्राइस आने वाले टाइम में नीचे जाएगी और"
    },
    {
      "subtitle_id": 137,
      "start": 292.639,
      "end": 296.68,
      "text": "जब नीचे जाएगी तब वो पैसा बना लेंगे और"
    },
    {
      "subtitle_id": 138,
      "start": 294.84,
      "end": 298.759,
      "text": "दूसरी होती है एक्टिविस्ट शॉर्ट सेलिंग"
    },
    {
      "subtitle_id": 139,
      "start": 296.68,
      "end": 301.08,
      "text": "कंपनीज यह कंपनी शॉर्ट सेलिंग पोजीशन लेती"
    },
    {
      "subtitle_id": 140,
      "start": 298.759,
      "end": 303.24,
      "text": "है फिर दुनिया भर में ढंडोरा करती है कि"
