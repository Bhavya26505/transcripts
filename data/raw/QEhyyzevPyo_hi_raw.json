    {
      "subtitle_id": 167,
      "start": 354.319,
      "end": 360.16,
      "text": "इलेक्ट्रिक व्हीकल्स कार्स बेची होगी"
    },
    {
      "subtitle_id": 168,
      "start": 356.4,
      "end": 362.56,
      "text": "50000 20000 10000 नहीं"
    },
    {
      "subtitle_id": 169,
      "start": 360.16,
      "end": 364.44,
      "text": "जीरो 30 बिलियन डॉलर की कंपनी और एक भी"
