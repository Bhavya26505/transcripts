      "end": 446.039,
      "text": "इंफ्रास्ट्रक्चर यूज कर रहा है मैक्स मा"
    },
    {
      "subtitle_id": 194,
      "start": 443.639,
      "end": 448.639,
      "text": "इंडिया का वो मतलब अभी तो प्लान यही है कि"
    },
    {
      "subtitle_id": 195,
      "start": 446.039,
      "end": 450.319,
      "text": "फुकड में यूज करेगा तो यह तो ऐसा हो गया"
    },
    {
      "subtitle_id": 196,
      "start": 448.639,
      "end": 452.0,
      "text": "कि आप तो फुकड में में सर्विसेस बांट रहे"
    },
    {
      "subtitle_id": 197,
      "start": 450.319,
      "end": 453.8,
      "text": "हो फिर जो बाकी आपके क्लाइंट्स हैं फिर"
    },
    {
      "subtitle_id": 198,
      "start": 452.0,
      "end": 456.56,
      "text": "फोन पे हो बाकी लोग हो वो भी क्यों पे"
    },
    {
      "subtitle_id": 199,
      "start": 453.8,
      "end": 461.199,
      "text": "करें उनको भी सेम चीज होनी चाहिए मतलब इस"
    },
    {
      "subtitle_id": 200,
      "start": 456.56,
      "end": 461.199,
      "text": "तरह का मतलब काफी एक बायस्सीनोसिस"
    },
    {
      "subtitle_id": 201,
      "start": 471.28,
      "end": 474.44,
      "text": "इंजन था"
    },
    {
      "subtitle_id": 202,
      "start": 479.479,
      "end": 482.759,
      "text": "एग्जीक्यूशन में प्रॉब्लम है और कंपनी"
    },
    {
      "subtitle_id": 203,
      "start": 480.879,
      "end": 485.479,
      "text": "डायरेक्शन लेस है तो उन्होंने कंपनी में"
    },
    {
      "subtitle_id": 204,
      "start": 482.759,
      "end": 486.919,
      "text": "5.8 पर स्टेक खरीद लिया और उसके बाद सबसे"
    },
    {
      "subtitle_id": 205,
      "start": 485.479,
      "end": 488.879,
      "text": "पहली चीज उन्होंने एग्जीक्यूटिव्स को"
    },
    {
      "subtitle_id": 206,
      "start": 486.919,
      "end": 491.199,
      "text": "बदलना शुरू कि उन्होंने सबसे पहले एक्सपोज"
    },
    {
      "subtitle_id": 207,
      "start": 488.879,
      "end": 493.4,
      "text": "किया कि कंपनी के जो सीईओ है स्कॉट थॉमसन"
    },
    {
      "subtitle_id": 208,
      "start": 491.199,
      "end": 495.639,
      "text": "उन्होंने अपना रिज्यूमे फैब्रिकेट किया है"
    },
    {
      "subtitle_id": 209,
      "start": 493.4,
      "end": 497.4,
      "text": "गलत चीजें उसमें बताई है ऐसी डिग्री"
    },
    {
      "subtitle_id": 210,
      "start": 495.639,
      "end": 500.159,
      "text": "उन्होंने बताई है जो कभी उनके पास थी ही"
    },
    {
      "subtitle_id": 211,
      "start": 497.4,
      "end": 502.319,
      "text": "नहीं इस रेवलेशन के बाद y को अपने आप में"
    },
    {
      "subtitle_id": 212,
      "start": 500.159,
      "end": 504.319,
      "text": "काफी खराब फील हुआ एंबैरेस्ड फील हुआ और"
    },
    {
      "subtitle_id": 213,
      "start": 502.319,
      "end": 506.479,
      "text": "कंपनी ने उन्हें सीओ पद से हटा दिया जिसके"
    },
    {
      "subtitle_id": 214,
      "start": 504.319,
      "end": 508.56,
      "text": "बाद लोम ने धीरे-धीरे कंपनी के काफी सारे"
    },
    {
      "subtitle_id": 215,
      "start": 506.479,
      "end": 510.56,
      "text": "बोर्ड मेंबर्स को कंपनी से हटा दिया और नए"
    },
    {
      "subtitle_id": 216,
      "start": 508.56,
      "end": 512.36,
      "text": "सीईओ को लाया जिन का नाम था मेरी सा मेयर"
    },
    {
      "subtitle_id": 217,
      "start": 510.56,
      "end": 514.519,
      "text": "अब मेरी सा ने क्या किया कि याहू के पास"
    },
    {
      "subtitle_id": 218,
      "start": 512.36,
      "end": 516.2,
      "text": "अलीबाबा का काफी सारा स्टेक था उसे बेज"
    },
    {
      "subtitle_id": 219,
      "start": 514.519,
      "end": 518.159,
      "text": "दिया जिससे कंपनी को बिलियंस ऑफ डॉलर्स"
    },
    {
      "subtitle_id": 220,
      "start": 516.2,
      "end": 519.68,
      "text": "मिलेन रिटर्न में उसके साथ कंपनी के कोर"
    },
    {
      "subtitle_id": 221,
      "start": 518.159,
      "end": 521.36,
      "text": "प्रोडक्ट्स को उन्होंने चेंज किया कंपनी"
    },
    {
      "subtitle_id": 222,
      "start": 519.68,
      "end": 523.159,
      "text": "में फाइनेंशियल ट्रांसफरेंस लाई और काफी"
    },
    {
      "subtitle_id": 223,
      "start": 521.36,
      "end": 525.08,
      "text": "चीजें लाई बाद में लोब ने अपना जो स्टेक"
    },
    {
      "subtitle_id": 224,
      "start": 523.159,
      "end": 527.36,
      "text": "है वो अच्छे खासे प्रॉफिट पर भेज दिया और"
    },
    {
      "subtitle_id": 225,
      "start": 525.08,
      "end": 529.72,
      "text": "बाद में याहू राइजन के साथ मर्ज हो गई वो"
    },
    {
      "subtitle_id": 226,
      "start": 527.36,
      "end": 531.56,
      "text": "आगे की बात अलग है बट लोइब ने इस केस में"
    },
    {
      "subtitle_id": 227,
      "start": 529.72,
      "end": 533.48,
      "text": "काफी सारा प्रॉफिट कमा लिया अब ये जो डन"
    },
    {
      "subtitle_id": 228,
      "start": 531.56,
      "end": 535.08,
      "text": "लोइब नाम का बंदा है ही इज एन एक्टिविस्ट"
    },
    {
      "subtitle_id": 229,
      "start": 533.48,
      "end": 536.76,
      "text": "इन्वेस्टर मतलब ऐसी भी इन्वेस्टर की"
    },
    {
      "subtitle_id": 230,
      "start": 535.08,
      "end": 538.56,
      "text": "कैटेगरी है जब ये लोग देखते हैं कि शेयर"
    },
    {
      "subtitle_id": 231,
      "start": 536.76,
      "end": 540.72,
      "text": "होल्डर के साथ गलत हो रहा है तो ये लोग"
    },
    {
      "subtitle_id": 232,
      "start": 538.56,
      "end": 542.16,
      "text": "कंपनी में एंटर कर करते हैं गलत मैनेजमेंट"
    },
    {
      "subtitle_id": 233,
      "start": 540.72,
      "end": 543.6,
      "text": "को गायब कर देते हैं और कंपनी को टर्न"
    },
    {
      "subtitle_id": 234,
      "start": 542.16,
      "end": 545.48,
      "text": "अराउंड करके शेरहोल्डर्स को वैल्यू"
    },
    {
      "subtitle_id": 235,
      "start": 543.6,
      "end": 547.279,
      "text": "प्रोवाइड करने की कोशिश करते हैं एट द सेम"
    },
    {
      "subtitle_id": 236,
      "start": 545.48,
      "end": 549.399,
      "text": "टाइम खुद भी काफी सारा पैसा कमा लेते हैं"
    },
    {
      "subtitle_id": 237,
      "start": 547.279,
      "end": 550.959,
      "text": "अब अनफॉर्चूनेटली इंडिया में ऐसे कई सारे"
    },
    {
      "subtitle_id": 238,
      "start": 549.399,
      "end": 552.72,
      "text": "एक्टिविस्ट इन्वेस्टर्स की जरूरत है लेकिन"
    },
    {
      "subtitle_id": 239,
      "start": 550.959,
      "end": 554.959,
      "text": "इंडिया में कोई है नहीं और जो राहुल वर्मा"
    },
    {
      "subtitle_id": 240,
      "start": 552.72,
      "end": 556.48,
      "text": "है ही स्टैनफोर्ड ग्रेजुएट काफी बड़ा मतलब"
    },
    {
      "subtitle_id": 241,
      "start": 554.959,
      "end": 558.519,
      "text": "ये बिजनेस है उनका अपने आप में एंड इट इज"
    },
    {
      "subtitle_id": 242,
      "start": 556.48,
      "end": 560.2,
      "text": "आल्सो ग्रोइंग वेरी वेल जो ये लोग प्रॉफिट"
    },
    {
      "subtitle_id": 243,
      "start": 558.519,
      "end": 561.76,
      "text": "का बहाना दे रहे हैं कि प्रॉफिट बहुत ये"
    },
    {
      "subtitle_id": 244,
      "start": 560.2,
      "end": 563.12,
      "text": "हो रहा है वो हो रहा है तो मैं आपको कंपनी"
    },
    {
      "subtitle_id": 245,
      "start": 561.76,
      "end": 565.16,
      "text": "के कुछ फाइनेंशियल्स भी दिखाता हूं कि"
    },
    {
      "subtitle_id": 246,
      "start": 563.12,
      "end": 566.6,
      "text": "पिछले तीन सालों में अगर पाच सालों का तीन"
    },
    {
      "subtitle_id": 247,
      "start": 565.16,
      "end": 568.64,
      "text": "सालों का डेटा देखें तो इन द लास्ट थ्री"
    },
    {
      "subtitle_id": 248,
      "start": 566.6,
      "end": 571.959,
      "text": "इयर्स कंपनी का कंपाउंडेड सालाना रेवेन्यू"
    },
    {
      "subtitle_id": 249,
      "start": 568.64,
      "end": 573.92,
      "text": "36 से बढ़ रहा है और प्रॉफिट 37 पर से बढ़"
    },
    {
      "subtitle_id": 250,
      "start": 571.959,
      "end": 575.64,
      "text": "रहा है और यहां पर आप कंपनी की ऑपरेटिंग"
    },
    {
      "subtitle_id": 251,
      "start": 573.92,
      "end": 577.959,
      "text": "प्रॉफिट मार्जिन देखें तो वोह भी काफी हद"
    },
    {
      "subtitle_id": 252,
      "start": 575.64,
      "end": 580.12,
      "text": "तक कंपनी ने कंट्रोल की है मतलब अराउंड 40"
    },
    {
      "subtitle_id": 253,
      "start": 577.959,
      "end": 581.92,
      "text": "पर के करीब वो लगातार रही है मैसमा इंडिया"
    },
    {
      "subtitle_id": 254,
      "start": 580.12,
      "end": 583.76,
      "text": "पर वापस आते हैं अब मैसमा इंडिया में ये"
    },
    {
      "subtitle_id": 255,
      "start": 581.92,
      "end": 585.2,
      "text": "सारी चीजें देखने के बाद शेयर होल्डर बकला"
    },
    {
      "subtitle_id": 256,
      "start": 583.76,
      "end": 587.04,
      "text": "गए मतलब उन्होंने अपना एंगर दिखाया"
    },
    {
      "subtitle_id": 257,
      "start": 585.2,
      "end": 589.56,
      "text": "अलग-अलग प्लेटफॉर्म्स के जरिए और जिसके"
    },
    {
      "subtitle_id": 258,
      "start": 587.04,
      "end": 591.519,
      "text": "बाद कंपनी पर प्रेशर आ और कंपनी ने जो 335"
    },
    {
      "subtitle_id": 259,
      "start": 589.56,
      "end": 594.279,
      "text": "करोड़ इन्वेस्टमेंट की जो प्लानिंग की थी"
    },
    {
      "subtitle_id": 260,
      "start": 591.519,
      "end": 596.92,
      "text": "मेपल्स में वो भी हटा दी है मतलब कंपनी ने"
    },
    {
      "subtitle_id": 261,
      "start": 594.279,
      "end": 598.32,
      "text": "अभी बता दिया कि ₹ 35 करोड़ अब हम मेपल्स"
    },
    {
      "subtitle_id": 262,
      "start": 596.92,
      "end": 600.56,
      "text": "में इन्वेस्ट नहीं करने वाले लेकिन जो"
    },
    {
      "subtitle_id": 263,
      "start": 598.32,
      "end": 603.279,
      "text": "स्टेक है वो 10 पर ही मिलेगा उससे ज्यादा"
    },
    {
      "subtitle_id": 264,
      "start": 600.56,
      "end": 605.72,
      "text": "नहीं मिलेगा बाकी रोहन वर्मा ही रहेंगे"
    },
    {
      "subtitle_id": 265,
      "start": 603.279,
      "end": 607.6,
      "text": "वही कंपनी को सीईओ बनके चलाएंगे मेपल्स को"
    },
    {
      "subtitle_id": 266,
      "start": 605.72,
      "end": 609.44,
      "text": "और 90 पर कंपनी का स्टिक उनके साथ ही"
    },
    {
      "subtitle_id": 267,
      "start": 607.6,
      "end": 612.24,
      "text": "रहेगा मतलब इन्वेस्टर्स की तो यही भावना"
    },
    {
      "subtitle_id": 268,
      "start": 609.44,
      "end": 615.92,
      "text": "है कि दिन दहाड़ हमारे घर में डके हुई है"
    },
    {
      "subtitle_id": 269,
      "start": 612.24,
      "end": 617.36,
      "text": "और वही है कि हमारे जो पैसे हैं जो मैप्स"
    },
    {
      "subtitle_id": 270,
      "start": 615.92,
      "end": 619.44,
      "text": "में इंडि की इन्वेस्टमेंट रही है उसका गलत"
    },
    {
      "subtitle_id": 271,
      "start": 617.36,
      "end": 622.12,
      "text": "फायदा हुआ है सो दिस इज नथिंग बट अ वेरी"
    },
    {
      "subtitle_id": 272,
      "start": 619.44,
      "end": 624.56,
      "text": "बिग रिलेटेड पार्टी ट्रांजैक्शन जहां पर"
    },
    {
      "subtitle_id": 273,
      "start": 622.12,
      "end": 626.32,
      "text": "जो मैनेजमेंट है उसने अपने फायदे में"
    },
    {
      "subtitle_id": 274,
      "start": 624.56,
      "end": 628.04,
      "text": "ज्यादा यह डिसीजन लिया है राद दन शेयर"
    },
    {
      "subtitle_id": 275,
      "start": 626.32,
      "end": 630.12,
      "text": "होल्डर्स के फायदे में कंपनी की जैसे ही"
    },
    {
      "subtitle_id": 276,
      "start": 628.04,
      "end": 631.88,
      "text": "ये चीजें बाहर आई कंपनी की शेयर प्राइस"
    },
    {
      "subtitle_id": 277,
      "start": 630.12,
      "end": 633.68,
      "text": "दो-तीन दिनों में ही 12 पर से ज्यादा से"
    },
    {
      "subtitle_id": 278,
      "start": 631.88,
      "end": 635.12,
      "text": "गिर चुकी थी देखिए जब भी आप मार्केट में"
    },
    {
      "subtitle_id": 279,
      "start": 633.68,
      "end": 637.32,
      "text": "इन्वेस्ट करते हो और आपको पता चलता है कि"
    },
    {
      "subtitle_id": 280,
      "start": 635.12,
      "end": 639.12,
      "text": "कंपनी का मैनेजमेंट इस तरह का है तो मेरी"
    },
    {
      "subtitle_id": 281,
      "start": 637.32,
      "end": 641.44,
      "text": "तो आपसे राय होगी गुजारिश होगी कि आप 10"
    },
    {
      "subtitle_id": 282,
      "start": 639.12,
      "end": 643.079,
      "text": "कदम दूरी रहिए कि एक बार आदमी एडल्ट एज"
    },
    {
      "subtitle_id": 283,
      "start": 641.44,
      "end": 645.2,
      "text": "में आ जाए तो उसका बिहेवियर ज्यादा चेंज"
    },
    {
      "subtitle_id": 284,
      "start": 643.079,
      "end": 647.0,
      "text": "नहीं हो पाता तो अगर किसी पर्सन का"
    },
    {
      "subtitle_id": 285,
      "start": 645.2,
      "end": 648.44,
      "text": "बिहेवियर ऐसा है कि लोगों को पागल बनाना"
    },
    {
      "subtitle_id": 286,
      "start": 647.0,
      "end": 650.399,
      "text": "है तो आने वाले टाइम में भी वो लोगों को"
    },
    {
      "subtitle_id": 287,
      "start": 648.44,
      "end": 652.079,
      "text": "पागल ही बनाता रहेगा तो इसीलिए जब जब आपको"
    },
    {
      "subtitle_id": 288,
      "start": 650.399,
      "end": 654.0,
      "text": "ऐसा मैनेजमेंट मिलता है कहीं पर तो उससे"
    },
    {
      "subtitle_id": 289,
      "start": 652.079,
      "end": 655.639,
      "text": "आप दूरी रहिए और ऐसे रिलेटेड पार्टी"
    },
    {
      "subtitle_id": 290,
      "start": 654.0,
      "end": 657.8,
      "text": "ट्रांजैक्शंस होते हैं बड़े-बड़े वो आपके"
    },
    {
      "subtitle_id": 291,
      "start": 655.639,
      "end": 659.8,
      "text": "लिए एक बहुत बड़ी सीख है और यही पॉइंट था"
    },
    {
      "subtitle_id": 292,
      "start": 657.8,
      "end": 661.68,
      "text": "मेरा कि आज का एक वीडियो बनाना और आप सभी"
    },
    {
      "subtitle_id": 293,
      "start": 659.8,
      "end": 663.079,
      "text": "को ये जो रियलिटी है वो आपके सामने शेयर"
    },
    {
      "subtitle_id": 294,
      "start": 661.68,
      "end": 664.72,
      "text": "करना कि ये क्या हो रहा है इंडिया में मैं"
    },
    {
      "subtitle_id": 295,
      "start": 663.079,
      "end": 666.12,
      "text": "आशा करता हूं कि सेबी और बाकी लोग जल्दी"
    },
    {
      "subtitle_id": 296,
      "start": 664.72,
      "end": 667.839,
      "text": "इस पर इंक्वायरी शुरू करेंगे और जो"
    },
    {
      "subtitle_id": 297,
      "start": 666.12,
      "end": 669.92,
      "text": "शेरहोल्डर्स हैं उनको न्याय देंगे जो कि"
    },
    {
      "subtitle_id": 298,
      "start": 667.839,
      "end": 672.72,
      "text": "उनको मिलना चाहिए इस केस में अगर यही चीज"
    },
    {
      "subtitle_id": 299,
      "start": 669.92,
      "end": 674.959,
      "text": "यूएसए जैसे कंट्री में होती तो ऑफकोर्स ये"
    },
    {
      "subtitle_id": 300,
      "start": 672.72,
      "end": 677.16,
      "text": "डील कैंसिल करनी पड़ती कंपनी को उस तरह की"
    },
    {
      "subtitle_id": 301,
      "start": 674.959,
      "end": 679.24,
      "text": "पावर्स यू नो वहां के रेगुलेटर्स के पास"
    },
    {
      "subtitle_id": 302,
      "start": 677.16,
      "end": 681.279,
      "text": "है और बाकी कोर्ट में भी शेयर होल्डर्स जा"
    },
    {
      "subtitle_id": 303,
      "start": 679.24,
      "end": 683.04,
      "text": "सकते हैं और तुरंत उसका रिजल्ट भी आ जाता"
    },
    {
      "subtitle_id": 304,
      "start": 681.279,
      "end": 685.8,
      "text": "है और अगर कुछ शेयर होल्डर अभी इंडिया में"
    },
    {
      "subtitle_id": 305,
      "start": 683.04,
      "end": 687.639,
      "text": "कोर्ट में भी जाते हैं तो यू नो अ मतलब"
    },
    {
      "subtitle_id": 306,
      "start": 685.8,
      "end": 689.68,
      "text": "हिस्टॉरिकली देखा गया है कि काफी ज्यादा"
    },
    {
      "subtitle_id": 307,
      "start": 687.639,
      "end": 691.32,
      "text": "टाइम इंडिया में लगता है कि इसके रिजल्ट्स"
    },
    {
      "subtitle_id": 308,
      "start": 689.68,
      "end": 693.079,
      "text": "आने में तो वरन बफिट जैसा कहते हैं कि"
    },
    {
      "subtitle_id": 309,
      "start": 691.32,
      "end": 695.04,
      "text": "रेपुटेशन बनाने में आपको 20 साल लगते हैं"
    },
    {
      "subtitle_id": 310,
      "start": 693.079,
      "end": 697.44,
      "text": "लेकिन रेपुटेशन अगर गिरानी है तोड़नी है"
    },
    {
      "subtitle_id": 311,
      "start": 695.04,
      "end": 699.24,
      "text": "तो फाइव मिनट्स आर सफिशिएंट तो इस तरह की"
    },
    {
      "subtitle_id": 312,
      "start": 697.44,
      "end": 701.6,
      "text": "चीजें आपको किसी भी व्यक्ति का रेपुटेशन"
    },
    {
      "subtitle_id": 313,
      "start": 699.24,
      "end": 704.8,
      "text": "पता करने में मदद करेगी कि रियल में वो"
    },
    {
      "subtitle_id": 314,
      "start": 701.6,
      "end": 707.959,
      "text": "मैनेजमेंट वो व्यक्ति कैसे हैं तो सावधान"
    },
    {
      "subtitle_id": 315,
      "start": 704.8,
      "end": 711.639,
      "text": "रहे सतर्क रहे मिलते हैं अगली वीडियो में"
    },
    {
      "subtitle_id": 316,
      "start": 707.959,
      "end": 711.639,
      "text": "थैंक यू सो मच"
    }
  ]
}