  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.08,
      "end": 4.44,
      "text": "एक कंपनी जिसका काम ही डायरेक्शन दिखाना"
    },
    {
      "subtitle_id": 2,
      "start": 2.12,
      "end": 5.879,
      "text": "हो उसका मैनेजमेंट कुछ ऐसा काम करता है"
    },
    {
      "subtitle_id": 3,
      "start": 4.44,
      "end": 7.68,
      "text": "जिससे कंपनी के शेयर होल्डर और"
    },
    {
      "subtitle_id": 4,
      "start": 5.879,
      "end": 9.24,
      "text": "इन्वेस्टर्स डायरेक्शन लेस हो जाते हैं"
    },
    {
      "subtitle_id": 5,
      "start": 7.68,
      "end": 11.08,
      "text": "मैं किस कंपनी की बात कर रहा हूं मैं बात"
    },
    {
      "subtitle_id": 6,
      "start": 9.24,
      "end": 12.88,
      "text": "कर रहा हूं मैप्स माय इंडिया की जो कि एक"
    },
    {
      "subtitle_id": 7,
      "start": 11.08,
      "end": 15.44,
      "text": "लिस्टेड कंपनी है अभी कुछ ही दिनों पहले"
    },
    {
      "subtitle_id": 8,
      "start": 12.88,
      "end": 17.359,
      "text": "सडन कंपनी ने बीएससी और एनएससी जो है"
    },
    {
      "subtitle_id": 9,
      "start": 15.44,
      "end": 19.64,
      "text": "स्टॉक एक्सचेंज जस हैं उन्हें यह बताया"
    },
    {
      "subtitle_id": 10,
      "start": 17.359,
      "end": 19.64,
      "text": "इंफॉर्मेशन"
    },
    {
      "subtitle_id": 11,
      "start": 24.56,
      "end": 29.96,
      "text": "भी अपने साथ लेकर जाएंगे जिसमें 90 पर"
    },
    {
      "subtitle_id": 12,
      "start": 27.8,
      "end": 32.2,
      "text": "शेयर होल्डिंग रोहन वर्मा की खुद की होगी"
    },
    {
      "subtitle_id": 13,
      "start": 29.96,
      "end": 34.8,
      "text": "और मात्र 10 पर शेयर होल्डिंग मैप मा"
    },
    {
      "subtitle_id": 14,
      "start": 32.2,
      "end": 37.6,
      "text": "इंडिया की होगी यानी कि ये कुछ ऐसा है कि"
    },
    {
      "subtitle_id": 15,
      "start": 34.8,
      "end": 40.079,
      "text": "एक गाय है जिसे 50 पर मैं ऑन करता हूं और"
    },
    {
      "subtitle_id": 16,
      "start": 37.6,
      "end": 41.76,
      "text": "50 पर आप सब लोग इस गाय को एक बछड़ा होता"
    },
    {
      "subtitle_id": 17,
      "start": 40.079,
      "end": 43.84,
      "text": "है और फिर मैं आपसे कहता हूं कि देखो"
    },
    {
      "subtitle_id": 18,
      "start": 41.76,
      "end": 45.879,
      "text": "बछड़ा है तो उसको खिलाना पिलाना पड़ेगा"
    },
    {
      "subtitle_id": 19,
      "start": 43.84,
      "end": 47.28,
      "text": "फालतू का खर्चा है तो ये जो बछड़ा है इसे"
    },
    {
      "subtitle_id": 20,
      "start": 45.879,
      "end": 49.039,
      "text": "मैं अपने पास ही रख लेता हूं ताकि आप"
    },
    {
      "subtitle_id": 21,
      "start": 47.28,
      "end": 50.84,
      "text": "लोगों के खर्चे कम हो जाए तो चलिए पूरी"
    },
    {
      "subtitle_id": 22,
      "start": 49.039,
      "end": 52.68,
      "text": "तरह से समझते हैं कि मामला क्या है ये एक"
    },
    {
      "subtitle_id": 23,
      "start": 50.84,
      "end": 54.48,
      "text": "ऐसा मामला है जिसमें मैनेजमेंट एनालिसिस"
    },
    {
      "subtitle_id": 24,
      "start": 52.68,
      "end": 56.84,
      "text": "कितना इंपॉर्टेंट है ये पहली चीज आपको पता"
    },
    {
      "subtitle_id": 25,
      "start": 54.48,
      "end": 59.0,
      "text": "चलेगी सेकंड चीज किस तरह से कंपनी के"
    },
    {
      "subtitle_id": 26,
      "start": 56.84,
      "end": 61.28,
      "text": "प्रमोटर्स अपने शेयर होल्डर्स को गुमराह"
    },
    {
      "subtitle_id": 27,
      "start": 59.0,
      "end": 63.519,
      "text": "कर सकते हैं इसका एक प्राइम एग्जांपल आज"
    },
    {
      "subtitle_id": 28,
      "start": 61.28,
      "end": 65.28,
      "text": "आपको पता चलने वाला है यह कहीं और नहीं"
    },
    {
      "subtitle_id": 29,
      "start": 63.519,
      "end": 67.439,
      "text": "अपने इंडिया में हो रहा है शेयर मार्केट"
    },
    {
      "subtitle_id": 30,
      "start": 65.28,
      "end": 69.08,
      "text": "लिस्टेड कंपनी में हो रहा है देखिए m माय"
    },
    {
      "subtitle_id": 31,
      "start": 67.439,
      "end": 70.799,
      "text": "इंडिया मल्टीपल सर्विसेस ऑफर करती है"
    },
    {
      "subtitle_id": 32,
      "start": 69.08,
      "end": 72.52,
      "text": "रिलेटेड टू मैपिंग जिसमें से उनकी एक"
    },
    {
      "subtitle_id": 33,
      "start": 70.799,
      "end": 74.45,
      "text": "सर्विस है क्लाउड मैपिंग सर्विसेस जिसमें"
    },
    {
      "subtitle_id": 34,
      "start": 72.52,
      "end": 77.569,
      "text": "बड़े-बड़े उनके क्लाइंट्स हैं जैसे कि"
    },
    {
      "subtitle_id": 35,
      "start": 74.45,
      "end": 77.569,
      "text": "[संगीत]"
    },
    {
      "subtitle_id": 36,
      "start": 90.159,
      "end": 94.0,
      "text": "करती है व्हीकल मैन्युफैक्चरर को जैसे"
    },
    {
      "subtitle_id": 37,
      "start": 92.0,
      "end": 96.799,
      "text": "जितने भी ऑटोमोबाइल कंपनीज है उनमें से"
    },
    {
      "subtitle_id": 38,
      "start": 94.0,
      "end": 99.0,
      "text": "काफी सारी कंपनीज इनकी सर्विस अवेल करती"
    },
    {
      "subtitle_id": 39,
      "start": 96.799,
      "end": 101.119,
      "text": "है यूज करती है सो जैसे कि आप देख सकते हो"
    },
    {
      "subtitle_id": 40,
      "start": 99.0,
      "end": 103.399,
      "text": "कि कंपनी का जो सबसे बड़ा कस्टमर बेस है"
    },
    {
      "subtitle_id": 41,
      "start": 101.119,
      "end": 105.64,
      "text": "वो ऑटोमोबाइल इंडस्ट्री है इसके अलावा"
    },
    {
      "subtitle_id": 42,
      "start": 103.399,
      "end": 108.24,
      "text": "कंपनी का इंडिया में जीपीएस नेविगेशन में"
    },
    {
      "subtitle_id": 43,
      "start": 105.64,
      "end": 110.28,
      "text": "अराउंड 95 पर का मार्केट शेयर है और कंपनी"
    },
    {
      "subtitle_id": 44,
      "start": 108.24,
      "end": 112.52,
      "text": "का यह दावा है कि कंपनी के 5000 प्लस"
    },
    {
      "subtitle_id": 45,
      "start": 110.28,
      "end": 114.759,
      "text": "एंटरप्राइज कस्टमर्स हैं यानी कि कंपनी का"
    },
    {
      "subtitle_id": 46,
      "start": 112.52,
      "end": 117.079,
      "text": "अगर बिजनेस को आप समझे तो यह बीटू बी"
    },
    {
      "subtitle_id": 47,
      "start": 114.759,
      "end": 119.28,
      "text": "बिजनेस है यानी मैप माय इंडिया अपने आप"
    },
    {
      "subtitle_id": 48,
      "start": 117.079,
      "end": 121.759,
      "text": "में एक बिजनेस है यह सिर्फ दूसरे बिजनेसेस"
    },
    {
      "subtitle_id": 49,
      "start": 119.28,
      "end": 124.039,
      "text": "से जनरली डील करता है जैसे कि ऑटोमोबिल"
    },
    {
      "subtitle_id": 50,
      "start": 121.759,
      "end": 125.96,
      "text": "कंपनीज मतलब ये डायरेक्ट यूजर बिजनेस नहीं"
    },
    {
      "subtitle_id": 51,
      "start": 124.039,
      "end": 129.36,
      "text": "है इनका जो मेन बिज़नेस है ना वो बीटू बी"
    },
    {
      "subtitle_id": 52,
      "start": 125.96,
      "end": 131.0,
      "text": "है वो हम जैसे आम लोगों के लिए नहीं बना"
    },
    {
      "subtitle_id": 53,
      "start": 129.36,
      "end": 132.879,
      "text": "है अब वीडियो में आगे बढ़ने से पहले आपको"
    },
    {
      "subtitle_id": 54,
      "start": 131.0,
      "end": 134.599,
      "text": "बता दूं कि हमारी एफएमवीए यानी फाइनेंशियल"
    },
    {
      "subtitle_id": 55,
      "start": 132.879,
      "end": 136.16,
      "text": "मॉडलिंग एंड वैल्युएशन मेंटरशिप की बैच"
    },
    {
      "subtitle_id": 56,
      "start": 134.599,
      "end": 137.76,
      "text": "दिसंबर से शुरू हो रही है अगर आपको"
    },
    {
      "subtitle_id": 57,
      "start": 136.16,
      "end": 139.599,
      "text": "फाइनेंस में बहुत डिटेल में जाकर ये चेक"
    },
    {
      "subtitle_id": 58,
      "start": 137.76,
      "end": 141.72,
      "text": "करना है कि कंपनी के फाइनेंशियल्स आगे"
    },
    {
      "subtitle_id": 59,
      "start": 139.599,
      "end": 143.44,
      "text": "चलकर कैसे परफॉर्म करेंगे आने वाले टाइम"
    },
    {
      "subtitle_id": 60,
      "start": 141.72,
      "end": 145.519,
      "text": "में कंपनी की ग्रोथ किस तरह से होगी उसकी"
    },
    {
      "subtitle_id": 61,
      "start": 143.44,
      "end": 147.48,
      "text": "फाइनेंशियल मॉडलिंग फिर कैसे करनी है और"
    },
    {
      "subtitle_id": 62,
      "start": 145.519,
      "end": 149.08,
      "text": "उसके बेसिस पर उसका डीसीएफ मेथड से यानी"
    },
    {
      "subtitle_id": 63,
      "start": 147.48,
      "end": 151.08,
      "text": "डिस्काउंटेड कैशफ्लो मेथड से वैल्यूएशन"
    },
    {
      "subtitle_id": 64,
      "start": 149.08,
      "end": 152.68,
      "text": "निकाल के कैसे पता करें कि कंपनी अंडर"
    },
    {
      "subtitle_id": 65,
      "start": 151.08,
      "end": 154.36,
      "text": "वैल्यूड है या फिर ओवर वैल्यूड तो ये सारी"
    },
    {
      "subtitle_id": 66,
      "start": 152.68,
      "end": 156.28,
      "text": "चीजें सीखने की अपॉर्चुनिटी अभी आपके पास"
    },
    {
      "subtitle_id": 67,
      "start": 154.36,
      "end": 158.16,
      "text": "है न महीने के ये वीकेंड बैच चलती है"
    },
    {
      "subtitle_id": 68,
      "start": 156.28,
      "end": 159.599,
      "text": "जिसके बाद आखिरी चंद सीटें बची है तो अभी"
    },
    {
      "subtitle_id": 69,
      "start": 158.16,
      "end": 162.4,
      "text": "नीचे डिस्क्रिप्शन और कमेंट बॉक्स में दीए"
    },
    {
      "subtitle_id": 70,
      "start": 159.599,
      "end": 162.4,
      "text": "गई लिंक पर क्लिक करके"
    },
    {
      "subtitle_id": 71,
      "start": 165.36,
      "end": 169.48,
      "text": "google3 आपके सारे डाउट्स उस काउंसलिंग"
    },
    {
      "subtitle_id": 72,
      "start": 167.64,
      "end": 171.2,
      "text": "सेशन में क्लियर हो जाएंगे फॉर्म की लिंक"
    },
    {
      "subtitle_id": 73,
      "start": 169.48,
      "end": 172.76,
      "text": "नीचे दी गई है अब मैप माय इंडिया को पता"
    },
    {
      "subtitle_id": 74,
      "start": 171.2,
      "end": 174.8,
      "text": "चला कि हम सिर्फ बी टू बी रहेंगे तो काम"
    },
    {
      "subtitle_id": 75,
      "start": 172.76,
      "end": 176.8,
      "text": "नहीं चलेगा एक तो उससे हमें कस्टमर का जो"
    },
    {
      "subtitle_id": 76,
      "start": 174.8,
      "end": 179.84,
      "text": "डाटा है कहां वह जा रहे हैं कैसे कर रहे"
    },
    {
      "subtitle_id": 77,
      "start": 176.8,
      "end": 181.2,
      "text": "हैं वह पता नहीं चलेगा सेकंड चीज हमें"
    },
    {
      "subtitle_id": 78,
      "start": 179.84,
      "end": 183.08,
      "text": "बीटू स में भी काफी सारी रेवेन्यू"
    },
    {
      "subtitle_id": 79,
      "start": 181.2,
      "end": 185.68,
      "text": "अपॉर्चुनिटी हैं व भी हम टैप नहीं कर"
    },
    {
      "subtitle_id": 80,
      "start": 183.08,
      "end": 187.4,
      "text": "पाएंगे तो इसे टैप करने के लिए कंपनी ने"
    },
    {
      "subtitle_id": 81,
      "start": 185.68,
      "end": 189.519,
      "text": "डिसाइड किया कि चलो हम एक बीटू स बिजनेस"
    },
    {
      "subtitle_id": 82,
      "start": 187.4,
      "end": 191.68,
      "text": "स्टार्ट करते हैं इसलिए उन्होंने मल्स नाम"
    },
    {
      "subtitle_id": 83,
      "start": 189.519,
      "end": 194.159,
      "text": "का एक ऐप लाया ये ऐप भी कोई ऐसा वैसा ऐप"
    },
    {
      "subtitle_id": 84,
      "start": 191.68,
      "end": 196.599,
      "text": "नहीं है इसके 25 मिलियन डाउनलोड्स है यानी"
    },
    {
      "subtitle_id": 85,
      "start": 194.159,
      "end": 199.0,
      "text": "कि 2.5 करोड़ डाउनलोड्स है अब मैस मा"
    },
    {
      "subtitle_id": 86,
      "start": 196.599,
      "end": 201.64,
      "text": "इंडिया पिछले कई सालों से m पल्स पर पैसा"
    },
    {
      "subtitle_id": 87,
      "start": 199.0,
      "end": 203.04,
      "text": "खर्चा कर रही है उसमें वो अलग-अलग यूजर"
    },
    {
      "subtitle_id": 88,
      "start": 201.64,
      "end": 204.799,
      "text": "बेस को अट्रैक्ट करने के लिए कई सारी"
    },
    {
      "subtitle_id": 89,
      "start": 203.04,
      "end": 207.4,
      "text": "चीजें कर रही है उस पर पैसा खर्च कर रही"
    },
    {
      "subtitle_id": 90,
      "start": 204.799,
      "end": 209.12,
      "text": "है और ताकि मतलब फ्यूचर में उनका यह गोल"
    },
    {
      "subtitle_id": 91,
      "start": 207.4,
      "end": 211.28,
      "text": "है कि हमें यहां से रेवेन्यू भी आएगा प्लस"
    },
    {
      "subtitle_id": 92,
      "start": 209.12,
      "end": 213.0,
      "text": "कस्टमर का टा भी आएगा जो उनके बीटू बी"
    },
    {
      "subtitle_id": 93,
      "start": 211.28,
      "end": 214.76,
      "text": "बिजनेस के लिए भी और ज्यादा हेल्पफुल होगा"
    },
    {
      "subtitle_id": 94,
      "start": 213.0,
      "end": 216.799,
      "text": "लेकिन फिर अचानक से कंपनी के सीईओ रोहन"
    },
    {
      "subtitle_id": 95,
      "start": 214.76,
      "end": 218.519,
      "text": "वर्मा ने डिसाइड किया कि देखो अब मैं"
