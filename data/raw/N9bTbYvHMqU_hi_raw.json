  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.28,
      "end": 4.16,
      "text": "वीडियो शुरू करने से पहले आपसे कुछ सवाल"
    },
    {
      "subtitle_id": 2,
      "start": 2.159,
      "end": 6.08,
      "text": "पूछता हूं इससे होल लाइफ इंश्योरेंस के"
    },
    {
      "subtitle_id": 3,
      "start": 4.16,
      "end": 9.32,
      "text": "बारे में आप काफी कुछ समझ जाएंगे तो मेरा"
    },
    {
      "subtitle_id": 4,
      "start": 6.08,
      "end": 12.16,
      "text": "पहला सवाल आपसे यह है कि आप आज के ₹ लाख"
    },
    {
      "subtitle_id": 5,
      "start": 9.32,
      "end": 14.4,
      "text": "लेना चाहेंगे या फिर 15 साल बाद के ₹ लाख"
    },
    {
      "subtitle_id": 6,
      "start": 12.16,
      "end": 16.0,
      "text": "अब आप कहेंगे अरे सर हम तो आपको लंबे टाइम"
    },
    {
      "subtitle_id": 7,
      "start": 14.4,
      "end": 17.64,
      "text": "से फॉलो कर रहे हैं और इंफ्लेशन नाम की"
    },
    {
      "subtitle_id": 8,
      "start": 16.0,
      "end": 19.76,
      "text": "कोई चीज होती है तो हमें पता ही है तो"
    },
    {
      "subtitle_id": 9,
      "start": 17.64,
      "end": 22.16,
      "text": "हमें यह पता है कि 15 साल बाद जो ₹ लाख"
    },
    {
      "subtitle_id": 10,
      "start": 19.76,
      "end": 25.199,
      "text": "मिलेंगे उसकी वैल्यू आज के ₹ लाख से कम हो"
    },
    {
      "subtitle_id": 11,
      "start": 22.16,
      "end": 27.56,
      "text": "गई इसलिए हम आज के 55 लाख ही लेंगे चलो यह"
    },
    {
      "subtitle_id": 12,
      "start": 25.199,
      "end": 29.48,
      "text": "तो फिर ठीक है अब मैं अगला सवाल पूछता हूं"
    },
    {
      "subtitle_id": 13,
      "start": 27.56,
      "end": 31.56,
      "text": "और फिर देखता हूं कि क्या आप सही जवाब दे"
    },
    {
      "subtitle_id": 14,
      "start": 29.48,
      "end": 35.52,
      "text": "पाएंगे या फिर नहीं दो ऑप्शन आपके सामने"
    },
    {
      "subtitle_id": 15,
      "start": 31.56,
      "end": 38.32,
      "text": "हैं आज के ₹ लाख या फिर 20 साल बाद हर साल"
    },
    {
      "subtitle_id": 16,
      "start": 35.52,
      "end": 40.719,
      "text": "आपको ₹ लाख मिलेंगे इस तरह से आपको 50 लाख"
    },
    {
      "subtitle_id": 17,
      "start": 38.32,
      "end": 42.76,
      "text": "मिलेंगे 50 सालों तक लेकिन 20 साल के बाद"
    },
    {
      "subtitle_id": 18,
      "start": 40.719,
      "end": 44.76,
      "text": "आपको -1 लाख इस तरह से मिलना शुरू हो"
    },
    {
      "subtitle_id": 19,
      "start": 42.76,
      "end": 46.52,
      "text": "जाएगा अब आप कौन सा ऑप्शन सिलेक्ट करेंगे"
    },
    {
      "subtitle_id": 20,
      "start": 44.76,
      "end": 48.76,
      "text": "अब आप कहेंगे थोड़ा टाइम दीजिए थोड़ा"
    },
    {
      "subtitle_id": 21,
      "start": 46.52,
      "end": 50.719,
      "text": "कैलकुलेट करके पता करते हैं तो बताइए क्या"
    },
    {
      "subtitle_id": 22,
      "start": 48.76,
      "end": 52.68,
      "text": "लेंगे आप में से बहुत सारे लोगों ने 50"
    },
    {
      "subtitle_id": 23,
      "start": 50.719,
      "end": 56.0,
      "text": "लाख को सिलेक्ट किया होगा करें भी क्यों"
    },
    {
      "subtitle_id": 24,
      "start": 52.68,
      "end": 58.079,
      "text": "ना क्योंकि एक तरफ 5 लाख दूसरी तरफ ₹ लाख"
    },
    {
      "subtitle_id": 25,
      "start": 56.0,
      "end": 60.44,
      "text": "तो मैं आपको बता दूं कि इन 50 लाख को अगर"
    },
    {
      "subtitle_id": 26,
      "start": 58.079,
      "end": 62.76,
      "text": "% के इंफ्लेशन रेट से ही मैं एड स् करता"
    },
    {
      "subtitle_id": 27,
      "start": 60.44,
      "end": 64.68,
      "text": "हूं तो 50 लाख की जो वैल्यू है मतलब जो 20"
    },
    {
      "subtitle_id": 28,
      "start": 62.76,
      "end": 67.28,
      "text": "साल से ₹1 लाख इस तरह से आने वाले हैं"
    },
    {
      "subtitle_id": 29,
      "start": 64.68,
      "end": 70.72,
      "text": "उसकी आज की वैल्यू जो है वो ₹ लाख से भी"
    },
    {
      "subtitle_id": 30,
      "start": 67.28,
      "end": 72.759,
      "text": "कम है वो आती है 4.91 लाख थोड़े से"
    },
    {
      "subtitle_id": 31,
      "start": 70.72,
      "end": 75.479,
      "text": "कंफ्यूज हो गए चलिए इसे पूरा करते हैं और"
    },
    {
      "subtitle_id": 32,
      "start": 72.759,
      "end": 77.68,
      "text": "एक और सवाल मैं आपसे पूछता हूं आज 5 लाख"
    },
    {
      "subtitle_id": 33,
      "start": 75.479,
      "end": 80.759,
      "text": "या फिर ₹ लाख का गारंटीड रिटर्न 15 साल"
    },
    {
      "subtitle_id": 34,
      "start": 77.68,
      "end": 83.0,
      "text": "बाद प्लस आपको ₹5000000 हर साल मिलेंगे"
    },
    {
      "subtitle_id": 35,
      "start": 80.759,
      "end": 85.04,
      "text": "लेकिन टर्म यह है कि 25 साल के बाद से तो"
    },
    {
      "subtitle_id": 36,
      "start": 83.0,
      "end": 87.36,
      "text": "हर साल 25 साल के बाद आपको ₹5000000 मिलते"
    },
    {
      "subtitle_id": 37,
      "start": 85.04,
      "end": 89.36,
      "text": "रहेंगे और ऐसा 25 साल के बाद आगे 50 सालों"
    },
    {
      "subtitle_id": 38,
      "start": 87.36,
      "end": 91.36,
      "text": "तक चलता रहेगा और इसके साथ ही आपको ₹10"
    },
    {
      "subtitle_id": 39,
      "start": 89.36,
      "end": 93.2,
      "text": "लाख का इंश्योरेंस मिलेगा 100 सालों तक"
    },
    {
      "subtitle_id": 40,
      "start": 91.36,
      "end": 95.28,
      "text": "हालांकि 100 सालों तक देता कोई नहीं है"
    },
    {
      "subtitle_id": 41,
      "start": 93.2,
      "end": 96.72,
      "text": "फिर भी मैं बता रहा हूं आपको कि ₹ लाख तक"
    },
    {
      "subtitle_id": 42,
      "start": 95.28,
      "end": 98.6,
      "text": "का टर्म इंश्योरेंस के साथ ही आपको मिलेगा"
    },
    {
      "subtitle_id": 43,
      "start": 96.72,
      "end": 100.799,
      "text": "अब आप कौन सा ऑप्शन सिलेक्ट करेंगे पहला"
    },
    {
      "subtitle_id": 44,
      "start": 98.6,
      "end": 102.52,
      "text": "वाला या फिर दूसरा वाला तो आप कहेंगे कि"
    },
    {
      "subtitle_id": 45,
      "start": 100.799,
      "end": 103.84,
      "text": "ये क्या लगा रखा है आपने टॉपिक की बातें"
    },
    {
      "subtitle_id": 46,
      "start": 102.52,
      "end": 105.32,
      "text": "होल लाइफ इंश्योरेंस की तो होल लाइफ"
    },
    {
      "subtitle_id": 47,
      "start": 103.84,
      "end": 106.68,
      "text": "इंश्योरेंस की बात करते हैं तो आपको बता"
    },
    {
      "subtitle_id": 48,
      "start": 105.32,
      "end": 108.2,
      "text": "दूं कि ये जो चीजें हम बातें कर रहे हैं"
    },
    {
      "subtitle_id": 49,
      "start": 106.68,
      "end": 110.24,
      "text": "इससे आपको होल लाइफ इंश्योरेंस बहुत अच्छे"
    },
    {
      "subtitle_id": 50,
      "start": 108.2,
      "end": 113.36,
      "text": "से समझ में आएगा कि किस तरह से कैलकुलेशंस"
    },
    {
      "subtitle_id": 51,
      "start": 110.24,
      "end": 115.52,
      "text": "हो रहे हैं और किस तरह से आप कंफ्यूजन में"
    },
    {
      "subtitle_id": 52,
      "start": 113.36,
      "end": 117.119,
      "text": "जा रहे हैं नमस्कार मैं प्रसाद आपका आज के"
    },
    {
      "subtitle_id": 53,
      "start": 115.52,
      "end": 119.2,
      "text": "इस वीडियो में स्वागत करता हूं सबसे पहले"
    },
    {
      "subtitle_id": 54,
      "start": 117.119,
      "end": 121.36,
      "text": "आप सभी का बहुत-बहुत धन्यवाद जो आप सभी ने"
    },
    {
      "subtitle_id": 55,
      "start": 119.2,
      "end": 123.28,
      "text": "हमारी पनल फाइनेंस की सीरीज को बहुत सारा"
    },
    {
      "subtitle_id": 56,
      "start": 121.36,
      "end": 124.84,
      "text": "प्यार दिया है तो देखिए इस सीरीज में हम"
    },
    {
      "subtitle_id": 57,
      "start": 123.28,
      "end": 126.32,
      "text": "दो पार्ट पहले ही कवर कर चुके हैं हेल्थ"
    },
    {
      "subtitle_id": 58,
      "start": 124.84,
      "end": 128.399,
      "text": "इंश्योरेंस का और टर्म इंश्योरेंस का इन"
    },
    {
      "subtitle_id": 59,
      "start": 126.32,
      "end": 130.399,
      "text": "दोनों चीजों को बहुत अच्छे से समझना है तो"
    },
    {
      "subtitle_id": 60,
      "start": 128.399,
      "end": 132.599,
      "text": "यहां पर आई बटन पर क्लिक कीजिए आपको यह"
    },
    {
      "subtitle_id": 61,
      "start": 130.399,
      "end": 134.319,
      "text": "वीडियो मिल जाएगा और ये पर्सनल फाइनेंस"
    },
    {
      "subtitle_id": 62,
      "start": 132.599,
      "end": 135.879,
      "text": "नाम से हमने प्लेलिस्ट भी बनाई है वो भी"
    },
    {
      "subtitle_id": 63,
      "start": 134.319,
      "end": 138.12,
      "text": "आप प्लेलिस्ट सेक्शन में जाके देख सकते"
    },
    {
      "subtitle_id": 64,
      "start": 135.879,
      "end": 139.8,
      "text": "हैं ये इस एपिसोड का तीसरा पार्ट है जहां"
    },
    {
      "subtitle_id": 65,
      "start": 138.12,
      "end": 141.8,
      "text": "पर हम बात करने वाले हैं होल लाइफ"
    },
    {
      "subtitle_id": 66,
      "start": 139.8,
      "end": 143.68,
      "text": "इंश्योरेंस के बारे में जिससे ज्यादातर"
    },
    {
      "subtitle_id": 67,
      "start": 141.8,
      "end": 146.12,
      "text": "लोगों को आज बेचा जा रहा है और ज्यादातर"
    },
    {
      "subtitle_id": 68,
      "start": 143.68,
      "end": 147.84,
      "text": "लोग खरीद भी रहे हैं सो जो मेरा आखिरी"
    },
    {
      "subtitle_id": 69,
      "start": 146.12,
      "end": 149.599,
      "text": "सवाल था उसका जवाब आप में से ज्यादातर लोग"
    },
    {
      "subtitle_id": 70,
      "start": 147.84,
      "end": 152.0,
      "text": "सेकंड ऑप्शन ही चुनेंगे उसमें क्योंकि"
    },
    {
      "subtitle_id": 71,
      "start": 149.599,
      "end": 153.959,
      "text": "आपको 15 साल बाद ₹ लाख मिल रहे हैं 25 साल"
    },
    {
      "subtitle_id": 72,
      "start": 152.0,
      "end": 156.0,
      "text": "बाद हर साल ₹5000000 मिल रहे हैं प्लस 10"
    },
    {
      "subtitle_id": 73,
      "start": 153.959,
      "end": 158.8,
      "text": "लाख का टर्म इंश्योरेंस भी मिल रहा है और"
    },
    {
      "subtitle_id": 74,
      "start": 156.0,
      "end": 161.68,
      "text": "दूसरी तरफ सिर्फ ₹ लाख लेकिन यहीं पर सब"
    },
    {
      "subtitle_id": 75,
      "start": 158.8,
      "end": 163.519,
      "text": "लोग गलती कर रहे हैं कैसे चलिए इस चीज के"
    },
    {
      "subtitle_id": 76,
      "start": 161.68,
      "end": 165.519,
      "text": "तीन कंपोनेंट्स है पहले उन तीनों"
    },
    {
      "subtitle_id": 77,
      "start": 163.519,
      "end": 167.599,
      "text": "कंपोनेंट्स को सही से समझ लेते हैं फिर"
    },
    {
      "subtitle_id": 78,
      "start": 165.519,
      "end": 169.2,
      "text": "मैं आपको आगे की चीजें बताऊंगा देखिए"
    },
    {
      "subtitle_id": 79,
      "start": 167.599,
      "end": 170.959,
      "text": "इसमें तीन कंपोनेंट्स है एक है गारंटीड"
    },
    {
      "subtitle_id": 80,
      "start": 169.2,
      "end": 173.68,
      "text": "रिटर्न का दूसरा है रेगुलर इनकम का और"
    },
    {
      "subtitle_id": 81,
      "start": 170.959,
      "end": 175.12,
      "text": "तीसरा है टर्म इंश्योरेंस का अब इन्हें"
    },
    {
      "subtitle_id": 82,
      "start": 173.68,
      "end": 177.519,
      "text": "अलग-अलग करके इनकी प्रेजेंट वैल्यू"
    },
    {
      "subtitle_id": 83,
      "start": 175.12,
      "end": 179.08,
      "text": "निकालते हैं ₹ लाख जो आपको 15 साल बाद"
    },
    {
      "subtitle_id": 84,
      "start": 177.519,
      "end": 182.4,
      "text": "मिलेंगे उसकी प्रेजेंट वैल्यू निकल कर आती"
    },
    {
      "subtitle_id": 85,
      "start": 179.08,
      "end": 185.12,
      "text": "है 28 000 ओनली अगर मैं रेगुलर इनकम की"
    },
    {
      "subtitle_id": 86,
      "start": 182.4,
      "end": 187.12,
      "text": "बात करूं तो जो ₹5000000 आपको 25 साल बाद"
    },
    {
      "subtitle_id": 87,
      "start": 185.12,
      "end": 189.12,
      "text": "हर साल मिलने शुरू हो जाएंगे 25 साल के"
    },
    {
      "subtitle_id": 88,
      "start": 187.12,
      "end": 190.799,
      "text": "बाद के 50 सालों तक उसकी प्रेजेंट वैल्यू"
    },
    {
      "subtitle_id": 89,
      "start": 189.12,
      "end": 193.64,
      "text": "टोटल मिला के प्रेजेंट वैल्यू निकल कर आती"
    },
    {
      "subtitle_id": 90,
      "start": 190.799,
      "end": 195.959,
      "text": "है सिर्फ ₹1 83000 और जो टर्म इंश्योरेंस"
    },
    {
      "subtitle_id": 91,
      "start": 193.64,
      "end": 198.2,
      "text": "की मैं बात करूं जो 1 करोड़ का है उसके"
    },
    {
      "subtitle_id": 92,
      "start": 195.959,
      "end": 200.799,
      "text": "लिए आपको पर मंट पे करना पड़ता है 000 टू"
    },
    {
      "subtitle_id": 93,
      "start": 198.2,
      "end": 201.879,
      "text": "₹1 12200 अगर आप अपने 20 में हो तो चलिए"
    },
    {
      "subtitle_id": 94,
      "start": 200.799,
      "end": 204.04,
      "text": "मान लेते हैं कि 10 लाख की टर्म"
    },
    {
      "subtitle_id": 95,
      "start": 201.879,
      "end": 206.64,
      "text": "इंश्योरेंस की वैल्यू 1 लाख भी होती है 1"
    },
    {
      "subtitle_id": 96,
      "start": 204.04,
      "end": 208.959,
      "text": "लाख मतलब हम काफी ऊपर की मान रहे हैं तो"
    },
    {
      "subtitle_id": 97,
      "start": 206.64,
      "end": 211.319,
      "text": "भी इन तीनों के जो कंबाइन टोटल है वो फिर"
    },
    {
      "subtitle_id": 98,
      "start": 208.959,
      "end": 213.04,
      "text": "भी 5 लाख से कम ही निकल कर आती है वो निकल"
    },
    {
      "subtitle_id": 99,
      "start": 211.319,
      "end": 215.4,
      "text": "कर आती है"
    },
    {
      "subtitle_id": 100,
      "start": 213.04,
      "end": 217.159,
      "text": "92000 तो इन सारी चीजों का होल लाइफ"
    },
    {
      "subtitle_id": 101,
      "start": 215.4,
      "end": 219.519,
      "text": "इंश्योरेंस से क्या लेना देना तो आपको बता"
    },
    {
      "subtitle_id": 102,
      "start": 217.159,
      "end": 222.0,
      "text": "दूं कि यही है होल लाइफ इंश्योरेंस क्यों"
    },
    {
      "subtitle_id": 103,
      "start": 219.519,
      "end": 223.92,
      "text": "नहीं समझे चलिए इसे जानते हैं अगर मैं"
    },
    {
      "subtitle_id": 104,
      "start": 222.0,
      "end": 225.879,
      "text": "इंडिया की बात करूं जहां पर 30 पर"
    },
    {
      "subtitle_id": 105,
      "start": 223.92,
      "end": 229.799,
      "text": "पॉपुलेशन इलिटरेट है यानी जो पढ़े लिखे"
    },
    {
      "subtitle_id": 106,
      "start": 225.879,
      "end": 232.799,
      "text": "नहीं है ऊपर से 78 पर पॉपुलेशन ऐसे है जो"
    },
    {
      "subtitle_id": 107,
      "start": 229.799,
      "end": 232.799,
      "text": "फाइनेंशियलीईएक्सप्रेस"
    },
    {
      "subtitle_id": 108,
      "start": 234.64,
      "end": 240.519,
      "text": "से आसान शब्दों में पॉलिसी रखेगी ताकि सभी"
    },
    {
      "subtitle_id": 109,
      "start": 237.56,
      "end": 242.439,
      "text": "को समझ में आए लेकिन होता एगजैक्टली इसके"
    },
    {
      "subtitle_id": 110,
      "start": 240.519,
      "end": 245.159,
      "text": "उल्टा है इंश्योरेंस कंपनीज अपनी जो"
    },
    {
      "subtitle_id": 111,
      "start": 242.439,
      "end": 247.079,
      "text": "पॉलिसीज है उसे इतना कॉम्प्लेक्शन करती है"
    },
    {
      "subtitle_id": 112,
      "start": 245.159,
      "end": 250.0,
      "text": "कि आप कंफ्यूज हो जाओ अगर आप नहीं हो रहे"
    },
    {
      "subtitle_id": 113,
      "start": 247.079,
      "end": 253.0,
      "text": "हो तो वो और ज्यादा उसे"
    },
    {
      "subtitle_id": 114,
      "start": 250.0,
      "end": 255.0,
      "text": "कॉम्प्लेक्शन हैंस की और स्पेशली होल लाइफ"
    },
    {
      "subtitle_id": 115,
      "start": 253.0,
      "end": 256.799,
      "text": "इंश्योरेंस की और इन्हीं पॉलिसीज को समझने"
    },
    {
      "subtitle_id": 116,
      "start": 255.0,
      "end": 258.799,
      "text": "के लिए हमने टर्म इंश्योरेंस को समझा पहले"
    },
    {
      "subtitle_id": 117,
      "start": 256.799,
      "end": 260.72,
      "text": "वीडियो में देन हेल्थ इंश्योरेंस को समझा"
    },
    {
      "subtitle_id": 118,
      "start": 258.799,
      "end": 262.479,
      "text": "अभी हम होल लाइफ इंश्योरेंस को समझने आए"
    },
    {
      "subtitle_id": 119,
      "start": 260.72,
      "end": 264.72,
      "text": "हैं कि इनकी वर्डिक होती है कैसे आपको"
    },
    {
      "subtitle_id": 120,
      "start": 262.479,
      "end": 266.44,
      "text": "इन्हें समझना है अब आपको बताना चाहूंगा कि"
    },
    {
      "subtitle_id": 121,
      "start": 264.72,
      "end": 268.12,
      "text": "कुछ ही दिनों पहले हमारे एक टीम मेंबर को"
    },
    {
      "subtitle_id": 122,
      "start": 266.44,
      "end": 269.8,
      "text": "इंश्योरेंस लेना था वो इंडिया की सबसे"
    },
    {
      "subtitle_id": 123,
      "start": 268.12,
      "end": 271.44,
      "text": "बड़े इंश्योरेंस कंपनी के एजेंट के पास"
    },
    {
      "subtitle_id": 124,
      "start": 269.8,
      "end": 273.28,
      "text": "गया और टर्म इंश्योरेंस खरीदने की उसने"
    },
    {
      "subtitle_id": 125,
      "start": 271.44,
      "end": 275.039,
      "text": "बात की तो एजेंट उसे टर्म इंश्योरेंस की"
    },
    {
      "subtitle_id": 126,
      "start": 273.28,
      "end": 276.88,
      "text": "जगह होल लाइफ इंश्योरेंस लेने के लिए"
    },
    {
      "subtitle_id": 127,
      "start": 275.039,
      "end": 279.32,
      "text": "बोलने लगा जब हमने इस बारे में थोड़ा"
    },
    {
      "subtitle_id": 128,
      "start": 276.88,
      "end": 281.88,
      "text": "रिसर्च किया तो हमें पता चला कि असली बात"
    },
    {
      "subtitle_id": 129,
      "start": 279.32,
      "end": 283.96,
      "text": "कुछ और है आपको भी थोड़ी देर में पता चल"
    },
    {
      "subtitle_id": 130,
      "start": 281.88,
      "end": 285.759,
      "text": "जाएगा चलिए कहानी के माध्यम से इसे समझते"
    },
    {
      "subtitle_id": 131,
      "start": 283.96,
      "end": 288.36,
      "text": "हैं तो दो दोस्त होते हैं एक का नाम है"
    },
    {
      "subtitle_id": 132,
      "start": 285.759,
      "end": 291.28,
      "text": "मंदीप और दूसरे का नाम है"
    },
    {
      "subtitle_id": 133,
      "start": 288.36,
      "end": 293.24,
      "text": "संदीप दोनों एक ही गली में रहते हैं और"
    },
    {
      "subtitle_id": 134,
      "start": 291.28,
      "end": 295.84,
      "text": "उसी सेम गली में दो इंश्योरेंस एजेंट्स"
    },
    {
      "subtitle_id": 135,
      "start": 293.24,
      "end": 298.16,
      "text": "रहते हैं एक का नाम होता है ऋषभ और दूसरे"
    },
    {
      "subtitle_id": 136,
      "start": 295.84,
      "end": 299.88,
      "text": "का नाम होता है विवेक अब दोनों को खरीदना"
    },
    {
      "subtitle_id": 137,
      "start": 298.16,
      "end": 302.16,
      "text": "होता है लाइफ इंश्योरेंस"
    },
    {
      "subtitle_id": 138,
      "start": 299.88,
      "end": 304.16,
      "text": "तो मंदीप चला जाता है ऋषभ के घर पे अब ऋषभ"
    },
    {
      "subtitle_id": 139,
      "start": 302.16,
      "end": 306.199,
      "text": "बहुत ईमानदार आदमी होता है व मंदीप की"
    },
    {
      "subtitle_id": 140,
      "start": 304.16,
      "end": 307.88,
      "text": "रिक्वायरमेंट को समझकर उसे सजेस्ट करता है"
    },
    {
      "subtitle_id": 141,
      "start": 306.199,
      "end": 310.44,
      "text": "कि तू टर्म इंश्योरेंस पॉलिसी के साथ चला"
    },
    {
      "subtitle_id": 142,
      "start": 307.88,
      "end": 312.16,
      "text": "जा अब मंदीप की ऐज होती है 30 साल तो 60"
    },
    {
      "subtitle_id": 143,
      "start": 310.44,
      "end": 314.0,
      "text": "साल तक वो 1 करोड़ का टर्म इंश्योरेंस"
    },
    {
      "subtitle_id": 144,
      "start": 312.16,
      "end": 316.52,
      "text": "खरीद लेता है जिसका मंथली प्रीमियम लगभग"
    },
    {
      "subtitle_id": 145,
      "start": 314.0,
      "end": 318.84,
      "text": "000 निकल कर आता है और वही दूसरी तरफ"
    },
    {
      "subtitle_id": 146,
      "start": 316.52,
      "end": 321.08,
      "text": "संदीप पहुंच जाता है विवेक के घर जैसे ही"
    },
    {
      "subtitle_id": 147,
      "start": 318.84,
      "end": 323.319,
      "text": "वह विवेक के घर पहुंच जाता है देखता है कि"
    },
    {
      "subtitle_id": 148,
      "start": 321.08,
      "end": 325.44,
      "text": "टेबल पर दसों प्रकार के स्नैक्स और"
    },
    {
      "subtitle_id": 149,
      "start": 323.319,
      "end": 328.56,
      "text": "फ्रूट्स पड़े हैं संदीप जैसे ही चेयर पर"
    },
    {
      "subtitle_id": 150,
      "start": 325.44,
      "end": 331.08,
      "text": "बैठता है वैसे ही विवेक कहता है संदीप भाई"
    },
    {
      "subtitle_id": 151,
      "start": 328.56,
      "end": 333.16,
      "text": "आप एकदम राइट टाइम पर आ गए हो कुछ ही दिन"
    },
    {
      "subtitle_id": 152,
      "start": 331.08,
      "end": 336.039,
      "text": "पहले एक पॉलिसी लॉन्च हुई है जिसका नाम है"
    },
    {
      "subtitle_id": 153,
      "start": 333.16,
      "end": 338.72,
      "text": "जीवन जल इस पॉलिसी में आपको सिर्फ भरना"
    },
    {
      "subtitle_id": 154,
      "start": 336.039,
      "end": 340.28,
      "text": "पड़ेगा ₹1000000 हर महीने 10 साल के लिए"
    },
    {
      "subtitle_id": 155,
      "start": 338.72,
      "end": 342.039,
      "text": "और उसके बदले में आपको क्या-क्या मिलेगा"
    },
    {
      "subtitle_id": 156,
      "start": 340.28,
      "end": 344.0,
      "text": "10 लाख का टर्म इंश्योरेंस मिलेगा 100"
    },
    {
      "subtitle_id": 157,
      "start": 342.039,
      "end": 346.44,
      "text": "सालों तक कोई नहीं देता 100 सालों तक हम"
    },
    {
      "subtitle_id": 158,
      "start": 344.0,
      "end": 348.919,
      "text": "दे रहे हैं ₹ लाख तो आपको रिटर्न मिल"
    },
    {
      "subtitle_id": 159,
      "start": 346.44,
      "end": 351.72,
      "text": "जाएंगे 10वें साल में ही और ₹1000000 हर"
    },
    {
      "subtitle_id": 160,
      "start": 348.919,
      "end": 353.919,
      "text": "महीने जब तक आप 100 साल के नहीं हो जाते"
    },
    {
      "subtitle_id": 161,
      "start": 351.72,
      "end": 355.919,
      "text": "अब देखिए इतनी सारी जो बेनिफिट्स ये किसी"
    },
    {
      "subtitle_id": 162,
      "start": 353.919,
      "end": 357.88,
      "text": "भी स्कीम में नहीं होते ऐसा विवेक संदीप"
    },
    {
      "subtitle_id": 163,
      "start": 355.919,
      "end": 359.919,
      "text": "को बताते हैं संदीप तो सुनकर मतलब उनकी"
    },
    {
      "subtitle_id": 164,
      "start": 357.88,
      "end": 361.28,
      "text": "खुशी का ठिकाना नहीं रहता है तो वो सोचते"
    },
    {
      "subtitle_id": 165,
      "start": 359.919,
      "end": 364.24,
      "text": "हैं कि इतना कुछ मिल रहा है वो भी सिर्फ"
    },
    {
      "subtitle_id": 166,
      "start": 361.28,
      "end": 366.16,
      "text": "00 महीने में तो चलिए शुरू कर लेते हैं"
    },
    {
      "subtitle_id": 167,
      "start": 364.24,
      "end": 367.84,
      "text": "फिर संदीप विवेक से कहता है कि वो ऋषभ तो"
    },
    {
      "subtitle_id": 168,
      "start": 366.16,
      "end": 370.28,
      "text": "कह रहा था कि टर्म इंश्योरेंस अच्छा होता"
    },
    {
      "subtitle_id": 169,
      "start": 367.84,
      "end": 371.96,
      "text": "है सस्ता होता है तो विवेक कहता है कि ऋषभ"
    },
    {
      "subtitle_id": 170,
      "start": 370.28,
      "end": 373.639,
      "text": "ऐसी बातें करता है इसलिए उसकी कोई नहीं"
    },
    {
      "subtitle_id": 171,
      "start": 371.96,
      "end": 375.12,
      "text": "मानता टर्म इंश्योरेंस में तुम प्रीमियम"
    },
    {
      "subtitle_id": 172,
      "start": 373.639,
      "end": 377.319,
      "text": "भरोगे अगर तुम्हें कुछ नहीं हुआ तो"
    },
    {
      "subtitle_id": 173,
      "start": 375.12,
      "end": 378.759,
      "text": "प्रीमियम तो बर्बाद हुआ ना तुम बड़ा सोचो"
    },
    {
      "subtitle_id": 174,
      "start": 377.319,
      "end": 380.84,
      "text": "और जीवन जल में इन्वेस्ट करो तुम्हें"
    },
    {
      "subtitle_id": 175,
      "start": 378.759,
      "end": 382.68,
      "text": "कितना कुछ मिल जाएगा तो फाइनली विवेक मान"
    },
    {
      "subtitle_id": 176,
      "start": 380.84,
      "end": 384.919,
      "text": "जाता है और जीवन जल में जो कि एक होल लाइफ"
    },
    {
      "subtitle_id": 177,
      "start": 382.68,
      "end": 386.919,
      "text": "इंश्योरेंस की पॉलिसी उसे खरीद लेता है अब"
    },
    {
      "subtitle_id": 178,
      "start": 384.919,
      "end": 389.0,
      "text": "दोनों ऋषभ और विवेक इंश्योरेंस एजेंट्स"
    },
    {
      "subtitle_id": 179,
      "start": 386.919,
      "end": 391.56,
      "text": "हैं सीधी सी बात है तो दोनों को कमीशन"
    },
    {
      "subtitle_id": 180,
      "start": 389.0,
      "end": 393.319,
      "text": "मिलता है पर कितना जानते हैं तो पहले बात"
    },
    {
      "subtitle_id": 181,
      "start": 391.56,
      "end": 395.8,
      "text": "करते हैं ऋषभ की जो कि इस केस में एक"
    },
    {
      "subtitle_id": 182,
      "start": 393.319,
      "end": 398.199,
      "text": "इंश्योरेंस एजेंट है और उसे कमीशन मिलता"
    },
    {
      "subtitle_id": 183,
      "start": 395.8,
      "end": 400.4,
      "text": "है टर्म इंश्योरेंस बेचने पर 25 पर ऑफ द"
    },
    {
      "subtitle_id": 184,
      "start": 398.199,
      "end": 402.44,
      "text": "प्रीमियम पेड पहले साल में दूसरे और तीसरे"
    },
    {
      "subtitle_id": 185,
      "start": 400.4,
      "end": 405.24,
      "text": "साल में जो भी प्रीमियम पे किया जा रहा है"
    },
    {
      "subtitle_id": 186,
      "start": 402.44,
      "end": 407.68,
      "text": "उसका 7.5 मिलेगा यानी घट जाता है और चौथे"
    },
    {
      "subtitle_id": 187,
      "start": 405.24,
      "end": 409.68,
      "text": "साल से 5 पर ऑफ द टोटल प्रीमियम पेड तो"
    },
    {
      "subtitle_id": 188,
      "start": 407.68,
      "end": 412.96,
      "text": "अगर हम कैलकुलेशन करें तो ऋषभ 30 साल का"
    },
    {
      "subtitle_id": 189,
      "start": 409.68,
      "end": 412.96,
      "text": "टोटल कमीशन बनेगा लगभग"
    },
    {
      "subtitle_id": 190,
      "start": 415.96,
      "end": 421.08,
      "text": "₹2000000"
    },
    {
      "subtitle_id": 191,
      "start": 417.56,
      "end": 422.84,
      "text": "ये कई गुना ज्यादा है ऋषभ से जिसने कि एक"
    },
    {
      "subtitle_id": 192,
      "start": 421.08,
      "end": 424.4,
      "text": "प्लेन टर्म इंश्योरेंस पॉलिसी बेची थी"
    },
    {
      "subtitle_id": 193,
      "start": 422.84,
      "end": 428.36,
      "text": "मतलब कि एक तरफ"
    },
    {
      "subtitle_id": 194,
      "start": 424.4,
      "end": 430.16,
      "text": "₹2000000 एक चीज तो समझ में आ गई कि संदीप"
    },
    {
      "subtitle_id": 195,
      "start": 428.36,
      "end": 432.12,
      "text": "ने विवेक के घर जो स्नैक्स और फ्रूट्स खाए"
    },
    {
      "subtitle_id": 196,
      "start": 430.16,
      "end": 433.599,
      "text": "थे वो फ्री में तो नहीं थे बहुत सारे लोग"
    },
    {
      "subtitle_id": 197,
      "start": 432.12,
      "end": 435.84,
      "text": "ऐसे ही जाने-अनजाने में होल लाइफ"
    },
    {
      "subtitle_id": 198,
      "start": 433.599,
      "end": 437.759,
      "text": "इंश्योरेंस ले लेते हैं फिर हमारा इस तरह"
    },
    {
      "subtitle_id": 199,
      "start": 435.84,
      "end": 439.84,
      "text": "का वीडियो देख लेते हैं और फिर उन्हें जब"
    },
    {
      "subtitle_id": 200,
      "start": 437.759,
      "end": 441.36,
      "text": "पता चलता है कि हमने काफी बड़ी गलती की है"
    },
    {
      "subtitle_id": 201,
      "start": 439.84,
      "end": 443.599,
      "text": "तो फिर जाहिर सी बात है कि वो पॉलिसी"
    },
    {
      "subtitle_id": 202,
      "start": 441.36,
      "end": 446.039,
      "text": "कैंसिल करने चले जाते हैं और उन्हें वहां"
    },
    {
      "subtitle_id": 203,
      "start": 443.599,
      "end": 448.0,
      "text": "जाकर पता चलता है कि उनकी जो पॉलिसी है"
    },
    {
      "subtitle_id": 204,
      "start": 446.039,
      "end": 450.039,
      "text": "उसमें एक लॉकइन पीरियड है यानी व एक"
    },
    {
      "subtitle_id": 205,
      "start": 448.0,
      "end": 452.08,
      "text": "स्पेसिफिक टाइम 2 साल या तीन 3 साल तक"
    },
    {
      "subtitle_id": 206,
      "start": 450.039,
      "end": 454.319,
      "text": "अपना प्रीमियम विड्रॉ नहीं कर सकते और अगर"
    },
    {
      "subtitle_id": 207,
      "start": 452.08,
      "end": 456.599,
      "text": "वह प्रीमियम देना भी बंद कर देंगे तो उनका"
    },
    {
      "subtitle_id": 208,
      "start": 454.319,
      "end": 458.599,
      "text": "पूरा पैसा ही डूब जाएगा अब आपको लगता है"
    },
    {
      "subtitle_id": 209,
      "start": 456.599,
      "end": 461.4,
      "text": "कि इस लॉकइन पीरियड के बाद आपको अपना पैसा"
    },
    {
      "subtitle_id": 210,
      "start": 458.599,
      "end": 463.84,
      "text": "रिटर्न मिल जाएगा तो आप बिल्कुल गलत हैं"
    },
    {
      "subtitle_id": 211,
      "start": 461.4,
      "end": 465.84,
      "text": "क्योंकि आपको 100% पैसा कभी भी वापस नहीं"
    },
    {
      "subtitle_id": 212,
      "start": 463.84,
      "end": 467.919,
      "text": "मिलेगा हर पॉलिसी में अलग-अलग सरेंडर"
    },
    {
      "subtitle_id": 213,
      "start": 465.84,
      "end": 470.0,
      "text": "वैल्यू होती है डिपेंड करता है कि आप कौन"
    },
    {
      "subtitle_id": 214,
      "start": 467.919,
      "end": 472.199,
      "text": "से पॉलिसी ईयर में सरेंडर करने जा रहे हो"
    },
    {
      "subtitle_id": 215,
      "start": 470.0,
      "end": 474.72,
      "text": "जल्दी सरेंडर कर रहे हो तो 50 पर थोड़ा"
    },
    {
      "subtitle_id": 216,
      "start": 472.199,
      "end": 476.639,
      "text": "लेट करेंगे तो 7080 पर हर पॉलिसी का"
    },
    {
      "subtitle_id": 217,
      "start": 474.72,
      "end": 478.56,
      "text": "अलग-अलग सरेंडर वैल्यू का कैलकुलेशन होता"
    },
    {
      "subtitle_id": 218,
      "start": 476.639,
      "end": 481.12,
      "text": "है जो आपको पॉलिसी डॉक्यूमेंट में मिल"
    },
    {
      "subtitle_id": 219,
      "start": 478.56,
      "end": 483.08,
      "text": "जाएगा अब आप सोच रहे होंगे 5 से 6 पर का"
    },
    {
      "subtitle_id": 220,
      "start": 481.12,
      "end": 485.199,
      "text": "रिटर्न आपके इन्वेस्टमेंट का जितना बड़ा"
    },
    {
      "subtitle_id": 221,
      "start": 483.08,
      "end": 487.08,
      "text": "हिस्सा एजेंट के पास जाता है वो साथ ही"
    },
    {
      "subtitle_id": 222,
      "start": 485.199,
      "end": 489.4,
      "text": "सरेंडर वैल्यू का झमेला फिर भी इस"
    },
    {
      "subtitle_id": 223,
      "start": 487.08,
      "end": 491.4,
      "text": "प्रोडक्ट को लोग ले रहे हैं और आज टर्म"
    },
    {
      "subtitle_id": 224,
      "start": 489.4,
      "end": 493.44,
      "text": "इंश्योरेंस से भी ज्यादा की सेल होल लाइफ"
    },
    {
      "subtitle_id": 225,
      "start": 491.4,
      "end": 495.319,
      "text": "इंश्योरेंस की है और इंडिया में ये बहुत"
    },
    {
      "subtitle_id": 226,
      "start": 493.44,
      "end": 497.479,
      "text": "ज्यादा पॉपुलर प्रोडक्ट है और ये चेंज"
    },
    {
      "subtitle_id": 227,
      "start": 495.319,
      "end": 499.28,
      "text": "होने की जरूरत है देखिए कई सारे एजेंट्स"
    },
    {
      "subtitle_id": 228,
      "start": 497.479,
      "end": 501.24,
      "text": "हैं जो अपने बारे में सोचेंगे पर यहां पर"
    },
    {
      "subtitle_id": 229,
      "start": 499.28,
      "end": 503.12,
      "text": "आपको अपने बारे में सोचने की जरूरत है"
    },
    {
      "subtitle_id": 230,
      "start": 501.24,
      "end": 504.84,
      "text": "बहुत से लोग टर्म इंश्योरेंस को ये बोलकर"
    },
    {
      "subtitle_id": 231,
      "start": 503.12,
      "end": 506.759,
      "text": "नहीं लेते हैं कि अगर कुछ नहीं हुआ तो"
    },
    {
      "subtitle_id": 232,
      "start": 504.84,
      "end": 509.0,
      "text": "प्रीमियम वेस्ट हो जाएगा और जो लोग ऐसा"
    },
    {
      "subtitle_id": 233,
      "start": 506.759,
      "end": 511.28,
      "text": "सोचते हैं वही लोग आगे बढ़ के होल लाइफ"
    },
    {
      "subtitle_id": 234,
      "start": 509.0,
      "end": 513.08,
      "text": "इंश्योरेंस स्कीम में फस जाते हैं और कई"
    },
    {
      "subtitle_id": 235,
      "start": 511.28,
      "end": 515.399,
      "text": "बार एजेंट आपको यह बोलेगा कि होल लाइफ"
    },
    {
      "subtitle_id": 236,
      "start": 513.08,
      "end": 518.56,
      "text": "इंश्योरेंस को आप खरीद लीजिए बाद में इसके"
    },
    {
      "subtitle_id": 237,
      "start": 515.399,
      "end": 520.839,
      "text": "अगेंस्ट में आपको लोन भी मिलेगा जो आप कभी"
    },
    {
      "subtitle_id": 238,
      "start": 518.56,
      "end": 522.88,
      "text": "भी इस्तेमाल कर सकते हैं तो आप पॉलिसी के"
    },
    {
      "subtitle_id": 239,
      "start": 520.839,
      "end": 525.24,
      "text": "अगेंस्ट में लोन ले सकते हैं हां ले सकते"
    },
    {
      "subtitle_id": 240,
      "start": 522.88,
      "end": 526.88,
      "text": "हैं पर यहां भी एक कैच है आप पॉलिसी"
    },
    {
      "subtitle_id": 241,
      "start": 525.24,
      "end": 529.12,
      "text": "स्टार्ट होने के एक सर्टेन पीरियड जैसे कि"
    },
    {
      "subtitle_id": 242,
      "start": 526.88,
      "end": 531.68,
      "text": "2 साल 3 साल बाद ही लोन ले सकते हैं और"
    },
    {
      "subtitle_id": 243,
      "start": 529.12,
      "end": 534.519,
      "text": "आपको इंटरेस्ट भी पे करना होगा यस वो"
    },
    {
      "subtitle_id": 244,
      "start": 531.68,
      "end": 537.44,
      "text": "इंटरेस्ट होगा कम से कम 9 से 10 पर का"
    },
    {
      "subtitle_id": 245,
      "start": 534.519,
      "end": 540.519,
      "text": "मतलब आप सोचो आपका पैसा आप विड्रॉ नहीं कर"
    },
    {
      "subtitle_id": 246,
      "start": 537.44,
      "end": 542.88,
      "text": "सकते आप लोन ले सकते हैं पर आपको 2 साल का"
    },
    {
      "subtitle_id": 247,
      "start": 540.519,
      "end": 545.24,
      "text": "वेट करना है और 2 साल के बाद 10 पर के"
    },
    {
      "subtitle_id": 248,
      "start": 542.88,
      "end": 548.32,
      "text": "इंटरेस्ट पर वह इंश्योरेंस कंपनी आपका ही"
    },
    {
      "subtitle_id": 249,
      "start": 545.24,
      "end": 551.6,
      "text": "पैसा आपको लोन देगी वाह भाई वाह इसे कहते"
    },
    {
      "subtitle_id": 250,
      "start": 548.32,
      "end": 553.44,
      "text": "हैं असली बिजनेस पर इंडिया है चलता है अब"
    },
    {
      "subtitle_id": 251,
      "start": 551.6,
      "end": 555.399,
      "text": "मैं और क्या बोलूं गो विद टर्म इंश्योरेंस"
    },
    {
      "subtitle_id": 252,
      "start": 553.44,
      "end": 557.44,
      "text": "एंड डोंट इवन थिंक अबाउट होल लाइफ"
    },
    {
      "subtitle_id": 253,
      "start": 555.399,
      "end": 559.36,
      "text": "इंश्योरेंस तो अगर आपने टर्म इंश्योरेंस"
    },
    {
      "subtitle_id": 254,
      "start": 557.44,
      "end": 561.68,
      "text": "नहीं लिया है तो आप बिल्कुल भी देर मत"
    },
    {
      "subtitle_id": 255,
      "start": 559.36,
      "end": 563.88,
      "text": "कीजिए क्योंकि आप जितना ज्यादा देर करेंगे"
    },
    {
      "subtitle_id": 256,
      "start": 561.68,
      "end": 565.8,
      "text": "उतना ज्यादा प्रीमियम बढ़ता जाएगा बेटर है"
    },
    {
      "subtitle_id": 257,
      "start": 563.88,
      "end": 568.24,
      "text": "जितना जल्दी ले सको उतना जल्दी ले लीजिए"
    },
    {
      "subtitle_id": 258,
      "start": 565.8,
      "end": 570.6,
      "text": "क्योंकि कम एज में प्रीमियम कम होता है और"
    },
    {
      "subtitle_id": 259,
      "start": 568.24,
      "end": 572.68,
      "text": "एक बार प्रीमियम लॉक कर दिया तो वो जिंदगी"
    },
    {
      "subtitle_id": 260,
      "start": 570.6,
      "end": 574.36,
      "text": "भर सेम ही रहता है और अगर आप इसे ऑनलाइन"
    },
    {
      "subtitle_id": 261,
      "start": 572.68,
      "end": 576.16,
      "text": "लेते हैं तो ऑफलाइन के कंपेरटिवली थोड़ा"
    },
    {
      "subtitle_id": 262,
      "start": 574.36,
      "end": 577.88,
      "text": "सस्ता भी आपको ये मिल जाएगा और ऑनलाइन के"
    },
    {
      "subtitle_id": 263,
      "start": 576.16,
      "end": 579.56,
      "text": "लिए मेरी बेस्ट चॉइस रहेगी पॉलिसी बाजार"
    },
    {
      "subtitle_id": 264,
      "start": 577.88,
      "end": 582.56,
      "text": "क्योंकि पॉलिसी बाजार पर 1 करोड़ का टर्म"
    },
    {
      "subtitle_id": 265,
      "start": 579.56,
      "end": 584.72,
      "text": "इंश्योरेंस स्टार्ट होता है सिर्फ ₹ 73 पर"
    },
    {
      "subtitle_id": 266,
      "start": 582.56,
      "end": 587.12,
      "text": "मंथ से यहां ढेरों सारी हेल्थ इंश्योरेंस"
    },
    {
      "subtitle_id": 267,
      "start": 584.72,
      "end": 589.2,
      "text": "कंपनीज के डजन ऑफ प्लांस को कंपेयर कर"
    },
    {
      "subtitle_id": 268,
      "start": 587.12,
      "end": 590.959,
      "text": "सकते हैं जिससे आपको बेस्ट प्लान चुनने"
    },
    {
      "subtitle_id": 269,
      "start": 589.2,
      "end": 592.64,
      "text": "में बड़ी आसानी होती है और जैसे ही आप"
    },
    {
      "subtitle_id": 270,
      "start": 590.959,
      "end": 594.44,
      "text": "डिस्क्रिप्शन या पिन कमेंट में दी गई लिंक"
    },
    {
      "subtitle_id": 271,
      "start": 592.64,
      "end": 596.16,
      "text": "पर क्लिक करके फॉर्म फिल करेंगे वैसे ही"
    },
    {
      "subtitle_id": 272,
      "start": 594.44,
      "end": 597.959,
      "text": "पॉलिसी वजार के इंश्योरेंस एक्सपर्ट आपको"
    },
    {
      "subtitle_id": 273,
      "start": 596.16,
      "end": 599.68,
      "text": "कांटेक्ट करेंगे आपके रिक्वायरमेंट को"
    },
    {
      "subtitle_id": 274,
      "start": 597.959,
      "end": 601.32,
      "text": "समझेंगे और आपके सारे डाउट्स क्लियर"
    },
    {
      "subtitle_id": 275,
      "start": 599.68,
      "end": 603.48,
      "text": "करेंगे तो आपको जो भी डाउट्स हैं उन्हें"
    },
    {
      "subtitle_id": 276,
      "start": 601.32,
      "end": 604.92,
      "text": "आप पूछ लीजिए और हां यह वीडियो स्पों सर्ड"
    },
    {
      "subtitle_id": 277,
      "start": 603.48,
      "end": 606.64,
      "text": "नहीं है किसी से भी पर हां अगर आप"
    },
    {
      "subtitle_id": 278,
      "start": 604.92,
      "end": 608.76,
      "text": "डिस्क्रिप्शन और पिन कमेंट भी दी गई लिंक"
    },
    {
      "subtitle_id": 279,
      "start": 606.64,
      "end": 610.519,
      "text": "पर क्लिक करके तो उससे हमें इनडायरेक्टली"
    },
    {
      "subtitle_id": 280,
      "start": 608.76,
      "end": 612.04,
      "text": "कुछ अमाउंट मिल जाएगी जो हमें और हमारी"
    },
    {
      "subtitle_id": 281,
      "start": 610.519,
      "end": 613.92,
      "text": "टीम को इसी तरह के वीडियोस बनाने में"
    },
    {
      "subtitle_id": 282,
      "start": 612.04,
      "end": 615.36,
      "text": "सपोर्ट करेगी तो अभी डिस्क्रिप्शन और पिन"
    },
    {
      "subtitle_id": 283,
      "start": 613.92,
      "end": 617.48,
      "text": "कमेंट में दी गई लिंक पर क्लिक कीजिए"
    },
    {
      "subtitle_id": 284,
      "start": 615.36,
      "end": 619.72,
      "text": "फॉर्म फिल कीजिए और पॉलिसी कंपेयर करके"
    },
    {
      "subtitle_id": 285,
      "start": 617.48,
      "end": 621.56,
      "text": "बेस्ट इंश्योरेंस बाय कीजिए लेकिन प्लेन"
    },
    {
      "subtitle_id": 286,
      "start": 619.72,
      "end": 623.32,
      "text": "टर्म इंश्योरेंस ही और जाने से पहले एक"
    },
    {
      "subtitle_id": 287,
      "start": 621.56,
      "end": 625.399,
      "text": "रिक्वेस्ट है फिन शंस की जो ज्यादातर"
    },
    {
      "subtitle_id": 288,
      "start": 623.32,
      "end": 627.32,
      "text": "ऑडियंस है वो यंग है और जो कई सारे"
    },
    {
      "subtitle_id": 289,
      "start": 625.399,
      "end": 628.68,
      "text": "एजेंट्स हैं वो एल्डरली लोगों को घर के जो"
    },
    {
      "subtitle_id": 290,
      "start": 627.32,
      "end": 630.519,
      "text": "बुजुर्ग व्यक्ति हैं उन्हें होल लाइफ"
    },
    {
      "subtitle_id": 291,
      "start": 628.68,
      "end": 632.12,
      "text": "इंश्योरेंस बेच ने की कोशिश करते हैं तो"
    },
    {
      "subtitle_id": 292,
      "start": 630.519,
      "end": 634.56,
      "text": "आप सबसे रिक्वेस्ट है कि इस वीडियो को"
    },
    {
      "subtitle_id": 293,
      "start": 632.12,
      "end": 637.04,
      "text": "अपने पेरेंट्स तक अंकल आंटी सबके साथ शेयर"
    },
    {
      "subtitle_id": 294,
      "start": 634.56,
      "end": 639.6,
      "text": "कीजिए ताकि वह सब इस पॉलिसी के चक्कर में"
    },
    {
      "subtitle_id": 295,
      "start": 637.04,
      "end": 641.8,
      "text": "ना पड़े और एक सही इंश्योरेंस खरीद सके और"
    },
    {
      "subtitle_id": 296,
      "start": 639.6,
      "end": 643.44,
      "text": "खुद के फायदे की बात कर सके थैंक यू सो मच"
    },
    {
      "subtitle_id": 297,
      "start": 641.8,
      "end": 646.079,
      "text": "फॉर वाचिंग दिस वीडियो मिलते हैं अगले"
    },
    {
      "subtitle_id": 298,
      "start": 643.44,
      "end": 646.079,
      "text": "वीडियो में"
    }
  ]
}