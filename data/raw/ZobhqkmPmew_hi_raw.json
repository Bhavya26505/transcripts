  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.08,
      "end": 4.12,
      "text": "इमेजिन कीजिए एक ऐसा देश जहां पर कोई"
    },
    {
      "subtitle_id": 2,
      "start": 1.76,
      "end": 6.919,
      "text": "जीएसटी नहीं कोई स्टम ड्यूटी नहीं कोई"
    },
    {
      "subtitle_id": 3,
      "start": 4.12,
      "end": 9.0,
      "text": "एसटीटी नहीं कोई एलटीसीजी या एसटीसीजी भी"
    },
    {
      "subtitle_id": 4,
      "start": 6.919,
      "end": 11.16,
      "text": "नहीं साथ ही एक्सचेंज ट्रांजैक्शन चार्जेस"
    },
    {
      "subtitle_id": 5,
      "start": 9.0,
      "end": 13.28,
      "text": "भी नहीं अब आप पूछेंगे कि यह कौन सा देश"
    },
    {
      "subtitle_id": 6,
      "start": 11.16,
      "end": 19.0,
      "text": "है तो आपको उस देश का नाम बता दूं तो इस"
    },
    {
      "subtitle_id": 7,
      "start": 13.28,
      "end": 21.439,
      "text": "देश का नाम है आई एन डी आई ए इंडिया यानी"
    },
    {
      "subtitle_id": 8,
      "start": 19.0,
      "end": 23.48,
      "text": "भारत अब आप कहेंगे कि सर नशीले पदार्थों"
    },
    {
      "subtitle_id": 9,
      "start": 21.439,
      "end": 25.24,
      "text": "का सेवन कम किया करो क्योंकि हमारे देश"
    },
    {
      "subtitle_id": 10,
      "start": 23.48,
      "end": 28.119,
      "text": "में तो हर बजट में कोई नया टैक्स आ जाता"
    },
    {
      "subtitle_id": 11,
      "start": 25.24,
      "end": 30.679,
      "text": "है पहले स्टम ड्यूटी आया फिर एसटीसीजी आया"
    },
    {
      "subtitle_id": 12,
      "start": 28.119,
      "end": 32.88,
      "text": "फिर एलटीसीजी आया फिर एलटीसीजी हटा के"
    },
    {
      "subtitle_id": 13,
      "start": 30.679,
      "end": 34.84,
      "text": "एसटीटी आया और फिर एसटीटी हटाए बिना ही"
    },
    {
      "subtitle_id": 14,
      "start": 32.88,
      "end": 36.68,
      "text": "एलटीसीजी फिर से वापस आया फिर एक्शन"
    },
    {
      "subtitle_id": 15,
      "start": 34.84,
      "end": 38.64,
      "text": "ट्रांजैक्शन चार्जेस आए और इस तरह से"
    },
    {
      "subtitle_id": 16,
      "start": 36.68,
      "end": 41.0,
      "text": "टैक्सेस की संख्या बढ़ती जा रही है तो ये"
    },
    {
      "subtitle_id": 17,
      "start": 38.64,
      "end": 42.92,
      "text": "कौन सा इंडिया है जहां ये सब टैक्स है ही"
    },
    {
      "subtitle_id": 18,
      "start": 41.0,
      "end": 44.92,
      "text": "नहीं तो जो मेरे स्टेटमेंट पर डाउट कर रहे"
    },
    {
      "subtitle_id": 19,
      "start": 42.92,
      "end": 46.36,
      "text": "हैं उन्हें बता दूं कि ये सारी चीजें जो"
    },
    {
      "subtitle_id": 20,
      "start": 44.92,
      "end": 48.079,
      "text": "स्टेटमेंट्स मैं दे रहा हूं पूरे होशो"
    },
    {
      "subtitle_id": 21,
      "start": 46.36,
      "end": 49.92,
      "text": "आवाज में दे रहा हूं मैंने किसी भी तरह के"
    },
    {
      "subtitle_id": 22,
      "start": 48.079,
      "end": 51.84,
      "text": "नशीले पदार्थों का सेवन नहीं किया है"
    },
    {
      "subtitle_id": 23,
      "start": 49.92,
      "end": 54.28,
      "text": "इंडिया में शेयर बाय सेल हो या फिर फ्यूचर"
    },
    {
      "subtitle_id": 24,
      "start": 51.84,
      "end": 56.16,
      "text": "ऑप्शंस हो या फिर कमोडिटीज हो सब में"
    },
    {
      "subtitle_id": 25,
      "start": 54.28,
      "end": 58.44,
      "text": "ट्रेडिंग कर सकते हो विदाउट पेइंग अ सिंगल"
    },
    {
      "subtitle_id": 26,
      "start": 56.16,
      "end": 62.039,
      "text": "रुपी और यह हमारे देश के कई सारे शहरों"
    },
    {
      "subtitle_id": 27,
      "start": 58.44,
      "end": 64.199,
      "text": "में चल रहा है अहमदाबाद ले लो रांची सूरत"
    },
    {
      "subtitle_id": 28,
      "start": 62.039,
      "end": 65.88,
      "text": "और कई जगह पर यह हो रहा है तो भाइयों और"
    },
    {
      "subtitle_id": 29,
      "start": 64.199,
      "end": 68.6,
      "text": "बहनों मैं बात कर रहा हूं डब्बा ट्रेडिंग"
    },
    {
      "subtitle_id": 30,
      "start": 65.88,
      "end": 71.479,
      "text": "की यस डब्बा ट्रेडिंग नाम पहली बार सुना"
    },
    {
      "subtitle_id": 31,
      "start": 68.6,
      "end": 74.84,
      "text": "है सुना है पर मतलब पता नहीं है और क्या"
    },
    {
      "subtitle_id": 32,
      "start": 71.479,
      "end": 76.96,
      "text": "यह लीगल है या फिर इलीगल इन सारी चीजों के"
    },
    {
      "subtitle_id": 33,
      "start": 74.84,
      "end": 78.88,
      "text": "बारे में आज हम विस्तार में चर्चा करेंगे"
    },
    {
      "subtitle_id": 34,
      "start": 76.96,
      "end": 80.52,
      "text": "नमस्कार मैं प्रसाद आपका आज के इस वीडियो"
    },
    {
      "subtitle_id": 35,
      "start": 78.88,
      "end": 82.28,
      "text": "में स्वागत करता हूं तो सबसे पहले बात"
    },
    {
      "subtitle_id": 36,
      "start": 80.52,
      "end": 85.439,
      "text": "करेंगे कि डब्बा ट्रेनिंग आखिर होती क्या"
    },
    {
      "subtitle_id": 37,
      "start": 82.28,
      "end": 87.24,
      "text": "है यह कहां से आई है और कैसे काम करती हैं"
    },
    {
      "subtitle_id": 38,
      "start": 85.439,
      "end": 89.04,
      "text": "अगर आप गुजराती या मारवाड़ी हो तो शायद"
    },
    {
      "subtitle_id": 39,
      "start": 87.24,
      "end": 91.159,
      "text": "आपको डब्बा इस टर्म का मतलब अच्छे से पता"
    },
    {
      "subtitle_id": 40,
      "start": 89.04,
      "end": 93.2,
      "text": "होगा गुजराती या मारवाड़ी में अगर कोई"
    },
    {
      "subtitle_id": 41,
      "start": 91.159,
      "end": 94.92,
      "text": "कहता है कि किसी इंसान का दिमाग डब्बा है"
    },
    {
      "subtitle_id": 42,
      "start": 93.2,
      "end": 98.119,
      "text": "तो उसका मतलब है कि उसके दिमाग में कुछ"
    },
    {
      "subtitle_id": 43,
      "start": 94.92,
      "end": 99.64,
      "text": "नहीं है इंग्लिश में कहे तो नथिंग तो अगर"
    },
    {
      "subtitle_id": 44,
      "start": 98.119,
      "end": 102.04,
      "text": "हम डब्बा ट्रेडिंग का लिटरल इंग्लिश"
    },
    {
      "subtitle_id": 45,
      "start": 99.64,
      "end": 104.759,
      "text": "मीनिंग निकाले तो वो निकल कर आएगा नथिंग"
    },
    {
      "subtitle_id": 46,
      "start": 102.04,
      "end": 106.92,
      "text": "ट्रेडिंग पर ऐसा क्यों तो आपको थोड़ी देर"
    },
    {
      "subtitle_id": 47,
      "start": 104.759,
      "end": 108.92,
      "text": "में पता चल जाएगा लेकिन डब्बा ट्रेडिंग को"
    },
    {
      "subtitle_id": 48,
      "start": 106.92,
      "end": 110.56,
      "text": "समझने के लिए पहले यह समझना पड़ेगा हमें"
    },
    {
      "subtitle_id": 49,
      "start": 108.92,
      "end": 112.2,
      "text": "कि एक्चुअल में जो ट्रेडिंग होती है वो"
    },
    {
      "subtitle_id": 50,
      "start": 110.56,
      "end": 114.32,
      "text": "किस तरह से किस स्टेप्स में एग्जीक्यूट"
    },
    {
      "subtitle_id": 51,
      "start": 112.2,
      "end": 116.36,
      "text": "होती है जिसे समझने के बाद आप बड़े आसानी"
    },
    {
      "subtitle_id": 52,
      "start": 114.32,
      "end": 118.32,
      "text": "से डब्बा ट्रेडिंग समझ जाएंगे देखिए एक"
    },
    {
      "subtitle_id": 53,
      "start": 116.36,
      "end": 120.24,
      "text": "नॉर्मल ट्रेडिंग की पूरी प्रोसेस में पांच"
    },
    {
      "subtitle_id": 54,
      "start": 118.32,
      "end": 122.759,
      "text": "स्टेप्स होती है मान लीजिए कि एक व्यक्ति"
    },
    {
      "subtitle_id": 55,
      "start": 120.24,
      "end": 125.32,
      "text": "है जिनका नाम है अजय मान लीजिए कि अजय को"
    },
    {
      "subtitle_id": 56,
      "start": 122.759,
      "end": 128.44,
      "text": "एबीसी कंपनी के 1000 शेयर्स खरीदने हैं और"
    },
    {
      "subtitle_id": 57,
      "start": 125.32,
      "end": 130.8,
      "text": "एक शेयर की कीमत फिलहाल है ₹1 1000 शेयर्स"
    },
    {
      "subtitle_id": 58,
      "start": 128.44,
      "end": 132.36,
      "text": "खरीदने हैं ₹1 का एक शेयर है मतलब ₹1 लाख"
    },
    {
      "subtitle_id": 59,
      "start": 130.8,
      "end": 133.959,
      "text": "के शेयर्स उन्हें खरीदने हैं जिसके लिए"
    },
    {
      "subtitle_id": 60,
      "start": 132.36,
      "end": 135.879,
      "text": "उन्हें ब्रोकर के पास जाना पड़ता है आज की"
    },
    {
      "subtitle_id": 61,
      "start": 133.959,
      "end": 137.68,
      "text": "डेट में सारे ऐप्स से तो ऐप में से ही वो"
    },
    {
      "subtitle_id": 62,
      "start": 135.879,
      "end": 141.0,
      "text": "ऑर्डर प्लेस कर देते हैं जिसके बाद जो"
    },
    {
      "subtitle_id": 63,
      "start": 137.68,
      "end": 143.16,
      "text": "ब्रोकिंग ऐप है व अजय से ₹1 लाख और उसके"
    },
    {
      "subtitle_id": 64,
      "start": 141.0,
      "end": 145.04,
      "text": "साथ अपना ब्रोकरेज और टैक्सेस कलेक्ट करते"
    },
    {
      "subtitle_id": 65,
      "start": 143.16,
      "end": 147.04,
      "text": "हैं उसके बाद ब्रोकर य ऑर्डर स्टॉक"
    },
    {
      "subtitle_id": 66,
      "start": 145.04,
      "end": 148.84,
      "text": "एक्सचेंज के पास भेज देते हैं अब उसके बाद"
    },
    {
      "subtitle_id": 67,
      "start": 147.04,
      "end": 150.84,
      "text": "रोल आता है स्टॉक एक्सचेंज का स्टॉक"
    },
    {
      "subtitle_id": 68,
      "start": 148.84,
      "end": 152.76,
      "text": "एक्सचेंज के पास अज कि ये बाय ऑर्डर आने"
    },
    {
      "subtitle_id": 69,
      "start": 150.84,
      "end": 154.8,
      "text": "के बाद स्टॉक एक्सचेंज ऐसे इन्वेस्टर्स"
    },
    {
      "subtitle_id": 70,
      "start": 152.76,
      "end": 156.64,
      "text": "ढूंढते हैं जो एबीसी कंपनी के शेयर सेल"
    },
    {
      "subtitle_id": 71,
      "start": 154.8,
      "end": 158.28,
      "text": "करने के लिए तैयार हैं अब स्टॉक एक्सचेंज"
    },
    {
      "subtitle_id": 72,
      "start": 156.64,
      "end": 160.64,
      "text": "के पास मैकेनिज्म है कि वो बायर सेलर का"
    },
    {
      "subtitle_id": 73,
      "start": 158.28,
      "end": 162.44,
      "text": "ऑर्डर ऑटोमेटिक मैच कर देते हैं यानी अजय"
    },
    {
      "subtitle_id": 74,
      "start": 160.64,
      "end": 164.44,
      "text": "की जो बाय ऑर्डर है वो किसी सेलर के साथ"
    },
    {
      "subtitle_id": 75,
      "start": 162.44,
      "end": 166.48,
      "text": "मैच हो जाएगी जिसके बाद ऑर्डर कंप्लीट हो"
    },
    {
      "subtitle_id": 76,
      "start": 164.44,
      "end": 168.48,
      "text": "जाएगी ऑर्डर कंप्लीट होने के बाद ऑर्डर के"
    },
    {
      "subtitle_id": 77,
      "start": 166.48,
      "end": 170.36,
      "text": "जो डिटेल्स है वो एक्सचेंज क्लीयरिंग हाउस"
    },
    {
      "subtitle_id": 78,
      "start": 168.48,
      "end": 172.72,
      "text": "को भेज देंगे फिर क्लीयरिंग हाउस मेक"
    },
    {
      "subtitle_id": 79,
      "start": 170.36,
      "end": 174.56,
      "text": "श्योर करता है कि ऑर्डर के शेयर्स और पैसे"
    },
    {
      "subtitle_id": 80,
      "start": 172.72,
      "end": 176.72,
      "text": "रिस्पेक्टिव पर्सन को ट्रांसफर हो गए कि"
    },
    {
      "subtitle_id": 81,
      "start": 174.56,
      "end": 178.12,
      "text": "नहीं और फिर ये जो पूरा सिस्टम है यह सही"
    },
    {
      "subtitle_id": 82,
      "start": 176.72,
      "end": 180.36,
      "text": "से चल रहा है कि नहीं चल रहा है इस पर"
    },
    {
      "subtitle_id": 83,
      "start": 178.12,
      "end": 182.599,
      "text": "सुपरविजन रखने के लिए होता है सेबी यानी"
    },
    {
      "subtitle_id": 84,
      "start": 180.36,
      "end": 184.04,
      "text": "इंडिया का सिक्योरिटी मार्केट रेगुलेटर अब"
    },
    {
      "subtitle_id": 85,
      "start": 182.599,
      "end": 185.76,
      "text": "देखिए क्योंकि यहां पर ब्रोकर है तो"
    },
    {
      "subtitle_id": 86,
      "start": 184.04,
      "end": 187.799,
      "text": "ब्रोकर का एक ब्रोकरेज चार्ज यहां पर लगता"
    },
    {
      "subtitle_id": 87,
      "start": 185.76,
      "end": 189.4,
      "text": "है उसके बाद ऑर्डर जाती है एक्सचेंज पर तो"
    },
    {
      "subtitle_id": 88,
      "start": 187.799,
      "end": 191.36,
      "text": "एक्सचेंज ट्रांजैक्शन चार्ज आपको पे करना"
    },
    {
      "subtitle_id": 89,
      "start": 189.4,
      "end": 193.0,
      "text": "पड़ता है उसके बाद आपके जो खरीदे हुए"
    },
    {
      "subtitle_id": 90,
      "start": 191.36,
      "end": 194.799,
      "text": "शेयर्स है वो इलेक्ट्रॉनिक फॉर्मेट में"
    },
    {
      "subtitle_id": 91,
      "start": 193.0,
      "end": 196.879,
      "text": "डिपॉजिटरीज में स्टोर होते हैं जिसके लिए"
    },
    {
      "subtitle_id": 92,
      "start": 194.799,
      "end": 198.72,
      "text": "डीपी चार्ज डिपॉजिटरीज चार्ज कर दी है"
    },
    {
      "subtitle_id": 93,
      "start": 196.879,
      "end": 200.56,
      "text": "उसके बाद सेबी जो कि रेगुलेटर है वो भी"
    },
    {
      "subtitle_id": 94,
      "start": 198.72,
      "end": 202.76,
      "text": "सेबी ट्रांजैक्शन चार्जेस लेते हैं और"
    },
    {
      "subtitle_id": 95,
      "start": 200.56,
      "end": 204.92,
      "text": "सबसे ऊपर बैठी है सरकार स्टेट गवर्नमेंट"
    },
    {
      "subtitle_id": 96,
      "start": 202.76,
      "end": 207.159,
      "text": "लेगी आपके हिसाब से स्टम ड्यूटी और जो ऊपर"
    },
    {
      "subtitle_id": 97,
      "start": 204.92,
      "end": 209.28,
      "text": "वाली सरकारी सेंट्रल वो आपसे एसटीटी और जो"
    },
    {
      "subtitle_id": 98,
      "start": 207.159,
      "end": 211.599,
      "text": "भी चार्जेस हैं उन पर जीएसटी अलग से तो इस"
    },
    {
      "subtitle_id": 99,
      "start": 209.28,
      "end": 213.76,
      "text": "तरह के सारे चार्जेस आपके डिडक्ट हो जाते"
    },
    {
      "subtitle_id": 100,
      "start": 211.599,
      "end": 215.879,
      "text": "हैं जो आपको ज्यादातर टाइम पता भी नहीं"
    },
    {
      "subtitle_id": 101,
      "start": 213.76,
      "end": 218.239,
      "text": "चलते वही अगर हम डब्बा ट्रेडिंग की बात"
    },
    {
      "subtitle_id": 102,
      "start": 215.879,
      "end": 220.599,
      "text": "करें तो यहां पर मामला पूरा अलग है मान"
    },
    {
      "subtitle_id": 103,
      "start": 218.239,
      "end": 222.64,
      "text": "लीजिए कि अजय को सेम एबीसी कंपनी के 1000"
    },
    {
      "subtitle_id": 104,
      "start": 220.599,
      "end": 224.319,
      "text": "शेयर्स खरीदने हैं तो डब्बा ट्रेडिंग में"
    },
    {
      "subtitle_id": 105,
      "start": 222.64,
      "end": 226.36,
      "text": "वो सेबी रजिस्टर्ड ब्रोकर के पास नहीं"
    },
    {
      "subtitle_id": 106,
      "start": 224.319,
      "end": 228.56,
      "text": "जाएगा वो जाएगा एक डब्बा ब्रोकर के पास"
    },
    {
      "subtitle_id": 107,
      "start": 226.36,
      "end": 230.2,
      "text": "जिसे डब्बा ऑपरेटर भी कहते हैं मान लीजिए"
    },
    {
      "subtitle_id": 108,
      "start": 228.56,
      "end": 232.36,
      "text": "कि इस डब्बा ऑपरेटर का नाम है मिस्टर"
    },
    {
      "subtitle_id": 109,
      "start": 230.2,
      "end": 234.4,
      "text": "डब्बा स्वामी अब अजय एक डब्बा ऑपरेटर के"
    },
    {
      "subtitle_id": 110,
      "start": 232.36,
      "end": 236.4,
      "text": "पास आता है अपने ऑर्डर प्लेस करने तो जैसे"
    },
    {
      "subtitle_id": 111,
      "start": 234.4,
      "end": 238.439,
      "text": "ही अजय मिस्टर डब्बा स्वामी के पास एबीसी"
    },
    {
      "subtitle_id": 112,
      "start": 236.4,
      "end": 240.079,
      "text": "कंपनी के शेयर्स का सौदा करने आता है तो"
    },
    {
      "subtitle_id": 113,
      "start": 238.439,
      "end": 242.319,
      "text": "फिर मिस्टर डब्बा स्वामी क्या करता है"
    },
    {
      "subtitle_id": 114,
      "start": 240.079,
      "end": 244.56,
      "text": "एक्सचेंज के पास जाता है नहीं वो अपने"
    },
    {
      "subtitle_id": 115,
      "start": 242.319,
      "end": 246.68,
      "text": "अकाउंट की बुक खोलता है और सौदे की पूरी"
    },
    {
      "subtitle_id": 116,
      "start": 244.56,
      "end": 248.2,
      "text": "डिटेल्स उसमें नोट कर लेता है तो एक्सचेंज"
    },
    {
      "subtitle_id": 117,
      "start": 246.68,
      "end": 250.4,
      "text": "की तरह क्या यहां पर किसी भी तरह के"
    },
    {
      "subtitle_id": 118,
      "start": 248.2,
      "end": 253.799,
      "text": "शेयर्स एक्सचेंज हुए नहीं क्या अजय को"
    },
    {
      "subtitle_id": 119,
      "start": 250.4,
      "end": 255.56,
      "text": "शेयर्स मिले नहीं इसीलिए इसे कहते हैं"
    },
    {
      "subtitle_id": 120,
      "start": 253.799,
      "end": 257.479,
      "text": "नथिंग ट्रेडिंग यानी कि डब्बा ट्रेडिंग"
    },
    {
      "subtitle_id": 121,
      "start": 255.56,
      "end": 259.519,
      "text": "यहां पर कुछ नहीं होता है एक्चुअल में अब"
    },
    {
      "subtitle_id": 122,
      "start": 257.479,
      "end": 261.519,
      "text": "देखिए डब्बा ट्रेडिंग पूरी तरह से लीगल है"
    },
    {
      "subtitle_id": 123,
      "start": 259.519,
      "end": 263.759,
      "text": "फिर भी कुछ लोग इसे करते हैं और लॉन्ग"
    },
    {
      "subtitle_id": 124,
      "start": 261.519,
      "end": 265.16,
      "text": "टर्म में यह आपको कभी फायदा नहीं देगी"
    },
    {
      "subtitle_id": 125,
      "start": 263.759,
      "end": 267.16,
      "text": "लेकिन यदि मैं आपसे कहू कि कई सारे"
    },
    {
      "subtitle_id": 126,
      "start": 265.16,
      "end": 269.68,
      "text": "इल्लीगल एक्टिविटीज और स्कैम्स शेयर"
    },
    {
      "subtitle_id": 127,
      "start": 267.16,
      "end": 271.28,
      "text": "मार्केट में भी होते हैं और ज्यादातर स्मल"
    },
    {
      "subtitle_id": 128,
      "start": 269.68,
      "end": 273.0,
      "text": "स्ल कैप और मिड कैप सेगमेंट में होते हैं"
    },
    {
      "subtitle_id": 129,
      "start": 271.28,
      "end": 274.68,
      "text": "लेकिन फिर दुविधा यह भी है कि सबसे ज्यादा"
    },
    {
      "subtitle_id": 130,
      "start": 273.0,
      "end": 276.6,
      "text": "मल्टीबैगर्स हमें स्मॉल कैप और मिडकैप"
    },
    {
      "subtitle_id": 131,
      "start": 274.68,
      "end": 278.28,
      "text": "सेगमेंट में ही मिलते हैं तो फिर स्कैम"
    },
    {
      "subtitle_id": 132,
      "start": 276.6,
      "end": 280.36,
      "text": "फ्री मिडकैप और स्मॉल कैप स्टॉक्स कैसे"
    },
    {
      "subtitle_id": 133,
      "start": 278.28,
      "end": 282.199,
      "text": "ढूंढे क्योंकि मिस्टर राकेश झुंझुनवाला की"
    },
    {
      "subtitle_id": 134,
      "start": 280.36,
      "end": 284.0,
      "text": "तरह हर किसी को अपना एक टाइटन चाहिए जो"
    },
    {
      "subtitle_id": 135,
      "start": 282.199,
      "end": 286.16,
      "text": "कभी ना कभी एक स्मॉल कैप और मिड कैप स्टॉक"
    },
    {
      "subtitle_id": 136,
      "start": 284.0,
      "end": 287.88,
      "text": "था इसके लिए एमबीएस फ्रेमवर्क यूज की जाती"
    },
    {
      "subtitle_id": 137,
      "start": 286.16,
      "end": 289.88,
      "text": "है जिसे कई सारे सक्सेसफुल इन्वेस्टर्स भी"
    },
    {
      "subtitle_id": 138,
      "start": 287.88,
      "end": 292.479,
      "text": "फॉलो करते हैं और इसी फ्रेमवर्क की मदद से"
    },
    {
      "subtitle_id": 139,
      "start": 289.88,
      "end": 294.44,
      "text": "हमने आईआरएफसी रेडी को खैतान और सीडीएसएल"
    },
    {
      "subtitle_id": 140,
      "start": 292.479,
      "end": 295.96,
      "text": "जैसे स्टॉक्स ढूंढे हैं और यही एमबीएस"
    },
    {
      "subtitle_id": 141,
      "start": 294.44,
      "end": 298.759,
      "text": "फ्रेमवर्क और स्टॉक सिलेक्शन की पूरी"
    },
    {
      "subtitle_id": 142,
      "start": 295.96,
      "end": 300.68,
      "text": "प्रोसेस हम लेकर आए हैं फंडामेंटल 2.0 में"
    },
    {
      "subtitle_id": 143,
      "start": 298.759,
      "end": 302.96,
      "text": "जहां पर आप बड़े आसानी से स्टॉक सिलेक्शन"
    },
    {
      "subtitle_id": 144,
      "start": 300.68,
      "end": 304.6,
      "text": "की पूरी प्रोसेस समझ लेंगे जिसके बाद आपको"
    },
    {
      "subtitle_id": 145,
      "start": 302.96,
      "end": 306.639,
      "text": "किसी पर भी डिपेंड रहने की जरूरत नहीं"
    },
    {
      "subtitle_id": 146,
      "start": 304.6,
      "end": 308.56,
      "text": "पड़ेगी और इस कोर्स के लिए बिगनर भी एनरोल"
    },
    {
      "subtitle_id": 147,
      "start": 306.639,
      "end": 310.88,
      "text": "कर सकते हैं इस कोर्स के फिलहाल प्रीलॉन्च"
    },
    {
      "subtitle_id": 148,
      "start": 308.56,
      "end": 313.56,
      "text": "ऑफर शुरू हैं जहां पर 15th अगस्ट तक आपको"
    },
    {
      "subtitle_id": 149,
      "start": 310.88,
      "end": 315.44,
      "text": "यह कोर्स मिलेगा सिर्फ ₹1 में जिसमें आपको"
    },
    {
      "subtitle_id": 150,
      "start": 313.56,
      "end": 317.72,
      "text": "यह कोर्स मिलता है लाइफ टाइम वैलिडिटी के"
    },
    {
      "subtitle_id": 151,
      "start": 315.44,
      "end": 320.12,
      "text": "साथ विथ फाइव डेज नो क्वेश्चन आस रिफंड"
    },
    {
      "subtitle_id": 152,
      "start": 317.72,
      "end": 321.96,
      "text": "पॉलिसी बिल्कुल ही नो ब्रेनर डील है तो"
    },
    {
      "subtitle_id": 153,
      "start": 320.12,
      "end": 324.24,
      "text": "जरूर इस कोर्स में एनरोल करें क्योंकि"
    },
    {
      "subtitle_id": 154,
      "start": 321.96,
      "end": 325.919,
      "text": "इसके बाद इस प्राइस में आपको यह कोर्स कभी"
    },
    {
      "subtitle_id": 155,
      "start": 324.24,
      "end": 327.24,
      "text": "नहीं मिलेगा इसकी लिंक आपको नीचे"
    },
    {
      "subtitle_id": 156,
      "start": 325.919,
      "end": 329.919,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में मिल"
    },
    {
      "subtitle_id": 157,
      "start": 327.24,
      "end": 331.759,
      "text": "जाएगी अब ये ऑपरेट कैसे होता है और लोग"
    },
    {
      "subtitle_id": 158,
      "start": 329.919,
      "end": 333.479,
      "text": "इसे क्यों करते हैं उसे समझ लेते हैं अब"
    },
    {
      "subtitle_id": 159,
      "start": 331.759,
      "end": 335.6,
      "text": "मिस्टर डब्बा स्वामी कई बार ना कोई"
    },
    {
      "subtitle_id": 160,
      "start": 333.479,
      "end": 337.84,
      "text": "ब्रोकरेज लेता है ना कोई टैक्स ना स्टैंप"
    },
    {
      "subtitle_id": 161,
      "start": 335.6,
      "end": 339.72,
      "text": "ड्यूटी है ना एसटीटी है ना एसटीसीजी ना"
    },
    {
      "subtitle_id": 162,
      "start": 337.84,
      "end": 341.6,
      "text": "एक्सचेंज ट्रांजैक्शन चार्जेस और इतना ही"
    },
    {
      "subtitle_id": 163,
      "start": 339.72,
      "end": 343.6,
      "text": "नहीं मिस्टर डब्बा स्वामी को अगर अजय पर"
    },
    {
      "subtitle_id": 164,
      "start": 341.6,
      "end": 346.56,
      "text": "ट्रस्ट वो रेगुलर कस्टमर है तो उनसे पूरे"
    },
    {
      "subtitle_id": 165,
      "start": 343.6,
      "end": 348.4,
      "text": "₹1 लाख भी नहीं लेगा कई बार 102 हज ही ले"
    },
    {
      "subtitle_id": 166,
      "start": 346.56,
      "end": 350.08,
      "text": "लेगा और कई बार तो वो भी नहीं लेगा मतलब"
    },
    {
      "subtitle_id": 167,
      "start": 348.4,
      "end": 352.199,
      "text": "डब्बा ट्रेडिंग का जो काम है पूरा ब्लाइंड"
    },
    {
      "subtitle_id": 168,
      "start": 350.08,
      "end": 354.28,
      "text": "फेथ पे चलता है अब वैसे तो इस केस में तीन"
    },
    {
      "subtitle_id": 169,
      "start": 352.199,
      "end": 356.319,
      "text": "पॉसिबिलिटीज हैं पहला मान लेते हैं कि"
    },
    {
      "subtitle_id": 170,
      "start": 354.28,
      "end": 358.96,
      "text": "प्राइस ऊपर जाती है ₹1 की जो प्राइस है"
    },
    {
      "subtitle_id": 171,
      "start": 356.319,
      "end": 360.72,
      "text": "एबीसी शेयर की वो ₹10 हो जाती है तो अजय"
    },
    {
      "subtitle_id": 172,
      "start": 358.96,
      "end": 363.36,
      "text": "को कितना फायदा होगा अजय खरीदने वाला था"
    },
    {
      "subtitle_id": 173,
      "start": 360.72,
      "end": 366.8,
      "text": "1000 शेयर्स 1000 मल्टीप्ला बा ₹ का यहां"
    },
    {
      "subtitle_id": 174,
      "start": 363.36,
      "end": 369.28,
      "text": "पर फायदा हुआ 1000 मल्ला बा 20 = ₹2000000"
    },
    {
      "subtitle_id": 175,
      "start": 366.8,
      "end": 371.639,
      "text": "इस केस में मिस्टर डब्बा स्वामी अजय को"
    },
    {
      "subtitle_id": 176,
      "start": 369.28,
      "end": 373.919,
      "text": "0000 दे देंगे और अगर मान लेते कि प्राइस"
    },
    {
      "subtitle_id": 177,
      "start": 371.639,
      "end": 375.84,
      "text": "₹ से नीचे चला जाता है तो उस केस में अजय"
    },
    {
      "subtitle_id": 178,
      "start": 373.919,
      "end": 377.72,
      "text": "को मिस्टर डब्बा स्वामी को 0000 देने"
    },
    {
      "subtitle_id": 179,
      "start": 375.84,
      "end": 379.36,
      "text": "पड़ेंगे अब आप सोचेंगे कि किस केस में"
    },
    {
      "subtitle_id": 180,
      "start": 377.72,
      "end": 381.759,
      "text": "मिस्टर डब्बा स्वामी को लॉसेस भी तो हो"
    },
    {
      "subtitle_id": 181,
      "start": 379.36,
      "end": 383.68,
      "text": "सकते हैं हां अगर नॉर्मली सोचे तो आपका जो"
    },
    {
      "subtitle_id": 182,
      "start": 381.759,
      "end": 385.28,
      "text": "कहना है वह बिल्कुल सही है लेकिन एक्चुअल"
    },
    {
      "subtitle_id": 183,
      "start": 383.68,
      "end": 387.28,
      "text": "में ऐसा नहीं है तो होता क्या है कि जैसे"
    },
    {
      "subtitle_id": 184,
      "start": 385.28,
      "end": 389.28,
      "text": "कि आप ये सेबी की रिपोर्ट पढ़ सकते हो तो"
    },
    {
      "subtitle_id": 185,
      "start": 387.28,
      "end": 391.72,
      "text": "इस रिपोर्ट के हिसाब से 10 में से सात डे"
    },
    {
      "subtitle_id": 186,
      "start": 389.28,
      "end": 393.96,
      "text": "ट्रेड पैसा गवाते हैं और ऑप्शन में तो यह"
    },
    {
      "subtitle_id": 187,
      "start": 391.72,
      "end": 396.44,
      "text": "नंबर और भी हॉरिबल है 10 में से नौ ऑप्शन"
    },
    {
      "subtitle_id": 188,
      "start": 393.96,
      "end": 398.52,
      "text": "ट्रेडर्स पैसा गवाते हैं इसका मतलब यह है"
    },
    {
      "subtitle_id": 189,
      "start": 396.44,
      "end": 401.24,
      "text": "कि मिस्टर डब्बा स्वामी जैसे डब्बा ऑपरेटर"
    },
    {
      "subtitle_id": 190,
      "start": 398.52,
