    {
      "subtitle_id": 286,
      "start": 603.0,
      "end": 607.12,
      "text": "पैसा मिला यह सब न्यूज़ आजकल बहुत आम हो"
    },
    {
      "subtitle_id": 287,
      "start": 605.16,
      "end": 609.16,
      "text": "गई है तो डब्बा ट्रेडिंग से दूर रहे इस"
    },
    {
      "subtitle_id": 288,
      "start": 607.12,
      "end": 610.68,
      "text": "वीडियो को बनाने का मकसद यही था कि डब्बा"
    },
    {
      "subtitle_id": 289,
      "start": 609.16,
      "end": 612.48,
      "text": "ट्रेडिंग क्या है ये आपके समझ में आए और"
    },
    {
      "subtitle_id": 290,
      "start": 610.68,
      "end": 614.36,
      "text": "जो जेनन एप्स है और डब्बा ट्रेडिंग है"
    },
    {
      "subtitle_id": 291,
      "start": 612.48,
      "end": 616.2,
      "text": "उसमें क्या फर्क है और क्यों आपको डब्बा"
    },
    {
      "subtitle_id": 292,
      "start": 614.36,
      "end": 618.0,
      "text": "ट्रेडिंग से दूर रहना चाहिए क्योंकि आप"
    },
    {
      "subtitle_id": 293,
      "start": 616.2,
      "end": 620.32,
      "text": "अपने सामने स्क्रीन पर देख सकते हो कि अगर"
    },
    {
      "subtitle_id": 294,
      "start": 618.0,
      "end": 622.76,
      "text": "आप डब्बा ट्रेडिंग करते पकड़े गए तो 10"
    },
    {
      "subtitle_id": 295,
      "start": 620.32,
      "end": 625.04,
      "text": "साल की सजा या 25 करोड़ का फाइन या दोनों"
    },
    {
      "subtitle_id": 296,
      "start": 622.76,
      "end": 627.0,
      "text": "आपको हो सकता है और यही चीज आप सेबी की"
    },
    {
      "subtitle_id": 297,
      "start": 625.04,
      "end": 628.56,
      "text": "वेबसाइट पर भी पढ़ सकते हो तो सेबी का"
    },
    {
      "subtitle_id": 298,
      "start": 627.0,
      "end": 631.079,
      "text": "क्लियर ये कहना है कि अगर आप ट्रेडिंग"
    },
    {
      "subtitle_id": 299,
      "start": 628.56,
      "end": 633.8,
      "text": "करोगे डब्बा तो हम कर देंगे आपका अब्बा"
    },
    {
      "subtitle_id": 300,
      "start": 631.079,
      "end": 635.8,
      "text": "डब्बा चब्बा तो इन सारी चीजों से दूर रहिए"
    },
    {
      "subtitle_id": 301,
      "start": 633.8,
      "end": 637.68,
      "text": "हां यह चीज मान लेते हैं कि टैक्सेस बढ़"
    },
    {
      "subtitle_id": 302,
      "start": 635.8,
      "end": 639.16,
      "text": "रहे हैं बढ़ते हुए टैक्सेस की वजह से कई"
    },
    {
      "subtitle_id": 303,
      "start": 637.68,
      "end": 641.88,
      "text": "सारे लोग डब्बा ट्रेडिंग की तरफ जा रहे"
    },
    {
      "subtitle_id": 304,
      "start": 639.16,
      "end": 643.12,
      "text": "हैं लेकिन यह सलूशन नहीं है उस चीज का तो"
    },
    {
      "subtitle_id": 305,
      "start": 641.88,
      "end": 645.0,
      "text": "इस वीडियो को अपने ज्यादा से ज्यादा"
    },
    {
      "subtitle_id": 306,
      "start": 643.12,
      "end": 646.959,
      "text": "दोस्तों के साथ फैमिली फ्रेंड्स सभी के"
    },
    {
      "subtitle_id": 307,
      "start": 645.0,
      "end": 648.68,
      "text": "साथ शेयर कीजिए ताकि उन्हें भी पता चले कि"
    },
    {
      "subtitle_id": 308,
      "start": 646.959,
      "end": 650.72,
      "text": "डब्बा ट्रेडिंग क्या होती है और क्यों"
    },
    {
      "subtitle_id": 309,
      "start": 648.68,
      "end": 652.56,
      "text": "उन्हें इससे दूर रहना चाहिए और वो भी कहीं"
    },
    {
      "subtitle_id": 310,
      "start": 650.72,
      "end": 654.44,
      "text": "कंफ्यूज ना हो जाए कि कौन सा रियल ऐप है"
    },
    {
      "subtitle_id": 311,
      "start": 652.56,
      "end": 656.32,
      "text": "और कौन सा डब्बा ऑपरेटर का मिलते हैं अगले"
    },
    {
      "subtitle_id": 312,
      "start": 654.44,
      "end": 658.399,
      "text": "वीडियो में और जाते-जाते हमारे फंडामेंटल"
    },
    {
      "subtitle_id": 313,
      "start": 656.32,
      "end": 660.0,
      "text": "2.0 कोर्स को जरूर चेक आउट कीजिए लिंक"
    },
    {
      "subtitle_id": 314,
      "start": 658.399,
      "end": 661.76,
      "text": "नीचे डिस्क्रिप्शन और कमेंट बॉक्स में दी"
    },
    {
      "subtitle_id": 315,
      "start": 660.0,
      "end": 663.76,
      "text": "गई है ये डिस्काउंट्स आपको फिर नहीं"
    },
    {
      "subtitle_id": 316,
      "start": 661.76,
      "end": 665.48,
      "text": "मिलेगा और हमारे कोर्स की जो लॉन्च प्राइस"
    },
    {
      "subtitle_id": 317,
      "start": 663.76,
      "end": 667.519,
      "text": "होती है उस प्राइस में आपको वो कोर्स बाद"
    },
    {
      "subtitle_id": 318,
      "start": 665.48,
      "end": 669.16,
      "text": "में कभी नहीं मिलता है सो डोंट मिस आउट ऑन"
    },
    {
      "subtitle_id": 319,
      "start": 667.519,
      "end": 673.44,
      "text": "दिस अपॉर्चुनिटी मिलते हैं अगले वीडियो"
    },
    {
      "subtitle_id": 320,
      "start": 669.16,
      "end": 673.44,
      "text": "में थैंक यू सो मच फॉर वाचिंग दिस वीडियो"
    }
  ]
}