  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.16,
      "end": 4.2,
      "text": "बड़े बुजुर्ग कह के गए कि आप जिंदगी में"
    },
    {
      "subtitle_id": 2,
      "start": 2.0,
      "end": 4.2,
      "text": "कभी"
    },
    {
      "subtitle_id": 3,
      "start": 4.6,
      "end": 10.639,
      "text": "डिसपिटर अगर आप किसी से कुछ एक्सपेक्टशंस"
    },
    {
      "subtitle_id": 4,
      "start": 8.2,
      "end": 12.92,
      "text": "ही नहीं रखते हैं तो आज के बजट का हाल भी"
    },
    {
      "subtitle_id": 5,
      "start": 10.639,
      "end": 15.0,
      "text": "कुछ ऐसा ही था शुरुआत में तो ऐसा लगा कि"
    },
    {
      "subtitle_id": 6,
      "start": 12.92,
      "end": 16.68,
      "text": "बिहार और आंध्रा का बजट है मेरा पर्सनल"
    },
    {
      "subtitle_id": 7,
      "start": 15.0,
      "end": 18.439,
      "text": "मानना है कि कुछ सेक्टर जैसे एग्रीकल्चर"
    },
    {
      "subtitle_id": 8,
      "start": 16.68,
      "end": 20.279,
      "text": "मैन्युफैक्चरिंग को फायदा पहुंचेगा पर"
    },
    {
      "subtitle_id": 9,
      "start": 18.439,
      "end": 23.16,
      "text": "मोस्टली मिडिल क्लास को तो आज के इस बजट"
    },
    {
      "subtitle_id": 10,
      "start": 20.279,
      "end": 24.8,
      "text": "ने काफी ज्यादा डिसपिटर जम में यहां पर"
    },
    {
      "subtitle_id": 11,
      "start": 23.16,
      "end": 27.599,
      "text": "कुछ चेंजेज आए हैं और सरकार के अनुसार"
    },
    {
      "subtitle_id": 12,
      "start": 24.8,
      "end": 29.519,
      "text": "यहां पर मिडिल क्लास भारी भक्कम 17500"
    },
    {
      "subtitle_id": 13,
      "start": 27.599,
      "end": 32.16,
      "text": "यहां पर बचाएगा यानी महीने के कुल मिलाकर"
    },
    {
      "subtitle_id": 14,
      "start": 29.519,
      "end": 34.16,
      "text": "निकल कर आते हैं 50 तो इस भारी भक्कम"
    },
    {
      "subtitle_id": 15,
      "start": 32.16,
      "end": 36.8,
      "text": "सेविंग की आज हम सच्चाई जानेंगे साथ ही जो"
    },
    {
      "subtitle_id": 16,
      "start": 34.16,
      "end": 38.48,
      "text": "एलटीसी ज 12.5 पर हुआ है उससे रिलेटेड भी"
    },
    {
      "subtitle_id": 17,
      "start": 36.8,
      "end": 40.28,
      "text": "काफी सारी चीजों की सच्चाई आज हम जानने"
    },
    {
      "subtitle_id": 18,
      "start": 38.48,
      "end": 42.239,
      "text": "वाले हैं शुरुआत करते हैं लॉन्ग टर्म"
    },
    {
      "subtitle_id": 19,
      "start": 40.28,
      "end": 44.32,
      "text": "कैपिटल गेन टैक्स से जिसे एलटीसीजी कहते"
    },
    {
      "subtitle_id": 20,
      "start": 42.239,
      "end": 46.32,
      "text": "हैं अगर एलटीसीजी की बात करें तो पहले"
    },
    {
      "subtitle_id": 21,
      "start": 44.32,
      "end": 48.36,
      "text": "फाइनेंस और नॉन फाइनेंस के लिए आप स्क्रीन"
    },
    {
      "subtitle_id": 22,
      "start": 46.32,
      "end": 50.399,
      "text": "पर देख सकते हो उस तरह के टैक्सेस लगते थे"
    },
    {
      "subtitle_id": 23,
      "start": 48.36,
      "end": 52.32,
      "text": "ओल्ड एलटीसीजी के अनुसार अलग-अलग एसेट्स"
    },
    {
      "subtitle_id": 24,
      "start": 50.399,
      "end": 54.32,
      "text": "के लिए अलग-अलग टैक्सेस लगते थे इक्विटी"
    },
    {
      "subtitle_id": 25,
      "start": 52.32,
      "end": 56.64,
      "text": "के लिए 10 पर था तो बाकी जो फाइनेंशियल"
    },
    {
      "subtitle_id": 26,
      "start": 54.32,
      "end": 59.28,
      "text": "एसेट्स थे जैसे कि गोल्ड रियल एस्टेट इन"
    },
    {
      "subtitle_id": 27,
      "start": 56.64,
      "end": 62.48,
      "text": "सबके लिए 20 पर था तो अब इन सभी के लिए जो"
    },
    {
      "subtitle_id": 28,
      "start": 59.28,
      "end": 65.519,
      "text": "एलटीसी लगेगा वो होगा 12.5 पर का"
    },
    {
      "subtitle_id": 29,
      "start": 62.48,
      "end": 67.64,
      "text": "12.5 और यहां पर जो होल्डिंग पीरियड है वो"
    },
    {
      "subtitle_id": 30,
      "start": 65.519,
      "end": 69.08,
      "text": "भी 1 साल से 2 साल किया गया है यानी पहले"
    },
    {
      "subtitle_id": 31,
      "start": 67.64,
      "end": 71.04,
      "text": "माना जाता था कि लॉन्ग टर्म इन्वेस्टमेंट"
    },
    {
      "subtitle_id": 32,
      "start": 69.08,
      "end": 72.759,
      "text": "मतलब 1 साल से ज्यादा लेकिन अब ऐसा नहीं"
    },
    {
      "subtitle_id": 33,
      "start": 71.04,
      "end": 74.479,
      "text": "है 2 साल से ज्यादा जो इन्वेस्टमेंट रहेगी"
    },
    {
      "subtitle_id": 34,
      "start": 72.759,
      "end": 76.08,
      "text": "वही लॉन्ग टर्म में काउंट की जाएगी जो"
    },
    {
      "subtitle_id": 35,
      "start": 74.479,
      "end": 79.119,
      "text": "इक्विटी इन्वेस्टर्स हैं उनके लिए दोनों"
    },
    {
      "subtitle_id": 36,
      "start": 76.08,
      "end": 81.24,
      "text": "कम थे आपका एलटीसीजी 10 पर था आपका"
    },
    {
      "subtitle_id": 37,
      "start": 79.119,
      "end": 83.079,
      "text": "होल्डिंग पीरियड 1 साल का था एक साल से"
    },
    {
      "subtitle_id": 38,
      "start": 81.24,
      "end": 85.6,
      "text": "डबल हो गया होल्डिंग पीरियड साथ में जो"
    },
    {
      "subtitle_id": 39,
      "start": 83.079,
      "end": 87.52,
      "text": "टैक्स था 10 से वो 12 1.5 पर हो गया वहीं"
    },
    {
      "subtitle_id": 40,
      "start": 85.6,
      "end": 89.56,
      "text": "पर रियल एस्टेट गोल्ड वगैरह है वहां पर 20"
    },
    {
      "subtitle_id": 41,
      "start": 87.52,
      "end": 91.6,
      "text": "पर का एलटीसीजी लगता था वो 12 1.5 पर हो"
    },
    {
      "subtitle_id": 42,
      "start": 89.56,
      "end": 93.04,
      "text": "गया अब आप यहां पर मुझे बताइए तो अब ये जो"
    },
    {
      "subtitle_id": 43,
      "start": 91.6,
      "end": 94.72,
      "text": "एलटीसीजी में चेंजेज लाए हैं होल्डिंग"
    },
    {
      "subtitle_id": 44,
      "start": 93.04,
      "end": 96.759,
      "text": "पीरियड में चेंजेज लाए हैं ये अच्छे हैं"
    },
    {
      "subtitle_id": 45,
      "start": 94.72,
      "end": 99.32,
      "text": "या फिर बुरे तो यहां पर इक्विटी की अगर"
    },
    {
      "subtitle_id": 46,
      "start": 96.759,
      "end": 101.56,
      "text": "बात करें तो एलटीसीजी में जो एजमन था 1"
    },
    {
      "subtitle_id": 47,
      "start": 99.32,
      "end": 104.799,
      "text": "लाख का हर साल का वो ₹2500000"
    },
    {
      "subtitle_id": 48,
      "start": 101.56,
      "end": 107.24,
      "text": "कर दिया है और उसका फायदा हार्डली ₹ 3000"
    },
    {
      "subtitle_id": 49,
      "start": 104.799,
      "end": 110.0,
      "text": "का रहेगा पर अगर आपको जो एलटीसीजी है वो ₹"
    },
    {
      "subtitle_id": 50,
      "start": 107.24,
      "end": 112.88,
      "text": "लाख के ऊपर जाता है तो आपको वहां पर जो %"
    },
    {
      "subtitle_id": 51,
      "start": 110.0,
      "end": 114.52,
      "text": "जो ऊपर आ रहा है वो काफी चुभे साथ ही जो 1"
    },
    {
      "subtitle_id": 52,
      "start": 112.88,
      "end": 116.2,
      "text": "साल की टाइम पीरियड थी होल्डिंग पीरियड वो"
    },
    {
      "subtitle_id": 53,
      "start": 114.52,
      "end": 118.2,
      "text": "भी 2 साल होने से वहां पर भी आपकी टैक्स"
    },
    {
      "subtitle_id": 54,
      "start": 116.2,
      "end": 119.96,
      "text": "लायबिलिटी काफी बढ़ने की आशंका है अब जो"
    },
    {
      "subtitle_id": 55,
      "start": 118.2,
      "end": 121.92,
      "text": "बाकी एसेट क्लासेस है रियल एस्टेट गोल्ड"
    },
    {
      "subtitle_id": 56,
      "start": 119.96,
      "end": 123.64,
      "text": "वहां पर स्क्रीनशॉट देखकर आपको पता चल गया"
    },
    {
      "subtitle_id": 57,
      "start": 121.92,
      "end": 126.68,
      "text": "होगा कि यहां पर तो एलटीसीजी काफी कम हुआ"
    },
    {
      "subtitle_id": 58,
      "start": 123.64,
      "end": 129.039,
      "text": "है 20 पर से 12.5 पर लेकिन अग आपको बात"
    },
    {
      "subtitle_id": 59,
      "start": 126.68,
      "end": 130.84,
      "text": "बता दूं कि अंदर की बात कुछ और है बात ये"
    },
    {
      "subtitle_id": 60,
      "start": 129.039,
      "end": 132.68,
      "text": "है तो यहां पर जो इंडेक्स सेशन के बेनिफिट"
    },
    {
      "subtitle_id": 61,
      "start": 130.84,
      "end": 134.4,
      "text": "है वो कंपलीटली हटाए गए हैं तो इसके बाद"
    },
    {
      "subtitle_id": 62,
      "start": 132.68,
      "end": 136.879,
      "text": "एक्चुअल में आपका जो रियल एस्टेट का"
    },
    {
      "subtitle_id": 63,
      "start": 134.4,
      "end": 139.28,
      "text": "एलटीसीजी है वो कम नहीं होगा उल्टा बहुत"
    },
    {
      "subtitle_id": 64,
      "start": 136.879,
      "end": 141.36,
      "text": "ज्यादा बढ़ेगा कैसे देखिए इंडेक्सेशन एक"
    },
    {
      "subtitle_id": 65,
      "start": 139.28,
      "end": 143.16,
      "text": "प्रोसेस है जो आपके एसेट के परचेस प्राइस"
    },
    {
      "subtitle_id": 66,
      "start": 141.36,
      "end": 145.76,
      "text": "को इंफ्लेशन के हिसाब से एडजस्ट कर लेता"
    },
    {
      "subtitle_id": 67,
      "start": 143.16,
      "end": 147.959,
      "text": "है ताकि टैक्सेबल गेन कम हो और आपको कम"
    },
    {
      "subtitle_id": 68,
      "start": 145.76,
      "end": 150.44,
      "text": "टैक्स पे करना पड़े अगर मान लीजिए आपके"
    },
    {
      "subtitle_id": 69,
      "start": 147.959,
      "end": 152.0,
      "text": "पास 10 साल पहले प्रॉपर्टी थी 50 लाख की"
    },
    {
      "subtitle_id": 70,
      "start": 150.44,
      "end": 154.64,
      "text": "तो इंफ्लेशन जैसे-जैसे बढ़ रहा है उस"
    },
    {
      "subtitle_id": 71,
      "start": 152.0,
      "end": 157.36,
      "text": "हिसाब से उसकी प्राइस आज 80 लाख हो गई है"
    },
    {
      "subtitle_id": 72,
      "start": 154.64,
      "end": 159.64,
      "text": "यानी उसकी इंडेक्स कॉस्ट 80 लाख की हो गई"
    },
    {
      "subtitle_id": 73,
      "start": 157.36,
      "end": 161.319,
      "text": "है और अगर आप उस प्रॉपर्टी को 90 लाख में"
    },
    {
      "subtitle_id": 74,
      "start": 159.64,
      "end": 163.84,
      "text": "बेचते हैं तो आपका टैक्सेबल गेन कितना"
    },
    {
      "subtitle_id": 75,
      "start": 161.319,
      "end": 166.239,
      "text": "होगा ₹10 लाख का तो ओल्ड में आप ₹10 लाख"
    },
    {
      "subtitle_id": 76,
      "start": 163.84,
      "end": 167.879,
      "text": "पर % पे करते यानी ₹2500000 लेकिन अब"
    },
    {
      "subtitle_id": 77,
      "start": 166.239,
      "end": 170.12,
      "text": "इंडेक्सेशन है ही नहीं आपने प्रॉपर्टी"
    },
    {
      "subtitle_id": 78,
      "start": 167.879,
      "end": 172.159,
      "text": "खरीदी थी 50 लाख की बेची 90 लाख में आपका"
    },
    {
      "subtitle_id": 79,
      "start": 170.12,
      "end": 175.84,
      "text": "टैक्सेबल गेन कितना हुआ 40 लाख का उस पर"
    },
    {
      "subtitle_id": 80,
      "start": 172.159,
      "end": 177.92,
      "text": "12.5 पर यानी अब आपको 2 लाख की बजाय ₹ लाख"
    },
    {
      "subtitle_id": 81,
      "start": 175.84,
      "end": 179.959,
      "text": "पे करने पड़ेंगे तो भले ही यहां पर दिखने"
    },
    {
      "subtitle_id": 82,
      "start": 177.92,
      "end": 181.56,
      "text": "में रेट कम हुआ हो बट एक्चुअल में आपको को"
    },
    {
      "subtitle_id": 83,
      "start": 179.959,
      "end": 183.239,
      "text": "मोस्ट ऑफ द केसेस में ज्यादा टैक्स पे"
    },
    {
      "subtitle_id": 84,
      "start": 181.56,
      "end": 185.56,
      "text": "करना पड़ेगा रियल एस्टेट पर और इसी के"
    },
    {
      "subtitle_id": 85,
      "start": 183.239,
      "end": 187.239,
      "text": "चलते आप अगर देखेंगे यहां पर तो सारी रियल"
    },
    {
      "subtitle_id": 86,
      "start": 185.56,
      "end": 190.12,
      "text": "एस्टेट कंपनीज के शेयर्स गिर गए हैं बहुत"
    },
    {
      "subtitle_id": 87,
      "start": 187.239,
      "end": 191.64,
      "text": "ज्यादा गिर गए हैं क्यों गिरे तो अब उनको"
    },
    {
      "subtitle_id": 88,
      "start": 190.12,
      "end": 193.12,
      "text": "पता है कि रियल एस्टेट में इन्वेस्ट करने"
    },
    {
      "subtitle_id": 89,
      "start": 191.64,
      "end": 195.959,
      "text": "वाले लोगों की संख्या भी शायद कम हो सकती"
    },
    {
      "subtitle_id": 90,
      "start": 193.12,
      "end": 197.48,
      "text": "है इन चेंजेज के बाद अब आते हैं सबसे"
    },
    {
      "subtitle_id": 91,
      "start": 195.959,
      "end": 199.519,
      "text": "इंपोर्टेंट चीज के बारे में बात करने वो"
    },
    {
      "subtitle_id": 92,
      "start": 197.48,
      "end": 202.44,
      "text": "है एसटीटी सिक्योरिटीज ट्रांजैक्शन टैक्स"
    },
    {
      "subtitle_id": 93,
      "start": 199.519,
      "end": 204.319,
      "text": "इसको लाया गया था 2004 में पी चिदंबरम ने"
    },
    {
      "subtitle_id": 94,
      "start": 202.44,
      "end": 206.159,
      "text": "उस टाइम के फाइनेंस मिनिस्टर तो उस टाइम"
    },
    {
      "subtitle_id": 95,
      "start": 204.319,
      "end": 209.959,
      "text": "उन्होंने क्या किया एलटीसीजी को हटा दिया"
    },
    {
      "subtitle_id": 96,
      "start": 206.159,
      "end": 212.0,
      "text": "और एसटीटी लाया फिर 201819 की बात है और"
    },
    {
      "subtitle_id": 97,
      "start": 209.959,
      "end": 214.599,
      "text": "जेटली ने एसटीटी को तो रखा ही रखा"
    },
    {
      "subtitle_id": 98,
      "start": 212.0,
      "end": 216.36,
      "text": "एलटीसीजी भी लाया 10 का लॉन्ग टर्म पर"
    },
    {
      "subtitle_id": 99,
      "start": 214.599,
      "end": 217.92,
      "text": "इक्विटी में शेयर मार्केट में फिर अब"
    },
    {
      "subtitle_id": 100,
      "start": 216.36,
      "end": 219.68,
      "text": "रिसेंटली जैसे कि कल वाली वीडियो में"
    },
    {
      "subtitle_id": 101,
      "start": 217.92,
      "end": 221.76,
      "text": "मैंने बात की कि शायद मुझे भी ऐसा अनुमान"
    },
    {
      "subtitle_id": 102,
      "start": 219.68,
      "end": 223.48,
      "text": "था कि शायद एसटीटी कम हो लेकिन वही है कि"
    },
    {
      "subtitle_id": 103,
      "start": 221.76,
      "end": 226.159,
      "text": "आपको खुश रहने एक्सपेक्टेशन नहीं रखनी"
    },
    {
      "subtitle_id": 104,
      "start": 223.48,
      "end": 229.56,
      "text": "चाहिए और वही एगजैक्टली यहां पर हुआ जो"
    },
    {
      "subtitle_id": 105,
      "start": 226.159,
      "end": 232.04,
      "text": "एसटीटी है जो हटाने की बात चल रही थी लोग"
    },
    {
      "subtitle_id": 106,
      "start": 229.56,
      "end": 233.72,
      "text": "एक्सपेक्ट करते शायद यह कम हो जो लॉन्ग"
    },
    {
      "subtitle_id": 107,
      "start": 232.04,
      "end": 235.4,
      "text": "टर्म इन्वेस्टर्स है उनकी संख्या बढ़ाने"
    },
    {
      "subtitle_id": 108,
      "start": 233.72,
      "end": 237.519,
      "text": "के लिए शायद सरकार को काम करने चाहिए तो"
    },
    {
      "subtitle_id": 109,
      "start": 235.4,
      "end": 239.319,
      "text": "उसके लिए एलटीसीजी भी कम करें लेकिन उसके"
    },
    {
      "subtitle_id": 110,
      "start": 237.519,
      "end": 240.92,
      "text": "बजाय दोनों चीजें बढ़ाई गई तो यहां पर"
    },
    {
      "subtitle_id": 111,
      "start": 239.319,
      "end": 243.0,
      "text": "एलटीसी जी बढ़ाया लॉन्ग टर्म पर और"
    },
    {
      "subtitle_id": 112,
      "start": 240.92,
      "end": 245.04,
      "text": "फ्यूचर्स ऑप्शन पर जो एसटीटी है वो लगभग"
    },
    {
      "subtitle_id": 113,
      "start": 243.0,
      "end": 246.92,
      "text": "डबल कर दिया गया है और बात रही एसटीसीजी"
    },
    {
      "subtitle_id": 114,
      "start": 245.04,
      "end": 248.92,
      "text": "यानी शॉर्ट टर्म कैपिटल गेन टैक्स की तो"
    },
    {
      "subtitle_id": 115,
      "start": 246.92,
      "end": 251.36,
      "text": "सरकार ने कहा कि इसे भी क्यों कम रखना है"
    },
    {
      "subtitle_id": 116,
      "start": 248.92,
      "end": 253.28,
      "text": "तो उसे भी अभी 15 पर से 20 पर कर दिया गया"
    },
    {
      "subtitle_id": 117,
      "start": 251.36,
      "end": 255.2,
      "text": "है जो कि अगेन बिग ब्लो है काफी सारे"
    },
    {
      "subtitle_id": 118,
      "start": 253.28,
      "end": 257.04,
      "text": "इन्वेस्टर्स के लिए और इसी के चलते आज"
    },
    {
      "subtitle_id": 119,
      "start": 255.2,
      "end": 259.32,
      "text": "हमने देखा है कि मार्केट काफी क्रैश हो"
    },
    {
      "subtitle_id": 120,
      "start": 257.04,
      "end": 261.4,
      "text": "गया है और कई सारी कंपनी जो अलग-अलग"
    },
    {
      "subtitle_id": 121,
      "start": 259.32,
      "end": 263.32,
      "text": "सेक्टर्स की है वो काफी खराब परफॉर्म करती"
    },
    {
      "subtitle_id": 122,
      "start": 261.4,
      "end": 264.88,
      "text": "हुई नजर आई अब देखिए कई सारे लोग कमेंट्री"
    },
    {
      "subtitle_id": 123,
      "start": 263.32,
      "end": 266.6,
      "text": "कर रहे थे कि सरकार चाहती थी कि फ्यूचर्स"
    },
    {
      "subtitle_id": 124,
      "start": 264.88,
      "end": 268.44,
      "text": "ऑप्शंस को थोड़ा कंट्रोल किया जाए तो"
    },
    {
      "subtitle_id": 125,
      "start": 266.6,
      "end": 270.24,
      "text": "इसलिए लेकिन मुझे यहां पर यह समझ में नहीं"
    },
    {
      "subtitle_id": 126,
      "start": 268.44,
      "end": 271.8,
      "text": "आया कि आप लॉन्ग टर्म इन्वेस्टर्स के लिए"
    },
    {
      "subtitle_id": 127,
      "start": 270.24,
      "end": 273.6,
      "text": "एलटीसीजी क्यों बढ़ा रहे हैं और साथ ही"
    },
    {
      "subtitle_id": 128,
      "start": 271.8,
      "end": 275.919,
      "text": "प्रीवियस जो केस स्टडीज है वो ये भी बताती"
    },
    {
      "subtitle_id": 129,
      "start": 273.6,
      "end": 278.28,
      "text": "है कि जब-जब आप टैक्सेस कुछ एक लेवल के"
    },
    {
      "subtitle_id": 130,
      "start": 275.919,
      "end": 281.12,
      "text": "बाद बढ़ाते हो तो इल्लीगल चीजें काफी"
    },
    {
      "subtitle_id": 131,
      "start": 278.28,
      "end": 282.759,
      "text": "बढ़ने लगती है मार्केट में और जैसे बेटिंग"
    },
    {
      "subtitle_id": 132,
      "start": 281.12,
      "end": 284.52,
      "text": "ऐप में हुआ कि बहुत सारे फॉरेन के बेटिंग"
    },
    {
      "subtitle_id": 133,
      "start": 282.759,
      "end": 286.4,
      "text": "एप्स आने लगे और बिना टैक्स का बिना"
    },
    {
      "subtitle_id": 134,
      "start": 284.52,
      "end": 287.919,
      "text": "जीएसटी का यहां पर चलने लगे और फिर"
    },
    {
      "subtitle_id": 135,
      "start": 286.4,
      "end": 289.96,
      "text": "उन्होंने काफी सारे लोगों को अट्रैक्ट"
    },
    {
      "subtitle_id": 136,
      "start": 287.919,
      "end": 291.84,
      "text": "किया और यहां पर एक गवर्नमेंट का भी लॉस"
    },
    {
      "subtitle_id": 137,
      "start": 289.96,
      "end": 293.479,
      "text": "हुआ इन टर्म्स ऑफ टैक्स तो इस चीज का भी"
    },
    {
      "subtitle_id": 138,
      "start": 291.84,
      "end": 294.919,
      "text": "फ्यूचर में फाइनेंस डिपार्टमेंट को मेरे"
    },
    {
      "subtitle_id": 139,
      "start": 293.479,
      "end": 297.08,
      "text": "हिसाब से ध्यान रखना चाहिए कि आप जो"
    },
    {
      "subtitle_id": 140,
      "start": 294.919,
      "end": 299.12,
      "text": "एक्शंस ले रहे हैं उसकी रिएक्शन क्या आ"
    },
    {
      "subtitle_id": 141,
      "start": 297.08,
      "end": 300.96,
      "text": "रही है वो भी जरूर ध्यान में रखनी चाहिए"
    },
    {
      "subtitle_id": 142,
      "start": 299.12,
      "end": 303.28,
      "text": "उसके बाद आते हैं कस्टम ड्यूटी पर तो"
    },
    {
      "subtitle_id": 143,
      "start": 300.96,
      "end": 305.919,
      "text": "गोल्ड पर जो कस्टम ड्यूटी थी 15 की वो अब"
    },
    {
      "subtitle_id": 144,
      "start": 303.28,
      "end": 309.4,
      "text": "घटाकर 6 पर कर दी गई है जिसके चलते सारी"
    },
    {
      "subtitle_id": 145,
      "start": 305.919,
      "end": 312.24,
      "text": "जो अ हम कह सकते हैं कि गोल्ड स्टॉक्स है"
    },
    {
      "subtitle_id": 146,
      "start": 309.4,
      "end": 314.039,
      "text": "जैसे टाइटन है सिंको गोल्ड है कल्याण"
    },
    {
      "subtitle_id": 147,
      "start": 312.24,
      "end": 315.84,
      "text": "जलर्स है उनकी शेयर प्राइस आज हमें ऑन द"
    },
    {
      "subtitle_id": 148,
      "start": 314.039,
      "end": 317.16,
      "text": "रूफ दिखाई दी गोल्ड में भी इंडेक्सेशन"
    },
    {
      "subtitle_id": 149,
      "start": 315.84,
      "end": 319.319,
      "text": "इफेक्ट यहां से नहीं रहेगा और वहां का जो"
    },
    {
      "subtitle_id": 150,
      "start": 317.16,
      "end": 321.759,
      "text": "गोल्ड का एलटीसीजी जो 20 हुआ करता था वो"
    },
    {
      "subtitle_id": 151,
      "start": 319.319,
      "end": 323.36,
      "text": "भी भी 12.5 पर हो जाएगा लेकिन वहां पर भी"
    },
    {
      "subtitle_id": 152,
      "start": 321.759,
      "end": 325.039,
      "text": "ज्यादा कुछ बेनिफिट कस्टमर को मिलेगा ऐसा"
    },
    {
      "subtitle_id": 153,
      "start": 323.36,
      "end": 326.479,
      "text": "नहीं लगता है लेकिन कस्टमर जो कस्टम"
    },
    {
      "subtitle_id": 154,
      "start": 325.039,
      "end": 328.8,
      "text": "ड्यूटी है वो कम होने की वजह से थोड़ा"
    },
    {
      "subtitle_id": 155,
      "start": 326.479,
      "end": 330.24,
      "text": "गोल्ड आपको सस्ते में मिल सकता है और इसकी"
    },
    {
      "subtitle_id": 156,
      "start": 328.8,
      "end": 331.6,
      "text": "वजह से जो"
    },
    {
      "subtitle_id": 157,
      "start": 330.24,
      "end": 333.16,
      "text": "एयरपोर्ट्स पे हम देखते थे कस्टम"
    },
    {
      "subtitle_id": 158,
      "start": 331.6,
      "end": 335.0,
      "text": "डिपार्टमेंट में कि कोई बाल में छुपा के"
    },
    {
      "subtitle_id": 159,
      "start": 333.16,
      "end": 337.039,
      "text": "गोल्ड ला रहा है शूज में सैंडल में छुपा"
    },
    {
      "subtitle_id": 160,
      "start": 335.0,
      "end": 339.68,
      "text": "के ला रहा है वो कैसे शायद इस वजह से"
    },
    {
      "subtitle_id": 161,
      "start": 337.039,
      "end": 341.36,
      "text": "थोड़ी कम हो सकती है अब बात करते हैं एंजल"
    },
    {
      "subtitle_id": 162,
      "start": 339.68,
      "end": 343.52,
      "text": "टैक्स की तो एंजल टैक्स गवर्नमेंट ने पूरी"
    },
    {
      "subtitle_id": 163,
      "start": 341.36,
      "end": 345.24,
      "text": "तरह से हटा दिया गया है अब ये एंजल टैक्स"
    },
    {
      "subtitle_id": 164,
      "start": 343.52,
      "end": 347.12,
      "text": "क्या था तो एंजल टैक्स वो टैक्स था जो"
    },
    {
      "subtitle_id": 165,
      "start": 345.24,
      "end": 348.8,
      "text": "स्टार्टअप्स को लगता था जब वो उनकी"
    },
    {
      "subtitle_id": 166,
      "start": 347.12,
      "end": 351.24,
      "text": "वैल्यूएशन से ज्यादा प्राइस पर शेयर्स"
    },
    {
      "subtitle_id": 167,
      "start": 348.8,
      "end": 353.4,
      "text": "बेचते थे गवर्नमेंट उसे तब लगाती थी जब"
    },
    {
      "subtitle_id": 168,
      "start": 351.24,
      "end": 355.52,
      "text": "उन्हें लगता था कि वैल्यूएशन जबरदस्ती"
    },
    {
      "subtitle_id": 169,
      "start": 353.4,
      "end": 357.919,
      "text": "आर्टिफिशियल तरीके से बढ़ाया जा रहा है तो"
    },
    {
      "subtitle_id": 170,
      "start": 355.52,
      "end": 359.68,
      "text": "ये टैक्स पूरी तरह से हटाया गया है जिसका"
    },
    {
      "subtitle_id": 171,
      "start": 357.919,
      "end": 361.52,
      "text": "स्टार्टअप्स को भी काफी बेनिफिट मिलेगा"
    },
    {
      "subtitle_id": 172,
      "start": 359.68,
      "end": 363.16,
      "text": "फंड रेज करने में वही अगर हम कॉर्पोरेट"
    },
    {
      "subtitle_id": 173,
      "start": 361.52,
      "end": 365.479,
      "text": "टैक्स की बात करें तो बाहर की जो कंपनीज"
    },
    {
      "subtitle_id": 174,
      "start": 363.16,
      "end": 367.72,
      "text": "है फॉरेन कंपनीज उनको 40 पर का कॉर्पोरेट"
    },
    {
      "subtitle_id": 175,
      "start": 365.479,
      "end": 370.68,
      "text": "टैक्स यहां पर देना पड़ता था जो अभी 5 पर"
    },
    {
      "subtitle_id": 176,
      "start": 367.72,
      "end": 373.0,
      "text": "से कम किया गया है और 35 पर किया गया है"
    },
    {
      "subtitle_id": 177,
      "start": 370.68,
      "end": 375.0,
      "text": "तो अभी भी यह ज्यादा ही है फॉरेन कंपनीज"
    },
    {
      "subtitle_id": 178,
      "start": 373.0,
      "end": 376.84,
      "text": "के लिए बट पहले से बेटर है तो कंक्लूजन"
    },
    {
      "subtitle_id": 179,
      "start": 375.0,
      "end": 378.479,
      "text": "में आने से पहले एक बार उन चीजों की बात"
    },
    {
      "subtitle_id": 180,
      "start": 376.84,
      "end": 380.919,
      "text": "करते हैं कि क्या कुछ सस्ता होने वाला है"
    },
    {
      "subtitle_id": 181,
      "start": 378.479,
      "end": 382.8,
      "text": "क्या कुछ महंगा तो गोल्ड होगा सस्ता तीन"
    },
    {
      "subtitle_id": 182,
      "start": 380.919,
      "end": 385.4,
      "text": "कैंसर की मेडिसिन सस्ती होगी मोबाइल फोस"
    },
    {
      "subtitle_id": 183,
      "start": 382.8,
      "end": 387.68,
      "text": "चार्जर सस्ते होंगे श्रिंप और फिश फीड"
    },
    {
      "subtitle_id": 184,
      "start": 385.4,
      "end": 389.56,
      "text": "सस्ती होंगी सोलर सेल सस्ते होंगे 25"
    },
    {
      "subtitle_id": 185,
      "start": 387.68,
      "end": 391.24,
      "text": "क्रिटिकल मटेरियल सस्ते होंगे और यह जो"
    },
    {
      "subtitle_id": 186,
      "start": 389.56,
      "end": 393.039,
      "text": "ट्रिकल मटेरियल है वो मटेरियल वो है जो"
    },
    {
      "subtitle_id": 187,
      "start": 391.24,
      "end": 394.36,
      "text": "मैन्युफैक्चरिंग में बहुत काम में आते हैं"
    },
    {
      "subtitle_id": 188,
      "start": 393.039,
      "end": 396.199,
      "text": "तो ये अच्छा मूव है मैन्युफैक्चरिंग"
    },
    {
      "subtitle_id": 189,
      "start": 394.36,
      "end": 398.28,
      "text": "इंडस्ट्री के लिए तो ओवरऑल मोटा मोटी बात"
    },
    {
      "subtitle_id": 190,
      "start": 396.199,
      "end": 400.24,
      "text": "करें तो जो इन्वेस्टर्स हैं जो मिडिल"
    },
    {
      "subtitle_id": 191,
      "start": 398.28,
      "end": 401.8,
      "text": "क्लास लोग हैं जो पैसे कमाने आए थे वो भी"
    },
    {
      "subtitle_id": 192,
      "start": 400.24,
      "end": 403.84,
      "text": "म्यूचुअल फंड में काफी सारा पैसा डाल रहे"
    },
    {
      "subtitle_id": 193,
      "start": 401.8,
      "end": 405.639,
      "text": "थे बहुत सारा इनफ्लो बढ़ गया था तो उनको"
    },
    {
      "subtitle_id": 194,
      "start": 403.84,
      "end": 407.319,
      "text": "यहां पर टैक्स का बर्डन अभी छिलना पड़ेगा"
    },
    {
      "subtitle_id": 195,
      "start": 405.639,
      "end": 409.24,
      "text": "बीट शॉर्ट टर्म कैपिटल गेन टैक्स बीट"
    },
    {
      "subtitle_id": 196,
      "start": 407.319,
      "end": 410.68,
      "text": "लॉन्ग टर्म कैपिटल गेन टैक्स और फिर कई"
    },
    {
      "subtitle_id": 197,
      "start": 409.24,
      "end": 412.319,
      "text": "सारे लोग हैं जिन्हें इन चीजों की समझ"
    },
    {
      "subtitle_id": 198,
      "start": 410.68,
      "end": 414.0,
      "text": "नहीं थी वो रियल एस्टेट में पैसा डालते थे"
    },
    {
      "subtitle_id": 199,
      "start": 412.319,
      "end": 415.8,
      "text": "उनको तो और भी ज्यादा प्रॉब्लम अभी आने"
    },
    {
      "subtitle_id": 200,
      "start": 414.0,
      "end": 417.28,
      "text": "वाली है तो इंडेक्सेशन बेनिफिट नहीं है तो"
    },
    {
      "subtitle_id": 201,
      "start": 415.8,
      "end": 418.68,
      "text": "बड़े-बड़े टैक्सेस आपको पे करने के लिए"
    },
    {
      "subtitle_id": 202,
      "start": 417.28,
      "end": 420.319,
      "text": "रियल स्टेट इन्वेस्टर्स को यहां से रेडी"
    },
    {
      "subtitle_id": 203,
      "start": 418.68,
      "end": 422.4,
      "text": "होना पड़ेगा लास्ट ला वीडियो में हमने ये"
    },
    {
      "subtitle_id": 204,
      "start": 420.319,
      "end": 424.879,
      "text": "क्लिप देखी थी मिस्टर निरंजन हिरानंदानी"
    },
    {
      "subtitle_id": 205,
      "start": 422.4,
      "end": 426.44,
      "text": "की जो कि हिरानंदानी ग्रुप के एमडी है"
    },
    {
      "subtitle_id": 206,
      "start": 424.879,
      "end": 428.639,
      "text": "उन्होंने यह बात कही थी कि मुंबई में जो"
    },
    {
      "subtitle_id": 207,
      "start": 426.44,
      "end": 430.4,
      "text": "भी फ्लैट्स है उसकी एक्चुअल कॉस्ट हम भी"
    },
    {
      "subtitle_id": 208,
      "start": 428.639,
      "end": 433.44,
      "text": "इतनी ज्यादा रखना नहीं चाहते बट क्या करें"
    },
    {
      "subtitle_id": 209,
      "start": 430.4,
      "end": 435.12,
      "text": "कि उसकी फ्लैट की जो 50 टू 55 पर कॉस्ट है"
    },
    {
      "subtitle_id": 210,
      "start": 433.44,
      "end": 437.319,
      "text": "वो डायरेक्टली इनडायरेक्टली सरकार को हमें"
    },
    {
      "subtitle_id": 211,
      "start": 435.12,
      "end": 439.199,
      "text": "देनी पड़ती है तो इसमें अब जो कैपिटल गेन"
    },
    {
      "subtitle_id": 212,
      "start": 437.319,
      "end": 441.36,
      "text": "आपको एक्स्ट्रा लगेगा वो और एडिशनल हो गया"
    },
    {
      "subtitle_id": 213,
      "start": 439.199,
      "end": 443.08,
      "text": "तो इसकी वजह से शायद रियल एस्टेट मार्केट"
    },
    {
      "subtitle_id": 214,
      "start": 441.36,
      "end": 445.199,
      "text": "के लिए थोड़ी प्रॉब्लम्स आने वाले टाइम"
    },
    {
      "subtitle_id": 215,
      "start": 443.08,
      "end": 447.319,
      "text": "में जरूर देखने मिलेंगे तो कंक्लूजन यही"
    },
    {
      "subtitle_id": 216,
      "start": 445.199,
      "end": 449.0,
      "text": "है कि जैसे बड़े बुजुर्ग कहते हैं उनकी"
    },
    {
      "subtitle_id": 217,
      "start": 447.319,
      "end": 451.0,
      "text": "बातें हमें माननी चाहिए और ज्यादा"
    },
    {
      "subtitle_id": 218,
      "start": 449.0,
      "end": 452.479,
      "text": "एक्सपेक्टेशन नहीं रखने चाहिए थोड़े बहुत"
    },
    {
      "subtitle_id": 219,
      "start": 451.0,
      "end": 454.039,
      "text": "जो भी लोगों के एक्सपेक्टशंस थे इस बार के"
    },
    {
      "subtitle_id": 220,
      "start": 452.479,
      "end": 456.28,
      "text": "बजट में मुझे लगता है अगले टाइम में वो भी"
    },
    {
      "subtitle_id": 221,
      "start": 454.039,
      "end": 458.44,
      "text": "लोग नहीं रखेंगे इस तरह का ओवरऑल ये बजट"
    },
    {
      "subtitle_id": 222,
      "start": 456.28,
      "end": 460.8,
      "text": "था ओवरऑल कुछ भी ऐसा नहीं था कि जिसकी हम"
    },
    {
      "subtitle_id": 223,
      "start": 458.44,
      "end": 462.479,
      "text": "सरा ना करें और जिसको अप्रिशिएट करें"
    },
    {
      "subtitle_id": 224,
      "start": 460.8,
      "end": 464.56,
      "text": "हालांकि ये कहा गया था कि ये जो बजट है"
    },
    {
      "subtitle_id": 225,
      "start": 462.479,
      "end": 466.319,
      "text": "अगले 5 साल की न्यू रखेगा लेकिन अगर न्यू"
    },
    {
      "subtitle_id": 226,
      "start": 464.56,
      "end": 469.24,
      "text": "ही कुछ इस तरह की है तो आई एम फीयरफुल कि"
    },
    {
      "subtitle_id": 227,
      "start": 466.319,
      "end": 473.68,
      "text": "अगले पाच सालों के बजट में क्या होगा सो"
    },
    {
      "subtitle_id": 228,
      "start": 469.24,
      "end": 473.68,
      "text": "आई मीन इट इज अप टू द पीपल"
    }
  ]
}