  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.16,
      "end": 4.56,
      "text": "वीडियो शुरू करने से पहले यह क्लिप जरूर"
    },
    {
      "subtitle_id": 2,
      "start": 2.12,
      "end": 8.0,
      "text": "देख लीजिए हाउसहोल्ड एंड कंज्यूमर्स हु"
    },
    {
      "subtitle_id": 3,
      "start": 4.56,
      "end": 10.12,
      "text": "ट्रेडिशनल लीन ऑन बैंक्स फॉर पार्किंग और"
    },
    {
      "subtitle_id": 4,
      "start": 8.0,
      "end": 12.559,
      "text": "इन्वेस्टिंग देयर सेविंग्स आर"
    },
    {
      "subtitle_id": 5,
      "start": 10.12,
      "end": 15.519,
      "text": "इंक्रीजिंगली टर्निंग टू कैपिटल मार्केट्स"
    },
    {
      "subtitle_id": 6,
      "start": 12.559,
      "end": 17.88,
      "text": "एंड अदर फाइनेंशियल इंटरमीडियरीज यह थे"
    },
    {
      "subtitle_id": 7,
      "start": 15.519,
      "end": 20.24,
      "text": "आरबीआई गवर्नर शक्तिकांता दास इनका कहना"
    },
    {
      "subtitle_id": 8,
      "start": 17.88,
      "end": 22.199,
      "text": "है कि रिसेंट ट्रेन को देखा जाए तो बहुत"
    },
    {
      "subtitle_id": 9,
      "start": 20.24,
      "end": 24.72,
      "text": "सारे लोग अपना पैसा सेविंग अकाउंट में"
    },
    {
      "subtitle_id": 10,
      "start": 22.199,
      "end": 26.96,
      "text": "नहीं रख रहे हैं फिर कहां रख रहे हैं वो"
    },
    {
      "subtitle_id": 11,
      "start": 24.72,
      "end": 28.359,
      "text": "रख रहे हैं म्यूचुअल फंड्स में इक्विटी"
    },
    {
      "subtitle_id": 12,
      "start": 26.96,
      "end": 30.56,
      "text": "में यानी शेयर मार्केट में और बाकी"
    },
    {
      "subtitle_id": 13,
      "start": 28.359,
      "end": 32.279,
      "text": "इन्वेस्टमेंट ऑप्शंस में तो गवर्नर साहब"
    },
    {
      "subtitle_id": 14,
      "start": 30.56,
      "end": 34.0,
      "text": "का कहना है कि इंडियन बैंक्स आर गोइंग"
    },
    {
      "subtitle_id": 15,
      "start": 32.279,
      "end": 35.879,
      "text": "थ्रू वन ऑफ द वर्स्ट क्रेडिट क्रंच ऑफ"
    },
    {
      "subtitle_id": 16,
      "start": 34.0,
      "end": 38.32,
      "text": "इंडियन हिस्ट्री पर वो ऐसा क्यों कह रहे"
    },
    {
      "subtitle_id": 17,
      "start": 35.879,
      "end": 40.12,
      "text": "हैं तो इसके चार रीजन है पहला इंडियन"
    },
    {
      "subtitle_id": 18,
      "start": 38.32,
      "end": 42.879,
      "text": "बैंक्स की जो डिपॉजिट ग्रोथ है वो बहुत"
    },
    {
      "subtitle_id": 19,
      "start": 40.12,
      "end": 44.879,
      "text": "स्लो चल रही है दूसरा जो इंडियन"
    },
    {
      "subtitle_id": 20,
      "start": 42.879,
      "end": 46.92,
      "text": "हाउसहोल्ड्स हैं उनका जो सेविंग रेट है ये"
    },
    {
      "subtitle_id": 21,
      "start": 44.879,
      "end": 49.16,
      "text": "ऑल टाइम लो पर चल रहा है यानी हमारी पहले"
    },
    {
      "subtitle_id": 22,
      "start": 46.92,
      "end": 51.199,
      "text": "की जनरेशन जिस तरह से पैसा सेव कर पाती थी"
    },
    {
      "subtitle_id": 23,
      "start": 49.16,
      "end": 53.199,
      "text": "उस तरह से हम पैसा सेव नहीं कर पा रहे हैं"
    },
    {
      "subtitle_id": 24,
      "start": 51.199,
      "end": 55.48,
      "text": "और इसलिए बैंक में भी नहीं रख पा रहे हैं"
    },
    {
      "subtitle_id": 25,
      "start": 53.199,
      "end": 58.519,
      "text": "तीसरा इंफ्लेशन बहुत तेजी से बढ़ रहा है"
    },
    {
      "subtitle_id": 26,
      "start": 55.48,
      "end": 60.719,
      "text": "और चौथा है लोन ग्रोथ बढ़ते ही जा रहा है"
    },
    {
      "subtitle_id": 27,
      "start": 58.519,
      "end": 62.48,
      "text": "मतलब लोगों के पास पैसा नहीं है क्योंकि"
    },
    {
      "subtitle_id": 28,
      "start": 60.719,
      "end": 64.159,
      "text": "सेविंग हैबिट्स नहीं है साथ ही इंफ्लेशन"
    },
    {
      "subtitle_id": 29,
      "start": 62.48,
      "end": 65.76,
      "text": "काफी ज्यादा है और जो भी पैसा लोगों के"
    },
    {
      "subtitle_id": 30,
      "start": 64.159,
      "end": 67.32,
      "text": "पास है वोह लोग बैंक में नहीं रख रहे हैं"
    },
    {
      "subtitle_id": 31,
      "start": 65.76,
      "end": 69.119,
      "text": "वो रख रहे हैं म्यूचुअल फंड्स में और"
    },
    {
      "subtitle_id": 32,
      "start": 67.32,
      "end": 71.32,
      "text": "इक्विटी में अब जो लोग इक्विटी में पैसा"
    },
    {
      "subtitle_id": 33,
      "start": 69.119,
      "end": 73.6,
      "text": "डाल भी रहे हैं सेबी के डाटा के अनुसार कई"
    },
    {
      "subtitle_id": 34,
      "start": 71.32,
      "end": 75.439,
      "text": "सारे बिगिनर्स वहां पर पैसा गवा रहे हैं"
    },
    {
      "subtitle_id": 35,
      "start": 73.6,
      "end": 77.4,
      "text": "क्योंकि उन्हें यह पता ही नहीं है कि किसे"
    },
    {
      "subtitle_id": 36,
      "start": 75.439,
      "end": 79.479,
      "text": "सही स्टॉक को या फिर सही कंपनी को कैसे"
    },
    {
      "subtitle_id": 37,
      "start": 77.4,
      "end": 81.84,
      "text": "चुनना है जिसकी वजह से वोह गलत स्टॉक्स"
    },
    {
      "subtitle_id": 38,
      "start": 79.479,
      "end": 83.96,
      "text": "चुन लेते हैं और अपना पैसा गवा बैठते हैं"
    },
    {
      "subtitle_id": 39,
      "start": 81.84,
      "end": 85.36,
      "text": "अब अगर आप इन सारी चीजों से बचने के लिए"
    },
    {
      "subtitle_id": 40,
      "start": 83.96,
      "end": 87.28,
      "text": "कंपनी के फंडामेंटल्स और कंपनी के"
    },
    {
      "subtitle_id": 41,
      "start": 85.36,
      "end": 89.64,
      "text": "वैल्युएशन को अच्छे से समझना चाहते हो"
    },
    {
      "subtitle_id": 42,
      "start": 87.28,
      "end": 91.96,
      "text": "सीखना चाहते हो तो मेरे पास आपके लिए बहुत"
    },
    {
      "subtitle_id": 43,
      "start": 89.64,
      "end": 93.799,
      "text": "बह बेहतरीन ऑफर है हर इंडिपेंडेंस डे हम"
    },
    {
      "subtitle_id": 44,
      "start": 91.96,
      "end": 95.92,
      "text": "फंडामेंटल एनालिसिस का कोर्स लॉन्च करते"
    },
    {
      "subtitle_id": 45,
      "start": 93.799,
      "end": 97.32,
      "text": "हैं बहुत ही स्पेशल प्राइस पर इस कोर्स"
    },
    {
      "subtitle_id": 46,
      "start": 95.92,
      "end": 99.28,
      "text": "में हम सिखाते हैं कि कैसे कंपनी के"
    },
    {
      "subtitle_id": 47,
      "start": 97.32,
      "end": 100.84,
      "text": "फंडामेंटल्स देखने हैं उसका फॉरेंसिक"
    },
    {
      "subtitle_id": 48,
      "start": 99.28,
      "end": 102.92,
      "text": "एनालिसिस करना है उसके बाद कंपनी का"
    },
    {
      "subtitle_id": 49,
      "start": 100.84,
      "end": 104.56,
      "text": "वैल्युएशन निकाल के यह पता करना है कि"
    },
    {
      "subtitle_id": 50,
      "start": 102.92,
      "end": 106.6,
      "text": "शेयर्स अंडर वैल्यूड है या फिर ओवर"
    },
    {
      "subtitle_id": 51,
      "start": 104.56,
      "end": 108.52,
      "text": "वैल्यूड इस पूरे कोर्स के बाद बड़े आसानी"
    },
    {
      "subtitle_id": 52,
      "start": 106.6,
      "end": 110.719,
      "text": "से आप ये सारी चीजें चुटकी में कर पाएंगे"
    },
    {
      "subtitle_id": 53,
      "start": 108.52,
      "end": 112.439,
      "text": "अगर आप बिगनर हैं तो भी तो अगर आपको स्टॉक"
    },
    {
      "subtitle_id": 54,
      "start": 110.719,
      "end": 114.36,
      "text": "सिलेक्शन की पूरी प्रोसेस स्टार्ट टू एंड"
    },
    {
      "subtitle_id": 55,
      "start": 112.439,
      "end": 116.36,
      "text": "समझनी है तो आप इस कोर्स में एनरोल कर"
    },
    {
      "subtitle_id": 56,
      "start": 114.36,
      "end": 118.68,
      "text": "सकते हैं जहां पर इस इंडिपेंडेंस डे हमारी"
    },
    {
      "subtitle_id": 57,
      "start": 116.36,
      "end": 122.039,
      "text": "फ्रीडम सेल ऑफर में आपको ये ₹ 77000 का"
    },
    {
      "subtitle_id": 58,
      "start": 118.68,
      "end": 124.439,
      "text": "कोर्स मिलेगा मात्र 22919 में विथ नॉट वन"
    },
    {
      "subtitle_id": 59,
      "start": 122.039,
      "end": 126.719,
      "text": "ईयर टू ईयर सीधे लाइफ टाइम वैलिडिटी के"
    },
    {
      "subtitle_id": 60,
      "start": 124.439,
      "end": 128.399,
      "text": "साथ अब ये जो प्राइस है यह प्रीलॉन्च ऑफर"
    },
    {
      "subtitle_id": 61,
      "start": 126.719,
      "end": 130.239,
      "text": "प्राइस है इस प्राइस में आपको ये कोर्स"
    },
    {
      "subtitle_id": 62,
      "start": 128.399,
      "end": 131.84,
      "text": "बाद में कभी नहीं मिलेगा सो डोंट मिस आउट"
    },
    {
      "subtitle_id": 63,
      "start": 130.239,
      "end": 134.04,
      "text": "ऑन दिस अपॉर्चुनिटी अगर आपको कंपनी के"
    },
    {
      "subtitle_id": 64,
      "start": 131.84,
      "end": 136.0,
      "text": "फंडामेंटल्स बहुत डिटेल में समझने हैं तो"
    },
    {
      "subtitle_id": 65,
      "start": 134.04,
      "end": 137.8,
      "text": "इस ऑफर के बस आखिरी तीन दिन बचे हैं तो"
    },
    {
      "subtitle_id": 66,
      "start": 136.0,
      "end": 139.72,
      "text": "ऑफर खत्म होने से पहले जरूर इसका फायदा"
    },
    {
      "subtitle_id": 67,
      "start": 137.8,
      "end": 141.8,
      "text": "लें तो इस हालत में बैंक्स का क्या होगा"
    },
    {
      "subtitle_id": 68,
      "start": 139.72,
      "end": 144.04,
      "text": "क्योंकि अगर आपको ज्यादा लोंस देने हैं तो"
    },
    {
      "subtitle_id": 69,
      "start": 141.8,
      "end": 146.599,
      "text": "ज्यादा डिपॉजिट्स आपके पास होने चाहिए अदर"
    },
    {
      "subtitle_id": 70,
      "start": 144.04,
      "end": 148.239,
      "text": "वाइज बैंक सरवाइव कैसे करेगी तो इसी चीज"
    },
    {
      "subtitle_id": 71,
      "start": 146.599,
      "end": 150.84,
      "text": "की डिटेल में बात करेंगे आज के इस वीडियो"
    },
    {
      "subtitle_id": 72,
      "start": 148.239,
      "end": 152.72,
      "text": "में कि क्या बैंक्स का लंच टाइम आ गया है"
    },
    {
      "subtitle_id": 73,
      "start": 150.84,
      "end": 155.04,
      "text": "या फिर समय रहते ही बैंक्स अपना बिजनेस"
    },
    {
      "subtitle_id": 74,
      "start": 152.72,
      "end": 157.44,
      "text": "मॉडल पीवॉट करेगी थोड़ा चेंज करेगी ताकि"
    },
    {
      "subtitle_id": 75,
      "start": 155.04,
      "end": 159.44,
      "text": "बदलती हुई दुनिया के साथ-साथ वह भी बदले"
    },
    {
      "subtitle_id": 76,
      "start": 157.44,
      "end": 161.4,
      "text": "नमस्कार मैं प्रसाद आपका आज के इस वीडियो"
    },
    {
      "subtitle_id": 77,
      "start": 159.44,
      "end": 163.4,
      "text": "में स्वागत करता हूं तो यह पूरा मामला"
    },
    {
      "subtitle_id": 78,
      "start": 161.4,
      "end": 165.48,
      "text": "समझने से पहले सबसे पहले हमें यह समझना"
    },
    {
      "subtitle_id": 79,
      "start": 163.4,
      "end": 167.879,
      "text": "पड़ेगा कि बैंक्स आखिर पैसा कमाती कैसे"
    },
    {
      "subtitle_id": 80,
      "start": 165.48,
      "end": 170.36,
      "text": "हैं तो वो पैसा कमाते हैं ऑन इंटरेस्ट"
    },
    {
      "subtitle_id": 81,
      "start": 167.879,
      "end": 172.36,
      "text": "स्प्रेड जिसे फाइनेंशियल लैंग्वेज में नेट"
    },
    {
      "subtitle_id": 82,
      "start": 170.36,
      "end": 174.12,
      "text": "इंटरेस्ट मार्जिन कहा जाता है तो ये नेट"
    },
    {
      "subtitle_id": 83,
      "start": 172.36,
      "end": 175.56,
      "text": "इंटरेस्ट मार्जिन क्या होता है तो नेट"
    },
    {
      "subtitle_id": 84,
      "start": 174.12,
      "end": 177.84,
      "text": "इंटरेस्ट मार्जिन को अगर आसान भाषा में"
    },
    {
      "subtitle_id": 85,
      "start": 175.56,
      "end": 179.4,
      "text": "समझे तो जो भी डिपॉजिट्स बैंक के पास आते"
    },
    {
      "subtitle_id": 86,
      "start": 177.84,
      "end": 181.2,
      "text": "हैं एफडी के फॉर्म में सेविंग अकाउंट के"
    },
    {
      "subtitle_id": 87,
      "start": 179.4,
      "end": 183.319,
      "text": "फॉर्म में उस पर बैंक को एक इंटरेस्ट देना"
    },
    {
      "subtitle_id": 88,
      "start": 181.2,
      "end": 185.4,
      "text": "पड़ता है उसी पैसों को यूज करके बैंक"
    },
    {
      "subtitle_id": 89,
      "start": 183.319,
      "end": 187.959,
      "text": "ज्यादा इंटरेस्ट पर लोगों को देगी पर्सनल"
    },
    {
      "subtitle_id": 90,
      "start": 185.4,
      "end": 189.84,
      "text": "लोन हाउसिंग लोन बाकी चीजों के लिए तो जिस"
    },
    {
      "subtitle_id": 91,
      "start": 187.959,
      "end": 192.0,
      "text": "इंटरेस्ट पे इन्होंने फंड्स रेज किया है"
    },
    {
      "subtitle_id": 92,
      "start": 189.84,
      "end": 194.2,
      "text": "बैंक्स ने और जिस इंटरेस्ट पे इन्होंने"
    },
    {
      "subtitle_id": 93,
      "start": 192.0,
      "end": 196.159,
      "text": "लोगों को लोन दिया है इसके बीच का डिफरेंस"
    },
    {
      "subtitle_id": 94,
      "start": 194.2,
      "end": 197.76,
