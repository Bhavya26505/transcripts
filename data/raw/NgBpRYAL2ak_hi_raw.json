  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.04,
      "end": 4.08,
      "text": "वीडियो शुरू करने से पहले भाईदूज की आप"
    },
    {
      "subtitle_id": 2,
      "start": 1.76,
      "end": 6.279,
      "text": "सभी को बहुत-बहुत शुभकामनाएं एक ऐसा आईपीओ"
    },
    {
      "subtitle_id": 3,
      "start": 4.08,
      "end": 8.32,
      "text": "आ रहा है जिसका इंतजार सभी को था लोग इस"
    },
    {
      "subtitle_id": 4,
      "start": 6.279,
      "end": 10.08,
      "text": "कंपनी के अनलिस्टेड शेयर्स पर ऐसे टूट"
    },
    {
      "subtitle_id": 5,
      "start": 8.32,
      "end": 11.799,
      "text": "पड़े कि उसके अनलिस्टेड शेयर्स मिलना भी"
    },
    {
      "subtitle_id": 6,
      "start": 10.08,
      "end": 13.719,
      "text": "मुश्किल हो गया था सिर्फ आम लोग ही नहीं"
    },
    {
      "subtitle_id": 7,
      "start": 11.799,
      "end": 15.519,
      "text": "बड़े-बड़े सेलिब्रिटीज जैसे अमिताभ बच्चन"
    },
    {
      "subtitle_id": 8,
      "start": 13.719,
      "end": 17.92,
      "text": "माधुरी दीक्षित क्रिकेटर्स लाइक राहुल"
    },
    {
      "subtitle_id": 9,
      "start": 15.519,
      "end": 19.64,
      "text": "द्रविड जहीर खान और कई सारे बिजनेसमैन भी"
    },
    {
      "subtitle_id": 10,
      "start": 17.92,
      "end": 21.56,
      "text": "इस आईपीओ के लिए एक्साइटेड हैं क्योंकि"
    },
    {
      "subtitle_id": 11,
      "start": 19.64,
      "end": 23.279,
      "text": "उन्होंने इस कंपनी के अनलिस्टेड शेयर्स"
    },
    {
      "subtitle_id": 12,
      "start": 21.56,
      "end": 24.76,
      "text": "अभी कुछ ही टाइम पहले खरीद लिए हैं पर लोग"
    },
    {
      "subtitle_id": 13,
      "start": 23.279,
      "end": 26.76,
      "text": "स्विगी के आईपीओ के बारे में इतने ज्यादा"
    },
    {
      "subtitle_id": 14,
      "start": 24.76,
      "end": 30.16,
      "text": "एक्साइटेड क्यों है तो बात कुछ यूं है कि"
    },
    {
      "subtitle_id": 15,
      "start": 26.76,
      "end": 32.359,
      "text": "2021 में इनके मार्केट शेयर के मामले में"
    },
    {
      "subtitle_id": 16,
      "start": 30.16,
      "end": 32.359,
      "text": "भाई"
    },
    {
      "subtitle_id": 17,
      "start": 60.239,
      "end": 63.76,
      "text": "और उसी चीज के बारे में आज हम डिटेल में"
    },
    {
      "subtitle_id": 18,
      "start": 62.0,
      "end": 65.36,
      "text": "बात करने वाले हैं इस वीडियो को मैंने तीन"
    },
    {
      "subtitle_id": 19,
      "start": 63.76,
      "end": 68.25,
      "text": "पार्ट में डिवाइड किया है पहले में मैं"
    },
    {
      "subtitle_id": 20,
      "start": 65.36,
      "end": 71.319,
      "text": "बात करूंगा स्विगी वर्सेस"
    },
    {
      "subtitle_id": 21,
      "start": 68.25,
      "end": 71.319,
      "text": "[संगीत]"
    },
    {
      "subtitle_id": 22,
      "start": 89.96,
      "end": 94.64,
      "text": "आप सभी को बताना चाहता हूं हमारे दिवाली"
    },
    {
      "subtitle_id": 23,
      "start": 91.92,
      "end": 96.479,
      "text": "कमो ऑफर के बस आखिरी 24 आवर्स बाकी है इस"
    },
    {
      "subtitle_id": 24,
      "start": 94.64,
      "end": 98.88,
      "text": "दिवाली हमारे शेयर मार्केट फाउंडेशन प्लस"
    },
    {
      "subtitle_id": 25,
      "start": 96.479,
      "end": 100.799,
      "text": "फंडामेंटल एनालिसिस 2.0 यह जो कॉन्बो है"
    },
    {
      "subtitle_id": 26,
      "start": 98.88,
      "end": 102.96,
      "text": "जिसमें हम शेयर मार्केट को एकदम बेसिक से"
    },
    {
      "subtitle_id": 27,
      "start": 100.799,
      "end": 104.719,
      "text": "एकदम एडवांस लेवल तक जहां पर आपको कंपनी"
    },
    {
      "subtitle_id": 28,
      "start": 102.96,
      "end": 106.32,
      "text": "का मैनेजमेंट एनालिसिस सीखने मिलता है"
    },
    {
      "subtitle_id": 29,
      "start": 104.719,
      "end": 108.32,
      "text": "कंपनी का वैल्युएशन यानी कंपनी अंडर"
    },
    {
      "subtitle_id": 30,
      "start": 106.32,
      "end": 110.6,
      "text": "वैल्यूड है या फिर ओवर वैल्यूड फॉरेंसिक"
    },
    {
      "subtitle_id": 31,
      "start": 108.32,
      "end": 112.799,
      "text": "एनालिसिस पल फार्मिंग अप्रोच ये सारी"
    },
    {
      "subtitle_id": 32,
      "start": 110.6,
      "end": 114.68,
      "text": "चीजें सीखने मिलती है तो यह जो कमो है वो"
    },
    {
      "subtitle_id": 33,
      "start": 112.799,
      "end": 116.2,
      "text": "आपको फ्लैट 50 पर से भी ज्यादा के"
    },
    {
      "subtitle_id": 34,
      "start": 114.68,
      "end": 118.399,
      "text": "डिस्काउंट में मिल रहा है और इसके अलावा"
    },
    {
      "subtitle_id": 35,
      "start": 116.2,
      "end": 120.56,
      "text": "आपको हमारा द बिग कमो जिसमें फाउंडेशन"
    },
    {
      "subtitle_id": 36,
      "start": 118.399,
      "end": 122.479,
      "text": "कोर्स फंडामेंटल एनालिसिस 2 ऑप्शंस"
    },
    {
      "subtitle_id": 37,
      "start": 120.56,
      "end": 124.6,
      "text": "ट्रेडिंग फॉर हेजिंग और एडवांस म्यूचुअल"
    },
    {
      "subtitle_id": 38,
      "start": 122.479,
      "end": 126.32,
      "text": "फंड ये चार कोर्सेस मिलते हैं ये दोनों भी"
    },
    {
      "subtitle_id": 39,
      "start": 124.6,
      "end": 128.399,
      "text": "कॉम्बोस आपको मिलते हैं विथ लाइफ टाइम"
    },
    {
      "subtitle_id": 40,
      "start": 126.32,
      "end": 130.36,
      "text": "एक्सेस एंड सर्टिफिकेट्स तो इस ऑफर को"
    },
    {
      "subtitle_id": 41,
      "start": 128.399,
      "end": 132.8,
      "text": "बिल्कुल भी मिस ना करें क्योंकि 24 आवर्स"
    },
    {
      "subtitle_id": 42,
      "start": 130.36,
      "end": 134.56,
      "text": "बाद इस प्राइस पर आपको कभी भी ये कॉम्बोस"
    },
    {
      "subtitle_id": 43,
      "start": 132.8,
      "end": 136.44,
      "text": "नहीं मिलेंगे सो डोंट मिस आउट ऑन दिस"
    },
    {
      "subtitle_id": 44,
      "start": 134.56,
      "end": 138.599,
      "text": "अपॉर्चुनिटी लिंक नीचे डिस्क्रिप्शन और"
    },
    {
      "subtitle_id": 45,
      "start": 136.44,
      "end": 140.72,
      "text": "कमेंट बॉक्स में दी गई है अभी के अभी जाइए"
    },
    {
      "subtitle_id": 46,
      "start": 138.599,
      "end": 142.44,
      "text": "24 आवर्स के अंदर ही आपको एक्सेस मिलेगा"
    },
    {
      "subtitle_id": 47,
      "start": 140.72,
      "end": 144.84,
      "text": "और तुरंत अपनी शेयर मार्केट जर्नी शुरू"
    },
    {
      "subtitle_id": 48,
      "start": 142.44,
      "end": 146.44,
      "text": "करे चलिए बढ़ते हैं वीडियो की तरफ s का"
    },
    {
      "subtitle_id": 49,
      "start": 144.84,
      "end": 149.92,
      "text": "आईओ जो अभी 6 तारीख को खुलने वाला है उसका"
    },
    {
      "subtitle_id": 50,
      "start": 146.44,
      "end": 151.239,
      "text": "प्राइस बैंड रखा गया है ₹ 3371 टू 90 इसका"
    },
    {
      "subtitle_id": 51,
      "start": 149.92,
      "end": 152.72,
      "text": "ग्रे मार्केट प्रीमियम लिस्टिंग एंड उसके"
    },
    {
      "subtitle_id": 52,
      "start": 151.239,
      "end": 154.92,
      "text": "बारे में आगे बात करेंगे तो शुरुआत करते"
    },
    {
      "subtitle_id": 53,
      "start": 152.72,
      "end": 156.4,
      "text": "हैं स्विगी के बिज़नेस मॉडल से तो स्विग"
    },
    {
      "subtitle_id": 54,
      "start": 154.92,
      "end": 158.28,
      "text": "के ऐप में अगर आप जाएंगे तो वहां पर आपको"
    },
    {
      "subtitle_id": 55,
      "start": 156.4,
      "end": 159.8,
      "text": "फूड डिलीवरी का ऑप्शन मिलता है डाइन आउट"
    },
    {
      "subtitle_id": 56,
      "start": 158.28,
      "end": 161.319,
      "text": "का ऑप्शन मिलता है यानी कि किसी"
    },
    {
      "subtitle_id": 57,
      "start": 159.8,
      "end": 163.04,
      "text": "रेस्टोरेंट में आपको रिजर्वेशन करवाना है"
    },
    {
      "subtitle_id": 58,
      "start": 161.319,
      "end": 164.92,
      "text": "तो स्विग ऐप से वो रिजर्वेशन कर सकते हो"
    },
    {
      "subtitle_id": 59,
      "start": 163.04,
      "end": 167.8,
      "text": "आपको उस पर डिस्काउंट मिलता है ये भी उनकी"
    },
    {
      "subtitle_id": 60,
      "start": 164.92,
      "end": 169.68,
      "text": "काफी अच्छी सर्विस है र् जो कि इनका क्विक"
    },
    {
      "subtitle_id": 61,
      "start": 167.8,
      "end": 171.28,
      "text": "कॉमर्स प्लेटफॉर्म है 10 मिनट में 15 मिनट"
    },
    {
      "subtitle_id": 62,
      "start": 169.68,
      "end": 173.879,
      "text": "में 20 मिनट में डिलीवर करने का काम करता"
    },
    {
      "subtitle_id": 63,
      "start": 171.28,
      "end": 175.879,
      "text": "है उसके बाद स्टेपिंग आउट इनका प्लेटफॉर्म"
    },
    {
      "subtitle_id": 64,
      "start": 173.879,
      "end": 177.519,
      "text": "है इवेंट बुकिंग्स के लिए जेनी इनका"
    },
    {
      "subtitle_id": 65,
      "start": 175.879,
      "end": 179.2,
      "text": "प्लेटफॉर्म है पिकअप एंड ड्रॉप सर्विसेस"
    },
    {
      "subtitle_id": 66,
      "start": 177.519,
      "end": 180.92,
      "text": "के लिए कुछ इंट्रासिटी कुरियर आपको देने"
    },
    {
      "subtitle_id": 67,
      "start": 179.2,
      "end": 182.68,
      "text": "हैं लेने हैं वो आप यहां पर कर सकते हो"
    },
    {
      "subtitle_id": 68,
      "start": 180.92,
      "end": 185.0,
      "text": "स्विगी मिनी इनका एक और प्रोडक्ट है और"
    },
    {
      "subtitle_id": 69,
      "start": 182.68,
      "end": 187.36,
      "text": "ऐसे कई सारे प्रोडक्ट्स जो हैं आपको एक ही"
    },
    {
      "subtitle_id": 70,
      "start": 185.0,
      "end": 188.959,
      "text": "ऐप के अंदर मिलते हैं जिसका नाम है स्विगी"
    },
    {
      "subtitle_id": 71,
      "start": 187.36,
      "end": 191.36,
      "text": "तो ये सारी चीजें सुनकर आपको लग रहा होगा"
    },
    {
      "subtitle_id": 72,
      "start": 188.959,
      "end": 191.36,
      "text": "यह तो बिल्कुल"
    },
    {
      "subtitle_id": 73,
      "start": 209.879,
      "end": 214.08,
      "text": "स्विग एक ऐसा ऐप है जो सुपर ऐप की तरह काम"
    },
    {
      "subtitle_id": 74,
      "start": 211.92,
      "end": 216.12,
      "text": "करता है यानी कि एक ही ऐप में आपको फूड"
    },
    {
      "subtitle_id": 75,
      "start": 214.08,
      "end": 217.519,
      "text": "डिलीवरी हो गया र् के जरिए क्विक कॉमर्स"
    },
    {
      "subtitle_id": 76,
      "start": 216.12,
      "end": 220.4,
      "text": "हो गया और बाकी चीजें एक ही ऐप में मिलती"
    },
    {
      "subtitle_id": 77,
      "start": 217.519,
      "end": 220.4,
      "text": "है वही"
    },
    {
      "subtitle_id": 78,
      "start": 239.799,
      "end": 242.92,
      "text": "फायदा ये है कि इनके जो डिलीवरी एंड"
    },
    {
      "subtitle_id": 79,
      "start": 241.36,
      "end": 244.56,
      "text": "रिलेटेड चार्जेस है वो यहां पर थोड़े बच"
    },
    {
      "subtitle_id": 80,
      "start": 242.92,
      "end": 246.799,
      "text": "जाते हैं अब स्विग के डिलीवरी चार्जेस"
    },
    {
      "subtitle_id": 81,
      "start": 244.56,
      "end": 249.239,
      "text": "इसलिए बच जाते हैं क्योंकि कई बार एक ही"
    },
    {
      "subtitle_id": 82,
      "start": 246.799,
      "end": 250.84,
      "text": "पर्सन आपको दोनों ऑर्डर्स डिलीवर करता है"
    },
    {
      "subtitle_id": 83,
      "start": 249.239,
      "end": 252.68,
      "text": "कि अगर सेम लोकेशन पर जाना है फूड भी"
    },
    {
      "subtitle_id": 84,
      "start": 250.84,
      "end": 255.72,
      "text": "ऑर्डर किया है बाकी चीजें भी ऑर्डर की है"
    },
    {
      "subtitle_id": 85,
      "start": 252.68,
      "end": 255.72,
      "text": "तो कई बार वो होता है लेकिन"
    },
    {
      "subtitle_id": 86,
      "start": 269.88,
      "end": 272.72,
      "text": "से ट्रीट किया जाता है"
    },
    {
      "subtitle_id": 87,
      "start": 299.68,
      "end": 302.6,
      "text": "चेक आउट करना चाहिए क्योंकि इन दोनों"
    },
    {
      "subtitle_id": 88,
      "start": 300.96,
      "end": 304.88,
      "text": "ब्रांड की सोशल मीडिया मार्केटिंग टीम को"
    },
    {
      "subtitle_id": 89,
      "start": 302.6,
      "end": 306.6,
      "text": "अच्छे से पता है कि जो ऑडियंस है वो है"
    },
    {
      "subtitle_id": 90,
      "start": 304.88,
      "end": 308.44,
      "text": "यंगस्टर्स और यंगस्टर्स आजकल अपना"
    },
    {
      "subtitle_id": 91,
      "start": 306.6,
      "end": 309.84,
      "text": "ज्यादातर टाइम सोशल मीडिया पर बिताते हैं"
    },
    {
      "subtitle_id": 92,
      "start": 308.44,
      "end": 311.32,
      "text": "वो ट्रेंडिंग चीजों को देखते और उन्हें"
    },
    {
      "subtitle_id": 93,
      "start": 309.84,
      "end": 314.68,
      "text": "फॉलो करते हैं और इनफ्लुएंसर से ज्यादा"
    },
    {
      "subtitle_id": 94,
      "start": 311.32,
      "end": 314.68,
      "text": "रिलेट कर पाते हैं और इसीलिए"
    },
    {
      "subtitle_id": 95,
      "start": 325.96,
      "end": 329.84,
      "text": "zeta-1 फिलहाल चल रही है तो उनके"
    },
    {
      "subtitle_id": 96,
