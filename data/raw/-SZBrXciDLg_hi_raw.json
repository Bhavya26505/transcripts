  "parsing_issues": [],
  "segments": [
    {
      "subtitle_id": 1,
      "start": 3.6,
      "end": 8.24,
      "text": "ट्रंप पूरी दुनिया को बना रहा है। पहले तो"
    },
    {
      "subtitle_id": 2,
      "start": 6.08,
      "end": 10.32,
      "text": "डॉनल्ड ट्रंप ने ईरान से अननेसेसरी पंगा"
    },
    {
      "subtitle_id": 3,
      "start": 8.24,
      "end": 12.16,
      "text": "लिया और पूरी दुनिया को एक इकोनमिक"
    },
    {
      "subtitle_id": 4,
      "start": 10.32,
      "end": 14.32,
      "text": "क्राइसिस में डाल दिया। पूरी दुनिया के"
    },
    {
      "subtitle_id": 5,
      "start": 12.16,
      "end": 16.56,
      "text": "स्टॉक मार्केट गिर गए। ऑयल के रूट्स बंद"
    },
    {
      "subtitle_id": 6,
      "start": 14.32,
      "end": 18.8,
      "text": "हो गए। ऑयल एंड एलएनजी क्राइसिस हो गया।"
    },
    {
      "subtitle_id": 7,
      "start": 16.56,
      "end": 20.56,
      "text": "फिर ईरान के पूरे सिविलाइजेशन को खत्म"
    },
    {
      "subtitle_id": 8,
      "start": 18.8,
      "end": 22.4,
      "text": "करने की धमकी देते हैं। कहते हैं कि अगर"
    },
    {
      "subtitle_id": 9,
      "start": 20.56,
      "end": 24.72,
      "text": "स्टेट ऑफ हॉर्मोंस को ईरान ने ओपन नहीं"
    },
    {
      "subtitle_id": 10,
      "start": 22.4,
      "end": 27.039,
      "text": "किया तो ईरान का हर पावर प्लांट और मेजर"
    },
    {
      "subtitle_id": 11,
      "start": 24.72,
      "end": 28.72,
      "text": "ब्रिज को बम से उड़ा देंगे। पूरी दुनिया"
    },
    {
      "subtitle_id": 12,
      "start": 27.039,
      "end": 31.519,
      "text": "एक पैनिकिक मोड में चली जाती है। क्रूड"
    },
    {
      "subtitle_id": 13,
      "start": 28.72,
      "end": 33.68,
      "text": "ऑयल 115 पर पहुंच जाता है। इंडियन मार्केट"
    },
    {
      "subtitle_id": 14,
      "start": 31.519,
      "end": 35.84,
      "text": "भी आज पूरी तैयारी में था कि आज खुलते ही"
    },
    {
      "subtitle_id": 15,
      "start": 33.68,
      "end": 38.48,
      "text": "मैं गिर जाऊं। लेकिन फिर तभी ट्रंप कुछ"
    },
    {
      "subtitle_id": 16,
      "start": 35.84,
      "end": 40.32,
      "text": "ऐसा करते हैं जो वह करते आए हैं। इंडियन"
    },
    {
      "subtitle_id": 17,
      "start": 38.48,
      "end": 42.719,
      "text": "टाइम के हिसाब से सुबह 5:00 बजे न्यूज़"
    },
    {
      "subtitle_id": 18,
      "start": 40.32,
      "end": 44.559,
      "text": "आती है कि वह ईरान को दो हफ्तों का और"
    },
    {
      "subtitle_id": 19,
      "start": 42.719,
      "end": 46.559,
      "text": "एक्सटेंशन देने वाले हैं। यह सब होने के"
    },
    {
      "subtitle_id": 20,
      "start": 44.559,
      "end": 48.719,
      "text": "बाद एक बात तो पर्सनली मेरे मन में क्लियर"
    },
    {
      "subtitle_id": 21,
      "start": 46.559,
      "end": 50.96,
      "text": "है कि डोन्ड ट्रंप मार्केट मैनिपुलेशन कर"
    },
    {
      "subtitle_id": 22,
      "start": 48.719,
      "end": 53.039,
      "text": "रहे हैं। यस, पास्ट में भी डोन्ड ट्रंप पर"
    },
    {
      "subtitle_id": 23,
      "start": 50.96,
      "end": 54.96,
      "text": "सीरियस मार्केट मैनपुलेशन और इंसाइडर"
    },
    {
      "subtitle_id": 24,
      "start": 53.039,
      "end": 56.96,
      "text": "ट्रेडिंग के आरोप लगे हैं। आरोप है कि खुद"
    },
    {
      "subtitle_id": 25,
      "start": 54.96,
      "end": 58.8,
      "text": "के और अपने फैमिली और बिजनेस फ्रेंड्स के"
    },
    {
      "subtitle_id": 26,
      "start": 56.96,
      "end": 60.8,
      "text": "फायदे के लिए पूरी दुनिया को उन्होंने"
    },
    {
      "subtitle_id": 27,
      "start": 58.8,
      "end": 62.32,
      "text": "क्राइसिस में डाला है। और आरोप ऐसे गंभीर"
    },
    {
      "subtitle_id": 28,
      "start": 60.8,
      "end": 64.159,
      "text": "है कि वह दोनों तरफ से मार्केट को"
    },
    {
      "subtitle_id": 29,
      "start": 62.32,
      "end": 65.92,
      "text": "मैनिपुलेट कर रहे हैं। पहले तो वह खुद"
    },
    {
      "subtitle_id": 30,
      "start": 64.159,
      "end": 68.0,
      "text": "क्राइसिस क्रिएट करते हैं और इनके जो"
    },
    {
      "subtitle_id": 31,
      "start": 65.92,
      "end": 70.4,
      "text": "इंसाइडर लोग हैं वह शॉर्ट करके मार्केट"
    },
    {
      "subtitle_id": 32,
      "start": 68.0,
      "end": 72.4,
      "text": "में पैसा बनाते हैं। शॉर्ट करना मतलब जब"
    },
    {
      "subtitle_id": 33,
      "start": 70.4,
      "end": 74.4,
      "text": "आपको लगता है कि मार्केट डाउन जाएगा तो"
    },
    {
      "subtitle_id": 34,
      "start": 72.4,
      "end": 76.4,
      "text": "उसके लिए शॉर्ट पोजीशन ली जाती है जिससे"
    },
    {
      "subtitle_id": 35,
      "start": 74.4,
      "end": 78.0,
      "text": "आप प्रॉफिट कमाते हो। यानी कि आपने शॉर्ट"
    },
    {
      "subtitle_id": 36,
      "start": 76.4,
      "end": 79.759,
      "text": "पोजीशन लेने के बाद जितना ज्यादा मार्केट"
    },
    {
      "subtitle_id": 37,
      "start": 78.0,
      "end": 81.68,
      "text": "या पर्टिकुलर स्टॉक गिरेगा उतना ज्यादा"
    },
    {
      "subtitle_id": 38,
      "start": 79.759,
      "end": 83.52,
      "text": "आपको फायदा मिलेगा। उसके बाद उनके स्टेप"
    },
    {
      "subtitle_id": 39,
      "start": 81.68,
      "end": 85.68,
      "text": "टू है कि क्राइसिस को ठीक करने का नाटक"
    },
    {
      "subtitle_id": 40,
      "start": 83.52,
      "end": 87.759,
      "text": "करो और फिर उनके इंसाइडर सर्कल के लोग"
    },
    {
      "subtitle_id": 41,
      "start": 85.68,
      "end": 89.28,
      "text": "मार्केट को लॉन्ग करके यहां पर पैसा कमाते"
    },
    {
      "subtitle_id": 42,
      "start": 87.759,
      "end": 90.96,
      "text": "हैं। देखिए यह वीडियो तो वैसे लास्ट वीक"
    },
    {
      "subtitle_id": 43,
      "start": 89.28,
      "end": 92.64,
      "text": "ही आने वाली थी लेकिन पिछले हफ्ते में"
    },
    {
      "subtitle_id": 44,
      "start": 90.96,
      "end": 94.4,
      "text": "दो-तीन बार मार्केट मैनपुलेशन जैसी"
    },
    {
      "subtitle_id": 45,
      "start": 92.64,
      "end": 96.24,
      "text": "सिचुएशनंस उन्होंने क्रिएट की है। इसीलिए"
    },
    {
      "subtitle_id": 46,
      "start": 94.4,
      "end": 98.159,
      "text": "सोचा कि इन सारी चीजों को कवर करना जरूरी"
    },
    {
      "subtitle_id": 47,
      "start": 96.24,
      "end": 99.92,
      "text": "है इसलिए आज इस वीडियो को हम ला रहे हैं।"
    },
    {
      "subtitle_id": 48,
      "start": 98.159,
      "end": 101.68,
      "text": "नमस्कार मैं प्रसाद आपका आज के इस वीडियो"
    },
    {
      "subtitle_id": 49,
      "start": 99.92,
      "end": 103.6,
      "text": "में स्वागत करता हूं। तो देखिए ईरान का यह"
    },
    {
      "subtitle_id": 50,
      "start": 101.68,
      "end": 105.28,
      "text": "जो इशू है यह काफी लंबे टाइम से चल रहा"
    },
    {
      "subtitle_id": 51,
      "start": 103.6,
      "end": 107.2,
      "text": "है। दुनिया के सारे मार्केट बहुत ज्यादा"
    },
    {
      "subtitle_id": 52,
      "start": 105.28,
      "end": 109.6,
      "text": "प्रेशर में थे। कोरिया जापान सब मार्केट"
    },
    {
      "subtitle_id": 53,
      "start": 107.2,
      "end": 111.52,
      "text": "10-15% गिरे हुए थे। इंडिया का मार्केट"
    },
    {
      "subtitle_id": 54,
      "start": 109.6,
      "end": 113.6,
      "text": "20th फरवरी से अब तक लगातार गिर रहा है।"
    },
    {
      "subtitle_id": 55,
      "start": 111.52,
      "end": 115.84,
      "text": "इंडिया का लार्ज कैप इंडेक्स अराउंड 12-3%"
    },
    {
      "subtitle_id": 56,
      "start": 113.6,
      "end": 118.479,
      "text": "गिर गया है। वहीं पर स्माल कैप इंडेक्स 18"
    },
    {
      "subtitle_id": 57,
      "start": 115.84,
      "end": 120.159,
      "text": "से 20% तक गिर गया था। लाखों करोड़ों रुपए"
    },
    {
      "subtitle_id": 58,
      "start": 118.479,
      "end": 122.799,
      "text": "मार्केट से स्वाहा हो गए और उसके पीछे का"
    },
    {
      "subtitle_id": 59,
      "start": 120.159,
      "end": 125.04,
      "text": "कारण यह आदमी। जब से आदमी आया है दुनिया"
    },
    {
      "subtitle_id": 60,
      "start": 122.799,
      "end": 126.88,
      "text": "की इकॉनमी को शॉक पर शॉक दिए जा रहा है।"
    },
    {
      "subtitle_id": 61,
      "start": 125.04,
      "end": 128.72,
      "text": "शुरुआत हुई टेररिफ से फिर किसी भी कंट्री"
    },
    {
      "subtitle_id": 62,
      "start": 126.88,
      "end": 131.2,
      "text": "पर अटैक करने की बातें होने लगी और फिर"
    },
    {
      "subtitle_id": 63,
      "start": 128.72,
      "end": 133.04,
      "text": "कभी बेवजह वॉर शुरू करना। अब यहां पर आम"
    },
    {
      "subtitle_id": 64,
      "start": 131.2,
      "end": 134.959,
      "text": "जो लोग हैं उनको यह लगता है कि ट्रंप यह"
    },
    {
      "subtitle_id": 65,
      "start": 133.04,
      "end": 136.64,
      "text": "सन के आदमी है। लेकिन उससे पहले आपको एक"
    },
    {
      "subtitle_id": 66,
      "start": 134.959,
      "end": 138.48,
      "text": "चीज बताना चाहता हूं कि ट्रंप प्रेसिडेंट"
    },
    {
      "subtitle_id": 67,
      "start": 136.64,
      "end": 140.48,
      "text": "होने से पहले एक बिजनेसमैन रह चुके हैं और"
    },
    {
      "subtitle_id": 68,
      "start": 138.48,
      "end": 142.72,
      "text": "वो भी ऐसे वैसे नहीं बल्कि बहुत ही ज्यादा"
    },
    {
      "subtitle_id": 69,
      "start": 140.48,
      "end": 144.64,
      "text": "कंट्रोवर्शियल। इनफैक्ट आपको पता ही होगा"
    },
    {
      "subtitle_id": 70,
      "start": 142.72,
      "end": 146.72,
      "text": "कि डॉन्ड ट्रंप ने अपने बिजनेस करियर में"
    },
    {
      "subtitle_id": 71,
      "start": 144.64,
      "end": 148.4,
      "text": "छह बार बैंकरप्स फाइल की है। यानी छह बार"
    },
    {
      "subtitle_id": 72,
      "start": 146.72,
      "end": 149.92,
      "text": "उन्होंने दिवालिया घोषित किया है। अब यहां"
    },
    {
      "subtitle_id": 73,
      "start": 148.4,
      "end": 152.16,
      "text": "पर सोचने वाली बात यह है कि उसमें से एक"
    },
    {
      "subtitle_id": 74,
      "start": 149.92,
      "end": 154.319,
      "text": "बिजनेस कसीनो का था और कसीनो का बिज़नेस"
    },
    {
      "subtitle_id": 75,
      "start": 152.16,
      "end": 156.4,
      "text": "बैंककरप्ट करना यह भी आप समझ लीजिए हुनर"
    },
    {
      "subtitle_id": 76,
      "start": 154.319,
      "end": 158.08,
      "text": "ही है। लेकिन छह बार बैंकरप्सी घोषित करने"
    },
    {
      "subtitle_id": 77,
      "start": 156.4,
      "end": 161.44,
      "text": "के बावजूद आज डॉनल्ड ट्रंप की जो नेटवर्थ"
    },
    {
      "subtitle_id": 78,
      "start": 158.08,
      "end": 163.92,
      "text": "है वो 6.5 बिलियन है। यानी कि लगभग $600"
    },
    {
      "subtitle_id": 79,
      "start": 161.44,
      "end": 165.76,
      "text": "करोड़ की। तो ऐसा कैसे हुआ? देखिए भले ही"
    },
    {
      "subtitle_id": 80,
      "start": 163.92,
      "end": 167.76,
      "text": "डोनाल्ड ट्रंप बिजनेसमैन अच्छे ना हो"
    },
    {
      "subtitle_id": 81,
      "start": 165.76,
      "end": 169.28,
      "text": "लेकिन वह एक अच्छे मनीपुलेटर जरूर हैं।"
    },
    {
      "subtitle_id": 82,
      "start": 167.76,
      "end": 171.36,
      "text": "उन्हें पता है कि सिस्टम को कैसे अपने"
    },
    {
      "subtitle_id": 83,
      "start": 169.28,
      "end": 173.2,
      "text": "फेवर में यूज करना है। यूएस के बैंककरप्सी"
    },
    {
      "subtitle_id": 84,
      "start": 171.36,
      "end": 175.04,
      "text": "लॉज़ में लूप होल निकाल के उन्होंने ऐसा"
    },
    {
      "subtitle_id": 85,
      "start": 173.2,
      "end": 176.72,
      "text": "खेल रचा कि उनकी बहुत सारी कंपनीज़"
    },
    {
      "subtitle_id": 86,
      "start": 175.04,
      "end": 178.48,
      "text": "बैंककरप्ट तो हो गई पर ट्रंप कभी खुद"
    },
    {
      "subtitle_id": 87,
      "start": 176.72,
      "end": 180.16,
      "text": "बैंकरप्ट नहीं हुए और प्रेसिडेंट होने के"
    },
    {
      "subtitle_id": 88,
      "start": 178.48,
      "end": 182.0,
      "text": "बाद भी उन्होंने अपनी इस एक हैबिट को नहीं"
    },
    {
      "subtitle_id": 89,
      "start": 180.16,
      "end": 184.0,
      "text": "बदला कि पहले वो बैंकरप्ट्स लॉ को"
    },
    {
      "subtitle_id": 90,
      "start": 182.0,
      "end": 185.76,
      "text": "मैनपुलेट करते थे। आज वो मार्केट को"
    },
    {
      "subtitle_id": 91,
      "start": 184.0,
      "end": 187.599,
      "text": "मैनपुलेट करते हैं। और यह मैं ऐसे नहीं कह"
    },
    {
      "subtitle_id": 92,
      "start": 185.76,
      "end": 189.76,
      "text": "रहा कुछ प्रूफ्स के साथ अभी आपको समझाता"
    },
    {
      "subtitle_id": 93,
      "start": 187.599,
      "end": 191.68,
      "text": "हूं। आगे बढ़ने से पहले आपसे एक जरूरी बात"
    },
    {
      "subtitle_id": 94,
      "start": 189.76,
