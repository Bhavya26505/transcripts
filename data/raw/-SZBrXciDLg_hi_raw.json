    {
      "subtitle_id": 178,
      "start": 358.96,
      "end": 362.8,
      "text": "लास्ट के पांच दिन का जो एवरेज वॉल्यूम"
    },
    {
      "subtitle_id": 179,
      "start": 360.639,
      "end": 365.28,
      "text": "देखा जाए तो वह सिर्फ 700 कॉन्ट्रैक्ट्स"
    },
    {
      "subtitle_id": 180,
      "start": 362.8,
      "end": 367.759,
      "text": "के एवरेज का था। अब यहां पर 700 से ट्रंप"
    },
    {
      "subtitle_id": 181,
      "start": 365.28,
      "end": 369.6,
      "text": "की पोस्ट से पहले सीधा 6200 का जंप यहां"
    },
    {
      "subtitle_id": 182,
      "start": 367.759,
      "end": 371.919,
      "text": "पर देखने मिला जो कि एवरेज वॉल्यूम से"
