  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.199,
      "end": 4.319,
      "text": "स्कैम का अमाउंट इतना बड़ा है कि अगर आप"
    },
    {
      "subtitle_id": 2,
      "start": 2.12,
      "end": 7.08,
      "text": "इसे कैलकुलेटर पर टाइप करेंगे तो एरर"
    },
    {
      "subtitle_id": 3,
      "start": 4.319,
      "end": 10.16,
      "text": "दिखाएगा इस स्कैम का साइज इतना बड़ा है कि"
    },
    {
      "subtitle_id": 4,
      "start": 7.08,
      "end": 12.32,
      "text": "इसके सामने सत्यम स्कैम 2g स्कैम कोल"
    },
    {
      "subtitle_id": 5,
      "start": 10.16,
      "end": 14.44,
      "text": "स्कैम भी यह सुनने पर मजबूर हो जाएंगे"
    },
    {
      "subtitle_id": 6,
      "start": 12.32,
      "end": 16.32,
      "text": "छोटी बच्ची हो क्या यह स्कैम हुआ है"
    },
    {
      "subtitle_id": 7,
      "start": 14.44,
      "end": 18.199,
      "text": "वियतनाम में जहां पर एक प्रॉपर्टी डेवलपर"
    },
    {
      "subtitle_id": 8,
      "start": 16.32,
      "end": 20.76,
      "text": "ने ये स्कैम किया है तो इस स्कैम का साइज"
    },
    {
      "subtitle_id": 9,
      "start": 18.199,
      "end": 20.76,
      "text": "कितना है"
    },
    {
      "subtitle_id": 10,
      "start": 21.96,
      "end": 26.76,
      "text": "21600 इतना नहीं एक और जीरो और उसके सामने"
    },
    {
      "subtitle_id": 11,
      "start": 24.92,
      "end": 28.359,
      "text": "एक और रो लगा दीजिए और उसके सामने एक और"
    },
    {
      "subtitle_id": 12,
      "start": 26.76,
      "end": 31.359,
      "text": "जीरो कुल मिलाकर"
    },
    {
      "subtitle_id": 13,
      "start": 28.359,
      "end": 33.36,
      "text": "216000 करोड़ का ये स्म है 216000 करोड़"
    },
    {
      "subtitle_id": 14,
      "start": 31.359,
      "end": 35.559,
      "text": "का देखिए मैं पिछले 7 साल से वीडियोस बना"
    },
    {
      "subtitle_id": 15,
      "start": 33.36,
      "end": 37.48,
      "text": "रहा हूं लेकिन इतने बड़े वॉल्यूम का इतने"
    },
    {
      "subtitle_id": 16,
      "start": 35.559,
      "end": 40.36,
      "text": "बड़े अमाउंट का स्कैम मैंने पहली बार देखा"
    },
    {
      "subtitle_id": 17,
      "start": 37.48,
      "end": 41.96,
      "text": "है जो प्रूव हो गया है और सिर्फ स्कैम का"
    },
    {
      "subtitle_id": 18,
      "start": 40.36,
      "end": 43.84,
      "text": "साइज ही नहीं इसकी स्टोरी भी इतनी ज्यादा"
    },
    {
      "subtitle_id": 19,
      "start": 41.96,
      "end": 45.96,
      "text": "इंटरेस्टिंग है कि कोई भी बड़े आसानी से"
    },
    {
      "subtitle_id": 20,
      "start": 43.84,
      "end": 47.559,
      "text": "दो ढाई घंटे की मूवी इस पर बना सकता है"
    },
    {
      "subtitle_id": 21,
      "start": 45.96,
      "end": 49.8,
      "text": "लेकिन अगले कुछ ही मिनटों में मैं आपको"
    },
    {
      "subtitle_id": 22,
      "start": 47.559,
      "end": 52.16,
      "text": "डिटेल में इस स्टोरी को बताने वाला हूं तो"
    },
    {
      "subtitle_id": 23,
      "start": 49.8,
      "end": 54.12,
      "text": "एंड तक जरूर देखिए नमस्कार मैं प्रसाद"
    },
    {
      "subtitle_id": 24,
      "start": 52.16,
      "end": 55.92,
      "text": "आपका आज के इस वीडियो में स्वागत करता हूं"
    },
    {
      "subtitle_id": 25,
      "start": 54.12,
      "end": 58.079,
      "text": "तो इस प्रॉपर्टी डेवलपर का नाम है ट्राउ"
    },
    {
      "subtitle_id": 26,
      "start": 55.92,
      "end": 60.16,
      "text": "मिलान और ट्राउ मिलान का जो जन्म है वो"
    },
    {
      "subtitle_id": 27,
      "start": 58.079,
      "end": 62.0,
      "text": "वियतनाम के एक सिटी होची मिन में हु हुआ"
    },
    {
      "subtitle_id": 28,
      "start": 60.16,
      "end": 64.159,
      "text": "था जिसका पहला नाम इस सिटी का जो पहला नाम"
    },
    {
      "subtitle_id": 29,
      "start": 62.0,
      "end": 66.64,
      "text": "था वो था साइ गॉन उस टाइम की अगर मैं बात"
    },
    {
      "subtitle_id": 30,
      "start": 64.159,
      "end": 68.68,
      "text": "करूं तो वियतनाम एक बहुत गरीब कंट्री हुआ"
    },
    {
      "subtitle_id": 31,
      "start": 66.64,
      "end": 70.32,
      "text": "करती थी अभी भी उतनी ज्यादा मतलब डेवलप"
    },
    {
      "subtitle_id": 32,
      "start": 68.68,
      "end": 73.159,
      "text": "नहीं हुई है लेकिन काफी बेटर हुई है"
    },
    {
      "subtitle_id": 33,
      "start": 70.32,
      "end": 75.439,
      "text": "कंपेयर्ड टू 80 से उस टाइम लान की जो"
    },
    {
      "subtitle_id": 34,
      "start": 73.159,
      "end": 77.479,
      "text": "फैमिली थी वो भी काफी गरीब थी उसकी मां"
    },
    {
      "subtitle_id": 35,
      "start": 75.439,
      "end": 79.52,
      "text": "चाय का स्टॉल चलाती थी और लान भी वहां पर"
    },
    {
      "subtitle_id": 36,
      "start": 77.479,
      "end": 80.88,
      "text": "जाकर चाय बेजती थी अपनी मां को मदद करती"
    },
    {
      "subtitle_id": 37,
      "start": 79.52,
      "end": 82.32,
      "text": "थी और वहां पर अपने कुछ कॉस्मेटिक"
    },
    {
      "subtitle_id": 38,
      "start": 80.88,
      "end": 84.36,
      "text": "प्रोडक्ट भी बेचती थी पहले से ही वो"
    },
    {
      "subtitle_id": 39,
      "start": 82.32,
      "end": 86.2,
      "text": "इंटेलिजेंट थी बिजनेस सेंस अच्छा था और"
    },
    {
      "subtitle_id": 40,
      "start": 84.36,
      "end": 88.479,
      "text": "वहां पर अच्छे खासे कॉस्मेटिक्स भी वो"
    },
    {
      "subtitle_id": 41,
      "start": 86.2,
      "end": 91.0,
      "text": "बेचा करती थी ताकि उनकी फैमिली दो वक्त की"
    },
    {
      "subtitle_id": 42,
      "start": 88.479,
      "end": 92.88,
      "text": "रोटी खा पाए बात है 19 1980 की ज्यादातर"
    },
    {
      "subtitle_id": 43,
      "start": 91.0,
      "end": 94.799,
      "text": "जो रियल एस्टेट वहां पर थी इट वाज"
    },
    {
      "subtitle_id": 44,
      "start": 92.88,
      "end": 96.479,
      "text": "कंट्रोल्ड बाय गवर्नमेंट प्राइवेट कंपनीज"
    },
    {
      "subtitle_id": 45,
      "start": 94.799,
      "end": 98.68,
      "text": "को अलाव नहीं था कि वो जाकर वहां पर"
    },
    {
      "subtitle_id": 46,
      "start": 96.479,
      "end": 100.119,
      "text": "प्रॉपर्टीज खरीद सके गवर्नमेंट बदल गई"
    },
    {
      "subtitle_id": 47,
      "start": 98.68,
      "end": 102.52,
      "text": "लेकिन गवर्नमेंट ने आगे चलकर कुछ"
    },
    {
      "subtitle_id": 48,
      "start": 100.119,
      "end": 105.159,
      "text": "रिफॉर्म्स लाए रिफॉर्म्स क्या थे कि अब"
    },
    {
      "subtitle_id": 49,
      "start": 102.52,
      "end": 107.799,
      "text": "कोई भी प्राइवेट कंपनी लैंड ले सकती है"
    },
    {
      "subtitle_id": 50,
      "start": 105.159,
      "end": 110.159,
      "text": "लोग भी वो लैंड परचेस कर सकते हैं और इसके"
    },
    {
      "subtitle_id": 51,
      "start": 107.799,
      "end": 112.399,
      "text": "साथ कुछ बैंकिंग रिफॉर्म्स भी आए जहां पर"
    },
    {
      "subtitle_id": 52,
      "start": 110.159,
      "end": 113.96,
      "text": "बैंक भी आसानी से कंपनीज को और"
    },
    {
      "subtitle_id": 53,
      "start": 112.399,
      "end": 116.2,
      "text": "इंडिविजुअल्स को लोन देगी ताकि वो"
    },
    {
      "subtitle_id": 54,
      "start": 113.96,
      "end": 118.479,
      "text": "प्रॉपर्टीज खरीद पाए अब इसकी वजह से अचानक"
    },
    {
      "subtitle_id": 55,
      "start": 116.2,
      "end": 121.28,
      "text": "जहां पर रियल एस्टेट में जाने को सबको मना"
    },
    {
      "subtitle_id": 56,
      "start": 118.479,
      "end": 123.2,
      "text": "था अचानक से ओपन हो गया गेट भीड़ बढ़ गई"
    },
    {
      "subtitle_id": 57,
      "start": 121.28,
      "end": 124.719,
      "text": "लोग तेजी से वहां पर जाने लगे डिमांड बहुत"
    },
    {
      "subtitle_id": 58,
      "start": 123.2,
      "end": 126.52,
      "text": "ज्यादा बढ़ गई जिसकी वजह से प्राइसेस बहुत"
    },
    {
      "subtitle_id": 59,
      "start": 124.719,
      "end": 128.319,
      "text": "तेजी से बढ़ रही थी वियतनाम में करप्शन"
    },
    {
      "subtitle_id": 60,
      "start": 126.52,
      "end": 130.08,
      "text": "लंबे टाइम से बहुत ज्यादा चल रही थी तो"
    },
    {
      "subtitle_id": 61,
      "start": 128.319,
      "end": 131.84,
      "text": "लोगों ने एक सलूशन निकाला सलूशन ये था कि"
    },
    {
      "subtitle_id": 62,
      "start": 130.08,
      "end": 133.68,
      "text": "बैंक के जो लोग हैं एग्जीक्यूटिव्स हैं"
    },
    {
      "subtitle_id": 63,
      "start": 131.84,
      "end": 136.12,
      "text": "काम करने वाले लोग हैं उनको हम कुछ घुस"
    },
    {
      "subtitle_id": 64,
      "start": 133.68,
      "end": 138.239,
      "text": "देते हैं ब्राइब देते हैं और उनसे फिर लोन"
    },
    {
      "subtitle_id": 65,
      "start": 136.12,
      "end": 140.599,
      "text": "हम पास करवा लेते हैं फिर उस लोन से हम"
    },
    {
      "subtitle_id": 66,
      "start": 138.239,
      "end": 142.36,
      "text": "लैंड ले लेते हैं उस लैंड को फिर जैसे"
    },
    {
      "subtitle_id": 67,
      "start": 140.599,
      "end": 144.44,
      "text": "क्योंकि प्राइसेस बहुत तेजी से बढ़ रही है"
    },
    {
      "subtitle_id": 68,
      "start": 142.36,
      "end": 146.68,
      "text": "तो ज्यादा प्राइस पर बेचकर लोन का पैसा"
    },
    {
      "subtitle_id": 69,
      "start": 144.44,
      "end": 148.36,
      "text": "चुका करर अपना पैसा बना लेंगे और यह बहुत"
    },
    {
      "subtitle_id": 70,
      "start": 146.68,
      "end": 150.44,
      "text": "सारे लोग कर रहे थे और उससे बहुत सारा"
    },
    {
      "subtitle_id": 71,
      "start": 148.36,
      "end": 153.4,
      "text": "पैसा भी कमा रहे थे उसमें से एक थी ट्रंग"
    },
    {
      "subtitle_id": 72,
      "start": 150.44,
      "end": 155.2,
      "text": "मलान उन्होंने भी इस पूरे जो बबल था उससे"
    },
    {
      "subtitle_id": 73,
      "start": 153.4,
      "end": 157.2,
      "text": "बहुत ज्यादा पैसा कमा लिया रियल एस्टेट"
    },
    {
      "subtitle_id": 74,
      "start": 155.2,
      "end": 159.04,
      "text": "में और लान ने इतना पैसा तो कमा लिया था"
    },
    {
      "subtitle_id": 75,
      "start": 157.2,
      "end": 161.8,
      "text": "कि एक खुशहाल जिंदगी एक अच्छी लाइफस्टाइल"
    },
    {
      "subtitle_id": 76,
      "start": 159.04,
      "end": 164.36,
      "text": "वो जी पाए लेकिन लान को बनना था और ज्यादा"
    },
    {
      "subtitle_id": 77,
      "start": 161.8,
      "end": 166.36,
      "text": "अमीर और इसीलिए लान ने सोचा कि ये जो करंट"
    },
    {
      "subtitle_id": 78,
      "start": 164.36,
      "end": 168.239,
      "text": "मॉडल है ये स्केलेबल नहीं है मतलब क्या है"
    },
    {
      "subtitle_id": 79,
      "start": 166.36,
      "end": 170.319,
      "text": "कि आप घुस दे रहे हो आपका कमीशन गया"
    },
    {
      "subtitle_id": 80,
      "start": 168.239,
      "end": 171.879,
      "text": "इंटरेस्ट पर लोन ले रहे हो लोन से मार्जिन"
    },
    {
      "subtitle_id": 81,
      "start": 170.319,
      "end": 173.959,
      "text": "कमा रहे हो थोड़ी बहुत तो इसमें बहुत सारे"
    },
    {
      "subtitle_id": 82,
      "start": 171.879,
      "end": 175.64,
      "text": "हर्डल हैं ज्यादा इंटरेस्ट भी देना है ऊपर"
    },
    {
      "subtitle_id": 83,
      "start": 173.959,
      "end": 177.48,
      "text": "से घुस भी देनी है तो हमारे लिए क्या"
    },
    {
      "subtitle_id": 84,
      "start": 175.64,
      "end": 179.44,
      "text": "बचेगा तो इसलिए लान ने सोचे कि इसका"
    },
    {
      "subtitle_id": 85,
      "start": 177.48,
      "end": 181.44,
      "text": "स्केलेबल मॉडल क्या हो सकता है आप बताइए"
    },
    {
      "subtitle_id": 86,
      "start": 179.44,
      "end": 184.159,
      "text": "अगर आप लान की जगह होते तो इसका स्केलेबल"
    },
    {
      "subtitle_id": 87,
      "start": 181.44,
      "end": 185.92,
      "text": "मॉडल क्या होता शायद आप बैंक के और जो ऊपर"
    },
    {
      "subtitle_id": 88,
      "start": 184.159,
      "end": 187.56,
      "text": "वाले एग्जीक्यूटिव्स हैं उनके पास रीच आउट"
    },
    {
      "subtitle_id": 89,
      "start": 185.92,
      "end": 189.239,
      "text": "करते कि ज्यादा लोन मुझे दो ताकि मैं"
    },
    {
      "subtitle_id": 90,
      "start": 187.56,
      "end": 191.159,
      "text": "ज्यादा प्रॉपर्टीज खरीदो और अपने बिजनेस"
    },
    {
      "subtitle_id": 91,
      "start": 189.239,
      "end": 193.12,
      "text": "को या फिर जो ये जो प्रोसेस है इसको मैं"
    },
    {
      "subtitle_id": 92,
      "start": 191.159,
      "end": 195.44,
      "text": "और बढ़ा सकूं शायद आप पॉलिटिशियन के पास"
    },
    {
      "subtitle_id": 93,
      "start": 193.12,
      "end": 197.44,
      "text": "चले जाते कि वो आपको बड़ा लोन देंगे फिर"
    },
    {
      "subtitle_id": 94,
      "start": 195.44,
      "end": 199.159,
      "text": "आप बड़ी प्रॉपर्टीज खरीद सकते हैं ऐसे कुछ"
    },
    {
      "subtitle_id": 95,
      "start": 197.44,
      "end": 201.0,
      "text": "तीन-चार सलूशन हमारे दिमाग में आते हैं"
    },
    {
      "subtitle_id": 96,
      "start": 199.159,
      "end": 203.48,
      "text": "लेकिन लान का दिमाग कुछ अलग ही लेवल का चल"
    },
    {
      "subtitle_id": 97,
      "start": 201.0,
      "end": 205.44,
      "text": "रहा था लान मतलब क्रेजी थी लान ने सोचा कि"
    },
    {
      "subtitle_id": 98,
      "start": 203.48,
      "end": 207.64,
      "text": "क्यों ना मैं बैंक ही बना लू अपनी अब बैंक"
    },
    {
      "subtitle_id": 99,
      "start": 205.44,
      "end": 209.36,
      "text": "अपनी होगी तो घुस देने की जरूरत नहीं है"
    },
    {
      "subtitle_id": 100,
      "start": 207.64,
      "end": 211.92,
      "text": "जितना पैसा चाहिए उतना ले सकती हो कम"
    },
    {
      "subtitle_id": 101,
      "start": 209.36,
      "end": 213.92,
      "text": "इंटरेस्ट पे ले सकती हू तो उससे बिजनेस"
    },
    {
      "subtitle_id": 102,
      "start": 211.92,
      "end": 215.56,
      "text": "मेरा स्केल भी होगा और मुझे ज्यादा पैसा"
    },
    {
      "subtitle_id": 103,
      "start": 213.92,
      "end": 217.319,
      "text": "देने की जरूरत नहीं मेरी मार्जिन बिजनेस"
    },
    {
      "subtitle_id": 104,
      "start": 215.56,
      "end": 219.4,
      "text": "मार्जिन भी बढ़ जाएगी तो लान ने क्या किया"
    },
    {
      "subtitle_id": 105,
      "start": 217.319,
      "end": 221.56,
      "text": "तीन छोटी बैंक्स को एक्वायर किया और उसका"
    },
    {
      "subtitle_id": 106,
      "start": 219.4,
      "end": 224.159,
      "text": "मिलाकर एक बैंक बना दी बड़ी बैंक जिसका"
    },
    {
      "subtitle_id": 107,
      "start": 221.56,
      "end": 225.959,
      "text": "नाम था सगन कमर्शियल बैंक एससीबी वीडियो"
    },
    {
      "subtitle_id": 108,
      "start": 224.159,
      "end": 228.4,
      "text": "में आगे बढ़ने से पहले आपको एक शॉकिंग चीज"
    },
    {
      "subtitle_id": 109,
      "start": 225.959,
      "end": 230.239,
      "text": "बताना चाहता हूं कि आईआरडीएआई जो कि"
    },
    {
      "subtitle_id": 110,
      "start": 228.4,
      "end": 231.959,
      "text": "इंडिया की इंश्योरेंस रेगुलेटरी बॉडी है"
    },
    {
      "subtitle_id": 111,
      "start": 230.239,
      "end": 233.92,
      "text": "उसने एक डेटा पब्लिश किया है डेटा बहुत"
    },
    {
      "subtitle_id": 112,
      "start": 231.959,
      "end": 236.68,
      "text": "शॉकिंग है और वो यह है कि इंडिया के सिर्फ"
    },
    {
      "subtitle_id": 113,
      "start": 233.92,
      "end": 239.159,
      "text": "4.2 पर लोगों के पास इंश्योरेंस है अब"
    },
    {
      "subtitle_id": 114,
      "start": 236.68,
      "end": 241.2,
      "text": "देखिए दो इंश्योरेंस ऐसे हैं जो आप सभी को"
    },
    {
      "subtitle_id": 115,
      "start": 239.159,
      "end": 242.84,
      "text": "लेने चाहिए एक हेल्थ इंश्योरेंस और दूसरा"
    },
    {
      "subtitle_id": 116,
      "start": 241.2,
      "end": 245.0,
      "text": "प्लेन टर्म इंश्योरेंस क्योंकि लाइफ में"
    },
    {
      "subtitle_id": 117,
      "start": 242.84,
      "end": 246.84,
      "text": "कई बार अनएक्सपेक्टेड चीजें होती है और उस"
    },
    {
      "subtitle_id": 118,
      "start": 245.0,
      "end": 248.959,
      "text": "रिस्क को हेच करने के लिए आपके पास ये दो"
    },
    {
      "subtitle_id": 119,
      "start": 246.84,
      "end": 251.079,
      "text": "बेसिक इंश्योरेंस जरूर होने चाहिए अगर आप"
    },
    {
      "subtitle_id": 120,
      "start": 248.959,
      "end": 252.68,
      "text": "इन्हें ऑनलाइन लेते हैं तो आपको 30 पर तक"
    },
    {
      "subtitle_id": 121,
      "start": 251.079,
      "end": 254.439,
      "text": "का डिस्काउंट मिलता है और ऑनलाइन"
    },
    {
      "subtitle_id": 122,
      "start": 252.68,
      "end": 256.12,
      "text": "इंश्योरेंस खरीदने की बात आती है तो एक"
    },
    {
      "subtitle_id": 123,
      "start": 254.439,
      "end": 258.12,
      "text": "काफी अच्छा प्लेटफॉर्म है पॉलिसी बजार"
    },
    {
      "subtitle_id": 124,
      "start": 256.12,
      "end": 259.72,
      "text": "जहां पर जाकर आप दर्जनों हेल्थ इंश्योरेंस"
    },
    {
      "subtitle_id": 125,
      "start": 258.12,
      "end": 261.799,
      "text": "और टर्म इंश्योरेंस प्लांस को कंपेयर कर"
    },
    {
      "subtitle_id": 126,
      "start": 259.72,
      "end": 263.96,
      "text": "सकते हो और अपने लिए बेस्ट फिगर आउट कर"
    },
    {
      "subtitle_id": 127,
      "start": 261.799,
      "end": 266.0,
      "text": "सकते हो इस बीच आपको कोई भी डाउट आता है"
    },
    {
      "subtitle_id": 128,
      "start": 263.96,
      "end": 267.72,
      "text": "तो उनकी टीम आपका डाउट सॉल्व करेगी साथ ही"
    },
    {
      "subtitle_id": 129,
      "start": 266.0,
      "end": 269.68,
      "text": "उनके क्लेम सपोर्ट टीम भी है जो आपको"
    },
    {
      "subtitle_id": 130,
      "start": 267.72,
      "end": 270.84,
      "text": "क्लेम के टाइम मदद करती है तो अभी डिस्क"
    },
    {
      "subtitle_id": 131,
      "start": 269.68,
      "end": 272.6,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में दी गई"
    },
    {
      "subtitle_id": 132,
      "start": 270.84,
      "end": 274.32,
      "text": "लिंक पर क्लिक करके अपने लिए एक बेस्ट"
    },
    {
      "subtitle_id": 133,
      "start": 272.6,
      "end": 276.28,
      "text": "हेल्थ और एक प्लेन टर्म इंश्योरेंस जरूर"
    },
    {
      "subtitle_id": 134,
      "start": 274.32,
      "end": 278.4,
      "text": "खरीदें देखिए लाइफ इंश्योरेंस सेगमेंट में"
    },
    {
      "subtitle_id": 135,
      "start": 276.28,
      "end": 280.56,
      "text": "टर्म इंश्योरेंस ही खरीदिए जो आपको कम से"
    },
    {
      "subtitle_id": 136,
      "start": 278.4,
      "end": 282.199,
      "text": "कम प्राइस में मिलेगा कंपेयर टू अदर लाइफ"
    },
    {
      "subtitle_id": 137,
      "start": 280.56,
      "end": 283.88,
      "text": "इंश्योरेंस प्लांस जो आपको कई बार"
    },
    {
      "subtitle_id": 138,
      "start": 282.199,
      "end": 285.6,
      "text": "जबरदस्ती बेचे जाते हैं और यहां पर एक"
    },
    {
      "subtitle_id": 139,
      "start": 283.88,
      "end": 287.28,
      "text": "डिस्क्लेमर देना चाहूंगा कि एक स्पों सर्ड"
    },
    {
      "subtitle_id": 140,
      "start": 285.6,
      "end": 288.96,
      "text": "वीडियो नहीं है नीचे जो भी दो लिंक्स दी"
    },
    {
      "subtitle_id": 141,
      "start": 287.28,
      "end": 291.199,
      "text": "गई है डिस्क्रिप्शन और कमेंट बॉक्स में वो"
    },
    {
      "subtitle_id": 142,
      "start": 288.96,
      "end": 292.919,
      "text": "हमारी अफिटेक लिंक है जब आप उसके जरिए कोई"
    },
    {
      "subtitle_id": 143,
      "start": 291.199,
      "end": 294.96,
      "text": "इंश्योरेंस खरीदते हैं तो उसमें से कुछ"
    },
    {
      "subtitle_id": 144,
      "start": 292.919,
      "end": 296.8,
      "text": "हिस्सा हमारे पास आता है जो हमें इस तरह"
    },
    {
      "subtitle_id": 145,
      "start": 294.96,
      "end": 298.56,
      "text": "के वीडियोस बनाने में सपोर्ट करता है तो"
    },
    {
      "subtitle_id": 146,
      "start": 296.8,
      "end": 300.36,
      "text": "जाते-जाते अपने लिए और अपनी फैमिली के लिए"
    },
    {
      "subtitle_id": 147,
      "start": 298.56,
      "end": 302.639,
      "text": "हेल्थ इंश्योरेंस और प्ले टर्म इंश्योरेंस"
    },
    {
      "subtitle_id": 148,
      "start": 300.36,
      "end": 304.16,
      "text": "जरूर खरीदें लिंक नीचे दी गई है अब एसबी"
    },
    {
      "subtitle_id": 149,
      "start": 302.639,
      "end": 305.8,
      "text": "शुरू करने के बाद शुरुआत के कुछ साल थोड़े"
    },
    {
      "subtitle_id": 150,
      "start": 304.16,
      "end": 308.36,
      "text": "टफ ही थे उतने लोग आ नहीं रहे थे"
    },
    {
      "subtitle_id": 151,
      "start": 305.8,
      "end": 310.919,
      "text": "डिपॉजिट्स डालने के लिए तो लान को लगा कि"
    },
    {
      "subtitle_id": 152,
      "start": 308.36,
      "end": 312.919,
      "text": "यार ये कैसे चलेगा लेकिन इसी बीच लान ने"
    },
    {
      "subtitle_id": 153,
      "start": 310.919,
      "end": 315.199,
      "text": "थोड़ा पीआर पर फोकस किया और अपना पीआर"
    },
    {
      "subtitle_id": 154,
      "start": 312.919,
      "end": 317.72,
      "text": "उन्होंने बहुत सटीक तरीके सेया पीआर ये था"
    },
    {
      "subtitle_id": 155,
      "start": 315.199,
      "end": 319.919,
      "text": "कि कैसे गरीब घर की लड़की एक बिलिनियर बन"
    },
    {
      "subtitle_id": 156,
      "start": 317.72,
      "end": 321.96,
      "text": "गई और वो आज एक बैंक चला रही है ये एक"
    },
    {
      "subtitle_id": 157,
      "start": 319.919,
      "end": 324.199,
      "text": "बहुत बड़ी अचीवमेंट है ना कि सिर्फ होची"
    },
    {
      "subtitle_id": 158,
      "start": 321.96,
      "end": 326.8,
      "text": "मिन सिटी के लिए बल्कि पूरे वियतनाम के"
    },
    {
      "subtitle_id": 159,
      "start": 324.199,
      "end": 328.639,
      "text": "लिए और ये जो स्टोरी थी ये थोड़ी वायरल हो"
    },
    {
      "subtitle_id": 160,
      "start": 326.8,
      "end": 331.16,
      "text": "गई वायरल होने के बाद लोगों का ट्रस्ट आया"
    },
    {
      "subtitle_id": 161,
      "start": 328.639,
      "end": 333.639,
      "text": "कि यार ये लड़की इतनी मेहनती है नीचे से"
    },
    {
      "subtitle_id": 162,
      "start": 331.16,
      "end": 335.44,
      "text": "इतनी ऊपर गई है और जरूर ये इस चीज के तो"
    },
    {
      "subtitle_id": 163,
      "start": 333.639,
      "end": 337.039,
      "text": "काबिल है कि इस पर हम भरोसा कर पाए लोगों"
    },
    {
      "subtitle_id": 164,
      "start": 335.44,
      "end": 338.8,
      "text": "ने बहुत बड़ी-बड़ी मात्रा में एससीबी में"
    },
    {
      "subtitle_id": 165,
      "start": 337.039,
      "end": 341.0,
      "text": "अपना पैसा रखना शुरू किया डिपॉजिट करने"
    },
    {
      "subtitle_id": 166,
      "start": 338.8,
      "end": 343.0,
      "text": "लगे लोग बहुत सारा पैसा वहां पर आने लगा"
    },
    {
      "subtitle_id": 167,
      "start": 341.0,
      "end": 344.639,
      "text": "लेकिन लान का दिमाग लान का दिमाग है अब"
    },
    {
      "subtitle_id": 168,
      "start": 343.0,
      "end": 346.759,
      "text": "वहां पर क्या था कि उस टाइम जो बैंक के"
    },
    {
      "subtitle_id": 169,
      "start": 344.639,
      "end": 348.72,
      "text": "रेगुलेशंस थे वियतनाम के वो ये कहते थे कि"
    },
    {
      "subtitle_id": 170,
      "start": 346.759,
      "end": 351.36,
      "text": "कोई भी इंडिविजुअल व्यक्ति किसी बैंक में"
    },
    {
      "subtitle_id": 171,
      "start": 348.72,
      "end": 354.08,
      "text": "5 पर से ज्यादा का स्टेक नहीं खरीद सकते"
    },
    {
      "subtitle_id": 172,
      "start": 351.36,
      "end": 355.68,
      "text": "तो मैक्सिमम आपका 5 पर हो गया लेकिन 5 पर"
    },
    {
      "subtitle_id": 173,
      "start": 354.08,
      "end": 357.72,
      "text": "में कंट्रोल तो नहीं आ र आपके पास तो"
    },
    {
      "subtitle_id": 174,
      "start": 355.68,
      "end": 359.479,
      "text": "इसीलिए लान ने क्या किया बहुत सारी शेल"
    },
    {
      "subtitle_id": 175,
      "start": 357.72,
      "end": 361.639,
      "text": "कंपनीज बनाई अब ये शेल कंपनीज क्या होती"
    },
    {
      "subtitle_id": 176,
      "start": 359.479,
      "end": 363.639,
      "text": "है है ये कुछ ऐसी कंपनीज होती है जो कुछ"
    },
    {
      "subtitle_id": 177,
      "start": 361.639,
      "end": 365.44,
      "text": "नहीं करती है ये नाम की कंपनीज होती है बस"
    },
    {
      "subtitle_id": 178,
      "start": 363.639,
      "end": 367.24,
      "text": "लोगों को गुमराह करने के लिए कई बार शेल"
    },
    {
      "subtitle_id": 179,
      "start": 365.44,
      "end": 369.28,
      "text": "कंपनीज किसी और लोगों के नाम पर बनाई जाती"
    },
    {
      "subtitle_id": 180,
      "start": 367.24,
      "end": 370.68,
      "text": "है ताकि असली में यह पता ही नहीं चल पाता"
    },
    {
      "subtitle_id": 181,
      "start": 369.28,
      "end": 372.28,
      "text": "कि कौन चला रहा है कंपनी इसमें बस"
    },
    {
      "subtitle_id": 182,
      "start": 370.68,
      "end": 374.4,
      "text": "फाइनेंशियल ट्रांजैक्शंस किए जाते हैं"
    },
    {
      "subtitle_id": 183,
      "start": 372.28,
      "end": 376.639,
      "text": "बिजनेस कुछ नहीं होता है खाली कंपनी तो"
    },
    {
      "subtitle_id": 184,
      "start": 374.4,
      "end": 378.68,
      "text": "यहां पर कई सारी शेल कंपनीज लान ने बनाई"
    },
    {
      "subtitle_id": 185,
      "start": 376.639,
      "end": 380.84,
      "text": "और उन कंपनीज के जरिए उसने एससीबी में"
    },
    {
      "subtitle_id": 186,
      "start": 378.68,
      "end": 383.12,
      "text": "स्टेक खरीदना शुरू किया तो धीरे-धीरे धीरे"
    },
    {
      "subtitle_id": 187,
      "start": 380.84,
      "end": 385.08,
      "text": "करके 90 पर स्टेक लान के पास था"
    },
    {
      "subtitle_id": 188,
      "start": 383.12,
      "end": 387.0,
      "text": "डायरेक्टली या इनडायरेक्टली अब कंट्रोल तो"
    },
    {
      "subtitle_id": 189,
      "start": 385.08,
      "end": 388.319,
      "text": "अपने पास आ गया अब तो हम पैसों का कुछ भी"
    },
    {
      "subtitle_id": 190,
      "start": 387.0,
      "end": 389.88,
      "text": "कर सकते हैं ये तो बड़ा क्लियर वो"
    },
    {
      "subtitle_id": 191,
      "start": 388.319,
      "end": 391.52,
      "text": "डायरेक्टर जो लोगों को लग रहे थे है कि ये"
    },
    {
      "subtitle_id": 192,
      "start": 389.88,
      "end": 393.96,
      "text": "इंडिपेंडेंट डायरेक्टर्स से लान ने ही"
    },
    {
      "subtitle_id": 193,
      "start": 391.52,
      "end": 395.96,
      "text": "डिसाइड किया था लान की जान पहचान वाले लान"
    },
    {
      "subtitle_id": 194,
      "start": 393.96,
      "end": 397.639,
      "text": "ने ही बिठाए हुए लोग सब कुछ अपना घर उत का"
    },
    {
      "subtitle_id": 195,
      "start": 395.96,
      "end": 399.56,
      "text": "चल रहा था मुझे लगता है कि इंडिया के कई"
    },
    {
      "subtitle_id": 196,
      "start": 397.639,
      "end": 401.36,
      "text": "सारी जो कोऑपरेटिव बैंक्स है जो पिछले"
    },
    {
      "subtitle_id": 197,
      "start": 399.56,
      "end": 403.36,
      "text": "टाइम में फेल हुई है उन्होंने भी कुछ इसी"
    },
    {
      "subtitle_id": 198,
      "start": 401.36,
      "end": 404.52,
      "text": "तरह का मोड्स ऑपरेंट किया था कोई खुल के"
    },
    {
      "subtitle_id": 199,
      "start": 403.36,
      "end": 406.88,
      "text": "उसके बारे में बात नहीं करता क्योंकि"
    },
    {
      "subtitle_id": 200,
      "start": 404.52,
      "end": 408.56,
      "text": "पॉलिटिशियन की क बैंक्स होती है तो ज्यादा"
    },
    {
      "subtitle_id": 201,
      "start": 406.88,
      "end": 410.44,
      "text": "बोल नहीं पाते और कई बार इन्हें पकड़ा भी"
    },
    {
      "subtitle_id": 202,
      "start": 408.56,
      "end": 412.36,
      "text": "नहीं ज्यादा तो इनका भी मोड अस ऑपरेंट यही"
    },
    {
      "subtitle_id": 203,
      "start": 410.44,
      "end": 414.08,
      "text": "होता है और यहां पर लाने क्या किया फिर कि"
    },
    {
      "subtitle_id": 204,
      "start": 412.36,
      "end": 416.52,
      "text": "उन्होने शेल कंपनीज को बड़ा-बड़ा लोन देना"
    },
    {
      "subtitle_id": 205,
      "start": 414.08,
      "end": 418.44,
      "text": "शुरू किया लोन इतने बड़े-बड़े थे कि काफी"
    },
    {
      "subtitle_id": 206,
      "start": 416.52,
      "end": 420.24,
      "text": "सारा पैसा फिर जो भी लोगों के डिपॉजिट्स"
    },
    {
      "subtitle_id": 207,
      "start": 418.44,
      "end": 422.039,
      "text": "के जरिए आ रहा था वोन शेल कंपनीज को जा"
    },
    {
      "subtitle_id": 208,
      "start": 420.24,
      "end": 424.96,
      "text": "रहा था कितना पैसा शेल कंपनीज को दिया"
    },
    {
      "subtitle_id": 209,
      "start": 422.039,
      "end": 426.879,
      "text": "होगा एनी केसेस 44 बिलियन डॉलर 3 लाख"
    },
    {
      "subtitle_id": 210,
      "start": 424.96,
      "end": 428.759,
      "text": "करोड़ से भी ज्यादा का पैसा वियतनाम जैसे"
    },
    {
      "subtitle_id": 211,
      "start": 426.879,
      "end": 431.24,
      "text": "की छोटी सी कंट्री के एक बैंक ने शेल"
    },
    {
      "subtitle_id": 212,
      "start": 428.759,
      "end": 432.96,
      "text": "कंपनीज को ट्रांसफर किया और अपने ड्राइवर"
    },
    {
      "subtitle_id": 213,
      "start": 431.24,
      "end": 435.639,
      "text": "को बोल के वो काफी सारा कैश भी निकल वाती"
    },
    {
      "subtitle_id": 214,
      "start": 432.96,
      "end": 437.52,
      "text": "थी अलग से कितनी कैश निकाली होगी 36000"
    },
    {
      "subtitle_id": 215,
      "start": 435.639,
      "end": 439.479,
      "text": "करोड़ की फिर अपने कुछ बेसमेंट में रखती"
    },
    {
      "subtitle_id": 216,
      "start": 437.52,
      "end": 442.12,
      "text": "थी कुछ इधर-उधर रखा उसने बेसमेंट में काफी"
    },
    {
      "subtitle_id": 217,
      "start": 439.479,
      "end": 444.24,
      "text": "सारी रखी थी और यह सब चल रहा था स्मूथली"
    },
    {
      "subtitle_id": 218,
      "start": 442.12,
      "end": 446.4,
      "text": "तभी वहां की जो गवर्नमेंट है वियतनाम की"
    },
    {
      "subtitle_id": 219,
      "start": 444.24,
      "end": 449.0,
      "text": "उन्होंने कैंपेन लाया एंटी करप्शन कि जो"
    },
    {
      "subtitle_id": 220,
      "start": 446.4,
      "end": 450.599,
      "text": "कोई गवर्नमेंट एंप्लॉई आपसे घुस मांग रहा"
    },
    {
      "subtitle_id": 221,
      "start": 449.0,
      "end": 452.28,
      "text": "है आप क कंप्लेंट कीज हम उसको जेल में डाल"
    },
    {
      "subtitle_id": 222,
      "start": 450.599,
      "end": 454.199,
      "text": "देंगे और सही में जेल में डाल रहे थे यह"
    },
    {
      "subtitle_id": 223,
      "start": 452.28,
      "end": 456.0,
      "text": "बहुत स्ट्रिक्टली चल रहा था किसी ने सिंपल"
    },
    {
      "subtitle_id": 224,
      "start": 454.199,
      "end": 457.84,
      "text": "कंप्लेंट कर दी चलो डाल दिया जेल में तो"
    },
    {
      "subtitle_id": 225,
      "start": 456.0,
      "end": 459.84,
      "text": "बहुत अग्रेसिव थी गवर्नमेंट कि करप्शन"
    },
    {
      "subtitle_id": 226,
      "start": 457.84,
      "end": 462.0,
      "text": "पूरा ही निकालना है और फिर इसी मामले में"
    },
    {
      "subtitle_id": 227,
      "start": 459.84,
      "end": 464.319,
      "text": "हजार लोगों को जेल में डाला गया और एक"
    },
    {
      "subtitle_id": 228,
      "start": 462.0,
      "end": 466.159,
      "text": "पूरी वेव बन गई वियतनाम में कि कोई करप्शन"
    },
    {
      "subtitle_id": 229,
      "start": 464.319,
      "end": 468.56,
      "text": "कर रहा है तो उसका टिकना भी मुश्किल है"
    },
    {
      "subtitle_id": 230,
      "start": 466.159,
      "end": 470.84,
      "text": "इसी बीच एससीबी बैंक के कुछ एक्स एंप्लॉयज"
    },
    {
      "subtitle_id": 231,
      "start": 468.56,
      "end": 473.479,
      "text": "ने कुछ लोगों को इस चीज के बारे में बताया"
    },
    {
      "subtitle_id": 232,
      "start": 470.84,
      "end": 475.319,
      "text": "कि ट्राउ मिलान काफी सारा पैसा बैंक से"
    },
    {
      "subtitle_id": 233,
      "start": 473.479,
      "end": 477.159,
      "text": "निकाल कर अपनी शेल कंपनीज को भेज रही है"
    },
    {
      "subtitle_id": 234,
      "start": 475.319,
      "end": 479.52,
      "text": "क्योंकि ये सब उनके सामने ही हो रहा था अब"
    },
    {
      "subtitle_id": 235,
      "start": 477.159,
      "end": 481.36,
      "text": "इसे सुनकर कुछ लोगों ने"
    },
    {
      "subtitle_id": 236,
      "start": 479.52,
      "end": 483.44,
      "text": "पोस्ट किया अब ये पोस्ट कुछ ही दिनों में"
    },
    {
      "subtitle_id": 237,
      "start": 481.36,
      "end": 485.24,
      "text": "इतनी ज्यादा वायरल हो गई कि हर कोई इसी"
    },
    {
      "subtitle_id": 238,
      "start": 483.44,
      "end": 486.96,
      "text": "बैंक की बात करने लगा अब यह चीज सबसे"
    },
    {
      "subtitle_id": 239,
      "start": 485.24,
      "end": 488.96,
      "text": "ज्यादा हॉरिबल किसके लिए थी उन लोगों के"
    },
    {
      "subtitle_id": 240,
      "start": 486.96,
      "end": 490.759,
      "text": "लिए जिन्होंने भरोसा करके डिपॉजिट डाला था"
    },
    {
      "subtitle_id": 241,
      "start": 488.96,
      "end": 492.599,
      "text": "अब जैसे ही लोगों ने ये पोस्ट देखी भाग कर"
    },
    {
      "subtitle_id": 242,
      "start": 490.759,
      "end": 494.52,
      "text": "चले गए एससीबी में चलो मुझे अपना पैसा"
    },
    {
      "subtitle_id": 243,
      "start": 492.599,
      "end": 497.479,
      "text": "निकालना है शुरुआत के जो लोग चले गए उनको"
    },
    {
      "subtitle_id": 244,
      "start": 494.52,
      "end": 499.68,
      "text": "तो पैसा मिल गया बाद में लगभग हर डिपॉजिट"
    },
    {
      "subtitle_id": 245,
      "start": 497.479,
      "end": 501.759,
      "text": "होल्डर बैंक के पास जाने लगा तो बैंक ने"
    },
    {
      "subtitle_id": 246,
      "start": 499.68,
      "end": 503.919,
      "text": "क्लियर स्टेटमेंट दे दिया कि देखिए हमारे"
    },
    {
      "subtitle_id": 247,
      "start": 501.759,
      "end": 505.56,
      "text": "पास इतना सारा पैसा है कि आप सभी को हम"
    },
    {
      "subtitle_id": 248,
      "start": 503.919,
      "end": 507.919,
      "text": "इजली दे सकते हैं कोई दिक्कत नहीं है"
    },
    {
      "subtitle_id": 249,
      "start": 505.56,
      "end": 510.479,
      "text": "लिक्विडिटी हमारी अच्छी है लेकिन अगर आपको"
    },
    {
      "subtitle_id": 250,
      "start": 507.919,
      "end": 512.279,
      "text": "हम पर भरोसा नहीं है ट्र लान पर भी भरोसा"
    },
    {
      "subtitle_id": 251,
      "start": 510.479,
      "end": 514.64,
      "text": "नहीं है तो आप पैसे निकाल लो तो इन्होंने"
    },
    {
      "subtitle_id": 252,
      "start": 512.279,
      "end": 516.44,
      "text": "ऐसी मतलब रिवर्स साइकोलॉजी से ऐसी धमकी दी"
    },
    {
      "subtitle_id": 253,
      "start": 514.64,
      "end": 518.0,
      "text": "लेकिन लोगों ने कुछ सुना नहीं लोग चले गए"
    },
    {
      "subtitle_id": 254,
      "start": 516.44,
      "end": 519.68,
      "text": "लोगों ने बोला यार हमारा पैसा हम निकाल"
    },
    {
      "subtitle_id": 255,
      "start": 518.0,
      "end": 521.919,
      "text": "लेते हैं क्योंकि एलिगेशंस बहुत स्ट्रांग"
    },
    {
      "subtitle_id": 256,
      "start": 519.68,
      "end": 524.0,
      "text": "है लोग गए वहां पर पैसा निकाल लिया कुछ"
    },
    {
      "subtitle_id": 257,
      "start": 521.919,
      "end": 525.839,
      "text": "लोगों को तो मिला लेकिन बैंक को बाद में"
    },
    {
      "subtitle_id": 258,
      "start": 524.0,
      "end": 528.16,
      "text": "हाथ खड़े करने पड़े और यह बोलना पड़ा कि"
    },
    {
      "subtitle_id": 259,
      "start": 525.839,
      "end": 530.839,
      "text": "हमारे पास अब उतना पैसा नहीं है कि हम"
    },
    {
      "subtitle_id": 260,
      "start": 528.16,
      "end": 533.399,
      "text": "आपको यह सारा पैसा दे पाए बैंक ने बोला कि"
    },
    {
      "subtitle_id": 261,
      "start": 530.839,
      "end": 535.56,
      "text": "हम तो हो गए बैंकर पट अब बैंकर पट होने के"
    },
    {
      "subtitle_id": 262,
      "start": 533.399,
      "end": 538.16,
      "text": "बाद फिर गवर्नमेंट एजेंसीज बीच में आई तो"
    },
    {
      "subtitle_id": 263,
      "start": 535.56,
      "end": 540.839,
      "text": "44 बिलियन डॉलर में से लगभग 17 बिलियन"
    },
    {
      "subtitle_id": 264,
      "start": 538.16,
      "end": 542.88,
      "text": "डॉलर तो सरकार ने रिकवर कर लिए मतलब कुछ"
    },
    {
      "subtitle_id": 265,
      "start": 540.839,
      "end": 544.76,
      "text": "उनके बेसमेंट से निकाल लिए पैसे कुछ शेल"
    },
    {
      "subtitle_id": 266,
      "start": 542.88,
      "end": 549.04,
      "text": "कंपनीज के अकाउंट से निकाल लिए लेकिन फिर"
    },
    {
      "subtitle_id": 267,
      "start": 544.76,
      "end": 552.0,
      "text": "भी 27 बिलियन डॉलर यानी लगभग 21000 करोड़"
    },
    {
      "subtitle_id": 268,
      "start": 549.04,
      "end": 554.24,
      "text": "अभी भी मिसिंग और फिर यह मामला फिर 2022"
    },
    {
      "subtitle_id": 269,
      "start": 552.0,
      "end": 556.04,
      "text": "में बाहर आया तो ट्रंग मिलान उनके हस्बैंड"
    },
    {
      "subtitle_id": 270,
      "start": 554.24,
      "end": 558.04,
      "text": "जो कि हांगकांग में बिजनेस करते थे उनके"
    },
    {
      "subtitle_id": 271,
      "start": 556.04,
      "end": 560.36,
      "text": "कुछ रिलेटिव्स बैंक के कुछ एंप्लॉयज ऐसे"
    },
    {
      "subtitle_id": 272,
      "start": 558.04,
      "end": 562.0,
      "text": "करीब-करीब 800 लोगों पर केस चली केस"
    },
    {
      "subtitle_id": 273,
      "start": 560.36,
      "end": 563.839,
      "text": "शुरुआत में तो ढीली ढाली चल रही थी लेकिन"
    },
    {
      "subtitle_id": 274,
      "start": 562.0,
      "end": 565.56,
      "text": "लोगों का प्रेशर था लोगों ने तो प्रोटेस्ट"
    },
    {
      "subtitle_id": 275,
      "start": 563.839,
      "end": 567.44,
      "text": "करना शुरू कर दिया रास्ते पे आ गए कि बहुत"
    },
    {
      "subtitle_id": 276,
      "start": 565.56,
      "end": 569.56,
      "text": "सारा पैसा हमारा डूबा है हम शांति से नहीं"
    },
    {
      "subtitle_id": 277,
      "start": 567.44,
      "end": 572.44,
      "text": "बैठ सकते आप इमेजिन कर सकते एक छोटी"
    },
    {
      "subtitle_id": 278,
      "start": 569.56,
      "end": 574.68,
      "text": "कंट्री जहां का जीडीपी 46 बिलियन डॉलर का"
    },
    {
      "subtitle_id": 279,
      "start": 572.44,
      "end": 577.0,
      "text": "है वहां पर 44 बिलियन डॉलर यानी जीडीपी का"
    },
    {
      "subtitle_id": 280,
      "start": 574.68,
      "end": 578.959,
      "text": "लगभग 10 पर से ज्यादा का फ्रॉड हो जाता है"
    },
    {
      "subtitle_id": 281,
      "start": 577.0,
      "end": 580.76,
      "text": "फ्रॉड बहुत बड़े लेवल पर किया गया है तो"
    },
    {
      "subtitle_id": 282,
      "start": 578.959,
      "end": 582.68,
      "text": "पब्लिक से आते हुए प्रेशर को देखकर सरकार"
    },
    {
      "subtitle_id": 283,
      "start": 580.76,
      "end": 584.72,
      "text": "और कोर्ट ने जल्दी इस पर एक्शन लेना शुरू"
    },
    {
      "subtitle_id": 284,
      "start": 582.68,
      "end": 587.279,
      "text": "किया और 2 साल के अंदर इसका रिजल्ट लगाया"
    },
    {
      "subtitle_id": 285,
      "start": 584.72,
      "end": 589.6,
      "text": "अब देखिए इसमें कई सारे लोग आए वहां पर जो"
    },
    {
      "subtitle_id": 286,
      "start": 587.279,
      "end": 592.399,
      "text": "एविडेंसेस थे वो कितने थे उसका वेट किया"
    },
    {
      "subtitle_id": 287,
      "start": 589.6,
      "end": 594.88,
      "text": "गया तो लगभग 6000 किग्रा इतने एविडेंसेस"
    },
    {
      "subtitle_id": 288,
      "start": 592.399,
      "end": 596.839,
      "text": "आए 200 लॉयर्स इन में इवॉल्व थे और जो"
    },
    {
      "subtitle_id": 289,
      "start": 594.88,
      "end": 599.68,
      "text": "गवाही देने के लिए लोग आए उनकी संख्या थी"
    },
    {
      "subtitle_id": 290,
      "start": 596.839,
      "end": 602.12,
      "text": "2700 बहुत बड़े लेवल पर ही हुआ और फिर"
    },
    {
      "subtitle_id": 291,
      "start": 599.68,
      "end": 605.2,
      "text": "फाइनली कोर्ट ने बता दिया कि ट्रंग मलान"
    },
    {
      "subtitle_id": 292,
      "start": 602.12,
      "end": 607.16,
      "text": "स्मर दोषी पाई जाती है और उनको सजाए मौत"
    },
    {
      "subtitle_id": 293,
      "start": 605.2,
      "end": 609.16,
      "text": "यहां पर दी जाती है उनके हस्बैंड को करीब"
    },
    {
      "subtitle_id": 294,
      "start": 607.16,
      "end": 611.64,
      "text": "9 साल की सजा हुई बैंक के कई सारे"
    },
    {
      "subtitle_id": 295,
      "start": 609.16,
      "end": 613.76,
      "text": "एंप्लॉयज ने किसी को 2 साल 4 साल 10 साल"
    },
    {
      "subtitle_id": 296,
      "start": 611.64,
      "end": 615.6,
      "text": "इस तरह की सजाएं हुई और चार लोग ऐसे भी थे"
    },
    {
      "subtitle_id": 297,
      "start": 613.76,
      "end": 617.32,
      "text": "जिन्हें आजीवन कारावास की सजा हुई"
    },
    {
      "subtitle_id": 298,
      "start": 615.6,
      "end": 619.6,
      "text": "गवर्नमेंट अभी भी ट्राई कर रही है पैसा"
    },
    {
      "subtitle_id": 299,
      "start": 617.32,
      "end": 621.8,
      "text": "रिकवर करने के लिए लेकिन इस 44 बिलियन"
    },
    {
      "subtitle_id": 300,
      "start": 619.6,
      "end": 624.32,
      "text": "डॉलर में से $7 बिलियन डलर अभी भी मिसिंग"
    },
    {
      "subtitle_id": 301,
      "start": 621.8,
      "end": 626.36,
      "text": "है ₹ 166000 करोड़ अभी भी मिसिंग है तो"
    },
    {
      "subtitle_id": 302,
      "start": 624.32,
      "end": 629.32,
      "text": "आपको क्या लगता है क्या यह पैसा कभी मिल"
    },
    {
      "subtitle_id": 303,
      "start": 626.36,
      "end": 630.44,
      "text": "पाएगा नीचे कमेंट करके जरूर बताइए और इस"
    },
    {
      "subtitle_id": 304,
      "start": 629.32,
      "end": 631.92,
      "text": "इस वीडियो को भी ज्यादा से ज्यादा लोगों"
    },
    {
      "subtitle_id": 305,
      "start": 630.44,
      "end": 633.519,
      "text": "तक जरूर शेयर करें मिलते हैं अगले वीडियो"
    },
    {
      "subtitle_id": 306,
      "start": 631.92,
      "end": 635.079,
      "text": "में अभी तक चैनल को सब्सक्राइब नहीं किया"
    },
    {
      "subtitle_id": 307,
      "start": 633.519,
      "end": 636.519,
      "text": "है तो क्या कर रहे हो जरूर सब्सक्राइब"
    },
    {
      "subtitle_id": 308,
      "start": 635.079,
      "end": 638.639,
      "text": "कीजिए क्योंकि इसी तरह के क्वालिटी"
    },
    {
      "subtitle_id": 309,
      "start": 636.519,
      "end": 642.279,
      "text": "वीडियोस आपको इस चैनल पर हमेशा मिलते"
    },
    {
      "subtitle_id": 310,
      "start": 638.639,
      "end": 642.279,
      "text": "रहेंगे और यह मेरी गारंटी है"
    }
  ]
}