      "text": "देगी लेकिन ऐसा नहीं होता है आपका पैसा"
    },
    {
      "subtitle_id": 289,
      "start": 610.279,
      "end": 614.44,
      "text": "फसा मतलब खत्म चार दिन आप पुलिस स्टेशन के"
    },
    {
      "subtitle_id": 290,
      "start": 612.92,
      "end": 617.92,
      "text": "चक्कर मारोगे 10 दिन कोर्ट के चक्कर"
    },
    {
      "subtitle_id": 291,
      "start": 614.44,
      "end": 620.12,
      "text": "मारोगे ओवर पैसा नहीं मिलता आपको सो वो आप"
    },
    {
      "subtitle_id": 292,
      "start": 617.92,
      "end": 622.56,
      "text": "छोड़ दीजिए कि ऐसा हुआ तो वो करके देगा वो"
    },
    {
      "subtitle_id": 293,
      "start": 620.12,
      "end": 624.44,
      "text": "वैसा हुआ तो वो करके दे देगा सो बेटर है"
    },
    {
      "subtitle_id": 294,
      "start": 622.56,
      "end": 627.2,
      "text": "कि आप इन चीजों से हटके रहिए प्रॉपर जो"
    },
    {
      "subtitle_id": 295,
      "start": 624.44,
      "end": 628.64,
      "text": "प्रोफेशनल इन्वेस्टमेंट्स है ठीक है कि"
    },
    {
      "subtitle_id": 296,
      "start": 627.2,
      "end": 630.279,
      "text": "अगर आपको कुछ भी रिस्क नहीं लेना है तो"
    },
    {
      "subtitle_id": 297,
      "start": 628.64,
      "end": 632.079,
      "text": "एफडी थोड़ा बहुत रिस्क लेना है म्यूचुअल"
    },
    {
      "subtitle_id": 298,
      "start": 630.279,
      "end": 633.6,
      "text": "फंड स्टॉक और फंडामेंटल की बेटर जानकारी"
    },
    {
      "subtitle_id": 299,
      "start": 632.079,
      "end": 635.56,
      "text": "है तो स्टॉक मार्केट अच्छा खासा पैसा और"
    },
    {
      "subtitle_id": 300,
      "start": 633.6,
      "end": 638.04,
      "text": "रियल एस्टेट की जानकारी तो रियल एस्टेट इन"
    },
    {
      "subtitle_id": 301,
      "start": 635.56,
      "end": 639.959,
      "text": "पर आप फोकस कीजिए इनके बाहर आप ना ही जाए"
    },
    {
      "subtitle_id": 302,
      "start": 638.04,
      "end": 642.0,
      "text": "तो बेटर है वीडियो को खत्म होने से पहले"
    },
    {
      "subtitle_id": 303,
      "start": 639.959,
      "end": 644.88,
      "text": "आपको बता दूं कि हम आपको हायर करना चाहते"
    },
    {
      "subtitle_id": 304,
      "start": 642.0,
      "end": 647.279,
      "text": "हैं फिलहाल हमारी हायरिंग चल रही है जहां"
    },
    {
      "subtitle_id": 305,
      "start": 644.88,
      "end": 649.279,
      "text": "पर कॉपीराइटिंग और कई सारी ऐसी पोजीशंस है"
    },
    {
      "subtitle_id": 306,
      "start": 647.279,
      "end": 651.8,
      "text": "एक्विटी रिसर्च एनालिस्ट जिनकी ओपनिंग"
    },
    {
      "subtitle_id": 307,
      "start": 649.279,
      "end": 654.16,
      "text": "फिलहाल चल रही है 100% वर्क फ्रॉम ऑफिस ये"
    },
    {
      "subtitle_id": 308,
      "start": 651.8,
      "end": 656.2,
      "text": "जॉब है मलकापुर लोकेशन है जो कि जलगांव के"
    },
    {
      "subtitle_id": 309,
      "start": 654.16,
      "end": 658.279,
      "text": "नजदीक आता है अकोमोडेशन कंपनी की तरफ है"
    },
    {
      "subtitle_id": 310,
      "start": 656.2,
      "end": 660.959,
      "text": "फाइव डेज वर्किंग है और काफी अच्छा"
    },
    {
      "subtitle_id": 311,
      "start": 658.279,
      "end": 663.279,
      "text": "वर्किंग एनवायरमेंट है जहां पर आपको काफी"
    },
    {
      "subtitle_id": 312,
      "start": 660.959,
      "end": 665.6,
      "text": "कुछ नई-नई चीजें सीखने मिलेगी मेरे साथ"
    },
    {
      "subtitle_id": 313,
      "start": 663.279,
      "end": 667.72,
      "text": "डायरेक्टली काम करने मिलेगा डिस्क्रिप्शन"
    },
    {
      "subtitle_id": 314,
      "start": 665.6,
      "end": 669.68,
      "text": "में आपको करियर पेज की लिंक मिल जाएगी उस"
    },
    {
      "subtitle_id": 315,
      "start": 667.72,
      "end": 671.76,
      "text": "पर क्लिक करके आप अप्लाई कीजिए मल्टीपल"
    },
    {
      "subtitle_id": 316,
      "start": 669.68,
      "end": 673.44,
      "text": "पोजीशंस को वहां पर रिजू में अपलोड करने"
    },
    {
      "subtitle_id": 317,
      "start": 671.76,
      "end": 675.12,
      "text": "का ऑप्शन आता है अगर आप शॉर्टलिस्ट हो"
    },
    {
      "subtitle_id": 318,
      "start": 673.44,
      "end": 677.279,
      "text": "जाते हैं तो हमारी एचआर टीम आपसे कांटेक्ट"
    },
    {
      "subtitle_id": 319,
      "start": 675.12,
      "end": 679.6,
      "text": "करेगी और आगे की प्रोसेस कर लेगी होप टू"
    },
    {
      "subtitle_id": 320,
      "start": 677.279,
      "end": 681.0,
      "text": "सी यू ऑन दिस साइड ऑफ कैमरा सो आज के इस"
    },
    {
      "subtitle_id": 321,
      "start": 679.6,
      "end": 682.48,
      "text": "वीडियो में यहीं पर रुकते हैं थैंक यू सो"
    },
    {
      "subtitle_id": 322,
      "start": 681.0,
      "end": 683.92,
      "text": "मच फॉर वाचिंग दिस वीडियो ज्यादा से"
    },
    {
      "subtitle_id": 323,
      "start": 682.48,
      "end": 685.839,
      "text": "ज्यादा इस वीडियो को शेयर कीजिए ताकि"
    },
    {
      "subtitle_id": 324,
      "start": 683.92,
      "end": 687.839,
      "text": "ज्यादा से ज्यादा लोग अवेयर हो सके और इस"
    },
    {
      "subtitle_id": 325,
      "start": 685.839,
      "end": 691.24,
      "text": "तरह के पंज स्कीम में ना फसे अब इस तरह की"
    },
    {
      "subtitle_id": 326,
      "start": 687.839,
      "end": 691.24,
      "text": "पंज स्कीम हजारों अभी चल रही"
    },
    {
      "subtitle_id": 327,
      "start": 692.32,
      "end": 695.32,
      "text": "m"
    }
  ]
}