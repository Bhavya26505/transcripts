  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.04,
      "end": 4.2,
      "text": "लगता है हजारों करोड़ों के स्कैम का दौर"
    },
    {
      "subtitle_id": 2,
      "start": 2.12,
      "end": 6.24,
      "text": "अब वापस आ गया है अभी कुछ ही दिनों पहले"
    },
    {
      "subtitle_id": 3,
      "start": 4.2,
      "end": 8.639,
      "text": "हमने अनिल अंबानी के 8000 करोड़ के स्कैम"
    },
    {
      "subtitle_id": 4,
      "start": 6.24,
      "end": 10.28,
      "text": "को कवर किया जिसके बाद हमें उसे टेक डाउन"
    },
    {
      "subtitle_id": 5,
      "start": 8.639,
      "end": 12.48,
      "text": "करने का नोटिस भी आया और इस वीडियो के"
    },
    {
      "subtitle_id": 6,
      "start": 10.28,
      "end": 14.36,
      "text": "जस्ट बाद 7000 करोड़ का डीबी स्टॉक"
    },
    {
      "subtitle_id": 7,
      "start": 12.48,
      "end": 16.44,
      "text": "ब्रोकिंग का स्कैम सामने आया और इस पर हम"
    },
    {
      "subtitle_id": 8,
      "start": 14.36,
      "end": 18.439,
      "text": "रिसर्च कर ही रहे थे तब तक एक और 2200"
    },
    {
      "subtitle_id": 9,
      "start": 16.44,
      "end": 20.0,
      "text": "करोड़ का नया स्कैम बाहर आया अब ये दोनों"
    },
    {
      "subtitle_id": 10,
      "start": 18.439,
      "end": 21.64,
      "text": "स्कैमर्स इतने भी लायक नहीं थे कि इन"
    },
    {
      "subtitle_id": 11,
      "start": 20.0,
      "end": 23.32,
      "text": "दोनों पर अलग-अलग वीडियोस बनाई जाए तो"
    },
    {
      "subtitle_id": 12,
      "start": 21.64,
      "end": 25.32,
      "text": "हमने सोचा कि क्यों ना इन दोनों को एक ही"
    },
    {
      "subtitle_id": 13,
      "start": 23.32,
      "end": 27.519,
      "text": "वीडियो में कवर किया जाए इसलिए हमने इस पर"
    },
    {
      "subtitle_id": 14,
      "start": 25.32,
      "end": 29.679,
      "text": "एक डिटेल रिसर्च शुरू की रिसर्च करते-करते"
    },
    {
      "subtitle_id": 15,
      "start": 27.519,
      "end": 31.84,
      "text": "एक सवाल यह भी दिमाग में आया कि यह बहुत"
    },
    {
      "subtitle_id": 16,
      "start": 29.679,
      "end": 33.399,
      "text": "सारे स्कैम्स रिसेंटली आसाम में ही क्यों"
    },
    {
      "subtitle_id": 17,
      "start": 31.84,
      "end": 35.559,
      "text": "हो रहे हैं और फिर रिसर्च में कुछ ऐसी"
    },
    {
      "subtitle_id": 18,
      "start": 33.399,
      "end": 37.76,
      "text": "चीजें बाहर आई जिससे मैं खुद बहुत ज्यादा"
    },
    {
      "subtitle_id": 19,
      "start": 35.559,
      "end": 39.52,
      "text": "शौक था तो इन सारी चीजों की बात करेंगे आज"
    },
    {
      "subtitle_id": 20,
      "start": 37.76,
      "end": 41.2,
      "text": "के इस वीडियो में तो आखिर तक जरूर बने"
    },
    {
      "subtitle_id": 21,
      "start": 39.52,
      "end": 42.92,
      "text": "रहिए वैसे बताने की जरूरत नहीं पड़ती"
    },
    {
      "subtitle_id": 22,
      "start": 41.2,
      "end": 44.52,
      "text": "बिकॉज आप में से लगभग सारे लोग आखिर तक"
    },
    {
      "subtitle_id": 23,
      "start": 42.92,
      "end": 46.8,
      "text": "बने रहते हैं तो आज के इस वीडियो में बात"
    },
    {
      "subtitle_id": 24,
      "start": 44.52,
      "end": 49.039,
      "text": "करेंगे कि दो स्कैम्स आखिर है क्या साथ ही"
    },
    {
      "subtitle_id": 25,
      "start": 46.8,
      "end": 50.84,
      "text": "यह भी समझेंगे कि ज्यादातर लोग इन स्कैम्स"
    },
    {
      "subtitle_id": 26,
      "start": 49.039,
      "end": 52.84,
      "text": "में क्यों फंस रहे हैं और आप अपने आप को"
    },
    {
      "subtitle_id": 27,
      "start": 50.84,
      "end": 54.64,
      "text": "और अपनी फैमिली को इन स्कैम में फंसने से"
    },
    {
      "subtitle_id": 28,
      "start": 52.84,
      "end": 56.68,
      "text": "कैसे बचा सकते हैं इसके बारे में भी मैं"
    },
    {
      "subtitle_id": 29,
      "start": 54.64,
      "end": 59.12,
      "text": "बहुत ही इंपॉर्टेंट टिप्स और चीजें आपको"
    },
    {
      "subtitle_id": 30,
      "start": 56.68,
      "end": 61.239,
      "text": "बताने वाला नमस्कार मैं प्रसाद आपका आज के"
    },
    {
      "subtitle_id": 31,
      "start": 59.12,
      "end": 62.68,
      "text": "इस वीडियो में स्वागत करता वीडियो में आगे"
    },
    {
      "subtitle_id": 32,
      "start": 61.239,
      "end": 64.199,
      "text": "बढ़ने से पहले आपको बता दूं कि अभी 1"
    },
    {
      "subtitle_id": 33,
      "start": 62.68,
      "end": 65.96,
      "text": "अक्टूबर से हमारी फाइनेंशियल मॉडलिंग एंड"
    },
    {
      "subtitle_id": 34,
      "start": 64.199,
      "end": 68.439,
      "text": "वैल्युएशन मेंटरशिप यानी एफएमवीए की"
    },
    {
      "subtitle_id": 35,
      "start": 65.96,
      "end": 70.28,
      "text": "नेक्स्ट बैच शुरू हो रही है 100% ऑनलाइन"
    },
    {
      "subtitle_id": 36,
      "start": 68.439,
      "end": 71.88,
      "text": "और वीकेंड बैच है जिसे कोई भी अटेंड कर"
    },
    {
      "subtitle_id": 37,
      "start": 70.28,
      "end": 73.68,
      "text": "सकता है अगर आपको फाइनेंस की फील्ड में"
    },
    {
      "subtitle_id": 38,
      "start": 71.88,
      "end": 75.32,
      "text": "करियर बनाना है या फिर फाइनेंस की फील्ड"
    },
    {
      "subtitle_id": 39,
      "start": 73.68,
      "end": 77.28,
      "text": "में बहुत इनपथ नॉलेज हासिल करना है"
    },
    {
      "subtitle_id": 40,
      "start": 75.32,
      "end": 78.92,
      "text": "फाइनेंशियल मॉडलिंग का और डीसीएफ यानी"
    },
    {
      "subtitle_id": 41,
      "start": 77.28,
      "end": 80.799,
      "text": "डिस्काउंटेड कैश मेथड से वैल्युएशन"
    },
    {
      "subtitle_id": 42,
      "start": 78.92,
      "end": 82.84,
      "text": "निकालने का तो यहां पर ये सारी चीजें आपको"
    },
    {
      "subtitle_id": 43,
      "start": 80.799,
      "end": 84.439,
      "text": "सीखने मिल जाती है एफएमवीए में एनरोल करने"
    },
    {
      "subtitle_id": 44,
      "start": 82.84,
      "end": 86.0,
      "text": "की लिंक आपको नीचे डिस्क्रिप्शन और कमेंट"
    },
    {
      "subtitle_id": 45,
      "start": 84.439,
      "end": 87.64,
      "text": "बॉक्स में मिल जाएगी यह कोर्स सबके लिए"
    },
    {
      "subtitle_id": 46,
      "start": 86.0,
      "end": 89.4,
      "text": "नहीं है तो जो लोग फॉर्म फिल करने के बाद"
    },
    {
      "subtitle_id": 47,
      "start": 87.64,
      "end": 91.52,
      "text": "सिलेक्ट होंगे उन्हें हमारी टीम कांटेक्ट"
    },
    {
      "subtitle_id": 48,
      "start": 89.4,
      "end": 94.0,
      "text": "कर लेगी तो चलिए बढ़ते हैं वीडियो की तरफ"
    },
    {
      "subtitle_id": 49,
      "start": 91.52,
      "end": 96.32,
      "text": "तो सबसे पहले बात करते हैं स्कैमर नंबर वन"
    },
    {
      "subtitle_id": 50,
      "start": 94.0,
      "end": 99.399,
      "text": "की इस पूरे स्कैम का सूत्रधार यह महानुभव"
    },
    {
      "subtitle_id": 51,
      "start": 96.32,
      "end": 101.84,
      "text": "है जिनका नाम है दीपांकर बर्मन जो कि"
    },
    {
      "subtitle_id": 52,
      "start": 99.399,
      "end": 104.32,
      "text": "चलाते थे कंपनी कॉल्ड डीबी स्टॉक ब्रोकिंग"
    },
    {
      "subtitle_id": 53,
      "start": 101.84,
      "end": 106.56,
      "text": "अब नाम सुनकर तो आपको यही लग रहा होगा कि"
    },
    {
      "subtitle_id": 54,
      "start": 104.32,
      "end": 109.68,
      "text": "कंपनी का स्टॉक से या फिर ब्रोकिंग से कुछ"
    },
    {
      "subtitle_id": 55,
      "start": 106.56,
      "end": 111.399,
      "text": "ना कुछ लेना देना तो जरूर होगा राइट रॉन्ग"
    },
    {
      "subtitle_id": 56,
      "start": 109.68,
      "end": 113.28,
      "text": "तो मैं आपको बता दूं कि इस कंपनी का ना ही"
    },
    {
      "subtitle_id": 57,
      "start": 111.399,
      "end": 116.2,
      "text": "स्टॉक से कोई लेना देना है ना ही ब्रोकिंग"
    },
    {
      "subtitle_id": 58,
      "start": 113.28,
      "end": 117.96,
      "text": "से इसका लेना देना है पोंज स्कीम से कैसे"
    },
    {
      "subtitle_id": 59,
      "start": 116.2,
      "end": 120.32,
      "text": "उसने यह स्कैम एग्जीक्यूट किया बात करेंगे"
    },
    {
      "subtitle_id": 60,
      "start": 117.96,
      "end": 122.439,
      "text": "थोड़ी देर में उससे पहले बात करते हैं"
    },
    {
      "subtitle_id": 61,
      "start": 120.32,
      "end": 125.2,
      "text": "स्कैमर नंबर टू की और इस स्कैम के"
    },
    {
      "subtitle_id": 62,
      "start": 122.439,
      "end": 127.52,
      "text": "सूत्रधार हैं यह महानुभव जिनका नाम है"
    },
    {
      "subtitle_id": 63,
      "start": 125.2,
      "end": 129.8,
      "text": "विशाल फुकन यह अपने आप को आंत प्रनर"
    },
    {
      "subtitle_id": 64,
      "start": 127.52,
      "end": 131.84,
      "text": "कहलाता है यह मात्र 22 साल का है और स्कैम"
    },
    {
      "subtitle_id": 65,
      "start": 129.8,
      "end": 134.4,
      "text": "जो इसने किया है वो अपनी एज के हजार गुना"
    },
    {
      "subtitle_id": 66,
      "start": 131.84,
      "end": 136.48,
      "text": "बड़ा किया है सब मिलके 2200 करोड़ का इसने"
    },
    {
      "subtitle_id": 67,
      "start": 134.4,
      "end": 138.04,
      "text": "स्कैम किया है अगर आप इसके टा पर जाकर चेक"
    },
    {
      "subtitle_id": 68,
      "start": 136.48,
      "end": 140.08,
      "text": "करोगे तो आपको पता चलेगा कि यह बंदा"
    },
    {
      "subtitle_id": 69,
      "start": 138.04,
      "end": 142.2,
      "text": "इंडिया से ज्यादा टाइम दुबई में बिताता है"
    },
    {
      "subtitle_id": 70,
      "start": 140.08,
      "end": 144.84,
      "text": "और यह बहुत बड़ा दानवीर भी था इसने अपनी"
    },
    {
      "subtitle_id": 71,
      "start": 142.2,
      "end": 147.16,
      "text": "सो कॉल्ड सिस्टर जिनका नाम है सुमी बोरा"
    },
    {
      "subtitle_id": 72,
      "start": 144.84,
      "end": 148.76,
      "text": "उसकी वेडिंग में ₹ करोड़ खर्च किए सुमी"
    },
    {
      "subtitle_id": 73,
      "start": 147.16,
      "end": 150.72,
      "text": "बोरा आसाम के एक एक्टर और इंस्टा"
    },
    {
      "subtitle_id": 74,
      "start": 148.76,
      "end": 152.4,
      "text": "इनफ्लुएंसर हैं इन का क्या लेना देना है"
    },
    {
      "subtitle_id": 75,
      "start": 150.72,
      "end": 154.68,
      "text": "स्कैम से थोड़ी देर में उसके बारे में भी"
    },
    {
      "subtitle_id": 76,
      "start": 152.4,
      "end": 156.8,
      "text": "बात करेंगे कहने को विशाल के तीन कंपनीज"
    },
    {
      "subtitle_id": 77,
      "start": 154.68,
      "end": 159.4,
      "text": "हैं फार्मा वीडियो प्रोडक्शन और"
    },
    {
      "subtitle_id": 78,
      "start": 156.8,
      "end": 161.239,
      "text": "कंस्ट्रक्शन की अब देखिए इतनी बड़ी तीन"
    },
    {
      "subtitle_id": 79,
      "start": 159.4,
      "end": 163.36,
      "text": "कंपनीज आपने बनाई है तो उसके लिए बड़ी"
    },
    {
      "subtitle_id": 80,
      "start": 161.239,
      "end": 165.4,
      "text": "तगड़ी फंडिंग भी आपको लगी होगी तो पैसा"
    },
    {
      "subtitle_id": 81,
      "start": 163.36,
      "end": 167.44,
      "text": "आपने या तो बैंक से लिया होगा या वेंचर"
    },
    {
      "subtitle_id": 82,
      "start": 165.4,
      "end": 170.519,
      "text": "कैपिटल से या फिर फैमिली से लिया होगा या"
    },
    {
      "subtitle_id": 83,
      "start": 167.44,
      "end": 172.44,
      "text": "फिर खुद कमाया होगा राइट रॉन्ग पूरा का"
    },
    {
      "subtitle_id": 84,
      "start": 170.519,
      "end": 174.64,
      "text": "पूरा पैसा इसने फंडिंग से नहीं लोगों के"
    },
    {
      "subtitle_id": 85,
      "start": 172.44,
      "end": 176.92,
      "text": "साथ स्कैम करके इसमें इन्वेस्ट किया था ये"
    },
    {
      "subtitle_id": 86,
      "start": 174.64,
      "end": 178.72,
      "text": "भी एक पोंजी स्कीम चलाता था अब जो भी पंजी"
    },
    {
      "subtitle_id": 87,
      "start": 176.92,
      "end": 180.239,
      "text": "स्कीम होती है वो दो चीजों के बेसिस पर"
    },
    {
      "subtitle_id": 88,
      "start": 178.72,
      "end": 181.84,
      "text": "चलती है पहली चीज यह है कि कि आप डोमेन"
    },
    {
      "subtitle_id": 89,
      "start": 180.239,
      "end": 183.48,
      "text": "एक्सपर्ट होने का नाटक करो जैसे अमित"
    },
    {
      "subtitle_id": 90,
      "start": 181.84,
      "end": 185.519,
      "text": "भारद्वाज ने क्रिप्टो करेंसी में एक पंजी"
    },
    {
      "subtitle_id": 91,
      "start": 183.48,
      "end": 187.159,
      "text": "स्कीम चलाई थी उसने बताया था कि मैं बहुत"
    },
    {
      "subtitle_id": 92,
      "start": 185.519,
      "end": 189.159,
      "text": "बड़ा क्रिप्टोकरंसी एक्सपर्ट हूं मेरी"
    },
    {
      "subtitle_id": 93,
      "start": 187.159,
      "end": 191.04,
      "text": "बहुत सारी माइंस है मैं क्रिप्टो करेंसी"
    },
    {
      "subtitle_id": 94,
      "start": 189.159,
      "end": 192.959,
      "text": "पर बहुत सारे बुक्स लिखता हूं और वैसे"
    },
    {
      "subtitle_id": 95,
      "start": 191.04,
      "end": 195.08,
      "text": "करके उसने लोगों को फंसाया पोंज स् गम"
    },
    {
      "subtitle_id": 96,
      "start": 192.959,
      "end": 197.28,
      "text": "करने का दूसरा तरीका थोड़ा कैजुअल है वो"
    },
    {
      "subtitle_id": 97,
      "start": 195.08,
      "end": 199.72,
      "text": "ये है कि आप ऑलरेडी जिनका ट्रस्ट बना हुआ"
    },
    {
      "subtitle_id": 98,
      "start": 197.28,
      "end": 201.239,
      "text": "है उनके साथ एसोसिएट होकर उन पर जो लोगों"
    },
    {
      "subtitle_id": 99,
      "start": 199.72,
      "end": 203.12,
      "text": "का ट्रस्ट फैक्टर है उसे अपने फायदे के"
    },
    {
      "subtitle_id": 100,
      "start": 201.239,
      "end": 205.12,
      "text": "लिए यूज़ करते हो तो दीप अंकर ने यहां पर"
    },
    {
      "subtitle_id": 101,
      "start": 203.12,
      "end": 207.08,
      "text": "ये कैजुअल वाला तरीका अपना लिया इसने क्या"
    },
    {
      "subtitle_id": 102,
      "start": 205.12,
      "end": 208.879,
      "text": "किया कि जैसे कि आप स्क्रीन पर देख सकते"
    },
    {
      "subtitle_id": 103,
      "start": 207.08,
      "end": 211.0,
      "text": "हो इसने अमन गुप्ता के साथ अपनी एक फोटो"
    },
    {
      "subtitle_id": 104,
      "start": 208.879,
      "end": 213.56,
      "text": "खिंचवा ली ये कॉलेज के फेस्ट में ली गई"
    },
    {
      "subtitle_id": 105,
      "start": 211.0,
      "end": 216.319,
      "text": "फोटो है जिसको स्पंस दीपांकर ने किया था"
    },
    {
      "subtitle_id": 106,
      "start": 213.56,
      "end": 216.319,
      "text": "ये फोटो इसने अपने"
    },
    {
      "subtitle_id": 107,
      "start": 239.84,
      "end": 243.76,
      "text": "कल्ट इमेज बनाई जिस पर लोगों ने काफी"
    },
    {
      "subtitle_id": 108,
      "start": 241.68,
      "end": 246.079,
      "text": "ट्रस्ट किया अब बात करते हैं विशाल फुकान"
    },
    {
      "subtitle_id": 109,
      "start": 243.76,
      "end": 248.079,
      "text": "की जिसने 2200 करोड़ का स्कैम किया है"
    },
    {
      "subtitle_id": 110,
      "start": 246.079,
      "end": 250.56,
      "text": "इसने आसाम के जो इन्फ्लुएंस है एक्टर्स"
    },
    {
      "subtitle_id": 111,
      "start": 248.079,
      "end": 252.2,
      "text": "हैं इनकी मदद से अपनी पंज स्कीम को फैलाया"
    },
    {
      "subtitle_id": 112,
      "start": 250.56,
      "end": 254.04,
      "text": "जैसे कि मैंने थोड़ी देर पहले ही सुमी"
    },
    {
      "subtitle_id": 113,
      "start": 252.2,
      "end": 255.84,
      "text": "बोरा का नाम लिया था विशाल ने सुमी के"
    },
    {
      "subtitle_id": 114,
      "start": 254.04,
      "end": 257.919,
      "text": "जरिए आसाम के एक्टर्स और इंडस्ट्री के"
    },
    {
      "subtitle_id": 115,
      "start": 255.84,
      "end": 259.6,
      "text": "लोगों से अपनी स्कीम में पैसा डलवाया उसके"
    },
    {
      "subtitle_id": 116,
      "start": 257.919,
      "end": 261.639,
      "text": "बदले में विशाल ने सुमी को करोड़ों के"
    },
    {
      "subtitle_id": 117,
      "start": 259.6,
      "end": 264.32,
      "text": "गिफ्ट्स दिए और उसकी उदयपुर में जो शादी"
    },
    {
      "subtitle_id": 118,
      "start": 261.639,
      "end": 267.12,
      "text": "थी उसे स्पंस किया जिसका टोटल खर्चा था"
    },
    {
      "subtitle_id": 119,
      "start": 264.32,
      "end": 268.6,
      "text": "225 करोड़ रपए अब जनरली पोंजी स्कीम में"
    },
    {
      "subtitle_id": 120,
      "start": 267.12,
      "end": 270.56,
      "text": "होता क्या है तो लोगों को क्रेजी रिटर्न्स"
    },
    {
      "subtitle_id": 121,
      "start": 268.6,
      "end": 272.88,
      "text": "का वादा किया जाता है जैसे कि अनुराधा ने"
    },
    {
      "subtitle_id": 122,
      "start": 270.56,
      "end": 275.24,
      "text": "राजू को किया था और यहां पर भी वही हुआ"
    },
    {
      "subtitle_id": 123,
      "start": 272.88,
      "end": 277.639,
      "text": "दीपांकर ने अलग-अलग मंथ के अलग-अलग रिटर्न"
    },
    {
      "subtitle_id": 124,
      "start": 275.24,
      "end": 279.32,
      "text": "पैकेजेस के प्रॉमिस बनाए वही विशाल की बात"
    },
    {
      "subtitle_id": 125,
      "start": 277.639,
      "end": 281.639,
      "text": "करें तो रिटर्न्स के मामले में विशाल"
    },
    {
      "subtitle_id": 126,
      "start": 279.32,
      "end": 283.72,
      "text": "दीपंकर से काफी आगे था बहुत ज्यादा आगे था"
    },
    {
      "subtitle_id": 127,
      "start": 281.639,
      "end": 285.56,
      "text": "उसने लोगों को 30 पर रिटर्न मात्र दो"
    },
    {
      "subtitle_id": 128,
      "start": 283.72,
      "end": 287.639,
      "text": "महीनों में देने का प्रॉमिस किया अब लोगों"
    },
    {
      "subtitle_id": 129,
      "start": 285.56,
      "end": 289.68,
      "text": "ने भी जैसे शाम ने अनुराधा को पूछा था"
    },
    {
      "subtitle_id": 130,
      "start": 287.639,
      "end": 291.44,
      "text": "वैसे ही इन दोनों से पूछना शुरू किया कि"
    },
    {
      "subtitle_id": 131,
      "start": 289.68,
      "end": 294.039,
      "text": "आप हमें इतने सारे रिटर्न्स दे रहे हैं तो"
    },
    {
      "subtitle_id": 132,
      "start": 291.44,
      "end": 295.759,
      "text": "आपको पैसा कहां से आ रहा है तो जैसे कि"
    },
    {
      "subtitle_id": 133,
      "start": 294.039,
      "end": 297.52,
      "text": "आपको याद होगा कि अनुराधा ने तो बोला था"
    },
    {
      "subtitle_id": 134,
      "start": 295.759,
      "end": 299.72,
      "text": "कि हम एक और कंपनी में इन्वेस्ट करते हैं"
    },
    {
      "subtitle_id": 135,
      "start": 297.52,
      "end": 301.639,
      "text": "जो हमें अपना पैसा सात दिन में डबल करके"
    },
    {
      "subtitle_id": 136,
      "start": 299.72,
      "end": 303.4,
      "text": "देती है तो यहां पर दीपांकर और विशाल के"
    },
    {
      "subtitle_id": 137,
      "start": 301.639,
      "end": 305.28,
      "text": "जो जवाब है वो बड़े इंटरेस्टिंग है"
    },
    {
      "subtitle_id": 138,
      "start": 303.4,
      "end": 307.479,
      "text": "दीपांकर ने यह बताया कि उसके पास एक ऐसी"
    },
    {
      "subtitle_id": 139,
      "start": 305.28,
      "end": 309.8,
      "text": "ट्रेडिंग स्ट्रेटेजी है जिसे यूज करके"
    },
    {
      "subtitle_id": 140,
      "start": 307.479,
      "end": 312.24,
      "text": "बड़े आसानी से एक महीने में ही 40 से 50"
    },
    {
      "subtitle_id": 141,
      "start": 309.8,
      "end": 313.72,
      "text": "पर वो बना लेता है बस उसे जरूरत थी कैपिटल"
    },
    {
      "subtitle_id": 142,
      "start": 312.24,
      "end": 315.479,
      "text": "की कि आप लोग पैसा इन्वेस्ट करो मैं"
    },
    {
      "subtitle_id": 143,
      "start": 313.72,
      "end": 317.08,
      "text": "ट्रेडिंग से पैसा कमा के दे दूंगा बट ऐसे"
    },
    {
      "subtitle_id": 144,
      "start": 315.479,
      "end": 319.12,
      "text": "कोई ट्रेडिंग स्ट्रेटेजी इसके पास नहीं थी"
    },
    {
      "subtitle_id": 145,
      "start": 317.08,
      "end": 321.28,
      "text": "इसके पास एक ही स्ट्रेटेजी थी वो थी पज"
    },
    {
      "subtitle_id": 146,
      "start": 319.12,
      "end": 323.8,
      "text": "स्किन स्ट्रेटेजी अब दीपांकर और विशाल के"
    },
    {
      "subtitle_id": 147,
      "start": 321.28,
      "end": 326.08,
      "text": "केसेस में हुआ ये कि जो भी नए क्लाइंट का"
    },
    {
      "subtitle_id": 148,
      "start": 323.8,
      "end": 327.88,
      "text": "पैसा आ रहा था वो पैसा वो पुराने क्लाइंट"
    },
    {
      "subtitle_id": 149,
      "start": 326.08,
      "end": 329.36,
      "text": "को एज अ इंटरेस्ट दे रहे थे जिससे पुराने"
    },
    {
      "subtitle_id": 150,
      "start": 327.88,
      "end": 330.28,
      "text": "वालों को लग रहा था कि हमें तो पैसा मिल"
    },
    {
      "subtitle_id": 151,
      "start": 329.36,
      "end": 332.44,
      "text": "रहा है"
    },
    {
      "subtitle_id": 152,
      "start": 330.28,
      "end": 334.6,
      "text": "तो उन्होंने और जगह चर्चा करनी शुरू कर दी"
    },
    {
      "subtitle_id": 153,
      "start": 332.44,
      "end": 336.919,
      "text": "फिर और लोगों ने पैसा डाला अब यह साइकिल"
    },
    {
      "subtitle_id": 154,
      "start": 334.6,
      "end": 339.72,
      "text": "बहुत अच्छे तरीके से चलती है जब तक नए लोग"
    },
    {
      "subtitle_id": 155,
      "start": 336.919,
      "end": 341.639,
      "text": "नए क्लाइंट्स पैसा डालना जारी रखते हैं"
    },
    {
      "subtitle_id": 156,
      "start": 339.72,
      "end": 343.56,
      "text": "लेकिन जैसे ही नए क्लाइंट्स बंद हो जाते"
    },
    {
      "subtitle_id": 157,
      "start": 341.639,
      "end": 345.759,
      "text": "हैं या फिर कम हो जाते हैं तब दिक्कत हो"
    },
    {
      "subtitle_id": 158,
      "start": 343.56,
      "end": 347.8,
      "text": "जाती है कि बाकी का पैसा कहां दें तो ऐसे"
    },
    {
      "subtitle_id": 159,
      "start": 345.759,
      "end": 349.6,
      "text": "केस में जो फ्रॉड स्टर होते हैं वह पैसा"
    },
    {
      "subtitle_id": 160,
      "start": 347.8,
      "end": 351.88,
      "text": "लेके जितना बचा कुचा पैसा है उतना लेके"
    },
    {
      "subtitle_id": 161,
      "start": 349.6,
      "end": 353.36,
      "text": "भाग जाते हैं एगजैक्टली यही दीपांकर के"
    },
    {
      "subtitle_id": 162,
      "start": 351.88,
      "end": 355.08,
      "text": "केस में भी हुआ खबर यह है कि वो इंडिया"
    },
    {
      "subtitle_id": 163,
      "start": 353.36,
      "end": 357.8,
      "text": "छोड़ के ऑस्ट्रेलिया भाग चुका है लेकिन"
    },
    {
      "subtitle_id": 164,
      "start": 355.08,
      "end": 360.0,
      "text": "विशाल को आसाम की पुलिस ने पकड़ लिया अगर"
    },
    {
      "subtitle_id": 165,
      "start": 357.8,
      "end": 361.6,
      "text": "पर्टिकुलर असाम या नॉर्थ स्टेट्स की बात"
    },
    {
      "subtitle_id": 166,
      "start": 360.0,
      "end": 363.24,
      "text": "करें तो वहां पर रिसेंट टाइम में इस तरह"
    },
    {
      "subtitle_id": 167,
      "start": 361.6,
      "end": 365.479,
      "text": "की पंज स्कीम्स की संख्या बहुत ज्यादा"
    },
    {
      "subtitle_id": 168,
      "start": 363.24,
      "end": 367.24,
      "text": "बड़ी है जब हमने इसके बारे में पता करना"
    },
    {
      "subtitle_id": 169,
      "start": 365.479,
      "end": 369.28,
      "text": "शुरू किया कि ऐसा क्यों हो रहा है तो कुछ"
    },
    {
      "subtitle_id": 170,
      "start": 367.24,
      "end": 371.199,
      "text": "शॉकिंग चीजें हमें पता चली आप स्क्रीन पर"
    },
    {
      "subtitle_id": 171,
      "start": 369.28,
      "end": 373.52,
      "text": "देख सकते हो ट्रेडिंग f और ट्रेडिंग बुल"
    },
    {
      "subtitle_id": 172,
      "start": 371.199,
      "end": 375.68,
      "text": "नाम की कंपनी है जो महीने के 15 पर देने"
    },
    {
      "subtitle_id": 173,
      "start": 373.52,
      "end": 377.68,
      "text": "का दावा कर रही है और यह सब लोकल लेवल पर"
    },
    {
      "subtitle_id": 174,
      "start": 375.68,
      "end": 379.479,
      "text": "चलता है जिसमें आपकी ही फैमिली मेंबर्स या"
    },
    {
      "subtitle_id": 175,
      "start": 377.68,
      "end": 381.52,
      "text": "आपके फ्रेंड्स आपको आकर रिटर्न्स के बारे"
    },
    {
      "subtitle_id": 176,
      "start": 379.479,
      "end": 383.8,
      "text": "में बताते हैं और आप पैसा लगाते हो और"
    },
    {
      "subtitle_id": 177,
      "start": 381.52,
      "end": 386.0,
      "text": "आपका पैसा डूब जाता है और बहुत सारे केसेस"
    },
    {
      "subtitle_id": 178,
      "start": 383.8,
      "end": 387.88,
      "text": "में स्कैमर्स पर एज यूजुअल पीट का सपोर्ट"
    },
    {
      "subtitle_id": 179,
      "start": 386.0,
      "end": 390.72,
      "text": "होता है पीट यानी कि जैसे मैंने पहले भी"
    },
    {
      "subtitle_id": 180,
      "start": 387.88,
      "end": 392.479,
      "text": "कई बार बताया है पुलिस और पॉलि ंस विशाल"
    },
    {
      "subtitle_id": 181,
      "start": 390.72,
      "end": 394.599,
      "text": "के केस में एक सीआईडी ऑफिसर भी पकड़ा गया"
    },
    {
      "subtitle_id": 182,
      "start": 392.479,
      "end": 396.56,
      "text": "है इसीलिए ऐसे लोग इंडिया छोड़कर बड़ी"
    },
    {
      "subtitle_id": 183,
      "start": 394.599,
      "end": 398.16,
      "text": "आसानी से बाहर भाग जाते हैं अब प्राइमर"
    },
    {
      "subtitle_id": 184,
      "start": 396.56,
      "end": 399.919,
      "text": "इंडिया में यह स्कैम्स इतने ज्यादा इसलिए"
    },
    {
      "subtitle_id": 185,
      "start": 398.16,
      "end": 402.24,
      "text": "हो रहे हैं क्योंकि यहां पर जो फाइनेंशियल"
    },
    {
      "subtitle_id": 186,
      "start": 399.919,
      "end": 404.56,
      "text": "लिटरेसी है वो नाम मात्र है आप ये रिपोर्ट"
    },
    {
      "subtitle_id": 187,
      "start": 402.24,
      "end": 407.24,
      "text": "देखिए इसके अनुसार इंडिया में सिर्फ 4.2"
    },
    {
      "subtitle_id": 188,
      "start": 404.56,
      "end": 410.44,
      "text": "पर लोग एडवांस फाइनेंशियल नॉलेज रखते हैं"
    },
    {
      "subtitle_id": 189,
      "start": 407.24,
      "end": 412.4,
      "text": "सिर्फ 4.2 पर बाकी जो बचे हुए 95 96 पर"
    },
    {
      "subtitle_id": 190,
      "start": 410.44,
      "end": 414.24,
      "text": "लोग हैं इनके पास बहुत ही लो फाइनेंशियल"
    },
    {
      "subtitle_id": 191,
      "start": 412.4,
      "end": 416.319,
      "text": "लिटरेसी होती है क्योंकि हमें वो स्कूल"
    },
    {
      "subtitle_id": 192,
      "start": 414.24,
      "end": 418.319,
