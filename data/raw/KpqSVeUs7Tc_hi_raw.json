  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.08,
      "end": 4.56,
      "text": "हजारों साल पुरानी एक कहावत है। व्हेन अ"
    },
    {
      "subtitle_id": 2,
      "start": 2.399,
      "end": 7.279,
      "text": "क्लाउन मूव्स इनू अ पैलेस ही डजंट बिकम अ"
    },
    {
      "subtitle_id": 3,
      "start": 4.56,
      "end": 9.36,
      "text": "किंग, द पैलेस बिकम्स अ सर्कस। यानी अगर"
    },
    {
      "subtitle_id": 4,
      "start": 7.279,
      "end": 12.639,
      "text": "आप जोकर को राजा बनाओगे तो राजा नहीं"
    },
    {
      "subtitle_id": 5,
      "start": 9.36,
      "end": 14.799,
      "text": "बनेगा बल्कि पूरा देश सर्कस बन जाएगा। जी"
    },
    {
      "subtitle_id": 6,
      "start": 12.639,
      "end": 17.52,
      "text": "हां, यह हजारों साल पुरानी कहावत है।"
    },
    {
      "subtitle_id": 7,
      "start": 14.799,
      "end": 20.0,
      "text": "लेकिन आज भी उतनी ही सही लगती है जितनी तब"
    },
    {
      "subtitle_id": 8,
      "start": 17.52,
      "end": 22.56,
      "text": "थी। आज के समय में देखें तो एक देश की"
    },
    {
      "subtitle_id": 9,
      "start": 20.0,
      "end": 24.88,
      "text": "बिल्कुल यही हालत है। पहले जब इस देश का"
    },
    {
      "subtitle_id": 10,
      "start": 22.56,
      "end": 26.8,
      "text": "नाम लिया जाता था तो इज्जत और सम्मान से"
    },
    {
      "subtitle_id": 11,
      "start": 24.88,
      "end": 29.279,
      "text": "लिया जाता था। लोग जलते थे इनके"
    },
    {
      "subtitle_id": 12,
      "start": 26.8,
      "end": 32.239,
      "text": "टेक्नोलॉजी और इनोवेशन को देखकर। लेकिन जब"
    },
    {
      "subtitle_id": 13,
      "start": 29.279,
      "end": 35.04,
      "text": "से एक क्लाउन पैलेस के अंदर घुसा है मानो"
    },
    {
      "subtitle_id": 14,
      "start": 32.239,
      "end": 36.559,
      "text": "पूरा देश सर्कस बन गया है। तो मैं किस देश"
    },
    {
      "subtitle_id": 15,
      "start": 35.04,
      "end": 38.719,
      "text": "की बात कर रहा हूं और किस क्लाउन की बात"
    },
    {
      "subtitle_id": 16,
      "start": 36.559,
      "end": 40.8,
      "text": "कर रहा हूं यह तो आप समझ ही गए होंगे। जी"
    },
    {
      "subtitle_id": 17,
      "start": 38.719,
      "end": 43.2,
      "text": "हां, मिस्टर डोनल्ड ट्रंप ने दुनिया के"
    },
    {
      "subtitle_id": 18,
      "start": 40.8,
      "end": 46.079,
      "text": "सबसे अमीर देश को सिर्फ और सिर्फ 8 महीनों"
    },
    {
      "subtitle_id": 19,
      "start": 43.2,
      "end": 48.32,
      "text": "में रिसेशन के कगार पर लाकर खड़ा कर दिया"
    },
    {
      "subtitle_id": 20,
      "start": 46.079,
      "end": 51.2,
      "text": "है। लेकिन सबसे बड़ा कारण क्या है? तो"
    },
    {
      "subtitle_id": 21,
      "start": 48.32,
      "end": 52.96,
      "text": "उनकी इकॉनमी को लेकर नासमझी। और हम उनकी"
    },
    {
      "subtitle_id": 22,
      "start": 51.2,
      "end": 55.199,
      "text": "ना समझी पर बात नहीं करेंगे क्योंकि वो"
    },
    {
      "subtitle_id": 23,
      "start": 52.96,
      "end": 57.039,
      "text": "डॉक्टर्स का काम है। फिनोवेशंस एक फाइनेंस"
    },
    {
      "subtitle_id": 24,
      "start": 55.199,
      "end": 59.359,
      "text": "चैनल है। तो यहां पर हम बात करेंगे"
    },
    {
      "subtitle_id": 25,
      "start": 57.039,
      "end": 61.68,
      "text": "फैक्ट्स और नंबर्स की और वो भी बहुत ही"
    },
    {
      "subtitle_id": 26,
      "start": 59.359,
      "end": 64.32,
      "text": "आसान भाषा में। तो चलिए जानते हैं कि"
    },
    {
      "subtitle_id": 27,
      "start": 61.68,
      "end": 66.64,
      "text": "यूएसए आखिर रिसेशन से कितना दूर है या"
    },
    {
      "subtitle_id": 28,
      "start": 64.32,
      "end": 68.32,
      "text": "क्या वो ऑलरेडी रिसेशन में है? कौन से"
    },
    {
      "subtitle_id": 29,
      "start": 66.64,
      "end": 70.24,
      "text": "मैट्रिक्स से डिसाइड होता है कि एक कंट्री"
    },
    {
      "subtitle_id": 30,
      "start": 68.32,
      "end": 72.64,
      "text": "रिसेशन में है या नहीं? और सबसे"
    },
    {
      "subtitle_id": 31,
      "start": 70.24,
      "end": 75.2,
      "text": "इंपॉर्टेंट सवाल क्या यूएसए खुद ही डूबेगा"
    },
    {
      "subtitle_id": 32,
      "start": 72.64,
      "end": 78.0,
      "text": "या खुद के साथ-साथ पूरी दुनिया को लेकर"
    },
    {
      "subtitle_id": 33,
      "start": 75.2,
      "end": 80.72,
      "text": "डूबेगा? यानी कि हम तो डूबेंगे सनम रिसेशन"
    },
    {
      "subtitle_id": 34,
      "start": 78.0,
      "end": 82.72,
      "text": "में तुमको भी ले डूबेंगे। सब सवालों के"
    },
    {
      "subtitle_id": 35,
      "start": 80.72,
      "end": 84.4,
      "text": "जवाब आपको मिलेंगे आज के इस वीडियो में और"
    },
    {
      "subtitle_id": 36,
      "start": 82.72,
      "end": 86.24,
      "text": "डू चेक आउट आवर प्रीमियम कम्युनिटी यहां"
    },
    {
      "subtitle_id": 37,
      "start": 84.4,
      "end": 88.24,
      "text": "ज्वाइन बटन पर क्लिक करके जहां पर आपको"
    },
    {
      "subtitle_id": 38,
      "start": 86.24,
      "end": 90.159,
      "text": "मिलेगा हमारा प्रीमियम कंटेंट। सो लेट्स"
    },
    {
      "subtitle_id": 39,
      "start": 88.24,
      "end": 91.68,
      "text": "स्टार्ट द वीडियो। नमस्कार, मैं प्रसाद"
    },
    {
      "subtitle_id": 40,
      "start": 90.159,
      "end": 93.92,
      "text": "आपका आज के इस वीडियो में स्वागत करता"
    },
    {
      "subtitle_id": 41,
      "start": 91.68,
      "end": 95.68,
      "text": "हूं। अब एक कंट्री रिसेशन में है या नहीं"
    },
    {
      "subtitle_id": 42,
      "start": 93.92,
      "end": 97.68,
      "text": "इसे जानने के लिए कई सारे मैट्रिक्स होते"
    },
    {
      "subtitle_id": 43,
      "start": 95.68,
      "end": 99.68,
      "text": "हैं। और इंटरेस्टिंगली सारे मैट्रिक्स एक"
    },
    {
      "subtitle_id": 44,
      "start": 97.68,
      "end": 101.92,
      "text": "ही तरफ इशारा कर रहे हैं और वो यह कि"
    },
    {
      "subtitle_id": 45,
      "start": 99.68,
      "end": 104.24,
      "text": "यूएसए इज मोस्ट लाइकली टू गो इनू रिसेशन"
    },
    {
      "subtitle_id": 46,
      "start": 101.92,
      "end": 106.079,
      "text": "एज अर्ली एज दिस ईयर एंड। तो उन हर एक"
    },
    {
      "subtitle_id": 47,
      "start": 104.24,
      "end": 108.399,
      "text": "मैट्रिक्स के एक-एक करके बात करते हैं।"
    },
    {
      "subtitle_id": 48,
      "start": 106.079,
      "end": 110.56,
      "text": "शुरुआत करते हैं जॉब मार्केट से। अगर हम"
    },
    {
      "subtitle_id": 49,
      "start": 108.399,
      "end": 113.119,
      "text": "एकदम लेटेस्ट डाटा देखें अगस्त मंथ के"
    },
    {
      "subtitle_id": 50,
      "start": 110.56,
      "end": 117.439,
      "text": "अनइंप्लॉयमेंट रेट का तो वो 4 साल के हाई"
    },
    {
      "subtitle_id": 51,
      "start": 113.119,
      "end": 120.64,
      "text": "पर जा चुका है सिंस अक्टूबर 2021 एट 4.3%"
    },
    {
      "subtitle_id": 52,
      "start": 117.439,
      "end": 123.04,
      "text": "जून में यह 4.1% था और साल भर यह लगातार"
    },
    {
      "subtitle_id": 53,
      "start": 120.64,
      "end": 125.68,
      "text": "और खराब होता जा रहा है और अगर यूएसए के"
    },
    {
      "subtitle_id": 54,
      "start": 123.04,
      "end": 127.92,
      "text": "ब्रॉडर U6 अनइंप्लॉयमेंट रेट की बात करें"
    },
    {
      "subtitle_id": 55,
      "start": 125.68,
      "end": 130.319,
      "text": "तो तस्वीर और भी ज्यादा खराब नजर आ रही"
    },
    {
      "subtitle_id": 56,
      "start": 127.92,
      "end": 134.879,
      "text": "है। U6 के हिसाब से अनइंप्लॉयमेंट रेट"
    },
    {
      "subtitle_id": 57,
      "start": 130.319,
      "end": 136.48,
      "text": "8.1% हो चुका है जो पिछले महीने 7.9% था।"
    },
    {
      "subtitle_id": 58,
      "start": 134.879,
      "end": 138.48,
      "text": "वीडियो में आगे बढ़ने से पहले मैं आपको एक"
    },
    {
      "subtitle_id": 59,
      "start": 136.48,
      "end": 140.08,
      "text": "खुशखबरी देना चाहता हूं कि आपकी मोस्ट"
    },
    {
      "subtitle_id": 60,
      "start": 138.48,
      "end": 142.319,
      "text": "डिमांडेड और मोस्ट रिक्वेस्टेड चीज को"
    },
    {
      "subtitle_id": 61,
      "start": 140.08,
      "end": 144.879,
      "text": "फिनोवेशंस ने ल्च कर दिया है। हमने अपने"
    },
    {
      "subtitle_id": 62,
      "start": 142.319,
      "end": 147.36,
      "text": "दो स्माल केस ल्च किए हैं। पहला है हमारा"
    },
    {
      "subtitle_id": 63,
      "start": 144.879,
      "end": 149.04,
      "text": "इका वैल्यू इन्वेस्टिंग स्मॉल केस जहां पर"
    },
    {
      "subtitle_id": 64,
      "start": 147.36,
      "end": 151.2,
      "text": "हम वैल्यू इन्वेस्टिंग ओपोरर्चुनिटीज ढूंढ"
    },
    {
      "subtitle_id": 65,
      "start": 149.04,
      "end": 152.879,
      "text": "रहे हैं मार्केट में और उन ओपोरर्चुनिटीज"
    },
    {
      "subtitle_id": 66,
      "start": 151.2,
      "end": 155.519,
      "text": "में इन्वेस्ट कर रहे हैं। और दूसरा है"
    },
    {
      "subtitle_id": 67,
      "start": 152.879,
      "end": 157.76,
      "text": "हमारा इका इमर्जिंग इंडिया स्मॉल केस जहां"
    },
    {
      "subtitle_id": 68,
      "start": 155.519,
      "end": 159.92,
      "text": "पर हम उन कंपनीज़ में इन्वेस्ट कर रहे हैं"
    },
    {
      "subtitle_id": 69,
      "start": 157.76,
      "end": 162.16,
      "text": "जो बहुत ही हाई ग्रोथ सेक्टर में खुद भी"
    },
    {
      "subtitle_id": 70,
      "start": 159.92,
      "end": 164.08,
      "text": "बहुत तेजी से बढ़ रही है। और उससे भी बड़ी"
    },
    {
      "subtitle_id": 71,
      "start": 162.16,
      "end": 166.239,
      "text": "खुशखबरी है कि पिछले एक साल में मार्केट"
    },
    {
      "subtitle_id": 72,
      "start": 164.08,
      "end": 168.08,
      "text": "लगभग नेट नेट डाउन ही है और पिछले कुछ"
    },
    {
      "subtitle_id": 73,
      "start": 166.239,
      "end": 169.84,
      "text": "दिनों से ट्रंप की वजह से वह और भी नीचे"
    },
    {
      "subtitle_id": 74,
      "start": 168.08,
      "end": 171.36,
      "text": "जा रहा है और ऐसे में आपके पास एक"
    },
    {
      "subtitle_id": 75,
      "start": 169.84,
      "end": 173.36,
      "text": "अपोरर्चुनिटी है इन सारी कंपनीज़ को और"
    },
    {
      "subtitle_id": 76,
      "start": 171.36,
      "end": 175.519,
      "text": "बेटर वैल्यू्यूएशन पर खरीदने की जिससे"
    },
    {
      "subtitle_id": 77,
      "start": 173.36,
      "end": 177.28,
      "text": "आपकी मार्जिन ऑफ सेफ्टी और बेटर हो जाएगी।"
    },
    {
      "subtitle_id": 78,
      "start": 175.519,
      "end": 178.64,
      "text": "इन स्मॉल केसेस की लिंक आपको नीचे"
    },
    {
      "subtitle_id": 79,
      "start": 177.28,
      "end": 180.56,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में मिल"
    },
    {
      "subtitle_id": 80,
      "start": 178.64,
      "end": 182.879,
      "text": "जाएगी। और यहां पर इन स्मॉल केस का एनुअल"
    },
    {
      "subtitle_id": 81,
      "start": 180.56,
      "end": 185.68,
      "text": "सब्सक्रिप्शन लेकर आप इनमें एसआईपी भी कर"
    },
    {
      "subtitle_id": 82,
      "start": 182.879,
      "end": 187.2,
      "text": "सकते हो और जब चाहे तब अपना एडिशनल पैसा"
    },
    {
      "subtitle_id": 83,
      "start": 185.68,
      "end": 189.28,
      "text": "यहां पर इन्वेस्ट कर सकते हो। उसका पूरा"
    },
    {
      "subtitle_id": 84,
      "start": 187.2,
      "end": 191.36,
      "text": "एक्सेस पूरे साल भर आपके लिए रहेगा। और इस"
    },
    {
      "subtitle_id": 85,
      "start": 189.28,
      "end": 193.599,
      "text": "लॉन्च ऑफर में हम आपके लिए यानी फिनोशंस"
    },
    {
      "subtitle_id": 86,
      "start": 191.36,
      "end": 195.04,
      "text": "फैमिली के लिए स्पेशल फ्लैट 30% का"
    },
    {
      "subtitle_id": 87,
      "start": 193.599,
      "end": 198.959,
      "text": "डिस्काउंट दे रहे हैं। जिसके लिए कूपन कोड"
    },
    {
      "subtitle_id": 88,
      "start": 195.04,
      "end": 200.8,
      "text": "आपको यूज करना है एफ एम30 फम 30 और अच्छी"
    },
    {
      "subtitle_id": 89,
      "start": 198.959,
      "end": 202.8,
      "text": "बात यह है कि ये जो छोटी-मोटी गिरावटें"
    },
    {
      "subtitle_id": 90,
      "start": 200.8,
      "end": 204.64,
      "text": "होती है यही वैल्यू इन्वेस्टिंग पॉइंट ऑफ"
    },
    {
      "subtitle_id": 91,
      "start": 202.8,
      "end": 206.319,
      "text": "व्यू से हमारे लिए बेटर अपोरर्चुनिटीज"
    },
    {
      "subtitle_id": 92,
      "start": 204.64,
      "end": 208.0,
      "text": "लेकर आती है। तो हमारे इन स्मॉल केसेस को"
    },
    {
      "subtitle_id": 93,
      "start": 206.319,
      "end": 210.08,
      "text": "जरूर चेक आउट कीजिए और इस ऑफर का फायदा"
    },
    {
      "subtitle_id": 94,
      "start": 208.0,
      "end": 212.0,
      "text": "लीजिए क्योंकि बाद में यह ऑफर आपको नहीं"
    },
    {
      "subtitle_id": 95,
      "start": 210.08,
      "end": 214.72,
      "text": "मिलेगी। एंड यहां पर इन्वेस्टमेंट की कोई"
    },
    {
      "subtitle_id": 96,
      "start": 212.0,
      "end": 216.72,
      "text": "भी अपपर लिमिट नहीं है। आपको जितना पैसा"
    },
    {
      "subtitle_id": 97,
      "start": 214.72,
      "end": 219.36,
      "text": "इन्वेस्ट करना है यू कैन इन्वेस्ट विद द"
    },
    {
      "subtitle_id": 98,
      "start": 216.72,
      "end": 221.84,
      "text": "फिक्स फीस। चलिए अब बढ़ते हैं वीडियो की"
    },
    {
      "subtitle_id": 99,
      "start": 219.36,
      "end": 223.92,
      "text": "तरफ। अब यह तो बात हो गई अनइंप्लॉयमेंट"
    },
    {
      "subtitle_id": 100,
      "start": 221.84,
      "end": 226.239,
      "text": "रेट की जो तो खराब है ही। लेकिन क्या यह"
    },
    {
      "subtitle_id": 101,
      "start": 223.92,
      "end": 227.92,
      "text": "फ्यूचर में सुधर सकता है? और वो तभी होगा"
    },
    {
      "subtitle_id": 102,
      "start": 226.239,
      "end": 230.56,
      "text": "जब फ्यूचर में बहुत सारी जॉब्स क्रिएट"
    },
    {
      "subtitle_id": 103,
      "start": 227.92,
      "end": 232.64,
      "text": "होगी। पर क्या ऐसा हो रहा है? वो चेक करने"
    },
    {
      "subtitle_id": 104,
      "start": 230.56,
      "end": 234.72,
      "text": "के लिए हमने और एक डाटा खंगाला कि कितने"
    },
    {
      "subtitle_id": 105,
      "start": 232.64,
      "end": 237.12,
      "text": "नए जॉब्स मंथली बेसिस पर क्रिएट हो रहे"
    },
    {
      "subtitle_id": 106,
      "start": 234.72,
      "end": 240.159,
      "text": "हैं। और यह नंबर्स देखकर आपको पिक्चर बहुत"
    },
    {
      "subtitle_id": 107,
      "start": 237.12,
      "end": 242.959,
      "text": "ज्यादा क्लियर हो जाएगी। 2025 में मंथली"
    },
    {
      "subtitle_id": 108,
      "start": 240.159,
      "end": 245.76,
      "text": "जॉब एवरेज सिर्फ 85,000 रही है। जबकि"
    },
    {
      "subtitle_id": 109,
      "start": 242.959,
      "end": 248.239,
      "text": "पेंडेमिक से पहले यह ₹1,77,000"
    },
    {
      "subtitle_id": 110,
      "start": 245.76,
      "end": 250.64,
      "text": "थी। यानी जॉब क्रिएट होने की स्पीड आधी से"
    },
    {
      "subtitle_id": 111,
      "start": 248.239,
      "end": 253.76,
      "text": "कम हो चुकी है और सिर्फ अगस्त को ही देखा"
    },
    {
      "subtitle_id": 112,
      "start": 250.64,
      "end": 256.239,
      "text": "जाए तो एक्सपेक्टेड था कि 75,000 जॉब्स ऐड"
    },
    {
      "subtitle_id": 113,
      "start": 253.76,
      "end": 258.959,
      "text": "होंगी। पर असल में और बहुत शॉकिंग चीज है"
    },
    {
      "subtitle_id": 114,
      "start": 256.239,
      "end": 261.6,
      "text": "कि सिर्फ 22,000 जॉब्स क्रिएट हुई है।"
    },
    {
      "subtitle_id": 115,
      "start": 258.959,
      "end": 263.759,
      "text": "इतनी बड़ी कंट्री के लिए 22,000 जॉब्स इज"
    },
    {
      "subtitle_id": 116,
      "start": 261.6,
      "end": 267.12,
      "text": "नथिंग। यानी जॉब्स तो क्रिएट नहीं हो रहे"
    },
    {
      "subtitle_id": 117,
      "start": 263.759,
      "end": 269.199,
      "text": "हैं। पर उससे ज्यादा खतरनाक चीज है कि 53%"
    },
    {
      "subtitle_id": 118,
      "start": 267.12,
      "end": 271.84,
      "text": "इंडस्ट्रीज जॉब कट कर रही है। और"
    },
    {
      "subtitle_id": 119,
      "start": 269.199,
      "end": 275.04,
      "text": "हिस्टोरिकली हमने देखा है कि जबजब यह नंबर"
    },
    {
      "subtitle_id": 120,
      "start": 271.84,
      "end": 277.36,
      "text": "50% के ऊपर चला जाता है। वो हमेशा रिसेशन"
    },
    {
      "subtitle_id": 121,
      "start": 275.04,
      "end": 280.0,
      "text": "का एक क्लियर सिग्नल होता है। लॉन्ग टर्म"
    },
    {
      "subtitle_id": 122,
      "start": 277.36,
      "end": 282.639,
      "text": "अनइंप्लॉयमेंट भी शार्पली बढ़ रही है। 27"
    },
    {
      "subtitle_id": 123,
      "start": 280.0,
      "end": 286.24,
      "text": "वीक से अनइंप्लॉयड लोगों की संख्या एक साल"
    },
    {
      "subtitle_id": 124,
      "start": 282.639,
      "end": 288.8,
      "text": "में 3,85,000 बढ़ गई और अब टोटल 1.9"
    },
    {
      "subtitle_id": 125,
      "start": 286.24,
      "end": 291.84,
      "text": "मिलियन यानी 19 लाख लोग इस कैटेगरी में आ"
    },
    {
      "subtitle_id": 126,
      "start": 288.8,
      "end": 294.08,
      "text": "गए हैं। और जून 2025 में तो एक बहुत बड़ा"
    },
    {
      "subtitle_id": 127,
      "start": 291.84,
      "end": 296.4,
      "text": "शॉक आया कि पिछले 4 सालों में पहली बार"
    },
    {
      "subtitle_id": 128,
      "start": 294.08,
      "end": 298.479,
      "text": "जॉब्स में नेट डिक्लाइन हुआ है अराउंड"
    },
    {
      "subtitle_id": 129,
      "start": 296.4,
      "end": 300.72,
      "text": "13,000 जॉब्स का लॉस। यानी आप"
    },
    {
      "subtitle_id": 130,
      "start": 298.479,
      "end": 303.28,
      "text": "अनइंप्लॉयमेंट का डाटा देख लो, न्यू जॉब"
    },
    {
      "subtitle_id": 131,
      "start": 300.72,
      "end": 305.759,
      "text": "क्रिएशन का डाटा देख लो या फिर इंडस्ट्रीज"
    },
    {
      "subtitle_id": 132,
      "start": 303.28,
      "end": 308.0,
      "text": "के लेऑफ का डाटा देख लो। सब लगातार एक ही"
    },
    {
      "subtitle_id": 133,
      "start": 305.759,
      "end": 310.16,
      "text": "तरफ इशारा कर रहे हैं कि रिसेशन इज कमिंग"
    },
    {
      "subtitle_id": 134,
      "start": 308.0,
      "end": 311.919,
      "text": "इन यूएसए। और अगर हम मैन्युफैक्चरिंग"
    },
    {
      "subtitle_id": 135,
      "start": 310.16,
      "end": 313.52,
      "text": "सेक्टर की बात करें जिसे अट्रैक्ट करने के"
    },
    {
      "subtitle_id": 136,
      "start": 311.919,
      "end": 315.759,
      "text": "लिए डॉन्ड ट्रंप बहुत सारी चीजें कर रहे"
    },
    {
      "subtitle_id": 137,
      "start": 313.52,
      "end": 318.4,
      "text": "हैं। तो इस सेक्टर की तरफ नजर डालोगे तो"
    },
    {
      "subtitle_id": 138,
      "start": 315.759,
      "end": 320.16,
      "text": "चीजें और भी भयंकर नजर आ रही है। ट्रंप के"
    },
    {
      "subtitle_id": 139,
      "start": 318.4,
      "end": 322.4,
      "text": "टेरिफ के बावजूद यूएस मैन्युफैक्चरिंग"
    },
    {
      "subtitle_id": 140,
      "start": 320.16,
      "end": 324.4,
      "text": "लगातार 6 महीने से गिर रही है। और सिर्फ"
    },
    {
      "subtitle_id": 141,
      "start": 322.4,
      "end": 326.639,
      "text": "इस साल में अब तक 78,000 जॉब्स"
    },
    {
      "subtitle_id": 142,
      "start": 324.4,
      "end": 328.639,
      "text": "मैन्युफैक्चरिंग सेक्टर में चली गई है। और"
    },
    {
      "subtitle_id": 143,
      "start": 326.639,
      "end": 330.96,
      "text": "अगस्त मंथ की बात करें तो सिर्फ इस एक"
    },
    {
      "subtitle_id": 144,
      "start": 328.639,
      "end": 332.96,
      "text": "महीने में इस सेक्टर से 12,000 जॉब्स खत्म"
    },
    {
      "subtitle_id": 145,
      "start": 330.96,
      "end": 335.039,
      "text": "हो चुकी है। ट्रंप ने यह वादा किया था"
    },
    {
      "subtitle_id": 146,
      "start": 332.96,
      "end": 337.44,
      "text": "लोगों से कि मैं जॉब्स लाऊंगा बल्कि यहां"
    },
    {
      "subtitle_id": 147,
      "start": 335.039,
      "end": 339.28,
      "text": "पर उल्टा हो रहा है। मैन्युफैक्चरर्स तो"
    },
    {
      "subtitle_id": 148,
      "start": 337.44,
      "end": 341.6,
      "text": "यहां खुद कह रहे हैं कि आज की जो सिचुएशन"
    },
    {
      "subtitle_id": 149,
      "start": 339.28,
      "end": 343.84,
      "text": "है वह ग्रेट रिसेशन से भी ज्यादा बुरी है।"
    },
    {
      "subtitle_id": 150,
      "start": 341.6,
      "end": 346.08,
      "text": "और सबसे बड़ी बात टेरिफ के चलते कंपनीज़"
    },
    {
      "subtitle_id": 151,
      "start": 343.84,
      "end": 348.8,
      "text": "हायरिंग फ्रीज़ कर रही है। नए लोगों को"
    },
    {
      "subtitle_id": 152,
      "start": 346.08,
      "end": 350.88,
      "text": "रखना तो दूर जो स्टाफ उनके पास है उन्हें"
    },
    {
      "subtitle_id": 153,
      "start": 348.8,
      "end": 353.28,
      "text": "सस्टेन करना भी इनके लिए टफ जा रहा है। अब"
    },
    {
      "subtitle_id": 154,
      "start": 350.88,
      "end": 355.52,
      "text": "यह तो दो तरफ की तकलीफ है। लेकिन यूएसए"
    },
    {
      "subtitle_id": 155,
      "start": 353.28,
      "end": 357.52,
      "text": "फिलहाल चारों तरफ से तकलीफों से घिरा हुआ"
    },
    {
      "subtitle_id": 156,
      "start": 355.52,
      "end": 359.44,
      "text": "है। क्योंकि इन सब प्रॉब्लम्स के साथ-साथ"
    },
    {
      "subtitle_id": 157,
      "start": 357.52,
      "end": 361.759,
      "text": "एक और बड़ी प्रॉब्लम भी है और वो है"
    },
    {
      "subtitle_id": 158,
      "start": 359.44,
      "end": 364.0,
      "text": "इनफ्लेशन की। यानी कि एक तरफ"
    },
    {
      "subtitle_id": 159,
      "start": 361.759,
      "end": 366.4,
      "text": "अनइंप्लॉयमेंट तो दूसरी तरफ टेरिफ की वजह"
    },
    {
      "subtitle_id": 160,
      "start": 364.0,
      "end": 368.56,
      "text": "कई सारी चीजें महंगी हो रही है। जिसकी वजह"
    },
    {
      "subtitle_id": 161,
      "start": 366.4,
      "end": 371.28,
      "text": "से इनफ्लेशन बहुत तेजी से बढ़ रहा है।"
    },
    {
      "subtitle_id": 162,
      "start": 368.56,
      "end": 373.6,
      "text": "इनफ्लेशन अगस्त में बढ़कर 2.9% हो गया जो"
    },
    {
      "subtitle_id": 163,
      "start": 371.28,
      "end": 375.68,
      "text": "जनवरी के बाद सबसे ज्यादा है। पहले"
    },
    {
      "subtitle_id": 164,
      "start": 373.6,
      "end": 377.6,
      "text": "इनफ्लेशन धीरे-धीरे कूलडाउन हो रहा था।"
    },
    {
      "subtitle_id": 165,
      "start": 375.68,
      "end": 379.919,
      "text": "लेकिन ट्रंप के आने के बाद फिर से गर्मी"
    },
    {
      "subtitle_id": 166,
      "start": 377.6,
      "end": 381.84,
      "text": "चढ़ गई। और अगर अलग-अलग कैटेगरीज में देखा"
    },
    {
      "subtitle_id": 167,
      "start": 379.919,
      "end": 384.639,
      "text": "जाए तो तस्वीर आपको और क्लियर हो जाएगी।"
    },
    {
      "subtitle_id": 168,
      "start": 381.84,
      "end": 387.199,
      "text": "तो देखिए फूड प्राइसेस 3.2% से बढ़ गए।"
    },
    {
      "subtitle_id": 169,
      "start": 384.639,
      "end": 390.08,
      "text": "यूज्ड कार की प्राइसेस में 6% का सर्च आया"
    },
    {
      "subtitle_id": 170,
      "start": 387.199,
      "end": 392.479,
      "text": "है। एनर्जी कॉस्ट 7 महीनों बाद पहली बार"
    },
    {
      "subtitle_id": 171,
      "start": 390.08,
      "end": 395.68,
      "text": "ऊपर गए और कोर इनफ्लेशन भी यहां पर हाई है"
    },
    {
      "subtitle_id": 172,
      "start": 392.479,
      "end": 397.6,
      "text": "अराउंड 3.1% का। यानी वहां के एक आम आदमी"
    },
    {
      "subtitle_id": 173,
      "start": 395.68,
      "end": 400.16,
      "text": "के लिए लगातार चीजें महंगी होती जा रही"
    },
    {
      "subtitle_id": 174,
      "start": 397.6,
      "end": 401.6,
      "text": "है। इसीलिए जो फेडरल रिजर्व है जो वहां पर"
    },
    {
      "subtitle_id": 175,
      "start": 400.16,
      "end": 404.24,
      "text": "डिसाइड करता है कि इंटरेस्ट रेट कितने"
    },
    {
      "subtitle_id": 176,
      "start": 401.6,
      "end": 406.639,
      "text": "रखने हैं वो भी फिलहाल एकदम कंफ्यूज्ड है"
    },
    {
      "subtitle_id": 177,
      "start": 404.24,
      "end": 408.88,
      "text": "कि कम इंटरेस्ट रेट रखूं तो महंगाई और बढ़"
    },
    {
      "subtitle_id": 178,
      "start": 406.639,
      "end": 410.88,
      "text": "सकती है और ज्यादा रखूं तो इकॉनमी इसी तरह"
    },
    {
      "subtitle_id": 179,
      "start": 408.88,
      "end": 412.96,
      "text": "से स्लो स्पीड से आगे बढ़ेगी। पूरी तरह से"
    },
    {
      "subtitle_id": 180,
      "start": 410.88,
      "end": 415.12,
      "text": "दुविधा में और इसी के चलते पिछले कुछ"
    },
    {
      "subtitle_id": 181,
      "start": 412.96,
      "end": 417.28,
      "text": "महीनों में आपने देखा होगा ट्रंप और फेडरल"
    },
    {
      "subtitle_id": 182,
      "start": 415.12,
      "end": 420.08,
      "text": "रिजर्व के जो चीफ है उनके बीच तू तू मैंम"
    },
    {
      "subtitle_id": 183,
      "start": 417.28,
      "end": 422.0,
      "text": "हो रही है। अब इन सब चीजों के बावजूद भी"
    },
    {
      "subtitle_id": 184,
      "start": 420.08,
      "end": 424.08,
      "text": "ट्रंप टेरिफ यहां पर रुकने का नाम नहीं ले"
    },
    {
      "subtitle_id": 185,
      "start": 422.0,
      "end": 426.96,
      "text": "रहे हैं। आज के टाइम में वहां पर जो एवरेज"
    },
    {
      "subtitle_id": 186,
      "start": 424.08,
      "end": 430.08,
      "text": "टेरिफ रेट है वो 19.5% तक पहुंच चुका है"
    },
    {
      "subtitle_id": 187,
      "start": 426.96,
      "end": 432.56,
      "text": "जो 1933 के बाद सबसे ज्यादा है और यह नंबर"
    },
    {
      "subtitle_id": 188,
      "start": 430.08,
      "end": 434.639,
      "text": "और भी बढ़ेगा। क्यों आपको पता चलेगा?"
    },
    {
      "subtitle_id": 189,
      "start": 432.56,
      "end": 437.12,
      "text": "स्टील और एलुमिनियम पर भी जो टेरिफ है वह"
    },
    {
      "subtitle_id": 190,
      "start": 434.639,
      "end": 439.52,
      "text": "काफी हैवी है। डायरेक्ट 50% तक बढ़ गए हैं"
    },
    {
      "subtitle_id": 191,
      "start": 437.12,
      "end": 441.759,
      "text": "और जिसका कंपनीज़ पर सीधा असर दिख रहा है"
    },
    {
      "subtitle_id": 192,
      "start": 439.52,
      "end": 444.72,
      "text": "और इस चीज का कंपनीज़ पर सीधा असर दिख रहा"
    },
    {
      "subtitle_id": 193,
      "start": 441.759,
      "end": 447.44,
      "text": "है। जॉन डियर को सिर्फ 2025 में ही टेरिफ"
    },
    {
      "subtitle_id": 194,
      "start": 444.72,
      "end": 450.639,
      "text": "की वजह से 600 मिलियन का एक्स्ट्रा कॉस्ट"
    },
    {
      "subtitle_id": 195,
      "start": 447.44,
      "end": 453.039,
      "text": "फेस करना पड़ा और उन्होंने 238 लोगों को"
    },
    {
      "subtitle_id": 196,
      "start": 450.639,
      "end": 454.4,
      "text": "कंपनी से निकाल दिया। यानी कि इससे"
    },
    {
      "subtitle_id": 197,
      "start": 453.039,
      "end": 456.4,
      "text": "एग्रीकल्चरल इक्विपमेंट और"
    },
    {
      "subtitle_id": 198,
      "start": 454.4,
      "end": 457.919,
      "text": "मैन्युफैक्चरिंग सेक्टर दोनों अफेक्ट हो"
    },
    {
      "subtitle_id": 199,
      "start": 456.4,
      "end": 460.16,
      "text": "रहे हैं। एक्सपर्ट्स का कहना है कि"
    },
    {
      "subtitle_id": 200,
      "start": 457.919,
      "end": 462.56,
      "text": "स्लोडाउन के पीछे दो मेन कारण हैं। पहला"
    },
    {
      "subtitle_id": 201,
      "start": 460.16,
      "end": 464.88,
      "text": "है ट्रंप के टेरिफ और दूसरा है मॉडरेटिंग"
    },
    {
      "subtitle_id": 202,
      "start": 462.56,
      "end": 466.72,
      "text": "नेट इमीग्रेशन। क्योंकि ट्रंप यूएस की"
    },
    {
      "subtitle_id": 203,
      "start": 464.88,
      "end": 468.96,
      "text": "इकॉनमी को बिल्कुल क्लोज इकॉनमी बनाना"
    },
    {
      "subtitle_id": 204,
      "start": 466.72,
      "end": 471.039,
      "text": "चाहते हैं। जोरदार टेरिफ लगा रहे हैं और"
    },
    {
      "subtitle_id": 205,
      "start": 468.96,
      "end": 473.919,
      "text": "दूसरी तरफ इमीग्रेशन पर रोक लगा रहे हैं"
    },
    {
      "subtitle_id": 206,
      "start": 471.039,
      "end": 475.759,
      "text": "इंक्लूडिंग द लीगल वंस यानी कि H1B। जबकि"
    },
    {
      "subtitle_id": 207,
      "start": 473.919,
      "end": 477.759,
      "text": "सबको पता है कि आज की वहां की कई सारी टॉप"
    },
    {
      "subtitle_id": 208,
      "start": 475.759,
      "end": 479.759,
      "text": "कंपनीज भी इमीग्रेंट्स ने बिल्ड की है।"
    },
    {
      "subtitle_id": 209,
      "start": 477.759,
      "end": 481.68,
      "text": "इंक्लूडिंग ईलॉन मस्क जो कि दुनिया के"
    },
    {
      "subtitle_id": 210,
      "start": 479.759,
      "end": 484.479,
      "text": "फिलहाल रिचेस्ट पर्सन है। अब हम बात"
    },
    {
      "subtitle_id": 211,
      "start": 481.68,
      "end": 486.879,
      "text": "करेंगे एक ऐसे इंडिकेटर की जिसने 1950 के"
    },
    {
      "subtitle_id": 212,
      "start": 484.479,
      "end": 488.96,
      "text": "बाद हर एक रिसेशन को सही तरह से प्रेडिक्ट"
    },
    {
      "subtitle_id": 213,
      "start": 486.879,
      "end": 491.84,
      "text": "किया। अब आप कहेंगे यह कौन सा इंडिकेटर"
    },
    {
      "subtitle_id": 214,
      "start": 488.96,
      "end": 493.599,
      "text": "है? तो इसका नाम है सैम रूल। यह एक सिंपल"
    },
    {
      "subtitle_id": 215,
      "start": 491.84,
      "end": 495.919,
      "text": "रियल टाइम रिसेशन इंडिकेटर है जो"
    },
    {
      "subtitle_id": 216,
      "start": 493.599,
      "end": 498.24,
      "text": "इकोनॉमिस्ट क्लॉडिया सैम ने बनाया था और"
    },
    {
      "subtitle_id": 217,
      "start": 495.919,
      "end": 500.16,
      "text": "1950 से लेकर आज तक इन्होंने हर रिसेशन को"
    },
    {
      "subtitle_id": 218,
      "start": 498.24,
      "end": 502.319,
      "text": "सही तरह से प्रेडिक्ट किया है। रूल का"
    },
    {
      "subtitle_id": 219,
      "start": 500.16,
      "end": 504.24,
      "text": "लॉजिक बहुत ही सीधा है। अगर 3 मंथ"
    },
    {
      "subtitle_id": 220,
      "start": 502.319,
      "end": 506.96,
      "text": "अनइंप्लॉयमेंट एवरेज अपने 12 मंथ के"
    },
    {
      "subtitle_id": 221,
      "start": 504.24,
      "end": 509.599,
      "text": "लोएस्ट से 0.5% ज्यादा हो जाए तो इसका"
    },
    {
      "subtitle_id": 222,
      "start": 506.96,
      "end": 511.759,
      "text": "मतलब है कि इकॉनमी रिसेशन में घुस रही है।"
    },
    {
      "subtitle_id": 223,
      "start": 509.599,
      "end": 514.8,
      "text": "एग्जांपल के लिए मान लीजिए पिछले 3 महीने"
    },
    {
      "subtitle_id": 224,
      "start": 511.759,
      "end": 517.599,
      "text": "का एवरेज अनइंप्लॉयमेंट रेट है 4.5% का और"
    },
    {
      "subtitle_id": 225,
      "start": 514.8,
      "end": 520.64,
      "text": "पिछले 12 महीने का जो लोएस्ट है वो 4% था।"
    },
    {
      "subtitle_id": 226,
      "start": 517.599,
      "end": 522.959,
      "text": "दोनों के बीच का डिफरेंस 0.5% आया। यानी"
    },
    {
      "subtitle_id": 227,
      "start": 520.64,
      "end": 525.519,
      "text": "सैम रूल के हिसाब से रिसेशन स्टार्ट हो"
    },
    {
      "subtitle_id": 228,
      "start": 522.959,
      "end": 527.44,
      "text": "चुका है। अब यूएसए के एक्चुअल नंबर देखें"
    },
    {
      "subtitle_id": 229,
      "start": 525.519,
      "end": 530.32,
      "text": "तो जून, जुलाई, अगस्त के नंबर्स आप देख"
    },
    {
      "subtitle_id": 230,
      "start": 527.44,
      "end": 533.04,
      "text": "सकते हो। 3 मंथ का एवरेज होता है 4.2%, 12"
    },
    {
      "subtitle_id": 231,
      "start": 530.32,
      "end": 537.2,
      "text": "मंथ का लोएस्ट होता है 4.1% यानी डिफरेंस"
    },
    {
      "subtitle_id": 232,
      "start": 533.04,
      "end": 539.519,
      "text": "आता है 0.1% का व्हिच इज वेल बिलो 0.5%।"
    },
    {
      "subtitle_id": 233,
      "start": 537.2,
      "end": 541.44,
      "text": "बट वेट अ मिनट। क्या यह अनइंप्लॉयमेंट के"
    },
    {
      "subtitle_id": 234,
      "start": 539.519,
      "end": 544.0,
      "text": "जो नंबर्स हैं वो सही है? अभी फर्स्ट"
    },
    {
      "subtitle_id": 235,
      "start": 541.44,
      "end": 546.32,
      "text": "अगस्त 2025 को प्रेसिडेंट ट्रंप ने"
    },
    {
      "subtitle_id": 236,
      "start": 544.0,
      "end": 549.44,
      "text": "कमिश्नर ऑफ ब्यूरो लेबर स्टैटिस्टिक्स"
    },
    {
      "subtitle_id": 237,
      "start": 546.32,
      "end": 551.12,
      "text": "एररिका मैकफर को फायर कर दिया। क्यों?"
    },
    {
      "subtitle_id": 238,
      "start": 549.44,
      "end": 553.839,
      "text": "क्योंकि उन्होंने जो खराब जॉब रिपोर्ट्स"
    },
    {
      "subtitle_id": 239,
      "start": 551.12,
      "end": 555.92,
      "text": "हैं उनका डाटा कई बार रिवाइज किया था और"
    },
    {
      "subtitle_id": 240,
      "start": 553.839,
      "end": 558.32,
      "text": "यह चीज ट्रंप को पसंद नहीं आई। इस रिपोर्ट"
    },
    {
      "subtitle_id": 241,
      "start": 555.92,
      "end": 560.64,
      "text": "के आने के कुछ ही घंटे बाद उन्हें जॉब से"
    },
    {
      "subtitle_id": 242,
      "start": 558.32,
      "end": 562.48,
      "text": "फायर कर दिया गया। सो अनफॉर्चूनेटली यह"
    },
    {
      "subtitle_id": 243,
      "start": 560.64,
      "end": 564.56,
      "text": "रूल करंट सिनेरियो में पॉसिबल ही नहीं है"
    },
    {
      "subtitle_id": 244,
      "start": 562.48,
      "end": 567.2,
      "text": "क्योंकि नंबर्स क्या है लास्ट 2 महीने के"
    },
    {
      "subtitle_id": 245,
      "start": 564.56,
      "end": 569.279,
      "text": "उस पर किसी को भी विश्वास नहीं हो रहा है।"
    },
    {
      "subtitle_id": 246,
      "start": 567.2,
      "end": 571.279,
      "text": "और यह रियलिटी है। बट दूसरे सारे"
    },
    {
      "subtitle_id": 247,
      "start": 569.279,
      "end": 573.04,
      "text": "इंडिकेटर्स उठा के देख लो। नंबर्स ऑफ न्यू"
    },
    {
      "subtitle_id": 248,
      "start": 571.279,
      "end": 574.88,
      "text": "ऑर्डर्स इन मैन्युफैक्चरिंग, गिरती हुई"
    },
    {
      "subtitle_id": 249,
      "start": 573.04,
      "end": 576.959,
      "text": "कंज्यूमर्स पेंडिंग, अनइंप्लॉयमेंट"
    },
    {
      "subtitle_id": 250,
      "start": 574.88,
      "end": 579.519,
      "text": "क्लेम्स का बढ़ना और मैन्युफैक्चरिंग"
    },
    {
      "subtitle_id": 251,
      "start": 576.959,
      "end": 581.6,
      "text": "आवर्स के कम होना। यानी हर तरफ से एक-एक"
    },
    {
      "subtitle_id": 252,
      "start": 579.519,
      "end": 583.2,
      "text": "कहानी सुनाई दे रही है। अब बात करते हैं"
    },
    {
      "subtitle_id": 253,
      "start": 581.6,
      "end": 584.8,
      "text": "इन चीजों का। ग्लोबल इंपैक्ट क्या होगा?"
    },
    {
      "subtitle_id": 254,
      "start": 583.2,
      "end": 586.88,
      "text": "भारत पर क्या इंपैक्ट होगा? बाकी कंट्रीज"
    },
    {
      "subtitle_id": 255,
      "start": 584.8,
      "end": 588.72,
      "text": "पर इंपैक्ट क्या होगा? आपने कहावत तो सुनी"
    },
    {
      "subtitle_id": 256,
      "start": 586.88,
      "end": 590.959,
      "text": "होगी कि हम तो डूबेंगे सनम तुम्हें भी ले"
    },
    {
      "subtitle_id": 257,
      "start": 588.72,
      "end": 592.959,
      "text": "डूबेंगे। यह आज के समय में सही होती हुई"
    },
    {
      "subtitle_id": 258,
      "start": 590.959,
      "end": 594.8,
      "text": "दिखाई दे रही है। जैसे इंडिया की बात करें"
    },
    {
      "subtitle_id": 259,
      "start": 592.959,
      "end": 597.12,
      "text": "तो ट्रंप के डिसीजंस का डायरेक्ट इंपैक्ट"
    },
    {
      "subtitle_id": 260,
      "start": 594.8,
      "end": 598.56,
      "text": "इंडिया पर भी आ रहा है। यूएस रिसेशन का"
    },
    {
      "subtitle_id": 261,
      "start": 597.12,
      "end": 600.0,
      "text": "सीधा मतलब होगा कि इंडिया की जो आईटी"
    },
    {
      "subtitle_id": 262,
      "start": 598.56,
      "end": 602.16,
      "text": "आउटसोर्सिंग कंपनीज़ है वो भी इंपैक्ट"
    },
    {
      "subtitle_id": 263,
      "start": 600.0,
      "end": 604.16,
      "text": "होगी। उन्हें कम ऑर्डर्स आएंगे। जबकि आईटी"
    },
    {
      "subtitle_id": 264,
      "start": 602.16,
      "end": 606.08,
      "text": "कंपनीज ऑलरेडी प्रेशर में है। उनके शेयर्स"
    },
    {
      "subtitle_id": 265,
      "start": 604.16,
      "end": 607.839,
      "text": "भी प्रेशर में हैं। फार्मा पर भी अभी"
    },
    {
      "subtitle_id": 266,
      "start": 606.08,
      "end": 609.76,
      "text": "उन्होंने कुछ ही घंटे पहले टेरिफ लगा"
    },
    {
      "subtitle_id": 267,
      "start": 607.839,
      "end": 611.839,
      "text": "दिया। तो उसका भी अच्छा खासा असर इंडियन"
    },
    {
      "subtitle_id": 268,
      "start": 609.76,
      "end": 614.24,
      "text": "फार्मा कंपनीज़ पर पड़ेगा। और भी कई सारी"
    },
    {
      "subtitle_id": 269,
      "start": 611.839,
      "end": 616.24,
      "text": "इंडस्ट्रीज हैं। टेक्सटाइल एंड एपल्स 50%"
    },
    {
      "subtitle_id": 270,
      "start": 614.24,
      "end": 617.68,
      "text": "टेरिफ ने ऑर्डर्स रोक दिए हैं। क्योंकि"
    },
    {
      "subtitle_id": 271,
      "start": 616.24,
      "end": 619.2,
      "text": "इंडिया के जो रेडीमेड गारमेंट्स का"
    },
    {
      "subtitle_id": 272,
      "start": 617.68,
      "end": 621.12,
      "text": "एक्सपोर्ट यूएस की डिमांड पर ही ज्यादा"
    },
    {
      "subtitle_id": 273,
      "start": 619.2,
      "end": 622.88,
      "text": "डिपेंड करता था। जेम्स एंड ज्वेलरी यह"
    },
    {
      "subtitle_id": 274,
      "start": 621.12,
      "end": 625.04,
      "text": "सेक्टर भी बहुत ही वनरेबल है। फिलहाल"
    },
    {
      "subtitle_id": 275,
      "start": 622.88,
      "end": 626.88,
      "text": "टेरिफ की वजह से सी फूड मरीन प्रोडक्ट्स"
    },
    {
      "subtitle_id": 276,
      "start": 625.04,
      "end": 628.64,
      "text": "यहां पर भी हम इंपैक्ट हो रहे हैं। तो आप"
    },
    {
      "subtitle_id": 277,
      "start": 626.88,
      "end": 631.04,
      "text": "देख सकते हो कि यूएस के जो पॉलिसीज हैं,"
    },
    {
      "subtitle_id": 278,
      "start": 628.64,
      "end": 632.72,
      "text": "रिसेशन और टेरिफ है उनका असर सिर्फ यूएस"
    },
    {
      "subtitle_id": 279,
      "start": 631.04,
      "end": 635.36,
      "text": "पर नहीं पड़ रहा है। पर अगर पूरी दुनिया"
    },
    {
      "subtitle_id": 280,
      "start": 632.72,
      "end": 637.76,
      "text": "पर पड़ रहा है इंक्लूडिंग इंडिया जहां पर"
    },
    {
      "subtitle_id": 281,
      "start": 635.36,
      "end": 639.6,
      "text": "हमारी भी जॉब्स हमारी भी कंपनीज़ इंपैक्ट"
    },
    {
      "subtitle_id": 282,
      "start": 637.76,
      "end": 641.76,
      "text": "होगी। बाकी कंट्रीज की बात करें तो"
    },
    {
      "subtitle_id": 283,
      "start": 639.6,
      "end": 643.839,
      "text": "ब्राजील की कॉफी पर इन्होंने 50% टेरिफ"
    },
    {
      "subtitle_id": 284,
      "start": 641.76,
      "end": 646.32,
      "text": "मारा है। साउथ कोरिया के साथ इनका इशू चल"
    },
    {
      "subtitle_id": 285,
      "start": 643.839,
      "end": 648.8,
      "text": "रहा है। स्विट्जरलैंड पर 39% टेरिफ मारा"
    },
    {
      "subtitle_id": 286,
      "start": 646.32,
      "end": 651.04,
      "text": "है। ब्रांडेड और पेटेंटेड मेडिसिंस बहुत"
    },
    {
      "subtitle_id": 287,
      "start": 648.8,
      "end": 653.839,
      "text": "ज्यादा स्विट्जरलैंड से आती है। उस पर तो"
    },
    {
      "subtitle_id": 288,
      "start": 651.04,
      "end": 656.079,
      "text": "उन्होंने 100% टेरिफ लगाया है। आयरलैंड"
    },
    {
      "subtitle_id": 289,
      "start": 653.839,
      "end": 658.48,
      "text": "क्लोज टू 45 मिलियन वर्थ ऑफ फार्मा"
    },
    {
      "subtitle_id": 290,
      "start": 656.079,
      "end": 660.64,
      "text": "एक्सपोर्ट करता है। उस पर 100% टेरिफ लगा"
    },
    {
      "subtitle_id": 291,
      "start": 658.48,
      "end": 662.959,
      "text": "है। यानी दुनिया भर की कंट्रीज ले लो छोटी"
    },
    {
      "subtitle_id": 292,
      "start": 660.64,
      "end": 664.959,
      "text": "से छोटी बड़ी से बड़ी। इंपैक्टेड तो है ही"
    },
    {
      "subtitle_id": 293,
      "start": 662.959,
      "end": 667.12,
      "text": "है। यानी कि सिंपल है कि डोन्ड ट्रंप"
    },
    {
      "subtitle_id": 294,
      "start": 664.959,
      "end": 669.6,
      "text": "डूबेंगे तो डूबेंगे यूएस को लेकर साथ में"
    },
    {
      "subtitle_id": 295,
      "start": 667.12,
      "end": 671.519,
      "text": "बाकी लोगों को भी लेकर डूबेंगे। कुछ दिन"
    },
    {
      "subtitle_id": 296,
      "start": 669.6,
      "end": 674.0,
      "text": "पहले मैं रेड एलियो जो कि एक बहुत बड़े"
    },
    {
      "subtitle_id": 297,
      "start": 671.519,
      "end": 676.16,
      "text": "हेच फंड के मालिक है यूएस में। उनका एक"
    },
    {
      "subtitle_id": 298,
      "start": 674.0,
      "end": 678.56,
      "text": "पॉडकास्ट देख रहा था जहां पर उन्होंने कहा"
    },
    {
      "subtitle_id": 299,
      "start": 676.16,
      "end": 680.48,
      "text": "कि वी आर हेडिंग इंटू अ वेरी वेरी डार्क"
    },
    {
      "subtitle_id": 300,
      "start": 678.56,
      "end": 682.16,
      "text": "टाइम। तो ऐसा नहीं है कि वहां के जो यूएस"
    },
    {
      "subtitle_id": 301,
      "start": 680.48,
      "end": 684.16,
      "text": "के लोग हैं, बिजनेसमैन है उनके लिए पिक्चर"
    },
    {
      "subtitle_id": 302,
      "start": 682.16,
      "end": 686.32,
      "text": "क्लियर नहीं है। पिक्चर सबके लिए क्लियर"
    },
    {
      "subtitle_id": 303,
      "start": 684.16,
      "end": 688.32,
      "text": "हो चुकी है और दिन-बदिन चीजें खराब होती"
    },
    {
      "subtitle_id": 304,
      "start": 686.32,
      "end": 689.92,
      "text": "जा रही है। और इसी के चलते इंडियन मार्केट"
    },
    {
      "subtitle_id": 305,
      "start": 688.32,
      "end": 692.24,
      "text": "पे आप देखेंगे तो पिछले चार-प दिनों से"
    },
    {
      "subtitle_id": 306,
      "start": 689.92,
      "end": 693.839,
      "text": "लगातार गिर रहा है। काफी वोलेटाइल है। तो"
    },
    {
      "subtitle_id": 307,
      "start": 692.24,
      "end": 696.079,
      "text": "दिक्कत होना शुरू हो गया। अभी जो भी"
    },
    {
      "subtitle_id": 308,
      "start": 693.839,
      "end": 698.32,
      "text": "उन्होंने डिसीजंस लिए पिछले आठ महीनों में"
    },
    {
      "subtitle_id": 309,
      "start": 696.079,
      "end": 700.24,
      "text": "उसका इंपैक्ट अब धीरे-धीरे पड़ना शुरू हो"
    },
    {
      "subtitle_id": 310,
      "start": 698.32,
      "end": 702.0,
      "text": "चुका है और एक रिपल इफेक्ट की तरह यह हर"
    },
    {
      "subtitle_id": 311,
      "start": 700.24,
      "end": 703.2,
      "text": "जगह जाएगा। तो देखते हैं आने वाले टाइम"
    },
    {
      "subtitle_id": 312,
      "start": 702.0,
      "end": 705.04,
      "text": "में क्या नंबर्स आते हैं हम आप तक"
    },
    {
      "subtitle_id": 313,
      "start": 703.2,
      "end": 707.2,
      "text": "पहुंचाते हैं। लेकिन करेंटली अगर देखें तो"
    },
    {
      "subtitle_id": 314,
      "start": 705.04,
      "end": 709.279,
      "text": "यूएस एक सही पोजीशन पर नहीं है। बहुत ही"
    },
    {
      "subtitle_id": 315,
      "start": 707.2,
      "end": 710.959,
      "text": "खराब पोजीशन पे है। लेकिन ऐसा ही जारी रहा"
    },
    {
      "subtitle_id": 316,
      "start": 709.279,
      "end": 712.72,
      "text": "तो खुद तो रिसेशन में जाएंगे ही जाएंगे।"
    },
    {
      "subtitle_id": 317,
      "start": 710.959,
      "end": 714.64,
      "text": "बाकी कंट्रीज को भी वो तकलीफ देंगे ही"
    },
    {
      "subtitle_id": 318,
      "start": 712.72,
      "end": 716.56,
      "text": "देंगे। तो यही सारी चीजें आप तक पहुंचानी"
    },
    {
      "subtitle_id": 319,
      "start": 714.64,
      "end": 718.24,
      "text": "थी। ये डराने धमकाने वाली बात नहीं है। बट"
    },
    {
      "subtitle_id": 320,
      "start": 716.56,
      "end": 720.399,
      "text": "ये जो नंबर्स मैंने आपको बताएं इन्हें आप"
    },
    {
      "subtitle_id": 321,
      "start": 718.24,
      "end": 722.32,
      "text": "भी ट्रैक कीजिए मंथ ऑन मंथ बेसिस पर। उससे"
    },
    {
      "subtitle_id": 322,
      "start": 720.399,
      "end": 724.56,
      "text": "आपको क्लैरिटी रहेगी क्योंकि प्रिपेयर"
    },
    {
      "subtitle_id": 323,
      "start": 722.32,
      "end": 726.079,
      "text": "होना भी जरूरी है। और डरने की बात नहीं है"
    },
    {
      "subtitle_id": 324,
      "start": 724.56,
      "end": 728.079,
      "text": "अगर नंबर्स इंप्रूव होते तो वेल एंड गुड।"
    },
    {
      "subtitle_id": 325,
      "start": 726.079,
      "end": 730.48,
      "text": "लेकिन जिस तरह से डेली बेसिस पर नए-नए"
    },
    {
      "subtitle_id": 326,
      "start": 728.079,
      "end": 732.32,
      "text": "टेरीफ आ रहे हैं, मुझे तो तकलीफ ही नजर आ"
    },
    {
      "subtitle_id": 327,
      "start": 730.48,
      "end": 734.56,
      "text": "रही है। तो फिलहाल हम यहीं पर रुकते हैं।"
    },
    {
      "subtitle_id": 328,
      "start": 732.32,
      "end": 736.8,
      "text": "यूएस इकॉनमी पर आपका क्या मत है? नीचे"
    },
    {
      "subtitle_id": 329,
      "start": 734.56,
      "end": 738.399,
      "text": "कमेंट करके जरूर बताइए। और अगर यह रिसेशन"
    },
    {
      "subtitle_id": 330,
      "start": 736.8,
      "end": 740.16,
      "text": "आता है, तो एज एन इन्वेस्टर आप किस तरह से"
    },
    {
      "subtitle_id": 331,
      "start": 738.399,
      "end": 741.839,
      "text": "प्रिपयर्ड हैं, वह भी नीचे कमेंट करके"
    },
    {
      "subtitle_id": 332,
      "start": 740.16,
      "end": 745.32,
      "text": "जरूर बताइए। मिलते हैं अगले वीडियो में।"
    },
    {
      "subtitle_id": 333,
      "start": 741.839,
      "end": 745.32,
      "text": "थैंक यू सो मच।"
    }
  ]
}