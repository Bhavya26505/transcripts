  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.0,
      "end": 4.319,
      "text": "आईएसी फर्स्ट बैंक की शेयर प्राइस पिछले"
    },
    {
      "subtitle_id": 2,
      "start": 1.76,
      "end": 5.96,
      "text": "सिर्फ 1 साल में 23 से डाउन है जिसके बाद"
    },
    {
      "subtitle_id": 3,
      "start": 4.319,
      "end": 8.2,
      "text": "कई सारे रिटेल इन्वेस्टर्स के हमें सवाल आ"
    },
    {
      "subtitle_id": 4,
      "start": 5.96,
      "end": 10.4,
      "text": "रहे हैं कि बैंक का आखिर फ्यूचर क्या है"
    },
    {
      "subtitle_id": 5,
      "start": 8.2,
      "end": 12.08,
      "text": "क्या यही चलता रहेगा वही दूसरी तरफ कई"
    },
    {
      "subtitle_id": 6,
      "start": 10.4,
      "end": 13.559,
      "text": "सारे ऐसे भी इन्वेस्टर्स हैं जो हमें यह"
    },
    {
      "subtitle_id": 7,
      "start": 12.08,
      "end": 15.839,
      "text": "पूछ रहे हैं कि शेयर प्राइस अच्छी खासी गर"
    },
    {
      "subtitle_id": 8,
      "start": 13.559,
      "end": 17.56,
      "text": "गई है तो क्या यहां पर अंडरवैल्यूड"
    },
    {
      "subtitle_id": 9,
      "start": 15.839,
      "end": 19.64,
      "text": "इन्वेस्टमेंट की अपॉर्चुनिटी है तो यह"
    },
    {
      "subtitle_id": 10,
      "start": 17.56,
      "end": 21.76,
      "text": "दोनों भी सवालों के जवाब आपको आज के इस"
    },
    {
      "subtitle_id": 11,
      "start": 19.64,
      "end": 24.08,
      "text": "वीडियो के अंत तक मिल जाएंगे क्योंकि"
    },
    {
      "subtitle_id": 12,
      "start": 21.76,
      "end": 26.88,
      "text": "आईएसी फ बैंक की जो कहानी है वह बड़ी अलग"
    },
    {
      "subtitle_id": 13,
      "start": 24.08,
      "end": 28.359,
      "text": "है बड़ी अजीब है क्योंकि रिसेंटली जैसे आप"
    },
    {
      "subtitle_id": 14,
      "start": 26.88,
      "end": 31.4,
      "text": "इस डाटा में देख सकते हो कि इनकी जो"
    },
    {
      "subtitle_id": 15,
      "start": 28.359,
      "end": 33.16,
      "text": "ऑपरेटिंग प्रॉफिट है वह ईयर ऑन ईयर 30 पर"
    },
    {
      "subtitle_id": 16,
      "start": 31.4,
      "end": 35.559,
      "text": "से बढ़ गया है अब इसके बावजूद भी सेकंड"
    },
    {
      "subtitle_id": 17,
      "start": 33.16,
      "end": 37.68,
      "text": "क्वार्टर में इनका ईयर ऑन ईयर प्रॉफिट 73"
    },
    {
      "subtitle_id": 18,
      "start": 35.559,
      "end": 40.2,
      "text": "पर से डाउन है यानी कि पिछले साल सेकंड"
    },
    {
      "subtitle_id": 19,
      "start": 37.68,
      "end": 41.879,
      "text": "क्वार्टर में ने 751 करोड़ का प्रॉफिट था"
    },
    {
      "subtitle_id": 20,
      "start": 40.2,
      "end": 44.64,
      "text": "इस साल के सेकंड क्वार्टर में वो गिर कर आ"
    },
    {
      "subtitle_id": 21,
      "start": 41.879,
      "end": 46.399,
      "text": "गया है सिर्फ 201 करोड़ ₹ करोड़ अब ये"
    },
    {
      "subtitle_id": 22,
      "start": 44.64,
      "end": 48.879,
      "text": "अचानक कैसे हुआ तो कुछ भी अचानक नहीं हुआ"
    },
    {
      "subtitle_id": 23,
      "start": 46.399,
      "end": 50.64,
      "text": "है इसके पीछे दो मेन रीजंस हैं जिनकी आज"
    },
    {
      "subtitle_id": 24,
      "start": 48.879,
      "end": 52.239,
      "text": "हम डिटेल में चर्चा करने वाले हैं देखिए"
    },
    {
      "subtitle_id": 25,
      "start": 50.64,
      "end": 54.039,
      "text": "अगर प्रॉब्लम ढूंढना है तो यह देखना"
    },
    {
      "subtitle_id": 26,
      "start": 52.239,
      "end": 56.44,
      "text": "पड़ेगा कि कौन से लोंस में प्रॉब्लम आ रही"
    },
    {
      "subtitle_id": 27,
      "start": 54.039,
      "end": 58.32,
      "text": "है इसीलिए हमने अपना रिसर्च उस तरफ बढ़ाया"
    },
    {
      "subtitle_id": 28,
      "start": 56.44,
      "end": 60.559,
      "text": "कि बैंक जो अलग-अलग सेगमेंट्स को लोन दे"
    },
    {
      "subtitle_id": 29,
      "start": 58.32,
      "end": 62.199,
      "text": "रही है सबको स्टेप बाय स्टेप एनालाइज करते"
    },
    {
      "subtitle_id": 30,
      "start": 60.559,
      "end": 64.08,
      "text": "हैं फिर हमें ये डाटा मिला जहां पर आप देख"
    },
    {
      "subtitle_id": 31,
      "start": 62.199,
      "end": 66.4,
      "text": "सकते हो कि जो मॉर्गेज लोंस है वो तो"
    },
    {
      "subtitle_id": 32,
      "start": 64.08,
      "end": 68.24,
      "text": "स्टेबल है वहां पर कुछ गड़बड़ नहीं है यह"
    },
    {
      "subtitle_id": 33,
      "start": 66.4,
      "end": 69.759,
      "text": "जो डाटा आपके सामने है एनपीए यानी नॉन"
    },
    {
      "subtitle_id": 34,
      "start": 68.24,
      "end": 71.56,
      "text": "परफॉर्मिंग एसेट्स का है यानी कौन-कौन से"
    },
    {
      "subtitle_id": 35,
      "start": 69.759,
      "end": 73.439,
      "text": "लोन डिफॉल्ट हुए हैं शुरुआत में मॉर्गेज"
    },
    {
      "subtitle_id": 36,
      "start": 71.56,
      "end": 75.68,
      "text": "लोन है उसमें कोई स्टेबल है वो कुछ ज्यादा"
    },
    {
      "subtitle_id": 37,
      "start": 73.439,
      "end": 77.119,
      "text": "फर्क नहीं है व्हीकल्स में एनपीए थोड़ा"
    },
    {
      "subtitle_id": 38,
      "start": 75.68,
      "end": 79.24,
      "text": "ज्यादा है मॉर्गेज में सबसे कम रहता है"
    },
    {
      "subtitle_id": 39,
      "start": 77.119,
      "end": 81.24,
      "text": "जनरली एमएसएमई में भी कम है कंज्यूमर"
    },
    {
      "subtitle_id": 40,
      "start": 79.24,
      "end": 83.32,
      "text": "ड्यूरेबल में भी कम है प्रॉब्लम कहां है"
    },
    {
      "subtitle_id": 41,
      "start": 81.24,
      "end": 85.439,
      "text": "तो प्रॉब्लम लास्ट में है माइक्रो फाइनेंस"
    },
    {
      "subtitle_id": 42,
      "start": 83.32,
      "end": 86.799,
      "text": "बिजनेस अब ये पहला प्रॉब्लम है इसके अलावा"
    },
    {
      "subtitle_id": 43,
      "start": 85.439,
      "end": 88.56,
      "text": "भी कुछ और प्रॉब्लम्स है तो माइक्रो"
    },
    {
      "subtitle_id": 44,
      "start": 86.799,
      "end": 91.64,
      "text": "फाइनेंस बिजनेस का सबसे बड़ा प्रॉब्लम है"
    },
    {
      "subtitle_id": 45,
      "start": 88.56,
      "end": 93.759,
      "text": "हुआ यह कि करीब 5छ साल पहले बंधन बैंक और"
    },
    {
      "subtitle_id": 46,
      "start": 91.64,
      "end": 95.2,
      "text": "कुछ और बैंक्स थी जो पर्टिकुलर माइक्रो"
    },
    {
      "subtitle_id": 47,
      "start": 93.759,
      "end": 97.119,
      "text": "फाइनेंस सेगमेंट में काम कर रही थी और"
    },
    {
      "subtitle_id": 48,
      "start": 95.2,
      "end": 99.32,
      "text": "उसमें उन्हें काफी सक्सेस मिला जिसके बाद"
    },
    {
      "subtitle_id": 49,
      "start": 97.119,
      "end": 101.479,
      "text": "बाकी बैंक्स ने सोचा कि हम क्यों ना जाए"
    },
    {
      "subtitle_id": 50,
      "start": 99.32,
      "end": 103.759,
      "text": "तो उन्होंने भी इस टेरिटरी में जाना शुरू"
    },
    {
      "subtitle_id": 51,
      "start": 101.479,
      "end": 106.479,
      "text": "किया और वहां पर मार्केट कैप्चर करना शुरू"
    },
    {
      "subtitle_id": 52,
      "start": 103.759,
      "end": 108.2,
      "text": "किया सब कुछ बहुत बढ़िया था मतलब ये लोग"
    },
    {
      "subtitle_id": 53,
      "start": 106.479,
      "end": 110.079,
      "text": "क्या करते थे कि गांव के पांच छह लोगों को"
    },
    {
      "subtitle_id": 54,
      "start": 108.2,
      "end": 112.04,
      "text": "पकड़ लिया और उन्हें ग्रुप में लोन बांटते"
    },
    {
      "subtitle_id": 55,
      "start": 110.079,
      "end": 113.84,
      "text": "थे और एक दूसरे को गारंटर बना देते ताकि"
    },
    {
      "subtitle_id": 56,
      "start": 112.04,
      "end": 115.6,
      "text": "बाकी लोगों पर भी जिम्मेदारी रहे कि लोन"
    },
    {
      "subtitle_id": 57,
      "start": 113.84,
      "end": 117.479,
      "text": "हमें चुकाना है अब ये सिस्टम बहुत बढ़िया"
    },
    {
      "subtitle_id": 58,
      "start": 115.6,
      "end": 120.2,
      "text": "से चल रहा था"
    },
    {
      "subtitle_id": 59,
      "start": 117.479,
      "end": 121.759,
      "text": "अंट्स लिया वीडियो में आगे बढ़ने से पहले"
    },
    {
      "subtitle_id": 60,
      "start": 120.2,
      "end": 124.159,
      "text": "एक इंपोर्टेंट चीज आप सभी को बताना चाहता"
    },
    {
      "subtitle_id": 61,
      "start": 121.759,
      "end": 126.399,
      "text": "हूं कि हमारी दिवाली कमो ऑफर के बस आखिरी"
    },
    {
      "subtitle_id": 62,
      "start": 124.159,
      "end": 128.36,
      "text": "48 आवर्स बाकी है इस दिवाली हमारे शेयर"
    },
    {
      "subtitle_id": 63,
      "start": 126.399,
      "end": 130.84,
      "text": "मार्केट फाउंडेशन प्लस फंडामेंटल एनालिसिस"
    },
    {
      "subtitle_id": 64,
      "start": 128.36,
      "end": 133.12,
      "text": "2.0 ये जो कमो है जिसमें हम शेयर मार्केट"
    },
    {
      "subtitle_id": 65,
      "start": 130.84,
      "end": 134.879,
      "text": "को एकदम बेसिक से एकदम एडवांस लेवल तक"
    },
    {
      "subtitle_id": 66,
      "start": 133.12,
      "end": 136.76,
      "text": "जहां पर आपको कंपनी का मैनेजमेंट एनालिसिस"
    },
    {
      "subtitle_id": 67,
      "start": 134.879,
      "end": 138.76,
      "text": "सीखने मिलता है कंपनी का वैल्यूएशन यानी"
    },
    {
      "subtitle_id": 68,
      "start": 136.76,
      "end": 141.16,
      "text": "कंपनी अंडर वैल्यूड है या फिर ओवर वैल्यूड"
    },
    {
      "subtitle_id": 69,
      "start": 138.76,
      "end": 143.12,
      "text": "फॉरेंसिक एनालिसिस पर्ल फार्मिंग अप्रोच"
    },
    {
      "subtitle_id": 70,
      "start": 141.16,
      "end": 145.56,
      "text": "ये सारी चीजें सीखने मिलती है तो यह जो"
    },
    {
      "subtitle_id": 71,
      "start": 143.12,
      "end": 146.92,
      "text": "कमो है वो आपको फ्लैट 50 पर से भी ज्यादा"
    },
    {
      "subtitle_id": 72,
      "start": 145.56,
      "end": 148.84,
      "text": "के डिस्काउंट में मिल रहा है और इसके"
    },
    {
      "subtitle_id": 73,
      "start": 146.92,
      "end": 151.2,
      "text": "अलावा आपको हमारा द बिग कमो जिसमें"
    },
    {
      "subtitle_id": 74,
      "start": 148.84,
      "end": 153.2,
      "text": "फाउंडेशन कोर्स फंडामेंटल एनालिसिस 2.0"
    },
    {
      "subtitle_id": 75,
      "start": 151.2,
      "end": 155.2,
      "text": "ऑप्शन ट्रेडिंग फॉर हेजिंग और एडवांस"
    },
    {
      "subtitle_id": 76,
      "start": 153.2,
      "end": 157.04,
      "text": "म्यूचुअल फंड ये चार कोर्सेस मिलते हैं ये"
    },
    {
      "subtitle_id": 77,
      "start": 155.2,
      "end": 159.28,
      "text": "दोनों भी कॉम्बोस आपको मिलते हैं विद लाइफ"
    },
    {
      "subtitle_id": 78,
      "start": 157.04,
      "end": 160.92,
      "text": "टाइम एक्सेस एंड सर्टिफिकेट्स तो इस ऑफर"
    },
    {
      "subtitle_id": 79,
      "start": 159.28,
      "end": 163.239,
      "text": "को बिल्कुल भी मिस ना करें क्योंकि 48"
    },
    {
      "subtitle_id": 80,
      "start": 160.92,
      "end": 165.4,
      "text": "आवर्स के बाद इस प्राइस पर आपको कभी भी ये"
    },
    {
      "subtitle_id": 81,
      "start": 163.239,
      "end": 167.28,
      "text": "कॉम्बोस नहीं मिलेंगे सो डोंट मिस आउट ऑन"
    },
    {
      "subtitle_id": 82,
      "start": 165.4,
      "end": 169.159,
      "text": "दिस अपॉर्चुनिटी लिंक नीचे डिस्क्रिप्शन"
    },
    {
      "subtitle_id": 83,
      "start": 167.28,
      "end": 171.599,
      "text": "और कमेंट बॉक्स में दी गई है अभी के अभी"
    },
    {
      "subtitle_id": 84,
      "start": 169.159,
      "end": 173.519,
      "text": "जाइए 24 आवर्स के अंदर ही आपको एक्सेस"
    },
    {
      "subtitle_id": 85,
      "start": 171.599,
      "end": 175.879,
      "text": "मिलेगा और तुरंत अपनी शेयर मार्केट जर्नी"
    },
    {
      "subtitle_id": 86,
      "start": 173.519,
      "end": 178.0,
      "text": "शुरू करें चलिए बढ़ते हैं वीडियो की तरफ"
    },
    {
      "subtitle_id": 87,
      "start": 175.879,
      "end": 179.959,
      "text": "आज से करीब 2 साल पहले यानी 2022 में"
    },
    {
      "subtitle_id": 88,
      "start": 178.0,
      "end": 181.68,
      "text": "आरबीआई ने एक नई पॉलिसी लाई पहले क्या"
    },
    {
      "subtitle_id": 89,
      "start": 179.959,
      "end": 183.48,
      "text": "होता था वो बता देता हूं उससे पहले पहले"
    },
    {
      "subtitle_id": 90,
      "start": 181.68,
      "end": 185.48,
      "text": "ये होता था कि आरबीआई के स्ट्रिक्ट"
    },
    {
      "subtitle_id": 91,
      "start": 183.48,
      "end": 187.64,
      "text": "गाइडलाइंस थी कि जो भी आपकी कॉस्ट ऑफ"
    },
    {
      "subtitle_id": 92,
      "start": 185.48,
      "end": 190.48,
      "text": "बोरोंग है यानी कि मान लो आईडीएसी फर्स्ट"
    },
    {
      "subtitle_id": 93,
      "start": 187.64,
      "end": 193.879,
      "text": "बैंक 7 पर से कहीं और से पैसा ले रही है"
    },
    {
