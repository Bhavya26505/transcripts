      "start": 640.04,
      "end": 642.92,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में मिल"
    },
    {
      "subtitle_id": 287,
      "start": 641.36,
      "end": 644.959,
      "text": "जाएगी मिलते हैं अगले वीडियो में और"
    },
    {
      "subtitle_id": 288,
      "start": 642.92,
      "end": 646.56,
      "text": "वीडियो कैसा लगा कमेंट करके जरूर बताइए और"
    },
    {
      "subtitle_id": 289,
      "start": 644.959,
      "end": 647.639,
      "text": "कौन सी कंपनी जिसके बारे में आप चाहते हैं"
    },
    {
      "subtitle_id": 290,
      "start": 646.56,
      "end": 649.2,
      "text": "कि हम डिटेल में बात करें उसके"
    },
    {
      "subtitle_id": 291,
      "start": 647.639,
      "end": 651.079,
      "text": "फंडामेंटल्स के बारे में बात करें उसका भी"
    },
    {
      "subtitle_id": 292,
      "start": 649.2,
      "end": 652.6,
      "text": "नाम कमेंट में जरूर बताइए रिसेंटली हमने"
    },
    {
      "subtitle_id": 293,
      "start": 651.079,
      "end": 654.44,
      "text": "एक ऑप्शंस पर बहुत बढ़िया वीडियो बनाया कि"
    },
    {
      "subtitle_id": 294,
      "start": 652.6,
      "end": 656.399,
      "text": "क्या ऑप्शंस बैन होने वाले हैं ऑप्शंस के"
    },
    {
      "subtitle_id": 295,
      "start": 654.44,
      "end": 658.639,
      "text": "रिलेटेड काफी कुछ रेगुलेशंस चेंज हुए हैं"
    },
    {
      "subtitle_id": 296,
      "start": 656.399,
      "end": 660.6,
      "text": "तो उन्हें बहुत इन डेप्थ रिसर्च करके हमने"
    },
    {
      "subtitle_id": 297,
      "start": 658.639,
      "end": 662.399,
      "text": "बताया है अलगो ट्रेडिंग की भी हमने उसमें"
    },
    {
      "subtitle_id": 298,
      "start": 660.6,
      "end": 663.88,
      "text": "बात की है उस वीडियो को भी जरूर चेक आउट"
    },
    {
      "subtitle_id": 299,
      "start": 662.399,
      "end": 665.6,
      "text": "कीजिए चैनल नेम पर क्लिक करके रिसेंट"
    },
    {
      "subtitle_id": 300,
      "start": 663.88,
      "end": 666.88,
      "text": "वीडियो में आपको दिख जाएगा डू चेक इट आउट"
    },
    {
      "subtitle_id": 301,
      "start": 665.6,
      "end": 668.48,
      "text": "एंड ज्यादा से ज्यादा लोगों से उसे शेयर"
    },
    {
      "subtitle_id": 302,
      "start": 666.88,
      "end": 670.48,
      "text": "कीजिए मिलते हैं अगले वीडियो में थैंक यू"
    },
    {
      "subtitle_id": 303,
      "start": 668.48,
      "end": 673.399,
      "text": "सो मच और अभी तक सब्सक्राइब नहीं किया है"
    },
    {
      "subtitle_id": 304,
      "start": 670.48,
      "end": 673.399,
      "text": "कर दो यार"
    }
  ]
}