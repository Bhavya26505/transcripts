  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.199,
      "end": 4.08,
      "text": "पिछले 1 साल में गवर्नमेंट स्टॉक्स ने"
    },
    {
      "subtitle_id": 2,
      "start": 2.12,
      "end": 6.799,
      "text": "तबाही मचा दी है पिछले वीडियो में हमने"
    },
    {
      "subtitle_id": 3,
      "start": 4.08,
      "end": 8.599,
      "text": "आईआरडीए की बात की कि ₹ 332 पर जिस कंपनी"
    },
    {
      "subtitle_id": 4,
      "start": 6.799,
      "end": 11.599,
      "text": "का आईपीओ आया महीने भर में उसके शेयर"
    },
    {
      "subtitle_id": 5,
      "start": 8.599,
      "end": 14.16,
      "text": "प्राइस ₹10 के ऊपर चले गई आरईसी की अगर हम"
    },
    {
      "subtitle_id": 6,
      "start": 11.599,
      "end": 16.76,
      "text": "बात करें उसके शेयर प्राइस ₹10 थे एक साल"
    },
    {
      "subtitle_id": 7,
      "start": 14.16,
      "end": 18.32,
      "text": "पहले अभी 400 के ऊपर है सेम चीज आईआरएफसी"
    },
    {
      "subtitle_id": 8,
      "start": 16.76,
      "end": 20.4,
      "text": "में हो रही है और कई सारी और भी सरकारी"
    },
    {
      "subtitle_id": 9,
      "start": 18.32,
      "end": 22.519,
      "text": "स्टॉक्स है जिसमें ऐसा हो रहा है अब देखिए"
    },
    {
      "subtitle_id": 10,
      "start": 20.4,
      "end": 24.88,
      "text": "सवाल ये आता है कि ऐसा क्या हुआ है कि जब"
    },
    {
      "subtitle_id": 11,
      "start": 22.519,
      "end": 26.56,
      "text": "₹ में जब आईआरएफसी था 1 1 साल पहले तब उसे"
    },
    {
      "subtitle_id": 12,
      "start": 24.88,
      "end": 29.119,
      "text": "टच करने के लिए कोई रेडी नहीं था खरीदने"
    },
    {
      "subtitle_id": 13,
      "start": 26.56,
      "end": 31.759,
      "text": "के लिए कोई रेडी नहीं था आज हर कोई ₹1 पर"
    },
    {
      "subtitle_id": 14,
      "start": 29.119,
      "end": 34.36,
      "text": "भी उसे खरीदने के लिए तैयार है तो यह चेंज"
    },
    {
      "subtitle_id": 15,
      "start": 31.759,
      "end": 36.12,
      "text": "कहां से आया है और यह पीएसयू स्टॉक्स में"
    },
    {
      "subtitle_id": 16,
      "start": 34.36,
      "end": 38.48,
      "text": "जो ग्रोथ हो रही है उसके पीछे एग्जैक्ट"
    },
    {
      "subtitle_id": 17,
      "start": 36.12,
      "end": 40.6,
      "text": "रीजन क्या है और यही एक बहुत बड़ा सवाल"
    },
    {
      "subtitle_id": 18,
      "start": 38.48,
      "end": 42.28,
      "text": "फिलहाल के इस मार्केट में बना है जिसे आज"
    },
    {
      "subtitle_id": 19,
      "start": 40.6,
      "end": 44.0,
      "text": "हम बहुत ही डिटेल में स्टेप बाय स्टेप"
    },
    {
      "subtitle_id": 20,
      "start": 42.28,
      "end": 45.76,
      "text": "समझने वाले हैं तो इस वीडियो के एंड तक"
    },
    {
      "subtitle_id": 21,
      "start": 44.0,
      "end": 47.719,
      "text": "आपको यह समझ में आ जाएगा कि पीएसयू"
    },
    {
      "subtitle_id": 22,
      "start": 45.76,
      "end": 49.84,
      "text": "स्टॉक्स क्यों बढ़ रहे हैं और यह जो"
    },
    {
      "subtitle_id": 23,
      "start": 47.719,
      "end": 51.719,
      "text": "मोमेंटम बना है यह कब तक बना रहेगा"
    },
    {
      "subtitle_id": 24,
      "start": 49.84,
      "end": 54.16,
      "text": "नमस्कार मैं प्रसाद आपका आज के इस वीडियो"
    },
    {
      "subtitle_id": 25,
      "start": 51.719,
      "end": 57.039,
      "text": "में स्वागत करता हूं बीएससी के इस पीएसओ"
    },
    {
      "subtitle_id": 26,
      "start": 54.16,
      "end": 59.68,
      "text": "इंडेक्स पर आप नजर डालिए तो 2007 से लेकर"
    },
    {
      "subtitle_id": 27,
      "start": 57.039,
      "end": 62.039,
      "text": "2019 तक इस इंडेक्स ने इस पीएसओ इंडेक्स"
    },
    {
      "subtitle_id": 28,
      "start": 59.68,
      "end": 64.4,
      "text": "ने कोई रिटर्न नहीं दिया है 0 पर रिटर्न"
    },
    {
      "subtitle_id": 29,
      "start": 62.039,
      "end": 66.56,
      "text": "लेकिन 2009 के बाद जो ये चल पड़ा है और"
    },
    {
      "subtitle_id": 30,
      "start": 64.4,
      "end": 68.759,
      "text": "पर्टिकुलर एक साल में जो ये चल पड़ा है तो"
    },
    {
      "subtitle_id": 31,
      "start": 66.56,
      "end": 70.96,
      "text": "अब ये इंडेक्स हर दिन नई-नई ऊंचाइयों को"
    },
    {
      "subtitle_id": 32,
      "start": 68.759,
      "end": 72.68,
      "text": "छू रहा है जिसके बाद पहला सवाल दिमाग में"
    },
    {
      "subtitle_id": 33,
      "start": 70.96,
      "end": 74.479,
      "text": "यह आता है कि गवर्नमेंट कंपनीज है उनकी"
    },
    {
      "subtitle_id": 34,
      "start": 72.68,
      "end": 76.68,
      "text": "परफॉर्मेंस बहुत अच्छी हो गई है इसकी वजह"
    },
    {
      "subtitle_id": 35,
      "start": 74.479,
      "end": 78.92,
      "text": "से शेयर प्राइस बढ़ रही है तो इसे पहले"
    },
    {
      "subtitle_id": 36,
      "start": 76.68,
      "end": 80.96,
      "text": "समझ लेते हैं जैसे आप यहां पर स्टेट बैंक"
    },
    {
      "subtitle_id": 37,
      "start": 78.92,
      "end": 83.2,
      "text": "ऑफ इंडिया के फाइनेंशियल्स देख सकते हैं"
    },
    {
      "subtitle_id": 38,
      "start": 80.96,
      "end": 84.84,
      "text": "इनके जो रेवेन्यू ग्रोथ है वो पिछले 5 साल"
    },
    {
      "subtitle_id": 39,
      "start": 83.2,
      "end": 86.88,
      "text": "में 10 साल में कंपाउंडेड सालाना सिंगल"
    },
    {
      "subtitle_id": 40,
      "start": 84.84,
      "end": 88.759,
      "text": "डिजिट ही रही है प्रॉफिट हालांकि काफी"
    },
    {
      "subtitle_id": 41,
      "start": 86.88,
      "end": 90.96,
      "text": "ज्यादा बड़ा है पिछले पा साल में वो"
    },
    {
      "subtitle_id": 42,
      "start": 88.759,
      "end": 92.84,
      "text": "कंपाउंडेड सालाना 7 6 पर से बढ़ा है"
    },
    {
      "subtitle_id": 43,
      "start": 90.96,
      "end": 94.119,
      "text": "एलआईसी की बात करें तो यहां पर भी सेम ही"
    },
    {
      "subtitle_id": 44,
      "start": 92.84,
      "end": 96.439,
      "text": "हमें दिख रहा है कि रेवेन्यू कुछ नहीं"
    },
    {
      "subtitle_id": 45,
      "start": 94.119,
      "end": 98.52,
      "text": "बढ़ा है प्रॉफिट बहुत ज्यादा बढ़ रहा है"
    },
    {
      "subtitle_id": 46,
      "start": 96.439,
      "end": 100.72,
      "text": "एनटीपीसी में दोनों चीजें नहीं बढ़ रही है"
    },
    {
      "subtitle_id": 47,
      "start": 98.52,
      "end": 102.799,
      "text": "ओएनजीसी में भी दोनों चीजें इतनी ज्यादा"
    },
    {
      "subtitle_id": 48,
      "start": 100.72,
      "end": 104.159,
      "text": "नहीं बढ़ रही है कोल इंडिया में भी अगर हम"
    },
    {
      "subtitle_id": 49,
      "start": 102.799,
      "end": 106.2,
      "text": "देखें तो प्रॉफिट बढ़ रहा है रेवेन्यू"
    },
    {
      "subtitle_id": 50,
      "start": 104.159,
      "end": 108.759,
      "text": "नहीं बढ़ रहा है और फिर पावर ग्रेड"
    },
    {
      "subtitle_id": 51,
      "start": 106.2,
      "end": 111.68,
      "text": "कॉरपोरेशन हिंदुस्तान एरोनॉटिकल इंडियन"
    },
    {
      "subtitle_id": 52,
      "start": 108.759,
      "end": 113.32,
      "text": "ऑयल कॉरपोरेशन भारत इलेक्ट्रॉनिक्स और"
    },
    {
      "subtitle_id": 53,
      "start": 111.68,
      "end": 114.719,
      "text": "बाकी कंपनीज की भी बात करें तो रेवेन्यू"
    },
    {
      "subtitle_id": 54,
      "start": 113.32,
      "end": 116.88,
      "text": "उतने तेजी से नहीं बढ़ रहा है कुछ"
    },
    {
      "subtitle_id": 55,
      "start": 114.719,
      "end": 118.399,
      "text": "एक्सेप्शन है जैसे आईआरएफसी है जहां पर"
    },
    {
      "subtitle_id": 56,
      "start": 116.88,
      "end": 120.719,
      "text": "रेवेन्यू भी बढ़ रहा है लेकिन ज्यादातर"
    },
    {
      "subtitle_id": 57,
      "start": 118.399,
      "end": 122.56,
      "text": "पीएसयू में रेवेन्यू नहीं बढ़ रहा है वहां"
    },
    {
      "subtitle_id": 58,
      "start": 120.719,
      "end": 124.32,
      "text": "पर बढ़ रहा है प्रॉफिट अब ये प्रॉफिट"
    },
    {
      "subtitle_id": 59,
      "start": 122.56,
      "end": 125.799,
      "text": "क्यों बढ़ रहा है तो देखिए सरकारी कंपनी"
    },
    {
      "subtitle_id": 60,
      "start": 124.32,
      "end": 127.56,
      "text": "है तो क्या सरकार के इसके पीछे की क्या"
    },
    {
      "subtitle_id": 61,
      "start": 125.799,
      "end": 130.239,
      "text": "प्लानिंग है उसे थोड़ा समझ लेते हैं तो"
    },
    {
      "subtitle_id": 62,
      "start": 127.56,
      "end": 132.879,
      "text": "देखिए इसी तरह की पीएसयू की रैली साल 2002"
    },
    {
      "subtitle_id": 63,
      "start": 130.239,
      "end": 134.879,
      "text": "से लेकर 2007 के बीच में भी आई थी अब ये"
    },
    {
      "subtitle_id": 64,
      "start": 132.879,
      "end": 138.12,
      "text": "क्यों आई थी इसका भी एक रीजन समझ लेते हैं"
    },
    {
      "subtitle_id": 65,
      "start": 134.879,
      "end": 139.76,
      "text": "हम तो देखिए उस दौरान हुआ ये कि 1999 के"
    },
    {
      "subtitle_id": 66,
      "start": 138.12,
      "end": 141.879,
      "text": "बजट में ये अनाउंस किया गया कि अब हम"
    },
    {
      "subtitle_id": 67,
      "start": 139.76,
      "end": 144.08,
      "text": "डाइवस्ट मेंट पर फोकस करेंगे यानी जो"
    },
    {
      "subtitle_id": 68,
      "start": 141.879,
      "end": 146.08,
      "text": "सरकारी कंपनीज हैं उनके आईबीओ लाएंगे या"
    },
    {
      "subtitle_id": 69,
      "start": 144.08,
      "end": 148.0,
      "text": "उसका जो स्टेक है हम बेचना शुरू करेंगे और"
    },
    {
      "subtitle_id": 70,
      "start": 146.08,
      "end": 149.84,
      "text": "यह भी कोशिश करेंगे कि जो सरकारी कंपनीज"
    },
    {
      "subtitle_id": 71,
      "start": 148.0,
      "end": 151.879,
      "text": "है वो ज्यादा प्रॉफिटेबल हो अब स्पेशली"
    },
    {
      "subtitle_id": 72,
      "start": 149.84,
      "end": 153.64,
      "text": "चीज के लिए उस टाइम गवर्नमेंट ने एक"
    },
    {
      "subtitle_id": 73,
      "start": 151.879,
      "end": 155.599,
      "text": "डिपार्टमेंट की स्थापना की जिसका नाम था"
    },
    {
      "subtitle_id": 74,
      "start": 153.64,
      "end": 157.68,
      "text": "डिपार्टमेंट ऑफ डिस इन्वेस्टमेंट जिसका"
    },
    {
      "subtitle_id": 75,
      "start": 155.599,
      "end": 159.44,
      "text": "काम यह था कि सरकारी कंपनीज में जो"
    },
    {
      "subtitle_id": 76,
      "start": 157.68,
      "end": 160.56,
      "text": "पार्शियल स्टेक है वो हम कैसे बेच सकते"
    },
    {
      "subtitle_id": 77,
      "start": 159.44,
      "end": 162.84,
      "text": "हैं और इन्हें ज्यादा से ज्यादा हम"
    },
    {
      "subtitle_id": 78,
      "start": 160.56,
      "end": 164.599,
      "text": "प्रॉफिटेबल कैसे बना सकते हैं अब सरकार का"
    },
    {
      "subtitle_id": 79,
      "start": 162.84,
      "end": 165.879,
      "text": "पीएसयू पर ये फोकस देखते हुए उस टाइम"
    },
    {
      "subtitle_id": 80,
      "start": 164.599,
      "end": 168.599,
      "text": "इन्वेस्टर्स ने इसमें काफी इंटरेस्ट"
    },
    {
      "subtitle_id": 81,
      "start": 165.879,
      "end": 171.36,
      "text": "दिखाया जिसके चलते पीएसयू इंडेक्स तब 2002"
    },
    {
      "subtitle_id": 82,
      "start": 168.599,
      "end": 173.2,
      "text": "से लेकर 2007 के बीच 10 टाइम्स बढ़ गया"
    },
    {
      "subtitle_id": 83,
      "start": 171.36,
      "end": 175.4,
      "text": "कुछ-कुछ स्टॉक्स तो ऐसे थे जैसे आप यहां"
    },
    {
      "subtitle_id": 84,
      "start": 173.2,
      "end": 177.599,
      "text": "पर देख सकते हैं जो दो-दो सालों में ही कई"
    },
    {
      "subtitle_id": 85,
      "start": 175.4,
      "end": 179.72,
      "text": "गुना बढ़ गए जिस जिसमें से एक है स्टील"
    },
    {
      "subtitle_id": 86,
      "start": 177.599,
      "end": 181.76,
      "text": "अथॉरिटी ऑफ इंडिया जनरली हमसे एक सवाल"
    },
    {
      "subtitle_id": 87,
      "start": 179.72,
      "end": 184.04,
      "text": "बहुत कॉमनली पूछा जाता है और यह है कि आप"
    },
    {
      "subtitle_id": 88,
      "start": 181.76,
      "end": 185.84,
      "text": "किसी भी कंपनी का रिसर्च कैसे करते हैं और"
    },
    {
      "subtitle_id": 89,
      "start": 184.04,
      "end": 187.56,
      "text": "यह कैसे डिसाइड करते हैं कि कौन सी कंपनी"
    },
    {
      "subtitle_id": 90,
      "start": 185.84,
      "end": 189.64,
      "text": "में इन्वेस्ट करना चाहिए और ऐसे कौन से"
    },
    {
      "subtitle_id": 91,
      "start": 187.56,
      "end": 191.36,
      "text": "फाइनेंशियल रेशियो और मैट्रिक्स है जो"
    },
    {
      "subtitle_id": 92,
      "start": 189.64,
      "end": 193.519,
      "text": "हमें उस कंपनी को एनालाइज करने के लिए"
    },
    {
      "subtitle_id": 93,
      "start": 191.36,
      "end": 195.72,
      "text": "देखने हैं देखिए हर एक कंपनी यूनिक होती"
    },
    {
      "subtitle_id": 94,
      "start": 193.519,
      "end": 197.799,
      "text": "है आप किसी भी कंपनी को डायरेक्टली कंपेयर"
    },
    {
      "subtitle_id": 95,
      "start": 195.72,
      "end": 199.28,
      "text": "नहीं कर सकते उस कंपनी के यूएसपी आपको"
    },
    {
      "subtitle_id": 96,
      "start": 197.799,
      "end": 201.12,
      "text": "देखने हैं और उसके लिए कुछ पर्टिकुलर"
    },
    {
      "subtitle_id": 97,
      "start": 199.28,
      "end": 203.72,
      "text": "फाइनेंशियल रेश्योस पर आपको फोकस करना"
    },
    {
      "subtitle_id": 98,
      "start": 201.12,
      "end": 205.72,
      "text": "पड़ेगा और ये सारी चीजें हमने सिखाई है"
    },
    {
      "subtitle_id": 99,
      "start": 203.72,
      "end": 207.799,
      "text": "हमारे फंडामेंटल एनालिसिस कोर्स में बहुत"
    },
    {
      "subtitle_id": 100,
      "start": 205.72,
      "end": 210.519,
      "text": "ही स्टेप बाय स्टेप मैनर में जिससे कोई भी"
    },
    {
      "subtitle_id": 101,
      "start": 207.799,
      "end": 212.36,
      "text": "बिगनर बड़ी आसानी से बहुत अच्छे तरीके से"
    },
    {
      "subtitle_id": 102,
      "start": 210.519,
      "end": 214.959,
      "text": "किसी भी कंपनी का फंडामेंटल एनालिसिस कर"
    },
    {
      "subtitle_id": 103,
      "start": 212.36,
      "end": 217.12,
      "text": "सकता है और यह पता कर सकता है कि वो कंपनी"
    },
    {
      "subtitle_id": 104,
      "start": 214.959,
      "end": 220.12,
      "text": "सही में"
    },
    {
      "subtitle_id": 105,
      "start": 217.12,
      "end": 220.12,
      "text": "फाइनेंशियलीईएक्सप्रेस"
    },
    {
      "subtitle_id": 106,
      "start": 231.72,
      "end": 235.92,
      "text": "को बिल्कुल भी मिस ना होने दे इस कोर्स की"
    },
    {
      "subtitle_id": 107,
      "start": 234.519,
      "end": 237.68,
      "text": "लिंक आपको नीचे डिस्क्रिप्शन और कमेंट"
    },
    {
      "subtitle_id": 108,
      "start": 235.92,
      "end": 239.319,
      "text": "बॉक्स में दी गई है और आपको बता दूं कि"
    },
    {
      "subtitle_id": 109,
      "start": 237.68,
      "end": 241.04,
      "text": "पूरे इंडिया का एक अकेला शेयर मार्केट"
    },
    {
      "subtitle_id": 110,
      "start": 239.319,
      "end": 243.4,
      "text": "कोर्स है है जहां पर आपको दी जाती है नो"
    },
    {
      "subtitle_id": 111,
      "start": 241.04,
      "end": 245.64,
      "text": "क्वेश्चन आस रिफंड पॉलिसी 5 दिनों के लिए"
    },
    {
      "subtitle_id": 112,
      "start": 243.4,
      "end": 248.64,
      "text": "और हमारे जो रिफंड रेट है वो लेस दन 1 पर"
    },
    {
      "subtitle_id": 113,
      "start": 245.64,
      "end": 250.36,
      "text": "है चलिए वीडियो में आगे बढ़ते हैं अब 2019"
    },
    {
      "subtitle_id": 114,
      "start": 248.64,
      "end": 252.2,
      "text": "से अगर हम बात करें तो सेम चीज यहां पर"
    },
    {
      "subtitle_id": 115,
      "start": 250.36,
      "end": 254.48,
      "text": "दिख रही है जहां पर गवर्नमेंट का फोकस है"
    },
    {
      "subtitle_id": 116,
      "start": 252.2,
      "end": 256.759,
      "text": "डाइवस्ट मेंट पर कि ज्यादा से ज्यादा जो"
    },
    {
      "subtitle_id": 117,
      "start": 254.48,
      "end": 258.919,
      "text": "सरकारी कंपनीज का स्टेक है वो बेचा जाए और"
    },
    {
      "subtitle_id": 118,
      "start": 256.759,
      "end": 261.799,
      "text": "उन्हें प्रॉफिटेबल किया जाए अब इसके लिए"
    },
    {
      "subtitle_id": 119,
      "start": 258.919,
      "end": 263.919,
      "text": "अब 2015 के करीब एक मेगा बैड लोन क्लीनअप"
    },
    {
      "subtitle_id": 120,
      "start": 261.799,
      "end": 266.12,
      "text": "इनिशिएटिव लिया गया यह क्लीनअप इनिशिएटिव"
    },
    {
      "subtitle_id": 121,
      "start": 263.919,
      "end": 268.24,
      "text": "आरबीआई के एसेट क्वालिटी रिव्यू के बाद"
    },
    {
      "subtitle_id": 122,
      "start": 266.12,
      "end": 270.28,
      "text": "लिया गया था जहां पर फोकस यह था कि जो"
    },
    {
      "subtitle_id": 123,
      "start": 268.24,
      "end": 272.44,
      "text": "बैंक्स है उनके एनपीएस बहुत बड़ बढ रहे थे"
    },
    {
      "subtitle_id": 124,
      "start": 270.28,
      "end": 275.88,
      "text": "अगर आप उस दौरान आईडीबीआई बैंक और बाकी"
    },
    {
      "subtitle_id": 125,
      "start": 272.44,
      "end": 277.96,
      "text": "बैंक्स के एनपीएस देखेंगे तो वो 27 28 पर"
    },
    {
      "subtitle_id": 126,
      "start": 275.88,
      "end": 280.12,
      "text": "पर चले गए थे यानी ₹1 का लोन अगर बैंक दे"
    },
    {
      "subtitle_id": 127,
      "start": 277.96,
      "end": 281.919,
      "text": "रही है तो उसमें से ₹ वापस आ ही नहीं रहे"
    },
    {
      "subtitle_id": 128,
      "start": 280.12,
      "end": 283.96,
      "text": "हैं अब इस वजह से बैंक्स बहुत प्रॉब्लम"
    },
    {
      "subtitle_id": 129,
      "start": 281.919,
      "end": 286.12,
      "text": "में चली गई और फिर पिछले कुछ टाइम से"
    },
    {
      "subtitle_id": 130,
      "start": 283.96,
      "end": 288.12,
      "text": "सरकार कोशिशें कर रही है कि आईडीवी बैंक"
    },
    {
      "subtitle_id": 131,
      "start": 286.12,
      "end": 289.96,
      "text": "को बेचा जाए लेकिन मीन वाइल इन्होंने क्या"
    },
    {
      "subtitle_id": 132,
      "start": 288.12,
      "end": 292.4,
      "text": "किया कि स्टेप बाय स्टेप हम बेचेंगे इसलिए"
    },
    {
      "subtitle_id": 133,
      "start": 289.96,
      "end": 294.56,
      "text": "हर बजट में ये एक डाइवस्ट मेंट टारगेट"
    },
    {
      "subtitle_id": 134,
      "start": 292.4,
      "end": 296.639,
      "text": "लेकर आ रहे हैं फाइनेंशियल 2022 में इनका"
    },
    {
      "subtitle_id": 135,
      "start": 294.56,
      "end": 298.28,
      "text": "जो टारगेट था डाइवस्ट मेंट का वो 93000"
    },
    {
      "subtitle_id": 136,
      "start": 296.639,
      "end": 299.639,
      "text": "करोड़ का था जो ऑलमोस्ट इन्होंने पूरा"
    },
    {
      "subtitle_id": 137,
      "start": 298.28,
      "end": 301.6,
      "text": "किया और इस फाइनेंशियल ईयर का जो जो"
    },
    {
      "subtitle_id": 138,
      "start": 299.639,
      "end": 303.12,
      "text": "टारगेट है वो पूरा करना काफी मुश्किल लग"
    },
    {
      "subtitle_id": 139,
      "start": 301.6,
      "end": 305.199,
      "text": "रहा है वो थोड़ा ज्यादा है और अभी तक कुछ"
    },
    {
      "subtitle_id": 140,
      "start": 303.12,
      "end": 306.919,
      "text": "खास कवर नहीं हुआ है तो डाइवस्ट मेंट तो"
    },
    {
      "subtitle_id": 141,
      "start": 305.199,
      "end": 308.4,
      "text": "एक चीज हुई प्लस इन्न का दूसरा फोकस यह है"
    },
    {
      "subtitle_id": 142,
      "start": 306.919,
      "end": 309.759,
      "text": "कि सरकारी कंपनीज को ज्यादा से ज्यादा"
    },
    {
      "subtitle_id": 143,
      "start": 308.4,
      "end": 311.56,
      "text": "प्रॉफिटेबल बनाया जाए ज्यादा से ज्यादा"
    },
    {
      "subtitle_id": 144,
      "start": 309.759,
      "end": 313.56,
      "text": "एफिशिएंट बनाया जाए इसलिए उन्होंने इनकी"
    },
    {
      "subtitle_id": 145,
      "start": 311.56,
      "end": 315.36,
      "text": "जो बैंक्स है सरकार की और जो एनबीएफसी"
    },
    {
      "subtitle_id": 146,
      "start": 313.56,
      "end": 317.12,
      "text": "टाइप कंपनीज है उन पर फोकस करना शुरू किया"
    },
    {
      "subtitle_id": 147,
      "start": 315.36,
      "end": 319.36,
      "text": "कि बैड लोन हम कैसे ज्यादा से ज्यादा कम"
    },
    {
      "subtitle_id": 148,
      "start": 317.12,
      "end": 321.6,
      "text": "करें तो आप अगर देखेंगे तो आईडी बया जिसका"
    },
    {
      "subtitle_id": 149,
      "start": 319.36,
      "end": 324.319,
      "text": "बैड लोन 27 पर तक चला गया था वो उन्होंने"
    },
    {
      "subtitle_id": 150,
      "start": 321.6,
      "end": 325.919,
      "text": "67 पर पर अभी लाया है सेम चीज आपको बाकी"
    },
    {
      "subtitle_id": 151,
      "start": 324.319,
      "end": 328.479,
      "text": "सारी सरकारी बैंक्स में देखने मिलेगी"
    },
    {
      "subtitle_id": 152,
      "start": 325.919,
      "end": 330.68,
      "text": "जिसका अंजाम यह हुआ कि कंपनीज का प्रॉफिट"
    },
    {
      "subtitle_id": 153,
      "start": 328.479,
      "end": 332.8,
      "text": "बढ़ने लगा क्योंकि बैड डेट्स आपके बहुत कम"
    },
    {
      "subtitle_id": 154,
      "start": 330.68,
      "end": 335.759,
      "text": "हो रहे हैं और कंपनी ज्यादा एफिशिएंट भी"
    },
    {
      "subtitle_id": 155,
      "start": 332.8,
      "end": 337.08,
      "text": "बन रही है लेकिन जहां तक ग्रोथ की बात है"
    },
    {
      "subtitle_id": 156,
      "start": 335.759,
      "end": 339.319,
      "text": "ग्रोथ उतनी ज्यादा नहीं हो रही है"
    },
    {
      "subtitle_id": 157,
      "start": 337.08,
      "end": 341.16,
      "text": "रेवेन्यू में अब ये जो ऐसी चीजें कुछ टाइम"
    },
    {
      "subtitle_id": 158,
      "start": 339.319,
      "end": 343.84,
      "text": "तक अच्छे से चलती है लेकिन एक बार आपका"
    },
    {
      "subtitle_id": 159,
      "start": 341.16,
      "end": 345.759,
      "text": "प्रॉफिट मोस्ट एफिशिएंट लेवल पर आ गया तो"
    },
    {
      "subtitle_id": 160,
      "start": 343.84,
      "end": 347.84,
      "text": "उसके बाद अगर रेवेन्यू नहीं बढ़ा तो"
    },
    {
      "subtitle_id": 161,
      "start": 345.759,
      "end": 349.639,
      "text": "प्रॉफिट नहीं बढ़ेगा और ये जो सिचुएशन है"
    },
    {
      "subtitle_id": 162,
      "start": 347.84,
      "end": 351.08,
      "text": "मुझे लगता है दो-तीन साल में आने वाली है"
    },
    {
      "subtitle_id": 163,
      "start": 349.639,
      "end": 352.44,
      "text": "लेकिन लोग कहीं ना कहीं इसे नहीं देख पा"
    },
    {
      "subtitle_id": 164,
      "start": 351.08,
      "end": 354.52,
      "text": "रहे हैं लोग बस यही देख रहे हैं कि इनका"
    },
    {
      "subtitle_id": 165,
      "start": 352.44,
      "end": 356.0,
      "text": "प्रॉफिट बहुत ज्यादा बढ़ रहा है और ठीक है"
    },
    {
      "subtitle_id": 166,
      "start": 354.52,
      "end": 358.319,
      "text": "मतलब ये चीज भी सही है कि कंपनी के"
    },
    {
      "subtitle_id": 167,
      "start": 356.0,
      "end": 360.6,
      "text": "फंडामेंटल्स मतलब हिस्टोरिकल सरकारी"
    },
    {
      "subtitle_id": 168,
      "start": 358.319,
      "end": 362.16,
      "text": "कंपनीज को बहुत बहुत कम पी रेशो दिया जाता"
    },
    {
      "subtitle_id": 169,
      "start": 360.6,
      "end": 363.6,
      "text": "है बिकॉज़ लोग के एक्सपेक्टशंस ही नहीं है"
    },
    {
      "subtitle_id": 170,
      "start": 362.16,
      "end": 365.56,
      "text": "लोग सोचते नहीं है कि सरकारी कंपनीज"
    },
    {
      "subtitle_id": 171,
      "start": 363.6,
      "end": 367.88,
      "text": "रिटर्न भी दे पाएगी लेकिन क्योंकि"
    },
    {
      "subtitle_id": 172,
      "start": 365.56,
      "end": 370.08,
      "text": "रिसेंटली यह थोड़ी बहुत एफिशिएंट बन गई है"
    },
    {
      "subtitle_id": 173,
      "start": 367.88,
      "end": 371.44,
      "text": "इन्होंने बैड लोन के जो कैंपेन चलाए उसकी"
    },
    {
      "subtitle_id": 174,
      "start": 370.08,
      "end": 372.919,
      "text": "वजह से भी इन्हें फायदा मिला है तो ये"
    },
    {
      "subtitle_id": 175,
      "start": 371.44,
      "end": 375.12,
      "text": "लोगों के लिए थोड़े अनएक्सपेक्टेड चीजें"
    },
    {
      "subtitle_id": 176,
      "start": 372.919,
      "end": 376.68,
      "text": "थी जिसका फायदा कंपनी के शेयर प्राइस में"
    },
    {
      "subtitle_id": 177,
      "start": 375.12,
      "end": 379.12,
      "text": "हुआ है लेकिन क्या शेयर प्राइस इतनी"
    },
    {
      "subtitle_id": 178,
      "start": 376.68,
      "end": 381.0,
      "text": "ज्यादा बढ़नी चाहिए थी तो शायद नहीं क्यों"
    },
    {
      "subtitle_id": 179,
      "start": 379.12,
      "end": 383.0,
      "text": "क्योंकि कुछ टाइम बाद ये ग्रोथ जो है जो"
    },
    {
      "subtitle_id": 180,
      "start": 381.0,
      "end": 384.639,
      "text": "सडन आ गई है ये कम हो जाएगी क्योंकि"
    },
    {
      "subtitle_id": 181,
      "start": 383.0,
      "end": 386.28,
      "text": "रेवेन्यू आपका नहीं बढ़ रहा है और फिर"
    },
    {
      "subtitle_id": 182,
      "start": 384.639,
      "end": 388.4,
      "text": "रेवेन्यू पर उनको काम करने की जरूरत"
    },
    {
      "subtitle_id": 183,
      "start": 386.28,
      "end": 390.68,
      "text": "पड़ेगी जो अलग चैलेंज है कैसे उसे टैकल"
    },
    {
      "subtitle_id": 184,
      "start": 388.4,
      "end": 392.36,
      "text": "करते देखना इंटरेस्टिंग रहेगा दूसरा पॉइंट"
    },
    {
      "subtitle_id": 185,
      "start": 390.68,
      "end": 395.199,
      "text": "लोगों का इतना ज्यादा बुलिश होने के पीछे"
    },
    {
      "subtitle_id": 186,
      "start": 392.36,
      "end": 397.12,
      "text": "यह है कि करंट जो गवर्नमेंट है एनडीए की"
    },
    {
      "subtitle_id": 187,
      "start": 395.199,
      "end": 398.919,
      "text": "उनका फोकस हमेशा से डाइवस्ट मेंट पर रहा"
    },
    {
      "subtitle_id": 188,
      "start": 397.12,
      "end": 400.68,
      "text": "है सरकारी कंपनीज में स्टेक बेचना या फिर"
    },
    {
      "subtitle_id": 189,
      "start": 398.919,
      "end": 402.68,
      "text": "उन्हें प्रॉफिटेबल बनाना अब इस वजह से"
    },
    {
      "subtitle_id": 190,
      "start": 400.68,
      "end": 405.08,
      "text": "होता यह है कि फिलहाल गवर्नमेंट इस"
    },
    {
      "subtitle_id": 191,
      "start": 402.68,
      "end": 407.0,
      "text": "इलेक्शन के बाद जो तीन स्टेट्स चार"
    },
    {
      "subtitle_id": 192,
      "start": 405.08,
      "end": 409.039,
      "text": "स्टेट्स के इलेक्शंस हुए उसके बाद जब तीन"
    },
    {
      "subtitle_id": 193,
      "start": 407.0,
      "end": 411.759,
      "text": "स्टेट्स में बीजेपी आई तो काफी सारे लोगों"
    },
    {
      "subtitle_id": 194,
      "start": 409.039,
      "end": 414.16,
      "text": "को लग रहा है कि शायद सेंटर में एनडीए फिर"
    },
    {
      "subtitle_id": 195,
      "start": 411.759,
      "end": 416.8,
      "text": "से सरकार बनाएगी और फिर से अपना जो फोकस"
    },
    {
      "subtitle_id": 196,
      "start": 414.16,
      "end": 418.919,
      "text": "है डाइवस्ट मेंट पर वो जारी रखेंगे जिससे"
    },
    {
      "subtitle_id": 197,
      "start": 416.8,
      "end": 421.08,
      "text": "पीएसयू अगेन फोकस में रहेंगे और अगेन इसकी"
    },
    {
      "subtitle_id": 198,
      "start": 418.919,
      "end": 423.84,
      "text": "शेयर प्राइस बढ़ती रहेगी अब इसके पीछे एक"
    },
    {
      "subtitle_id": 199,
      "start": 421.08,
      "end": 426.28,
      "text": "और लॉजिक यह भी है कि देखिए लास्ट बजट जो"
    },
    {
      "subtitle_id": 200,
      "start": 423.84,
      "end": 428.36,
      "text": "होता है इलेक्शन के पहले का जस्ट वो हमेशा"
    },
    {
      "subtitle_id": 201,
      "start": 426.28,
      "end": 430.599,
      "text": "ज्यादा टाइम पॉजिटिव ही होता है तो उसमें"
    },
    {
      "subtitle_id": 202,
      "start": 428.36,
      "end": 432.879,
      "text": "भी कुछ ऐसी अनाउंसमेंट्स आ सकती है जो"
    },
    {
      "subtitle_id": 203,
      "start": 430.599,
      "end": 434.199,
      "text": "पीएसयू के फेवर में हो और इन वजह से लोग"
    },
    {
      "subtitle_id": 204,
      "start": 432.879,
      "end": 435.84,
      "text": "देख रहे हैं कि पीएसयू में और भी"
    },
    {
      "subtitle_id": 205,
      "start": 434.199,
      "end": 438.12,
      "text": "पोटेंशियल है और उसमें इन्वेस्ट करते जा"
    },
    {
      "subtitle_id": 206,
      "start": 435.84,
      "end": 440.639,
      "text": "रहे हैं अब देखिए पीएसओस के फंडामेंटल्स"
    },
    {
      "subtitle_id": 207,
      "start": 438.12,
      "end": 442.639,
      "text": "हिस्टॉरिकली जैसे थे उससे बेटर हुए हैं"
    },
    {
      "subtitle_id": 208,
      "start": 440.639,
      "end": 444.479,
      "text": "शेयर प्राइस भी बढ़नी चाहिए थी लेकिन इतनी"
    },
    {
      "subtitle_id": 209,
      "start": 442.639,
      "end": 446.24,
      "text": "नहीं तो अब ये जो शेयर प्राइस बढ़ी है"
    },
    {
      "subtitle_id": 210,
      "start": 444.479,
      "end": 447.8,
      "text": "ज्यादा काफी सारे पीएस स्टॉक्स जो ओवर"
    },
    {
      "subtitle_id": 211,
      "start": 446.24,
      "end": 449.759,
      "text": "वैल्यूड हुए हैं तो क्या हम यह कह सकते"
    },
    {
      "subtitle_id": 212,
      "start": 447.8,
      "end": 452.72,
      "text": "हैं कि करेक्शन आने वाला है तो मुझे ऐसा"
    },
    {
      "subtitle_id": 213,
      "start": 449.759,
      "end": 454.319,
      "text": "नहीं लगता है जहां तक मैंने"
    },
    {
      "subtitle_id": 214,
      "start": 452.72,
      "end": 456.72,
      "text": "201314"
    },
    {
      "subtitle_id": 215,
      "start": 454.319,
      "end": 458.68,
      "text": "201819 यह दो इलेक्शंस देखे तो उसमें"
    },
    {
      "subtitle_id": 216,
      "start": 456.72,
      "end": 460.36,
      "text": "मैंने यही चीज देखे कि इलेक्शन के पहले"
    },
    {
      "subtitle_id": 217,
      "start": 458.68,
      "end": 462.599,
      "text": "जब-जब लोगों को लगता है कि एनडीए सरकार"
    },
    {
      "subtitle_id": 218,
      "start": 460.36,
      "end": 464.68,
      "text": "गवर्नमेंट बनाएगी जल्दी मार्केट करेक्ट"
    },
    {
      "subtitle_id": 219,
      "start": 462.599,
      "end": 466.44,
      "text": "नहीं होता है मार्केट और ज्यादा बढ़ते चला"
    },
    {
      "subtitle_id": 220,
      "start": 464.68,
      "end": 468.96,
      "text": "जाता है चाहे वो फिर बबल हो जाए या फिर"
    },
    {
      "subtitle_id": 221,
      "start": 466.44,
      "end": 471.879,
      "text": "बहुत ओवर वैल्यूड हो जाए ये चीज 2013 के"
    },
    {
      "subtitle_id": 222,
      "start": 468.96,
      "end": 474.639,
      "text": "दिसंबर मंथ से शुरू हुई थी जो मई जून तक"
    },
    {
      "subtitle_id": 223,
      "start": 471.879,
      "end": 476.24,
      "text": "चली थी 2014 के अगर आप शेयर प्राइस ग्राफ"
    },
    {
      "subtitle_id": 224,
      "start": 474.639,
      "end": 477.8,
      "text": "देखेंगे उस टाइम कंपनीज के या फिर"
    },
    {
      "subtitle_id": 225,
      "start": 476.24,
      "end": 479.84,
      "text": "सेंसेक्स निफ्टी के तो आपको उससे एक बेटर"
    },
    {
      "subtitle_id": 226,
      "start": 477.8,
      "end": 481.52,
      "text": "आईडिया आएगी तो यहां पर भी इले से पहले"
    },
    {
      "subtitle_id": 227,
      "start": 479.84,
      "end": 484.56,
      "text": "मुझे नहीं लगता कि कोई करेक्शन देखने मिले"
    },
    {
      "subtitle_id": 228,
      "start": 481.52,
      "end": 486.72,
      "text": "तो यह जो भी चीजें हैं यह मतलब अच्छी खासी"
    },
    {
      "subtitle_id": 229,
      "start": 484.56,
      "end": 488.52,
      "text": "प्रोबेबिलिटी है कि यह ऐसे ही जाती रहे तो"
    },
    {
      "subtitle_id": 230,
      "start": 486.72,
      "end": 490.36,
      "text": "इन पीएसओ स्टॉक्स में अभी इस लेवल पे"
    },
    {
      "subtitle_id": 231,
      "start": 488.52,
      "end": 492.0,
      "text": "करेक्शन मिलना मेरे हिसाब से तो बहुत"
    },
    {
      "subtitle_id": 232,
      "start": 490.36,
      "end": 494.879,
      "text": "ज्यादा मुश्किल है लेकिन हां मैं आपको बता"
    },
    {
      "subtitle_id": 233,
      "start": 492.0,
      "end": 496.759,
      "text": "दूं कि जैसे 2002 टू 2007 पीएस स्टॉक्स"
    },
    {
      "subtitle_id": 234,
      "start": 494.879,
      "end": 499.12,
      "text": "बहुत चले फ फिर अगले 12 साल बिल्कुल भी"
    },
    {
      "subtitle_id": 235,
      "start": 496.759,
      "end": 501.44,
      "text": "नहीं चले अब फिर से चलने लगे हैं यह इस"
    },
    {
      "subtitle_id": 236,
      "start": 499.12,
      "end": 503.56,
      "text": "तरह की प्रोसेस पीएसयू में होती रहती है"
    },
    {
      "subtitle_id": 237,
      "start": 501.44,
      "end": 505.72,
      "text": "तो डिस्काउंट अगर आपको चाहिए तो अगेन"
    },
    {
      "subtitle_id": 238,
      "start": 503.56,
      "end": 507.96,
      "text": "इसमें वेट करना पड़ेगा पिछले साल के मिड"
    },
    {
      "subtitle_id": 239,
      "start": 505.72,
      "end": 510.24,
      "text": "तक डिस्काउंट्स अवेलेबल थे पीएसयू में जो"
    },
    {
      "subtitle_id": 240,
      "start": 507.96,
      "end": 511.639,
      "text": "अभी नहीं है और जिन-जिन लोगों ने ये देखा"
    },
    {
      "subtitle_id": 241,
      "start": 510.24,
      "end": 513.56,
      "text": "जैसे हमने बैंक ऑफ महाराष्ट्र पर भी"
    },
    {
      "subtitle_id": 242,
      "start": 511.639,
      "end": 515.56,
      "text": "वीडियो बनाया था और हमने बात की कि कैसे"
    },
    {
      "subtitle_id": 243,
      "start": 513.56,
      "end": 517.64,
      "text": "वहां के जो सीईओ है उन्होंने कंपनी को"
    },
    {
      "subtitle_id": 244,
      "start": 515.56,
      "end": 519.519,
      "text": "पूरा ट्रांसफॉर्म किया सेम चीज कई सारे"
    },
    {
      "subtitle_id": 245,
      "start": 517.64,
      "end": 521.44,
      "text": "पीएसयू स्टॉक्स में हो रही है जिसका भी"
    },
    {
      "subtitle_id": 246,
      "start": 519.519,
      "end": 523.24,
      "text": "कंपनी को फायदा मिल रहा है लेकिन हां शेयर"
    },
    {
      "subtitle_id": 247,
      "start": 521.44,
      "end": 524.8,
      "text": "प्राइस बढ़नी चाहिए थी लेकिन अभी इतनी जो"
    },
    {
      "subtitle_id": 248,
      "start": 523.24,
      "end": 526.12,
      "text": "बढ़ी है या आप कह सकते हैं कि रिटेल"
    },
    {
      "subtitle_id": 249,
      "start": 524.8,
      "end": 528.16,
      "text": "इन्वेस्टर्स थोड़ा भी पीछे पड़े हैं"
    },
    {
      "subtitle_id": 250,
      "start": 526.12,
      "end": 531.68,
      "text": "पीएसयू के और मुझे नहीं लगता कि ये जल्दी"
    },
    {
      "subtitle_id": 251,
      "start": 528.16,
      "end": 534.2,
      "text": "रुकने भी वाला है तो अगर मैं इस वीडियो को"
    },
    {
      "subtitle_id": 252,
      "start": 531.68,
      "end": 535.44,
      "text": "कंक्लूजन प्राइस बहुत तेजी से बढ़ रही है"
    },
    {
      "subtitle_id": 253,
      "start": 534.2,
      "end": 537.0,
      "text": "उसके पीछे एक रीजन ये भी है कि"
    },
    {
      "subtitle_id": 254,
      "start": 535.44,
      "end": 539.399,
      "text": "फंडामेंटल्स इनके थोड़े बेटर हो रहे हैं"
    },
    {
      "subtitle_id": 255,
      "start": 537.0,
      "end": 541.64,
      "text": "ऑन प्रॉफिट साइड बट रेवेन्यू साइड अभी भी"
    },
    {
      "subtitle_id": 256,
      "start": 539.399,
      "end": 543.279,
      "text": "स्ट्रगल जारी है तो एक बहुत बड़ा मतलब"
    },
    {
      "subtitle_id": 257,
      "start": 541.64,
      "end": 544.76,
      "text": "मेरे हिसाब से रेड फ्लैग होगा क्योंकि"
    },
    {
      "subtitle_id": 258,
      "start": 543.279,
      "end": 546.399,
      "text": "ज्यादातर जो पीएसयू स्टॉक्स है जो बहुत"
    },
    {
      "subtitle_id": 259,
      "start": 544.76,
      "end": 548.519,
      "text": "तेजी से बढ़ रहे हैं अभी भी उनकी रेवेन्यू"
    },
    {
      "subtitle_id": 260,
      "start": 546.399,
      "end": 551.04,
      "text": "ग्रोथ सिंगल डिजिट और डबल डिजिट में है तो"
    },
    {
      "subtitle_id": 261,
      "start": 548.519,
      "end": 553.32,
      "text": "1112 के करीब ही है जबकि इनकी शेयर प्राइस"
    },
    {
      "subtitle_id": 262,
      "start": 551.04,
      "end": 555.519,
      "text": "बहुत तेजी से आगे बढ़ रही है तो इस चीज को"
    },
    {
      "subtitle_id": 263,
      "start": 553.32,
      "end": 557.36,
      "text": "आपको देखना पड़ेगा कि अगर आपको लगता है कि"
    },
    {
      "subtitle_id": 264,
      "start": 555.519,
      "end": 560.12,
      "text": "उस कंपनी में रेवेन्यू पोटेंशियल है उतना"
    },
    {
      "subtitle_id": 265,
      "start": 557.36,
      "end": 562.44,
      "text": "ज्यादा बढ़ने का तो मे बी इट वुड मेक सेंस"
    },
    {
      "subtitle_id": 266,
      "start": 560.12,
      "end": 564.36,
      "text": "बट एलआईसी जैसी कंपनीज है जो बहुत ज्यादा"
    },
    {
      "subtitle_id": 267,
      "start": 562.44,
      "end": 566.72,
      "text": "ग्रोथ आपको नहीं दे सकती रेवेन्यू में तो"
    },
    {
      "subtitle_id": 268,
      "start": 564.36,
      "end": 568.76,
      "text": "एक लेवल पे इन जैसी कंपनीज की जो ग्रोथ है"
    },
    {
      "subtitle_id": 269,
      "start": 566.72,
      "end": 570.68,
      "text": "वो रुक जाएगी प्रॉफिट ग्रोथ भी जितनी तेजी"
    },
    {
      "subtitle_id": 270,
      "start": 568.76,
      "end": 572.72,
      "text": "से हो रही है और नॉर्मल ग्रोथ पर ही वापस"
    },
    {
      "subtitle_id": 271,
      "start": 570.68,
      "end": 574.32,
      "text": "आ जाएंगे तो उस एंगल से भी आपको इन कंपनीज"
    },
    {
      "subtitle_id": 272,
      "start": 572.72,
      "end": 575.76,
      "text": "को जरूर एनालाइज करना चाहिए और अगर आप"
    },
    {
      "subtitle_id": 273,
      "start": 574.32,
      "end": 577.48,
      "text": "इन्वेस्टर हैं जो पीएसयू कंपनीज में"
    },
    {
      "subtitle_id": 274,
      "start": 575.76,
      "end": 579.399,
      "text": "डिस्काउंट का इंतजार कर रहे हैं तो मुझे"
    },
    {
      "subtitle_id": 275,
      "start": 577.48,
      "end": 580.88,
      "text": "लगता है कि आपको लंबा इंतजार करना पड़ेगा"
    },
    {
      "subtitle_id": 276,
      "start": 579.399,
      "end": 583.36,
      "text": "शायद इलेक्शन के बाद ही आपको कोई"
    },
    {
      "subtitle_id": 277,
      "start": 580.88,
      "end": 587.04,
      "text": "डिस्काउंट मिलेगा उससे पहले मिलना तो"
    },
    {
      "subtitle_id": 278,
      "start": 583.36,
      "end": 587.04,
      "text": "जनरली बहुत डिफिकल्ट होता है"
    }
  ]
}