  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.08,
      "end": 4.44,
      "text": "अभी मैं आपको तीन शेयर्स का डाटा दिखाता"
    },
    {
      "subtitle_id": 2,
      "start": 1.88,
      "end": 6.839,
      "text": "हूं देखते हैं कि आप में से कितने लोग"
    },
    {
      "subtitle_id": 3,
      "start": 4.44,
      "end": 8.559,
      "text": "उसमें एक कॉमन चीज़ फिगर आउट कर पाते हैं"
    },
    {
      "subtitle_id": 4,
      "start": 6.839,
      "end": 10.28,
      "text": "इसमें पहली कंपनी है नाका जिसके शेयर"
    },
    {
      "subtitle_id": 5,
      "start": 8.559,
      "end": 12.2,
      "text": "प्राइस आप स्क्रीन पर देख सकते हो कंपनी"
    },
    {
      "subtitle_id": 6,
      "start": 10.28,
      "end": 13.799,
      "text": "ने 5s टू 1 बोनस दिया था इसलिए शेयर"
    },
    {
      "subtitle_id": 7,
      "start": 12.2,
      "end": 15.879,
      "text": "प्राइस में चेंजेज आ गए हैं लेकिन"
    },
    {
      "subtitle_id": 8,
      "start": 13.799,
      "end": 17.84,
      "text": "मोटा-मोटा अगर बोनस एडजस्ट प्राइस की बात"
    },
    {
      "subtitle_id": 9,
      "start": 15.879,
      "end": 20.119,
      "text": "करें लिस्टिंग वाले दिन ही नाका का शेयर"
    },
    {
      "subtitle_id": 10,
      "start": 17.84,
      "end": 22.039,
      "text": "78 ऊपर चला गया और बाद में कुछ ही दिनों"
    },
    {
      "subtitle_id": 11,
      "start": 20.119,
      "end": 24.16,
      "text": "में शेयर प्राइस डबल हो ग सेकंड एग्जांपल"
    },
    {
      "subtitle_id": 12,
      "start": 22.039,
      "end": 24.16,
      "text": "है"
    },
    {
      "subtitle_id": 13,
      "start": 30.039,
      "end": 33.48,
      "text": "ट्रिक की जिसके शेयर प्राइस आप स्क्रीन पर"
    },
    {
      "subtitle_id": 14,
      "start": 31.84,
      "end": 35.52,
      "text": "देख रहे हो लिस्टिंग के कुछ ही दिन बाद"
    },
    {
      "subtitle_id": 15,
      "start": 33.48,
      "end": 38.6,
      "text": "कंपनी की शेयर प्राइस भी लगभग डबल हो गई"
    },
    {
      "subtitle_id": 16,
      "start": 35.52,
      "end": 40.48,
      "text": "है तो ओवरऑल इन तीन कंपनीज में कॉमन चीज"
    },
    {
      "subtitle_id": 17,
      "start": 38.6,
      "end": 42.52,
      "text": "क्या है तो तीनों की शेयर प्राइस लिस्टिंग"
    },
    {
      "subtitle_id": 18,
      "start": 40.48,
      "end": 43.879,
      "text": "के टाइम डबल हो गई थी लेकिन अगर मैं नायका"
    },
    {
      "subtitle_id": 19,
      "start": 42.52,
      "end": 47.92,
      "text": "की बात करूं तो नायका अभी तक अपने"
    },
    {
      "subtitle_id": 20,
      "start": 43.879,
      "end": 47.92,
      "text": "लिस्टिंग एंड प्राइस तक नहीं पहुंच पाई"
    },
    {
      "subtitle_id": 21,
      "start": 49.2,
      "end": 52.239,
      "text": "[संगीत]"
    },
    {
      "subtitle_id": 22,
      "start": 60.12,
      "end": 64.04,
      "text": "वहीं पर नायका की बात करें तो नायका अभी"
    },
    {
      "subtitle_id": 23,
      "start": 62.0,
      "end": 65.88,
      "text": "भी स्ट्रगल ही कर रही है और अभी बात हो"
    },
    {
      "subtitle_id": 24,
      "start": 64.04,
      "end": 69.6,
      "text": "रही है ओला इलेक्ट्रिक की हर जगह यही"
    },
    {
      "subtitle_id": 25,
      "start": 65.88,
      "end": 69.6,
      "text": "चर्चा चल रहे हैं मैंने सोशल मीडिया पर"
    },
    {
      "subtitle_id": 26,
      "start": 89.96,
      "end": 93.479,
      "text": "लेकिन ओला इलेक्ट्रिक के केस में कंपनी कब"
    },
    {
      "subtitle_id": 27,
      "start": 91.64,
      "end": 95.32,
      "text": "प्रॉफिटेबल होगी उसे पता करने की आज हम"
    },
    {
      "subtitle_id": 28,
      "start": 93.479,
      "end": 97.2,
      "text": "कोशिश करेंगे एक और इंटरेस्टिंग चीज मैं"
    },
    {
      "subtitle_id": 29,
      "start": 95.32,
      "end": 99.32,
      "text": "आपको बताता हूं प्रोफेसर अश्वत दामोदरन"
    },
    {
      "subtitle_id": 30,
      "start": 97.2,
      "end": 102.399,
      "text": "जिन्हें डीन ऑफ वैल्यूएशन भी कहते हैं"
    },
    {
      "subtitle_id": 31,
      "start": 99.32,
      "end": 102.399,
      "text": "उन्होंने कुछ साल पहले"
    },
    {
      "subtitle_id": 32,
      "start": 105.079,
      "end": 109.079,
      "text": "paytm2 के वैल्यूएशन पर आया उस टाइम"
    },
    {
      "subtitle_id": 33,
      "start": 107.32,
      "end": 110.719,
      "text": "प्रोफेसर अश्वत दामोदर ने ये कहा था कि"
    },
    {
      "subtitle_id": 34,
      "start": 109.079,
      "end": 112.64,
      "text": "कंपनी का जो फेयर वैल्यूएशन है वो $"
    },
    {
      "subtitle_id": 35,
      "start": 110.719,
      "end": 114.079,
      "text": "बिलियन डॉलर के आसपास है यानी कि लगभग 5"
    },
    {
      "subtitle_id": 36,
      "start": 112.64,
      "end": 115.88,
      "text": "लाख करोड़ का जो वैल्यूएशन है उन्होंने"
    },
    {
      "subtitle_id": 37,
      "start": 114.079,
      "end": 117.439,
      "text": "कहा था कि ये फेयर वैल्यूएशन है लेकिन आप"
    },
    {
      "subtitle_id": 38,
      "start": 115.88,
      "end": 119.6,
      "text": "यहां पर देख सकते हैं कि बाद में कंपनी की"
    },
    {
      "subtitle_id": 39,
      "start": 117.439,
      "end": 122.799,
      "text": "शेयर प्राइस लगातार गिरती रही लेकिन बाद"
    },
    {
      "subtitle_id": 40,
      "start": 119.6,
      "end": 122.799,
      "text": "में कंपनी का आईपीओ लगभग"
    },
    {
      "subtitle_id": 41,
      "start": 123.039,
      "end": 129.2,
      "text": "₹2000000"
    },
    {
      "subtitle_id": 42,
      "start": 125.84,
      "end": 131.039,
      "text": "₹1000000 पर आ चुकी है और इसी बीच कंपनी"
    },
    {
      "subtitle_id": 43,
      "start": 129.2,
      "end": 133.599,
      "text": "का जो 5 लाख करोड़ का वैल्यूएशन था वो आ"
    },
    {
      "subtitle_id": 44,
      "start": 131.039,
      "end": 135.4,
      "text": "गया है मात्र 35000 करोड़ यानी पूरी"
    },
    {
      "subtitle_id": 45,
      "start": 133.599,
      "end": 137.64,
      "text": "वैल्यू डिस्ट्रक्शन की केस स्टडी बन सकती"
    },
    {
      "subtitle_id": 46,
      "start": 135.4,
      "end": 139.68,
      "text": "है इस पर लेकिन यहां पर सवाल आता है कि"
    },
    {
      "subtitle_id": 47,
      "start": 137.64,
      "end": 141.64,
      "text": "अगर जो वैल्युएशन के बहुत बड़े एक्सपर्ट"
    },
    {
      "subtitle_id": 48,
      "start": 139.68,
      "end": 143.519,
      "text": "हैं और डीन ऑफ वैल्युएशन माने जाते हैं वो"
    },
    {
      "subtitle_id": 49,
      "start": 141.64,
      "end": 144.92,
      "text": "इस केस में कैसे गलत हुए तो गलत जाने के"
    },
    {
      "subtitle_id": 50,
      "start": 143.519,
      "end": 146.92,
      "text": "पीछे जो कारण है वो है प्रॉफिटेबिलिटी"
    },
    {
      "subtitle_id": 51,
      "start": 144.92,
      "end": 149.879,
      "text": "प्रोफेसर अश्वत दामोदर ने प्रिडिक्ट किया"
    },
    {
      "subtitle_id": 52,
      "start": 146.92,
      "end": 151.44,
      "text": "था कि paytm2 सालों में प्रॉफिटेबल बनेगी"
    },
    {
      "subtitle_id": 53,
      "start": 149.879,
      "end": 153.599,
      "text": "वहां से पॉजिटिव फ्री कैश फ्लो आना शुरू"
    },
    {
      "subtitle_id": 54,
      "start": 151.44,
      "end": 155.319,
      "text": "हो जाएगा ऐसा उनका मानना था लेकिन एक्चुअल"
    },
    {
      "subtitle_id": 55,
      "start": 153.599,
      "end": 157.599,
      "text": "में ऐसा बिल्कुल भी नहीं हुआ अगर आज भी हम"
    },
    {
      "subtitle_id": 56,
      "start": 155.319,
      "end": 160.599,
      "text": "देखें तो कंपनी लॉसेस पर लॉसेस लॉसेस पर"
    },
    {
      "subtitle_id": 57,
      "start": 157.599,
      "end": 160.599,
      "text": "लॉसेस बुक कर रही है"
    },
    {
      "subtitle_id": 58,
      "start": 165.36,
      "end": 169.519,
      "text": "paytm2 इस लगातार बढ़ रही है जहां पर बहुत"
    },
    {
      "subtitle_id": 59,
      "start": 168.08,
      "end": 170.68,
      "text": "सारे लोग अब नए-नए लोग कंपनी में"
    },
    {
      "subtitle_id": 60,
      "start": 169.519,
      "end": 172.64,
      "text": "पार्टिसिपेट कर रहे हैं क्योंकि शेयर"
    },
    {
      "subtitle_id": 61,
      "start": 170.68,
      "end": 174.239,
      "text": "प्राइस लगातार बढ़ रही है यहां पर एक चीज"
    },
    {
      "subtitle_id": 62,
      "start": 172.64,
      "end": 176.519,
      "text": "हमें समझना जरूरी है कि क्या ये शेयर"
    },
    {
      "subtitle_id": 63,
      "start": 174.239,
      "end": 178.48,
      "text": "प्राइस सस्टेन कर पाएगी और इसके लिए हमें"
    },
    {
      "subtitle_id": 64,
      "start": 176.519,
      "end": 180.68,
      "text": "ये समझना पड़ेगा कि क्या कंपनी प्रॉफिट"
    },
    {
      "subtitle_id": 65,
      "start": 178.48,
      "end": 182.44,
      "text": "बना पाएगी और बना पाएगी तो कब ओला"
    },
    {
      "subtitle_id": 66,
      "start": 180.68,
      "end": 184.599,
      "text": "इलेक्ट्रिक से रिलेटेड सारे सवालों के"
    },
    {
      "subtitle_id": 67,
      "start": 182.44,
      "end": 186.36,
      "text": "जवाब आज आपको इस वीडियो में मिल जाएंगे"
    },
    {
      "subtitle_id": 68,
      "start": 184.599,
      "end": 188.519,
      "text": "नमस्कार मैं प्रसाद आपका आज के इस वीडियो"
    },
    {
      "subtitle_id": 69,
      "start": 186.36,
      "end": 190.0,
      "text": "में स्वागत करता हूं 9थ अगस्त को ला"
    },
    {
      "subtitle_id": 70,
      "start": 188.519,
      "end": 192.44,
      "text": "इलेक्ट्रिक के शेयर्स स्टॉक एक्सचेंज पर"
    },
    {
      "subtitle_id": 71,
      "start": 190.0,
      "end": 195.799,
      "text": "लिस्ट हो गए और उसके बाद 15th अगस्त को ला"
    },
    {
      "subtitle_id": 72,
      "start": 192.44,
      "end": 196.959,
      "text": "ने एक इवेंट रखा जिसका नाम था ला संकल्प"
    },
    {
      "subtitle_id": 73,
      "start": 195.799,
      "end": 199.72,
      "text": "जिसमें भाविश अगरवाल ने बड़ी-बड़ी"
    },
    {
      "subtitle_id": 74,
      "start": 196.959,
      "end": 201.64,
      "text": "अनाउंसमेंट्स की कि जैसे वो ओला रोडस्टर"
    },
    {
      "subtitle_id": 75,
      "start": 199.72,
      "end": 203.68,
      "text": "नाम की ई बाइक लॉन्च कर रहे हैं उसके"
    },
    {
      "subtitle_id": 76,
      "start": 201.64,
      "end": 205.72,
      "text": "अलावा जो सेल्स है बैटरी सेल्स वो इंडिया"
    },
    {
      "subtitle_id": 77,
      "start": 203.68,
      "end": 207.56,
      "text": "में बनाएंगे अब यह सेल बनाने के लिए जो"
    },
    {
      "subtitle_id": 78,
      "start": 205.72,
      "end": 209.4,
      "text": "कुछ चीजें होती है रॉ मटेरियल उसमें से"
    },
    {
      "subtitle_id": 79,
      "start": 207.56,
      "end": 211.2,
      "text": "कुछ चीजों पर गवर्नमेंट ने इंपोर्ट ड्यूटी"
    },
    {
      "subtitle_id": 80,
      "start": 209.4,
      "end": 212.84,
      "text": "हटा दी है जिसके चलते ला की जो"
    },
    {
      "subtitle_id": 81,
      "start": 211.2,
      "end": 214.84,
      "text": "मैन्युफैक्चरिंग कॉस्ट है वह काफी कम हो"
    },
    {
      "subtitle_id": 82,
      "start": 212.84,
      "end": 216.799,
      "text": "सकती है जैसे अनाउंसमेंट बाहर है कि ई"
    },
    {
      "subtitle_id": 83,
      "start": 214.84,
      "end": 218.76,
      "text": "बाइक लॉन्च करने वाली है कॉस्ट कम होने"
    },
    {
      "subtitle_id": 84,
      "start": 216.799,
      "end": 220.84,
      "text": "वाली है उसके बाद अगले दिन यानी 16th"
    },
    {
      "subtitle_id": 85,
      "start": 218.76,
      "end": 223.48,
      "text": "अगस्त को शेयर प्राइस में अप्पर सर्किट लग"
    },
    {
      "subtitle_id": 86,
      "start": 220.84,
      "end": 225.159,
      "text": "गया और शेयर प्राइस 20 पर से बढ़ गई बीच"
    },
    {
      "subtitle_id": 87,
      "start": 223.48,
      "end": 227.2,
      "text": "में दो दिन छुट्टियां थी फिर 19th अगस्त"
    },
    {
      "subtitle_id": 88,
      "start": 225.159,
      "end": 228.959,
      "text": "को फिर से अपर सर्किट हिट हुआ और इस तरह"
    },
    {
      "subtitle_id": 89,
      "start": 227.2,
      "end": 230.56,
      "text": "से शेयर प्राइस बढ़ती चली गई लेकिन यहां"
    },
    {
      "subtitle_id": 90,
      "start": 228.959,
      "end": 232.159,
      "text": "पर कुछ चीजें सोचने वाली कि शॉर्ट टर्म"
    },
    {
      "subtitle_id": 91,
      "start": 230.56,
      "end": 234.079,
      "text": "में ठीक है सुनने में सारी चीजें सही लगती"
    },
    {
      "subtitle_id": 92,
      "start": 232.159,
      "end": 236.04,
      "text": "है लेकिन इन चीजों का सही में कितना"
    },
    {
      "subtitle_id": 93,
      "start": 234.079,
      "end": 237.599,
      "text": "इंपैक्ट होगा जैसे अभी भाविश अग्रवाल ने"
    },
    {
      "subtitle_id": 94,
      "start": 236.04,
      "end": 239.319,
      "text": "बड़ी-बड़ी अनाउंसमेंट्स की है जिसके चलते"
    },
    {
      "subtitle_id": 95,
      "start": 237.599,
      "end": 240.879,
      "text": "शेयर प्राइस बढ़ी है इससे पहले भी"
    },
    {
      "subtitle_id": 96,
      "start": 239.319,
      "end": 242.64,
      "text": "इन्होंने अनाउंसमेंट्स की थी उसका क्या"
    },
