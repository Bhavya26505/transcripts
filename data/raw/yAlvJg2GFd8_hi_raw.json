      "start": 447.08,
      "end": 452.0,
      "text": "मैं कुछ नंबर्स दिखाता हूं बजज के बजज में"
    },
    {
      "subtitle_id": 194,
      "start": 449.52,
      "end": 454.199,
      "text": "ने चेतक नाम से ई स्कूटर लॉन्च की थी नंबर"
    },
    {
      "subtitle_id": 195,
      "start": 452.0,
      "end": 456.84,
      "text": "शुरुआत में बहुत स्लगिश थे 2021 में मात्र"
    },
    {
      "subtitle_id": 196,
      "start": 454.199,
      "end": 459.12,
      "text": "1300 का सेल था 2022 में इन्होंने 8000"
    },
    {
      "subtitle_id": 197,
      "start": 456.84,
      "end": 461.56,
      "text": "यूनिट्स बेचे लेकिन फिर 2023 से इन्होंने"
    },
    {
      "subtitle_id": 198,
      "start": 459.12,
      "end": 464.96,
      "text": "पिकअप करना शुरू किया 2023 में इन्होंने"
    },
    {
      "subtitle_id": 199,
      "start": 461.56,
      "end": 468.0,
      "text": "36000 ई स्कूटर्स बेची है और 2024 में यह"
    },
    {
      "subtitle_id": 200,
      "start": 464.96,
      "end": 469.8,
      "text": "नंबर 1 155000 पर आ गया है यानी कि ग्रोथ"
    },
    {
      "subtitle_id": 201,
      "start": 468.0,
      "end": 471.879,
      "text": "सिर्फ ओला नहीं दिखा रही है जो भी"
    },
    {
      "subtitle_id": 202,
      "start": 469.8,
      "end": 473.599,
      "text": "कंपीटीटर्स हैं सारे के सारे ग्रोथ दिखा"
    },
    {
      "subtitle_id": 203,
      "start": 471.879,
      "end": 475.56,
      "text": "रहे हैं जिससे यह मार्केट बहुत ज्यादा"
    },
    {
      "subtitle_id": 204,
      "start": 473.599,
      "end": 479.199,
      "text": "क्राउडेड हो रहा है पर फर्क यह है कि जो"
    },
    {
      "subtitle_id": 205,
      "start": 475.56,
      "end": 479.199,
      "text": "बाकी कंपीटीटर्स हैं जैसे कि"
    },
    {
      "subtitle_id": 206,
      "start": 479.479,
      "end": 482.879,
      "text": "प्रॉफिटेबल है इनके पास डीप पॉकेट्स है"
    },
    {
      "subtitle_id": 207,
      "start": 481.44,
      "end": 484.919,
      "text": "पैसा बहुत सारा है बिकॉज ऑलरेडी"
    },
    {
      "subtitle_id": 208,
      "start": 482.879,
      "end": 487.08,
      "text": "प्रॉफिटेबल है रिजर्व्स अच्छे खासे हैं"
    },
    {
      "subtitle_id": 209,
      "start": 484.919,
      "end": 489.199,
      "text": "डिस्ट्रीब्यूशन स्ट्रांग है जिसके चलते"
    },
    {
      "subtitle_id": 210,
      "start": 487.08,
      "end": 491.84,
      "text": "करेंटली जो ला का मार्केट शेयर है 40 पर"
    },
    {
      "subtitle_id": 211,
      "start": 489.199,
      "end": 493.599,
      "text": "का उसे भी मेंटेन करना बहुत टफ है बहुत"
    },
    {
      "subtitle_id": 212,
      "start": 491.84,
      "end": 495.12,
      "text": "ज्यादा टफ है अब बात करते हैं भाविश"
    },
    {
      "subtitle_id": 213,
      "start": 493.599,
      "end": 496.639,
      "text": "अगरवाल के प्लांस की जो उन्होंने 2 साल"
    },
    {
      "subtitle_id": 214,
      "start": 495.12,
      "end": 498.44,
      "text": "पहले बताया था अभी तो उन्होंने बताया"
    },
    {
      "subtitle_id": 215,
      "start": 496.639,
      "end": 500.199,
      "text": "संकल्प में कि आगे के हमारे प्लांस के हम"
    },
    {
      "subtitle_id": 216,
      "start": 498.44,
      "end": 501.919,
      "text": "क्या करने वाले लेकिन 2 साल पहले भी"
    },
    {
      "subtitle_id": 217,
      "start": 500.199,
      "end": 503.68,
      "text": "उन्होंने कुछ इसी तरह के प्लांस बताए थे"
    },
    {
      "subtitle_id": 218,
      "start": 501.919,
      "end": 506.479,
      "text": "अभी एक दो साल पहले भाविश अग्रवाल ने कहा"
    },
    {
      "subtitle_id": 219,
      "start": 503.68,
      "end": 508.72,
      "text": "था कि 2023 24 में हम हमारी जो कैपेसिटी"
    },
    {
      "subtitle_id": 220,
      "start": 506.479,
      "end": 511.52,
      "text": "है प्रोडक्शन कैपेसिटी ई स्कूटर्स की वो 2"
    },
    {
      "subtitle_id": 221,
      "start": 508.72,
      "end": 513.68,
      "text": "मिलियन तक लेके जा 20 लाख स्कूटर्स सालाना"
    },
    {
      "subtitle_id": 222,
      "start": 511.52,
      "end": 515.56,
      "text": "हम मैन्युफैक्चर करेंगे और उसके बाद इस"
    },
    {
      "subtitle_id": 223,
      "start": 513.68,
      "end": 517.32,
      "text": "कैपेसिटी को हम 1 करोड़ सालाना स्कूटर्स"
    },
    {
      "subtitle_id": 224,
      "start": 515.56,
      "end": 519.08,
      "text": "की मैन्युफैक्चरिंग तक लेके जाएंगे लेकिन"
    },
    {
      "subtitle_id": 225,
      "start": 517.32,
      "end": 520.68,
      "text": "एक्चुअली जो उन्होंने प्लांस किए थे और जो"
    },
    {
      "subtitle_id": 226,
      "start": 519.08,
      "end": 523.08,
      "text": "एग्जीक्यूशन हुआ है उसमें बहुत बड़ा"
    },
    {
      "subtitle_id": 227,
      "start": 520.68,
      "end": 525.519,
      "text": "डिफरेंस है फिलहाल कंपनी की कैपेसिटी 10"
    },
    {
      "subtitle_id": 228,
      "start": 523.08,
      "end": 528.2,
      "text": "लाख ई स्कूटर्स की है लेकिन गाड़िया बेची"
    },
    {
      "subtitle_id": 229,
      "start": 525.519,
      "end": 530.56,
      "text": "जा रही है मात्र 35 लाख तो जो 67 लाख का"
    },
    {
      "subtitle_id": 230,
      "start": 528.2,
      "end": 532.399,
      "text": "बीच में गैप है वो अभी भी फिल नहीं हुआ है"
    },
    {
      "subtitle_id": 231,
      "start": 530.56,
      "end": 534.48,
      "text": "तो ऐसे में 2 मिलियन का एक्सपेंशन करके"
    },
    {
      "subtitle_id": 232,
      "start": 532.399,
      "end": 536.08,
      "text": "कोई मतलब नहीं है अनली सेटली उतना सेल"
    },
    {
      "subtitle_id": 233,
      "start": 534.48,
      "end": 538.12,
      "text": "आएगा दूसरी चीज यहां पर कैपेसिटी"
    },
    {
      "subtitle_id": 234,
      "start": 536.08,
      "end": 539.64,
      "text": "यूटिलाइजेशन भी काफी कम है आपके पास 10"
    },
    {
      "subtitle_id": 235,
      "start": 538.12,
      "end": 542.079,
      "text": "लाख ई स्कूटर्स की मैन्युफैक्चरिंग"
    },
    {
      "subtitle_id": 236,
      "start": 539.64,
      "end": 544.519,
      "text": "कैपेसिटी है लेकिन बनानी बस 3 सवा लाख पड़"
    },
    {
      "subtitle_id": 237,
      "start": 542.079,
      "end": 546.0,
      "text": "रही है तो यह भी एक चैलेंज है फिर भाविश"
    },
    {
      "subtitle_id": 238,
      "start": 544.519,
      "end": 547.56,
      "text": "अगरवाल ने गिगा फैक्ट्री की बात की थी कि"
    },
    {
      "subtitle_id": 239,
      "start": 546.0,
      "end": 549.8,
      "text": "1 करोड़ गाड़ियां बनाएंगे वगैरह वगैरह"
    },
    {
      "subtitle_id": 240,
      "start": 547.56,
      "end": 551.8,
      "text": "लेकिन वो चीजें उन्होंने आईपीओ के टाइम"
    },
    {
      "subtitle_id": 241,
      "start": 549.8,
      "end": 553.88,
      "text": "अभी नहीं बोली है क्योंकि नंबर्स वहां तक"
    },
    {
      "subtitle_id": 242,
      "start": 551.8,
      "end": 556.16,
      "text": "रिच नहीं हो पा रहे हैं जो करंट कैपेसिटी"
    },
    {
      "subtitle_id": 243,
      "start": 553.88,
      "end": 558.16,
      "text": "है वही फुलफिल नहीं हो पा रही है और इसी"
    },
    {
      "subtitle_id": 244,
      "start": 556.16,
      "end": 559.92,
      "text": "बीच कंपनी का दूसरा प्रॉब्लम आता है देखिए"
    },
    {
      "subtitle_id": 245,
      "start": 558.16,
      "end": 563.519,
      "text": "कंपनी जिस फील्ड में ऑपरेट करती है बहुत"
    },
    {
      "subtitle_id": 246,
      "start": 559.92,
      "end": 566.079,
      "text": "ही हाईली कैपिटल इंटेंसिव बिजनेस है और"
    },
    {
      "subtitle_id": 247,
      "start": 563.519,
      "end": 568.12,
      "text": "एकदम कट थ्रोट कंपटीशन है बहुत ही क्रेजी"
    },
    {
      "subtitle_id": 248,
      "start": 566.079,
      "end": 569.92,
      "text": "कंपटीशन है इसीलिए कंपनीज को आगे बढ़ने के"
    },
    {
      "subtitle_id": 249,
      "start": 568.12,
      "end": 571.8,
      "text": "लिए कई बार कर्ज लेना पड़ता है ताकि वह"
    },
    {
      "subtitle_id": 250,
      "start": 569.92,
      "end": 573.92,
      "text": "तेजी से आगे मूव कर पाए मैन्युफैक्चरिंग"
    },
    {
      "subtitle_id": 251,
      "start": 571.8,
      "end": 575.519,
      "text": "फैसिलिटी बिल्ड कर पाए सो इसीलिए अगर आप"
    },
    {
      "subtitle_id": 252,
      "start": 573.92,
      "end": 577.959,
      "text": "देखेंगे कि कंपनी की जो बोरो इंग्स है वो"
    },
    {
      "subtitle_id": 253,
      "start": 575.519,
      "end": 579.44,
      "text": "बहुत तेजी से बढ़ रही है यह भी अगेन कंपनी"
    },
    {
      "subtitle_id": 254,
      "start": 577.959,
      "end": 581.519,
      "text": "प्रॉफिटेबल नहीं है बोरो इंग्स ली तो"
    },
    {
      "subtitle_id": 255,
      "start": 579.44,
      "end": 583.32,
      "text": "इंटरेस्ट भी आएगा अब इंटरेस्ट पर अगर हम"
    },
    {
      "subtitle_id": 256,
      "start": 581.519,
      "end": 585.56,
      "text": "नजर डालें तो प्रॉफिट एंड लॉस स्टेटमेंट"
    },
    {
      "subtitle_id": 257,
      "start": 583.32,
      "end": 587.16,
      "text": "पर यहां पर आप देख सकते हो कि जो इंटरेस्ट"
    },
    {
      "subtitle_id": 258,
      "start": 585.56,
      "end": 589.8,
      "text": "कंपनी पे कर रही है दैट इज इंक्रीजिंग"
    },
    {
      "subtitle_id": 259,
      "start": 587.16,
      "end": 591.519,
      "text": "वेरी वेरी फास्ट 2 साल पहले 18 करोड़ का"
    },
    {
      "subtitle_id": 260,
      "start": 589.8,
      "end": 593.72,
      "text": "इंटरेस्ट कंपनी को पे करना पड़ रहा था वो"
    },
    {
      "subtitle_id": 261,
      "start": 591.519,
      "end": 595.839,
      "text": "अभी 187 करोड़ पर गया है और कंपनी की"
    },
    {
      "subtitle_id": 262,
      "start": 593.72,
      "end": 597.839,
      "text": "ऑपरेटिंग मार्जिन ही नेगेटिव में है यानी"
    },
    {
      "subtitle_id": 263,
      "start": 595.839,
      "end": 599.92,
      "text": "तो यह जो सारा पैसा है कंपनी को यह फंडिंग"
    },
    {
      "subtitle_id": 264,
      "start": 597.839,
      "end": 601.839,
      "text": "लेके आईपीओ से जो पैसा आ रहा है वहीं से"
    },
    {
      "subtitle_id": 265,
      "start": 599.92,
      "end": 603.8,
      "text": "ये सारी चीजें फुलफिल करनी है कंपनी के"
    },
    {
      "subtitle_id": 266,
      "start": 601.839,
      "end": 605.48,
      "text": "पास ज्यादा टाइम नहीं है अगर इसी तरह की"
    },
    {
      "subtitle_id": 267,
      "start": 603.8,
      "end": 607.68,
      "text": "चीजें होती रहेगी तो आपके लॉसेस अलग से"
    },
    {
      "subtitle_id": 268,
      "start": 605.48,
      "end": 609.959,
      "text": "हैं आपका इंटरेस्ट पेमेंट अलग से है तो"
    },
    {
      "subtitle_id": 269,
      "start": 607.68,
      "end": 611.92,
      "text": "बाजे जैसे सिचुएशन आने में ज्यादा वक्त"
    },
    {
      "subtitle_id": 270,
      "start": 609.959,
      "end": 613.48,
      "text": "नहीं लगेगा तो ओवरऑल अगर हम भाविश अग्रल"
    },
    {
      "subtitle_id": 271,
      "start": 611.92,
      "end": 615.12,
      "text": "की बात करें तो इनके पास दो चीजें है एक"
    },
    {
      "subtitle_id": 272,
      "start": 613.48,
      "end": 617.32,
      "text": "पॉजिटिव है एक नेगेटिव है पॉजिटिव यह है"
    },
    {
      "subtitle_id": 273,
      "start": 615.12,
      "end": 619.079,
      "text": "कि बहुत फास्ट एग्जीक्यूशन करते हैं जब तक"
    },
    {
      "subtitle_id": 274,
      "start": 617.32,
      "end": 621.0,
      "text": "कोई सोच सकता है तब तक इनका एग्जीक्यूशन"
    },
    {
      "subtitle_id": 275,
      "start": 619.079,
      "end": 623.56,
      "text": "हो जाता है दूसरी चीज यह है कि एक चीज पर"
    },
    {
      "subtitle_id": 276,
      "start": 621.0,
      "end": 625.88,
      "text": "फोकस नहीं है तुरंत जंप इन करते रहते हैं"
    },
    {
      "subtitle_id": 277,
      "start": 623.56,
      "end": 627.64,
      "text": "अलग-अलग चीजों में जैसे ई स्कूटर्स की बात"
    },
    {
      "subtitle_id": 278,
      "start": 625.88,
      "end": 629.76,
      "text": "कर रहे थे तो अचानक इन्होंने बीच में"
    },
    {
      "subtitle_id": 279,
      "start": 627.64,
      "end": 632.24,
      "text": "बातें की थी हम इलेक्ट्रिक का कार्स"
    },
    {
      "subtitle_id": 280,
      "start": 629.76,
      "end": 633.88,
      "text": "बनाएंगे इलेक्ट्रिक बाइक्स बनाने की बातें"
    },
    {
      "subtitle_id": 281,
      "start": 632.24,
      "end": 635.72,
      "text": "हो रही है ई सेल की बातें हो रही है जिसके"
    },
    {
      "subtitle_id": 282,
      "start": 633.88,
      "end": 638.04,
      "text": "लिए अगेन अलग से फैक्ट्री लगेगी अलग से"
    },
    {
      "subtitle_id": 283,
      "start": 635.72,
      "end": 640.279,
      "text": "कैपिटल एक्सपेंडिचर लगेगा अगेन पैसा बहुत"
    },
    {
      "subtitle_id": 284,
      "start": 638.04,
      "end": 641.92,
      "text": "लगेगा कहां से रेज करेंगे आई डोंट नो तो"
    },
    {
      "subtitle_id": 285,
      "start": 640.279,
      "end": 644.079,
      "text": "बेटर वे ऑफ डूइंग थिंग्स इज लाइक कि आप जो"
    },
    {
      "subtitle_id": 286,
      "start": 641.92,
      "end": 646.279,
      "text": "भी चीज कर रहे हो उसे अच्छे से प्रॉफिटेबल"
    },
    {
      "subtitle_id": 287,
      "start": 644.079,
      "end": 648.36,
      "text": "बनाओ देन दूसरी चीज में मूव ऑन करो फिर"
    },
    {
      "subtitle_id": 288,
      "start": 646.279,
      "end": 649.959,
      "text": "तीसरी चीज में मूव ऑन करो भाविश अराल ने"
    },
    {
      "subtitle_id": 289,
      "start": 648.36,
      "end": 652.76,
      "text": "जितनी भी चीजें अब तक शुरू की है छह सात"
    },
    {
      "subtitle_id": 290,
      "start": 649.959,
      "end": 654.399,
      "text": "बिजनेसेस है ओ का अपना ऐप है ला फाइंस है"
    },
    {
      "subtitle_id": 291,
      "start": 652.76,
      "end": 656.36,
      "text": "फूड का भी इन्होंने बिजनेस शुरू किया था"
    },
    {
      "subtitle_id": 292,
      "start": 654.399,
      "end": 658.04,
      "text": "फूड पांडा को एक्वायर किया था तो सारी की"
    },
    {
      "subtitle_id": 293,
      "start": 656.36,
      "end": 660.079,
      "text": "सारी चीजें अगर देखे तो सारी की सारी लॉस"
    },
    {
      "subtitle_id": 294,
      "start": 658.04,
      "end": 662.2,
      "text": "में एटलीस्ट इन्वेस्टर और अपने शेयर"
    },
    {
      "subtitle_id": 295,
      "start": 660.079,
      "end": 663.48,
      "text": "होल्डर्स को खुश रखने के लिए कंपनी का यह"
    },
    {
      "subtitle_id": 296,
      "start": 662.2,
      "end": 666.0,
      "text": "फोकस होना चाहिए कि जल्द से जल्द"
    },
    {
      "subtitle_id": 297,
      "start": 663.48,
      "end": 667.68,
      "text": "प्रॉफिटेबल कैसे बने और उसके बाद फिर ऑन द"
    },
    {
      "subtitle_id": 298,
      "start": 666.0,
      "end": 669.04,
      "text": "टॉप ऑफ दैट हम कैसे एक्सपें करें तो"
    },
    {
      "subtitle_id": 299,
      "start": 667.68,
      "end": 671.72,
      "text": "वीडियो का तात्पर्य यही था कि सावधानी"
    },
    {
      "subtitle_id": 300,
      "start": 669.04,
      "end": 671.72,
      "text": "बरते"
    },
    {
      "subtitle_id": 301,
      "start": 674.8,
      "end": 682.519,
      "text": "paytm-in अप टू यू बट अल्टीमेटली बिजनेस"
    },
    {
      "subtitle_id": 302,
      "start": 679.32,
      "end": 685.0,
      "text": "का एक ही रूल है एक ही प्रिंसिपल है वो यह"
    },
    {
      "subtitle_id": 303,
      "start": 682.519,
      "end": 687.16,
      "text": "है प्रॉफिटेबिलिटी जितना प्रॉफिट बढ़ेगा"
    },
    {
      "subtitle_id": 304,
      "start": 685.0,
      "end": 689.839,
      "text": "कंपनी का वैल्युएशन उसके अनुसार ही बढ़ेगा"
    },
    {
      "subtitle_id": 305,
      "start": 687.16,
      "end": 691.72,
      "text": "प्रॉफिट नहीं बढ़ेगा तो नो मैटर ट कितना"
    },
    {
      "subtitle_id": 306,
      "start": 689.839,
      "end": 693.24,
      "text": "मार्केटिंग करें कितना पीर करें कंपनी की"
    },
    {
      "subtitle_id": 307,
      "start": 691.72,
      "end": 696.279,
      "text": "शेयर प्राइस ज्यादा देर तक सस्टेन नहीं कर"
    },
    {
      "subtitle_id": 308,
      "start": 693.24,
      "end": 696.279,
      "text": "पाएगी उस प्राइस पर"
    },
    {
      "subtitle_id": 309,
      "start": 712.76,
      "end": 717.36,
      "text": "paytm.in है बिल्कुल जरूर ट्राई कीजिए"
    },
    {
      "subtitle_id": 310,
      "start": 715.56,
      "end": 718.92,
      "text": "आपको जरूर पसंद आएगा इतना मैं गारंटी के"
    },
    {
      "subtitle_id": 311,
      "start": 717.36,
      "end": 720.44,
      "text": "साथ कह सकता हूं और ये फाइव डे रिफंड"
    },
    {
      "subtitle_id": 312,
      "start": 718.92,
      "end": 722.36,
      "text": "पॉलिसी हम तभी उतने कॉन्फिडेंस से दे पा"
    },
    {
      "subtitle_id": 313,
      "start": 720.44,
      "end": 724.32,
      "text": "रहे हैं क्योंकि हमें कॉन्फिडेंस है कि इस"
    },
    {
      "subtitle_id": 314,
      "start": 722.36,
      "end": 726.079,
      "text": "कोर्स में बहुत ज्यादा दम है और वो देखने"
    },
    {
      "subtitle_id": 315,
      "start": 724.32,
      "end": 727.68,
      "text": "के बाद आपको भी पता चल जाएगा मिलते हैं"
    },
    {
      "subtitle_id": 316,
      "start": 726.079,
      "end": 729.6,
      "text": "अगले वीडियो में थैंक यू सो मच फॉर वाचिंग"
    },
    {
      "subtitle_id": 317,
      "start": 727.68,
      "end": 731.399,
      "text": "दिस वीडियो अपने बाकी यंग दोस्तों के साथ"
    },
    {
      "subtitle_id": 318,
      "start": 729.6,
      "end": 733.199,
      "text": "भी शेयर करें जो जनरली स्टार्टअप्स कंपनीज"
    },
    {
      "subtitle_id": 319,
      "start": 731.399,
      "end": 735.72,
      "text": "में इन्वेस्ट करते हैं ताकि उन्हें भी ये"
    },
    {
      "subtitle_id": 320,
      "start": 733.199,
      "end": 738.88,
      "text": "सारी डिटेल्स फाइनेंशियल्स लॉजिस और"
    },
    {
      "subtitle_id": 321,
      "start": 735.72,
      "end": 738.88,
      "text": "नंबर्स पता चले"
    }
