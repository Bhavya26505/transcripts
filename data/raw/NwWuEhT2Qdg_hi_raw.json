  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.919,
      "end": 5.759,
      "text": "बार एक नेगेटिव खबर निकल कर आई है जहां पर"
    },
    {
      "subtitle_id": 2,
      "start": 3.36,
      "end": 8.599,
      "text": "इंसें बैंक के डेरिवेटिव पोर्टफोलियो में"
    },
    {
      "subtitle_id": 3,
      "start": 5.759,
      "end": 11.28,
      "text": "गड़बड़ी मिली है इस बैंक के शेयर में 27"
    },
    {
      "subtitle_id": 4,
      "start": 8.599,
      "end": 13.96,
      "text": "पर की गिरावट आई है जो कि अब तक की सबसे"
    },
    {
      "subtitle_id": 5,
      "start": 11.28,
      "end": 15.839,
      "text": "बड़ी इंट्राडे गिरावट है आज सिर्फ और"
    },
    {
      "subtitle_id": 6,
      "start": 13.96,
      "end": 18.119,
      "text": "सिर्फ इंडसन बैंक का शेयर ही फोकस में है"
    },
    {
      "subtitle_id": 7,
      "start": 15.839,
      "end": 20.56,
      "text": "बैंक में आज 26 पर की भारी गिरावट है और"
    },
    {
      "subtitle_id": 8,
      "start": 18.119,
      "end": 23.32,
      "text": "बना है एक्सीडेंट ऑफ द डे आज चलते हैं इस"
    },
    {
      "subtitle_id": 9,
      "start": 20.56,
      "end": 26.16,
      "text": "पूरी खबर को समझने के"
    },
    {
      "subtitle_id": 10,
      "start": 23.32,
      "end": 29.039,
      "text": "लिए सोचिए अगर आपका बैंक बैलेंस बिना कोई"
    },
    {
      "subtitle_id": 11,
      "start": 26.16,
      "end": 31.679,
      "text": "खर्चा कि 25 पर से कम हो जाए तो आपको कैसा"
    },
    {
      "subtitle_id": 12,
      "start": 29.039,
      "end": 33.879,
      "text": "लगेगा बुरा लगेगा राइट बैंक के मैनेजमेंट"
    },
    {
      "subtitle_id": 13,
      "start": 31.679,
      "end": 35.719,
      "text": "पर ऐसा ही भरोसा करके लाखों शेयर होल्डर्स"
    },
    {
      "subtitle_id": 14,
      "start": 33.879,
      "end": 38.6,
      "text": "ने अपना पैसा इंडसन बैंक में इन्वेस्ट"
    },
    {
      "subtitle_id": 15,
      "start": 35.719,
      "end": 41.52,
      "text": "किया हुआ क्या एक ही दिन में शेयर प्राइस"
    },
    {
      "subtitle_id": 16,
      "start": 38.6,
      "end": 44.2,
      "text": "27 पर से डाउन चली गई पिछले दो से तीन"
    },
    {
      "subtitle_id": 17,
      "start": 41.52,
      "end": 47.48,
      "text": "दिनों में इंडसन बैंक करीब 35 पर गिर चुका"
    },
    {
      "subtitle_id": 18,
      "start": 44.2,
      "end": 49.719,
      "text": "है और बैंक की जो वैल्यू है वो 20000"
    },
    {
      "subtitle_id": 19,
      "start": 47.48,
      "end": 51.64,
      "text": "करोड़ से कम हो चुकी है और इस्ट बैंक की"
    },
    {
      "subtitle_id": 20,
      "start": 49.719,
      "end": 54.239,
      "text": "जो करंट मार्केट कैप है वो पहुंच गई है"
    },
    {
      "subtitle_id": 21,
      "start": 51.64,
      "end": 55.96,
      "text": "51000 करोड़ पर जो कि क्लोज टू s बैंक की"
    },
    {
      "subtitle_id": 22,
      "start": 54.239,
      "end": 57.96,
      "text": "मार्केट वैल्यू के बराबर है तो आप समझ"
    },
    {
      "subtitle_id": 23,
      "start": 55.96,
      "end": 60.519,
      "text": "सकते हो कि इंसें बैंक की हालत फिलहाल"
    },
    {
      "subtitle_id": 24,
      "start": 57.96,
      "end": 62.92,
      "text": "कैसी है इनफैक्ट अगर शेयर प्राइस में 1015"
    },
    {
      "subtitle_id": 25,
      "start": 60.519,
      "end": 65.08,
      "text": "पर की और गिरावट आती है तो इंसें बैंक का"
    },
    {
      "subtitle_id": 26,
      "start": 62.92,
      "end": 67.04,
      "text": "मार्केट कैप कुछ स्मॉल फाइनेंस बैंक्स"
    },
    {
      "subtitle_id": 27,
      "start": 65.08,
      "end": 68.6,
      "text": "जैसे कि एओ स्मॉल फाइनेंस बैंक के मार्केट"
    },
    {
      "subtitle_id": 28,
      "start": 67.04,
      "end": 70.68,
      "text": "कैप के करीब हो जाएगा व्हिच वुड बी"
    },
    {
      "subtitle_id": 29,
      "start": 68.6,
      "end": 73.96,
      "text": "एक्चुअली वेरी वेरी शॉकिंग क्योंकि ये कोई"
    },
    {
      "subtitle_id": 30,
      "start": 70.68,
      "end": 76.84,
      "text": "आम बैंक नहीं है ये इंडिया की पांचवी सबसे"
    },
    {
      "subtitle_id": 31,
      "start": 73.96,
      "end": 78.92,
      "text": "बड़ी प्राइवेट सेक्टर बैंक है अब सवाल ये"
    },
    {
      "subtitle_id": 32,
      "start": 76.84,
      "end": 81.119,
      "text": "आता है कि 20000 करोड़ की वैल्यू एक ही"
    },
    {
      "subtitle_id": 33,
      "start": 78.92,
      "end": 83.36,
      "text": "दिन में गायब होना कोई आम बात नहीं है ये"
    },
    {
      "subtitle_id": 34,
      "start": 81.119,
      "end": 86.28,
      "text": "बहुत ही एक्सेप्शनल केस है इतनी बड़ी बैंक"
    },
    {
      "subtitle_id": 35,
      "start": 83.36,
      "end": 89.28,
      "text": "के लिए अब ये हुआ कैसे मामला क्या है तो"
    },
    {
      "subtitle_id": 36,
      "start": 86.28,
      "end": 89.28,
      "text": "मामला बड़ा अजीब और"
    },
    {
      "subtitle_id": 37,
      "start": 90.079,
      "end": 93.28,
      "text": "हम आपको समझाएंगे और साथ ही मैं एंड में"
    },
    {
      "subtitle_id": 38,
      "start": 91.72,
      "end": 95.96,
      "text": "यह भी बताऊंगा कि जो रिटेल इन्वेस्टर्स या"
    },
    {
      "subtitle_id": 39,
      "start": 93.28,
      "end": 97.6,
      "text": "आम इन्वेस्टर्स वो इन चीजों को कैसे अवॉइड"
    },
    {
      "subtitle_id": 40,
      "start": 95.96,
      "end": 100.04,
      "text": "कर सकते हैं तो चलिए बिना किसी देरी के"
    },
    {
      "subtitle_id": 41,
      "start": 97.6,
      "end": 101.6,
      "text": "शुरू करते हैं नमस्कार मैं प्रसाद आपका आज"
    },
    {
      "subtitle_id": 42,
      "start": 100.04,
      "end": 103.72,
      "text": "के इस वीडियो में स्वागत करता हूं आज के"
    },
    {
      "subtitle_id": 43,
      "start": 101.6,
      "end": 105.68,
      "text": "इस वीडियो के प्रायोजक है जेब्रा लन जिनके"
    },
    {
      "subtitle_id": 44,
      "start": 103.72,
      "end": 107.719,
      "text": "बारे में हम वीडियो में आगे बात करेंगे तो"
    },
    {
      "subtitle_id": 45,
      "start": 105.68,
      "end": 109.719,
      "text": "सबसे पहले जानते हैं कि ऐसा क्या हुआ कि"
    },
    {
      "subtitle_id": 46,
      "start": 107.719,
      "end": 112.799,
      "text": "11th मार्च को एक ही दिन में शेयर प्राइस"
    },
    {
      "subtitle_id": 47,
      "start": 109.719,
      "end": 114.719,
      "text": "27 पर से गिर गए तो 10th मार्च को बैंक एक"
    },
    {
      "subtitle_id": 48,
      "start": 112.799,
      "end": 117.2,
      "text": "नोटिस इशू करती है जिसे आप स्क्रीन पर देख"
    },
    {
      "subtitle_id": 49,
      "start": 114.719,
      "end": 118.84,
      "text": "रहे हो जिसमें यह लिखा हुआ होता है कि"
    },
    {
      "subtitle_id": 50,
      "start": 117.2,
      "end": 121.479,
      "text": "आरबीआई मास्टर डायरेक्शन के हिसाब से"
    },
    {
      "subtitle_id": 51,
      "start": 118.84,
      "end": 124.119,
      "text": "इंस्टन बैंक ने इंटरनल ऑडिट की तब उन्हें"
    },
    {
      "subtitle_id": 52,
      "start": 121.479,
      "end": 127.319,
      "text": "पता चला कि देयर वेर सम अकाउंटिंग एरर अब"
    },
    {
      "subtitle_id": 53,
      "start": 124.119,
      "end": 129.64,
      "text": "देखिए इस नोटिस में बहुत सारी"
    },
    {
      "subtitle_id": 54,
      "start": 127.319,
      "end": 131.28,
      "text": "कॉम्प्लेक्टेड कायरे क्टल तो आपको काफी टफ"
    },
    {
      "subtitle_id": 55,
      "start": 129.64,
      "end": 133.239,
      "text": "जाएगा इसको मैं आपको एकदम आसान भाषा में"
    },
    {
      "subtitle_id": 56,
      "start": 131.28,
      "end": 136.08,
      "text": "सिंपलीफाई करके बताता हूं तो इसका एक ही"
    },
    {
      "subtitle_id": 57,
      "start": 133.239,
      "end": 139.72,
      "text": "मतलब था कि इन अकाउंटिंग एरर्स की वजह से"
    },
    {
      "subtitle_id": 58,
      "start": 136.08,
      "end": 142.04,
      "text": "इंसेंट बैंक को 2100 करोड़ का लॉस होने"
    },
    {
      "subtitle_id": 59,
      "start": 139.72,
      "end": 144.2,
      "text": "वाला है और बात यहीं पर नहीं खत्म होती है"
    },
    {
      "subtitle_id": 60,
      "start": 142.04,
      "end": 146.68,
      "text": "अब एक एक्सटर्नल ऑडिट होगा जिसके बाद रियल"
    },
    {
      "subtitle_id": 61,
      "start": 144.2,
      "end": 148.84,
      "text": "फिगर मे बी इससे भी ज्यादा हो सकती है तो"
    },
    {
      "subtitle_id": 62,
      "start": 146.68,
      "end": 151.319,
      "text": "मामला कोई छोटा-मोटा नहीं है शेयर प्राइस"
    },
    {
      "subtitle_id": 63,
      "start": 148.84,
      "end": 153.04,
      "text": "कोई यूं ही नहीं गिरी है और ये जो 2100"
    },
    {
      "subtitle_id": 64,
      "start": 151.319,
      "end": 156.08,
      "text": "करोड़ का लॉस है ये बैंक के नेटवर्थ का"
    },
    {
      "subtitle_id": 65,
      "start": 153.04,
      "end": 158.319,
      "text": "2.35 है और यह जो एरर है वो हेजिंग कॉस्ट"
    },
    {
      "subtitle_id": 66,
      "start": 156.08,
      "end": 160.56,
      "text": "से रिलेटेड है अब देखिए हर एक बैंक के पास"
    },
    {
      "subtitle_id": 67,
      "start": 158.319,
      "end": 162.159,
      "text": "अब ये देखिए हेजिंग वेजिंग ये सुनेंगे तो"
    },
    {
      "subtitle_id": 68,
      "start": 160.56,
      "end": 164.599,
      "text": "आपको थोड़ा और टफ हो जाएगा इसको थोड़ा"
    },
    {
      "subtitle_id": 69,
      "start": 162.159,
      "end": 166.48,
      "text": "सिंपलीफाई करता हूं तो हर एक बैंक फॉरेन"
    },
    {
      "subtitle_id": 70,
      "start": 164.599,
      "end": 168.879,
      "text": "एक्सचेंज जो होते हैं फॉरेन करेंसी उसमें"
    },
    {
      "subtitle_id": 71,
      "start": 166.48,
      "end": 170.44,
      "text": "डील करती है और फॉरेन करेंसी आपको पता ही"
    },
    {
      "subtitle_id": 72,
      "start": 168.879,
      "end": 172.48,
      "text": "है इंडिया की करेंसी बहुत तेजी से गिर रही"
    },
    {
      "subtitle_id": 73,
      "start": 170.44,
      "end": 174.68,
      "text": "है तो कोई करेंसी बढ़ रही है तो इंटरनेशनल"
    },
    {
      "subtitle_id": 74,
      "start": 172.48,
      "end": 176.72,
      "text": "करेंसीज में ये चलता रहता है तो इन रिस्क"
    },
    {
      "subtitle_id": 75,
      "start": 174.68,
      "end": 179.08,
      "text": "को मिटिगेट करने के लिए इन रिस्क को मैनेज"
    },
    {
      "subtitle_id": 76,
      "start": 176.72,
      "end": 181.84,
      "text": "करने के लिए ये डेरिवेटिव्स में जाकर"
    },
    {
      "subtitle_id": 77,
      "start": 179.08,
      "end": 183.84,
      "text": "फ्यूचर्स ऑप्शन की मदद से इस रिस्क को कम"
    },
    {
      "subtitle_id": 78,
      "start": 181.84,
      "end": 185.879,
      "text": "करने की म कोशिश करते हैं जिसे हम जनरली"
    },
    {
      "subtitle_id": 79,
      "start": 183.84,
      "end": 187.84,
      "text": "हेजिंग कहते हैं अब देखिए जब भी आप हेजिंग"
    },
    {
      "subtitle_id": 80,
      "start": 185.879,
      "end": 189.72,
      "text": "करते हो तो अलग-अलग चार्जेस आपको लगते हैं"
    },
    {
      "subtitle_id": 81,
      "start": 187.84,
      "end": 191.48,
      "text": "बाकी और चीजें भी है तो यहां पर इंडसन"
    },
    {
      "subtitle_id": 82,
      "start": 189.72,
      "end": 193.72,
      "text": "बैंक का जो ट्रेजरी डिपार्टमेंट है जोय"
    },
    {
      "subtitle_id": 83,
      "start": 191.48,
      "end": 196.56,
      "text": "सारी चीजें मैनेज करता है वो दो टीम्स में"
    },
    {
      "subtitle_id": 84,
      "start": 193.72,
      "end": 198.84,
      "text": "डिवाइडेड है एक है इंटरनल और दूसरा है"
    },
    {
      "subtitle_id": 85,
      "start": 196.56,
      "end": 201.76,
      "text": "एक्सटर्नल अब इनका जो इंटरनल ट्रेडिंग"
    },
    {
      "subtitle_id": 86,
      "start": 198.84,
      "end": 204.12,
      "text": "डेस्क है यह अलग मेथड जीी यूज करता था और"
    },
    {
      "subtitle_id": 87,
      "start": 201.76,
      "end": 206.599,
      "text": "एक्सटर्नल जो डेस्क है वो अलग मेथोड यूज"
    },
    {
      "subtitle_id": 88,
      "start": 204.12,
      "end": 208.519,
      "text": "करता था अब जो एक्सटर्नल ट्रेडिंग डेस्क"
    },
    {
      "subtitle_id": 89,
      "start": 206.599,
      "end": 210.84,
      "text": "है वो मार्क टू मार्केट अकाउंटिंग मेथड"
    },
    {
      "subtitle_id": 90,
      "start": 208.519,
      "end": 213.72,
      "text": "यूज करता था और जो इंटरनल डेस्क यूज करता"
    },
    {
      "subtitle_id": 91,
      "start": 210.84,
      "end": 216.239,
      "text": "था हिज अकाउंटिंग मेथड अब जो सारी"
    },
    {
      "subtitle_id": 92,
      "start": 213.72,
      "end": 218.28,
      "text": "प्रॉब्लम्स हुई है यह दोनों मेथोड अलग-अलग"
    },
    {
      "subtitle_id": 93,
      "start": 216.239,
      "end": 220.319,
      "text": "होने की वजह से हुई है दोनों अगर मार्क टू"
    },
    {
      "subtitle_id": 94,
