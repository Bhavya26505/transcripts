      "text": "कोई इन्वेस्टर किसी कंपनी में बैंक में"
    },
    {
      "subtitle_id": 190,
      "start": 431.44,
      "end": 436.24,
      "text": "इन्वेस्ट करता है तो ट्रस्ट एक सबसे बड़ा"
    },
    {
      "subtitle_id": 191,
      "start": 433.479,
      "end": 438.479,
      "text": "सिंबल होता है अगर वो टूट जाए तो सबके लिए"
    },
    {
      "subtitle_id": 192,
      "start": 436.24,
      "end": 439.96,
      "text": "मुसीबत ही मुसीबत है राइट नाउ ज्यादातर जो"
    },
    {
      "subtitle_id": 193,
      "start": 438.479,
      "end": 442.12,
      "text": "शेयर होल्डर्स हैं उनका मैनेजमेंट से जो"
    },
    {
      "subtitle_id": 194,
      "start": 439.96,
      "end": 444.16,
      "text": "ट्रस्ट है वो उड़ चुका है और इसका सबसे"
    },
    {
      "subtitle_id": 195,
      "start": 442.12,
      "end": 445.919,
      "text": "बड़ा कारण यह भी है कि यह जो इशू हुआ है"
    },
    {
      "subtitle_id": 196,
      "start": 444.16,
      "end": 447.84,
      "text": "ये बैंक को कब पता चला ये भी इंपॉर्टेंट"
    },
    {
      "subtitle_id": 197,
      "start": 445.919,
      "end": 449.56,
      "text": "है ये इनको 11 मार्च को या 10 मार्च को"
    },
    {
      "subtitle_id": 198,
      "start": 447.84,
      "end": 453.919,
      "text": "पता नहीं चला है ये उन्हें पता चला है"
    },
    {
      "subtitle_id": 199,
      "start": 449.56,
      "end": 455.599,
      "text": "अक्टूबर 2024 को तब से लेके ये कुछ ना कुछ"
    },
    {
      "subtitle_id": 200,
      "start": 453.919,
      "end": 458.319,
      "text": "कर रहे हैं इंटरनल ऑडिट्स उन्होंने किए"
    },
    {
      "subtitle_id": 201,
      "start": 455.599,
      "end": 460.599,
      "text": "बाद में और बाकी काफी सारी चीजें की और अब"
    },
    {
      "subtitle_id": 202,
      "start": 458.319,
      "end": 462.52,
      "text": "जाकर यानी टोटल 5 महीने बाद उन्हें इशू"
    },
    {
      "subtitle_id": 203,
      "start": 460.599,
      "end": 464.56,
      "text": "पता होने के 5 महीने बाद इन्होंने ये चीज"
    },
    {
      "subtitle_id": 204,
      "start": 462.52,
      "end": 465.96,
      "text": "पब्लिक की जिसके चलते शेयर होल्डर्स को"
    },
    {
      "subtitle_id": 205,
      "start": 464.56,
      "end": 467.96,
      "text": "काफी सारे डाउट आने लगे कंपनी के"
    },
    {
      "subtitle_id": 206,
      "start": 465.96,
      "end": 470.0,
      "text": "मैनेजमेंट पर और भी डाउट्स है जिनके बारे"
    },
    {
      "subtitle_id": 207,
      "start": 467.96,
      "end": 472.759,
      "text": "में मैं आगे बात करूंगा और इसी के चलते"
    },
    {
      "subtitle_id": 208,
      "start": 470.0,
      "end": 475.199,
      "text": "कंपनी के जो सीईओ है सुमंत कत पालिया"
    },
    {
      "subtitle_id": 209,
      "start": 472.759,
      "end": 477.0,
      "text": "उन्होंने आरबीआई के पास अपने सीईओ पद के"
    },
    {
      "subtitle_id": 210,
      "start": 475.199,
      "end": 479.599,
      "text": "लिए 3 ईयर का एक्सटेंशन मांगा लेकिन"
    },
    {
      "subtitle_id": 211,
      "start": 477.0,
      "end": 481.599,
      "text": "उन्हें मिला सिर्फ एक ईयर का एक्सटेंशन"
    },
    {
      "subtitle_id": 212,
      "start": 479.599,
      "end": 484.12,
      "text": "बात यहीं पर नहीं रुकी कंपनी के जो सीएफओ"
    },
    {
      "subtitle_id": 213,
      "start": 481.599,
      "end": 486.599,
      "text": "है गोविंद जैन उन्होंने क्वार्टर थ्री के"
    },
    {
      "subtitle_id": 214,
      "start": 484.12,
      "end": 488.159,
      "text": "रिजल्ट से पहले ही अपना रिजाइन डाल दिया"
    },
    {
      "subtitle_id": 215,
      "start": 486.599,
      "end": 490.0,
      "text": "यानी कि जैसे ही अक्टूबर में उन्हें ये"
    },
    {
      "subtitle_id": 216,
      "start": 488.159,
      "end": 492.72,
      "text": "इशू पता चला कुछ ही टाइम बाद उन्होंने भी"
    },
    {
      "subtitle_id": 217,
      "start": 490.0,
      "end": 494.84,
      "text": "रिजाइन अपना डाल दिया यानी बैकग्राउंड में"
    },
    {
      "subtitle_id": 218,
      "start": 492.72,
      "end": 496.639,
      "text": "क्लियर ऐसी कई सारी चीजें चल रही थी जिनके"
    },
    {
      "subtitle_id": 219,
      "start": 494.84,
      "end": 498.919,
      "text": "बारे में शेयर होल्डर्स को अंदाजा भी नहीं"
    },
    {
      "subtitle_id": 220,
      "start": 496.639,
      "end": 500.84,
      "text": "था बैंकिंग एक ट्रस्ट बिजनेस है अगर आपकी"
    },
    {
      "subtitle_id": 221,
      "start": 498.919,
      "end": 502.479,
      "text": "एक प्रोसेस सही नहीं चल रही है तो डाउट यह"
    },
    {
      "subtitle_id": 222,
      "start": 500.84,
      "end": 504.639,
      "text": "भी आता है कि क्या बाकी प्रोसेसेस जो आप"
    },
    {
      "subtitle_id": 223,
      "start": 502.479,
      "end": 506.759,
      "text": "कह रहे हो सही चल रही है सही में सही चल"
    },
    {
      "subtitle_id": 224,
      "start": 504.639,
      "end": 508.72,
      "text": "रही है और यह कोई पहली बार नहीं है जब"
    },
    {
      "subtitle_id": 225,
      "start": 506.759,
      "end": 510.759,
      "text": "इस्ट इन बैंक इस तरह की प्रॉब्लम में आई"
    },
    {
      "subtitle_id": 226,
      "start": 508.72,
      "end": 513.0,
      "text": "हो आपको थोड़ा कंपनी के लास्ट क्वार्टर के"
    },
    {
      "subtitle_id": 227,
      "start": 510.759,
      "end": 515.64,
      "text": "रिजल्ट्स पर लेकर चलता हूं जो 39 पर से"
    },
    {
      "subtitle_id": 228,
      "start": 513.0,
      "end": 517.56,
      "text": "गिर चुका है और 1402 करोड़ पर आ चुका है"
    },
    {
      "subtitle_id": 229,
      "start": 515.64,
      "end": 520.32,
      "text": "अब ऐसा क्यों हुआ क्योंकि माइक्रो फाइनेंस"
    },
    {
      "subtitle_id": 230,
      "start": 517.56,
      "end": 522.36,
      "text": "लोंस की वजह से कंपनी के सीईओ सुमन कटपाली"
    },
    {
      "subtitle_id": 231,
      "start": 520.32,
      "end": 524.039,
      "text": "का कहना है कि बिहार झारखंड और महाराष्ट्र"
    },
    {
      "subtitle_id": 232,
      "start": 522.36,
      "end": 525.959,
      "text": "के कुछ डिस्ट्रिक्ट्स में कंपनी को काफी"
    },
    {
      "subtitle_id": 233,
      "start": 524.039,
      "end": 527.72,
      "text": "ज्यादा स्ट्रेस देखने मिल रहा है बहुत"
    },
    {
      "subtitle_id": 234,
      "start": 525.959,
      "end": 529.839,
      "text": "सारे लोन उनके वहां पर डिफॉल्ट्स हो रहे"
    },
    {
      "subtitle_id": 235,
      "start": 527.72,
      "end": 532.959,
      "text": "हैं कंपनी का जो माइक्रो फाइनेंस लोन बुक"
    },
    {
      "subtitle_id": 236,
      "start": 529.839,
      "end": 534.68,
      "text": "है वह 39000 करोड़ का है बहुत बड़ा है अब"
    },
    {
      "subtitle_id": 237,
      "start": 532.959,
      "end": 535.959,
      "text": "आप कहेंगे प्रसाद माइक्रो फाइनेंस में तो"
    },
    {
      "subtitle_id": 238,
      "start": 534.68,
      "end": 537.72,
      "text": "कौन नहीं स्ट्रगल कर रहा है माइक्रो"
    },
    {
      "subtitle_id": 239,
      "start": 535.959,
      "end": 540.8,
      "text": "फाइनेंस में तो सभी के सभी लोग स्ट्रगल कर"
    },
    {
      "subtitle_id": 240,
      "start": 537.72,
      "end": 543.399,
      "text": "रहे हैं लेकिन आप एक चीज सुनिए जिसके बाद"
    },
    {
      "subtitle_id": 241,
      "start": 540.8,
      "end": 546.24,
      "text": "शायद आपको और क्लेरिटी आ जाएगी कुछ ही साल"
    },
    {
      "subtitle_id": 242,
      "start": 543.399,
      "end": 549.2,
      "text": "पहले एक विसल ब्लोअर ने इंसें बैंक के"
    },
    {
      "subtitle_id": 243,
      "start": 546.24,
      "end": 551.079,
      "text": "बारे में कुछ ऐसा बताया जिससे अगेन उस"
    },
    {
      "subtitle_id": 244,
      "start": 549.2,
      "end": 553.279,
      "text": "टाइम भी इंस बैंक की शेयर प्राइस बहुत"
    },
    {
      "subtitle_id": 245,
      "start": 551.079,
      "end": 556.16,
      "text": "तेजी से गिर गई थी इस पूरे केस का नाम था"
    },
    {
      "subtitle_id": 246,
      "start": 553.279,
      "end": 558.24,
      "text": "एवरग्रीनिंग ऑफ लोंस इसका मतलब क्या होता"
    },
    {
      "subtitle_id": 247,
      "start": 556.16,
      "end": 560.36,
      "text": "है तो इस विसल ब्लोर ने ये बताया कि"
    },
    {
      "subtitle_id": 248,
      "start": 558.24,
      "end": 563.16,
      "text": "इंसेंट बैंक की एक सब्सिडियरी है जिसका"
    },
    {
      "subtitle_id": 249,
      "start": 560.36,
      "end": 565.2,
      "text": "नाम है भारत फाइनेंशियल इंक्लूजन और यह"
    },
    {
      "subtitle_id": 250,
      "start": 563.16,
      "end": 567.48,
      "text": "कंपनी कई सारे कस्टमर्स को लोन दे रही है"
    },
    {
      "subtitle_id": 251,
      "start": 565.2,
      "end": 569.24,
      "text": "जो ऑलरेडी पहले लोन डिफॉल्ट कर चुके हैं"
    },
    {
      "subtitle_id": 252,
      "start": 567.48,
      "end": 571.04,
      "text": "तो आप पूछेंगे फिर बैंक लोन क्यों दे रही"
    },
    {
      "subtitle_id": 253,
      "start": 569.24,
      "end": 573.0,
      "text": "है इतना रिस्क क्यों ले रही है तो विसल"
    },
    {
      "subtitle_id": 254,
      "start": 571.04,
      "end": 575.2,
      "text": "ब्लोर का कहना था कि कंपनी अपनी लोन बुक"
    },
    {
      "subtitle_id": 255,
      "start": 573.0,
      "end": 577.079,
      "text": "बढ़ाना चाहती है अपनी ग्रोथ ज्यादा दिखाना"
    },
    {
      "subtitle_id": 256,
      "start": 575.2,
      "end": 579.64,
      "text": "चाहती है इसलिए बिना कोई डॉक्यूमेंट चेक"
    },
    {
      "subtitle_id": 257,
      "start": 577.079,
      "end": 581.72,
      "text": "किए बिना कोई चीजें किए बस ये लोन बांटते"
    },
    {
      "subtitle_id": 258,
      "start": 579.64,
      "end": 584.12,
      "text": "जा रहे हैं जिसका इंपैक्ट आपको बाद में"
    },
    {
      "subtitle_id": 259,
      "start": 581.72,
      "end": 586.519,
      "text": "पता चलेगा और कुछ टाइम बाद तो लोग यह भूल"
    },
    {
      "subtitle_id": 260,
      "start": 584.12,
      "end": 588.8,
      "text": "गए लेकिन विसल ब्लोर की वो जो चीजें हैं"
    },
    {
      "subtitle_id": 261,
      "start": 586.519,
      "end": 590.959,
      "text": "वो आज भी मुझे याद आती है क्योंकि आज"
    },
    {
      "subtitle_id": 262,
      "start": 588.8,
      "end": 592.399,
      "text": "एगजैक्टली वैसा ही चल रहा है अब कंपनी ने"
    },
    {
      "subtitle_id": 263,
      "start": 590.959,
      "end": 593.92,
      "text": "तो उस टाइम एक क्लेरिफिकेशन दे दिया"
    },
    {
      "subtitle_id": 264,
      "start": 592.399,
      "end": 596.24,
      "text": "क्लेरिफिकेशन भी बड़ा इंटरेस्टिंग था कि"
    },
    {
      "subtitle_id": 265,
      "start": 593.92,
      "end": 597.8,
      "text": "ये टेक्निकल ग्लिच था अब इंसें बैंक के"
    },
    {
      "subtitle_id": 266,
      "start": 596.24,
      "end": 599.68,
      "text": "कॉन्फ्रेंस कॉल को सुना जाए पिछले कुछ"
    },
    {
      "subtitle_id": 267,
      "start": 597.8,
      "end": 601.399,
      "text": "टाइम में तो मैनेजमेंट को भी लगता है कि"
    },
    {
      "subtitle_id": 268,
      "start": 599.68,
      "end": 603.0,
      "text": "यहां पर आने वाले क्वार्टर में भी यानी"
    },
    {
      "subtitle_id": 269,
      "start": 601.399,
      "end": 605.079,
      "text": "लास्ट क्वार्टर में भी प्रॉब्लम तो रहेगा"
    },
    {
      "subtitle_id": 270,
      "start": 603.0,
      "end": 606.92,
      "text": "ही रहेगा लेकिन नेक्स्ट फाइनेंशियल ईयर जो"
    },
    {
      "subtitle_id": 271,
      "start": 605.079,
      "end": 608.76,
      "text": "अगले महीने से शुरू होगा उसके फर्स्ट"
    },
    {
      "subtitle_id": 272,
      "start": 606.92,
      "end": 610.92,
      "text": "क्वार्टर से धीरे-धीरे चीजें इंप्रूव हो"
    },
    {
      "subtitle_id": 273,
      "start": 608.76,
      "end": 613.079,
      "text": "गई ऐसा कंपनी का मानना है तो फिलहाल बैंक"
    },
    {
      "subtitle_id": 274,
      "start": 610.92,
      "end": 615.72,
      "text": "के मैनेजमेंट के सामने बहुत सारे सवाल हैं"
    },
    {
      "subtitle_id": 275,
      "start": 613.079,
      "end": 618.0,
      "text": "एक तो माइक्रो फाइनेंस का प्रेशर सेकंड"
    },
    {
      "subtitle_id": 276,
      "start": 615.72,
      "end": 620.16,
      "text": "चीज ये जो पूरा मामला हुआ है वो और"
    },
    {
      "subtitle_id": 277,
      "start": 618.0,
      "end": 622.0,
      "text": "एक्सटर्नल ऑडिटर अब क्या बात करते हैं"
    },
    {
      "subtitle_id": 278,
      "start": 620.16,
      "end": 623.76,
      "text": "क्या और चीजें सामने आएगी वो और एक शॉकिंग"
    },
    {
      "subtitle_id": 279,
      "start": 622.0,
      "end": 625.68,
      "text": "फैक्टर्स रहेंगे जो तो अभी पिक्चर में आना"
    },
    {
      "subtitle_id": 280,
      "start": 623.76,
      "end": 627.519,
      "text": "बाकी ही है तो उन पर भी आपको एक ध्यान"
    },
    {
      "subtitle_id": 281,
      "start": 625.68,
      "end": 629.88,
      "text": "रखना पड़ेगा साथ में सीओ का सिर्फ एक साल"
    },
    {
      "subtitle_id": 282,
      "start": 627.519,
      "end": 631.56,
      "text": "का एक्सटेंशन सीएफओ ने किया हुआ रिजाइन तो"
    },
    {
      "subtitle_id": 283,
      "start": 629.88,
      "end": 633.519,
      "text": "सवाल बहुत सारे हैं तो मुझे लगता है कि"
    },
    {
      "subtitle_id": 284,
      "start": 631.56,
      "end": 636.56,
      "text": "बैंक को अगर इससे जल्द से जल्द उभरना है"
    },
    {
      "subtitle_id": 285,
      "start": 633.519,
      "end": 639.36,
      "text": "तो जल्द से जल्द नए सीईओ को अपॉइंट्स"
    },
    {
      "subtitle_id": 286,
      "start": 636.56,
      "end": 641.639,
      "text": "प्रोसेस स्टार्ट करनी पड़ेगी और जो भी ये"
    },
    {
      "subtitle_id": 287,
      "start": 639.36,
      "end": 643.12,
      "text": "मिस हुई है उसे जल्द से जल्द यू नो सॉर्ट"
    },
    {
      "subtitle_id": 288,
      "start": 641.639,
      "end": 644.839,
      "text": "आउट करने की कोशिश करनी पड़ेगी लेकिन"
    },
    {
      "subtitle_id": 289,
      "start": 643.12,
      "end": 647.68,
      "text": "दोबारा अगर ट्रस्ट पाना है तो उतना आसान"
    },
    {
      "subtitle_id": 290,
      "start": 644.839,
      "end": 649.36,
      "text": "नहीं है अ इट इज गोइंग टू बी वेरी वेरी टफ"
    },
    {
      "subtitle_id": 291,
      "start": 647.68,
      "end": 651.88,
      "text": "साथ ही अब एक सवाल तो आपके दिमाग में आया"
    },
    {
      "subtitle_id": 292,
      "start": 649.36,
      "end": 654.2,
      "text": "ही होगा और आना भी चाहिए कि अक्टूबर 2024"
    },
    {
      "subtitle_id": 293,
      "start": 651.88,
      "end": 656.68,
      "text": "में बैंक ने कहा कि हमें ये पता चला लेकिन"
    },
    {
      "subtitle_id": 294,
      "start": 654.2,
      "end": 658.76,
      "text": "कंपनी के सीईओ कंपनी के सीएफओ क्या उन्हें"
    },
    {
      "subtitle_id": 295,
      "start": 656.68,
      "end": 661.6,
      "text": "भी ये चीजें पता ही नहीं चली 6 सा साल से"
    },
    {
      "subtitle_id": 296,
      "start": 658.76,
      "end": 663.36,
      "text": "हो रही है पता ही नहीं चली वेरी शॉकिंग तो"
    },
    {
      "subtitle_id": 297,
      "start": 661.6,
      "end": 665.32,
      "text": "एक डाटा मैं आपको बताता हूं जो आपको और"
    },
    {
      "subtitle_id": 298,
      "start": 663.36,
      "end": 667.8,
      "text": "ज्यादा शॉक कर सकता है ट्रेंड लाइन का जो"
    },
    {
      "subtitle_id": 299,
      "start": 665.32,
      "end": 670.24,
      "text": "डाटा है उसके अनुसार कंपनी के सीईओ सुमन"
    },
    {
      "subtitle_id": 300,
      "start": 667.8,
      "end": 673.72,
      "text": "कत पालिया ने नियर अपनी सारी शेयर"
    },
    {
      "subtitle_id": 301,
      "start": 670.24,
      "end": 676.0,
      "text": "होल्डिंग ₹1 37 पर शेयर की प्राइस पर यानी"
    },
    {
      "subtitle_id": 302,
      "start": 673.72,
      "end": 678.88,
      "text": "118 करोड़ के शेयर्स थे उनके पास वो सेल"
    },
    {
      "subtitle_id": 303,
      "start": 676.0,
      "end": 683.24,
      "text": "कर दिए थे उनके डिप्यू सीईओ अरुण खुराना"
    },
    {
      "subtitle_id": 304,
      "start": 678.88,
      "end": 683.24,
      "text": "इन्होंने भी अपने लगभग सारे शेयर्स"
    },
    {
      "subtitle_id": 305,
      "start": 688.24,
      "end": 693.079,
      "text": "₹1500000 70 करोड़ के शेयर्स लगभग बेच दिए"
    },
    {
      "subtitle_id": 306,
      "start": 691.2,
      "end": 694.76,
      "text": "और इसके अलावा कंपनी में जो एफआईआई है"
    },
    {
      "subtitle_id": 307,
      "start": 693.079,
      "end": 697.92,
      "text": "फॉरेन इंस्टीट्यूशनल इन्वेस्टर्स उन्होंने"
    },
    {
      "subtitle_id": 308,
      "start": 694.76,
      "end": 699.959,
      "text": "भी अपनी शेयर होल्डिंग 40 पर से 24 तक कम"
    },
    {
      "subtitle_id": 309,
      "start": 697.92,
      "end": 701.6,
      "text": "की इसी बीच जो डोमेस्टिक इंस्टीट्यूशनल"
    },
    {
      "subtitle_id": 310,
      "start": 699.959,
      "end": 703.519,
      "text": "इन्वेस्टर्स हैं उन्होंने इसी बीच अपनी"
    },
    {
      "subtitle_id": 311,
      "start": 701.6,
      "end": 705.36,
      "text": "शेयर होल्डिंग बहुत ज्यादा बढ़ाई और इसी"
    },
    {
      "subtitle_id": 312,
      "start": 703.519,
      "end": 707.399,
      "text": "के चलते जो डीआईआई है जैसे कि म्यूचुअल"
    },
    {
      "subtitle_id": 313,
      "start": 705.36,
      "end": 709.36,
      "text": "फंड्स इंश्योरेंस कंपनी इंडिया की इन्हें"
    },
    {
      "subtitle_id": 314,
      "start": 707.399,
      "end": 711.16,
      "text": "भारी भक्कम नुकसान फिलहाल झेलना पड़ रहा"
    },
    {
      "subtitle_id": 315,
      "start": 709.36,
      "end": 713.32,
      "text": "है जाते जाते दो चीजें आपको बताऊंगा"
    },
    {
      "subtitle_id": 316,
      "start": 711.16,
      "end": 715.8,
      "text": "एक्सटर्नल ऑडिट पर बहुत सारी चीजें निर्भर"
    },
    {
      "subtitle_id": 317,
      "start": 713.32,
      "end": 717.56,
      "text": "है वो कब आता है कैसे आता है उस पर और भी"
    },
    {
      "subtitle_id": 318,
      "start": 715.8,
      "end": 719.76,
      "text": "पिक्चर क्लियर होगी सेकंड चीज जाते-जाते"
    },
    {
      "subtitle_id": 319,
      "start": 717.56,
      "end": 721.88,
      "text": "जेमरा लन को जरूर चेक आउट कीजिए"
    },
    {
      "subtitle_id": 320,
      "start": 719.76,
      "end": 724.079,
      "text": "बहुत अच्छी अपॉर्चुनिटी है रीडिंग हैबिट"
    },
    {
      "subtitle_id": 321,
      "start": 721.88,
      "end": 725.959,
      "text": "अपने लिए लगाने की और मार्केट को अच्छे"
    },
    {
      "subtitle_id": 322,
      "start": 724.079,
      "end": 727.88,
      "text": "तरीके से विद द हेल्प ऑफ अच्छे ग्राफिक्स"
    },
    {
      "subtitle_id": 323,
      "start": 725.959,
      "end": 730.079,
      "text": "एंड इंटरेस्टिंग तरीके से सीखने की सो"
    },
    {
      "subtitle_id": 324,
      "start": 727.88,
      "end": 734.399,
      "text": "डोंट मिस आउट न दिस अपॉर्चुनिटी लिंक नीचे"
    },
    {
      "subtitle_id": 325,
      "start": 730.079,
      "end": 734.399,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में दी गई है"
    }
  ]
}