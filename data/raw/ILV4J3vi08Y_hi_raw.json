  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.08,
      "end": 3.919,
      "text": "अगर डिफेंस स्टॉक्स के पिछले 1 साल के"
    },
    {
      "subtitle_id": 2,
      "start": 1.839,
      "end": 7.04,
      "text": "रिटर्न्स देखे जाए तो सारे के सारे ब्रोस"
    },
    {
      "subtitle_id": 3,
      "start": 3.919,
      "end": 7.04,
      "text": "मिसाइल की तरह ऊपर गए"
    },
    {
      "subtitle_id": 4,
      "start": 7.28,
      "end": 12.88,
      "text": "हैं यही नहीं सिर्फ पिछले 1 साल में"
    },
    {
      "subtitle_id": 5,
      "start": 10.12,
      "end": 14.839,
      "text": "निफ्टी इंडिया डिफेंस इंडेक्स ने 160 पर"
    },
    {
      "subtitle_id": 6,
      "start": 12.88,
      "end": 16.64,
      "text": "का रिटर्न दिया है मतलब एक का डबल से"
    },
    {
      "subtitle_id": 7,
      "start": 14.839,
      "end": 18.6,
      "text": "ज्यादा वो भी इंडेक्स में व्हिच इज वेरी"
    },
    {
      "subtitle_id": 8,
      "start": 16.64,
      "end": 20.4,
      "text": "अनयूजुअल 15 स्टॉक्स से इस इंडेक्स में और"
    },
    {
      "subtitle_id": 9,
      "start": 18.6,
      "end": 25.48,
      "text": "लास्ट के वन ईयर के रिटर्न की बात करें तो"
    },
    {
      "subtitle_id": 10,
      "start": 20.4,
      "end": 30.359,
      "text": "मासगा डॉग 158 अप है गार्डन रिच 152 अप है"
    },
    {
      "subtitle_id": 11,
      "start": 25.48,
      "end": 34.0,
      "text": "पारस डिफेंस 78 एल 145 डेटा पैटर्न 31 पर"
    },
    {
      "subtitle_id": 12,
      "start": 30.359,
      "end": 37.36,
      "text": "भारत डायनामिक 135 और एस्ट्रा माइक्रोवेव"
    },
    {
      "subtitle_id": 13,
      "start": 34.0,
      "end": 39.04,
      "text": "149 से ऊपर है तो सवाल यह है कि एक डिफेंस"
    },
    {
      "subtitle_id": 14,
      "start": 37.36,
      "end": 40.719,
      "text": "स्टॉक्स में एगजैक्टली ऐसा क्या हुआ है"
    },
    {
      "subtitle_id": 15,
      "start": 39.04,
      "end": 42.48,
      "text": "जिसके चलते शेयर प्राइस इतनी ज्यादा बढ़ी"
    },
    {
      "subtitle_id": 16,
      "start": 40.719,
      "end": 44.64,
      "text": "है और क्या यह आगे भी इसी तरह से बढ़ती"
    },
    {
      "subtitle_id": 17,
      "start": 42.48,
      "end": 46.079,
      "text": "रहेगी इसके बारे में आज हम बात करेंगे और"
    },
    {
      "subtitle_id": 18,
      "start": 44.64,
      "end": 47.879,
      "text": "दूसरी चीज यह है कि लास्ट वन ईयर के"
    },
    {
      "subtitle_id": 19,
      "start": 46.079,
      "end": 49.68,
      "text": "रिटर्न्स तो आपने देख लिए बहुत बेहतरीन है"
    },
    {
      "subtitle_id": 20,
      "start": 47.879,
      "end": 51.64,
      "text": "लेकिन अगर हम लास्ट वन मंथ के रिटर्न्स की"
    },
    {
      "subtitle_id": 21,
      "start": 49.68,
      "end": 53.239,
      "text": "बात करें तो पिक्चर पूरी तरह से उल्टी है"
    },
    {
      "subtitle_id": 22,
      "start": 51.64,
      "end": 55.96,
      "text": "क्योंकि लास्ट वन मंथ में सारे के सारे"
    },
    {
      "subtitle_id": 23,
      "start": 53.239,
      "end": 59.16,
      "text": "डिफेंस स्टॉक्स डाउन बीएएमएल अराउंड 24 पर"
    },
    {
      "subtitle_id": 24,
      "start": 55.96,
      "end": 61.8,
      "text": "डाउन है पारस अराउंड 12 पर डाउन है बीडीएल"
    },
    {
      "subtitle_id": 25,
      "start": 59.16,
      "end": 64.199,
      "text": "अराउंड 15 डाउन है और मासगा डॉक और एचएल"
    },
    {
      "subtitle_id": 26,
      "start": 61.8,
      "end": 65.92,
      "text": "लगभग 5 पर से डाउन है तो असली सवाल यह कि"
    },
    {
      "subtitle_id": 27,
      "start": 64.199,
      "end": 68.159,
      "text": "क्या ये स्टॉक्स आगे भी बढ़ेंगे या फिर"
    },
    {
      "subtitle_id": 28,
      "start": 65.92,
      "end": 69.88,
      "text": "इनका फ्यूज कंडक्टर निकल चुका है बात"
    },
    {
      "subtitle_id": 29,
      "start": 68.159,
      "end": 71.2,
      "text": "करेंगे इस वीडियो में सो अगर आप डिफेंस"
    },
    {
      "subtitle_id": 30,
      "start": 69.88,
      "end": 72.96,
      "text": "सेक्टर में इन्वेस्टेड हैं या इन्वेस्ट"
    },
    {
      "subtitle_id": 31,
      "start": 71.2,
      "end": 75.08,
      "text": "करने की प्लानिंग कर रहे हैं सो दिस इज अ"
    },
    {
      "subtitle_id": 32,
      "start": 72.96,
      "end": 77.159,
      "text": "कंप्लीट वीडियो जो आपको देखना बहुत जरूरी"
    },
    {
      "subtitle_id": 33,
      "start": 75.08,
      "end": 79.04,
      "text": "है पूरा डिफेंस सेक्टर इसमें कवर्ड है"
    },
    {
      "subtitle_id": 34,
      "start": 77.159,
      "end": 80.68,
      "text": "नमस्कार मैं प्रसाद आपका आज के इस वीडियो"
    },
    {
      "subtitle_id": 35,
      "start": 79.04,
      "end": 82.56,
      "text": "में स्वागत करता हूं तो शुरुआत करते हैं"
    },
    {
      "subtitle_id": 36,
      "start": 80.68,
      "end": 84.36,
      "text": "पहले सवाल से कि पिछले एक साल में ऐसा"
    },
    {
      "subtitle_id": 37,
      "start": 82.56,
      "end": 86.32,
      "text": "क्या हुआ है जिसके चलते डिफेंस के स्टॉक्स"
    },
    {
      "subtitle_id": 38,
      "start": 84.36,
      "end": 87.88,
      "text": "इतने बहुत तेजी से बढ़ रहे हैं इनफैक्ट"
    },
    {
      "subtitle_id": 39,
      "start": 86.32,
      "end": 89.4,
      "text": "डिफेंस का पूरा सेक्टर का सेक्टर बहुत"
    },
    {
      "subtitle_id": 40,
      "start": 87.88,
      "end": 91.119,
      "text": "तेजी से बढ़ रहा है फॉर एग्जांपल अगर हम"
    },
    {
      "subtitle_id": 41,
      "start": 89.4,
      "end": 92.96,
      "text": "डोमेस्टिक डिफेंस प्रोडक्शन की बात करें"
    },
    {
      "subtitle_id": 42,
      "start": 91.119,
      "end": 94.72,
      "text": "तो वो ऑल टाइम हाई पर चल रहा है पहले क्या"
    },
    {
      "subtitle_id": 43,
      "start": 92.96,
      "end": 97.0,
      "text": "होता था कि मेजॉरिटी ऑफ द डिफेंस परचेसेस"
    },
    {
      "subtitle_id": 44,
      "start": 94.72,
      "end": 98.799,
      "text": "गवर्नमेंट इंपोर्ट करती थी और उसके कंपेयर"
    },
    {
      "subtitle_id": 45,
      "start": 97.0,
      "end": 101.04,
      "text": "में डोमेस्टिक प्रोडक्शन नाम मात्र रहता"
    },
    {
      "subtitle_id": 46,
      "start": 98.799,
      "end": 102.56,
      "text": "था लेकिन अब बात करें तो डोमेस्टिक डिफेंस"
    },
    {
      "subtitle_id": 47,
      "start": 101.04,
      "end": 104.399,
      "text": "प्रोडक्शन ऑल टाइम हाई चला गया है"
    },
    {
      "subtitle_id": 48,
      "start": 102.56,
      "end": 107.36,
      "text": "डोमेस्टिक डिफेंस प्रोडक्शन फाइनेंशली"
    },
    {
      "subtitle_id": 49,
      "start": 104.399,
      "end": 109.799,
      "text": "2023 24 में पहुंच गया है 1.3 लाख करोड़"
    },
    {
      "subtitle_id": 50,
      "start": 107.36,
      "end": 111.799,
      "text": "पर जो कि पिछले रे के कंपेरटिवली 17 पर से"
    },
    {
      "subtitle_id": 51,
      "start": 109.799,
      "end": 113.32,
      "text": "अप है और यह नंबर कंटीन्यूअसली बढ़ते ही"
    },
    {
      "subtitle_id": 52,
      "start": 111.799,
      "end": 115.399,
      "text": "जा रहा है अब आप ये सोचिए कि इस चीज का"
    },
    {
      "subtitle_id": 53,
      "start": 113.32,
      "end": 117.92,
      "text": "सबसे ज्यादा फायदा किसे हो रहा होगा तो वो"
    },
    {
      "subtitle_id": 54,
      "start": 115.399,
      "end": 120.2,
      "text": "हो रहा है डीपीएस यूज यानी डिफेंस पब्लिक"
    },
    {
      "subtitle_id": 55,
      "start": 117.92,
      "end": 122.36,
      "text": "सेक्टर अंडरटेकिंग्स यानी सरकारी डिफेंस"
    },
    {
      "subtitle_id": 56,
      "start": 120.2,
      "end": 124.759,
      "text": "कंपनीज को और बाकी सरकारी कंपनीज को"
    },
    {
      "subtitle_id": 57,
      "start": 122.36,
      "end": 126.759,
      "text": "क्योंकि इस नंबर में तकरीबन 80 पर हिस्सा"
    },
    {
      "subtitle_id": 58,
      "start": 124.759,
      "end": 128.28,
      "text": "सरकारी डिफेंस कंपनीज का है तो सरकार का"
    },
    {
      "subtitle_id": 59,
      "start": 126.759,
      "end": 130.44,
      "text": "एक क्लियर विजन है कि ज्यादा से ज्यादा"
    },
    {
      "subtitle_id": 60,
      "start": 128.28,
      "end": 132.4,
      "text": "डिफेंस प्रोडक्शन इंडिया में ही हो और अब"
    },
    {
      "subtitle_id": 61,
      "start": 130.44,
      "end": 134.36,
      "text": "उसका असर धीरे-धीरे डिफेंस एक्सपोर्ट पर"
    },
    {
      "subtitle_id": 62,
      "start": 132.4,
      "end": 136.2,
      "text": "भी दिख रहा है अब डिफेंस प्रोडक्शन की तो"
    },
    {
      "subtitle_id": 63,
      "start": 134.36,
      "end": 138.92,
      "text": "हमने बात की अब डिफेंस एक्सपोर्ट के कुछ"
    },
    {
      "subtitle_id": 64,
      "start": 136.2,
      "end": 140.72,
      "text": "शॉकिंग नंबर आपको बताता हूं 2023 24 में"
    },
    {
      "subtitle_id": 65,
      "start": 138.92,
      "end": 142.56,
      "text": "डिफेंस एक्सपोर्ट ऑल टाइम हाई पर चला गया"
    },
    {
      "subtitle_id": 66,
      "start": 140.72,
      "end": 145.8,
      "text": "है इंडिया का डिफेंस एक्सपोर्ट पहुंच गया"
    },
    {
      "subtitle_id": 67,
      "start": 142.56,
      "end": 148.56,
      "text": "है 21000 करोड़ पर फ्रॉम 16000 करोड़ इन द"
    },
    {
      "subtitle_id": 68,
      "start": 145.8,
      "end": 150.519,
      "text": "प्रीवियस ईयर जो कि क्लोज टू 32 की ग्रोथ"
    },
    {
      "subtitle_id": 69,
      "start": 148.56,
      "end": 153.959,
      "text": "है अब इसे अगर 10 साल पहले से कंपेयर किया"
    },
    {
      "subtitle_id": 70,
      "start": 150.519,
      "end": 157.519,
      "text": "जाए साल 201314 से तो तब वो मात्र 86"
    },
    {
      "subtitle_id": 71,
      "start": 153.959,
      "end": 159.64,
      "text": "करोड़ था तो 686 करोड़ टू 21000 करोड़"
    },
    {
      "subtitle_id": 72,
      "start": 157.519,
      "end": 161.28,
      "text": "बहुत बड़ी जंप है जैसे हम यहां पर डिफेंस"
    },
    {
      "subtitle_id": 73,
      "start": 159.64,
      "end": 163.2,
      "text": "स्टॉक्स का और डिफेंस सेक्टर का एनालिसिस"
    },
    {
      "subtitle_id": 74,
      "start": 161.28,
      "end": 165.08,
      "text": "कर रहे हैं वैसे ही आप किसी भी कंपनी का"
    },
    {
      "subtitle_id": 75,
      "start": 163.2,
      "end": 167.2,
      "text": "या सेक्टर का डिटेल एनालिसिस करके उसमें"
    },
    {
      "subtitle_id": 76,
      "start": 165.08,
      "end": 168.959,
      "text": "इन्वेस्ट करना चाहते हो तो मेरे पास आपके"
    },
    {
      "subtitle_id": 77,
      "start": 167.2,
      "end": 171.159,
      "text": "लिए एक बहुत बेहतरीन ऑफर है हर"
    },
    {
      "subtitle_id": 78,
      "start": 168.959,
      "end": 172.76,
      "text": "इंडिपेंडेंस डे हम फंडामेंटल एनालिसिस का"
    },
    {
      "subtitle_id": 79,
      "start": 171.159,
      "end": 174.8,
      "text": "कोर्स लॉन्च करते हैं बहुत ही स्पेशल"
    },
    {
      "subtitle_id": 80,
      "start": 172.76,
      "end": 176.8,
      "text": "प्राइस पर इस कोर्स में हम सिखाते हैं कि"
    },
    {
      "subtitle_id": 81,
      "start": 174.8,
      "end": 178.8,
      "text": "कैसे कंपनी के फंडामेंटल्स देखने हैं उसका"
    },
    {
      "subtitle_id": 82,
      "start": 176.8,
      "end": 180.959,
      "text": "फॉरेंसिक एनालिसिस करना है उसके बाद कंपनी"
    },
    {
      "subtitle_id": 83,
      "start": 178.8,
      "end": 182.599,
      "text": "का वैल्युएशन निकाल के यह पता करना है कि"
    },
    {
      "subtitle_id": 84,
      "start": 180.959,
      "end": 184.68,
      "text": "शेयर्स अंडर वैल्यूड है या फिर ओवर"
    },
    {
      "subtitle_id": 85,
      "start": 182.599,
      "end": 186.599,
      "text": "वैल्यूड इस पूरे कोर्स के बाद बड़े आसानी"
    },
    {
      "subtitle_id": 86,
      "start": 184.68,
      "end": 188.799,
      "text": "से आप यह सारी चीजें चुटकी में कर पाएंगे"
    },
    {
      "subtitle_id": 87,
      "start": 186.599,
      "end": 190.519,
      "text": "अगर आप बिगिन हैं तो भी तो अगर आपको स्टॉक"
    },
    {
      "subtitle_id": 88,
      "start": 188.799,
      "end": 192.44,
      "text": "सिलेक्शन की पूरी प्रोसेस स्टार्ट टू एंड"
    },
    {
      "subtitle_id": 89,
      "start": 190.519,
      "end": 194.4,
      "text": "समझनी है तो आप इस कोर्स में एनरोल कर"
    },
    {
      "subtitle_id": 90,
      "start": 192.44,
      "end": 196.76,
      "text": "सकते हैं जहां पर इस इंडिपेंडेंस डे हमारी"
    },
    {
      "subtitle_id": 91,
      "start": 194.4,
      "end": 200.28,
      "text": "फ्रीडम सेल ऑफर में आपको ये ₹ 77000 का"
    },
    {
      "subtitle_id": 92,
      "start": 196.76,
      "end": 203.239,
      "text": "कोर्स मिलेगा मात्र ₹1 में विथ नॉट वन ईयर"
    },
    {
      "subtitle_id": 93,
      "start": 200.28,
      "end": 205.08,
      "text": "टू ईयर सीधे लाइफ टाइम वैलिडिटी के साथ अब"
    },
    {
      "subtitle_id": 94,
      "start": 203.239,
      "end": 206.72,
      "text": "ये जो प्राइस है ये प्रीलॉन्च ऑफर प्राइस"
    },
    {
      "subtitle_id": 95,
      "start": 205.08,
      "end": 208.56,
      "text": "है इस प्राइस में आपको ये कोर्स बाद में"
    },
    {
      "subtitle_id": 96,
      "start": 206.72,
      "end": 209.959,
      "text": "कभी नहीं मिलेगा सो डोंट मिस आउट ऑन दिस"
    },
    {
      "subtitle_id": 97,
      "start": 208.56,
      "end": 212.159,
      "text": "अपॉर्चुनिटी अगर आपको कंपनी के"
    },
    {
      "subtitle_id": 98,
      "start": 209.959,
      "end": 213.76,
      "text": "फंडामेंटल्स बहुत डिटेल में समझने हैं तो"
    },
    {
      "subtitle_id": 99,
      "start": 212.159,
      "end": 215.84,
      "text": "अब अगले कुछ सालों में इनका टारगेट यह है"
    },
    {
      "subtitle_id": 100,
      "start": 213.76,
      "end": 217.72,
      "text": "कि कैसे हम इसे 50000 करोड़ के पार लेकर"
    },
    {
      "subtitle_id": 101,
      "start": 215.84,
      "end": 218.879,
      "text": "जाए अब एक्सपोर्ट की बात आती है तो इंडिया"
    },
    {
      "subtitle_id": 102,
      "start": 217.72,
      "end": 221.08,
      "text": "उसमें काफी पीछे है फिर भी एक"
    },
    {
      "subtitle_id": 103,
      "start": 218.879,
      "end": 223.2,
      "text": "क्यूरियोसिटी जरूर आती है कि आखिर इंडिया"
    },
    {
      "subtitle_id": 104,
      "start": 221.08,
      "end": 225.48,
      "text": "डिफेंस किसे एक्सपोर्ट कर रहा है तो करीब"
    },
    {
      "subtitle_id": 105,
      "start": 223.2,
      "end": 227.56,
      "text": "85 कंट्रीज को इंडिया आम सप्लाई कर रहा है"
    },
    {
      "subtitle_id": 106,
      "start": 225.48,
      "end": 230.28,
      "text": "जिसमें इटली है मालदीव्स है कुछ पार्ट"
    },
    {
      "subtitle_id": 107,
      "start": 227.56,
      "end": 232.159,
      "text": "रशिया को गया है श्रीलंका यूएई फिलिपींस"
    },
    {
      "subtitle_id": 108,
      "start": 230.28,
      "end": 233.72,
      "text": "और भी ढेरों सारी कंट्रीज हैं और करीब 100"
    },
    {
      "subtitle_id": 109,
      "start": 232.159,
      "end": 235.4,
      "text": "कंपनीज इंडिया में ऐसी है जो इंडिया से"
    },
    {
      "subtitle_id": 110,
      "start": 233.72,
      "end": 237.2,
      "text": "डिफेंस प्रोडक्ट्स को एक्सपोर्ट कर रही है"
    },
    {
      "subtitle_id": 111,
      "start": 235.4,
      "end": 239.079,
      "text": "वहीं पर डिफेंस इंपोर्ट की बात करें तो वो"
    },
    {
      "subtitle_id": 112,
      "start": 237.2,
      "end": 240.84,
      "text": "स्टेडी कम हो रहा है बट वी आर स्टिल वन"
    },
    {
      "subtitle_id": 113,
      "start": 239.079,
      "end": 242.48,
      "text": "ऑफ़ द बिगेस्ट इंपोर्टर ऑफ द आर्म्स इन द"
    },
    {
      "subtitle_id": 114,
      "start": 240.84,
      "end": 244.2,
      "text": "वर्ल्ड अभी स्टॉक होम इंटरनेशनल पीस"
    },
    {
      "subtitle_id": 115,
      "start": 242.48,
      "end": 246.599,
      "text": "रिसर्च इंस्टिट्यूट का एक रिपोर्ट आया है"
    },
    {
      "subtitle_id": 116,
      "start": 244.2,
      "end": 248.56,
      "text": "जिसमें बताया गया है कि साल 2019 से 2023"
    },
    {
      "subtitle_id": 117,
      "start": 246.599,
      "end": 250.84,
      "text": "के बीच जितना भी डिफेंस ग्लोबली इंपोर्ट"
    },
    {
      "subtitle_id": 118,
      "start": 248.56,
      "end": 252.68,
      "text": "किया गया उसमें से 99.8 पर अकेले इंडिया"
    },
    {
      "subtitle_id": 119,
      "start": 250.84,
      "end": 254.2,
      "text": "ने इंपोर्ट किया है व्हिच इज अ बिग नंबर"
    },
    {
      "subtitle_id": 120,
      "start": 252.68,
      "end": 256.199,
      "text": "अगेन सो भले ही हमारा एक्सपोर्ट बढ़ रहा"
    },
    {
      "subtitle_id": 121,
      "start": 254.2,
      "end": 258.199,
      "text": "है लेकिन एट द सेम टाइम हमारे डिफेंस का"
    },
    {
      "subtitle_id": 122,
      "start": 256.199,
      "end": 260.199,
      "text": "काफी सारा बजट डिफेंस की इंपोर्ट पर जा"
    },
    {
      "subtitle_id": 123,
      "start": 258.199,
      "end": 261.959,
      "text": "रहा है जिसमें अब हम इंस्टेड ऑफ रशिया हम"
    },
    {
      "subtitle_id": 124,
      "start": 260.199,
      "end": 263.4,
      "text": "यूएसए और फ्रांस से ज्यादा इंपोर्ट कर रहे"
    },
    {
      "subtitle_id": 125,
      "start": 261.959,
      "end": 265.16,
      "text": "हैं और उसका मेन रीज़न यह है कि अगर हम"
    },
    {
      "subtitle_id": 126,
      "start": 263.4,
      "end": 267.24,
      "text": "रिसर्च एंड डेवलपमेंट दैट इज आर एनडी की"
    },
    {
      "subtitle_id": 127,
      "start": 265.16,
      "end": 269.16,
      "text": "बात करें तो ये कंट्रीज हमसे काफी ज्यादा"
    },
    {
      "subtitle_id": 128,
      "start": 267.24,
      "end": 270.96,
      "text": "आगे हैं क्योंकि यूएसए डिफेंस पर इंडिया"
    },
    {
      "subtitle_id": 129,
      "start": 269.16,
      "end": 272.68,
      "text": "से 10 गुना ज्यादा स्पेंड करता है और आर"
    },
    {
      "subtitle_id": 130,
      "start": 270.96,
      "end": 274.16,
      "text": "एनडी पर भी 10 गुना से ज्यादा स्पेंड करता"
    },
    {
      "subtitle_id": 131,
      "start": 272.68,
      "end": 275.919,
      "text": "है सो ओबवियस है कि उनकी टेक्नोलॉजी"
    },
    {
      "subtitle_id": 132,
      "start": 274.16,
      "end": 277.52,
      "text": "इंडिया से बेहतर होगी क्योंकि जाहिर सी"
    },
    {
      "subtitle_id": 133,
      "start": 275.919,
      "end": 279.24,
      "text": "बात है कि आगे चलके अगर चाइना से या फिर"
    },
    {
      "subtitle_id": 134,
      "start": 277.52,
      "end": 281.44,
      "text": "पाकिस्तान से हमारा कोई कॉन्फ्लेट हो जाता"
    },
    {
      "subtitle_id": 135,
      "start": 279.24,
      "end": 283.759,
      "text": "है तो सरकार भी चाहती है कि हमारे जवानों"
    },
    {
      "subtitle_id": 136,
      "start": 281.44,
      "end": 286.199,
      "text": "के पास एडवांस वेपंस हो ताकि हम हर चीज"
    },
    {
      "subtitle_id": 137,
      "start": 283.759,
      "end": 288.4,
      "text": "में आगे रहे तो देखा जाए तो पिक्चर क्लियर"
    },
    {
      "subtitle_id": 138,
      "start": 286.199,
      "end": 290.72,
      "text": "है कि सरकार का जो फोकस है वो डिफेंस का"
    },
    {
      "subtitle_id": 139,
      "start": 288.4,
      "end": 292.6,
      "text": "बजट बढ़ाने पर है जो कि 6.21 लाख करोड़ का"
    },
    {
      "subtitle_id": 140,
      "start": 290.72,
      "end": 294.32,
      "text": "फिलहाल है और उनका सेकंड फोकस यह है कि जो"
    },
    {
      "subtitle_id": 141,
      "start": 292.6,
      "end": 296.16,
      "text": "भी आर्म्स और डिफेंस प्रोडक्ट्स पर खर्चा"
    },
    {
      "subtitle_id": 142,
      "start": 294.32,
      "end": 298.16,
      "text": "हो रहा है उसका फायदा इंडियन कंपनीज को"
    },
    {
      "subtitle_id": 143,
      "start": 296.16,
      "end": 300.52,
      "text": "मिले ना कि पूरा का पूरा पैसा बाहर की"
    },
    {
      "subtitle_id": 144,
      "start": 298.16,
      "end": 302.36,
      "text": "कंपनीज को जाए इसी के साथ एक्सपोर्ट्स को"
    },
    {
      "subtitle_id": 145,
      "start": 300.52,
      "end": 304.12,
      "text": "भी बढ़ाने पर फोकस है तो पिक्चर क्लियर है"
    },
    {
      "subtitle_id": 146,
      "start": 302.36,
      "end": 306.28,
      "text": "कि इंडिया की डिफेंस इंडस्ट्री बहुत तेजी"
    },
    {
      "subtitle_id": 147,
      "start": 304.12,
      "end": 308.32,
      "text": "से बढ़ रही है एक्सपोर्ट बढ़ रहा है इसका"
    },
    {
      "subtitle_id": 148,
      "start": 306.28,
      "end": 310.36,
      "text": "फायदा भी इंडियन कंपनीज खासकर डिफेंस"
    },
    {
      "subtitle_id": 149,
      "start": 308.32,
      "end": 312.32,
      "text": "सरकारी कंपनीज को जाएगा पर रियल क्वेश्चन"
    },
    {
      "subtitle_id": 150,
      "start": 310.36,
      "end": 314.32,
      "text": "यह है कि जो भी सरकारी कंपनीज हैं उनको"
    },
    {
      "subtitle_id": 151,
      "start": 312.32,
      "end": 316.32,
      "text": "प्रॉफिट बनाने में बड़ी तकलीफ होती है तो"
    },
    {
      "subtitle_id": 152,
      "start": 314.32,
      "end": 318.199,
      "text": "यहां पर भी सवाल यह है कि क्या डिफेंस"
    },
    {
      "subtitle_id": 153,
      "start": 316.32,
      "end": 320.24,
      "text": "सरकारी कंपनीज इस अपॉर्चुनिटी को प्रॉफिट"
    },
    {
      "subtitle_id": 154,
      "start": 318.199,
      "end": 322.319,
      "text": "में तब्दील कर पा रही है तो चलिए उस पर"
    },
    {
      "subtitle_id": 155,
      "start": 320.24,
      "end": 324.36,
      "text": "अभी बात करते हैं और सबसे पहले बात करते"
    },
    {
      "subtitle_id": 156,
      "start": 322.319,
      "end": 325.919,
      "text": "हैं ऑर्डर बुक की तो ऑर्डर बुक ही सबसे"
    },
    {
      "subtitle_id": 157,
      "start": 324.36,
      "end": 327.88,
      "text": "बड़ा रीजन है जिसने डिफेंस स्टॉक की"
    },
    {
      "subtitle_id": 158,
      "start": 325.919,
      "end": 329.479,
      "text": "प्राइसेस को बहुत ऊपर पुश कर दिया है तो"
    },
    {
      "subtitle_id": 159,
      "start": 327.88,
      "end": 331.919,
      "text": "अगर एचएल की बात करें तो इनका ऑर्डर बुक"
    },
    {
      "subtitle_id": 160,
      "start": 329.479,
      "end": 333.96,
      "text": "है 94000 करोड़ का और इनके सीएफओ ने"
    },
    {
      "subtitle_id": 161,
      "start": 331.919,
      "end": 336.72,
      "text": "रिसेंटली कहा है कि हमारी जो ऑर्डर बुक है"
    },
    {
      "subtitle_id": 162,
      "start": 333.96,
      "end": 338.8,
      "text": "ये बढ़कर 3.5 लाख करोड़ पर जा सकती है बल"
    },
    {
      "subtitle_id": 163,
      "start": 336.72,
      "end": 341.16,
      "text": "की ऑर्डर बुक है 75000 करोड़ से ज्यादा"
    },
    {
      "subtitle_id": 164,
      "start": 338.8,
      "end": 342.759,
      "text": "मासगा डॉक की है 36000 करोड़ की अगर"
    },
    {
      "subtitle_id": 165,
      "start": 341.16,
      "end": 344.319,
      "text": "फाइनेंशियल्स में देखा जाए तो ऑफकोर्स"
    },
    {
      "subtitle_id": 166,
      "start": 342.759,
      "end": 347.479,
      "text": "काफी अच्छी ग्रोथ यहां पर दिख रही है"
    },
    {
      "subtitle_id": 167,
      "start": 344.319,
      "end": 350.12,
      "text": "मासगा डॉक का ये फाइनेंशियल्स हैं और"
    },
    {
      "subtitle_id": 168,
      "start": 347.479,
      "end": 352.6,
      "text": "कंपनी का रेवेन्यू पिछले 3 सालों में"
    },
    {
      "subtitle_id": 169,
      "start": 350.12,
      "end": 355.16,
      "text": "कंपाउंडेड सालाना 33 से बढ़ रहा है और"
    },
    {
      "subtitle_id": 170,
      "start": 352.6,
      "end": 357.12,
      "text": "प्रॉफिट कंपाउंडेड सालाना 47 पर से बढ़"
    },
    {
      "subtitle_id": 171,
      "start": 355.16,
      "end": 358.639,
      "text": "रहा है जिसके चलते लोग शेयर के लिए काफी"
    },
    {
      "subtitle_id": 172,
      "start": 357.12,
      "end": 360.72,
      "text": "ज्यादा प्राइस देने के लिए तैयार हो गए"
    },
    {
      "subtitle_id": 173,
      "start": 358.639,
      "end": 363.08,
      "text": "हैं और यह सिर्फ एक का नहीं है अगर मैं"
    },
    {
      "subtitle_id": 174,
      "start": 360.72,
      "end": 364.56,
      "text": "एएल की भी बात करूं तो अचानक से कंपनी की"
    },
    {
      "subtitle_id": 175,
      "start": 363.08,
      "end": 367.16,
      "text": "जो ऑपरेटिंग प्रॉफिट मार्जिन है वोह काफी"
    },
    {
      "subtitle_id": 176,
      "start": 364.56,
      "end": 369.08,
      "text": "बढ़ गई है और 32 के ऊपर चली गई है किसी"
    },
    {
      "subtitle_id": 177,
      "start": 367.16,
      "end": 371.08,
      "text": "मैन्युफैक्चरिंग कंपनीज के लिए इतनी हाई"
    },
    {
      "subtitle_id": 178,
      "start": 369.08,
      "end": 372.96,
      "text": "ऑपरेटिंग प्रॉफिट मार्जिन होना अपने आप"
    },
    {
      "subtitle_id": 179,
      "start": 371.08,
      "end": 374.36,
      "text": "में एक बहुत बड़ी बात है जिसके चलते एचएल"
    },
    {
      "subtitle_id": 180,
      "start": 372.96,
      "end": 375.96,
      "text": "की जो प्रॉफिट ग्रोथ है वो बहुत तेजी से"
    },
    {
      "subtitle_id": 181,
      "start": 374.36,
      "end": 377.8,
      "text": "हो रही है हालांकि उनकी रेवेन्यू ग्रोथ"
    },
    {
      "subtitle_id": 182,
      "start": 375.96,
      "end": 379.84,
      "text": "उतनी स्ट्रांग नहीं है तो इसीलिए बढ़ती"
    },
    {
      "subtitle_id": 183,
      "start": 377.8,
      "end": 381.319,
      "text": "हुई ऑर्डर बुक को देखते हुए लोग उनको"
    },
    {
      "subtitle_id": 184,
      "start": 379.84,
      "end": 383.16,
      "text": "ज्यादा प्राइस देने के लिए तैयार हो रहे"
    },
    {
      "subtitle_id": 185,
      "start": 381.319,
      "end": 385.72,
      "text": "हैं अब होता क्या है कि कई बार घोड़ों की"
    },
    {
      "subtitle_id": 186,
      "start": 383.16,
      "end": 387.88,
      "text": "रेस में गधे भी शामिल होकर जीत जाते हैं"
    },
    {
      "subtitle_id": 187,
      "start": 385.72,
      "end": 389.28,
      "text": "तो कुछ सिमिलर सिचुएशन अब यहां पर भी है"
    },
    {
      "subtitle_id": 188,
      "start": 387.88,
      "end": 391.599,
      "text": "वो हर बार होता है स्टॉक मार्केट में जब"
    },
    {
      "subtitle_id": 189,
      "start": 389.28,
      "end": 393.08,
      "text": "भी किसी सेक्टर में बूम आता है तो कुछ गधे"
    },
    {
      "subtitle_id": 190,
      "start": 391.599,
      "end": 395.319,
      "text": "भी विनर हो जाते हैं तो यहां पर भी कुछ"
    },
    {
      "subtitle_id": 191,
      "start": 393.08,
      "end": 397.039,
      "text": "ऐसे डिफेंस कंपनीज हैं जो कुछ खास परफॉर्म"
    },
    {
      "subtitle_id": 192,
      "start": 395.319,
      "end": 398.68,
      "text": "नहीं कर पा रही है ना ही उनको ज्यादा कुछ"
    },
    {
      "subtitle_id": 193,
      "start": 397.039,
      "end": 400.4,
      "text": "फायदा मिल रहा है बट स्टिल उनकी शेयर"
    },
    {
      "subtitle_id": 194,
      "start": 398.68,
      "end": 402.08,
      "text": "प्राइस भी बहुत ज्यादा तेजी से बढ़ रही है"
    },
    {
      "subtitle_id": 195,
      "start": 400.4,
      "end": 404.52,
      "text": "अब मैं उनके नाम नहीं लूंगा अगर आप"
    },
    {
      "subtitle_id": 196,
      "start": 402.08,
      "end": 406.639,
      "text": "स्मार्ट हो तो आप खुद उनका नाम ढूंढ के"
    },
    {
      "subtitle_id": 197,
      "start": 404.52,
      "end": 408.759,
      "text": "कमेंट में बता दो ताकि सबको पता चले तो ये"
    },
    {
      "subtitle_id": 198,
      "start": 406.639,
      "end": 410.8,
      "text": "रैली कंटिन्यू करने की दो पॉसिबिलिटीज हैं"
    },
    {
      "subtitle_id": 199,
      "start": 408.759,
      "end": 412.96,
      "text": "पहली ये है कि इंडिया का जो डिफेंस बजट है"
    },
    {
      "subtitle_id": 200,
      "start": 410.8,
      "end": 415.4,
      "text": "वो साल दर साल बढ़ रहा है एक्सपोर्ट पर भी"
    },
    {
      "subtitle_id": 201,
      "start": 412.96,
      "end": 416.919,
      "text": "फोकस है इंपोर्ट भी कम करना है तो लोकल"
    },
    {
      "subtitle_id": 202,
      "start": 415.4,
      "end": 418.72,
      "text": "कंपनीज को फायदा ज्यादा हो सकता है और"
    },
    {
      "subtitle_id": 203,
      "start": 416.919,
      "end": 421.24,
      "text": "इसके सबसे बड़े बेनिफिशियल कौन है सरकारी"
