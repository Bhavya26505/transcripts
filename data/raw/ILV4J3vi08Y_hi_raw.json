    {
      "subtitle_id": 241,
      "start": 494.44,
      "end": 498.919,
      "text": "गई तुरंत डिलीवर हो गई अगर हाईटेक"
    },
    {
      "subtitle_id": 242,
      "start": 496.96,
      "end": 500.4,
      "text": "एयरक्राफ्ट की बात करें तो उसे बनने में"
    },
    {
      "subtitle_id": 243,
      "start": 498.919,
      "end": 502.28,
      "text": "बहुत टाइम लग जाता है टेस्टिंग"
    },
    {
      "subtitle_id": 244,
      "start": 500.4,
      "end": 504.159,
      "text": "सर्टिफिकेशन की प्रोसेस काफी लंबी होती है"
