    {
      "subtitle_id": 220,
      "start": 449.52,
      "end": 454.12,
      "text": "रेशो के आसपास की नहीं है तो अगर गलती से"
    },
    {
      "subtitle_id": 221,
      "start": 451.96,
      "end": 455.84,
      "text": "आगे इस तरह की ग्रोथ नहीं आती है तो पी"
    },
    {
      "subtitle_id": 222,
      "start": 454.12,
      "end": 457.919,
      "text": "करेक्ट हो जाएगा जिसके चलते शेयर प्राइस"
