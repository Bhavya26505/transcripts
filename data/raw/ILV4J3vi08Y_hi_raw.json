    {
      "subtitle_id": 207,
      "start": 425.16,
      "end": 429.24,
      "text": "है रशिया यूक्रेन चल रहा है आर्मेनिया"
    },
    {
      "subtitle_id": 208,
      "start": 427.039,
      "end": 431.479,
      "text": "अजरबैजान का भी कॉन्फ्लेट चल रहा है अब यह"
    },
    {
      "subtitle_id": 209,
      "start": 429.24,
      "end": 433.4,
      "text": "जो इजराइल वाला है इसमें और भी कंट्रीज जा"
    },
    {
      "subtitle_id": 210,
      "start": 431.479,
      "end": 435.52,
      "text": "रही है जिसका फायदा कई सारी डिफेंस"
    },
    {
      "subtitle_id": 211,
      "start": 433.4,
      "end": 437.0,
      "text": "कंट्रीज को हो रहा है छुपके से यूएसए है"
    },
    {
      "subtitle_id": 212,
      "start": 435.52,
      "end": 438.44,
      "text": "रशिया है इनको बहुत ज्यादा फायदा हो रहा"
