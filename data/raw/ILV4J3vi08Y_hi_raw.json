    {
      "subtitle_id": 270,
      "start": 557.32,
      "end": 561.72,
      "text": "नटिसेंटर सुनना है तो सबसे यहां पर"
    },
    {
      "subtitle_id": 271,
      "start": 559.44,
      "end": 563.88,
      "text": "डॉक्यूमेंट पर क्लिक कीजिए टॉप में सीधा"
    },
    {
      "subtitle_id": 272,
      "start": 561.72,
      "end": 565.6,
      "text": "बॉटम में चले जाएंगे यहां पर कॉन्फ्रेंस"
    },
    {
      "subtitle_id": 273,
      "start": 563.88,
      "end": 567.24,
      "text": "कॉल का ट्रांसक्रिप्ट होता है रिकॉर्डिंग"
    },
    {
      "subtitle_id": 274,
      "start": 565.6,
      "end": 568.959,
      "text": "होता है मेरा रिकमेंडेशन है कि आप"
    },
    {
      "subtitle_id": 275,
      "start": 567.24,
      "end": 572.36,
      "text": "रिकॉर्डिंग सुनिए रिकॉर्डिंग आपको नहीं"
    },
    {
      "subtitle_id": 276,
      "start": 568.959,
      "end": 572.36,
      "text": "मिलता है तो आप"
    },
    {
      "subtitle_id": 277,
      "start": 573.8,
      "end": 577.959,
      "text": "youtube2 नाम का कोई चैनल आ जाएगा जहां पर"
    },
    {
      "subtitle_id": 278,
      "start": 576.399,
      "end": 579.56,
      "text": "आप इनकी कॉन्फ्रेंस कॉल सुन लीजिए"
    },
    {
      "subtitle_id": 279,
      "start": 577.959,
      "end": 581.88,
      "text": "मैनेजमेंट क्या बोल रहा है ऑर्डर बुक्स का"
    },
    {
      "subtitle_id": 280,
      "start": 579.56,
      "end": 583.68,
      "text": "क्या सीन है यह सारी चीजें आपके सामने हो"
    },
    {
      "subtitle_id": 281,
      "start": 581.88,
      "end": 586.04,
      "text": "जाएगी उससे आपको बेटर क्लेरिटी आएगी अदर"
    },
    {
      "subtitle_id": 282,
      "start": 583.68,
      "end": 587.68,
      "text": "वाइज अगर आप बस आग बंद करके यूं ही पैसा"
    },
    {
      "subtitle_id": 283,
      "start": 586.04,
      "end": 589.399,
      "text": "डालते रहेंगे तो दैट वुड बी प्रॉब्लेम िक"
    },
    {
      "subtitle_id": 284,
      "start": 587.68,
      "end": 590.56,
      "text": "फॉर यू और दूसरी चीज इन कंपनीज के"
    },
    {
      "subtitle_id": 285,
      "start": 589.399,
      "end": 592.2,
      "text": "क्वार्टर एंड क्वार्टर प्रॉफिट और"
