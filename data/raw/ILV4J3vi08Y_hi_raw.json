    {
      "subtitle_id": 213,
      "start": 437.0,
      "end": 440.16,
      "text": "है तो इस तरह के कॉन्फ्लेट्स अगर बढ़ते"
    },
    {
      "subtitle_id": 214,
      "start": 438.44,
      "end": 441.919,
      "text": "रहते हैं तो बाकी कंट्रीज भी अलग-अलग"
    },
    {
      "subtitle_id": 215,
      "start": 440.16,
      "end": 444.199,
      "text": "सप्लायर्स को ढूंढ सकती हैं जिसमें इंडिया"
    },
    {
      "subtitle_id": 216,
      "start": 441.919,
      "end": 445.919,
      "text": "को चांस मिल सकता है और तीसरा अभी जो रैली"
    },
    {
      "subtitle_id": 217,
      "start": 444.199,
      "end": 447.72,
      "text": "एंड होने की भी जो पॉसिबिलिटीज है उसके"
    },
    {
      "subtitle_id": 218,
      "start": 445.919,
      "end": 449.52,
      "text": "कुछ कारण मैं आपको बताता हूं लेकिन अभी भी"
