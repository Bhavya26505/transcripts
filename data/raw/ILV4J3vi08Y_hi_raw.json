    {
      "subtitle_id": 226,
      "start": 461.72,
      "end": 466.12,
      "text": "बुक सही में उनके पास आती है तो ऑफकोर्स"
    },
    {
      "subtitle_id": 227,
      "start": 463.639,
      "end": 468.56,
      "text": "ये रैली चल सकती है दूसरा इशू है ग्लोबल"
