  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.04,
      "end": 4.72,
      "text": "इन लोगों को सॉरी स्टॉक मार्केट के टीवी"
    },
    {
      "subtitle_id": 2,
      "start": 2.48,
      "end": 6.56,
      "text": "एक्सपर्ट्स को आपने कभी ना कभी टीवी पर"
    },
    {
      "subtitle_id": 3,
      "start": 4.72,
      "end": 8.599,
      "text": "देखा होगा लेकिन क्या आपको पता है कि इन"
    },
    {
      "subtitle_id": 4,
      "start": 6.56,
      "end": 11.639,
      "text": "लोगों ने ट्रेडिंग करके नहीं बल्कि आपको"
    },
    {
      "subtitle_id": 5,
      "start": 8.599,
      "end": 13.28,
      "text": "पागल बनाकर 75 करोड़ कमा लिए हैं बात"
    },
    {
      "subtitle_id": 6,
      "start": 11.639,
      "end": 15.88,
      "text": "सिर्फ इतनी नहीं है इस वीडियो में मैं"
    },
    {
      "subtitle_id": 7,
      "start": 13.28,
      "end": 15.88,
      "text": "आपको इनके कुछ"
    },
    {
      "subtitle_id": 8,
      "start": 30.08,
      "end": 34.119,
      "text": "एक आम इन्वेस्टर की आज आंखें खुलने वाली"
    },
    {
      "subtitle_id": 9,
      "start": 37.44,
      "end": 42.12,
      "text": "हैं तो आपने देखा होगा जो बिजनेस टीवी"
    },
    {
      "subtitle_id": 10,
      "start": 39.96,
      "end": 44.039,
      "text": "चैनल्स है झ बिजनेस है सीएनबीसी आवाज है"
    },
    {
      "subtitle_id": 11,
      "start": 42.12,
      "end": 46.039,
      "text": "वहां पर अलग-अलग गेस्ट आते हैं और वो अपने"
    },
    {
      "subtitle_id": 12,
      "start": 44.039,
      "end": 47.719,
      "text": "स्टॉक टिप्स देकर चले जाते हैं और इनका जो"
    },
    {
      "subtitle_id": 13,
      "start": 46.039,
      "end": 49.92,
      "text": "सेशन रहता है उसका नाम भी वो बहुत फैंसी"
    },
    {
      "subtitle_id": 14,
      "start": 47.719,
      "end": 52.0,
      "text": "रखते हैं ताकि एक आम इन्वेस्टर इजली उन पर"
    },
    {
      "subtitle_id": 15,
      "start": 49.92,
      "end": 54.0,
      "text": "ट्रस्ट करें जैसे कि किरण जादव का एक शो"
    },
    {
      "subtitle_id": 16,
      "start": 52.0,
      "end": 55.879,
      "text": "आता है जिसका नाम है किरण का कमाल सीमी"
    },
    {
      "subtitle_id": 17,
      "start": 54.0,
      "end": 58.0,
      "text": "भौमिक का एक शो आता है जिसका नाम है सीमी"
    },
    {
      "subtitle_id": 18,
      "start": 55.879,
      "end": 60.239,
      "text": "के नॉन स्टॉप शेयर्स मुदित गोयल के शो का"
    },
    {
      "subtitle_id": 19,
      "start": 58.0,
      "end": 62.6,
      "text": "नाम है मुदित के मुनाफे और इसके अला अलावा"
    },
    {
      "subtitle_id": 20,
      "start": 60.239,
      "end": 64.36,
      "text": "आशीष केड करर और हिमांशु गुप्ता ये टीवी"
    },
    {
      "subtitle_id": 21,
      "start": 62.6,
      "end": 66.32,
      "text": "एक्सपर्ट्स भी टीवी पर रेगुलरली आते हैं"
    },
    {
      "subtitle_id": 22,
      "start": 64.36,
      "end": 68.479,
      "text": "और स्टॉक आपको बताते हैं लेकिन सेबी ने"
    },
    {
      "subtitle_id": 23,
      "start": 66.32,
      "end": 70.92,
      "text": "अभी रिसेंटली पाया है कि इन लोगों ने आम"
    },
    {
      "subtitle_id": 24,
      "start": 68.479,
      "end": 72.56,
      "text": "लोगों के साथ 7 करोड़ का फ्रॉड किया है तो"
    },
    {
      "subtitle_id": 25,
      "start": 70.92,
      "end": 74.4,
      "text": "इन्होंने ये स्कैम कैसे किया और कैसे ये"
    },
    {
      "subtitle_id": 26,
      "start": 72.56,
      "end": 76.08,
      "text": "स्कैम पकड़ा गया बड़ी इंटरेस्टिंग स्टोरी"
    },
    {
      "subtitle_id": 27,
      "start": 74.4,
      "end": 77.68,
      "text": "है वीडियो में आगे बढ़ने से पहले आपसे कुछ"
    },
    {
      "subtitle_id": 28,
      "start": 76.08,
      "end": 79.56,
      "text": "कहना चाहता हूं कि अभी कुछ ही दिनों पहले"
    },
    {
      "subtitle_id": 29,
      "start": 77.68,
      "end": 81.4,
      "text": "हमने अपने फ्री कोर्सेस लॉन्च किए थे फ्री"
    },
    {
      "subtitle_id": 30,
      "start": 79.56,
      "end": 83.159,
      "text": "सुनके कई सारे लोगों को लग रहा था कि"
    },
    {
      "subtitle_id": 31,
      "start": 81.4,
      "end": 84.799,
      "text": "कोर्सेस में कुछ दम नहीं रहेगा या फिर"
    },
    {
      "subtitle_id": 32,
      "start": 83.159,
      "end": 86.56,
      "text": "क्या ये कोर्सेस कुछ काम के भी रहेंगे"
    },
    {
      "subtitle_id": 33,
      "start": 84.799,
      "end": 88.04,
      "text": "लेकिन अब पिछले 20-25 दिनों में बहुत सारे"
    },
    {
      "subtitle_id": 34,
      "start": 86.56,
      "end": 90.079,
      "text": "लोगों ने इन कोर्सेस के लिए अप्लाई किया"
    },
    {
      "subtitle_id": 35,
      "start": 88.04,
      "end": 91.92,
      "text": "और उनसे जो फीडबैक आया है उसे हम बहुत बत"
    },
    {
      "subtitle_id": 36,
      "start": 90.079,
      "end": 93.799,
      "text": "खुश है क्योंकि हमारी पूरी कोशिश थी कि इन"
    },
    {
      "subtitle_id": 37,
      "start": 91.92,
      "end": 95.479,
      "text": "कोर्सेस को जितना सिंपल हो सके उतना सिंपल"
    },
    {
      "subtitle_id": 38,
      "start": 93.799,
      "end": 98.0,
      "text": "बनाएं जितना डीटेल्ड एक्सप्लेनेशन हो सके"
    },
    {
      "subtitle_id": 39,
      "start": 95.479,
      "end": 100.04,
      "text": "उतना डिटेल बनाएं और 100% एनिमेशन के साथ"
    },
    {
      "subtitle_id": 40,
      "start": 98.0,
      "end": 101.96,
      "text": "बनाएं और ये सारी चीजें आप सभी को पसंद आ"
    },
    {
      "subtitle_id": 41,
      "start": 100.04,
      "end": 103.56,
      "text": "रही है ये देखकर हमें खुशी है सो थैंक यू"
    },
    {
      "subtitle_id": 42,
      "start": 101.96,
      "end": 105.36,
      "text": "सो मच फॉर योर सपोर्ट और आप में से अगर"
    },
    {
      "subtitle_id": 43,
      "start": 103.56,
      "end": 108.399,
      "text": "किसी को अभी तक एक्सेस नहीं मिला है तो"
    },
    {
      "subtitle_id": 44,
      "start": 105.36,
      "end": 108.399,
      "text": "प्लीज इन दो नंबर्स पर"
    },
    {
      "subtitle_id": 45,
      "start": 119.799,
      "end": 124.0,
      "text": "स मिल जाएगा अब यह जो कोर्सेस है यह आपको"
    },
    {
      "subtitle_id": 46,
      "start": 122.079,
      "end": 126.0,
      "text": "सेल्फ डिपेंडेंट होने में आत्मनिर्भर होने"
    },
    {
      "subtitle_id": 47,
      "start": 124.0,
      "end": 127.799,
      "text": "में बहुत मदद करेंगे और यह आत्मनिर्भर"
    },
    {
      "subtitle_id": 48,
      "start": 126.0,
      "end": 129.879,
      "text": "बनना क्यों जरूरी है इस वीडियो में आपको"
    },
    {
      "subtitle_id": 49,
      "start": 127.799,
      "end": 132.2,
      "text": "आगे पता चल जाएगा तो चलिए अपनी कहानी में"
    },
    {
      "subtitle_id": 50,
      "start": 129.879,
      "end": 134.28,
      "text": "आगे बढ़ते हैं देखिए सेबी के अभी वो"
    },
    {
      "subtitle_id": 51,
      "start": 132.2,
      "end": 136.2,
      "text": "पुरानी सेबी नहीं रही सेबी में कई सारे आज"
    },
    {
      "subtitle_id": 52,
      "start": 134.28,
      "end": 137.84,
      "text": "डेटा एनालिस्ट काम करते हैं जिनका काम यह"
    },
    {
      "subtitle_id": 53,
      "start": 136.2,
      "end": 140.12,
      "text": "है कि कंटीन्यूअस बेसिस पर डेटा को"
    },
    {
      "subtitle_id": 54,
      "start": 137.84,
      "end": 143.08,
      "text": "एनालाइज करना और यह चेक करना कि कुछ तो"
    },
    {
      "subtitle_id": 55,
      "start": 140.12,
      "end": 144.92,
      "text": "एनॉय चेक करते-करते कुछ डाटा एनालिस्ट को"
    },
    {
      "subtitle_id": 56,
      "start": 143.08,
      "end": 146.92,
      "text": "यह पता चला कई बार ऐसा हो रहा है कि कुछ"
    },
    {
      "subtitle_id": 57,
      "start": 144.92,
      "end": 148.76,
      "text": "स्टॉक्स में अगर 15 मिनट की ड्यूरेशन की"
    },
    {
      "subtitle_id": 58,
      "start": 146.92,
      "end": 150.319,
      "text": "हम बात करें वॉल्यूम अगर ऑन एन एवरेज 6"
    },
    {
      "subtitle_id": 59,
      "start": 148.76,
      "end": 152.64,
      "text": "लाख का चल रहा है तो अचानक से अगले 10"
    },
    {
      "subtitle_id": 60,
      "start": 150.319,
      "end": 154.319,
      "text": "मिनट में वो 60 लाख को क्रॉस कर रहा है ये"
    },
    {
      "subtitle_id": 61,
      "start": 152.64,
      "end": 156.08,
      "text": "अचानक कैसे हो रहा है तो उसके बाद उन्हें"
    },
    {
      "subtitle_id": 62,
      "start": 154.319,
      "end": 157.84,
      "text": "पता चला कि उस दौरान टीवी पर कुछ"
    },
    {
      "subtitle_id": 63,
      "start": 156.08,
      "end": 159.44,
      "text": "एक्सपर्ट्स उस स्टॉक को रिकमेंड कर रहे"
    },
    {
      "subtitle_id": 64,
      "start": 157.84,
      "end": 161.84,
      "text": "हैं जिसके बाद अचानक से वॉल्यूम बढ़ रहा"
    },
    {
      "subtitle_id": 65,
      "start": 159.44,
      "end": 164.04,
      "text": "है जिसके बाद इन एनालिस्ट ने क्या किया कि"
    },
    {
      "subtitle_id": 66,
      "start": 161.84,
      "end": 165.76,
      "text": "थोड़ा और डिटेल में चेक किया कि ऐसे कौन"
    },
    {
      "subtitle_id": 67,
      "start": 164.04,
      "end": 167.44,
      "text": "लोग हैं जो इस दौरान ज्यादा ट्रेड कर रहे"
    },
    {
      "subtitle_id": 68,
      "start": 165.76,
      "end": 169.0,
      "text": "हैं उसके बाद उन्हें कुछ डीमेट अकाउंट्स"
    },
    {
      "subtitle_id": 69,
      "start": 167.44,
      "end": 170.64,
      "text": "मिले उन डीमेट अकाउंट्स को जब उन्होंने"
    },
    {
      "subtitle_id": 70,
      "start": 169.0,
      "end": 173.08,
      "text": "एनालाइज किया तो उन्हें पता चला कि कुछ"
    },
    {
      "subtitle_id": 71,
      "start": 170.64,
      "end": 174.72,
      "text": "पर्टिकुलर लोग हैं कंपनीज हैं जिसके जरिए"
    },
    {
      "subtitle_id": 72,
      "start": 173.08,
      "end": 176.64,
      "text": "शेयर्स बाय सेल हो रहे हैं जिसके बाद अब"
    },
    {
      "subtitle_id": 73,
      "start": 174.72,
      "end": 178.36,
      "text": "सेबी के पास बहुत ज्यादा पावर है तो सेबी"
    },
    {
      "subtitle_id": 74,
      "start": 176.64,
      "end": 180.68,
      "text": "ने क्या किया कि उनके डीमेट अकाउंट से"
    },
    {
      "subtitle_id": 75,
      "start": 178.36,
      "end": 182.92,
      "text": "उनके बैंक अकाउंट डिटेल्स निकाले उनके ओनर"
    },
    {
      "subtitle_id": 76,
      "start": 180.68,
      "end": 184.64,
      "text": "की डिटेल्स निकाले कि उस अकाउंट को कौन ओन"
    },
    {
      "subtitle_id": 77,
      "start": 182.92,
      "end": 186.44,
      "text": "करता है और उस अकाउंट ओनर के डिटेल्स"
    },
    {
      "subtitle_id": 78,
      "start": 184.64,
      "end": 189.239,
      "text": "निकालने के बाद सेबी ने क्या किया कि वो"
    },
    {
      "subtitle_id": 79,
      "start": 186.44,
      "end": 189.239,
      "text": "जो पर्सन है उसका"
    },
    {
      "subtitle_id": 80,
      "start": 208.68,
      "end": 212.799,
      "text": "whatsapp-web वो शेयर सेल करके प्रॉफिट"
    },
    {
      "subtitle_id": 81,
      "start": 211.0,
      "end": 215.159,
      "text": "कमाया जाता था तो प्रॉफिट इस प्रोसेस से"
    },
    {
      "subtitle_id": 82,
      "start": 212.799,
      "end": 216.76,
      "text": "कितना बना 72 करोड़ का तो इसका मोड अस"
    },
    {
      "subtitle_id": 83,
      "start": 215.159,
      "end": 218.36,
      "text": "ऑपरेंट यानी पूरी प्रोसेस क्या है उसे समझ"
    },
    {
      "subtitle_id": 84,
      "start": 216.76,
      "end": 221.439,
      "text": "लेते हैं थोड़ा बड़ी इंटरेस्टिंग प्रोसेस"
    },
    {
      "subtitle_id": 85,
      "start": 218.36,
      "end": 221.439,
      "text": "है उसके बाद मैं आपको कुछ"
    },
    {
      "subtitle_id": 86,
      "start": 238.68,
      "end": 242.64,
      "text": "whatsapp-web अब इस चीज का इन्होंने कैसे"
    },
    {
      "subtitle_id": 87,
      "start": 240.84,
      "end": 244.56,
      "text": "फायदा लिया तो इन लोगों ने अपना एक"
    },
    {
      "subtitle_id": 88,
      "start": 242.64,
      "end": 246.04,
      "text": "नेटवर्क बनाया जैसे सीमी भवनिक ने अपना जो"
    },
    {
      "subtitle_id": 89,
      "start": 244.56,
      "end": 247.92,
      "text": "नेटवर्क है वो अपने हस्बैंड के साथ ही बना"
    },
    {
      "subtitle_id": 90,
      "start": 246.04,
      "end": 249.72,
      "text": "लिया पार्था सारथी धार के साथ बाकी जो"
    },
    {
      "subtitle_id": 91,
      "start": 247.92,
      "end": 252.239,
      "text": "तीन-चार एक्सपर्ट्स हैं जैसे आप यहां पर"
    },
    {
      "subtitle_id": 92,
      "start": 249.72,
      "end": 254.239,
      "text": "देख सकते हैं उन्होंने निर्मल कुमार सोनी"
    },
    {
      "subtitle_id": 93,
      "start": 252.239,
      "end": 256.12,
      "text": "इसके साथ नेटवर्क बनाया अब यह नेटवर्क"
    },
    {
      "subtitle_id": 94,
      "start": 254.239,
      "end": 257.919,
      "text": "बनाने का फायदा क्या है और कैसे नेटवर्क"
    },
    {
      "subtitle_id": 95,
      "start": 256.12,
      "end": 259.72,
