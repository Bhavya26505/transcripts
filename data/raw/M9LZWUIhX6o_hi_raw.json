      "start": 459.039,
      "end": 462.68,
      "text": "पूरा सीख लो और फिर अपने हिसाब से"
    },
    {
      "subtitle_id": 193,
      "start": 460.72,
      "end": 464.44,
      "text": "इन्वेस्ट करो क्योंकि मार्केट में जो असली"
    },
    {
      "subtitle_id": 194,
      "start": 462.68,
      "end": 466.08,
      "text": "इन्वेस्टर्स हैं ना वो यहां पर टीप बांटने"
    },
    {
      "subtitle_id": 195,
      "start": 464.44,
      "end": 467.72,
      "text": "नहीं आते ना मिस्टर झुंझुनवाला ने कभी टीप"
    },
    {
      "subtitle_id": 196,
      "start": 466.08,
      "end": 469.52,
      "text": "बांटी ना मिस्टर विजय केडिया ना बाकी"
    },
    {
      "subtitle_id": 197,
      "start": 467.72,
      "end": 471.36,
      "text": "सक्सेसफुल इन्वेस्टर्स आते हैं टीप बांटने"
    },
    {
      "subtitle_id": 198,
      "start": 469.52,
      "end": 473.28,
      "text": "तो जो सक्सेसफुल लोग हैं वो खुद अपने लिए"
    },
    {
      "subtitle_id": 199,
      "start": 471.36,
      "end": 475.36,
      "text": "स्टॉक ढूंढ रहे हैं और सही से सिलेक्ट कर"
    },
    {
      "subtitle_id": 200,
      "start": 473.28,
      "end": 476.879,
      "text": "पा रहे हैं और अगर ये आपसे नहीं हो रहा है"
    },
    {
      "subtitle_id": 201,
      "start": 475.36,
      "end": 478.68,
      "text": "तो बेटर है कि आप म्यूचुअल फंड में"
    },
    {
      "subtitle_id": 202,
      "start": 476.879,
      "end": 480.52,
      "text": "इन्वेस्ट करो जहां पर एक प्रोफेशनल फंड"
    },
    {
      "subtitle_id": 203,
      "start": 478.68,
      "end": 482.24,
      "text": "मैनेजर आपके के पैसे मैनेज करेगा या फिर"
    },
    {
      "subtitle_id": 204,
      "start": 480.52,
      "end": 483.96,
      "text": "सिंपली इंडेक्स फंड में इन्वेस्ट कर दो"
    },
    {
      "subtitle_id": 205,
      "start": 482.24,
      "end": 486.319,
      "text": "जहां पर जैसे मार्केट रिटर्न्स मिलेंगे"
    },
    {
      "subtitle_id": 206,
      "start": 483.96,
      "end": 488.08,
      "text": "वैसे आपको मिलेंगे पर कुछ भी करके शेयर"
    },
    {
      "subtitle_id": 207,
      "start": 486.319,
      "end": 490.0,
      "text": "सिलेक्शन के टाइम किसी पर भी डिपेंड मत"
    },
    {
      "subtitle_id": 208,
      "start": 488.08,
      "end": 491.52,
      "text": "रहो या तो इसे सीख लो या तो म्यूचुअल फंड"
    },
    {
      "subtitle_id": 209,
      "start": 490.0,
      "end": 492.96,
      "text": "की तरफ जाओ और इस वीडियो को ज्यादा से"
    },
    {
      "subtitle_id": 210,
      "start": 491.52,
      "end": 494.28,
      "text": "ज्यादा अपने शेयर मार्केट में इन्वेस्ट"
    },
    {
      "subtitle_id": 211,
      "start": 492.96,
      "end": 496.319,
      "text": "करने वाले दोस्तों के साथ शेयर करो"
    },
    {
      "subtitle_id": 212,
      "start": 494.28,
      "end": 499.759,
      "text": "क्योंकि ये रियलिटी सभी को समझनी बहुत"
    },
    {
      "subtitle_id": 213,
      "start": 496.319,
      "end": 499.759,
      "text": "जरूरी है तो जरूर इसे ज्यादा से ज्यादा"
    },
    {
      "subtitle_id": 214,
      "start": 509.4,
      "end": 512.36,
      "text": "इसके लिए आपको जो अकाउंट ओपन करना पड़ेगा"
    },
    {
      "subtitle_id": 215,
      "start": 510.96,
      "end": 514.2,
      "text": "उसकी लिंक आपको नीचे डिस्क्रिप्शन और"
    },
    {
      "subtitle_id": 216,
      "start": 512.36,
      "end": 518.08,
      "text": "कमेंट बॉक्स में दी गई है मिलते अग वीडियो"
    },
    {
      "subtitle_id": 217,
      "start": 514.2,
      "end": 518.08,
      "text": "में थैंक यू सो मच फॉर वाचिंग दिस वीडियो"
    }
  ]
}