  "parsing_issues": [],
  "segments": [
    {
      "subtitle_id": 1,
      "start": 1.52,
      "end": 6.0,
      "text": "इंडिया का सबसे बड़ा कमोडिटी एक्सचेंज"
    },
    {
      "subtitle_id": 2,
      "start": 3.52,
      "end": 8.48,
      "text": "यानी एमसीएक्स पिछले कुछ टाइम से लगातार"
    },
    {
      "subtitle_id": 3,
      "start": 6.0,
      "end": 10.4,
      "text": "चर्चा में है। और रहे भी क्यों ना?"
    },
    {
      "subtitle_id": 4,
      "start": 8.48,
      "end": 12.4,
      "text": "क्योंकि पिछले 3 सालों में MCX ने"
    },
    {
      "subtitle_id": 5,
      "start": 10.4,
      "end": 14.96,
      "text": "इन्वेस्टर्स को लगभग 10 गुना रिटर्न दिया"
    },
    {
      "subtitle_id": 6,
      "start": 12.4,
      "end": 17.199,
      "text": "है। जी हां, लगभग ₹300 का यह शेयर आज"
    },
    {
      "subtitle_id": 7,
      "start": 14.96,
      "end": 18.96,
      "text": "₹3000 के आसपास ट्रेड कर रहा है। लेकिन"
    },
    {
      "subtitle_id": 8,
      "start": 17.199,
      "end": 21.199,
      "text": "इंटरेस्टिंग बात सिर्फ शेयर प्राइस नहीं"
    },
    {
      "subtitle_id": 9,
      "start": 18.96,
      "end": 23.68,
      "text": "है। पिछले 3 सालों में कंपनी का बिजनेस भी"
    },
    {
      "subtitle_id": 10,
      "start": 21.199,
      "end": 26.4,
      "text": "लगभग चार गुना बढ़ा है। प्रॉफिट करीब 150"
    },
    {
      "subtitle_id": 11,
      "start": 23.68,
      "end": 28.16,
      "text": "करोड़ से बढ़कर 1300 करोड़ के आसपास पहुंच"
    },
    {
      "subtitle_id": 12,
      "start": 26.4,
      "end": 30.32,
      "text": "गया है। ट्रेडिंग वॉल्यूम्स नए रिकॉर्ड"
    },
    {
      "subtitle_id": 13,
      "start": 28.16,
      "end": 32.399,
      "text": "बना रहे हैं। एक्टिव क्लाइंट्स का बेस कई"
    },
    {
      "subtitle_id": 14,
      "start": 30.32,
      "end": 35.04,
      "text": "गुना बढ़ चुका है। और लगभग हर इंपॉर्टेंट"
    },
    {
      "subtitle_id": 15,
      "start": 32.399,
      "end": 36.96,
      "text": "मैट्रिक आप देखोगे तो ऊपर ही जाता हुआ नजर"
    },
    {
      "subtitle_id": 16,
      "start": 35.04,
      "end": 38.879,
      "text": "आ रहा है। लेकिन फिर सवाल आता है कि ऐसा"
    },
    {
      "subtitle_id": 17,
      "start": 36.96,
      "end": 40.559,
      "text": "क्या हुआ कि एमसीएक्स इतनी तेजी से दौड़"
    },
    {
      "subtitle_id": 18,
      "start": 38.879,
      "end": 42.399,
      "text": "रहा है? क्योंकि कमोडिटी मार्केट इंडिया"
    },
    {
      "subtitle_id": 19,
      "start": 40.559,
      "end": 44.399,
      "text": "में कोई नया मार्केट नहीं है। गोल्ड,"
    },
    {
      "subtitle_id": 20,
      "start": 42.399,
      "end": 46.32,
      "text": "सिल्वर और क्रूड ऑयल भी लोग पहले से ट्रेड"
    },
    {
      "subtitle_id": 21,
      "start": 44.399,
      "end": 48.16,
      "text": "करते आ रहे हैं। तो फिर ऐसा क्या हुआ कि"
    },
    {
      "subtitle_id": 22,
      "start": 46.32,
      "end": 50.079,
      "text": "पिछले कुछ सालों में एमसीएक्स का बिजनेस"
    },
    {
      "subtitle_id": 23,
      "start": 48.16,
      "end": 51.76,
      "text": "अचानक से पूरी तरह से एक्सप्ललोड हो गया।"
    },
    {
      "subtitle_id": 24,
      "start": 50.079,
      "end": 53.6,
      "text": "क्या इंडस्ट्रीज रिस्क कम करने के लिए"
    },
    {
      "subtitle_id": 25,
      "start": 51.76,
      "end": 55.28,
      "text": "पहले से ज्यादा हिजिंग करने लगी? क्या"
    },
    {
      "subtitle_id": 26,
      "start": 53.6,
      "end": 57.44,
      "text": "ज्वेलर्स और मैन्युफैक्चरर्स की डिमांड"
    },
    {
      "subtitle_id": 27,
      "start": 55.28,
      "end": 59.359,
      "text": "अचानक बढ़ गई? या फिर इस ग्रोथ के पीछे"
    },
    {
      "subtitle_id": 28,
      "start": 57.44,
      "end": 61.68,
      "text": "कोई और ही कारण छुपा हुआ है? और सबसे"
    },
    {
      "subtitle_id": 29,
      "start": 59.359,
      "end": 64.0,
      "text": "इंपॉर्टेंट सवाल क्या यह कहानी अभी भी"
    },
    {
      "subtitle_id": 30,
      "start": 61.68,
      "end": 65.84,
      "text": "बाकी है? ताकि हम सब उसका फायदा ले सकें?"
    },
    {
      "subtitle_id": 31,
      "start": 64.0,
      "end": 67.92,
      "text": "या फिर जो ग्रोथ हमें पिछले 3-चार सालों"
    },
    {
      "subtitle_id": 32,
      "start": 65.84,
      "end": 70.08,
      "text": "में दिखाई दी, क्या वह टेंपरेरी थी? इन"
    },
    {
      "subtitle_id": 33,
      "start": 67.92,
      "end": 72.08,
      "text": "सारे सवालों के जवाब आपको मिलेंगे आज के"
    },
    {
      "subtitle_id": 34,
      "start": 70.08,
      "end": 73.6,
      "text": "इस वीडियो में। नमस्कार, मैं प्रसाद आपका"
    },
    {
      "subtitle_id": 35,
      "start": 72.08,
      "end": 75.119,
      "text": "आज के इस वीडियो में स्वागत करता हूं।"
    },
    {
      "subtitle_id": 36,
      "start": 73.6,
      "end": 77.36,
      "text": "जिन्हें नहीं पता उनको बता दूं कि"
    },
    {
      "subtitle_id": 37,
      "start": 75.119,
      "end": 79.36,
      "text": "एमसीएक्स इंडिया का सबसे बड़ा कमोडिटी"
    },
    {
      "subtitle_id": 38,
      "start": 77.36,
      "end": 81.92,
      "text": "डेरिवेटिव्स एक्सचेंज है। अकेले एमसीएक्स"
    },
    {
      "subtitle_id": 39,
      "start": 79.36,
      "end": 83.68,
      "text": "के पास 98% ऑफ मार्केट शेयर है। यानी"
    },
    {
      "subtitle_id": 40,
      "start": 81.92,
      "end": 86.0,
      "text": "कमोडिटी ट्रेडिंग में इंडिया में यह"
    },
    {
      "subtitle_id": 41,
      "start": 83.68,
      "end": 88.32,
      "text": "अनडिस्प्यूटेड किंग है। जैसे कि इक्विटी"
    },
    {
      "subtitle_id": 42,
      "start": 86.0,
      "end": 91.04,
      "text": "में एनएससी और बीएसई है। बस फर्क इतना है"
    },
    {
      "subtitle_id": 43,
      "start": 88.32,
      "end": 93.28,
      "text": "कि यहां कंपनीज़ के शेयर्स की जगह गोल्ड,"
    },
    {
      "subtitle_id": 44,
      "start": 91.04,
      "end": 94.96,
      "text": "सिल्वर, क्रूड ऑयल, नेचुरल गैस और दूसरी"
    },
    {
      "subtitle_id": 45,
      "start": 93.28,
      "end": 97.04,
      "text": "कमोडिटीज के कॉन्ट्रैक्ट्स ट्रेड होते"
    },
    {
      "subtitle_id": 46,
      "start": 94.96,
      "end": 98.72,
      "text": "हैं। अब आप पूछोगे कि आखिर इन डेरिवेटिव्स"
    },
    {
      "subtitle_id": 47,
      "start": 97.04,
      "end": 100.799,
      "text": "की जरूरत ही क्या है? तो एक एग्जांपल से"
    },
    {
      "subtitle_id": 48,
      "start": 98.72,
      "end": 103.52,
      "text": "आपको समझाता हूं। मान लीजिए एक ज्वेलर है"
    },
    {
      "subtitle_id": 49,
      "start": 100.799,
      "end": 106.0,
      "text": "ज़ेरी जूलर। अब ज़वीरे ज्वेलर के ओनर को एक"
    },
    {
      "subtitle_id": 50,
      "start": 103.52,
      "end": 107.759,
      "text": "टेंशन है। उन्हें 3 महीने के बाद एक ऑर्डर"
    },
    {
      "subtitle_id": 51,
      "start": 106.0,
      "end": 109.6,
      "text": "डिलीवर करना पड़ता है और उस ऑर्डर को"
    },
    {
      "subtitle_id": 52,
      "start": 107.759,
      "end": 111.6,
      "text": "एग्जीक्यूट करने के लिए उन्हें 1 किलो"
    },
    {
      "subtitle_id": 53,
      "start": 109.6,
      "end": 113.759,
      "text": "गोल्ड की जरूरत पड़ती है। आज गोल्ड की"
    },
    {
      "subtitle_id": 54,
      "start": 111.6,
      "end": 115.759,
      "text": "प्राइस मान लीजिए ₹1 लाख है। लेकिन 3"
    },
    {
      "subtitle_id": 55,
      "start": 113.759,
      "end": 117.84,
      "text": "महीने बाद कितनी होगी यह किसी को नहीं"
    },
    {
      "subtitle_id": 56,
      "start": 115.759,
      "end": 119.68,
      "text": "पता। हो सकता है प्राइस ऊपर जाए या फिर"
    },
    {
      "subtitle_id": 57,
      "start": 117.84,
      "end": 121.759,
      "text": "नीचे भी जा सकती है। लेकिन क्या हो कि"
    },
    {
      "subtitle_id": 58,
      "start": 119.68,
      "end": 123.6,
      "text": "गोल्ड की प्राइस ₹1.5 लाख तक पहुंच जाए।"
    },
    {
      "subtitle_id": 59,
      "start": 121.759,
      "end": 125.84,
      "text": "तब ज़वीरी ज्वेलर की जो कॉस्ट है वह बहुत"
    },
    {
      "subtitle_id": 60,
      "start": 123.6,
      "end": 127.84,
      "text": "बढ़ जाएगी और प्रॉफिट पर उसका सीधा असर"
    },
    {
      "subtitle_id": 61,
      "start": 125.84,
      "end": 130.72,
      "text": "पड़ेगा। इसी रिस्क को बचाने के लिए वह"
    },
    {
      "subtitle_id": 62,
      "start": 127.84,
      "end": 132.56,
      "text": "अपने ब्रोकर के पास जाकर MCX पर गोल्ड का"
    },
    {
      "subtitle_id": 63,
      "start": 130.72,
      "end": 134.72,
      "text": "फ्यूचर कॉन्ट्रैक्ट खरीद लेते हैं। यानी"
    },
    {
      "subtitle_id": 64,
      "start": 132.56,
      "end": 137.12,
      "text": "कि आज ही वह गोल्ड की फ्यूचर परचेस प्राइस"
    },
    {
      "subtitle_id": 65,
      "start": 134.72,
      "end": 139.28,
      "text": "को लॉक कर लेते हैं एट ₹1 लाख। और इस"
    },
    {
      "subtitle_id": 66,
      "start": 137.12,
      "end": 141.44,
      "text": "ट्रांजैक्शन के लिए MCX एक छोटी सी फीस"
    },
    {
      "subtitle_id": 67,
      "start": 139.28,
      "end": 143.52,
      "text": "चार्ज करता है जिसे ट्रांजैक्शन फीस कहते"
    },
    {
      "subtitle_id": 68,
      "start": 141.44,
      "end": 145.599,
      "text": "हैं। अब 3 महीने बाद गोल्ड की प्राइस सच"
    },
    {
      "subtitle_id": 69,
      "start": 143.52,
      "end": 148.08,
      "text": "में ₹1.5 लाख तक पहुंच जाती है। तो"
    },
    {
      "subtitle_id": 70,
      "start": 145.599,
      "end": 150.16,
      "text": "फ्यूचर्स कॉन्ट्रैक्ट पर उन्हें लगभग ₹500"
    },
    {
      "subtitle_id": 71,
      "start": 148.08,
      "end": 152.08,
      "text": "का प्रॉफिट हो जाएगा। जो बढ़ी हुई गोल्ड"
    },
    {
      "subtitle_id": 72,
      "start": 150.16,
      "end": 154.48,
      "text": "कॉस्ट को ऑफसेट कर देगा। इसीलिए"
    },
    {
      "subtitle_id": 73,
      "start": 152.08,
      "end": 156.8,
      "text": "डेरिवेटिव्स का जो ओरिजिनल पर्पस था वह था"
    },
    {
      "subtitle_id": 74,
      "start": 154.48,
      "end": 158.56,
      "text": "कि बिजनेस के रिस्क को कम करना। इसे"
    },
    {
      "subtitle_id": 75,
      "start": 156.8,
      "end": 160.8,
      "text": "फाइनेंस की लैंग्वेज में रिस्क मैनेजमेंट"
    },
    {
      "subtitle_id": 76,
      "start": 158.56,
      "end": 163.04,
      "text": "या फिर हैेजिंग कहते हैं। लेकिन सच बात"
    },
    {
      "subtitle_id": 77,
      "start": 160.8,
      "end": 164.8,
      "text": "कहूं तो जैसे एक हाथी के खाने के दांत अलग"
    },
    {
      "subtitle_id": 78,
      "start": 163.04,
      "end": 166.56,
      "text": "होते हैं और दिखाने के अलग उसी तरह"
    },
    {
      "subtitle_id": 79,
      "start": 164.8,
      "end": 168.48,
      "text": "एमसीएक्स पर होने वाली ट्रेडिंग का बहुत"
    },
    {
      "subtitle_id": 80,
      "start": 166.56,
      "end": 170.56,
      "text": "बड़ा हिस्सा जेन्युइन हैेजिंग के लिए नहीं"
    },
    {
      "subtitle_id": 81,
      "start": 168.48,
      "end": 172.239,
      "text": "होता। जैसे एनएससी और बीएसई पर हर कोई"
    },
    {
      "subtitle_id": 82,
      "start": 170.56,
      "end": 174.239,
      "text": "इन्वेस्टिंग के लिए नहीं आता। वैसे ही"
    },
    {
      "subtitle_id": 83,
      "start": 172.239,
      "end": 176.08,
      "text": "एमसीएक्स पर बहुत सारे लोग सिर्फ प्राइस"
    },
    {
      "subtitle_id": 84,
      "start": 174.239,
      "end": 177.28,
      "text": "मूवमेंट से प्रॉफिट कमाने के लिए आते हैं।"
    },
    {
      "subtitle_id": 85,
      "start": 176.08,
      "end": 179.599,
      "text": "इन्हें फाइनेंस की लैंग्वेज में"
    },
    {
      "subtitle_id": 86,
      "start": 177.28,
      "end": 181.12,
      "text": "स्पेकुलेटर्स कहते हैं। इसमें कुछ रिटेल"
    },
    {
      "subtitle_id": 87,
      "start": 179.599,
      "end": 182.8,
      "text": "ट्रेडर्स होते हैं, कुछ हाई फ्रीक्वेंसी"
    },
    {
      "subtitle_id": 88,
      "start": 181.12,
      "end": 184.56,
      "text": "अल्गो ट्रेडर्स होते हैं। कुछ प्रॉप"
    },
    {
      "subtitle_id": 89,
      "start": 182.8,
      "end": 186.159,
      "text": "ट्रेडिंग फर्म्स होती है। और पिछले कुछ"
    },
    {
      "subtitle_id": 90,
      "start": 184.56,
      "end": 188.159,
      "text": "सालों में देखा जाए तो यहां पर रिटेल"
    },
    {
      "subtitle_id": 91,
      "start": 186.159,
      "end": 190.159,
      "text": "ट्रेडर्स की जो संख्या है वो बहुत ज्यादा"
    },
    {
      "subtitle_id": 92,
      "start": 188.159,
      "end": 192.08,
      "text": "बढ़ी है। और यही वजह है कि एमसीx का जो"
    },
    {
      "subtitle_id": 93,
      "start": 190.159,
      "end": 194.0,
      "text": "बिजनेस है वो काफी तेजी से ग्रो हुआ है।"
    },
    {
      "subtitle_id": 94,
      "start": 192.08,
      "end": 195.84,
      "text": "वीडियो में आगे बढ़ने से पहले मैं आपसे एक"
    },
    {
      "subtitle_id": 95,
      "start": 194.0,
      "end": 198.08,
      "text": "बात करना चाहूंगा। आजकल मार्केट में"
    },
    {
      "subtitle_id": 96,
      "start": 195.84,
      "end": 200.319,
      "text": "इंफॉर्मेशन की कोई कमी नहीं है। हर दिन नए"
    },
    {
      "subtitle_id": 97,
      "start": 198.08,
      "end": 202.48,
      "text": "टिप्स, नए प्रेडिक्शनंस और नए एक्सपर्ट्स"
    },
    {
      "subtitle_id": 98,
      "start": 200.319,
      "end": 204.56,
      "text": "मिल ही जाते हैं। बावजूद इसके लॉन्ग टर्म"
    },
    {
      "subtitle_id": 99,
      "start": 202.48,
      "end": 206.8,
      "text": "वेल क्रिएशन सिर्फ प्रेडिक्शन से नहीं"
    },
    {
      "subtitle_id": 100,
      "start": 204.56,
      "end": 208.879,
      "text": "होती प्रोसेस से होती है। और इसी प्रोसेस"
    },
    {
      "subtitle_id": 101,
      "start": 206.8,
      "end": 211.04,
      "text": "ड्रिवन फिलॉसोफी पर काम करती है कोड"
    },
    {
      "subtitle_id": 102,
      "start": 208.879,
      "end": 212.959,
      "text": "एडवाइज़र्स। कोड एक मुंबई बेस्ड सेबी"
    },
    {
      "subtitle_id": 103,
      "start": 211.04,
      "end": 215.2,
      "text": "रजिस्टर्ड पोर्टफोलियो मैनेजमेंट सर्विज"
    },
    {
      "subtitle_id": 104,
      "start": 212.959,
      "end": 217.2,
      "text": "यानी पीएमएसए जो इन्वेस्टिंग डिसीजंस"
    },
    {
      "subtitle_id": 105,
      "start": 215.2,
      "end": 219.44,
      "text": "इमोशंस या मार्केट नैरेटिव्स पर नहीं"
    },
    {
      "subtitle_id": 106,
      "start": 217.2,
      "end": 221.76,
      "text": "बल्कि डाटा और क्वांटिटेटिव मॉडल्स के"
    },
    {
      "subtitle_id": 107,
      "start": 219.44,
      "end": 223.44,
      "text": "बेसिस पर लेती है। यानी उनका फोकस होता है"
    },
    {
      "subtitle_id": 108,
      "start": 221.76,
      "end": 225.28,
      "text": "डिसिप्लिन इन्वेस्टिंग पर। जहां पर"
    },
    {
      "subtitle_id": 109,
      "start": 223.44,
      "end": 227.28,
      "text": "प्रीडफाइंड रूल्स और डाटा ड्रिवन"
    },
    {
      "subtitle_id": 110,
      "start": 225.28,
      "end": 229.36,
      "text": "फ्रेमवर्क्स के जरिए पोर्टफोलियो मैनेज"
    },
    {
      "subtitle_id": 111,
      "start": 227.28,
      "end": 231.44,
      "text": "किया जाता है। अगर आप एक एचए इन्वेस्टर"
    },
    {
      "subtitle_id": 112,
      "start": 229.36,
      "end": 233.28,
      "text": "हैं और एक्टिवली स्टॉक्स ट्रैक करने के"
    },
    {
      "subtitle_id": 113,
      "start": 231.44,
      "end": 235.36,
      "text": "लिए टाइम नहीं निकाल पाते हो तो कोड"
    },
    {
      "subtitle_id": 114,
      "start": 233.28,
      "end": 238.08,
      "text": "मल्टीपल इन्वेस्टमेंट स्ट्रेटजीस ऑफर करता"
    },
    {
      "subtitle_id": 115,
      "start": 235.36,
      "end": 240.0,
      "text": "है। जिसमें कोड ऑल वेदर, कोड टैक्टिकल फंड"
    },
    {
      "subtitle_id": 116,
      "start": 238.08,
      "end": 242.08,
      "text": "और कोड ग्रोथ फंड [संगीत] शामिल है। सबसे"
    },
    {
      "subtitle_id": 117,
      "start": 240.0,
      "end": 243.68,
      "text": "अच्छी बात यह है कि उनके पास अलग-अलग फ्री"
    },
    {
      "subtitle_id": 118,
      "start": 242.08,
      "end": 245.68,
      "text": "स्ट्रक्चर्स भी अवेलेबल है। जिससे"
    },
    {
      "subtitle_id": 119,
      "start": 243.68,
      "end": 248.0,
      "text": "इन्वेस्टर्स अपने प्रेफरेंस के हिसाब से"
    },
    {
      "subtitle_id": 120,
      "start": 245.68,
      "end": 250.0,
      "text": "ऑप्शन चूज़ कर सकते हैं। तो अगर आपके पास"
    },
    {
      "subtitle_id": 121,
      "start": 248.0,
      "end": 252.159,
      "text": "इन्वेस्ट करने के लिए 50 लाख या उससे"
    },
    {
      "subtitle_id": 122,
      "start": 250.0,
      "end": 253.76,
      "text": "ज्यादा का कॉरपस है और आप जानना चाहते हैं"
    },
    {
      "subtitle_id": 123,
      "start": 252.159,
      "end": 255.599,
      "text": "कि क्वांटिटेटिव इन्वेस्टिंग आपके"
    },
    {
      "subtitle_id": 124,
      "start": 253.76,
      "end": 257.199,
      "text": "पोर्टफोलियो में कैसे फिट हो सकती है तो"
    },
    {
      "subtitle_id": 125,
      "start": 255.599,
      "end": 258.959,
      "text": "आप नीचे डिस्क्रिप्शन और कमेंट बॉक्स में"
    },
    {
      "subtitle_id": 126,
      "start": 257.199,
      "end": 260.959,
      "text": "दी गई लिंक पर क्लिक करके कोड के"
    },
    {
      "subtitle_id": 127,
      "start": 258.959,
      "end": 263.199,
      "text": "एक्सपर्ट्स के साथ एक कंसल्टेशन कॉल फ्री"
    },
    {
      "subtitle_id": 128,
      "start": 260.959,
      "end": 265.36,
      "text": "में शेड्यूल कर सकते हो और डिटेल में उनकी"
    },
    {
      "subtitle_id": 129,
      "start": 263.199,
      "end": 267.199,
      "text": "सर्विज के बारे में भी जान सकते हो। लिंक"
    },
    {
      "subtitle_id": 130,
      "start": 265.36,
      "end": 269.759,
      "text": "नीचे दी गई है। चलिए अब बढ़ते हैं वीडियो"
    },
    {
      "subtitle_id": 131,
      "start": 267.199,
      "end": 271.44,
      "text": "की तरफ। आगे बढ़ने से पहले आप इस चार्ट को"
    },
    {
      "subtitle_id": 132,
      "start": 269.759,
      "end": 274.24,
      "text": "देखिए। इस चार्ट में आप देख सकते हैं कि"
    },
    {
      "subtitle_id": 133,
      "start": 271.44,
      "end": 276.72,
      "text": "फाइनेंसियल ईयर 2023 में इंडियन कमोडिटी"
    },
    {
      "subtitle_id": 134,
      "start": 274.24,
      "end": 279.68,
      "text": "मार्केट का एनुअल टर्नओवर लगभग 151 लाख"
    },
    {
      "subtitle_id": 135,
      "start": 276.72,
      "end": 281.68,
      "text": "करोड़ था और सिर्फ 3 साल बाद यह बढ़कर हो"
    },
    {
      "subtitle_id": 136,
      "start": 279.68,
      "end": 284.0,
      "text": "गया है 1388"
    },
    {
      "subtitle_id": 137,
      "start": 281.68,
      "end": 286.4,
      "text": "लाख करोड़ तक। यानी कमोडिटीज मार्केट का"
    },
    {
      "subtitle_id": 138,
      "start": 284.0,
      "end": 288.4,
      "text": "साइज सिर्फ 3 सालों में नौ गुना बढ़ गया"
    },
    {
      "subtitle_id": 139,
      "start": 286.4,
      "end": 290.72,
      "text": "है। अब सीधी सी बात है कि अगर कमोडिटीज"
    },
    {
      "subtitle_id": 140,
      "start": 288.4,
      "end": 292.639,
      "text": "मार्केट इतना तेजी से बढ़ेगा तो उसका सबसे"
    },
    {
      "subtitle_id": 141,
      "start": 290.72,
      "end": 295.199,
      "text": "ज्यादा फायदा एमसीएक्स को ही होगा क्योंकि"
    },
    {
      "subtitle_id": 142,
      "start": 292.639,
      "end": 296.88,
      "text": "एमसीएक्स के पास 98% मार्केट शेयर है।"
    },
    {
      "subtitle_id": 143,
      "start": 295.199,
      "end": 298.72,
      "text": "इनफैक्ट एमसीएक्स को ही कमोडिटीज़"
    },
    {
      "subtitle_id": 144,
      "start": 296.88,
      "end": 300.96,
      "text": "डेरिवेटिव इंडस्ट्री कहा जाए तो गलत नहीं"
    },
    {
      "subtitle_id": 145,
      "start": 298.72,
      "end": 303.12,
      "text": "होगा। अब आप एक और चार्ट देखिए। यह चार्ट"
    },
    {
      "subtitle_id": 146,
      "start": 300.96,
      "end": 305.44,
      "text": "है एमसीएक्स के एवरेज डेली टर्नओवर यानी"
    },
    {
      "subtitle_id": 147,
      "start": 303.12,
      "end": 307.52,
      "text": "एडीटी का। सिंपल भाषा में बोले तो"
    },
    {
      "subtitle_id": 148,
      "start": 305.44,
      "end": 309.28,
      "text": "एमसीएक्स पर हर दिन कितने रुपए के"
    },
    {
      "subtitle_id": 149,
      "start": 307.52,
      "end": 312.32,
      "text": "कॉन्ट्रैक्ट्स ट्रेड होते हैं? उसका"
    },
    {
      "subtitle_id": 150,
      "start": 309.28,
      "end": 315.36,
      "text": "मेजरमेंट 2020 में एमसीएक्स का एडीटी लगभग"
    },
    {
      "subtitle_id": 151,
      "start": 312.32,
      "end": 317.199,
      "text": "32,000 करोड़ था। आज यह नंबर 2 लाख करोड़"
    },
    {
      "subtitle_id": 152,
      "start": 315.36,
      "end": 318.96,
      "text": "के आसपास पहुंच चुका है। यानी पिछले 6"
    },
    {
      "subtitle_id": 153,
      "start": 317.199,
      "end": 321.36,
      "text": "सालों में एमसीएक्स के ट्रेडिंग वॉल्यूम"
    },
    {
      "subtitle_id": 154,
      "start": 318.96,
      "end": 324.16,
      "text": "सिक्स गुना बढ़ चुके हैं। अगर सीएजीआर की"
    },
    {
      "subtitle_id": 155,
      "start": 321.36,
      "end": 326.639,
      "text": "बात करें तो यह ग्रोथ लगभग 35% कंपाउंडेड"
    },
    {
      "subtitle_id": 156,
      "start": 324.16,
      "end": 328.24,
      "text": "सालाना है। अगर आप इसमें लास्ट के 2 सालों"
    },
    {
      "subtitle_id": 157,
      "start": 326.639,
      "end": 330.0,
      "text": "पर फोकस करते हो तो कहानी और भी"
    },
    {
      "subtitle_id": 158,
      "start": 328.24,
      "end": 332.16,
      "text": "इंटरेस्टिंग हो जाती है। पिछले सिर्फ दो"
    },
    {
      "subtitle_id": 159,
      "start": 330.0,
      "end": 335.28,
      "text": "सालों में एडीटी लगभग ढाई गुना बढ़ गया है"
    },
    {
      "subtitle_id": 160,
      "start": 332.16,
      "end": 336.96,
      "text": "और ग्रोथ रेट लगातार 50% से भी ऊपर बनी"
    },
    {
      "subtitle_id": 161,
      "start": 335.28,
      "end": 339.759,
      "text": "हुई है। और एक्टिव क्लाइंट्स का नंबर"
    },
    {
      "subtitle_id": 162,
      "start": 336.96,
      "end": 342.639,
      "text": "देखें तो 2022-23 में ये नंबर 62 लाख था"
    },
    {
      "subtitle_id": 163,
      "start": 339.759,
      "end": 344.479,
      "text": "और अभी 2025-26 में ये 2 करोड़ के ऊपर जा"
    },
    {
      "subtitle_id": 164,
      "start": 342.639,
      "end": 346.56,
      "text": "चुका है। जिसमें एक बड़ा नंबर छोटे"
    },
    {
      "subtitle_id": 165,
      "start": 344.479,
      "end": 348.72,
      "text": "ट्रेडर्स का ही है। तो आप देख सकते हो कि"
    },
    {
      "subtitle_id": 166,
      "start": 346.56,
      "end": 350.56,
      "text": "काफी क्रेजी चीजें यहां पर कमोडिटीज"
    },
    {
      "subtitle_id": 167,
      "start": 348.72,
      "end": 352.639,
      "text": "मार्केट में चल रही है। जिसके चलते"
    },
    {
      "subtitle_id": 168,
      "start": 350.56,
      "end": 354.8,
      "text": "एमसीएक्स का रेवेन्यू, प्रॉफिट और शेयर"
    },
    {
      "subtitle_id": 169,
      "start": 352.639,
      "end": 356.72,
      "text": "प्राइस तीनों रॉकेट की तरह भाग रहे हैं।"
    },
    {
      "subtitle_id": 170,
      "start": 354.8,
      "end": 358.72,
      "text": "अब सवाल ये आता है कि कमोडिटीज मार्केट की"
    },
    {
      "subtitle_id": 171,
      "start": 356.72,
      "end": 360.32,
      "text": "हिस्ट्री भी काफी पुरानी है। अब पिछले कुछ"
    },
    {
      "subtitle_id": 172,
      "start": 358.72,
      "end": 362.24,
      "text": "सालों में ऐसा क्या हुआ कि अचानक से यहां"
    },
    {
      "subtitle_id": 173,
      "start": 360.32,
      "end": 364.16,
      "text": "पर ट्रेडिंग बढ़ी? यह सवाल आपके दिमाग में"
    },
    {
      "subtitle_id": 174,
      "start": 362.24,
      "end": 366.08,
      "text": "आया होगा। इसका जवाब बहुत ज्यादा"
    },
    {
      "subtitle_id": 175,
      "start": 364.16,
      "end": 367.919,
      "text": "इंटरेस्टिंग है। अब आपको लग रहा होगा कि"
    },
    {
      "subtitle_id": 176,
      "start": 366.08,
      "end": 369.919,
      "text": "बहुत सारे लोग यहां पर कमोडिटीज मार्केट"
    },
    {
      "subtitle_id": 177,
      "start": 367.919,
      "end": 371.6,
      "text": "में नए आ गए जिसकी वजह से यह वॉल्यूम"
    },
    {
      "subtitle_id": 178,
      "start": 369.919,
      "end": 374.08,
      "text": "बढ़ा। लेकिन आपको बता दूं कि इनमें से"
    },
    {
      "subtitle_id": 179,
      "start": 371.6,
      "end": 376.0,
      "text": "ज्यादातर लोग पहले ही स्टॉक मार्केट में"
    },
    {
      "subtitle_id": 180,
      "start": 374.08,
      "end": 378.88,
      "text": "फ्यूचर्स एंड ऑप्शंस कर रहे थे। लेकिन"
    },
    {
      "subtitle_id": 181,
      "start": 376.0,
      "end": 381.12,
      "text": "पिछले कुछ टाइम में बहुत सारे लोग इक्विटी"
    },
    {
      "subtitle_id": 182,
      "start": 378.88,
      "end": 383.44,
      "text": "डेरिवेटिव्स से कमोडिटीज डेरिवेटिव्स पर"
    },
    {
      "subtitle_id": 183,
      "start": 381.12,
      "end": 384.8,
      "text": "माइग्रेट हो गए। अब आप सोचिए यह माइग्रेशन"
    },
    {
      "subtitle_id": 184,
      "start": 383.44,
      "end": 386.96,
      "text": "क्यों होता है? तो देखिए ज्यादातर"
    },
    {
      "subtitle_id": 185,
      "start": 384.8,
      "end": 389.12,
      "text": "माइग्रेशन दो कारणों से होते हैं। पहला जब"
    },
    {
      "subtitle_id": 186,
      "start": 386.96,
      "end": 391.52,
      "text": "आप जहां हैं वहां पर आपको परेशान किया जा"
    },
    {
      "subtitle_id": 187,
      "start": 389.12,
      "end": 393.919,
      "text": "रहा हो और दूसरा जब आपको कहीं और बेटर"
    },
    {
      "subtitle_id": 188,
      "start": 391.52,
      "end": 395.84,
      "text": "अपॉर्चुनिटी मिले और एफएओ से कमोडिटीज में"
    },
    {
      "subtitle_id": 189,
      "start": 393.919,
      "end": 398.4,
      "text": "यह माइग्रेशन इन दोनों का मिक्सचर है।"
    },
    {
      "subtitle_id": 190,
      "start": 395.84,
      "end": 400.88,
      "text": "क्योंकि पिछले कुछ सालों से सरकार और सेबी"
    },
    {
      "subtitle_id": 191,
      "start": 398.4,
      "end": 403.199,
      "text": "दोनों की नजर एफएओ पर है। जहां लगातार"
    },
    {
      "subtitle_id": 192,
      "start": 400.88,
      "end": 405.36,
      "text": "नए-नए टैक्सेस लाए गए, नए-नए रूल्स और"
    },
    {
      "subtitle_id": 193,
      "start": 403.199,
      "end": 407.68,
      "text": "रेगुलेशंस लाए गए ताकि एफएओ ट्रेडिंग को"
    },
    {
      "subtitle_id": 194,
      "start": 405.36,
      "end": 409.36,
      "text": "कंट्रोल किया जा सके। खासकर छोटे ट्रेडर्स"
    },
    {
      "subtitle_id": 195,
      "start": 407.68,
      "end": 411.199,
      "text": "के लिए पिछले कुछ टाइम में एफएओ काफी"
    },
    {
      "subtitle_id": 196,
      "start": 409.36,
      "end": 413.28,
      "text": "मुश्किल किया गया। यानी इक्विटी"
    },
    {
      "subtitle_id": 197,
      "start": 411.199,
      "end": 415.919,
      "text": "डेरिवेटिव्स वाले बहुत सारे लोग पहले ही"
    },
    {
      "subtitle_id": 198,
      "start": 413.28,
      "end": 418.0,
      "text": "सताए हुए थे। और दूसरी चीज कि एक जो भी"
    },
    {
      "subtitle_id": 199,
      "start": 415.919,
      "end": 420.8,
      "text": "ट्रेडर है जो एफएओ में ट्रेड करता है उसकी"
    },
    {
      "subtitle_id": 200,
      "start": 418.0,
      "end": 423.039,
      "text": "फेवरेट चीज क्या होती है? वो होती है वो।"
    },
    {
      "subtitle_id": 201,
      "start": 420.8,
      "end": 425.12,
      "text": "यानी जितना प्राइस ऊपर नीचे होगा कम से कम"
    },
    {
      "subtitle_id": 202,
      "start": 423.039,
      "end": 427.199,
      "text": "टाइम में उतना ट्रेडर्स को फायदा होने के"
    },
    {
      "subtitle_id": 203,
      "start": 425.12,
      "end": 429.12,
      "text": "चांसेस बढ़ते हैं। पहले यह शेयर मार्केट"
    },
    {
      "subtitle_id": 204,
      "start": 427.199,
      "end": 431.199,
      "text": "में होता था। पर पिछले डेढ़-2 सालों से"
    },
    {
      "subtitle_id": 205,
      "start": 429.12,
      "end": 433.199,
      "text": "कमोडिटीज मार्केट में खासकर गोल्ड और"
    },
    {
      "subtitle_id": 206,
      "start": 431.199,
      "end": 435.199,
      "text": "सिल्वर में बहुत ज्यादा वोलेटिलिटी रही"
    },
    {
      "subtitle_id": 207,
      "start": 433.199,
      "end": 438.16,
      "text": "है। इस साल के शुरुआत में ऐसे बहुत सारे"
    },
    {
      "subtitle_id": 208,
      "start": 435.199,
      "end": 440.0,
      "text": "दिन थे जहां पर सिल्वर 10-15% ऊपर नीचे हो"
    },
    {
      "subtitle_id": 209,
      "start": 438.16,
      "end": 442.08,
      "text": "रहा था। और यह जो वोलेटिलिटी है यह"
    },
    {
      "subtitle_id": 210,
      "start": 440.0,
      "end": 443.84,
      "text": "ट्रेडर्स को बहुत ज्यादा पसंद है। और जैसे"
    },
    {
      "subtitle_id": 211,
      "start": 442.08,
      "end": 445.44,
      "text": "कि मैं बार-बार कहता हूं कि जो गैंबलर्स"
    },
    {
      "subtitle_id": 212,
      "start": 443.84,
      "end": 447.599,
      "text": "हैं, स्पेकुलेटर्स हैं, दे ऑलवेज फाइंड"
    },
    {
      "subtitle_id": 213,
      "start": 445.44,
      "end": 449.36,
      "text": "अवे। अगर एक जगह पर उन्हें सताया जाए तो"
    },
    {
      "subtitle_id": 214,
      "start": 447.599,
      "end": 451.3,
      "text": "वो कहीं ना कहीं रास्ता ढूंढ ही लेते। तो"
    },
    {
      "subtitle_id": 215,
      "start": 449.36,
      "end": 452.479,
      "text": "उन्होंने वो रास्ता कमोडिटीज मार्केट"
    },
    {
      "subtitle_id": 216,
      "start": 451.3,
      "end": 454.479,
      "text": "[संगीत] में भी ढूंढ लिया है। और"
    },
    {
      "subtitle_id": 217,
      "start": 452.479,
      "end": 456.16,
      "text": "कोइंसिडेंस ऐसा था कि गोल्ड सिल्वर की"
    },
    {
      "subtitle_id": 218,
      "start": 454.479,
      "end": 458.16,
      "text": "प्राइसेस पिछले कुछ टाइम में काफी ज्यादा"
    },
    {
      "subtitle_id": 219,
      "start": 456.16,
      "end": 459.919,
      "text": "बढ़ी। पिछले दो सालों में पर्टिकुलरली और"
    },
    {
      "subtitle_id": 220,
      "start": 458.16,
      "end": 461.759,
      "text": "ऐसे में वहां पर वोलेटिलिटी भी काफी"
    },
    {
      "subtitle_id": 221,
      "start": 459.919,
      "end": 463.759,
      "text": "ज्यादा बढ़ी। तो बहुत सारे लोगों का ध्यान"
    },
    {
      "subtitle_id": 222,
      "start": 461.759,
      "end": 465.68,
      "text": "उस पर गया और वो भी फिर गोल्ड और सिल्वर"
    },
    {
      "subtitle_id": 223,
      "start": 463.759,
      "end": 467.44,
      "text": "में ट्रेडिंग करने लगे। और आप इस चार्ट को"
    },
    {
      "subtitle_id": 224,
      "start": 465.68,
      "end": 469.759,
      "text": "देखकर समझ ही सकते हो कि एमसीएक्स के"
    },
    {
      "subtitle_id": 225,
      "start": 467.44,
      "end": 472.0,
      "text": "ज्यादातर प्रीमियम्स और 80% टर्नओवर इन"
    },
    {
      "subtitle_id": 226,
      "start": 469.759,
      "end": 474.479,
      "text": "फ्यूचर्स गोल्ड और सिल्वर कॉन्ट्रैक्ट से"
    },
    {
      "subtitle_id": 227,
      "start": 472.0,
      "end": 476.319,
      "text": "ही आता है। बाकी सारी कमोडिटीज इनकी इनकम"
    },
    {
      "subtitle_id": 228,
      "start": 474.479,
      "end": 478.56,
      "text": "का एक छोटा सा पार्ट है। अब यह तो हो गया"
    },
    {
      "subtitle_id": 229,
      "start": 476.319,
      "end": 480.16,
      "text": "व्हाई कि अचानक से एमसीएक्स का बिजनेस"
    },
    {
      "subtitle_id": 230,
      "start": 478.56,
      "end": 482.0,
      "text": "पिछले कुछ सालों में इतना तेजी से कैसे"
    },
    {
      "subtitle_id": 231,
      "start": 480.16,
      "end": 483.44,
      "text": "बढ़ा? अब सवाल यह आता है कि क्या यह अच्छा"
    },
    {
      "subtitle_id": 232,
      "start": 482.0,
      "end": 485.68,
      "text": "टाइम है एमसीएक्स में इन्वेस्ट करने का?"
    },
    {
      "subtitle_id": 233,
      "start": 483.44,
      "end": 487.68,
      "text": "क्या यह रैली इसी तरह जारी रहेगी आने वाले"
    },
    {
      "subtitle_id": 234,
      "start": 485.68,
      "end": 489.919,
      "text": "टाइम में? तो अगर आप अब तक की एमसीएक्स की"
    },
    {
      "subtitle_id": 235,
      "start": 487.68,
      "end": 492.24,
      "text": "ग्रोथ स्टोरी सुनकर काफी इंप्रेस हो गए हो"
    },
    {
      "subtitle_id": 236,
      "start": 489.919,
      "end": 494.24,
      "text": "तो मैं कहूंगा थोड़ा वेट कीजिए क्योंकि यह"
    },
    {
      "subtitle_id": 237,
      "start": 492.24,
      "end": 496.319,
      "text": "सब तो पास्ट की बातें हैं। जैसे कि मिस्टर"
    },
    {
      "subtitle_id": 238,
      "start": 494.24,
      "end": 498.4,
      "text": "राजीव ठक्कर कहते हैं कि यू कांट ड्राइव अ"
    },
    {
      "subtitle_id": 239,
      "start": 496.319,
      "end": 500.16,
      "text": "कार व्हाइल लुकिंग इन द रियर व्यू मिरर।"
    },
    {
      "subtitle_id": 240,
      "start": 498.4,
      "end": 502.8,
      "text": "यू नीड टू लुक फॉरवर्ड। तो ये जितने भी"
    },
    {
      "subtitle_id": 241,
      "start": 500.16,
      "end": 504.879,
      "text": "नंबर्स मैंने आपको बताए वो मार्च 2026 तक"
    },
    {
      "subtitle_id": 242,
      "start": 502.8,
      "end": 506.4,
      "text": "के हैं। और हमें पता है कि फरवरी और मार्च"
    },
    {
      "subtitle_id": 243,
      "start": 504.879,
      "end": 508.56,
      "text": "में गोल्ड और सिल्वर की प्राइसेस में"
    },
    {
      "subtitle_id": 244,
      "start": 506.4,
      "end": 511.039,
      "text": "कितनी ज्यादा वोलेटिलिटी थी। जनवरी मंथ"
    },
    {
      "subtitle_id": 245,
      "start": 508.56,
      "end": 514.0,
      "text": "में गोल्ड की प्राइसेस ₹1.3 लाख तक पहुंच"
    },
    {
      "subtitle_id": 246,
      "start": 511.039,
      "end": 516.159,
      "text": "गई थी। और मंथ एंड तक वो ₹1.8 लाख के भी"
    },
    {
      "subtitle_id": 247,
      "start": 514.0,
      "end": 518.56,
      "text": "ऊपर चली गई थी। यानी हिस्टोरिकली वो वन ऑफ"
    },
    {
      "subtitle_id": 248,
      "start": 516.159,
      "end": 520.399,
      "text": "द मोस्ट वोलेटाइल मंथ था गोल्ड और सिल्वर"
    },
    {
      "subtitle_id": 249,
      "start": 518.56,
      "end": 522.32,
      "text": "के लिए। लेकिन अगर आप अप्रैल और मई के"
    },
    {
      "subtitle_id": 250,
      "start": 520.399,
      "end": 524.64,
      "text": "प्राइसेस चेक करोगे तो गोल्ड और सिल्वर"
    },
    {
      "subtitle_id": 251,
      "start": 522.32,
      "end": 526.64,
      "text": "में इतनी वोलेटिलिटी नहीं है। अगर आने"
    },
    {
      "subtitle_id": 252,
      "start": 524.64,
      "end": 528.32,
      "text": "वाले महीनों में भी इसी तरह वोलेटिलिटी कम"
    },
    {
      "subtitle_id": 253,
      "start": 526.64,
      "end": 530.48,
      "text": "रही तो यहां एमसीएक्स के प्रीमियम"
    },
    {
      "subtitle_id": 254,
      "start": 528.32,
      "end": 532.64,
      "text": "रेवेन्यू में एक ड्रॉप आ सकता है क्योंकि"
    },
    {
      "subtitle_id": 255,
      "start": 530.48,
      "end": 534.399,
      "text": "कम लोग उसे ट्रेड करेंगे। अब इस चीज को"
    },
    {
      "subtitle_id": 256,
      "start": 532.64,
      "end": 536.72,
      "text": "समझने के लिए हमने कंपनी का कॉन्फ्रेंस"
    },
    {
      "subtitle_id": 257,
      "start": 534.399,
      "end": 538.72,
      "text": "कॉल सुना और वहां पर मैनेजमेंट से किसी ने"
    },
    {
      "subtitle_id": 258,
      "start": 536.72,
      "end": 540.72,
      "text": "एक सवाल किया कि यह जो ग्रोथ है वह"
    },
    {
      "subtitle_id": 259,
      "start": 538.72,
      "end": 542.48,
      "text": "स्ट्रक्चरल है या फिर मोमेंटम वाली। तो"
    },
    {
      "subtitle_id": 260,
      "start": 540.72,
      "end": 544.72,
      "text": "मैनेजमेंट का कहना था कि यह स्ट्रक्चरल"
    },
    {
      "subtitle_id": 261,
      "start": 542.48,
      "end": 546.64,
      "text": "ग्रोथ है और आगे भी यह कंटिन्यू रहेगी। और"
    },
    {
      "subtitle_id": 262,
      "start": 544.72,
      "end": 548.64,
      "text": "सवाल यह है कि क्या यह इसी स्पीड से"
    },
    {
      "subtitle_id": 263,
      "start": 546.64,
      "end": 550.16,
      "text": "कंटिन्यू रहेगी? बिकॉज़ ऑफ MCX का"
    },
    {
      "subtitle_id": 264,
      "start": 548.64,
      "end": 553.04,
      "text": "वैल्यू्यूएशन देखोगे तो अभी भी उसका"
    },
    {
      "subtitle_id": 265,
      "start": 550.16,
      "end": 556.16,
      "text": "प्राइस टू अर्निंग रेशियो 55 के आसपास है।"
    },
    {
      "subtitle_id": 266,
      "start": 553.04,
      "end": 557.92,
      "text": "पीई रेशियो 0.5 है। तो ऐसा लग सकता है कि"
    },
    {
      "subtitle_id": 267,
      "start": 556.16,
      "end": 559.92,
      "text": "वैल्यू्यूएशन ग्रोथ के हिसाब से फिलहाल तो"
    },
    {
      "subtitle_id": 268,
      "start": 557.92,
      "end": 562.08,
      "text": "रीज़नेबल है। लेकिन पर्सनली मुझे लगता है"
    },
    {
      "subtitle_id": 269,
      "start": 559.92,
      "end": 563.76,
      "text": "कि इस ग्रोथ को मेंटेन करना बहुत ज्यादा"
    },
    {
      "subtitle_id": 270,
      "start": 562.08,
      "end": 565.68,
      "text": "मुश्किल है। क्योंकि गोल्ड और सिल्वर का"
    },
    {
      "subtitle_id": 271,
      "start": 563.76,
      "end": 567.6,
      "text": "एक गोल्डन पीरियड था। लेकिन हिस्टोरिकली"
    },
    {
      "subtitle_id": 272,
      "start": 565.68,
      "end": 569.2,
      "text": "देखें तो गोल्ड अगर दो-ती सालों में बहुत"
    },
    {
      "subtitle_id": 273,
      "start": 567.6,
      "end": 571.839,
      "text": "अच्छा परफॉर्म करता है तो आने वाले कुछ"
    },
    {
      "subtitle_id": 274,
      "start": 569.2,
      "end": 573.6,
      "text": "साल इसके काफी स्लो और ठंडे रहते हैं। अब"
    },
    {
      "subtitle_id": 275,
      "start": 571.839,
      "end": 575.839,
      "text": "यहां पर मैनेजमेंट का भी यह कहना है कि"
    },
    {
      "subtitle_id": 276,
      "start": 573.6,
      "end": 577.92,
      "text": "गोल्ड और सिल्वर में जरूर कमी आ सकती है"
    },
    {
      "subtitle_id": 277,
      "start": 575.839,
      "end": 579.92,
      "text": "पर वो कमी ऑबसेट हो जाएगी क्रूड ऑयल के"
    },
    {
      "subtitle_id": 278,
      "start": 577.92,
      "end": 582.0,
      "text": "प्रीमियम से। बिकॉज़ मार्च से क्रूड ऑयल के"
    },
    {
      "subtitle_id": 279,
      "start": 579.92,
      "end": 583.76,
      "text": "प्राइसेस काफी ऊपर नीचे हो रहे हैं। पर"
    },
    {
      "subtitle_id": 280,
      "start": 582.0,
      "end": 586.08,
      "text": "सवाल यह है कि क्या गोल्ड और सिल्वर का"
    },
    {
      "subtitle_id": 281,
      "start": 583.76,
      "end": 588.08,
      "text": "फॉल क्रूड ऑयल से पूरा होगा? मुझे पर्सनली"
    },
    {
      "subtitle_id": 282,
      "start": 586.08,
      "end": 589.76,
      "text": "लगता है कि काफी टफ है। बिकॉज़ अगर आप"
    },
    {
      "subtitle_id": 283,
      "start": 588.08,
      "end": 591.36,
      "text": "गोल्ड की बात करें तो एक छोटा ट्रेडर भी"
    },
    {
      "subtitle_id": 284,
      "start": 589.76,
      "end": 593.76,
      "text": "गोल्ड पेटल कॉन्ट्रैक्ट में छोटी सी"
    },
    {
      "subtitle_id": 285,
      "start": 591.36,
      "end": 595.44,
      "text": "अमाउंट 1500 2000 से ट्रेड कर सकता है।"
    },
    {
      "subtitle_id": 286,
      "start": 593.76,
      "end": 597.519,
      "text": "लेकिन प्रैक्टिकली देखें तो क्रूड ऑयल के"
    },
    {
      "subtitle_id": 287,
      "start": 595.44,
      "end": 599.519,
      "text": "लिए पॉसिबल नहीं है। वहां ऑप्शन ही एक"
    },
    {
      "subtitle_id": 288,
      "start": 597.519,
      "end": 601.44,
      "text": "जरिया है छोटे रिटेल ट्रेडर्स के लिए। अब"
    },
    {
      "subtitle_id": 289,
      "start": 599.519,
      "end": 603.279,
      "text": "गोल्ड की जो वोलेटिलिटी है पिछले 2 महीनों"
    },
    {
      "subtitle_id": 290,
      "start": 601.44,
      "end": 605.6,
      "text": "में काफी कम हुई है। तो ये जून क्वार्टर"
    },
    {
      "subtitle_id": 291,
      "start": 603.279,
      "end": 607.6,
      "text": "का रिजल्ट जो जुलाई मंथ में आएगा एमसीएक्स"
    },
    {
      "subtitle_id": 292,
      "start": 605.6,
      "end": 608.8,
      "text": "का वो देखना काफी इंटरेस्टिंग रहेगा।"
    },
    {
      "subtitle_id": 293,
      "start": 607.6,
      "end": 611.76,
      "text": "क्योंकि आने वाले टाइम में भी अगर"
    },
    {
      "subtitle_id": 294,
      "start": 608.8,
      "end": 613.839,
      "text": "एमसीएक्स हर साल 50% से बढ़ती है तो मैं"
    },
    {
      "subtitle_id": 295,
      "start": 611.76,
      "end": 615.6,
      "text": "काफी सरप्राइज़ हऊंगा। तो अगर आप एमसीएक्स"
    },
    {
      "subtitle_id": 296,
      "start": 613.839,
      "end": 618.24,
      "text": "में इन्वेस्ट करने का सोच रहे हो तो तभी"
    },
    {
      "subtitle_id": 297,
      "start": 615.6,
      "end": 620.959,
      "text": "कीजिए जब आपको लगता है कि गोल्ड और सिल्वर"
    },
    {
      "subtitle_id": 298,
      "start": 618.24,
      "end": 623.36,
      "text": "की जो वोलेटिलिटी है वो आगे भी कायम रहेगी"
    },
    {
      "subtitle_id": 299,
      "start": 620.959,
      "end": 625.519,
      "text": "जिसके चलते लोग एक्टिवली वहां पर कमोडिटीज"
    },
    {
      "subtitle_id": 300,
      "start": 623.36,
      "end": 627.839,
      "text": "मार्केट में ट्रेड करेंगे। अगर ऐसा नहीं"
    },
    {
      "subtitle_id": 301,
      "start": 625.519,
      "end": 629.519,
      "text": "होता है तो फिर एनसीएक्स की जो ग्रोथ है"
    },
    {
      "subtitle_id": 302,
      "start": 627.839,
      "end": 631.6,
      "text": "वो स्लो डाउन हो सकती है और उसका जो"
    },
    {
      "subtitle_id": 303,
      "start": 629.519,
      "end": 633.68,
      "text": "वैल्यू्यूएशन है जो फिलहाल तो कंफर्टेबल"
    },
    {
      "subtitle_id": 304,
      "start": 631.6,
      "end": 635.839,
      "text": "लग रहा है लेकिन ग्रोथ स्लो होने के बाद"
    },
    {
      "subtitle_id": 305,
      "start": 633.68,
      "end": 637.44,
      "text": "शायद आपको महंगा लग सकता है। तो सिंपली"
    },
    {
      "subtitle_id": 306,
      "start": 635.839,
      "end": 639.36,
      "text": "अगर आपको बता दूं तो एक दो क्वार्टर का"
    },
    {
      "subtitle_id": 307,
      "start": 637.44,
      "end": 641.12,
      "text": "जरूर इंतजार कीजिए। देखिए कि ये जो"
    },
    {
      "subtitle_id": 308,
      "start": 639.36,
      "end": 643.6,
      "text": "स्लोडाउन अभी आया है गोल्ड सिल्वर की"
    },
    {
      "subtitle_id": 309,
      "start": 641.12,
      "end": 645.36,
      "text": "वोलेटिलिटी में और उसका जो बूंद था वो भी"
    },
    {
      "subtitle_id": 310,
      "start": 643.6,
      "end": 647.2,
      "text": "अभी काफी उसकी बातें हो नहीं रही है आजकल"
    },
    {
      "subtitle_id": 311,
      "start": 645.36,
      "end": 648.959,
      "text": "नहीं तो पहले हर दिन गोल्ड सिल्वर की"
    },
    {
      "subtitle_id": 312,
      "start": 647.2,
      "end": 650.48,
      "text": "बातें हो रही थी तो ऐसे में एक दो"
    },
    {
      "subtitle_id": 313,
      "start": 648.959,
      "end": 652.399,
      "text": "क्वार्टर में भी अगर कंपनी कंटीन्यूअसली"
    },
    {
      "subtitle_id": 314,
      "start": 650.48,
      "end": 654.32,
      "text": "ग्रोथ दिखाती है क्रूड ऑयल के चलते जैसा"
    },
    {
      "subtitle_id": 315,
      "start": 652.399,
      "end": 656.399,
      "text": "कंपनी के मैनेजमेंट का कहना है तो इट विल"
    },
    {
      "subtitle_id": 316,
      "start": 654.32,
      "end": 658.56,
      "text": "बी ग्रेट अदरवाइज फिर शायद आपको [संगीत]"
    },
    {
      "subtitle_id": 317,
      "start": 656.399,
      "end": 660.72,
      "text": "सोच समझ के डिसीजन लेना होगा तो फिलहाल"
    },
    {
      "subtitle_id": 318,
      "start": 658.56,
      "end": 662.72,
      "text": "इतना ही आई होप एमसीx इतना क्यों बढ़ रहा"
    },
    {
      "subtitle_id": 319,
      "start": 660.72,
      "end": 665.12,
      "text": "है आगे बढ़ेगा कि नहीं बढ़ेगा इसका जवाब"
    },
    {
      "subtitle_id": 320,
      "start": 662.72,
      "end": 667.2,
      "text": "अब आपको आसानी से मिल गया होगा इसी तरह के"
    },
    {
      "subtitle_id": 321,
      "start": 665.12,
      "end": 668.88,
      "text": "स्टॉक रिलेटेड वीडियोस के लिए फिनोशंस को"
    },
    {
      "subtitle_id": 322,
      "start": 667.2,
      "end": 671.12,
      "text": "जरूर सब्सक्राइब कीजिए और नेक्स्ट वीडियो"
    },
    {
      "subtitle_id": 323,
      "start": 668.88,
      "end": 672.72,
      "text": "हमें किस स्टॉक पर बनाना चाहिए नीचे कमेंट"
    },
    {
      "subtitle_id": 324,
      "start": 671.12,
      "end": 674.399,
      "text": "करके जरूर बताइए। जिस स्टॉक को सबसे"
    },
    {
      "subtitle_id": 325,
      "start": 672.72,
      "end": 676.24,
      "text": "ज्यादा लाइक आएंगे उसे हम नेक्स्ट वीडियो"
    },
    {
      "subtitle_id": 326,
      "start": 674.399,
      "end": 678.32,
      "text": "में कवर करेंगे। सो सी यू इन द नेक्स्ट"
    },
    {
      "subtitle_id": 327,
      "start": 676.24,
      "end": 680.72,
      "text": "वीडियो। तब तक के लिए बाय-ब और जाते-जाते"
    },
    {
      "subtitle_id": 328,
      "start": 678.32,
      "end": 682.32,
      "text": "कोड एडवाइर्स को जरूर चेक आउट कीजिए। उनकी"
    },
    {
      "subtitle_id": 329,
      "start": 680.72,
      "end": 683.76,
      "text": "फ्री कंसल्टेशन लिंक आपको नीचे"
    },
    {
      "subtitle_id": 330,
      "start": 682.32,
      "end": 685.839,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में मिल"
    },
    {
      "subtitle_id": 331,
      "start": 683.76,
      "end": 685.839,
      "text": "जाएगी।"
    }
  ]
}