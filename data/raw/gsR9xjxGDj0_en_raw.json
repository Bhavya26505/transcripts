  "parsing_issues": [],
  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.0,
      "end": 5.0,
      "text": "टाटा टेक्नोलॉजीज और आईआरडीए की बेहतरीन"
    },
    {
      "subtitle_id": 2,
      "start": 2.12,
      "end": 7.359,
      "text": "लिस्टिंग के बाद अब एक ऐसा आईपीओ आ रहा है"
    },
    {
      "subtitle_id": 3,
      "start": 5.0,
      "end": 10.4,
      "text": "जिस कंपनी ने पिछले 10 साल में कंपाउंडेड"
    },
    {
      "subtitle_id": 4,
      "start": 7.359,
      "end": 12.88,
      "text": "सालाना 123 पर का रेवेन्यू दिखाया है इस"
    },
    {
      "subtitle_id": 5,
      "start": 10.4,
      "end": 15.12,
      "text": "कंपनी का नाम है मुट माइक्रोफिन देखिए"
    },
    {
      "subtitle_id": 6,
      "start": 12.88,
      "end": 17.439,
      "text": "इंडिया में मुट ग्रुप सभी को पता है लेकिन"
    },
    {
      "subtitle_id": 7,
      "start": 15.12,
      "end": 19.32,
      "text": "उस मुट ग्रुप से इस कंपनी का कोई लेना"
    },
    {
      "subtitle_id": 8,
      "start": 17.439,
      "end": 21.16,
      "text": "देना नहीं है हालांकि ये जो कंपनी है उसी"
    },
    {
      "subtitle_id": 9,
      "start": 19.32,
      "end": 23.199,
      "text": "फैमिली से आती है मुथूट फैमिली से जिसके"
    },
    {
      "subtitle_id": 10,
      "start": 21.16,
      "end": 25.039,
      "text": "लिए हमें उनका फैमिली स्ट्रक्चर और उनकी"
    },
    {
      "subtitle_id": 11,
      "start": 23.199,
      "end": 26.76,
      "text": "हिस्ट्री समझनी पड़ेगी थोड़ी बहुत उसके"
    },
    {
      "subtitle_id": 12,
      "start": 25.039,
      "end": 28.64,
      "text": "बाद देखिए कंपनी की अब तक की ग्रोथ बहुत"
    },
    {
      "subtitle_id": 13,
      "start": 26.76,
      "end": 30.279,
      "text": "जबरदस्त रही है लेकिन कंपनी एक ऐसे"
    },
    {
      "subtitle_id": 14,
      "start": 28.64,
      "end": 32.96,
      "text": "सेगमेंट में काम करती है जो बहुत ज्यादा"
    },
    {
      "subtitle_id": 15,
      "start": 30.279,
      "end": 34.36,
      "text": "रिस्की है तो कब तक यह ग्रोथ सस्टेन करेगी"
    },
    {
      "subtitle_id": 16,
      "start": 32.96,
      "end": 36.239,
      "text": "इसका जवाब भी आपको इस वीडियो में मिल"
    },
    {
      "subtitle_id": 17,
      "start": 34.36,
      "end": 38.0,
      "text": "जाएगा साथ ही हम यहां पर बात करेंगे कि"
    },
    {
      "subtitle_id": 18,
      "start": 36.239,
      "end": 39.8,
      "text": "लिस्टिंग गेन के कितने चांसेस हैं और"
    },
    {
      "subtitle_id": 19,
      "start": 38.0,
      "end": 41.68,
      "text": "कंपनी का ओवरऑल वैल्यूएशन कैसा है ओवर"
    },
    {
      "subtitle_id": 20,
      "start": 39.8,
      "end": 43.16,
      "text": "वैल्यूड कंपनी है या फिर अंडर वैल्यूड तो"
    },
    {
      "subtitle_id": 21,
      "start": 41.68,
      "end": 45.84,
      "text": "आज के इस वीडियो में ये सारी चीजें मैं"
    },
    {
      "subtitle_id": 22,
      "start": 43.16,
      "end": 47.32,
      "text": "आपको बहुत आसान भाषा में समझाऊ नमस्कार"
    },
    {
      "subtitle_id": 23,
      "start": 45.84,
      "end": 49.559,
      "text": "मैं प्रसाद आपका आज के इस वीडियो में"
    },
    {
      "subtitle_id": 24,
      "start": 47.32,
      "end": 52.16,
      "text": "स्वागत करता हूं आज से करीब सवा स साल"
    },
    {
      "subtitle_id": 25,
      "start": 49.559,
      "end": 54.399,
      "text": "पहले मुथूट निनान मताई जो कि मुथूट ग्रुप"
    },
    {
      "subtitle_id": 26,
      "start": 52.16,
      "end": 56.8,
      "text": "के फाउंडर हैं वह केरला के कोचेरी में"
    },
    {
      "subtitle_id": 27,
      "start": 54.399,
      "end": 58.8,
      "text": "अनाज बेचने का काम करते थे अब ऐसे में"
    },
    {
      "subtitle_id": 28,
      "start": 56.8,
      "end": 60.92,
      "text": "उनके कई बार कांटेक्ट हो जाते थे फार्मर"
    },
    {
      "subtitle_id": 29,
      "start": 58.8,
      "end": 62.64,
      "text": "से और फिर फार्मर्स की एक बहुत कॉमन"
    },
    {
      "subtitle_id": 30,
      "start": 60.92,
      "end": 64.199,
      "text": "प्रॉब्लम उन्होंने ऑब्जर्व की कई सारे जो"
    },
    {
      "subtitle_id": 31,
      "start": 62.64,
      "end": 66.159,
      "text": "फार्मर्स है और उनके यहां काम करने वाले"
    },
    {
      "subtitle_id": 32,
      "start": 64.199,
      "end": 68.2,
      "text": "लोग हैं वो कुछ सीजन में बहुत अच्छा पैसा"
    },
    {
      "subtitle_id": 33,
      "start": 66.159,
      "end": 70.119,
      "text": "कमाते हैं लेकिन कुछ सीजन में उनके पास"
    },
    {
      "subtitle_id": 34,
      "start": 68.2,
      "end": 71.68,
      "text": "पैसा ही नहीं बचता है तो इसलिए वो कुछ इस"
    },
    {
      "subtitle_id": 35,
      "start": 70.119,
      "end": 73.6,
      "text": "तरह की चीजें देख रहे थे जहां पर वो अपने"
    },
    {
      "subtitle_id": 36,
      "start": 71.68,
      "end": 74.759,
      "text": "पैसे सेविंग के लिए रख सके अब उस जमाने"
    },
    {
      "subtitle_id": 37,
      "start": 73.6,
      "end": 77.08,
      "text": "में बैंक्स के बारे में उतना ज्यादा"
    },
    {
      "subtitle_id": 38,
      "start": 74.759,
      "end": 80.2,
      "text": "अवेयरनेस नहीं था तो इसी अपॉर्चुनिटी का"
    },
    {
      "subtitle_id": 39,
      "start": 77.08,
      "end": 82.799,
      "text": "फायदा लेते हुए मुतु निनान मथाई ने अपने"
    },
    {
      "subtitle_id": 40,
      "start": 80.2,
      "end": 84.759,
      "text": "गांव में एक चीट फंड शुरू किया ताकि लोग"
    },
    {
      "subtitle_id": 41,
      "start": 82.799,
      "end": 86.479,
      "text": "वहां पर पैसे सेव करने लगे इसके लिए"
    },
    {
      "subtitle_id": 42,
      "start": 84.759,
      "end": 88.92,
      "text": "उन्होंने कोरन शरी में ही अपना पहला ऑफिस"
    },
    {
      "subtitle_id": 43,
      "start": 86.479,
      "end": 91.24,
      "text": "सेटअप किया जहां पर लोग आकर अपनी सेविंग"
    },
    {
      "subtitle_id": 44,
      "start": 88.92,
      "end": 92.84,
      "text": "रखते थे यह प्रोजेक्ट बहुत अच्छे से चलने"
    },
    {
      "subtitle_id": 45,
      "start": 91.24,
      "end": 94.2,
      "text": "लगा जिसके बाद उन्होंने इस प्रोजेक्ट को"
    },
    {
      "subtitle_id": 46,
      "start": 92.84,
      "end": 96.479,
      "text": "बहुत एक्सपें किया केरला के अलग-अलग"
    },
    {
      "subtitle_id": 47,
      "start": 94.2,
      "end": 97.68,
      "text": "डिस्ट्रिक्ट्स और अलग-अलग गांव में जिससे"
    },
    {
      "subtitle_id": 48,
      "start": 96.479,
      "end": 99.92,
      "text": "बहुत अच्छा रिस्पांस मिलने के बाद"
    },
    {
      "subtitle_id": 49,
      "start": 97.68,
      "end": 102.399,
      "text": "उन्होंने एक और चीज ऑब्जर्व की कि बहुत"
    },
    {
      "subtitle_id": 50,
      "start": 99.92,
      "end": 104.36,
      "text": "सारे लोग लोन लेना चाहते हैं लेकिन उनके"
    },
    {
      "subtitle_id": 51,
      "start": 102.399,
      "end": 106.24,
      "text": "पास गिरवी रखने के लिए सोने के अलावा कुछ"
    },
    {
      "subtitle_id": 52,
      "start": 104.36,
      "end": 107.96,
      "text": "नहीं है और इसीलिए उन्होंने गोल्ड लोन में"
    },
    {
      "subtitle_id": 53,
      "start": 106.24,
      "end": 110.479,
      "text": "एंटर किया जो उनका एक बहुत बड़ा बिजनेस"
    },
    {
      "subtitle_id": 54,
      "start": 107.96,
      "end": 112.88,
      "text": "आगे चलकर बन गया लेकिन उनकी डेथ के बाद"
    },
    {
      "subtitle_id": 55,
      "start": 110.479,
      "end": 115.68,
      "text": "उनकी जो फैमिली उसमें बंटवारा हुआ देखिए"
    },
    {
      "subtitle_id": 56,
      "start": 112.88,
      "end": 115.68,
      "text": "मुथूट निनान"
    },
    {
      "subtitle_id": 57,
      "start": 117.64,
      "end": 125.64,
      "text": "मिथाईलीन मैथ्यू एम मैथ्यू और मैथ्यू एम"
    },
    {
      "subtitle_id": 58,
      "start": 120.96,
      "end": 125.64,
      "text": "थॉमस यह उनके चार बेटे थे तो मुथूट निनान"
    },
    {
      "subtitle_id": 59,
      "start": 148.76,
      "end": 151.92,
      "text": "मिथाईलीनेडीऑक्सीमीथेंफेटामाइन उनको भी"
    },
    {
      "subtitle_id": 60,
      "start": 150.12,
      "end": 153.8,
      "text": "अपना बिजनेस तेजी से एक्सपें करना था"
    },
    {
      "subtitle_id": 61,
      "start": 151.92,
      "end": 155.92,
      "text": "इसलिए उन्होंने मुथूट पपा चन ग्रुप की"
    },
    {
      "subtitle_id": 62,
      "start": 153.8,
      "end": 158.2,
      "text": "शुरुआत की जहां पर उनका मेन बिजनेस था"
    },
    {
      "subtitle_id": 63,
      "start": 155.92,
      "end": 160.68,
      "text": "गोल्ड लोन का ये जो मुथूट पपा चन ग्रुप"
    },
    {
      "subtitle_id": 64,
      "start": 158.2,
      "end": 163.12,
      "text": "शुरू हुआ ये थिरु अनंतपुरम से हुआ और इनका"
    },
    {
      "subtitle_id": 65,
      "start": 160.68,
      "end": 165.879,
      "text": "जो लोगो रखा गया ये ब्लू कलर में रखा गया"
    },
    {
      "subtitle_id": 66,
      "start": 163.12,
      "end": 167.959,
      "text": "तो ओवरऑल अगर देखें समरी इस चीज की तो वो"
    },
    {
      "subtitle_id": 67,
      "start": 165.879,
      "end": 170.2,
      "text": "ये है कि मुथूट फैमिली से दो बड़े"
    },
    {
      "subtitle_id": 68,
      "start": 167.959,
      "end": 172.64,
      "text": "बिजनेसेस बाहर आए एक मुथूट ग्रुप जो लाल"
    },
    {
      "subtitle_id": 69,
      "start": 170.2,
      "end": 175.36,
      "text": "कलर का लोगो है और दूसरा है मुथूट पापा चन"
    },
    {
      "subtitle_id": 70,
      "start": 172.64,
      "end": 177.76,
      "text": "ग्रुप जो ब्लू कलर का है और जिस कंपनी का"
    },
    {
      "subtitle_id": 71,
      "start": 175.36,
      "end": 180.04,
      "text": "भी आईपीओ आ रहा है यह मुथूट पाचन ग्रुप की"
    },
    {
      "subtitle_id": 72,
      "start": 177.76,
      "end": 182.2,
      "text": "ही कंपनी है तो ये हो गया क्लियर हालाकि"
    },
    {
      "subtitle_id": 73,
      "start": 180.04,
      "end": 184.36,
      "text": "ग्रुप अलग-अलग हो गए लेकिन कुछ जगह पर"
    },
    {
      "subtitle_id": 74,
      "start": 182.2,
      "end": 186.959,
      "text": "इनके फैमिली रिलेशंस काफी अच्छे हैं जैसे"
    },
    {
      "subtitle_id": 75,
      "start": 184.36,
      "end": 189.04,
      "text": "कि इनकी एक बिल्डिंग है जो कोंचे में है"
    },
    {
      "subtitle_id": 76,
      "start": 186.959,
      "end": 190.56,
      "text": "और उस बिल्डिंग में मंडे ट्यूसडे जो"
    },
    {
      "subtitle_id": 77,
      "start": 189.04,
      "end": 192.76,
      "text": "बिजनेस आता है वो सबसे बड़े भाई को जाता"
    },
    {
      "subtitle_id": 78,
      "start": 190.56,
      "end": 195.0,
      "text": "है वेनसडे थर्सडे जो भी बिजनेस आएगा वो"
    },
    {
      "subtitle_id": 79,
      "start": 192.76,
      "end": 196.599,
      "text": "बीच वाले भाई को जाएगा और फिर फ्राइडे और"
    },
    {
      "subtitle_id": 80,
      "start": 195.0,
      "end": 198.72,
      "text": "सैटरडे जो बिजनेस आएगा वो छोटे वाले यानी"
    },
    {
      "subtitle_id": 81,
      "start": 196.599,
      "end": 200.599,
      "text": "ब्लू लोगो वाले भाई के पास चला जाएगा तो"
    },
    {
      "subtitle_id": 82,
      "start": 198.72,
      "end": 202.959,
      "text": "इस तरह से उस बिल्डिंग में जो भी बिजनेस"
    },
    {
      "subtitle_id": 83,
      "start": 200.599,
      "end": 204.68,
      "text": "होता है लोन का या जो भी तीन भाइयों में"
    },
    {
      "subtitle_id": 84,
      "start": 202.959,
      "end": 206.28,
      "text": "इस तरह से डे के हिसाब से उसका रेवेन्यू"
    },
    {
      "subtitle_id": 85,
      "start": 204.68,
      "end": 208.12,
      "text": "का बंटवारा होता है अभी हम अगर फास्ट"
    },
    {
      "subtitle_id": 86,
      "start": 206.28,
      "end": 210.159,
      "text": "फॉरवर्ड अभी की बात करें तो मुठ पाचन"
    },
    {
      "subtitle_id": 87,
      "start": 208.12,
      "end": 213.4,
      "text": "ग्रुप जो है उसका टोटल रेवेन्यू यानी टर्न"
    },
    {
      "subtitle_id": 88,
      "start": 210.159,
      "end": 215.319,
      "text": "ओवर है अराउंड 3400 करोड़ का जिसमें मेन"
    },
    {
      "subtitle_id": 89,
      "start": 213.4,
      "end": 217.04,
      "text": "कंट्रीब्यूशन आता है गोल्ड का अब देखिए"
    },
    {
      "subtitle_id": 90,
      "start": 215.319,
      "end": 219.439,
      "text": "गोल्ड लोन की बात ये तो आप कंफ्यूज मत हो"
    },
    {
      "subtitle_id": 91,
      "start": 217.04,
      "end": 221.76,
      "text": "जाइए क्योंकि जो बड़े भाई का मुथूट ग्रुप"
    },
    {
      "subtitle_id": 92,
      "start": 219.439,
      "end": 224.48,
      "text": "है वो गोल्ड लोन में बहुत बड़ा है पूरी"
    },
    {
      "subtitle_id": 93,
      "start": 221.76,
      "end": 226.439,
      "text": "एनबीएफसी में गोल्ड लोन में मुथूट ग्रुप"
    },
    {
      "subtitle_id": 94,
      "start": 224.48,
      "end": 228.4,
      "text": "के पास यानी जो बड़े भाई है लाल लोगो वाले"
    },
    {
      "subtitle_id": 95,
      "start": 226.439,
      "end": 230.159,
      "text": "उनके पास 46 पर मार्केट शेयर है गोल्ड"
    },
    {
      "subtitle_id": 96,
      "start": 228.4,
      "end": 231.84,
      "text": "गोल्ड लोन का 10000 करोड़ का इनका"
    },
    {
      "subtitle_id": 97,
      "start": 230.159,
      "end": 233.599,
      "text": "रेवेन्यू है तो बड़े भाई का जो बिज़नेस है"
    },
    {
      "subtitle_id": 98,
      "start": 231.84,
      "end": 235.439,
      "text": "वो बहुत बड़ा है कंपेयर्ड टू सबसे छोटे"
    },
    {
      "subtitle_id": 99,
      "start": 233.599,
      "end": 237.079,
      "text": "भाई का तो इसीलिए जो सबसे छोटे भाई हैं"
    },
    {
      "subtitle_id": 100,
      "start": 235.439,
      "end": 238.799,
      "text": "इन्होंने एक चीज ऑब्जर्व की कि हमारा जो"
    },
    {
      "subtitle_id": 101,
      "start": 237.079,
      "end": 240.84,
      "text": "बिजनेस है वो तेजी से नहीं बढ़ रहा है"
    },
    {
      "subtitle_id": 102,
      "start": 238.799,
      "end": 242.72,
      "text": "पिछले 4 साल में में उनका जो ओवरऑल बिजनेस"
    },
    {
      "subtitle_id": 103,
      "start": 240.84,
      "end": 245.319,
      "text": "है पूरे ग्रुप का मुथूट पाप चन ग्रुप का"
    },
    {
      "subtitle_id": 104,
      "start": 242.72,
      "end": 247.72,
      "text": "वो सिर्फ 88.9 पर से बढ़ा है कंपाउंडेड"
    },
    {
      "subtitle_id": 105,
      "start": 245.319,
      "end": 249.72,
      "text": "सालाना जो कि एक यंग कंपनी के लिए काफी कम"
    },
    {
      "subtitle_id": 106,
      "start": 247.72,
      "end": 251.439,
      "text": "ग्रोथ है और इसलिए कुछ साल पहले कंपनी ने"
    },
    {
      "subtitle_id": 107,
      "start": 249.72,
      "end": 253.319,
      "text": "डिसाइड किया कि हम माइक्रो फाइनेंस में"
    },
    {
      "subtitle_id": 108,
      "start": 251.439,
      "end": 255.159,
      "text": "एंटर करेंगे और उनके जो माइक्रो फाइनेंस"
    },
    {
      "subtitle_id": 109,
      "start": 253.319,
      "end": 257.239,
      "text": "की बेट थी यह बहुत सक्सेसफुल साबित हुई"
    },
    {
      "subtitle_id": 110,
      "start": 255.159,
      "end": 261.519,
      "text": "2014 में कंपनी का सिर्फ 50 लाख का"
    },
    {
      "subtitle_id": 111,
      "start": 257.239,
      "end": 263.24,
      "text": "रेवेन्यू था जो कि 2023 आते-आते 696 करोड़"
    },
    {
      "subtitle_id": 112,
      "start": 261.519,
      "end": 264.08,
      "text": "का हुआ है यानी कंपाउंडेड सालानी यह"
    },
    {
      "subtitle_id": 113,
      "start": 263.24,
      "end": 266.759,
      "text": "बिज़नेस"
    },
    {
      "subtitle_id": 114,
      "start": 264.08,
      "end": 268.88,
      "text": "123 से बढ़ा है पिछले 10 सालों में जिसके"
    },
    {
      "subtitle_id": 115,
      "start": 266.759,
      "end": 270.36,
      "text": "चलते अब मुथूट माइक्रो फाइनेंस चौथी सबसे"
    },
    {
      "subtitle_id": 116,
      "start": 268.88,
      "end": 272.44,
      "text": "बड़ी एनबीएफ सी माइक्रो फाइनेंस"
    },
    {
      "subtitle_id": 117,
      "start": 270.36,
      "end": 275.919,
      "text": "इंस्टीट्यूशन कंपनी बन गई है और अब तक"
    },
    {
      "subtitle_id": 118,
      "start": 272.44,
      "end": 277.84,
      "text": "उन्होंने 9208 करोड़ के लोंस लोगों के बीच"
    },
    {
      "subtitle_id": 119,
      "start": 275.919,
      "end": 279.919,
      "text": "बांट दिए हैं अब देखिए आप में से बहुत"
    },
    {
      "subtitle_id": 120,
      "start": 277.84,
      "end": 282.28,
      "text": "सारे लोग पूछते हैं कि जो आईपीओ वीडियो आप"
    },
    {
      "subtitle_id": 121,
      "start": 279.919,
      "end": 284.36,
      "text": "बनाते हैं उसका रिसर्च आप कैसे करते हैं"
    },
    {
      "subtitle_id": 122,
      "start": 282.28,
      "end": 286.36,
      "text": "इंफॉर्मेशन कहां से लाते हैं देखिए अगर"
    },
    {
      "subtitle_id": 123,
      "start": 284.36,
      "end": 288.32,
      "text": "आपको सही से बताऊं तो पहले मैं सारा ये"
    },
    {
      "subtitle_id": 124,
      "start": 286.36,
      "end": 289.919,
      "text": "रिसर्च वगैरह अकेला करता था अब अभी"
    },
    {
      "subtitle_id": 125,
      "start": 288.32,
      "end": 292.039,
      "text": "जैसे-जैसे हम आगे बढ़े हैं हमारी एक"
    },
    {
      "subtitle_id": 126,
      "start": 289.919,
      "end": 294.08,
      "text": "रिसर्च टीम भी है लेकिन फिर भी काफी सारी"
    },
    {
      "subtitle_id": 127,
      "start": 292.039,
      "end": 296.919,
      "text": "इंफॉर्मेशन ऐसी होती है जिसे हमें ढूंढना"
    },
    {
      "subtitle_id": 128,
      "start": 294.08,
      "end": 299.039,
      "text": "नहीं पड़ता वो हमारे पास आ जाती है अब यह"
    },
    {
      "subtitle_id": 129,
      "start": 296.919,
      "end": 301.36,
      "text": "कैसे होता है तो देखिए मेरे जो काफी सारे"
    },
    {
      "subtitle_id": 130,
      "start": 299.039,
      "end": 303.28,
      "text": "फ्रेंड्स है वो इन्वेस्टर है तो जब भी कोई"
    },
    {
      "subtitle_id": 131,
      "start": 301.36,
      "end": 305.16,
      "text": "आईपीओ आता है तो उनके काफी सारे सवाल आते"
    },
    {
      "subtitle_id": 132,
      "start": 303.28,
      "end": 306.96,
      "text": "हैं वैल्यूएशन क्या होगा फ्यूचर"
    },
    {
      "subtitle_id": 133,
      "start": 305.16,
      "end": 308.88,
      "text": "प्रोस्पेक्ट्स क्या है वगैरह वगैरह ऐसा"
    },
    {
      "subtitle_id": 134,
      "start": 306.96,
      "end": 310.639,
      "text": "क्यों ऐसा ही क्यों साथ ही हमारे जो"
    },
    {
      "subtitle_id": 135,
      "start": 308.88,
      "end": 312.56,
      "text": "फाइनेंस क्लब है उसमें काफी सारे सवाल आ"
    },
    {
      "subtitle_id": 136,
      "start": 310.639,
      "end": 314.199,
      "text": "जाते हैं जब भी कोई आईपीओ आ जाता है तो और"
    },
    {
      "subtitle_id": 137,
      "start": 312.56,
      "end": 316.16,
      "text": "साथ ही काफी सारे लोग वहां पर आईपीओ"
    },
    {
      "subtitle_id": 138,
      "start": 314.199,
      "end": 317.84,
      "text": "रिलेटेड ऐसे ऐसी इंफॉर्मेशन शेयर करते हैं"
    },
    {
      "subtitle_id": 139,
      "start": 316.16,
      "end": 319.96,
      "text": "जो काफी यूनिक होती है तो इसीलिए हमें"
    },
    {
      "subtitle_id": 140,
      "start": 317.84,
      "end": 321.919,
      "text": "इंफॉर्मेशन ढूंढनी नहीं पड़ती काफी बार वो"
    },
    {
      "subtitle_id": 141,
      "start": 319.96,
      "end": 323.919,
      "text": "हमारे पास आ जाती है अब पिछले कुछ टाइम से"
    },
    {
      "subtitle_id": 142,
      "start": 321.919,
      "end": 326.039,
      "text": "हमने जो फाइनेंस क्लब है वो सभी के लिए"
    },
    {
      "subtitle_id": 143,
      "start": 323.919,
      "end": 328.12,
      "text": "ओपन किया है यानी आप भी उस फाइनेंस क्लब"
    },
    {
      "subtitle_id": 144,
      "start": 326.039,
      "end": 330.24,
      "text": "में जॉइन कर सकते हैं और जो इंफॉर्मेशन आ"
    },
    {
      "subtitle_id": 145,
      "start": 328.12,
      "end": 332.0,
      "text": "रही है और एक स्मार्ट फ इन्वेस्टर्स की"
    },
    {
      "subtitle_id": 146,
      "start": 330.24,
      "end": 334.16,
      "text": "कम्युनिटी का फायदा ले सकते हैं जहां पर"
    },
    {
      "subtitle_id": 147,
      "start": 332.0,
      "end": 336.24,
      "text": "आईपीओ रिलेटेड सवाल इंफॉर्मेशन तो आपको"
    },
    {
      "subtitle_id": 148,
      "start": 334.16,
      "end": 338.16,
      "text": "मिलेगी ही मिलेगी साथ ही आप अपने सवाल भी"
    },
    {
      "subtitle_id": 149,
      "start": 336.24,
      "end": 339.88,
      "text": "यहां पर पूछ सकते हैं वीकली क्यू एंडडी"
    },
    {
      "subtitle_id": 150,
      "start": 338.16,
      "end": 341.68,
      "text": "सेशन में और क्विज वगैरह काफी सारी"
    },
    {
      "subtitle_id": 151,
      "start": 339.88,
      "end": 343.16,
      "text": "इंटरेस्टिंग चीजें यहां पर चलती रहती है"
    },
    {
      "subtitle_id": 152,
      "start": 341.68,
      "end": 344.52,
      "text": "तो इसका फायदा यह होगा कि आपको हर बार"
    },
    {
      "subtitle_id": 153,
      "start": 343.16,
      "end": 346.639,
      "text": "इंफॉर्मेशन तक नहीं जाना पड़ेगा"
    },
    {
      "subtitle_id": 154,
      "start": 344.52,
      "end": 348.56,
      "text": "इंफॉर्मेशन आप तक आती रहेगी इस क्लब को"
    },
    {
      "subtitle_id": 155,
      "start": 346.639,
      "end": 350.56,
      "text": "जॉइन करने के लिए कुछ खास लंबी प्रोसेस"
    },
    {
      "subtitle_id": 156,
      "start": 348.56,
      "end": 352.36,
      "text": "नहीं है सिंपली आपको एक फ्री डीमेट अकाउंट"
    },
    {
      "subtitle_id": 157,
      "start": 350.56,
      "end": 353.88,
      "text": "ओपन करना है और इस फाइनेंस क्लब को जवाइन"
    },
    {
      "subtitle_id": 158,
      "start": 352.36,
      "end": 355.759,
      "text": "करने की लिंक आपको नीचे डिस्क्रिप्शन और"
    },
    {
      "subtitle_id": 159,
      "start": 353.88,
      "end": 357.72,
      "text": "कमेंट बॉक्स में मिल जाएगी अभी जो मथ"
    },
    {
      "subtitle_id": 160,
      "start": 355.759,
      "end": 359.6,
      "text": "माइक्रो फिन है यह माइक्रो फाइनेंस का"
    },
    {
      "subtitle_id": 161,
      "start": 357.72,
      "end": 361.28,
      "text": "बिजनेस कर रहे हैं इसमें यह लोगों को"
    },
    {
      "subtitle_id": 162,
      "start": 359.6,
      "end": 363.039,
      "text": "छोटे-छोटे लोंस देते हैं पर्टिकुलर इनकी"
    },
    {
      "subtitle_id": 163,
      "start": 361.28,
      "end": 364.44,
      "text": "जो प्रेजेंस है वो रूरल इंडिया में है अब"
    },
    {
      "subtitle_id": 164,
      "start": 363.039,
      "end": 366.759,
      "text": "इसमें एक इंटरेस्टिंग बात यह है कि जो"
    },
    {
      "subtitle_id": 165,
      "start": 364.44,
      "end": 368.68,
      "text": "पूरा मुथूट पचन ग्रुप है इसको मुथूट"
    },
    {
      "subtitle_id": 166,
      "start": 366.759,
      "end": 370.8,
      "text": "माइक्रो फाइनेंस से बहुत फायदा मिलता है"
    },
    {
      "subtitle_id": 167,
      "start": 368.68,
      "end": 372.88,
      "text": "क्योंकि अगर आप ये इस ग्राफ को देखते हैं"
    },
    {
      "subtitle_id": 168,
      "start": 370.8,
      "end": 375.08,
      "text": "तो आपको पता चलेगा कि कि सबसे पहले आपको"
    },
    {
      "subtitle_id": 169,
      "start": 372.88,
      "end": 377.479,
      "text": "लोगों को लोन सिस्टम से जोड़ना है जिसके"
    },
    {
      "subtitle_id": 170,
      "start": 375.08,
      "end": 379.4,
      "text": "लिए आपको छोटे लोन से शुरुआत करनी पड़ेगी"
    },
    {
      "subtitle_id": 171,
      "start": 377.479,
      "end": 381.84,
      "text": "एक बार वह व्यक्ति लोन सिस्टम में आ गया"
    },
    {
      "subtitle_id": 172,
      "start": 379.4,
      "end": 383.68,
      "text": "टाइमली अपना लोन पेमेंट कर रहा है तो उसको"
    },
    {
      "subtitle_id": 173,
      "start": 381.84,
      "end": 385.4,
      "text": "ये लोग बड़े लोंस देने लगते हैं उनको"
    },
    {
      "subtitle_id": 174,
      "start": 383.68,
      "end": 387.4,
      "text": "व्हीकल लोन चाहिए गोल्ड लोन चाहिए तो वो"
    },
    {
      "subtitle_id": 175,
      "start": 385.4,
      "end": 389.72,
      "text": "मुथूट पापा चन ग्रुप की अदर कंपनीज उन्हें"
    },
    {
      "subtitle_id": 176,
      "start": 387.4,
      "end": 391.479,
      "text": "वो प्रोवाइड करती है और उसके बाद अगर उनका"
    },
    {
      "subtitle_id": 177,
      "start": 389.72,
      "end": 393.0,
      "text": "कोई कस्टमर है जो ये सारे लोन सही से चुका"
    },
    {
      "subtitle_id": 178,
      "start": 391.479,
      "end": 394.599,
      "text": "रहा है तो उसको वो हाउसिंग लोन भी देते"
    },
    {
      "subtitle_id": 179,
      "start": 393.0,
      "end": 397.12,
      "text": "हैं तो इस तरह से उन्होंने पूरा एक"
    },
    {
      "subtitle_id": 180,
      "start": 394.599,
      "end": 399.039,
      "text": "इकोसिस्टम बनाया है और जिसका एंट्री पॉइंट"
    },
    {
      "subtitle_id": 181,
      "start": 397.12,
      "end": 401.0,
      "text": "मुत माइक्रो फिन से शुरू होता है ये"
    },
    {
      "subtitle_id": 182,
      "start": 399.039,
      "end": 402.919,
      "text": "माइक्रो फाइनेंस जो सेक्टर है आप कह सकते"
    },
    {
      "subtitle_id": 183,
      "start": 401.0,
      "end": 405.8,
      "text": "हैं कि फाइनेंशियल सर्विसेस इंडस्ट्री का"
    },
    {
      "subtitle_id": 184,
      "start": 402.919,
      "end": 407.639,
      "text": "सबसे हॉटेस्ट सेक्टर है क्योंकि यहां पर"
    },
    {
      "subtitle_id": 185,
      "start": 405.8,
      "end": 409.8,
      "text": "काफी सारी अमेजिंग चीजें चल रही है पिछले"
    },
    {
      "subtitle_id": 186,
      "start": 407.639,
      "end": 411.919,
      "text": "कुछ सालों में यह सेक्टर लगातार 20 पर से"
    },
    {
      "subtitle_id": 187,
      "start": 409.8,
      "end": 413.759,
      "text": "ज्यादा की ग्रोथ दिखा रहा है और इसी का"
    },
    {
      "subtitle_id": 188,
      "start": 411.919,
      "end": 415.56,
      "text": "फायदा कई सारी माइक्रो फाइनेंस कंपनीज को"
    },
    {
      "subtitle_id": 189,
      "start": 413.759,
      "end": 417.56,
      "text": "हो रहा है अगर हम मुथूट माइक्रो फिन की ही"
    },
    {
      "subtitle_id": 190,
      "start": 415.56,
      "end": 422.0,
      "text": "बात करें तो इनका रेवेन्यू फाइनेंशियल"
    },
    {
      "subtitle_id": 191,
      "start": 417.56,
      "end": 424.12,
      "text": "2021 में 696 6 करोड़ था और अब वह 1446"
    },
    {
      "subtitle_id": 192,
      "start": 422.0,
      "end": 425.68,
      "text": "करोड़ पर आया है नेट प्रॉफिट की बात करें"
    },
    {
      "subtitle_id": 193,
      "start": 424.12,
      "end": 428.72,
      "text": "तो पिछले दो सालों में वह कंपाउंडेड"
    },
    {
      "subtitle_id": 194,
      "start": 425.68,
      "end": 430.479,
      "text": "सालाना 382 पर से बढ़ा है और साथ ही अगर"
    },
    {
      "subtitle_id": 195,
      "start": 428.72,
      "end": 432.08,
      "text": "आप कंपनी की नेट इंटरेस्ट मार्जिन देखते"
    },
    {
      "subtitle_id": 196,
      "start": 430.479,
      "end": 434.52,
      "text": "हो जो कि किसी भी लेंडिंग बिजनेस के लिए"
    },
    {
      "subtitle_id": 197,
      "start": 432.08,
      "end": 438.0,
      "text": "बड़ी इंपॉर्टेंट चीज होती है वो भी"
    },
    {
      "subtitle_id": 198,
      "start": 434.52,
      "end": 438.0,
      "text": "कंटीन्यूअसली चेंज हो रही है तो"
    },
    {
      "subtitle_id": 199,
      "start": 448.319,
      "end": 451.879,
      "text": "फाइनेंशियलीईएक्सप्रेस कम होते जा रहे हैं"
    },
    {
      "subtitle_id": 200,
      "start": 450.36,
      "end": 453.599,
      "text": "लेकिन फिर सवाल ये आता है कि क्या ये"
    },
    {
      "subtitle_id": 201,
      "start": 451.879,
      "end": 456.56,
      "text": "इकलौती ऐसी कंपनी है जो पूरे सेक्टर में"
    },
    {
      "subtitle_id": 202,
      "start": 453.599,
      "end": 458.56,
      "text": "बहुत तेजी से ग्रो कर रही है नहीं अगर आप"
    },
    {
      "subtitle_id": 203,
      "start": 456.56,
      "end": 460.599,
      "text": "इस सेक्टर को उठाकर देखते हैं तो लगभग हर"
    },
    {
      "subtitle_id": 204,
      "start": 458.56,
      "end": 463.08,
      "text": "एक कंपनी सेक्टर की इतनी ही तेजी से बढ़"
    },
    {
      "subtitle_id": 205,
      "start": 460.599,
      "end": 465.639,
      "text": "रही है आप क्रेडिट एक्सेस ग्रामीण को देख"
    },
    {
      "subtitle_id": 206,
      "start": 463.08,
      "end": 467.72,
      "text": "लीजिए आप इन स्मॉल फाइनेंस बैंक्स को देख"
    },
    {
      "subtitle_id": 207,
      "start": 465.639,
      "end": 470.319,
      "text": "लीजिए या फिर आप फ्यूजन माइक्रो फाइनेंस"
