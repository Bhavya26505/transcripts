    {
      "subtitle_id": 252,
      "start": 817.72,
      "end": 821.959,
      "text": "ढूंढे हैं मुझे बहुत शॉकिंग लगा कि ऐसा वो"
    },
    {
      "subtitle_id": 253,
      "start": 819.8,
      "end": 824.519,
      "text": "कैसे सारी चीजें किसी और पर थोप सकते हैं"
    },
    {
      "subtitle_id": 254,
      "start": 821.959,
      "end": 826.88,
      "text": "जबकि उनके जो सीएफओ है मधुर देवरा उनका"
    },
    {
      "subtitle_id": 255,
      "start": 824.519,
      "end": 829.68,
      "text": "स्टेटमेंट था स्टेटमेंट ये था कि हम चाहे"
    },
    {
      "subtitle_id": 256,
      "start": 826.88,
      "end": 829.68,
      "text": "तो अपने आईपीओ को"
    },
    {
      "subtitle_id": 257,
      "start": 834.24,
      "end": 840.36,
      "text": "paytm2 पर अपना आईपीओ लाया एंड ठीक है"
    },
    {
      "subtitle_id": 258,
      "start": 837.32,
      "end": 841.92,
      "text": "उसके बाद क्या हुआ वो तो सब को बताए तो एल"
    },
    {
      "subtitle_id": 259,
      "start": 840.36,
      "end": 843.8,
      "text": "का आप ले लीजिए इट वासो क्वाइट ओवर"
    },
    {
      "subtitle_id": 260,
      "start": 841.92,
      "end": 845.32,
      "text": "वैल्यूड जिसके बारे में उसके आईपी वीडियो"
    },
    {
      "subtitle_id": 261,
      "start": 843.8,
      "end": 848.04,
      "text": "में मैंने बात की थी तो यहां पर अगर हम"
    },
    {
      "subtitle_id": 262,
      "start": 845.32,
      "end": 848.04,
      "text": "इसकी भी बात करें"
    },
    {
      "subtitle_id": 263,
      "start": 869.16,
      "end": 872.6,
      "text": "में भी पता चलता है और आने वाले टाइम में"
