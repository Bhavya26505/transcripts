    {
      "subtitle_id": 272,
      "start": 910.519,
      "end": 913.92,
      "text": "का देखना बिकॉज़ अल्टीमेटली धंधा यहीं से"
    },
    {
      "subtitle_id": 273,
      "start": 912.079,
      "end": 915.44,
      "text": "आने वाला है इंडिया में ऑटोमोबाइल का तो"
    },
    {
      "subtitle_id": 274,
      "start": 913.92,
      "end": 916.759,
      "text": "जो भी कार कंपनी में इन्वेस्टमेंट कर रहे"
    },
    {
      "subtitle_id": 275,
      "start": 915.44,
      "end": 919.279,
      "text": "हो टाटा मोट्स में कर रहे हो किसी और में"
    },
    {
      "subtitle_id": 276,
      "start": 916.759,
      "end": 921.12,
      "text": "कर रहे हो मेक श्योर यू आर लुकिंग एट दिस"
