    {
      "subtitle_id": 246,
      "start": 781.399,
      "end": 784.12,
      "text": "से कुछ कंपनीज से"
    },
    {
      "subtitle_id": 247,
      "start": 809.079,
      "end": 812.32,
      "text": "उनके साथ कुछ ना कुछ दिक्कत तो है"
    },
    {
      "subtitle_id": 248,
      "start": 810.279,
      "end": 814.16,
      "text": "वैल्युएशन को लेके अभी मैं रिसेंटली विजय"
    },
    {
      "subtitle_id": 249,
      "start": 812.32,
      "end": 815.88,
      "text": "शेखर शर्मा के क्लिप सुन रहा था जहां पर"
    },
    {
      "subtitle_id": 250,
      "start": 814.16,
      "end": 817.72,
      "text": "वो बोल रहे थे कि हमसे जो गलती हुई है वो"
    },
    {
      "subtitle_id": 251,
      "start": 815.88,
      "end": 819.8,
      "text": "यह है कि हमने गलत इन्वेस्टमेंट बैंकर"
