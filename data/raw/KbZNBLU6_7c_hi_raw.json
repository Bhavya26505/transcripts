      "subtitle_id": 194,
      "start": 671.519,
      "end": 676.0,
      "text": "कोरिया प्रमोटर्स के पास तो यहां से मुझे"
    },
    {
      "subtitle_id": 195,
      "start": 674.04,
      "end": 678.04,
      "text": "तो एक चीज पता चलती है कि इस तरह का बड़ा"
    },
    {
      "subtitle_id": 196,
      "start": 676.0,
      "end": 680.0,
      "text": "डिविडेंड पब्लिक होने से देखिए अगर कंपनी"
    },
    {
      "subtitle_id": 197,
      "start": 678.04,
      "end": 682.04,
      "text": "बड़ा डिविडेंड ना देती तो ये जो पैसा था"
    },
    {
      "subtitle_id": 198,
      "start": 680.0,
      "end": 683.959,
      "text": "जो कंपनी डिविडेंड ना देती तो कंपनी कंपनी"
    },
    {
      "subtitle_id": 199,
      "start": 682.04,
      "end": 685.639,
      "text": "के रिजर्व्स में आपको दिखता जिससे कंपनी"
    },
    {
      "subtitle_id": 200,
      "start": 683.959,
      "end": 688.279,
      "text": "की बैलेंस शीट स्ट्रांग दिखती कंपनी के"
    },
    {
      "subtitle_id": 201,
      "start": 685.639,
      "end": 690.399,
      "text": "फंडामेंटल्स और स्ट्रांग दिखते ठीक है और"
    },
    {
      "subtitle_id": 202,
      "start": 688.279,
      "end": 692.16,
      "text": "वो वो पैसा फिर कंपनी शायद यू नो"
    },
    {
      "subtitle_id": 203,
      "start": 690.399,
      "end": 693.8,
      "text": "एक्सपेंशन के लिए यूज़ कर पाती फ्यूचर में"
    },
    {
      "subtitle_id": 204,
      "start": 692.16,
      "end": 695.519,
      "text": "लेकिन पूरा का पूरा तो इन्होंने हटा दिया"
    },
    {
      "subtitle_id": 205,
      "start": 693.8,
      "end": 698.0,
      "text": "साथ ही आईपीओ से आने वाली जो प्रोसीडिंग्स"
    },
    {
      "subtitle_id": 206,
      "start": 695.519,
      "end": 700.8,
      "text": "हैं वो भी उन्होंने दे दी देखिए कंपनी का"
    },
    {
      "subtitle_id": 207,
      "start": 698.0,
      "end": 703.399,
      "text": "कर्जा भी लिमिट में है कंपनी का आरओ ले लो"
    },
    {
      "subtitle_id": 208,
      "start": 700.8,
      "end": 704.88,
      "text": "आप आरवी ले लो सीएफओ ले लो सारी चीजें"
    },
    {
      "subtitle_id": 209,
      "start": 703.399,
      "end": 706.76,
      "text": "स्ट्रांग है इन्होंने अपना कर्जा जो है"
