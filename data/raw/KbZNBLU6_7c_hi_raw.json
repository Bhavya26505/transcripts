    {
      "subtitle_id": 277,
      "start": 919.279,
      "end": 922.88,
      "text": "टू डेटा पॉइंट्स एस में मार्केट शेयर कम"
    },
    {
      "subtitle_id": 278,
      "start": 921.12,
      "end": 924.44,
      "text": "हो रहा है कि बढ़ रहा है और दूसरी चीज"
    },
    {
      "subtitle_id": 279,
      "start": 922.88,
      "end": 925.759,
      "text": "इलेक्ट्रिक मोबिलिटी में उनका इलेक्ट्रिक"
    },
    {
      "subtitle_id": 280,
      "start": 924.44,
      "end": 927.079,
      "text": "व्हीकल्स में भी मार्केट शेयर कम हो रहा"
    },
    {
      "subtitle_id": 281,
      "start": 925.759,
      "end": 929.04,
      "text": "है कि बढ़ रहा है तो क्वांटिटी वाइज भी"
    },
    {
      "subtitle_id": 282,
      "start": 927.079,
      "end": 930.56,
      "text": "देखो मार्केट शेयर वाइज भी देखो काफी बेट"
    },
    {
      "subtitle_id": 283,
      "start": 929.04,
      "end": 932.16,
      "text": "क्लेरिटी आपको आ जाएगी तो आशा करता हूं कि"
    },
    {
      "subtitle_id": 284,
      "start": 930.56,
      "end": 934.079,
      "text": "आपके सारे डाउट्स जो मैंने प्रॉमिस किया"
    },
    {
      "subtitle_id": 285,
      "start": 932.16,
      "end": 935.519,
      "text": "था आपको एट द स्टार्ट ऑफ वीडियो वो क्लियर"
    },
    {
      "subtitle_id": 286,
      "start": 934.079,
      "end": 937.0,
      "text": "हो चुके होंगे अब आप क्या क्या कहना है"
    },
    {
      "subtitle_id": 287,
      "start": 935.519,
      "end": 938.759,
      "text": "नीचे कमेंट करके जरूर बताइए लेकिन एक"
    },
    {
      "subtitle_id": 288,
      "start": 937.0,
      "end": 940.639,
      "text": "शॉकिंग चीज आपको बताता हूं लिस्टिंग गेन"
    },
