    {
      "subtitle_id": 213,
      "start": 709.88,
      "end": 713.519,
      "text": "बाकी ऑटोमोबाइल कंपनी और डिविडेंड पेआउट"
    },
    {
      "subtitle_id": 214,
      "start": 711.6,
      "end": 716.519,
      "text": "रेशियो से इसे कंपेयर करते हैं तो बाकी"
    },
    {
      "subtitle_id": 215,
      "start": 713.519,
      "end": 716.519,
      "text": "वालों का देखिए आप और"
    },
    {
      "subtitle_id": 216,
      "start": 719.24,
      "end": 722.279,
      "text": "तो हो गया मैनेजमेंट के बारे में कि शायद"
    },
    {
      "subtitle_id": 217,
      "start": 720.6,
      "end": 724.36,
      "text": "उनको इंडियन मार्केट में कुछ खास रुचि"
    },
    {
      "subtitle_id": 218,
      "start": 722.279,
      "end": 726.279,
      "text": "मुझे नहीं लग रही है सो मे बी दे कुड बी"
    },
    {
      "subtitle_id": 219,
      "start": 724.36,
      "end": 728.079,
      "text": "फोकसिंग ऑन सम अदर मार्केट्स तो उसके लिए"
    },
    {
      "subtitle_id": 220,
      "start": 726.279,
      "end": 730.2,
      "text": "पैसा निकाल के जा रहे हो और शायद कई और पे"
    },
    {
      "subtitle_id": 221,
      "start": 728.079,
      "end": 731.8,
      "text": "इन्वेस्ट कर रहे हैं ऐसा तो मतलब मोटा"
    },
    {
      "subtitle_id": 222,
      "start": 730.2,
      "end": 733.279,
      "text": "मोटी मुझे तो लग ही रहा है क्योंकि बहुत"
    },
    {
      "subtitle_id": 223,
      "start": 731.8,
      "end": 734.6,
      "text": "ही हाइपर कंपीटेटिव मार्केट हो रहा है"
    },
    {
      "subtitle_id": 224,
      "start": 733.279,
      "end": 737.48,
      "text": "उसमें आप इस तरह का बिहेवियर करेंगे तो"
    },
    {
      "subtitle_id": 225,
      "start": 734.6,
      "end": 739.199,
      "text": "मुझे नहीं लगता कि आप जो आपके पास अभी 14"
    },
    {
      "subtitle_id": 226,
      "start": 737.48,
      "end": 741.279,
      "text": "15 पर का मार्केट शेयर है वो भी टिका"
    },
    {
      "subtitle_id": 227,
      "start": 739.199,
      "end": 742.839,
      "text": "पाएंगे दैट कुड बी वेरी चैलेंजिंग तो चलिए"
    },
    {
      "subtitle_id": 228,
      "start": 741.279,
      "end": 744.36,
      "text": "लिस्टिंग गेन की पहले बात करते हैं उसके"
    },
    {
      "subtitle_id": 229,
      "start": 742.839,
      "end": 746.199,
      "text": "बाद में वैल्यूएशन की डिटेल में बात करता"
    },
    {
      "subtitle_id": 230,
      "start": 744.36,
      "end": 750.16,
      "text": "हूं तो कंपनी का जो आईपीओ आ रहा है उसका"
    },
    {
      "subtitle_id": 231,
      "start": 746.199,
      "end": 752.199,
      "text": "जो प्राइस बैंड है वो है ₹1 65 टू 19 ₹10"
    },
    {
      "subtitle_id": 232,
      "start": 750.16,
      "end": 754.04,
      "text": "सात शेयर एक लॉट में रहेंगे अगर मैं ग्रे"
    },
    {
      "subtitle_id": 233,
      "start": 752.199,
      "end": 756.04,
      "text": "मार्केट प्रीमियम की बात करूं तो करेंटली"
    },
    {
      "subtitle_id": 234,
      "start": 754.04,
      "end": 758.0,
      "text": "वीडियो रिकॉर्ड करते टाइम वो ₹ 774 के"
    },
    {
      "subtitle_id": 235,
      "start": 756.04,
      "end": 759.92,
      "text": "करीब चल रहा है यानी कि अगर मैं मान लेता"
    },
    {
      "subtitle_id": 236,
      "start": 758.0,
      "end": 762.12,
      "text": "हूं कि ₹ 774 का आपको लिस्टिंग गन मिलता"
    },
    {
      "subtitle_id": 237,
      "start": 759.92,
      "end": 763.68,
      "text": "है तो 3 पर प्रॉफिट के बराबर हो जाता है"
    },
    {
      "subtitle_id": 238,
      "start": 762.12,
      "end": 765.8,
      "text": "अब ये ग्रे मार्केट प्रीमियम इतना कम"
    },
    {
      "subtitle_id": 239,
      "start": 763.68,
      "end": 767.32,
      "text": "क्यों है तो उसे भी आपको समझना पड़ेगा तो"
    },
    {
      "subtitle_id": 240,
      "start": 765.8,
      "end": 769.04,
      "text": "यहां पर आप देख सकते हो कि कंपनी का जो"
    },
    {
      "subtitle_id": 241,
      "start": 767.32,
      "end": 771.48,
      "text": "वैल्यूएशन है पी रेशो कंपनी ने रखा है वो"
    },
    {
      "subtitle_id": 242,
      "start": 769.04,
      "end": 773.32,
      "text": "रखा है 26 का जिसे अगर हम बाकी ऑटोमोबिल"
    },
    {
      "subtitle_id": 243,
      "start": 771.48,
      "end": 776.44,
      "text": "कंपनी से कंपेयर करेंगे तो आपको लगेगा ये"
