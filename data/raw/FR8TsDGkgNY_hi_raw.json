  "segments": [
    {
      "subtitle_id": 1,
      "start": 3.84,
      "end": 8.719,
      "text": "हम सबने शॉक टैंक शो तो देखी है जहां पर"
    },
    {
      "subtitle_id": 2,
      "start": 6.2,
      "end": 10.719,
      "text": "स्टार्टअप्स आती है और जजेस के सामने अपने"
    },
    {
      "subtitle_id": 3,
      "start": 8.719,
      "end": 12.639,
      "text": "प्रोडक्ट्स और सर्विसेस का पीज देती है"
    },
    {
      "subtitle_id": 4,
      "start": 10.719,
      "end": 14.719,
      "text": "उनके पीज के बाद स्टार्टअप के फाउंडर्स और"
    },
    {
      "subtitle_id": 5,
      "start": 12.639,
      "end": 16.6,
      "text": "जजेस के बीच क्यू एंड ए होता है और एंड"
    },
    {
      "subtitle_id": 6,
      "start": 14.719,
      "end": 18.6,
      "text": "में जजेस या तो इन्वेस्टमेंट ऑफर करते हैं"
    },
    {
      "subtitle_id": 7,
      "start": 16.6,
      "end": 20.88,
      "text": "या फिर कहते हैं मुझे नहीं लगता है कि आज"
    },
    {
      "subtitle_id": 8,
      "start": 18.6,
      "end": 22.8,
      "text": "मैं आपके साथ जुड़ पाऊंगा सो आई एम आउट और"
    },
    {
      "subtitle_id": 9,
      "start": 20.88,
      "end": 24.72,
      "text": "जजेस की बात करें तो यह खुद फाउंडर्स होते"
    },
    {
      "subtitle_id": 10,
      "start": 22.8,
      "end": 26.76,
      "text": "हैं सालों का तजुर्बा और सारे जजेस"
    },
    {
      "subtitle_id": 11,
      "start": 24.72,
      "end": 28.439,
      "text": "बिल्कुल शार्प और बिजनेस माइंडेड होते हैं"
    },
    {
      "subtitle_id": 12,
      "start": 26.76,
      "end": 30.679,
      "text": "जो भी होता है स्ट्रेट फॉरवर्ड बातें करते"
    },
    {
      "subtitle_id": 13,
      "start": 28.439,
      "end": 32.84,
      "text": "हैं नो दोगलापन पर अगर मैं आपसे कहूं कि"
    },
    {
      "subtitle_id": 14,
      "start": 30.679,
      "end": 34.559,
      "text": "आप भी शॉक टैंक वाली कुर्सी पर बैठकर अपने"
    },
    {
      "subtitle_id": 15,
      "start": 32.84,
      "end": 36.2,
      "text": "एनालिसिस के दम पर ऐसे स्टार्टअप्स और"
    },
    {
      "subtitle_id": 16,
      "start": 34.559,
      "end": 38.32,
      "text": "अनलिस्टेड कंपनीज में इन्वेस्ट कर सकते"
    },
    {
      "subtitle_id": 17,
      "start": 36.2,
      "end": 40.2,
      "text": "हैं तो क्या आप बिलीव करेंगे कि यह पॉसिबल"
    },
    {
      "subtitle_id": 18,
      "start": 38.32,
      "end": 42.8,
      "text": "है तो मैं आपको बताना चाहूंगा यस इट्स"
    },
    {
      "subtitle_id": 19,
      "start": 40.2,
      "end": 45.079,
      "text": "पॉसिबल पर कैसे तो आज के इस वीडियो में"
    },
    {
      "subtitle_id": 20,
      "start": 42.8,
      "end": 47.079,
      "text": "डिटेल में इस टॉपिक पर हम बात करेंगे और"
    },
    {
      "subtitle_id": 21,
      "start": 45.079,
      "end": 49.0,
      "text": "इसी के साथ कुछ इंपॉर्टेंट क्वेश्चंस जैसे"
    },
    {
      "subtitle_id": 22,
      "start": 47.079,
      "end": 51.079,
      "text": "कि कैसे इन कंपनीज में इन्वेस्ट करें क्या"
    },
    {
      "subtitle_id": 23,
      "start": 49.0,
      "end": 53.039,
      "text": "डिफरेंट वेज है और कोई प्लेटफॉर्म इन सब"
    },
    {
      "subtitle_id": 24,
      "start": 51.079,
      "end": 54.719,
      "text": "में इन्वेस्ट करने के लिए दूसरा इसी के"
    },
    {
      "subtitle_id": 25,
      "start": 53.039,
      "end": 56.28,
      "text": "साथ अनलिस्टेड कंपनीज में इन्वेस्ट करने"
    },
    {
      "subtitle_id": 26,
      "start": 54.719,
      "end": 58.76,
      "text": "के रिस्क और रिटर्न फैक्टर की भी बात"
    },
    {
      "subtitle_id": 27,
      "start": 56.28,
      "end": 60.44,
      "text": "करेंगे और तीसरा यह भी देखेंगे कि"
    },
    {
      "subtitle_id": 28,
      "start": 58.76,
      "end": 62.16,
      "text": "अनलिस्टेड कंपनीज में इन्वेस्टेड एक"
    },
    {
      "subtitle_id": 29,
      "start": 60.44,
      "end": 64.559,
      "text": "लिस्टेड कंपनी में इन्वेस्ट करने से कितना"
    },
    {
      "subtitle_id": 30,
      "start": 62.16,
      "end": 66.04,
      "text": "डिफरेंट होता है सो लेट्स स्टार्ट नमस्कार"
    },
    {
      "subtitle_id": 31,
      "start": 64.559,
      "end": 67.439,
      "text": "मैं प्रसाद आपका आज के इस वीडियो में"
    },
    {
      "subtitle_id": 32,
      "start": 66.04,
      "end": 69.28,
      "text": "स्वागत करता हूं आज के इस वीडियो के"
    },
    {
      "subtitle_id": 33,
      "start": 67.439,
      "end": 71.119,
      "text": "प्रायोजक है इंक्रेड मनी जिनके बारे में"
    },
    {
      "subtitle_id": 34,
      "start": 69.28,
      "end": 72.68,
      "text": "हम वीडियो में आगे बात करेंगे तो सबसे"
    },
    {
      "subtitle_id": 35,
      "start": 71.119,
      "end": 74.36,
      "text": "पहला क्वेश्चन यह है कि जो स्टार्टअप्स है"
    },
    {
      "subtitle_id": 36,
      "start": 72.68,
      "end": 76.52,
      "text": "और अनलिस्टेड कंपनीज हैं उनमें इन्वेस्ट"
    },
    {
      "subtitle_id": 37,
      "start": 74.36,
      "end": 78.24,
      "text": "कैसे करें तो इसके मेजर्ली तीन तरीके हैं"
    },
    {
      "subtitle_id": 38,
      "start": 76.52,
      "end": 80.0,
      "text": "पहला तो आप कंपनी के फाउंडर से डायरेक्टली"
    },
    {
      "subtitle_id": 39,
      "start": 78.24,
      "end": 81.759,
      "text": "कनेक्ट कर सकते हैं अगर आप उन्हें पहले से"
    },
    {
      "subtitle_id": 40,
      "start": 80.0,
      "end": 83.96,
      "text": "ही जानते हैं पहले से ही कनेक्शन है तो उस"
    },
    {
      "subtitle_id": 41,
      "start": 81.759,
      "end": 85.56,
      "text": "तरह से या फिर मेल या सोशल मीडिया चैनल से"
    },
    {
      "subtitle_id": 42,
      "start": 83.96,
      "end": 87.52,
      "text": "लेकिन ये जो पहला तरीका है ये बहुत ही कम"
    },
    {
      "subtitle_id": 43,
      "start": 85.56,
      "end": 89.32,
      "text": "टाइम काम में आता है अब बढ़ते हैं दूसरे"
    },
    {
      "subtitle_id": 44,
      "start": 87.52,
      "end": 91.04,
      "text": "तरीके की तरफ दूसरा तरीका है आप उन"
    },
    {
      "subtitle_id": 45,
      "start": 89.32,
      "end": 93.84,
      "text": "अनलिस्टेड और स्टार्टअप्स के एंप्लॉयज से"
    },
    {
      "subtitle_id": 46,
      "start": 91.04,
      "end": 95.799,
      "text": "ॉ खरीद सकते हो सॉप्स यानी एंप्लॉई स्टॉक"
    },
    {
      "subtitle_id": 47,
      "start": 93.84,
      "end": 97.56,
      "text": "ओनरशिप प्लांस ये वो स्टॉक्स हैं जो"
    },
    {
      "subtitle_id": 48,
      "start": 95.799,
      "end": 99.64,
      "text": "स्टार्टअप्स अपने एंप्लॉयज को देती है और"
    },
    {
      "subtitle_id": 49,
      "start": 97.56,
      "end": 102.04,
      "text": "ये ऑप्स ये एंप्लॉयज जनरली तब रिडीम करते"
    },
    {
      "subtitle_id": 50,
      "start": 99.64,
      "end": 104.2,
      "text": "हैं जब इस कंपनी का आईपीओ आता है यहां कुछ"
    },
    {
      "subtitle_id": 51,
      "start": 102.04,
      "end": 106.68,
      "text": "एजेंट्स भी होते हैं जो आपको ओवर द काउंटर"
    },
    {
      "subtitle_id": 52,
      "start": 104.2,
      "end": 108.159,
      "text": "सॉप्स ट्रेड करने में मदद करते हैं ये दो"
    },
    {
      "subtitle_id": 53,
      "start": 106.68,
      "end": 109.64,
      "text": "तरीके तो हैं लेकिन इनमें बहुत बड़े"
    },
    {
      "subtitle_id": 54,
      "start": 108.159,
      "end": 111.6,
      "text": "प्रॉब्लम्स हैं और जो बड़े-बड़े हाई"
    },
    {
      "subtitle_id": 55,
      "start": 109.64,
      "end": 113.479,
      "text": "नेटवर्क इन्वेस्टर्स हैं उनके लिए ज्यादा"
    },
    {
      "subtitle_id": 56,
      "start": 111.6,
      "end": 115.36,
      "text": "सूटेबल है जो करोड़ों का इन्वेस्टमेंट"
    },
    {
      "subtitle_id": 57,
      "start": 113.479,
      "end": 117.719,
      "text": "करना चाहते हैं बाकी के लिए इतना अच्छा और"
    },
    {
      "subtitle_id": 58,
      "start": 115.36,
      "end": 119.92,
      "text": "कारगर तरीका नहीं है और इसलिए एक तीसरा"
    },
    {
      "subtitle_id": 59,
      "start": 117.719,
      "end": 121.88,
      "text": "तरीका भी है और मेरे हिसाब से यह तरीका"
    },
    {
      "subtitle_id": 60,
      "start": 119.92,
      "end": 123.2,
      "text": "ज्यादातर लोगों के लिए काफी आसान भी है"
    },
    {
      "subtitle_id": 61,
      "start": 121.88,
      "end": 124.92,
      "text": "बहुत सारे प्लेटफॉर्म है जो आपको"
    },
    {
      "subtitle_id": 62,
      "start": 123.2,
      "end": 126.399,
      "text": "अनलिस्टेड कंपनी और स्टार्टअप्स खरीदने"
    },
    {
      "subtitle_id": 63,
      "start": 124.92,
      "end": 128.72,
      "text": "में मदद करते हैं और इनमें से एक है"
    },
    {
      "subtitle_id": 64,
      "start": 126.399,
      "end": 130.44,
      "text": "इंक्रेड मनी ये इंक्रेड ग्रुप की एक कंपनी"
    },
    {
      "subtitle_id": 65,
      "start": 128.72,
      "end": 132.28,
      "text": "है जिसका इनग्रेड मनी प्लेटफॉर्म आपको"
    },
    {
      "subtitle_id": 66,
      "start": 130.44,
      "end": 133.959,
      "text": "स्टार्टअप्स में और प्री आईपीओ शेयर्स में"
    },
    {
      "subtitle_id": 67,
      "start": 132.28,
      "end": 136.04,
      "text": "इन्वेस्ट करने की फैसिलिटी प्रोवाइड करता"
    },
    {
      "subtitle_id": 68,
      "start": 133.959,
      "end": 137.56,
      "text": "है और अब हमने पहले दो तारीखों में देखा"
    },
    {
      "subtitle_id": 69,
      "start": 136.04,
      "end": 139.72,
      "text": "कि इन्वेस्ट करने के लिए आपको बहुत बड़ी"
    },
    {
      "subtitle_id": 70,
      "start": 137.56,
      "end": 141.8,
      "text": "अमाउंट चाहिए वही इस प्लेटफॉर्म पर आप"
    },
    {
      "subtitle_id": 71,
      "start": 139.72,
      "end": 143.48,
      "text": "मात्र एक शेयर भी इन्वेस्ट कर सकते हैं और"
    },
    {
      "subtitle_id": 72,
      "start": 141.8,
      "end": 145.92,
      "text": "इस स्क्रीन पर आप देख सकते हो मिनिस्ट्री"
    },
    {
      "subtitle_id": 73,
      "start": 143.48,
      "end": 148.0,
      "text": "ऑफ कॉरपोरेशन यानी एमसीए की रूलिंग है कि"
    },
    {
      "subtitle_id": 74,
      "start": 145.92,
      "end": 150.0,
      "text": "सारी बड़ी अनलिस्टेड कंपनीज को अब अपने"
    },
    {
      "subtitle_id": 75,
      "start": 148.0,
      "end": 151.959,
      "text": "शेयर्स डी मटेरियल फॉर्म में रखने होंगे"
    },
    {
      "subtitle_id": 76,
      "start": 150.0,
      "end": 153.879,
      "text": "मतलब आप जो यह शेयर्स खरीदेंगे वो डी"
    },
    {
      "subtitle_id": 77,
      "start": 151.959,
      "end": 156.0,
      "text": "मटेरियल फॉर्म में होंगे ना कि फिजिकल"
    },
    {
      "subtitle_id": 78,
      "start": 153.879,
      "end": 157.4,
      "text": "पेपर में और यह शेयर्स आपके डीमेट अकाउंट"
    },
    {
      "subtitle_id": 79,
      "start": 156.0,
      "end": 159.239,
      "text": "में भी रिफ्लेक्ट होंगे और साथ ही इस"
    },
    {
      "subtitle_id": 80,
      "start": 157.4,
      "end": 161.239,
      "text": "प्लेटफॉर्म में आपको ढेरों सारी कंपनीज"
    },
    {
      "subtitle_id": 81,
      "start": 159.239,
      "end": 163.519,
      "text": "में इन्वेस्ट करने का मौका मिलेगा जैसे कि"
    },
    {
      "subtitle_id": 82,
      "start": 161.239,
      "end": 165.959,
      "text": "बोट जो कि अमन गुप्ता की कंपनी है चेन्नई"
    },
    {
      "subtitle_id": 83,
      "start": 163.519,
      "end": 167.8,
      "text": "सुपर किंग्स केयर हेल्थ इंश्योरेंस स्विगी"
    },
    {
      "subtitle_id": 84,
      "start": 165.959,
      "end": 169.959,
      "text": "और भी ढेरों सारी कंपनीज आपको यहां पर मिल"
    },
    {
      "subtitle_id": 85,
      "start": 167.8,
      "end": 171.8,
      "text": "जाएगी तो अब एक बेसिक एनालिसिस करते हैं"
    },
    {
      "subtitle_id": 86,
      "start": 169.959,
      "end": 174.12,
      "text": "तो लेट्स सिलेक्ट इमेजिन मार्केटिंग जो कि"
    },
    {
      "subtitle_id": 87,
      "start": 171.8,
      "end": 175.959,
      "text": "बोट की पैरेंट कंपनी है स्क्रीन पर आप देख"
    },
    {
      "subtitle_id": 88,
      "start": 174.12,
      "end": 178.8,
      "text": "सकते हो करेंटली कंपनी का जो एक शेयर है"
    },
    {
      "subtitle_id": 89,
      "start": 175.959,
      "end": 181.68,
      "text": "वो ₹1 70 पर ट्रेड हो रहा है जो कि 2 साल"
    },
    {
      "subtitle_id": 90,
      "start": 178.8,
      "end": 183.28,
      "text": "पहले 7 ₹ 775 का था फंडामेंटल्स में आपको"
    },
    {
      "subtitle_id": 91,
      "start": 181.68,
      "end": 186.44,
      "text": "इसका नीचे डाटा भी मिल जाएगा जैसे मार्केट"
    },
    {
      "subtitle_id": 92,
      "start": 183.28,
      "end": 188.76,
      "text": "कैपिटेशन चल रहा है 14126 करोड़ का पी"
    },
    {
      "subtitle_id": 93,
      "start": 186.44,
      "end": 190.36,
      "text": "रेशो चल रहा है 140 का इसके अलावा आप"
    },
    {
      "subtitle_id": 94,
      "start": 188.76,
      "end": 193.959,
      "text": "कंपनी के रेवेन्यू भी यहां पर देख सकते हो"
    },
    {
      "subtitle_id": 95,
      "start": 190.36,
      "end": 197.08,
      "text": "कि 2019 में 239 करोड़ का था जो 2023 तक"
    },
    {
      "subtitle_id": 96,
      "start": 193.959,
      "end": 199.4,
      "text": "बढ़कर 3376 करोड़ पर आ चुका है प्रॉफिट की"
    },
    {
      "subtitle_id": 97,
      "start": 197.08,
      "end": 201.799,
      "text": "बात करें तो 2022 तक वो बढ़ा लेकिन 2023"
    },
    {
      "subtitle_id": 98,
      "start": 199.4,
      "end": 203.12,
      "text": "में 129 करोड़ का लॉस कंपनी को हुआ है बोट"
    },
    {
      "subtitle_id": 99,
      "start": 201.799,
      "end": 206.879,
      "text": "के अलावा इस प्लेटफॉर्म पर जो लेटेस्ट"
    },
    {
      "subtitle_id": 100,
      "start": 203.12,
      "end": 206.879,
      "text": "एंट्री है वो स्विग की है फिलहाल"
    },
    {
      "subtitle_id": 101,
      "start": 209.76,
      "end": 212.76,
      "text": "जो मिनिमम रिक्वायरमेंट है इन्वेस्टमेंट"
    },
    {
      "subtitle_id": 102,
      "start": 211.04,
      "end": 214.36,
      "text": "की स्विगी के लिए वो थोड़ी ज्यादा है तो"
    },
    {
      "subtitle_id": 103,
      "start": 212.76,
      "end": 216.12,
      "text": "ये सब डाटा आपको देखने मिलता है तो आपका"
    },
    {
      "subtitle_id": 104,
      "start": 214.36,
      "end": 218.2,
      "text": "यहां पर काम ये आ जाता है कि अपना जो"
    },
    {
      "subtitle_id": 105,
      "start": 216.12,
      "end": 220.08,
      "text": "फंडामेंटल एनालिसिस है वो आपको यहां पर"
    },
    {
      "subtitle_id": 106,
      "start": 218.2,
      "end": 222.159,
      "text": "अप्लाई करना है कि कंपनी का वैल्यूएशन सही"
    },
    {
      "subtitle_id": 107,
      "start": 220.08,
      "end": 224.2,
      "text": "है या नहीं वो अंडर वैल्यूड है या फिर ओवर"
    },
    {
      "subtitle_id": 108,
      "start": 222.159,
      "end": 225.799,
      "text": "वैल्यूड है कंपनी का बिजनेस कैसा है नेट"
    },
    {
      "subtitle_id": 109,
      "start": 224.2,
      "end": 227.36,
      "text": "प्रॉफिट मार्जिंस कैसे हैं ये सारी चीजें"
    },
    {
      "subtitle_id": 110,
      "start": 225.799,
      "end": 229.04,
      "text": "आप यहां पर इजली देख सकते हो तो जो"
    },
    {
      "subtitle_id": 111,
      "start": 227.36,
      "end": 230.68,
      "text": "अनलिस्टेड स्टॉक्स इनके प्लेटफॉर्म पर है"
    },
    {
      "subtitle_id": 112,
      "start": 229.04,
      "end": 232.239,
      "text": "उनकी सारी इंफॉर्मेशन आपको यहां पर मिल"
    },
    {
      "subtitle_id": 113,
      "start": 230.68,
      "end": 233.56,
      "text": "जाएगी तो अगर आप इंटरेस्टेड है तो इसकी"
    },
    {
      "subtitle_id": 114,
      "start": 232.239,
      "end": 235.48,
      "text": "लिंक आपको नीचे डिस्क्रिप्शन और कमेंट"
    },
    {
      "subtitle_id": 115,
      "start": 233.56,
      "end": 237.64,
      "text": "बॉक्स में मिल जाएगी और हां अगर आप नीचे"
    },
    {
      "subtitle_id": 116,
      "start": 235.48,
      "end": 240.28,
      "text": "दी हुई लिंक से क्लिक करके खरीदते हो तो"
    },
    {
      "subtitle_id": 117,
      "start": 237.64,
      "end": 242.519,
      "text": "आपको पर ऑर्डर 25 पर का डिस्काउंट भी"
    },
    {
      "subtitle_id": 118,
      "start": 240.28,
      "end": 244.0,
      "text": "मिलेगा तो ये थे तीन तरीके जिससे आप किसी"
    },
    {
      "subtitle_id": 119,
      "start": 242.519,
      "end": 246.079,
      "text": "भी स्टार्टअप या अनलिस्टेड कंपनीज में"
    },
    {
      "subtitle_id": 120,
      "start": 244.0,
      "end": 247.519,
      "text": "इन्वेस्ट कर सकते हो अब बात करते हैं इन"
    },
    {
      "subtitle_id": 121,
      "start": 246.079,
      "end": 249.2,
      "text": "कंपनीज में इन्वेस्ट करने की रिस्क"
    },
    {
      "subtitle_id": 122,
      "start": 247.519,
      "end": 250.799,
      "text": "फैक्टर्स के बारे में और रिवॉर्ड फैक्टर्स"
    },
    {
      "subtitle_id": 123,
      "start": 249.2,
      "end": 252.48,
      "text": "के बारे में अब यहां पर जो अनलिस्टेड"
    },
    {
      "subtitle_id": 124,
      "start": 250.799,
      "end": 254.159,
      "text": "कंपनीज होती है वो लिस्टेड कंपनी से"
    },
    {
      "subtitle_id": 125,
      "start": 252.48,
      "end": 256.239,
      "text": "ज्यादा रिस्की होती है क्योंकि लिस्टेड"
    },
    {
      "subtitle_id": 126,
      "start": 254.159,
      "end": 257.919,
      "text": "कंपनीज को सेबी रेगुलेट करती है और इन्हें"
    },
    {
      "subtitle_id": 127,
      "start": 256.239,
      "end": 259.56,
      "text": "नहीं करती अनलिस्टेड को नहीं करती है तो"
    },
    {
      "subtitle_id": 128,
      "start": 257.919,
      "end": 261.6,
      "text": "रिस्क रिवॉर्ड रेशो की बात करें तो रिस्क"
    },
    {
      "subtitle_id": 129,
      "start": 259.56,
      "end": 263.08,
      "text": "भी यहां पर काफी ज्यादा है और रिवॉर्ड भी"
    },
    {
      "subtitle_id": 130,
      "start": 261.6,
      "end": 264.919,
      "text": "काफी ज्यादा आपको मिल सकते हैं फॉर"
    },
    {
      "subtitle_id": 131,
      "start": 263.08,
      "end": 266.919,
      "text": "एग्जांपल अगर आपको बता दूं तो यूएसए का एक"
    },
    {
      "subtitle_id": 132,
      "start": 264.919,
      "end": 268.68,
      "text": "ग्राफिटी आर्टिस्ट जो कि वॉल पेंटिंग करते"
    },
    {
      "subtitle_id": 133,
      "start": 266.919,
      "end": 270.8,
      "text": "थे उन्हें कांट्रैक्ट मिला कि वो उनके"
    },
    {
      "subtitle_id": 134,
      "start": 268.68,
      "end": 272.72,
      "text": "ऑफिस में आकर ग्राफ फिटी का काम करें और"
    },
    {
      "subtitle_id": 135,
      "start": 270.8,
      "end": 275.0,
      "text": "उसके बदले में उन्हें पैसे नहीं उन्हें"
    },
    {
      "subtitle_id": 136,
      "start": 272.72,
      "end": 277.24,
      "text": "मिलेंगे कंपनी के शेयर्स तो उन्होंने सोचा"
    },
    {
      "subtitle_id": 137,
      "start": 275.0,
      "end": 279.32,
      "text": "और रिस्क लिया और पैसों के बजाय स्टॉक्स"
    },
    {
      "subtitle_id": 138,
      "start": 277.24,
      "end": 281.56,
      "text": "ले लिए और कई सालों बाद जब 2012 में इस"
    },
    {
      "subtitle_id": 139,
      "start": 279.32,
      "end": 283.52,
      "text": "कंपनी का आईपीओ आता है तब उन सेम शेयर्स"
    },
    {
      "subtitle_id": 140,
      "start": 281.56,
      "end": 285.84,
      "text": "की कीमत आप गेस कर सकते हो कितनी हुई होगी"
    },
    {
      "subtitle_id": 141,
      "start": 283.52,
      "end": 288.68,
      "text": "क्लोज टू 200 मिलियन डलर यानी तब के लगभग"
    },
    {
      "subtitle_id": 142,
      "start": 285.84,
      "end": 292.24,
      "text": "000 करोड़ और इस आर्टिस्ट का नाम था डेविड"
    },
    {
      "subtitle_id": 143,
      "start": 288.68,
      "end": 292.24,
      "text": "को और कंपनी का नाम था"
    },
    {
      "subtitle_id": 144,
      "start": 299.68,
      "end": 303.759,
      "text": "स्टस आपको पता ही है फेल होते हैं और हां"
    },
    {
      "subtitle_id": 145,
      "start": 302.08,
      "end": 305.479,
      "text": "अनलिस्टेड कंपनीज में इन्वेस्टमेंट करने"
    },
    {
      "subtitle_id": 146,
      "start": 303.759,
      "end": 307.96,
      "text": "वाले वही लोग हैं जो लंबे समय का"
    },
    {
      "subtitle_id": 147,
      "start": 305.479,
      "end": 309.44,
      "text": "इन्वेस्टमेंट होराइजन रखते हैं यहां ऐसा"
    },
    {
      "subtitle_id": 148,
      "start": 307.96,
      "end": 311.44,
      "text": "नहीं है कि मॉर्निंग में शेयर्स खरीद लिया"
    },
    {
      "subtitle_id": 149,
      "start": 309.44,
      "end": 313.24,
      "text": "आफ्टरनून में बेज दिया और इसी के साथ में"
    },
    {
      "subtitle_id": 150,
      "start": 311.44,
      "end": 314.919,
      "text": "आप यहां पर एक तरह से कंपनी के प्रमोटर्स"
    },
    {
      "subtitle_id": 151,
      "start": 313.24,
      "end": 316.759,
      "text": "भी बन जाते हैं और इसी के साथ आप पर भी"
    },
    {
      "subtitle_id": 152,
      "start": 314.919,
      "end": 318.759,
      "text": "वही रूल्स लागू होते हैं जो कंपनी के"
    },
    {
      "subtitle_id": 153,
      "start": 316.759,
      "end": 321.0,
      "text": "प्रमोटर्स पर लागू होते हैं यानी यहां आप"
    },
    {
      "subtitle_id": 154,
      "start": 318.759,
      "end": 323.08,
      "text": "आईपीओ के 6 महीने बाद तक अपने शेयर्स नहीं"
    },
    {
      "subtitle_id": 155,
      "start": 321.0,
      "end": 325.039,
      "text": "बेच पाओगे जैसे कि बाकी प्रमोटर्स के साथ"
    },
    {
      "subtitle_id": 156,
      "start": 323.08,
      "end": 327.08,
      "text": "होता है बिकॉज इट्स अ सेबी रूल इसी के साथ"
    },
    {
      "subtitle_id": 157,
      "start": 325.039,
      "end": 329.08,
      "text": "लिक्विडिटी का रिस्क है यहां बीएस या फिर"
    },
    {
      "subtitle_id": 158,
      "start": 327.08,
      "end": 331.12,
      "text": "एनएससी एक्सचेंज नहीं है डेली ट्रेडिंग"
    },
    {
      "subtitle_id": 159,
      "start": 329.08,
      "end": 332.96,
      "text": "यहां पर नहीं होती है और आप तब तक यहां"
    },
    {
      "subtitle_id": 160,
      "start": 331.12,
      "end": 334.68,
      "text": "नहीं बेच सकते जब तक कोई खरीदने वाला"
    },
    {
      "subtitle_id": 161,
      "start": 332.96,
      "end": 336.56,
      "text": "तैयार ना हो तो यह सारी चीजें आपको"
    },
    {
      "subtitle_id": 162,
      "start": 334.68,
      "end": 338.28,
      "text": "इन्वेस्टिंग करते वक्त ध्यान में रखनी है"
    },
    {
      "subtitle_id": 163,
      "start": 336.56,
      "end": 339.8,
      "text": "इसी के साथ प्राइस का रिस्क है फेयर"
    },
    {
      "subtitle_id": 164,
      "start": 338.28,
      "end": 341.479,
      "text": "वैल्यू को फाइंड आउट करना यहां थोड़ा"
    },
    {
      "subtitle_id": 165,
      "start": 339.8,
      "end": 343.44,
      "text": "मुश्किल है लेकिन अगर आपको फंडामेंटल"
    },
    {
      "subtitle_id": 166,
      "start": 341.479,
      "end": 345.24,
      "text": "एनालिसिस अच्छे से आता है डीसीएफ वगैरह भी"
    },
    {
      "subtitle_id": 167,
      "start": 343.44,
      "end": 347.319,
      "text": "अच्छे से यूज़ करना आता है तो आप अच्छे से"
    },
    {
      "subtitle_id": 168,
      "start": 345.24,
      "end": 349.28,
      "text": "यहां पर काम कर लोगे और यहां पर अगर किसी"
    },
    {
      "subtitle_id": 169,
      "start": 347.319,
      "end": 351.12,
      "text": "स्टॉक के शेयर्स की सप्लाई कम हो जाती है"
    },
    {
      "subtitle_id": 170,
      "start": 349.28,
      "end": 353.24,
      "text": "तो विदाउट चेंज इन फंडामेंटल भी उस स्टॉक"
    },
    {
      "subtitle_id": 171,
      "start": 351.12,
      "end": 356.24,
      "text": "की प्राइस स्काय रॉकेट हो सकती है सो यस"
    },
    {
      "subtitle_id": 172,
      "start": 353.24,
      "end": 358.56,
      "text": "इट्स अ हाई रिस्क हाई रिवर्ड गेम तो आपको"
    },
    {
      "subtitle_id": 173,
      "start": 356.24,
      "end": 360.479,
      "text": "अपना पूरा पैसा यहां पर नहीं डालना है अगर"
    },
    {
      "subtitle_id": 174,
      "start": 358.56,
      "end": 362.08,
      "text": "आप शेयर मार्केट में इन्वेस्ट करते हैं तो"
    },
    {
      "subtitle_id": 175,
      "start": 360.479,
      "end": 364.08,
      "text": "प्रेफर कीजिए लिस्टेड कंपनीज में आपकी"
    },
    {
      "subtitle_id": 176,
      "start": 362.08,
      "end": 366.199,
      "text": "मेजॉरिटी इन्वेस्टमेंट हो आपको अनलिस्टेड"
    },
    {
      "subtitle_id": 177,
      "start": 364.08,
      "end": 367.84,
      "text": "में शुरुआत करनी है तो छोटी अमाउंट से ही"
    },
    {
      "subtitle_id": 178,
      "start": 366.199,
      "end": 370.0,
      "text": "शुरुआत करोगे तो मेरे हिसाब से क्या काफी"
    },
    {
      "subtitle_id": 179,
      "start": 367.84,
      "end": 372.199,
      "text": "बेहतर रहेगा एक और इंपॉर्टेंट चीज होती है"
    },
    {
      "subtitle_id": 180,
      "start": 370.0,
      "end": 373.68,
      "text": "जिसका नाम है पॉपुलर बायर्स ऐसी कई सारी"
    },
    {
      "subtitle_id": 181,
      "start": 372.199,
      "end": 375.96,
      "text": "कंपनीज होती है जो अनलिस्टेड होती है और"
    },
    {
      "subtitle_id": 182,
      "start": 373.68,
      "end": 377.84,
      "text": "पॉपुलर में रहती है जिसके चलते वो बहुत ही"
    },
    {
      "subtitle_id": 183,
      "start": 375.96,
      "end": 380.16,
      "text": "महंगे वैल्यूएशन पर हमेशा ट्रेड होती रहती"
    },
    {
      "subtitle_id": 184,
      "start": 377.84,
      "end": 382.28,
      "text": "है तो इसीलिए सही वैल्यू केस स्टॉक में है"
    },
    {
      "subtitle_id": 185,
      "start": 380.16,
      "end": 384.28,
      "text": "यह आपको ढूंढना पड़ेगा और सही एनालिसिस"
    },
    {
      "subtitle_id": 186,
      "start": 382.28,
      "end": 385.759,
      "text": "करोगे तो मिल भी जाएगा क्या आपने अभी तक"
    },
    {
      "subtitle_id": 187,
      "start": 384.28,
      "end": 387.56,
      "text": "किसी अनलिस्टेड कंपनी में इन्वेस्ट किया"
    },
    {
      "subtitle_id": 188,
      "start": 385.759,
      "end": 389.08,
      "text": "है किया है तो उसमें क्या हुआ है प्रॉफिट"
    },
    {
      "subtitle_id": 189,
      "start": 387.56,
      "end": 391.039,
      "text": "हुआ आपको लॉस हुआ है कमेंट करके जरूर"
    },
    {
      "subtitle_id": 190,
      "start": 389.08,
      "end": 392.44,
      "text": "बताइए और जाते-जाते इंक्रेड मनी को जरूर"
