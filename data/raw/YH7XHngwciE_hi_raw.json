  "parsing_issues": [],
  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.16,
      "end": 4.88,
      "text": "बबल मेले में अच्छे लगते हैं लेकिन स्टॉक"
    },
    {
      "subtitle_id": 2,
      "start": 2.56,
      "end": 7.359,
      "text": "मार्केट में बिल्कुल नहीं। पर क्या करें"
    },
    {
      "subtitle_id": 3,
      "start": 4.88,
      "end": 9.76,
      "text": "जब लोग मजबूर हो। पिछले हफ्ते NSDL का"
    },
    {
      "subtitle_id": 4,
      "start": 7.359,
      "end": 12.0,
      "text": "आईपीओ आया। आईपीओ में प्राइस रखी गई ₹800"
    },
    {
      "subtitle_id": 5,
      "start": 9.76,
      "end": 13.92,
      "text": "की और शेयर लिस्ट होने के बाद इस स्टॉक को"
    },
    {
      "subtitle_id": 6,
      "start": 12.0,
      "end": 16.16,
      "text": "तुरंत 10% का लिस्टिंग गेन भी मिल गया।"
    },
    {
      "subtitle_id": 7,
      "start": 13.92,
      "end": 18.24,
      "text": "व्हिच इज गुड। बट इसके बाद जो हुआ उसका"
    },
    {
      "subtitle_id": 8,
      "start": 16.16,
      "end": 20.16,
      "text": "किसी को अंदाजा भी नहीं था। लेकिन शायद इस"
    },
    {
      "subtitle_id": 9,
      "start": 18.24,
      "end": 22.08,
      "text": "10% लिस्टिंग गेन से लोगों का दिल नहीं"
    },
    {
      "subtitle_id": 10,
      "start": 20.16,
      "end": 24.72,
      "text": "भरा था। उन्हें चाहिए था इसका दो गुना"
    },
    {
      "subtitle_id": 11,
      "start": 22.08,
      "end": 27.76,
      "text": "नहीं। पांच गुना नहीं। उन्हें चाहिए था इस"
    },
    {
      "subtitle_id": 12,
      "start": 24.72,
      "end": 29.92,
      "text": "10% का आठ गुना यानी 80% का प्रॉफिट। और"
    },
    {
      "subtitle_id": 13,
      "start": 27.76,
      "end": 32.559,
      "text": "इसी के चलते NSDL के इन्वेस्टर्स इस स्टॉक"
    },
    {
      "subtitle_id": 14,
      "start": 29.92,
      "end": 34.64,
      "text": "को ₹800 से लेकर चले गए ₹1300 पर जिससे"
    },
    {
      "subtitle_id": 15,
      "start": 32.559,
      "end": 37.44,
      "text": "कंपनी का पीई रेशियो शूट अप होकर चला गया"
    },
    {
      "subtitle_id": 16,
      "start": 34.64,
      "end": 39.36,
      "text": "75 पर। अब इसी के साथ-साथ लोगों के दिमाग"
    },
    {
      "subtitle_id": 17,
      "start": 37.44,
      "end": 41.28,
      "text": "में एक सवाल आने लगा है कि क्या यह ग्रोथ"
    },
    {
      "subtitle_id": 18,
      "start": 39.36,
      "end": 43.36,
      "text": "सही में जस्टिफाइड है? लुकिंग एट दी"
    },
    {
      "subtitle_id": 19,
      "start": 41.28,
      "end": 45.2,
      "text": "फंडामेंटल्स ऑफ द कंपनी या फिर कंपनी एक"
    },
    {
      "subtitle_id": 20,
      "start": 43.36,
      "end": 47.2,
      "text": "डेंजरस टेरिटरी में जा चुकी है। जहां पर"
    },
    {
      "subtitle_id": 21,
      "start": 45.2,
      "end": 48.879,
      "text": "वैल्यू्यूएशन का कंपनी ग्रोथ से कोई लेना"
    },
    {
      "subtitle_id": 22,
      "start": 47.2,
      "end": 50.399,
      "text": "देना नहीं है। बात करेंगे इस वीडियो में"
    },
    {
      "subtitle_id": 23,
      "start": 48.879,
      "end": 52.399,
      "text": "डिटेल में। और हां, अभी रिसेंटली हमने जब"
    },
    {
      "subtitle_id": 24,
      "start": 50.399,
      "end": 54.16,
      "text": "एनएसएल का आईपीओ वीडियो बनाया था, तब टाइम"
    },
    {
      "subtitle_id": 25,
      "start": 52.399,
      "end": 56.559,
      "text": "की कमी की वजह से कुछ पॉइंट्स डिटेल में"
    },
    {
      "subtitle_id": 26,
      "start": 54.16,
      "end": 58.079,
      "text": "एक्सप्लेन नहीं कर पाए थे। जो आज हम बहुत"
    },
    {
      "subtitle_id": 27,
      "start": 56.559,
      "end": 59.52,
      "text": "ही डिटेल में और डाटा के साथ आपको"
    },
    {
      "subtitle_id": 28,
      "start": 58.079,
      "end": 61.039,
      "text": "एक्सप्लेन करेंगे और एनएसएल के"
    },
    {
      "subtitle_id": 29,
      "start": 59.52,
      "end": 62.96,
      "text": "फंडामेंटल्स के साथ-साथ वैल्यू्यूएशन"
    },
    {
      "subtitle_id": 30,
      "start": 61.039,
      "end": 64.879,
      "text": "स्टडी भी डिटेल में करेंगे। सो लेट्स गेट"
    },
    {
      "subtitle_id": 31,
      "start": 62.96,
      "end": 66.88,
      "text": "स्टार्टेड। नमस्कार, मैं प्रसाद आपका आज"
    },
    {
      "subtitle_id": 32,
      "start": 64.879,
      "end": 68.479,
      "text": "के इस वीडियो में स्वागत करता हूं। एनएसएल"
    },
    {
      "subtitle_id": 33,
      "start": 66.88,
      "end": 71.36,
      "text": "जैसे कि हमें पता है कि एक डिपॉजिटरी"
    },
    {
      "subtitle_id": 34,
      "start": 68.479,
      "end": 73.6,
      "text": "कंपनी है। सम लाइक बैंक्स बट इनके पास कैश"
    },
    {
      "subtitle_id": 35,
      "start": 71.36,
      "end": 75.6,
      "text": "के बजाय शेयर्स डिपॉजिट होते हैं। देखिए"
    },
    {
      "subtitle_id": 36,
      "start": 73.6,
      "end": 77.759,
      "text": "मार्केट में दो डिपॉजिटरीज है। पहली है"
    },
    {
      "subtitle_id": 37,
      "start": 75.6,
      "end": 80.159,
      "text": "सीडीएसएल जो ऑलरेडी लिस्टेड है और सेकंड"
    },
    {
      "subtitle_id": 38,
      "start": 77.759,
      "end": 82.24,
      "text": "है एनएसडीएल जिसका भी आईपीओ आया है। अब कई"
    },
    {
      "subtitle_id": 39,
      "start": 80.159,
      "end": 84.159,
      "text": "सारे लोग क्या गलती करते हैं कि इन दोनों"
    },
    {
      "subtitle_id": 40,
      "start": 82.24,
      "end": 85.68,
      "text": "को सामने-सामने रख के कंपैरिजन करते हैं।"
    },
    {
      "subtitle_id": 41,
      "start": 84.159,
      "end": 88.159,
      "text": "उन्हें लगता है कि ये दोनों के सीधे-सीधे"
    },
    {
      "subtitle_id": 42,
      "start": 85.68,
      "end": 90.96,
      "text": "कंपिटिट है। लेकिन अगर आप भी ऐसा सोच रहे"
    },
    {
      "subtitle_id": 43,
      "start": 88.159,
      "end": 93.119,
      "text": "हैं तो आप गलत सोच रहे हो। कैसे? आगे"
    },
    {
      "subtitle_id": 44,
      "start": 90.96,
      "end": 94.64,
      "text": "बताता हूं। यह दोनों इतनी डिफरेंट टेरिटरी"
    },
    {
      "subtitle_id": 45,
      "start": 93.119,
      "end": 97.28,
      "text": "में काम करते हैं कि जिस सेगमेंट में"
    },
    {
      "subtitle_id": 46,
      "start": 94.64,
      "end": 99.6,
      "text": "एनएसडीएल काम करता है उसमें तो सीडीएसएल"
    },
    {
      "subtitle_id": 47,
      "start": 97.28,
      "end": 101.6,
      "text": "का नामोनिशान तक नहीं है। और वही सीडीएसएल"
    },
    {
      "subtitle_id": 48,
      "start": 99.6,
      "end": 103.92,
      "text": "का जिस सेगमेंट में दबदबा है वहां पर"
    },
    {
      "subtitle_id": 49,
      "start": 101.6,
      "end": 106.56,
      "text": "एनएसडीएल की ज्यादा पावर नहीं है। कैसे?"
    },
    {
      "subtitle_id": 50,
      "start": 103.92,
      "end": 108.56,
      "text": "तो सुनिए। देखिए जो सीडीएसएल है ना यह आप"
    },
    {
      "subtitle_id": 51,
      "start": 106.56,
      "end": 110.399,
      "text": "और मेरे जैसे रिटेल इन्वेस्टर्स को कैटर"
    },
    {
      "subtitle_id": 52,
      "start": 108.56,
      "end": 112.24,
      "text": "करते हैं। यानी कि जब हम शेयर्स बाय करते"
    },
    {
      "subtitle_id": 53,
      "start": 110.399,
      "end": 114.32,
      "text": "हैं तो यहां पर वो स्टोर किए जाते हैं। और"
    },
    {
      "subtitle_id": 54,
      "start": 112.24,
      "end": 116.56,
      "text": "ये हमसे कब चार्ज करते हैं? जब हम शेयर्स"
    },
    {
      "subtitle_id": 55,
      "start": 114.32,
      "end": 118.479,
      "text": "सेल करते हैं। इसके अलावा भी सीडीएसएल कई"
    },
    {
      "subtitle_id": 56,
      "start": 116.56,
      "end": 120.56,
      "text": "सारी अलग-अलग जगह से पैसा बनाता है। जैसे"
    },
    {
      "subtitle_id": 57,
      "start": 118.479,
      "end": 122.56,
      "text": "आप स्क्रीन पर देख सकते हो। जैसे कि एनुअल"
    },
    {
      "subtitle_id": 58,
      "start": 120.56,
      "end": 124.64,
      "text": "इशर चार्जेस जो यह ब्रोकर से लेते हैं।"
    },
    {
      "subtitle_id": 59,
      "start": 122.56,
      "end": 126.24,
      "text": "आईपीओ और कॉर्पोरेट एक्शन के चार्जेस और"
    },
    {
      "subtitle_id": 60,
      "start": 124.64,
      "end": 128.0,
      "text": "बाकी भी इनकी कई सारी मल्टीपल इनकम"
    },
    {
      "subtitle_id": 61,
      "start": 126.24,
      "end": 130.0,
      "text": "स्ट्रीम्स हैं। और सीडीएसएल का यह जो"
    },
    {
      "subtitle_id": 62,
      "start": 128.0,
      "end": 132.319,
      "text": "सेगमेंट है जहां पर वो रिटेल डिपॉजिटरी"
    },
    {
      "subtitle_id": 63,
      "start": 130.0,
      "end": 135.2,
      "text": "सर्विज ऑफर करते हैं। यहां पर ये किंग है"
    },
    {
      "subtitle_id": 64,
      "start": 132.319,
      "end": 137.12,
      "text": "और इनका क्या दबदबा है यह ग्राफ देख के आप"
    },
    {
      "subtitle_id": 65,
      "start": 135.2,
      "end": 138.48,
      "text": "पता कर ही सकते हो। अगर आपको ये ग्राफ देख"
    },
    {
      "subtitle_id": 66,
      "start": 137.12,
      "end": 139.92,
      "text": "के भी समझ में नहीं आया तो एक और डाटा"
    },
    {
      "subtitle_id": 67,
      "start": 138.48,
      "end": 142.56,
      "text": "फैक्ट आपको बताता हूं। उससे समझ में आ"
    },
    {
      "subtitle_id": 68,
      "start": 139.92,
      "end": 145.28,
      "text": "जाएगा। इंडिया में फिलहाल 20 करोड़ डीमेट"
    },
    {
      "subtitle_id": 69,
      "start": 142.56,
      "end": 147.52,
      "text": "अकाउंट्स हैं। उसमें से 15.86 करोड़ यानी"
    },
    {
      "subtitle_id": 70,
      "start": 145.28,
      "end": 149.599,
      "text": "कि लगभग 16 करोड़ सिर्फ सीडीएसएल के पास"
    },
    {
      "subtitle_id": 71,
      "start": 147.52,
      "end": 152.72,
      "text": "है। यानी कि इनका मार्केट शेयर बन जाता है"
    },
    {
      "subtitle_id": 72,
      "start": 149.599,
      "end": 154.72,
      "text": "79% का और इसी के चलते इस कंपनी ने पिछले"
    },
    {
      "subtitle_id": 73,
      "start": 152.72,
      "end": 156.08,
      "text": "8 सालों में 10 गुना रिटर्न्स दिए हैं।"
    },
    {
      "subtitle_id": 74,
      "start": 154.72,
      "end": 157.92,
      "text": "वीडियो में आगे बढ़ने से पहले आपको बता"
    },
    {
      "subtitle_id": 75,
      "start": 156.08,
      "end": 159.84,
      "text": "दूं कि हर साल के इंडिपेंडेंस डे की तरह"
    },
    {
      "subtitle_id": 76,
      "start": 157.92,
      "end": 161.68,
      "text": "इस साल भी हमारा फंडामेंटल एनालिसिस का"
    },
    {
      "subtitle_id": 77,
      "start": 159.84,
      "end": 164.319,
      "text": "नेक्स्ट अपग्रेड आ रहा है जिसका नाम है"
    },
    {
      "subtitle_id": 78,
      "start": 161.68,
      "end": 166.239,
      "text": "फंडामेंटल एनालिसिस 3.0 जिसकी प्री बुकिंग"
    },
    {
      "subtitle_id": 79,
      "start": 164.319,
      "end": 167.84,
      "text": "क्लोज होने में बस कुछ ही दिन बाकी है। अब"
    },
    {
      "subtitle_id": 80,
      "start": 166.239,
      "end": 169.519,
      "text": "सवाल यह है कि आपको इस फंडामेंटल एनालिसिस"
    },
    {
      "subtitle_id": 81,
      "start": 167.84,
      "end": 171.28,
      "text": "3.0 में क्या-क्या मिलेगा? तो यहां पर"
    },
    {
      "subtitle_id": 82,
      "start": 169.519,
      "end": 173.04,
      "text": "आपको सीखने मिलेगा कि फंडामेंटल एनालिसिस"
    },
    {
      "subtitle_id": 83,
      "start": 171.28,
      "end": 174.64,
      "text": "की मदद से क्वालिटी कंपनीज़ कैसे ढूंढें,"
    },
    {
      "subtitle_id": 84,
      "start": 173.04,
      "end": 176.319,
      "text": "कंपनी का मैनेजमेंट एनालिसिस कैसे करें,"
    },
    {
      "subtitle_id": 85,
      "start": 174.64,
      "end": 177.84,
      "text": "फाइनेंसियल स्टेटमेंट्स को कैसे एनालाइज"
    },
    {
      "subtitle_id": 86,
      "start": 176.319,
      "end": 179.519,
      "text": "करें, वहां पर जो मैनपुलेशन हो रहा है"
    },
    {
      "subtitle_id": 87,
      "start": 177.84,
      "end": 181.04,
      "text": "उन्हें कैसे आइडेंटिफाई करें और फाइनली"
    },
    {
      "subtitle_id": 88,
      "start": 179.519,
      "end": 182.8,
      "text": "कंपनी का वैल्यू्यूएशन कैसे निकालें? और"
    },
    {
      "subtitle_id": 89,
      "start": 181.04,
      "end": 184.64,
      "text": "इसके साथ हम आपको सिखाएंगे एआई टूल्स की"
    },
    {
      "subtitle_id": 90,
      "start": 182.8,
      "end": 186.159,
      "text": "मदद से आप कैसे आप एनालिसिस कर सकते हो?"
    },
    {
      "subtitle_id": 91,
      "start": 184.64,
      "end": 188.08,
      "text": "और लास्ट में सवाल यह भी है कि यह"
    },
    {
      "subtitle_id": 92,
      "start": 186.159,
      "end": 190.0,
      "text": "प्रोग्राम किसके लिए है? तो सीधा जवाब है"
    },
    {
      "subtitle_id": 93,
      "start": 188.08,
      "end": 192.239,
      "text": "हर किसी के लिए। आप स्टूडेंट हो,"
    },
    {
      "subtitle_id": 94,
      "start": 190.0,
      "end": 193.84,
      "text": "इन्वेस्टर हो या फिर फाइनेंस की फील्ड में"
    },
    {
      "subtitle_id": 95,
      "start": 192.239,
      "end": 195.44,
      "text": "करियर बनाना चाहते हो? फर्क नहीं पड़ता"
    },
    {
      "subtitle_id": 96,
      "start": 193.84,
      "end": 197.36,
      "text": "आपका फाइनेंस का बैकग्राउंड है या नहीं।"
    },
    {
      "subtitle_id": 97,
      "start": 195.44,
      "end": 199.04,
      "text": "आप इस प्रोग्राम में एनरोल कर सकते हो। और"
    },
    {
      "subtitle_id": 98,
      "start": 197.36,
      "end": 200.319,
      "text": "फीस की बात करूं तो तीन ऑफर्स यहां पर"
    },
    {
      "subtitle_id": 99,
      "start": 199.04,
      "end": 202.64,
      "text": "हैं। पहले ऑफर में मिलता है आपको"
    },
    {
      "subtitle_id": 100,
      "start": 200.319,
      "end": 205.12,
      "text": "फंडामेंटल एनालिसिस 3.0 नॉन ऑफर डे पर"
    },
    {
      "subtitle_id": 101,
      "start": 202.64,
      "end": 206.879,
      "text": "जिसकी वैल्यू है ₹7499।"
    },
    {
      "subtitle_id": 102,
      "start": 205.12,
      "end": 209.76,
      "text": "पर इस इंडिपेंडेंस डे ऑफर में आपको यह"
    },
    {
      "subtitle_id": 103,
      "start": 206.879,
      "end": 211.44,
      "text": "मिलेगा मात्र ₹3297 में। यहां पर हमारा टू"
    },
    {
      "subtitle_id": 104,
      "start": 209.76,
      "end": 212.72,
      "text": "इन वन कॉम्बो आपको मिलता है जिसमें आपको"
    },
    {
      "subtitle_id": 105,
      "start": 211.44,
      "end": 214.879,
      "text": "हमारे दो प्रोग्राम्स मिलते हैं।"
    },
    {
      "subtitle_id": 106,
      "start": 212.72,
      "end": 216.64,
      "text": "फंडामेंटल एनालिसिस 3.0 और फाउंडेशन कोर्स"
    },
    {
      "subtitle_id": 107,
      "start": 214.879,
      "end": 218.64,
      "text": "ऑन स्टॉक मार्केट जिसके एक्चुअल प्राइस है"
    },
    {
      "subtitle_id": 108,
      "start": 216.64,
      "end": 221.599,
      "text": "₹1299 पर और यहां पर ऑफर में आपको यह मिल"
    },
    {
      "subtitle_id": 109,
      "start": 218.64,
      "end": 223.519,
      "text": "रहा है मात्र ₹597 में। और उसके बाद है"
    },
    {
      "subtitle_id": 110,
      "start": 221.599,
      "end": 225.28,
      "text": "हमारा फोर इन वन कॉम्बो। इस कॉम्बो में"
    },
    {
      "subtitle_id": 111,
      "start": 223.519,
      "end": 227.76,
      "text": "आपको मिलते हैं यह सारे चार प्रोग्राम्स"
    },
    {
      "subtitle_id": 112,
      "start": 225.28,
      "end": 230.159,
      "text": "जिनके एक्चुअल प्राइस है ₹1299 और ऑफर में"
    },
    {
      "subtitle_id": 113,
      "start": 227.76,
      "end": 231.76,
      "text": "आपको मिल रहा है यह मात्र ₹993 में। तो"
    },
    {
      "subtitle_id": 114,
      "start": 230.159,
      "end": 233.44,
      "text": "बिल्कुल देर मत कीजिए अभी डिस्क्रिप्शन और"
    },
    {
      "subtitle_id": 115,
      "start": 231.76,
      "end": 235.28,
      "text": "कमेंट बॉक्स में दी गई लिंक पर क्लिक करके"
    },
    {
      "subtitle_id": 116,
      "start": 233.44,
      "end": 237.2,
      "text": "आप प्री बुकिंग तुरंत कर लीजिए और इस ऑफर"
    },
    {
      "subtitle_id": 117,
      "start": 235.28,
      "end": 239.04,
      "text": "का फायदा उठाइए और अगर आप इस ऑफर में"
    },
    {
      "subtitle_id": 118,
      "start": 237.2,
      "end": 242.08,
      "text": "एनरोल करते हैं तो फ्यूचर में आने वाली जो"
    },
    {
      "subtitle_id": 119,
      "start": 239.04,
      "end": 243.84,
      "text": "अपडेट्स हैं 4.0, 5.0 उन सबका एक्सेस आपको"
    },
    {
      "subtitle_id": 120,
      "start": 242.08,
      "end": 245.84,
      "text": "फ्री में फ्यूचर में मिल जाएगा। सो डोंट"
    },
    {
      "subtitle_id": 121,
      "start": 243.84,
      "end": 247.439,
      "text": "मिस आउट ऑन दिस गोल्डन ओपोरर्चुनिटी। चलिए"
    },
    {
      "subtitle_id": 122,
      "start": 245.84,
      "end": 249.519,
      "text": "वीडियो की तरफ बढ़ते हैं। अब बात करते हैं"
    },
    {
      "subtitle_id": 123,
      "start": 247.439,
      "end": 251.2,
      "text": "एनएसडीएल की। देखिए मैं आपको यह नंबर्स और"
    },
    {
      "subtitle_id": 124,
      "start": 249.519,
      "end": 253.2,
      "text": "सारी चीजें इसलिए दिखा रहा हूं ताकि आपको"
    },
    {
      "subtitle_id": 125,
      "start": 251.2,
      "end": 254.64,
      "text": "एकदम क्लेरिटी मिल जाए कि एग्जैक्टली यहां"
    },
    {
      "subtitle_id": 126,
      "start": 253.2,
      "end": 256.479,
      "text": "पर क्या हो रहा है और एग्जैक्टली ये"
    },
    {
      "subtitle_id": 127,
      "start": 254.64,
      "end": 258.079,
      "text": "बिज़नेस क्या करते हैं और कैसे एक दूसरे से"
    },
    {
      "subtitle_id": 128,
      "start": 256.479,
      "end": 260.16,
      "text": "अलग है। क्या इन दोनों के अपने-अपने"
    },
    {
      "subtitle_id": 129,
      "start": 258.079,
      "end": 261.68,
      "text": "एडवांटेजेस हैं, डिसएडवांटेजेस हैं ताकि"
    },
    {
      "subtitle_id": 130,
      "start": 260.16,
      "end": 263.6,
      "text": "वीडियो के एंड में जब हम इनके"
    },
    {
      "subtitle_id": 131,
      "start": 261.68,
      "end": 265.759,
      "text": "वैल्यू्यूएशन की बात करेंगे तो कंक्लूजन"
    },
    {
      "subtitle_id": 132,
      "start": 263.6,
      "end": 267.6,
      "text": "आपको अपना खुद ही मिल जाएगा। एनएसडीएल की"
    },
    {
      "subtitle_id": 133,
      "start": 265.759,
      "end": 269.199,
      "text": "बात करें तो इनका एक रेवेन्यू सोर्सेस यह"
    },
    {
      "subtitle_id": 134,
      "start": 267.6,
      "end": 271.04,
      "text": "कुछ तीन मेन रेवेन्यू सोर्सेस हैं। तो"
    },
    {
      "subtitle_id": 135,
      "start": 269.199,
      "end": 272.88,
      "text": "इनका रेवेन्यू मिक्स जो है वो सीडीएसएल से"
    },
    {
      "subtitle_id": 136,
      "start": 271.04,
      "end": 274.96,
      "text": "पूरी तरह से अलग है। जहां पर सीडीएसएल"
    },
    {
      "subtitle_id": 137,
      "start": 272.88,
      "end": 276.96,
      "text": "रिटेल इन्वेस्टर्स को कैटर करता है। वहीं"
    },
    {
      "subtitle_id": 138,
      "start": 274.96,
      "end": 279.44,
      "text": "पर एनएसडीएल इंस्टीट्यूशनल इन्वेस्टर्स को"
    },
    {
      "subtitle_id": 139,
      "start": 276.96,
      "end": 280.96,
      "text": "कैटर करता है। जैसे कि आपके डीआईआई यानी"
    },
    {
      "subtitle_id": 140,
      "start": 279.44,
      "end": 282.639,
      "text": "डोमेस्टिक इंस्टीट्यूशनल इन्वेस्टर्स हो"
    },
    {
      "subtitle_id": 141,
      "start": 280.96,
      "end": 284.479,
      "text": "गए जिसमें आपके म्यूच्यूल फंड्स आते हैं,"
    },
    {
      "subtitle_id": 142,
      "start": 282.639,
      "end": 285.919,
      "text": "इंश्योरेंस कंपनीज़ आती है। और साथ ही"
    },
    {
      "subtitle_id": 143,
      "start": 284.479,
      "end": 288.0,
      "text": "एफपीआई यानी फॉरेन पोर्टफोलियो"
    },
    {
      "subtitle_id": 144,
      "start": 285.919,
      "end": 290.4,
      "text": "इन्वेस्टर्स। और यही रीजन है कि सीडीएसएल"
    },
    {
      "subtitle_id": 145,
      "start": 288.0,
      "end": 293.36,
      "text": "के पास 79% मार्केट शेयर होने के बावजूद"
    },
    {
      "subtitle_id": 146,
      "start": 290.4,
      "end": 295.68,
      "text": "भी अगर डिपॉजिटरी सेगमेंट में एसेट वाइज"
    },
    {
      "subtitle_id": 147,
      "start": 293.36,
      "end": 297.199,
      "text": "अगर कोई सबसे बड़ा है तो वह एनएसडीएल है।"
    },
    {
      "subtitle_id": 148,
      "start": 295.68,
      "end": 298.88,
      "text": "क्योंकि जो इंस्टीट्यूशनल इन्वेस्टर्स हैं"
    },
    {
      "subtitle_id": 149,
      "start": 297.199,
      "end": 300.479,
      "text": "उनके एसेट्स ज्यादा होते हैं। तो एसेट्स"
    },
    {
      "subtitle_id": 150,
      "start": 298.88,
      "end": 302.56,
      "text": "अंडर कस्टडी किसके पास ज्यादा है?"
    },
    {
      "subtitle_id": 151,
      "start": 300.479,
      "end": 304.479,
      "text": "एनएसडीएल के पास। तो आप स्क्रीन पर जैसे"
    },
    {
      "subtitle_id": 152,
      "start": 302.56,
      "end": 308.0,
      "text": "देख सकते हो कि एनएसडीएल का जो एसेट अंडर"
    },
    {
      "subtitle_id": 153,
      "start": 304.479,
      "end": 310.08,
      "text": "कस्टडी है वो है 51 लाख करोड़। और वहीं पर"
    },
    {
      "subtitle_id": 154,
      "start": 308.0,
      "end": 312.56,
      "text": "सीडीएसएल का देखा जाए तो कंपेरेटिवली काफी"
    },
    {
      "subtitle_id": 155,
      "start": 310.08,
      "end": 314.24,
      "text": "कम है। वो है 79 लाख करोड़। लेकिन इसके"
    },
    {
      "subtitle_id": 156,
      "start": 312.56,
      "end": 315.919,
      "text": "बावजूद भी एक चीज फिर आपके दिमाग में आ"
    },
    {
      "subtitle_id": 157,
      "start": 314.24,
      "end": 317.6,
      "text": "रही होगी कि अगर एसेट अंडर कस्टडी"
    },
    {
      "subtitle_id": 158,
      "start": 315.919,
      "end": 319.84,
      "text": "एनएसडीएल के पास है तो एनएसडीएल का"
    },
    {
      "subtitle_id": 159,
      "start": 317.6,
      "end": 321.68,
      "text": "मार्केट कैप सीडीएल से कम क्यों? इतनी"
    },
    {
      "subtitle_id": 160,
      "start": 319.84,
      "end": 323.84,
      "text": "शेयर प्राइस बढ़ने के बावजूद भी एनएसडीएल"
    },
    {
      "subtitle_id": 161,
      "start": 321.68,
      "end": 326.639,
      "text": "का मार्केट कैप फिलहाल ₹24,000 करोड़ है।"
    },
    {
      "subtitle_id": 162,
      "start": 323.84,
      "end": 328.24,
      "text": "वहीं CDSL का है 32,000 करोड़। और इसी के"
    },
    {
      "subtitle_id": 163,
      "start": 326.639,
      "end": 329.919,
      "text": "साथ एक और डाटा पॉइंट अगर आप देखें"
    },
    {
      "subtitle_id": 164,
      "start": 328.24,
      "end": 331.36,
      "text": "स्क्रीन पर वो है होल्डिंग पर डीमेट"
    },
    {
      "subtitle_id": 165,
      "start": 329.919,
      "end": 332.96,
      "text": "अकाउंट। यानी कि एक डीमेट अकाउंट में ऑन"
    },
    {
      "subtitle_id": 166,
      "start": 331.36,
      "end": 334.639,
      "text": "एन एवरेज कितने रुपए रखे गए हैं? तो"
    },
    {
      "subtitle_id": 167,
      "start": 332.96,
      "end": 336.72,
      "text": "एनएसडीएल के पास जो इंस्टीट्यूशन"
    },
    {
      "subtitle_id": 168,
      "start": 334.639,
      "end": 339.199,
      "text": "इन्वेस्टर्स हैं उनके एक डीमेट अकाउंट में"
    },
    {
      "subtitle_id": 169,
      "start": 336.72,
      "end": 341.36,
      "text": "ऑन एन एवरेज ₹1.2 करोड़ है। वहीं पर"
    },
    {
      "subtitle_id": 170,
      "start": 339.199,
      "end": 344.16,
      "text": "सीडीएल के पास जो डीमेट अकाउंट्स हैं उनके"
    },
    {
      "subtitle_id": 171,
      "start": 341.36,
      "end": 346.4,
      "text": "पास ऑन एन एवरेज एक अकाउंट में ₹4.6 लाख"
    },
    {
      "subtitle_id": 172,
      "start": 344.16,
      "end": 348.8,
      "text": "है। तो यह फर्क भी बहुत ज्यादा है। यानी"
    },
    {
      "subtitle_id": 173,
      "start": 346.4,
      "end": 350.639,
      "text": "कि क्लोज टू ₹1 करोड़ 15 लाख का अंतर है।"
    },
    {
      "subtitle_id": 174,
      "start": 348.8,
      "end": 352.88,
      "text": "और यह जो सीडीएल के डीममेट अकाउंट है,"
    },
    {
      "subtitle_id": 175,
      "start": 350.639,
      "end": 355.68,
      "text": "इसमें भी हम एचयूएफ यानी हिंदू अनडिवाइडेड"
    },
    {
      "subtitle_id": 176,
      "start": 352.88,
      "end": 358.4,
      "text": "फैमिली और एनआरआई को हटा दें, तो यह नंबर"
    },
    {
      "subtitle_id": 177,
      "start": 355.68,
      "end": 360.8,
      "text": "आ जाता है मात्र ₹2.2 लाख पर। रीज़न बड़ा"
    },
    {
      "subtitle_id": 178,
      "start": 358.4,
      "end": 362.639,
      "text": "सिंपल है। जो एफआईआई डीआईआई हैं उनके पास"
    },
    {
      "subtitle_id": 179,
      "start": 360.8,
      "end": 364.08,
      "text": "रिटेल इन्वेस्टर्स के कंपेरेटिवली काफी"
    },
    {
      "subtitle_id": 180,
      "start": 362.639,
      "end": 366.16,
      "text": "ज्यादा पैसा है। अब सवाल यह आता है कि"
    },
    {
      "subtitle_id": 181,
      "start": 364.08,
      "end": 368.319,
      "text": "एनएसडीएल की कस्टडी में अगर सीडीएल के"
    },
    {
      "subtitle_id": 182,
      "start": 366.16,
      "end": 370.8,
      "text": "कंपेरेटिवली छ से सात गुना ज्यादा पैसा है"
    },
    {
      "subtitle_id": 183,
      "start": 368.319,
      "end": 372.88,
      "text": "तो क्या एनएसडीएल सीडीएल से छ से सात गुना"
    },
    {
      "subtitle_id": 184,
      "start": 370.8,
      "end": 375.12,
      "text": "ज्यादा प्रॉफिट कमा रहा है? नहीं। यहां पर"
    },
    {
      "subtitle_id": 185,
      "start": 372.88,
      "end": 377.199,
      "text": "बिजनेस मॉडल वाइज़ सीडीएसएल के पास एक"
    },
    {
      "subtitle_id": 186,
      "start": 375.12,
      "end": 378.639,
      "text": "एडवांटेज है। बड़ा ही इंटरेस्टिंग एडवांटेज"
    },
    {
      "subtitle_id": 187,
      "start": 377.199,
      "end": 381.759,
      "text": "है। आप यह रेवेन्यू ब्रेकअप देख लीजिए।"
    },
    {
      "subtitle_id": 188,
      "start": 378.639,
      "end": 383.759,
      "text": "एनएसडीएल का और इसके बाद आप सीडीएसएल का"
    },
    {
      "subtitle_id": 189,
      "start": 381.759,
      "end": 385.6,
      "text": "यह रेवेन्यू ब्रेकअप देख लीजिए। आप देख"
    },
    {
      "subtitle_id": 190,
      "start": 383.759,
      "end": 387.36,
      "text": "सकते हो कि एनएसडीएल का जो मेन रेवेन्यू"
    },
    {
      "subtitle_id": 191,
      "start": 385.6,
      "end": 389.28,
      "text": "सोर्स है वह ट्रांजैक्शन फीस और कस्टडी"
    },
    {
      "subtitle_id": 192,
      "start": 387.36,
      "end": 391.039,
      "text": "फीस है। ट्रांजैक्शन फी हमें पता है व्हाट"
    },
    {
      "subtitle_id": 193,
      "start": 389.28,
      "end": 392.72,
      "text": "आर द कस्टडी फीस? तो एनएसडीएल"
    },
    {
      "subtitle_id": 194,
      "start": 391.039,
      "end": 395.199,
      "text": "इंस्टीट्यूशन इन्वेस्टर से पैसा चार्ज"
    },
    {
      "subtitle_id": 195,
      "start": 392.72,
      "end": 397.919,
      "text": "करता है शेयर स्टोर करने के बदले में और"
    },
    {
      "subtitle_id": 196,
      "start": 395.199,
      "end": 399.919,
      "text": "यहां से उन्होंने पिछले साल ₹235 करोड़"
    },
    {
      "subtitle_id": 197,
      "start": 397.919,
      "end": 402.24,
      "text": "कमाए थे। वहीं अगर सीडीएल के रेवेन्यू"
    },
    {
      "subtitle_id": 198,
      "start": 399.919,
      "end": 403.919,
      "text": "सोर्सेस देखें तो वह काफी डवर्सिफाइड है।"
    },
    {
      "subtitle_id": 199,
      "start": 402.24,
      "end": 406.56,
      "text": "यह एनुअल इशर चार्जेस, ट्रांजैक्शन"
    },
    {
      "subtitle_id": 200,
      "start": 403.919,
      "end": 408.56,
      "text": "चार्जेस, आईपीओ, ई वोटिंग, फलाना ढमकाना"
    },
    {
      "subtitle_id": 201,
      "start": 406.56,
      "end": 411.199,
      "text": "बहुत सारी जगह से पैसा कमाते हैं। इसी के"
    },
    {
      "subtitle_id": 202,
      "start": 408.56,
      "end": 414.08,
      "text": "चलते इनका जो प्रॉफिट था वो पिछले साल 526"
    },
    {
      "subtitle_id": 203,
      "start": 411.199,
      "end": 416.8,
      "text": "करोड़ का था। जो कि एनएसडीएल के 343 करोड़"
    },
    {
      "subtitle_id": 204,
      "start": 414.08,
      "end": 418.4,
      "text": "के प्रॉफिट से 53% ज्यादा था। तो मेन चीज"
    },
    {
      "subtitle_id": 205,
      "start": 416.8,
      "end": 420.4,
      "text": "अगर देखा जाए तो सीडीएल के रेवेन्यू"
    },
    {
      "subtitle_id": 206,
      "start": 418.4,
      "end": 421.919,
      "text": "सोर्सेस बहुत ज्यादा है। वहीं पर एनएसडीएल"
    },
    {
      "subtitle_id": 207,
      "start": 420.4,
      "end": 423.84,
      "text": "में जो पैसा है वो एक दो जगह से ही आ रहा"
    },
    {
      "subtitle_id": 208,
      "start": 421.919,
      "end": 425.919,
      "text": "है। देखिए जो कस्टडी फीस है जो सीडीएस,"
    },
    {
      "subtitle_id": 209,
      "start": 423.84,
      "end": 428.16,
      "text": "एनएसएल दोनों चार्ज करते हैं उसमें अच्छी"
    },
    {
      "subtitle_id": 210,
      "start": 425.919,
      "end": 430.24,
      "text": "बात यह है कि यह फीस वो सीधा कंपनीज़ को"
    },
    {
      "subtitle_id": 211,
      "start": 428.16,
      "end": 432.16,
      "text": "चार्ज करते हैं जो शेयर्स इशू करती है"
    },
    {
      "subtitle_id": 212,
      "start": 430.24,
      "end": 434.08,
      "text": "यानी TCS, Infosys, Reliance Industries"
    },
    {
      "subtitle_id": 213,
      "start": 432.16,
      "end": 435.919,
      "text": "वगैरह-वगैरह और यह जो फीस है यह रिकरिंग"
    },
    {
      "subtitle_id": 214,
      "start": 434.08,
      "end": 437.919,
      "text": "है। यह हर साल उन्हें कंपनी से मिलती रहती"
    },
    {
      "subtitle_id": 215,
      "start": 435.919,
      "end": 439.84,
      "text": "है। तो उस हिसाब से ये एक रिकरिंग बिज़नेस"
    },
    {
      "subtitle_id": 216,
      "start": 437.919,
      "end": 441.919,
      "text": "है। अच्छा। तो कंक्लूजन यह है कि ज्यादा"
    },
    {
      "subtitle_id": 217,
      "start": 439.84,
      "end": 444.16,
      "text": "एसेट अंडर कस्टडी होना अच्छी बात है।"
    },
    {
      "subtitle_id": 218,
      "start": 441.919,
      "end": 446.16,
      "text": "लेकिन सिर्फ उससे ही काम नहीं चलेगा। आपको"
    },
    {
      "subtitle_id": 219,
      "start": 444.16,
      "end": 448.16,
      "text": "कई सारे रेवेन्यू सोर्सेस उसी चीज से"
    },
    {
      "subtitle_id": 220,
      "start": 446.16,
      "end": 450.0,
      "text": "बनाने पड़ेंगे अपने डिपॉजिटरी बिज़नेस से।"
    },
    {
      "subtitle_id": 221,
      "start": 448.16,
      "end": 451.759,
      "text": "अब इसके बाद जो मेन सवाल आता है, वह यह है"
    },
    {
      "subtitle_id": 222,
      "start": 450.0,
      "end": 453.36,
      "text": "कि जो कई सारे बड़े-बड़े इन्वेस्टर्स हैं,"
    },
    {
      "subtitle_id": 223,
      "start": 451.759,
      "end": 455.28,
      "text": "वो एनएसडीएल के पास से क्यों जा रहे हैं?"
    },
    {
      "subtitle_id": 224,
      "start": 453.36,
      "end": 457.28,
      "text": "सीडीएसएल के पास क्यों नहीं? यह भी तो"
    },
    {
      "subtitle_id": 225,
      "start": 455.28,
      "end": 459.039,
      "text": "सवाल आना चाहिए। अब इस चीज का एक मेन रीज़न"
    },
    {
      "subtitle_id": 226,
      "start": 457.28,
      "end": 461.12,
      "text": "है। पहले आपको कुछ डाटा बताता हूं कि"
    },
    {
      "subtitle_id": 227,
      "start": 459.039,
      "end": 462.88,
      "text": "99.99%"
    },
    {
      "subtitle_id": 228,
      "start": 461.12,
      "end": 465.52,
      "text": "फॉरेन इंस्टीट्यूशनल इन्वेस्टर्स यानी"
    },
    {
      "subtitle_id": 229,
      "start": 462.88,
      "end": 467.599,
      "text": "एफआईआई एनएसडीएल के साथ हैं। बस एनएसडीएल"
    },
    {
      "subtitle_id": 230,
      "start": 465.52,
      "end": 469.36,
      "text": "के। और यह वही प्लेयर है जो बहुत तेजी से"
    },
    {
      "subtitle_id": 231,
      "start": 467.599,
      "end": 470.96,
      "text": "अगर मार्केट में शेयर्स बेचना शुरू करते"
    },
    {
      "subtitle_id": 232,
      "start": 469.36,
      "end": 472.4,
      "text": "हैं तो मार्केट भी गिर जाता है। तो हमने"
    },
    {
      "subtitle_id": 233,
      "start": 470.96,
      "end": 474.56,
      "text": "सोचा कि यह पता करना तो जरूरी है कि"
    },
    {
      "subtitle_id": 234,
      "start": 472.4,
      "end": 476.24,
      "text": "एफआईआई एनएसएल के पास ही क्यों है। अब"
    },
    {
      "subtitle_id": 235,
      "start": 474.56,
      "end": 478.319,
      "text": "इसके लिए हमने एनएसएल के एनुअल रिपोर्ट"
    },
    {
      "subtitle_id": 236,
      "start": 476.24,
      "end": 480.08,
      "text": "देखे। उनके आईपीओ पेपर्स देखे। कहीं पर भी"
    },
    {
      "subtitle_id": 237,
      "start": 478.319,
      "end": 482.639,
      "text": "जवाब नहीं था। पर इसका जवाब हमें एक"
    },
    {
      "subtitle_id": 238,
      "start": 480.08,
      "end": 484.479,
      "text": "अनएक्सेक्टेड जगह से मिला। वो था लास्ट"
    },
    {
      "subtitle_id": 239,
      "start": 482.639,
      "end": 486.319,
      "text": "क्वार्टर का सीडीएसएल का कॉन कॉल यानी"
    },
    {
      "subtitle_id": 240,
      "start": 484.479,
      "end": 488.08,
      "text": "कॉन्फ्रेंस कॉल। एक एनालिस्ट ने वहां पर"
    },
    {
      "subtitle_id": 241,
      "start": 486.319,
      "end": 490.08,
      "text": "मैनेजमेंट से पूछा कि बिग प्लेयर्स"
    },
    {
      "subtitle_id": 242,
      "start": 488.08,
      "end": 491.28,
      "text": "एनएसडीएल के पास क्यों जा रहे और सीडीएसएल"
    },
    {
      "subtitle_id": 243,
      "start": 490.08,
      "end": 492.96,
      "text": "के पास क्यों नहीं? तो इसका जवाब"
    },
    {
      "subtitle_id": 244,
      "start": 491.28,
      "end": 495.12,
      "text": "मैनेजमेंट ने बड़े अच्छे तरीके से दिया कि"
    },
    {
      "subtitle_id": 245,
      "start": 492.96,
      "end": 497.68,
      "text": "हिस्टोरिकली सिर्फ एनएसडीएल को अलाउ किया"
    },
    {
      "subtitle_id": 246,
      "start": 495.12,
      "end": 499.919,
      "text": "गया है टू इशू आईएसआईएन नंबर। अब यह"
    },
    {
      "subtitle_id": 247,
      "start": 497.68,
      "end": 501.599,
      "text": "आईएसआईए नंबर क्या होता है? तो आईएसएन"
    },
    {
      "subtitle_id": 248,
      "start": 499.919,
      "end": 504.4,
      "text": "नंबर और इंटरनेशनल सिक्योरिटीज"
    },
    {
      "subtitle_id": 249,
      "start": 501.599,
      "end": 506.08,
      "text": "आइडेंटिफिकेशन नंबर यह 12 डिजिट का यूनिक"
    },
    {
      "subtitle_id": 250,
      "start": 504.4,
      "end": 507.599,
      "text": "अल्फा न्यूमेरिक कोड होता है जो हर"
    },
    {
      "subtitle_id": 251,
      "start": 506.08,
      "end": 509.44,
      "text": "सिक्योरिटी के लिए अलग-अलग होता है। यानी"
    },
    {
      "subtitle_id": 252,
      "start": 507.599,
      "end": 511.12,
      "text": "स्टॉक्स के लिए अलग, बॉन्ड्स के लिए अलग।"
    },
    {
      "subtitle_id": 253,
      "start": 509.44,
      "end": 513.279,
      "text": "तो ग्लोबल इन्वेस्टिंग और ट्रेडिंग में यह"
    },
    {
      "subtitle_id": 254,
      "start": 511.12,
      "end": 515.2,
      "text": "एक बहुत ही क्रूशियल टूल है। और यह आईएसए"
    },
    {
      "subtitle_id": 255,
      "start": 513.279,
      "end": 517.2,
      "text": "नंबर हर एक सिक्योरिटी का एक यूनिक आईडी"
    },
    {
      "subtitle_id": 256,
      "start": 515.2,
      "end": 518.8,
      "text": "है जैसे कि इंसानों का आधार कार्ड है"
    },
    {
      "subtitle_id": 257,
      "start": 517.2,
      "end": 520.399,
      "text": "इंडिया में। तो जब फॉरेन इंस्टीट्यूशन"
    },
    {
      "subtitle_id": 258,
      "start": 518.8,
      "end": 522.8,
      "text": "इन्वेस्टर्स ने पहले इन्वेस्ट करना शुरू"
    },
    {
      "subtitle_id": 259,
      "start": 520.399,
      "end": 525.12,
      "text": "किया मिड 1990 में इंडिया में तो एनएसडीएल"
    },
    {
      "subtitle_id": 260,
      "start": 522.8,
      "end": 526.88,
      "text": "एक ऐसी इकलौती डिपॉजिटरी थी जो आईएसआई"
    },
    {
      "subtitle_id": 261,
      "start": 525.12,
      "end": 528.399,
      "text": "इंश्योरिंग अथॉरिटी थी और ऑपरेशनल"
    },
    {
      "subtitle_id": 262,
      "start": 526.88,
      "end": 530.48,
      "text": "इंफ्रास्ट्रक्चर भी उन्हीं के पास था। तो"
    },
    {
      "subtitle_id": 263,
      "start": 528.399,
      "end": 532.32,
      "text": "एफआईएस को सबसे पहली स्टेप यह करनी पड़ती"
    },
    {
      "subtitle_id": 264,
      "start": 530.48,
      "end": 534.32,
      "text": "थी कि एनएसडीएल के पास अपना डीमेट अकाउंट"
    },
    {
      "subtitle_id": 265,
      "start": 532.32,
      "end": 536.8,
      "text": "खोलना पड़ता था। बिकॉज़ सीडीएसएल जो थोड़ा"
    },
    {
      "subtitle_id": 266,
      "start": 534.32,
      "end": 539.12,
      "text": "बाद में शुरू हुआ 1996 में उसके पास यह"
    },
    {
      "subtitle_id": 267,
      "start": 536.8,
      "end": 540.959,
      "text": "अथॉरिटी नहीं थी आईए साइन इशू करने की। और"
    },
    {
      "subtitle_id": 268,
      "start": 539.12,
      "end": 542.64,
      "text": "फिर एफआई के लिए क्लियर था कि अगर हमें"
    },
    {
      "subtitle_id": 269,
      "start": 540.959,
      "end": 544.32,
      "text": "इंडियन मार्केट में आना है तो एनएसडीएल के"
    },
    {
      "subtitle_id": 270,
      "start": 542.64,
      "end": 546.08,
      "text": "पास ही डीमेट अकाउंट खुलना है। और उसी"
    },
    {
      "subtitle_id": 271,
      "start": 544.32,
      "end": 548.399,
      "text": "हिसाब से उन्होंने अपनी सारी सिस्टम्स"
    },
    {
      "subtitle_id": 272,
      "start": 546.08,
      "end": 550.64,
      "text": "एनएसडीएल के अकॉर्डिंग इंटीग्रेट की। अब"
    },
    {
      "subtitle_id": 273,
      "start": 548.399,
      "end": 553.44,
      "text": "हालांकि CDSL को अभी अथॉरिटी मिल गई है"
    },
    {
      "subtitle_id": 274,
      "start": 550.64,
      "end": 556.0,
      "text": "लेकिन ऑलरेडी जो कंपनीज़ हैं वह ऑलरेडी"
    },
    {
      "subtitle_id": 275,
      "start": 553.44,
      "end": 557.92,
      "text": "उनका सिस्टम बैठ चुका है। सारी चीजें सही"
    },
    {
      "subtitle_id": 276,
      "start": 556.0,
      "end": 559.68,
      "text": "है तो वह स्विच करने का नहीं देख रहे"
    },
    {
      "subtitle_id": 277,
      "start": 557.92,
      "end": 561.44,
      "text": "क्योंकि अंतर कुछ ज्यादा नहीं है दोनों"
    },
    {
      "subtitle_id": 278,
      "start": 559.68,
      "end": 562.88,
      "text": "में और ऑलरेडी सिस्टम बैठा है तो क्यों"
    },
    {
      "subtitle_id": 279,
      "start": 561.44,
      "end": 565.68,
      "text": "बाहर जाए और इसीलिए इंडिया के ऑलमोस्ट"
    },
    {
      "subtitle_id": 280,
      "start": 562.88,
      "end": 567.2,
      "text": "सारे एफआई और एफपीआई अकाउंट एनएसडीएल के"
    },
    {
      "subtitle_id": 281,
      "start": 565.68,
      "end": 568.959,
      "text": "पास है। अब बात करते हैं कंपनी के"
    },
    {
      "subtitle_id": 282,
      "start": 567.2,
      "end": 571.6,
      "text": "वैल्यू्यूएशन की और कंपनी का वैल्यू्यूएशन"
    },
    {
      "subtitle_id": 283,
      "start": 568.959,
      "end": 574.48,
      "text": "एट एनी लेवल कैन बी जस्टिफाइड विद दिस"
    },
    {
      "subtitle_id": 284,
      "start": 571.6,
      "end": 576.64,
      "text": "वनेंट थिंग वो है कंपनी की बिजनेस ग्रोथ"
    },
    {
      "subtitle_id": 285,
      "start": 574.48,
      "end": 578.56,
      "text": "और कंपनी की प्रॉफिट ग्रोथ। पीई रेशियो"
    },
    {
      "subtitle_id": 286,
      "start": 576.64,
      "end": 581.12,
      "text": "अगर 100 का भी है तो दिक्कत नहीं है। अगर"
    },
    {
      "subtitle_id": 287,
      "start": 578.56,
      "end": 584.0,
      "text": "कंपनी की ग्रोथ 70-80% की हो। पर अगर"
    },
    {
      "subtitle_id": 288,
      "start": 581.12,
      "end": 587.04,
      "text": "कंपनी 15-20% से ग्रो करे और कंपनी का पीई"
    },
    {
      "subtitle_id": 289,
      "start": 584.0,
      "end": 589.04,
      "text": "रेशियो 75 का हो तब अब इसका जवाब आप ही"
    },
    {
      "subtitle_id": 290,
      "start": 587.04,
      "end": 591.44,
      "text": "कमेंट में दीजिए। अब यहां पर एनएसएल की"
    },
    {
      "subtitle_id": 291,
      "start": 589.04,
      "end": 594.08,
      "text": "ग्रोथ की बात करें तो जून 2024 में उनका"
    },
    {
      "subtitle_id": 292,
      "start": 591.44,
      "end": 597.76,
      "text": "एसेट अंडर कस्टडी था 100 लाख करोड़ का जो"
    },
    {
      "subtitle_id": 293,
      "start": 594.08,
      "end": 600.0,
      "text": "कि 30th जून 2025 तक पहुंच चुका है 510"
    },
    {
      "subtitle_id": 294,
      "start": 597.76,
      "end": 603.04,
      "text": "लाख करोड़ पर। यानी कि जो सीएजीआर ग्रोथ"
    },
    {
      "subtitle_id": 295,
      "start": 600.0,
      "end": 605.36,
      "text": "है एसेट अंडर कस्टडी में वो है 16% की।"
    },
    {
      "subtitle_id": 296,
      "start": 603.04,
      "end": 606.88,
      "text": "इसका जो एक सबसे बड़ा कारण है वो यह है कि"
    },
    {
      "subtitle_id": 297,
      "start": 605.36,
      "end": 608.72,
      "text": "म्यूच्यूल फंड इंडस्ट्री का एसेट अंडर"
    },
    {
      "subtitle_id": 298,
      "start": 606.88,
      "end": 611.04,
      "text": "मैनेजमेंट पिछले कुछ सालों में बहुत बड़ा"
    },
    {
      "subtitle_id": 299,
      "start": 608.72,
      "end": 613.12,
      "text": "है और फिलहाल ऑल टाइम हाई पर चल रहा है 72"
    },
    {
      "subtitle_id": 300,
      "start": 611.04,
      "end": 615.2,
      "text": "लाख करोड़ पर और जो भी ये म्यूच्यूल फंड"
    },
    {
      "subtitle_id": 301,
      "start": 613.12,
      "end": 617.12,
      "text": "कंपनीज़ हैं लगभग इनके सारे के सारे डीमेट"
    },
    {
      "subtitle_id": 302,
      "start": 615.2,
      "end": 619.04,
      "text": "अकाउंट्स कहीं पर है तो वो है एनएसएल के"
    },
    {
      "subtitle_id": 303,
      "start": 617.12,
      "end": 620.72,
      "text": "पास तो इस चीज का भी एनएसडीएल को फायदा"
    },
    {
      "subtitle_id": 304,
      "start": 619.04,
      "end": 622.399,
      "text": "मिला है। पर क्या यह ग्रोथ कंपनी के"
    },
    {
      "subtitle_id": 305,
      "start": 620.72,
      "end": 624.24,
      "text": "प्रॉफिट में दिखाई दी है? इसलिए हमने"
    },
    {
      "subtitle_id": 306,
      "start": 622.399,
      "end": 627.2,
      "text": "कंपनी का प्रॉफिट देखा पिछले 7 आठ सालों"
    },
    {
      "subtitle_id": 307,
      "start": 624.24,
      "end": 629.36,
      "text": "का। सो 2018 से लेके 2025 जिसमें कोविड"
    },
    {
      "subtitle_id": 308,
      "start": 627.2,
      "end": 631.6,
      "text": "पीरियड भी आ गया। इस दौरान एनएसडीएल का जो"
    },
    {
      "subtitle_id": 309,
      "start": 629.36,
      "end": 634.88,
      "text": "नेट प्रॉफिट है वह कंपाउंडेड सालाना 20%"
    },
    {
      "subtitle_id": 310,
      "start": 631.6,
      "end": 636.48,
      "text": "से बढ़ा है और सीडीएसएल का इसी दौरान 29%"
    },
    {
      "subtitle_id": 311,
      "start": 634.88,
      "end": 638.079,
      "text": "से बढ़ा है। तो सवाल यह आता है कि जो"
    },
    {
      "subtitle_id": 312,
      "start": 636.48,
      "end": 640.56,
      "text": "इंस्टीट्यूशनल इन्वेस्टर्स हैं जिसमें फिर"
    },
    {
      "subtitle_id": 313,
      "start": 638.079,
      "end": 642.0,
      "text": "एफआई हो, एफपीआई हो या फिर डोमेस्टिक"
    },
    {
      "subtitle_id": 314,
      "start": 640.56,
      "end": 643.76,
      "text": "इंस्टीट्यूशनल इन्वेस्टर्स हो म्यूच्यूल"
    },
    {
      "subtitle_id": 315,
      "start": 642.0,
      "end": 646.079,
      "text": "फंड वगैरह जैसे क्या इसी तरह के इनकी"
    },
    {
      "subtitle_id": 316,
      "start": 643.76,
      "end": 648.0,
      "text": "ग्रोथ जारी रहेगी? ये एक बड़ा सवाल है।"
    },
    {
      "subtitle_id": 317,
      "start": 646.079,
      "end": 650.32,
      "text": "क्योंकि इसी ग्रोथ पर एनएसडीएल की ग्रोथ"
    },
    {
      "subtitle_id": 318,
      "start": 648.0,
      "end": 652.24,
      "text": "भी काफी हद तक निर्भर है। और जैसे कि हमने"
    },
    {
      "subtitle_id": 319,
      "start": 650.32,
      "end": 654.0,
      "text": "बात की एनएसएल अपने पेमेंट बैंक बिज़नेस से"
    },
    {
      "subtitle_id": 320,
      "start": 652.24,
      "end": 655.839,
      "text": "भी अच्छा खासा बिजनेस वहां पर कर रही है।"
    },
    {
      "subtitle_id": 321,
      "start": 654.0,
      "end": 657.6,
      "text": "तो वहां पर वो किस तरह की परफॉर्मेंस देते"
    },
    {
      "subtitle_id": 322,
      "start": 655.839,
      "end": 659.2,
      "text": "हैं? इस चीज को भी आपको ट्रैक रखना"
    },
    {
      "subtitle_id": 323,
      "start": 657.6,
      "end": 661.68,
      "text": "पड़ेगा। तो इन सारी चीजों को देखते हुए"
    },
    {
      "subtitle_id": 324,
      "start": 659.2,
      "end": 664.24,
      "text": "प्रॉफिट के 75 टाइम्स कंपनी का मार्केट"
    },
    {
      "subtitle_id": 325,
      "start": 661.68,
      "end": 665.92,
      "text": "कैप होना यानी 75 का कंपनी का पीई होना"
    },
    {
      "subtitle_id": 326,
      "start": 664.24,
      "end": 668.079,
      "text": "क्या आपको लगता है जस्टिफाइड है बाय"
    },
    {
      "subtitle_id": 327,
      "start": 665.92,
      "end": 670.56,
      "text": "टेकिंग इंटू द अकाउंट द करंट ग्रोथ एंड द"
    },
    {
      "subtitle_id": 328,
      "start": 668.079,
      "end": 672.16,
      "text": "फ्यूचर ग्रोथ ऑफ द कंपनी नीचे कमेंट करके"
    },
    {
      "subtitle_id": 329,
      "start": 670.56,
      "end": 674.16,
      "text": "जरूर बताइए। मिलते हैं अगले वीडियो में और"
    },
    {
      "subtitle_id": 330,
      "start": 672.16,
      "end": 676.32,
      "text": "जाते-जाते हमारे फंडामेंटल एनालिसिस 3.0"
    },
    {
      "subtitle_id": 331,
      "start": 674.16,
      "end": 678.0,
      "text": "को जरूर चेक आउट कीजिए। यह ऑफर आपको"
    },
    {
      "subtitle_id": 332,
      "start": 676.32,
      "end": 679.44,
      "text": "दोबारा नहीं मिलेगी। यह प्राइस आपको"
    },
    {
      "subtitle_id": 333,
      "start": 678.0,
      "end": 683.24,
      "text": "दोबारा नहीं मिलेगी। मिलते हैं अगले"
    },
    {
      "subtitle_id": 334,
      "start": 679.44,
      "end": 683.24,
      "text": "वीडियो में। थैंक यू सो मच।"
    }
  ]
}