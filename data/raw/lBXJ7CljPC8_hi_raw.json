  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.08,
      "end": 4.799,
      "text": "एक छोटी सी चिंगारी और 50 करोड़ का काला"
    },
    {
      "subtitle_id": 2,
      "start": 2.72,
      "end": 6.799,
      "text": "धन खाक। हां, ऐसा ही कुछ हुआ है हमारे देश"
    },
    {
      "subtitle_id": 3,
      "start": 4.799,
      "end": 9.04,
      "text": "के कैपिटल में। दिल्ली हाईकोर्ट के जज"
    },
    {
      "subtitle_id": 4,
      "start": 6.799,
      "end": 11.44,
      "text": "यशवंत वर्मा के घर में आग लगती है। आग"
    },
    {
      "subtitle_id": 5,
      "start": 9.04,
      "end": 13.679,
      "text": "काफी फैलने लगती है। तब घर में मौजूद कुछ"
    },
    {
      "subtitle_id": 6,
      "start": 11.44,
      "end": 16.24,
      "text": "लोग फायर ब्रिगेड को कॉल करते हैं। फायर"
    },
    {
      "subtitle_id": 7,
      "start": 13.679,
      "end": 18.96,
      "text": "ब्रिगेड वहां पर पहुंच जाती है और जो वो"
    },
    {
      "subtitle_id": 8,
      "start": 16.24,
      "end": 21.52,
      "text": "देखते हैं देखकर दंग रह जाते हैं। सामने"
    },
    {
      "subtitle_id": 9,
      "start": 18.96,
      "end": 23.439,
      "text": "थी बोरी भर-भर के जली हुई कैश। इसके बाद"
    },
    {
      "subtitle_id": 10,
      "start": 21.52,
      "end": 26.4,
      "text": "पूरे देश में ये न्यूज़ फैल गई। हर जगह"
    },
    {
      "subtitle_id": 11,
      "start": 23.439,
      "end": 28.48,
      "text": "सोशल मीडिया, टीवी चैनल हर जगह पर इसी बात"
    },
    {
      "subtitle_id": 12,
      "start": 26.4,
      "end": 30.16,
      "text": "के चर्चे होने लगे। जब मैं संडे को यह"
    },
    {
      "subtitle_id": 13,
      "start": 28.48,
      "end": 32.32,
      "text": "न्यूज़ देख रहा था, तो देखते-देखते मेरे"
    },
    {
      "subtitle_id": 14,
      "start": 30.16,
      "end": 36.16,
      "text": "दिमाग में एक सवाल आया कि इतनी बड़ी कैश"
    },
    {
      "subtitle_id": 15,
      "start": 32.32,
      "end": 37.92,
      "text": "₹50 करोड़ इस जज के पास आखिर आई कैसे? अब"
    },
    {
      "subtitle_id": 16,
      "start": 36.16,
      "end": 40.64,
      "text": "इंडिया में ज्यादातर पैसा तीन लोगों के"
    },
    {
      "subtitle_id": 17,
      "start": 37.92,
      "end": 43.36,
      "text": "पास है। बिजनेसमैन के पास, सेलिब्रिटीज के"
    },
    {
      "subtitle_id": 18,
      "start": 40.64,
      "end": 45.44,
      "text": "पास और पॉलिटिशियंस के पास। यानी कि ₹50"
    },
    {
      "subtitle_id": 19,
      "start": 43.36,
      "end": 47.52,
      "text": "करोड़ या तो किसी पॉलिटिशियन से कनेक्टेड"
    },
    {
      "subtitle_id": 20,
      "start": 45.44,
      "end": 49.52,
      "text": "है या फिर किसी बिजनेसमैन या सेलिब्रिटी"
    },
    {
      "subtitle_id": 21,
      "start": 47.52,
      "end": 51.36,
      "text": "से कनेक्टेड है। जब मैंने इंटरनेट पर जज"
    },
    {
      "subtitle_id": 22,
      "start": 49.52,
      "end": 53.199,
      "text": "यशवंत वर्मा के बारे में रिसर्च शुरू की"
    },
    {
      "subtitle_id": 23,
      "start": 51.36,
      "end": 55.039,
      "text": "तो एक बहुत ही इंटरेस्टिंग और शॉकिंग चीज"
    },
    {
      "subtitle_id": 24,
      "start": 53.199,
      "end": 56.719,
      "text": "मुझे पता चली कि ये जो जज है इन्होंने"
    },
    {
      "subtitle_id": 25,
      "start": 55.039,
      "end": 58.719,
      "text": "ढेरों सारे हाई प्रोफाइल कॉर्पोरेट"
    },
    {
      "subtitle_id": 26,
      "start": 56.719,
      "end": 60.8,
      "text": "डिस्प्यूट्स और टैक्स रिलेटेड केसेस में"
    },
    {
      "subtitle_id": 27,
      "start": 58.719,
      "end": 62.719,
      "text": "जजमेंट दिया है। और इस वीडियो में मैं"
    },
    {
      "subtitle_id": 28,
      "start": 60.8,
      "end": 65.04,
      "text": "पांच ऐसे हाई प्रोफाइल केसेस की डिटेल में"
    },
    {
      "subtitle_id": 29,
      "start": 62.719,
      "end": 67.439,
      "text": "बात करूंगा जिनके ऊपर जज यशवंत वर्मा ने"
    },
    {
      "subtitle_id": 30,
      "start": 65.04,
      "end": 69.439,
      "text": "जजमेंट सुनाए हैं। अब इन केसेस में दो ऐसी"
    },
    {
      "subtitle_id": 31,
      "start": 67.439,
      "end": 71.28,
      "text": "कंपनीज़ के भी नाम है जो स्टॉक एक्सचेंज पर"
    },
    {
      "subtitle_id": 32,
      "start": 69.439,
      "end": 72.88,
      "text": "लिस्टेड हैं। अब देखिए अब यहां पर मेरा यह"
    },
    {
      "subtitle_id": 33,
      "start": 71.28,
      "end": 74.96,
      "text": "मतलब नहीं कि मैं किसी कंपनी पर इल्जाम"
    },
    {
      "subtitle_id": 34,
      "start": 72.88,
      "end": 77.119,
      "text": "लगा रहा हूं। बट यही है कि सारी चीजें"
    },
    {
      "subtitle_id": 35,
      "start": 74.96,
      "end": 78.88,
      "text": "आपके सामने आए और आप एक बेटर डिसीजन ले"
    },
    {
      "subtitle_id": 36,
      "start": 77.119,
      "end": 80.32,
      "text": "पाओ। इसलिए बहुत ही डिटेल में यहां पर आज"
    },
    {
      "subtitle_id": 37,
      "start": 78.88,
      "end": 81.92,
      "text": "मैं गया हूं। क्योंकि जब मैं ये न्यूज़"
    },
    {
      "subtitle_id": 38,
      "start": 80.32,
      "end": 83.759,
      "text": "देख रहा हूं हर कोई ऊपर ऊपर से बता रहा है"
    },
    {
      "subtitle_id": 39,
      "start": 81.92,
      "end": 85.68,
      "text": "कोई डेप्थ में नहीं जा रहा है कि यह पैसा"
    },
    {
      "subtitle_id": 40,
      "start": 83.759,
      "end": 87.28,
      "text": "आखिर कहां का हो सकता है और उसके बारे में"
    },
    {
      "subtitle_id": 41,
      "start": 85.68,
      "end": 88.799,
      "text": "कोई बात भी नहीं कर रहा है। तो सोचा कि"
    },
    {
      "subtitle_id": 42,
      "start": 87.28,
      "end": 90.72,
      "text": "कोई बात नहीं कर रहा है तो कोई बात नहीं।"
    },
    {
      "subtitle_id": 43,
      "start": 88.799,
      "end": 92.72,
      "text": "हम फिनोवेशंस पर उसके डिटेल में बात करते"
    },
    {
      "subtitle_id": 44,
      "start": 90.72,
      "end": 94.4,
      "text": "हैं। नमस्कार, मैं प्रसाद आपका आज के इस"
    },
    {
      "subtitle_id": 45,
      "start": 92.72,
      "end": 96.079,
      "text": "वीडियो में स्वागत करता हूं। आज के इस"
    },
    {
      "subtitle_id": 46,
      "start": 94.4,
      "end": 98.159,
      "text": "वीडियो के प्रायोजक हैं बोरo जिनके बारे"
    },
    {
      "subtitle_id": 47,
      "start": 96.079,
      "end": 100.079,
      "text": "में हम वीडियो में आगे बात करेंगे। अब जज"
    },
    {
      "subtitle_id": 48,
      "start": 98.159,
      "end": 102.159,
      "text": "यशवंत वर्मा के बारे में बात करें तो यह"
    },
    {
      "subtitle_id": 49,
      "start": 100.079,
      "end": 104.24,
      "text": "मोस्टली कॉर्पोरेट लॉ और टैक्सेशन वगैरह"
    },
    {
      "subtitle_id": 50,
      "start": 102.159,
      "end": 106.079,
      "text": "के केसेस हैंडल करते थे। यहां आपको ज्यादा"
    },
    {
      "subtitle_id": 51,
      "start": 104.24,
      "end": 107.92,
      "text": "शॉक नहीं होगा बिकॉज़ पिछले कुछ सालों से"
    },
    {
      "subtitle_id": 52,
      "start": 106.079,
      "end": 109.92,
      "text": "इंडिया में टैक्स की ही बात हो रही है। तो"
    },
    {
      "subtitle_id": 53,
      "start": 107.92,
      "end": 112.32,
      "text": "मिस्टर वर्मा ने काफी सारे केसेस हैंडल"
    },
    {
      "subtitle_id": 54,
      "start": 109.92,
      "end": 114.88,
      "text": "किए हैं। उसमें से पांच केसेस जो सबसे हाई"
    },
    {
      "subtitle_id": 55,
      "start": 112.32,
      "end": 116.96,
      "text": "प्रोफाइल रही है उनके बारे में हम एक-एक"
    },
    {
      "subtitle_id": 56,
      "start": 114.88,
      "end": 119.04,
      "text": "करके बात करेंगे। तो सबसे पहला जो केस है"
    },
    {
      "subtitle_id": 57,
      "start": 116.96,
      "end": 121.759,
      "text": "वो बड़ा इंटरेस्टिंग है वो है SPI वर्सेस"
    },
    {
      "subtitle_id": 58,
      "start": 119.04,
      "end": 124.399,
      "text": "के एल एयरवेज केस। यह केस स्पाइसेट और"
    },
    {
      "subtitle_id": 59,
      "start": 121.759,
      "end": 126.719,
      "text": "केएल एयरवेज जो कलानिथि मारन की कंपनी है"
    },
    {
      "subtitle_id": 60,
      "start": 124.399,
      "end": 128.399,
      "text": "उनके बीच का है। अगर आप कला मारन को नहीं"
    },
    {
      "subtitle_id": 61,
      "start": 126.719,
      "end": 130.879,
      "text": "जानते हो तो बता दूं कि वह सन ग्रुप के"
    },
    {
      "subtitle_id": 62,
      "start": 128.399,
      "end": 133.12,
      "text": "ओनर हैं। जिनकी डॉटर काव्या मारन को अपनेl"
    },
    {
      "subtitle_id": 63,
      "start": 130.879,
      "end": 134.879,
      "text": "मैचेस के दौरान अपनी सनराइज़र्स हैदराबाद"
    },
    {
      "subtitle_id": 64,
      "start": 133.12,
      "end": 137.68,
      "text": "टीम को सपोर्ट करते हुए जरूर देखा होगा।"
    },
    {
      "subtitle_id": 65,
      "start": 134.879,
      "end": 139.76,
      "text": "तो यह बात शुरू हुई 2015 में जब spiceet"
    },
    {
      "subtitle_id": 66,
      "start": 137.68,
      "end": 141.92,
      "text": "फाइनेंसियल प्रॉब्लम्स फेस करने लगी। उस"
    },
    {
      "subtitle_id": 67,
      "start": 139.76,
      "end": 144.08,
      "text": "समय अजय सिंह जो फिलहाल spice के बॉस हैं,"
    },
    {
      "subtitle_id": 68,
      "start": 141.92,
      "end": 146.44,
      "text": "उन्होंने एयरलाइन को मारन से खरीदा था।"
    },
    {
      "subtitle_id": 69,
      "start": 144.08,
      "end": 148.959,
      "text": "डील यह थी कि मिस्टर मारन के पास का"
    },
    {
      "subtitle_id": 70,
      "start": 146.44,
      "end": 151.319,
      "text": "58.46% शेयर था। इस डील के हिसाब से"
    },
    {
      "subtitle_id": 71,
      "start": 148.959,
      "end": 154.4,
      "text": "मिस्टर मारन और उनकी कंपनी के एयरवेज ने"
    },
    {
      "subtitle_id": 72,
      "start": 151.319,
      "end": 156.319,
      "text": "₹679 करोड़ स्पाइस डेट को दिए थे। लेकिन"
    },
    {
      "subtitle_id": 73,
      "start": 154.4,
      "end": 158.56,
      "text": "प्रॉब्लम तब हुई जब मिस्टर मारन ने कहा कि"
    },
    {
      "subtitle_id": 74,
      "start": 156.319,
      "end": 160.4,
      "text": "ना ही हमें कंपनी के शेयर्स मिले ना ही"
    },
    {
      "subtitle_id": 75,
      "start": 158.56,
      "end": 162.56,
      "text": "हमने कंपनी को दिया हुआ पैसा हमें वापस"
    },
    {
      "subtitle_id": 76,
      "start": 160.4,
      "end": 164.08,
      "text": "मिला। बस यहीं से झगड़ा शुरू हुआ और 2017"
    },
    {
      "subtitle_id": 77,
      "start": 162.56,
      "end": 165.599,
      "text": "में यह मामला दिल्ली हाईकोर्ट में चला"
    },
    {
      "subtitle_id": 78,
      "start": 164.08,
      "end": 167.44,
      "text": "गया। कोर्ट ने कहा कि दोनों पार्टीज"
    },
    {
      "subtitle_id": 79,
      "start": 165.599,
      "end": 169.68,
      "text": "आर्बिट्रेशन यानी एक तरह का प्राइवेट"
    },
    {
      "subtitle_id": 80,
      "start": 167.44,
      "end": 171.599,
      "text": "सेटलमेंट से यह बात सॉल्व करें। 2018 में"
    },
    {
      "subtitle_id": 81,
      "start": 169.68,
      "end": 174.8,
      "text": "आर्बिट्रेशन पैनल ने अपना डिसीजन दे दिया।"
    },
    {
      "subtitle_id": 82,
      "start": 171.599,
      "end": 176.879,
      "text": "मिस्टर मारन को 1323 करोड़ का डैमेज नहीं"
    },
    {
      "subtitle_id": 83,
      "start": 174.8,
      "end": 179.84,
      "text": "मिला जो उन्होंने मांगा था। लेकिन उनको"
    },
    {
      "subtitle_id": 84,
      "start": 176.879,
      "end": 182.319,
      "text": "579 करोड़ का रिफंड प्लस इंटरेस्ट देने का"
    },
    {
      "subtitle_id": 85,
      "start": 179.84,
      "end": 184.64,
      "text": "आर्डर हुआ। स्पाइस डेट के लिए बड़ा झटका"
    },
    {
      "subtitle_id": 86,
      "start": 182.319,
      "end": 186.4,
      "text": "था क्योंकि वह पहले ही फाइनेंसियली कमजोर"
    },
    {
      "subtitle_id": 87,
      "start": 184.64,
      "end": 189.04,
      "text": "थी। उसके बाद देखिए इस केस में और एक टर्न"
    },
    {
      "subtitle_id": 88,
      "start": 186.4,
      "end": 190.879,
      "text": "आता है। जुलाई 2023 में ये केस चला जाता"
    },
    {
      "subtitle_id": 89,
      "start": 189.04,
      "end": 192.4,
      "text": "है दिल्ली हाईकोर्ट में। दिल्ली हाईकोर्ट"
    },
    {
      "subtitle_id": 90,
      "start": 190.879,
      "end": 194.8,
      "text": "के सिंगल बेंच के जज ने कहा कि"
    },
    {
      "subtitle_id": 91,
      "start": 192.4,
      "end": 197.599,
      "text": "आर्बिट्रेशन का डिसीजन सही है और स्पाइसेट"
    },
    {
      "subtitle_id": 92,
      "start": 194.8,
      "end": 199.599,
      "text": "को पैसे वापस करने पड़ेंगे। इसके बाद मई"
    },
    {
      "subtitle_id": 93,
      "start": 197.599,
      "end": 201.84,
      "text": "2024 में स्पाइसेट ने डिसीजन के अगेंस्ट"
    },
    {
      "subtitle_id": 94,
      "start": 199.599,
      "end": 204.4,
      "text": "अपील की और केस पहुंचा दिल्ली हाईकोर्ट के"
    },
    {
      "subtitle_id": 95,
      "start": 201.84,
      "end": 206.879,
      "text": "डिवीजन बेंच के पास। अब यहां पर यह केस"
    },
    {
      "subtitle_id": 96,
      "start": 204.4,
      "end": 209.44,
      "text": "बहुत इंटरेस्टिंग बन जाता है। डिवीजन बेंच"
    },
    {
      "subtitle_id": 97,
      "start": 206.879,
      "end": 212.159,
      "text": "में दो जजेस थे। पहले थे जस्टिस यशवंत"
    },
    {
      "subtitle_id": 98,
      "start": 209.44,
      "end": 214.959,
      "text": "वर्मा और दूसरे थे रविंद्र दुदेजा। तो"
    },
    {
      "subtitle_id": 99,
      "start": 212.159,
      "end": 217.12,
      "text": "इन्होंने क्या किया कि जो सिंगल जज का"
    },
    {
      "subtitle_id": 100,
      "start": 214.959,
      "end": 220.4,
      "text": "आर्डर था जो कि स्पाइसेट के अगेंस्ट में"
    },
    {
      "subtitle_id": 101,
      "start": 217.12,
      "end": 222.4,
      "text": "आया था उसे खारिज कर दिया और यह केस वापस"
    },
    {
      "subtitle_id": 102,
      "start": 220.4,
      "end": 224.64,
      "text": "उन्होंने सिंगल जज के पास भेज दिया यह कह"
    },
    {
      "subtitle_id": 103,
      "start": 222.4,
      "end": 227.04,
      "text": "के कि फिर से इस मामले में सुनवाई चालू"
    },
    {
      "subtitle_id": 104,
      "start": 224.64,
      "end": 228.799,
      "text": "हो। यानी केस थोड़ा और लंबा हो गया। लेकिन"
    },
    {
      "subtitle_id": 105,
      "start": 227.04,
      "end": 231.36,
      "text": "मिस्टर मारन भी कहां मानने वाले थे? वो"
    },
    {
      "subtitle_id": 106,
      "start": 228.799,
      "end": 233.12,
      "text": "जुलाई 2024 में इस डिसीजन के खिलाफ सीधा"
    },
    {
      "subtitle_id": 107,
      "start": 231.36,
      "end": 234.64,
      "text": "सुप्रीम कोर्ट चले गए। अब सुप्रीम कोर्ट"
    },
    {
      "subtitle_id": 108,
      "start": 233.12,
      "end": 236.72,
      "text": "में क्या हुआ? अब सुप्रीम कोर्ट ने भी"
    },
    {
      "subtitle_id": 109,
      "start": 234.64,
      "end": 239.2,
      "text": "स्पाइसेट के फेवर में डिसीजन दिया कि यह"
    },
    {
      "subtitle_id": 110,
      "start": 236.72,
      "end": 241.519,
      "text": "केस फिर से सिंगल बेंच हाईकोर्ट में"
    },
    {
      "subtitle_id": 111,
      "start": 239.2,
      "end": 243.519,
      "text": "दोबारा चलना चाहिए। तो इस तरह से यह केस"
    },
    {
      "subtitle_id": 112,
      "start": 241.519,
      "end": 246.0,
      "text": "अभी भी चल रहा है और दिल्ली हाईकोर्ट में"
    },
    {
      "subtitle_id": 113,
      "start": 243.519,
      "end": 247.92,
      "text": "नए जज के पास यह केस वापस आ गया है। और"
    },
    {
      "subtitle_id": 114,
      "start": 246.0,
      "end": 249.76,
      "text": "मामला अभी भी चल रहा है क्योंकि कोर्ट में"
    },
    {
      "subtitle_id": 115,
      "start": 247.92,
      "end": 252.08,
      "text": "फैसले एक दिन में डिलीवर नहीं होते हैं।"
    },
    {
      "subtitle_id": 116,
      "start": 249.76,
      "end": 254.159,
      "text": "यह सालों साल चलते हैं। लेकिन एक चीज है"
    },
    {
      "subtitle_id": 117,
      "start": 252.08,
      "end": 256.799,
      "text": "जो सेम डे डिलीवर हो सकती है और वो है"
    },
    {
      "subtitle_id": 118,
      "start": 254.159,
      "end": 259.04,
      "text": "आपका कूरियर। यस, Borzo फॉर्मरली नोन एस"
    },
    {
      "subtitle_id": 119,
      "start": 256.799,
      "end": 261.12,
      "text": "वीफास्ट अब आपके पैकेजेस सिंगल डे में"
    },
    {
      "subtitle_id": 120,
      "start": 259.04,
      "end": 263.12,
      "text": "डिलीवर करता है। Borzo कॉस्ट इफेक्टिव"
    },
    {
      "subtitle_id": 121,
      "start": 261.12,
      "end": 265.12,
      "text": "होने के साथ-साथ एक रिलायबल टू व्हीलर"
    },
    {
      "subtitle_id": 122,
      "start": 263.12,
      "end": 267.28,
      "text": "डिलीवरी सलूशन भी प्रोवाइड करता है इन"
    },
    {
      "subtitle_id": 123,
      "start": 265.12,
      "end": 269.84,
      "text": "मुंबई एंड दिल्ली सिटी एरियाज। भले ही आप"
    },
    {
      "subtitle_id": 124,
      "start": 267.28,
      "end": 272.0,
      "text": "छोटा बिजनेस चला रहे हो, प्रोफेशनल हो या"
    },
    {
      "subtitle_id": 125,
      "start": 269.84,
      "end": 274.4,
      "text": "फिर ऑनलाइन सेलर हो। जिनके पास डेडिकेटेड"
    },
    {
      "subtitle_id": 126,
      "start": 272.0,
      "end": 276.56,
      "text": "लॉजिस्टिक टीम नहीं है पर आपको सेम डे"
    },
    {
      "subtitle_id": 127,
      "start": 274.4,
      "end": 278.96,
      "text": "डिलीवरी की जरूरत है। तो BZO से आपका काम"
    },
    {
      "subtitle_id": 128,
      "start": 276.56,
      "end": 281.6,
      "text": "100% बन जाएगा। और यहां पर इनकी जो कॉस्ट"
    },
    {
      "subtitle_id": 129,
      "start": 278.96,
      "end": 283.759,
      "text": "है वह भी कंपिटिटर्स के मुकाबले 30% तक कम"
    },
    {
      "subtitle_id": 130,
      "start": 281.6,
      "end": 286.0,
      "text": "है। Borzo ऑन टाइम पिकअप और डिलीवरी।"
    },
    {
      "subtitle_id": 131,
      "start": 283.759,
      "end": 288.16,
      "text": "दोनों सर्विसेस आपको प्रोवाइड करती है विद"
    },
    {
      "subtitle_id": 132,
      "start": 286.0,
      "end": 290.16,
      "text": "ऑप्शन ऑफ रियल टाइम ट्रैकिंग जिससे आप"
    },
    {
      "subtitle_id": 133,
      "start": 288.16,
      "end": 292.4,
      "text": "अपने पैकेजेस को बड़े ही आसानी से कभी भी"
    },
    {
      "subtitle_id": 134,
      "start": 290.16,
      "end": 294.08,
      "text": "ट्रैक कर सकते हो। साथ ही आपको एंड ऑफ डे"
    },
    {
      "subtitle_id": 135,
      "start": 292.4,
      "end": 296.16,
      "text": "डिलीवरी ऑप्शन भी मिलता है। यानी आपका"
    },
    {
      "subtitle_id": 136,
      "start": 294.08,
      "end": 298.639,
      "text": "पार्सल एंड ऑफ डे ही डिलीवर हो जाता है।"
    },
    {
      "subtitle_id": 137,
      "start": 296.16,
      "end": 300.88,
      "text": "जो ऑन डिमांड डिलीवरी सर्विज से 40% तक"
    },
    {
      "subtitle_id": 138,
      "start": 298.639,
      "end": 303.04,
      "text": "सस्ता पड़ता है। अगर आपका काम बहुत ज्यादा"
    },
    {
      "subtitle_id": 139,
      "start": 300.88,
      "end": 304.88,
      "text": "डिलीवरीज का है तो बोजo आपको एक डेडिकेटेड"
    },
    {
      "subtitle_id": 140,
      "start": 303.04,
      "end": 306.88,
      "text": "सपोर्ट और पर्सनलाइज ऑर्डर मैनेजमेंट"
    },
    {
      "subtitle_id": 141,
      "start": 304.88,
      "end": 308.56,
      "text": "सर्विस भी आपको प्रोवाइड करता है। और किसी"
    },
    {
      "subtitle_id": 142,
      "start": 306.88,
      "end": 310.16,
      "text": "महीने में आपकी 10 से ज्यादा ऑर्डर्स हो"
    },
    {
      "subtitle_id": 143,
      "start": 308.56,
      "end": 312.24,
      "text": "जाती है तो उसमें आपको एक स्पेशल"
    },
    {
      "subtitle_id": 144,
      "start": 310.16,
      "end": 313.759,
      "text": "डिस्काउंट भी मिलता है। तो अभी इंतजार किस"
    },
    {
      "subtitle_id": 145,
      "start": 312.24,
      "end": 315.6,
      "text": "चीज का? अभी डिस्क्रिप्शन और कमेंट में दी"
    },
    {
      "subtitle_id": 146,
      "start": 313.759,
      "end": 317.84,
      "text": "गई लिंक पर क्लिक करके BZO ऐप डाउनलोड"
    },
    {
      "subtitle_id": 147,
      "start": 315.6,
      "end": 319.759,
      "text": "कीजिए। और अगर आप मेरा कोड प्रसाद 50 यूज"
    },
    {
      "subtitle_id": 148,
      "start": 317.84,
      "end": 321.84,
      "text": "करेंगे तो पहली तीन डिलीवरीज पर आपको"
    },
    {
      "subtitle_id": 149,
      "start": 319.759,
      "end": 324.08,
      "text": "फ्लैट 50% का डिस्काउंट मिलेगा। तो अभी"
    },
    {
      "subtitle_id": 150,
      "start": 321.84,
      "end": 326.24,
      "text": "जाके BZO को चेक आउट कीजिए क्योंकि BZO से"
    },
    {
      "subtitle_id": 151,
      "start": 324.08,
      "end": 327.919,
      "text": "ज्यादा आसान, अफोर्डेबल और सिक्योर सर्विस"
    },
    {
      "subtitle_id": 152,
      "start": 326.24,
      "end": 329.68,
      "text": "प्रोवाइड करने वाली सर्विस आपको नहीं"
    },
    {
      "subtitle_id": 153,
      "start": 327.919,
      "end": 331.6,
      "text": "मिलेगी। चलिए बात करते हैं नेक्स्ट"
    },
    {
      "subtitle_id": 154,
      "start": 329.68,
      "end": 333.68,
      "text": "इंटरेस्टिंग केस की। यानी कि केस बड़ा"
    },
    {
      "subtitle_id": 155,
      "start": 331.6,
      "end": 335.68,
      "text": "सिंपल है। कलानी थी मार ने spice को पैसे"
    },
    {
      "subtitle_id": 156,
      "start": 333.68,
      "end": 337.44,
      "text": "दिए थे। पैसों के बदले में उन्हें शेयर्स"
    },
    {
      "subtitle_id": 157,
      "start": 335.68,
      "end": 339.52,
      "text": "नहीं मिले। ना ही वह पैसा वापस मिला। वो"
    },
    {
      "subtitle_id": 158,
      "start": 337.44,
      "end": 342.16,
      "text": "कोर्ट गए। तो पहली बार तो कोर्ट ने बताया"
    },
    {
      "subtitle_id": 159,
      "start": 339.52,
      "end": 344.56,
      "text": "कि हां भाई spiceet तुम पैसा वापस करो। तो"
    },
    {
      "subtitle_id": 160,
      "start": 342.16,
      "end": 346.32,
      "text": "spiceet डिवीजन बेंच के पास आया। डिवीजन"
    },
    {
      "subtitle_id": 161,
      "start": 344.56,
      "end": 348.639,
      "text": "बेंच ने बोला कि नहीं स्पाइस जेट बराबर"
    },
    {
      "subtitle_id": 162,
      "start": 346.32,
      "end": 350.479,
      "text": "है। कोई पैसा वापस करने की जरूरत नहीं है।"
    },
    {
      "subtitle_id": 163,
      "start": 348.639,
      "end": 352.639,
      "text": "वापस यह केस हाई कोर्ट में सिंगल जज के"
    },
    {
      "subtitle_id": 164,
      "start": 350.479,
      "end": 354.4,
      "text": "पास दे दो। फिर कलानिधि मारन भी थोड़ा यह"
    },
    {
      "subtitle_id": 165,
      "start": 352.639,
      "end": 356.08,
      "text": "हो गए कि भाई यह क्या चल रहा है? अब इसके"
    },
    {
      "subtitle_id": 166,
      "start": 354.4,
      "end": 357.68,
      "text": "बाद कलानिधि मारन चले गए सीधा सुप्रीम"
    },
    {
      "subtitle_id": 167,
      "start": 356.08,
      "end": 359.759,
      "text": "कोर्ट में। सुप्रीम कोर्ट ने यही कहा कि"
    },
    {
      "subtitle_id": 168,
      "start": 357.68,
      "end": 362.16,
      "text": "यह केस फिर से चलाया जाए सिंगल जज के अंडर"
    },
    {
      "subtitle_id": 169,
      "start": 359.759,
      "end": 364.16,
      "text": "हाई कोर्ट में और फिर यह चीजें अभी चल रही"
    },
    {
      "subtitle_id": 170,
      "start": 362.16,
      "end": 365.52,
      "text": "है। तो अगर आपने Spiceet में इन्वेस्ट"
    },
    {
      "subtitle_id": 171,
      "start": 364.16,
      "end": 367.68,
      "text": "किया है तो एक चीज का ध्यान रखें कि उनकी"
    },
    {
      "subtitle_id": 172,
      "start": 365.52,
      "end": 369.759,
      "text": "यह केस चल रही है। अगर Spiceet के फेवर"
    },
    {
      "subtitle_id": 173,
      "start": 367.68,
      "end": 372.0,
      "text": "में यह नहीं जाती है तो Spiceet को काफी"
    },
    {
      "subtitle_id": 174,
      "start": 369.759,
      "end": 373.6,
      "text": "सारा पैसा पे करना पड़ेगा। अभी ऑलरेडी"
    },
    {
      "subtitle_id": 175,
      "start": 372.0,
      "end": 375.759,
      "text": "SPIJet प्रॉब्लम में है तो और ज्यादा"
    },
    {
      "subtitle_id": 176,
      "start": 373.6,
      "end": 377.759,
      "text": "प्रॉब्लम कंपनी के लिए हो सकती है। अब यह"
    },
    {
      "subtitle_id": 177,
      "start": 375.759,
      "end": 379.52,
      "text": "तो था SPIJet का मामला जिसमें डिवीजन बेंच"
    },
    {
      "subtitle_id": 178,
      "start": 377.759,
      "end": 381.68,
      "text": "ने ऐसा कुछ देखा जिसके बाद उन्होंने"
    },
    {
      "subtitle_id": 179,
      "start": 379.52,
      "end": 383.84,
      "text": "SPIJet के फेवर में अपना डिसीजन दिया था।"
    },
    {
      "subtitle_id": 180,
      "start": 381.68,
      "end": 385.759,
      "text": "अगला केस जो था वो था Veda लिमिटेड पोस्ट"
    },
    {
      "subtitle_id": 181,
      "start": 383.84,
      "end": 388.16,
      "text": "मर्जर टैक्स केस। यह केस क्या था? तो"
    },
    {
      "subtitle_id": 182,
      "start": 385.759,
      "end": 390.24,
      "text": "Vedant और केन इंडिया का अप्रैल 2017 को"
    },
    {
      "subtitle_id": 183,
      "start": 388.16,
      "end": 392.24,
      "text": "मर्जर कंप्लीट हो गया था। जिसके बाद केन"
    },
    {
      "subtitle_id": 184,
      "start": 390.24,
      "end": 394.639,
      "text": "इंडिया Vedता में पूरी तरह से शामिल हो गए"
    },
    {
      "subtitle_id": 185,
      "start": 392.24,
      "end": 397.52,
      "text": "थे। अब इनकम टैक्स डिपार्टमेंट ने 2018"
    },
    {
      "subtitle_id": 186,
      "start": 394.639,
      "end": 399.759,
      "text": "में यह देखा कि 2015-16 के फाइनेंसियल ईयर"
    },
    {
      "subtitle_id": 187,
      "start": 397.52,
      "end": 401.84,
      "text": "में KN इंडिया ने अपनी टैक्सेबल इनकम कम"
    },
    {
      "subtitle_id": 188,
      "start": 399.759,
      "end": 404.08,
      "text": "दिखाई थी। जिसकी वजह से उन्होंने टैक्स भी"
    },
    {
      "subtitle_id": 189,
      "start": 401.84,
      "end": 405.919,
      "text": "कम भरा। तो इसके चलते केन इंडिया को टैक्स"
    },
    {
      "subtitle_id": 190,
      "start": 404.08,
      "end": 408.0,
      "text": "नोटिस भेजा गया। तो इसके बाद टैक्स"
    },
    {
