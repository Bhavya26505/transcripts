      "start": 611.76,
      "end": 615.76,
      "text": "होना चाहिए और इसके लिए कस्टमर को बिल्कुल"
    },
    {
      "subtitle_id": 289,
      "start": 613.68,
      "end": 617.6,
      "text": "भी फोर्स नहीं करना चाहिए। गाइडलाइंस के"
    },
    {
      "subtitle_id": 290,
      "start": 615.76,
      "end": 620.24,
      "text": "अकॉर्डिंग सर्विस चार्ज को बिल में ऐड"
    },
    {
      "subtitle_id": 291,
      "start": 617.6,
      "end": 622.24,
      "text": "करके जीएसटी लगाना गलत माना गया था। इसके"
    },
    {
      "subtitle_id": 292,
      "start": 620.24,
      "end": 623.92,
      "text": "बाद नेशनल रेस्टोरेंट एसोसिएशन ऑफ इंडिया"
    },
    {
      "subtitle_id": 293,
      "start": 622.24,
      "end": 626.16,
      "text": "और फेडरेशन ऑफ होटल एंड रेस्टोरेंट"
    },
    {
      "subtitle_id": 294,
      "start": 623.92,
      "end": 628.24,
      "text": "एसोसिएशंस ऑफ इंडिया ने इसके खिलाफ दिल्ली"
    },
    {
      "subtitle_id": 295,
      "start": 626.16,
      "end": 630.64,
      "text": "हाईकोर्ट में पिटीशन डाली। उनका कहना था"
    },
    {
      "subtitle_id": 296,
      "start": 628.24,
      "end": 632.959,
      "text": "कि सर्विस चार्ज एक कॉमन प्रैक्टिस है जो"
    },
    {
      "subtitle_id": 297,
      "start": 630.64,
      "end": 636.16,
      "text": "स्टाफ के लिए की जाती है। इस पर जस्टिस"
    },
    {
      "subtitle_id": 298,
      "start": 632.959,
      "end": 637.76,
      "text": "वर्मा के बेंच ने जुलाई 2022 को एक इंटरिम"
    },
    {
      "subtitle_id": 299,
      "start": 636.16,
      "end": 640.24,
      "text": "यानी टेंपरेरी ऑर्डर दिया। कोर्ट ने"
    },
    {
      "subtitle_id": 300,
      "start": 637.76,
      "end": 642.959,
      "text": "सीसीपीए की जो गाइडलाइन थी उसके इस रूल पर"
    },
    {
      "subtitle_id": 301,
      "start": 640.24,
      "end": 645.12,
      "text": "रोक लगा दी जो सर्विस चार्ज बैन करता था।"
    },
    {
      "subtitle_id": 302,
      "start": 642.959,
      "end": 647.68,
      "text": "यानी कि रेस्टोरेंट्स अब सर्विस चार्ज लगा"
    },
    {
      "subtitle_id": 303,
      "start": 645.12,
      "end": 649.839,
      "text": "सकेंगे जब तक इस केस का फाइनल फैसला नहीं"
    },
    {
      "subtitle_id": 304,
      "start": 647.68,
      "end": 651.2,
      "text": "आता। अब यह सारे कॉर्पोरेट केसेस जस्टिस"
    },
    {
      "subtitle_id": 305,
      "start": 649.839,
      "end": 652.64,
      "text": "वर्मा ने हैंडल किए हैं। इसके साथ"
    },
    {
      "subtitle_id": 306,
      "start": 651.2,
      "end": 654.56,
      "text": "इन्होंने एक पॉलिटिकल केस काफी बड़ा"
    },
    {
      "subtitle_id": 307,
      "start": 652.64,
      "end": 656.24,
      "text": "पॉलिटिकल केस भी हैंडल किया है। इसको मैं"
    },
    {
      "subtitle_id": 308,
      "start": 654.56,
      "end": 658.399,
      "text": "आपको शॉर्ट में बता देता हूं। यह जो केस"
    },
    {
      "subtitle_id": 309,
      "start": 656.24,
      "end": 660.72,
      "text": "है यह कांग्रेस पार्टी और डिप्टी कमिश्नर"
    },
    {
      "subtitle_id": 310,
      "start": 658.399,
      "end": 664.0,
      "text": "ऑफ इनकम टैक्स के बीच था। इनकम टैक्स"
    },
    {
      "subtitle_id": 311,
      "start": 660.72,
      "end": 665.68,
      "text": "डिपार्टमेंट ने 2014-15 से लेकर 202021 तक"
    },
    {
      "subtitle_id": 312,
      "start": 664.0,
      "end": 667.6,
      "text": "के फाइनेंसियल रिकॉर्ड्स के बेसिस पर"
    },
    {
      "subtitle_id": 313,
      "start": 665.68,
      "end": 670.48,
      "text": "कांग्रेस के खिलाफ टैक्स नोटिस भेजा था।"
    },
    {
      "subtitle_id": 314,
      "start": 667.6,
      "end": 672.56,
      "text": "वो भी कहीं छोटा-मोटा नहीं ₹3500 करोड़"
    },
    {
      "subtitle_id": 315,
      "start": 670.48,
      "end": 674.56,
      "text": "का। इस पर कांग्रेस पार्टी ने लॉजिक दिया"
    },
    {
      "subtitle_id": 316,
      "start": 672.56,
      "end": 676.8,
      "text": "कि आप किसी भी टैक्स नोटिस को 3 साल के"
    },
    {
      "subtitle_id": 317,
      "start": 674.56,
      "end": 678.8,
      "text": "बाद नहीं भेज सकते हो। इस पर जस्टिस वर्मा"
    },
    {
      "subtitle_id": 318,
      "start": 676.8,
      "end": 681.279,
      "text": "ने आर्गुमेंट दिया कि अगर एविडेंस हो तो"
    },
    {
      "subtitle_id": 319,
      "start": 678.8,
      "end": 683.76,
      "text": "10 साल तक आपको नोटिस भेज सकते हैं। और"
    },
    {
      "subtitle_id": 320,
      "start": 681.279,
      "end": 685.92,
      "text": "फैसला किसके पक्ष में आया? तो आईटी"
    },
    {
      "subtitle_id": 321,
      "start": 683.76,
      "end": 687.76,
      "text": "डिपार्टमेंट के और अभी भी यह केस चल ही"
    },
    {
      "subtitle_id": 322,
      "start": 685.92,
      "end": 689.519,
      "text": "रहा है। अब इस वीडियो को बनाने का मेरा यह"
    },
    {
      "subtitle_id": 323,
      "start": 687.76,
      "end": 691.519,
      "text": "मकसद नहीं था कि मैं किसी कंपनी को या फिर"
    },
    {
      "subtitle_id": 324,
      "start": 689.519,
      "end": 693.36,
      "text": "पॉलिटिकल पार्टी को गलत ठहराऊं। मेरा काम"
    },
    {
      "subtitle_id": 325,
      "start": 691.519,
      "end": 695.839,
      "text": "था कि जस्टिस वर्मा ने जिन-जिन बड़े-बड़े"
    },
    {
      "subtitle_id": 326,
      "start": 693.36,
      "end": 698.079,
      "text": "केसेस पर जजमेंट दी है, वह सारी की सारी"
    },
    {
      "subtitle_id": 327,
      "start": 695.839,
      "end": 700.16,
      "text": "आपके सामने रखना। ताकि एज एन इन्वेस्टर आप"
    },
    {
      "subtitle_id": 328,
      "start": 698.079,
      "end": 702.8,
      "text": "भी यह समझ सको कि इंडिया में चीजें आखिर"
    },
    {
      "subtitle_id": 329,
      "start": 700.16,
      "end": 705.68,
      "text": "कैसे काम करती है और कैसे आप भी जो कंपनीज"
    },
    {
      "subtitle_id": 330,
      "start": 702.8,
      "end": 708.0,
      "text": "लगातार कोर्ट मैटर में फंसती रहती है उनसे"
    },
    {
      "subtitle_id": 331,
      "start": 705.68,
      "end": 710.959,
      "text": "थोड़ा दूर रह सको। अब बड़ा सवाल यह है कि"
    },
    {
      "subtitle_id": 332,
      "start": 708.0,
      "end": 713.44,
      "text": "जो ₹50 करोड़ हैं आपको क्या लगता है?"
    },
    {
      "subtitle_id": 333,
      "start": 710.959,
      "end": 715.76,
      "text": "किसके होंगे? सारी चीजें क्लियरली आपके"
    },
    {
      "subtitle_id": 334,
      "start": 713.44,
      "end": 717.2,
      "text": "सामने है। कमेंट करके बताइए और जाते-जाते"
    },
    {
      "subtitle_id": 335,
      "start": 715.76,
      "end": 719.76,
      "text": "borzo को जरूर चेक आउट कीजिए। अगर आप"
    },
    {
      "subtitle_id": 336,
      "start": 717.2,
      "end": 721.6,
      "text": "मुंबई या दिल्ली से हैं और आपको वन डे"
    },
    {
      "subtitle_id": 337,
      "start": 719.76,
      "end": 723.519,
      "text": "डिलीवरी की जरूरत पड़ती है कभी भी तो"
    },
    {
      "subtitle_id": 338,
      "start": 721.6,
      "end": 725.839,
      "text": "हमेशा दिमाग में रहिए। ऐप डाउनलोड करके रख"
    },
    {
      "subtitle_id": 339,
      "start": 723.519,
      "end": 728.0,
      "text": "दीजिए। जब भी जरूरत हो आसानी से यूज़ कर"
    },
    {
      "subtitle_id": 340,
      "start": 725.839,
      "end": 729.76,
      "text": "दीजिए। नो टेंशन। और हां, इस वीडियो को"
    },
    {
      "subtitle_id": 341,
      "start": 728.0,
      "end": 731.44,
      "text": "ज्यादा से ज्यादा शेयर कीजिए अपने दोस्तों"
    },
    {
      "subtitle_id": 342,
      "start": 729.76,
      "end": 732.959,
      "text": "के साथ, अपने इन्वेस्टर फ्रेंड्स के साथ।"
    },
    {
      "subtitle_id": 343,
      "start": 731.44,
      "end": 735.959,
      "text": "मिलते हैं अगले वीडियो में। थैंक यू सो"
    },
    {
      "subtitle_id": 344,
      "start": 732.959,
      "end": 735.959,
      "text": "मच।"
    }
  ]
}