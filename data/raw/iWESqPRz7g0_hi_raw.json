    {
      "subtitle_id": 7,
      "start": 13.839,
      "end": 18.439,
      "text": "आर्टिफिशियल इंटेलिजेंस का एआई आया और"
    },
    {
      "subtitle_id": 8,
      "start": 16.08,
      "end": 20.6,
      "text": "धीरे-धीरे सब कुछ बदल रहा है और इंसान भी"
    },
    {
      "subtitle_id": 9,
      "start": 18.439,
      "end": 22.359,
      "text": "अब एआई के सामने बहुत छोटे लगने लगे हैं"
    },
    {
      "subtitle_id": 10,
      "start": 20.6,
      "end": 24.56,
      "text": "इस न्यूज़ को आप ही देखिए कि एआई ने"
    },
    {
      "subtitle_id": 11,
      "start": 22.359,
      "end": 26.679,
      "text": "यूपीएससी प्रिलिमनरी एग्जाम को जो इंडिया"
    },
    {
      "subtitle_id": 12,
      "start": 24.56,
      "end": 29.24,
      "text": "के सबसे मुश्किल में से एक एग्जाम है उसे"
    },
    {
      "subtitle_id": 13,
      "start": 26.679,
      "end": 32.759,
      "text": "सिर्फ 7 मिनट्स में सॉल्व कर दिया और"
