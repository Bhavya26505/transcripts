    {
      "subtitle_id": 16,
      "start": 34.84,
      "end": 39.0,
      "text": "के प्लेयर्स को भी हरा सकता है आज हर सवाल"
    },
    {
      "subtitle_id": 17,
      "start": 37.16,
      "end": 40.64,
      "text": "का जवाब एआई फ्रैक्शन ऑफ सेकंड में दे"
    },
    {
      "subtitle_id": 18,
      "start": 39.0,
      "end": 43.32,
      "text": "देता है बहुत सारे एक्सपर्ट्स का मानना है"
    },
    {
      "subtitle_id": 19,
      "start": 40.64,
      "end": 45.12,
      "text": "कि एआई जल्द ही सिंगुलेरिटी अचीव कर लेगा"
    },
    {
      "subtitle_id": 20,
      "start": 43.32,
      "end": 47.399,
      "text": "सिंगुलेरिटी का मतलब है कि वो टाइम इन"
    },
    {
      "subtitle_id": 21,
      "start": 45.12,
      "end": 49.079,
      "text": "फ्यूचर जब एआई ह्यूमन इंटेलिजेंस को भी"
    },
    {
      "subtitle_id": 22,
      "start": 47.399,
      "end": 50.92,
      "text": "पार कर देगा और वही दूसरी तरफ कुछ"
    },
    {
      "subtitle_id": 23,
      "start": 49.079,
      "end": 52.399,
      "text": "साइंटिस्ट ये कहते हैं कि नहीं ये पॉसिबल"
    },
    {
      "subtitle_id": 24,
      "start": 50.92,
      "end": 54.68,
      "text": "नहीं है ये नहीं होगा क्योंकि ह्यूमन"
    },
    {
      "subtitle_id": 25,
      "start": 52.399,
      "end": 56.52,
      "text": "सिविलाइजेशन जो है वो हजारों करोड़ों साल"
    },
    {
      "subtitle_id": 26,
      "start": 54.68,
      "end": 58.359,
      "text": "पुराने हैं और हमारी हिस्ट्री में भी कई"
    },
    {
      "subtitle_id": 27,
      "start": 56.52,
      "end": 60.559,
      "text": "सारे ऐसे मूमेंट आने वाले थे जब लगा था कि"
    },
    {
      "subtitle_id": 28,
      "start": 58.359,
      "end": 62.68,
      "text": "अब द एंड होने वाला है लेकिन नहीं हुआ"
    },
    {
      "subtitle_id": 29,
      "start": 60.559,
      "end": 66.119,
      "text": "क्यों क्योंकि ह्यूमन सिविलाइजेशन के पास"
    },
    {
      "subtitle_id": 30,
      "start": 62.68,
      "end": 68.2,
      "text": "दो खास स्किल्स हैं लर्निंग और रेलर्निंग"
    },
    {
      "subtitle_id": 31,
      "start": 66.119,
      "end": 70.84,
      "text": "तो मेरा यह मानना है कि एआई वोंट रिप्लेस"
    },
    {
      "subtitle_id": 32,
      "start": 68.2,
      "end": 73.759,
      "text": "ह्यूमंस बट ह्यूमंस विद एआई विल रिप्लेस"
    },
    {
      "subtitle_id": 33,
      "start": 70.84,
      "end": 75.92,
      "text": "ह्यूमंस विदाउट एआई एडि केज सीईओ ंग जॉनसन"
    },
    {
      "subtitle_id": 34,
      "start": 73.759,
      "end": 77.799,
      "text": "भी कई बार यही चीज कहते हुए हमें नजर आते"
    },
    {
      "subtitle_id": 35,
      "start": 75.92,
      "end": 79.64,
      "text": "हैं तो लर्निंग और रिलर्न की जो प्रोसेस"
    },
    {
      "subtitle_id": 36,
      "start": 77.799,
      "end": 81.36,
      "text": "है वो आपको लगातार चालू रखनी है क्योंकि"
    },
    {
      "subtitle_id": 37,
      "start": 79.64,
      "end": 83.96,
      "text": "यही दो चीजें हैं जिनके कारण ह्यूमंस"
    },
    {
      "subtitle_id": 38,
      "start": 81.36,
      "end": 85.64,
      "text": "लगातार सरवाइव करते आ रहे हैं और यह चीज"
    },
    {
      "subtitle_id": 39,
      "start": 83.96,
      "end": 87.079,
      "text": "आपको आज भी याद रखनी चाहिए कि अगर आपको"
    },
    {
      "subtitle_id": 40,
      "start": 85.64,
      "end": 88.92,
      "text": "किसी भी फील्ड में ग्रो करना है तो"
    },
    {
      "subtitle_id": 41,
      "start": 87.079,
      "end": 90.6,
      "text": "कंसिस्टेंटली आपको सीखना होगा और टाइम टू"
    },
    {
      "subtitle_id": 42,
      "start": 88.92,
      "end": 92.32,
      "text": "टाइम अपना नॉलेज अपडेट करना होगा क्योंकि"
    },
    {
      "subtitle_id": 43,
      "start": 90.6,
      "end": 94.479,
      "text": "हिस्ट्री बताती है कि सरवाइव करने के लिए"
    },
    {
      "subtitle_id": 44,
      "start": 92.32,
      "end": 96.28,
      "text": "ये दो स्किल्स मस्ट है जो कोई इसे फॉलो"
    },
    {
      "subtitle_id": 45,
      "start": 94.479,
      "end": 98.24,
      "text": "नहीं करेगा पीछे रह जाएगा या प्रॉब्लम में"
    },
    {
      "subtitle_id": 46,
      "start": 96.28,
      "end": 99.799,
      "text": "आ सकता है इसीलिए हमने सोचा कि फाइनेंस के"
    },
    {
      "subtitle_id": 47,
      "start": 98.24,
      "end": 101.119,
      "text": "टॉपिक्स की तो हम बात करते ही रहते हैं"
    },
    {
      "subtitle_id": 48,
      "start": 99.799,
      "end": 103.079,
      "text": "लेकिन एक वीडियो ऐसा भी होना चाहिए जो"
    },
    {
      "subtitle_id": 49,
      "start": 101.119,
      "end": 105.04,
      "text": "थोड़ा जेनरिक हो ताकि आपको भी पता चले कि"
    },
    {
      "subtitle_id": 50,
      "start": 103.079,
      "end": 107.28,
      "text": "जो चीजें बहुत तेजी से बदल रही है उसके"
    },
    {
      "subtitle_id": 51,
      "start": 105.04,
      "end": 108.799,
      "text": "अनुसार आपको भी अपडेट रहना है और नया साल"
    },
    {
      "subtitle_id": 52,
      "start": 107.28,
      "end": 111.439,
      "text": "शुरू हो रहा है तो दिस इज अ बेस्ट टाइम टू"
    },
    {
      "subtitle_id": 53,
      "start": 108.799,
      "end": 113.2,
      "text": "लर्न एंड रिलर्न समथिंग तो चलिए फिर"
    },
    {
      "subtitle_id": 54,
      "start": 111.439,
      "end": 115.04,
      "text": "स्टार्ट करते हैं नमस्कार मैं प्रसाद आपका"
    },
    {
      "subtitle_id": 55,
      "start": 113.2,
      "end": 116.799,
      "text": "आज के इस वीडियो में स्वागत करता हूं आज"
    },
    {
      "subtitle_id": 56,
      "start": 115.04,
      "end": 118.36,
      "text": "के इस वीडियो के प्रायोजक है कोर्सरा जो"
    },
    {
      "subtitle_id": 57,
      "start": 116.799,
      "end": 120.079,
      "text": "लोग नहीं जानते उन्हें बता दूं कि कोर्सरा"
    },
    {
      "subtitle_id": 58,
      "start": 118.36,
      "end": 122.159,
      "text": "एक ऑनलाइन लर्निंग प्लेटफॉर्म है जहां पर"
    },
    {
      "subtitle_id": 59,
      "start": 120.079,
      "end": 122.159,
      "text": "आप"
    },
    {
      "subtitle_id": 60,
      "start": 126.0,
      "end": 129.759,
      "text": "google2 से भी ज्यादा स्टूडेंट्स ने"
    },
    {
      "subtitle_id": 61,
      "start": 127.96,
      "end": 131.48,
      "text": "कोर्सरा पर अपने स्किल्स बिल्ड किए हैं"
    },
    {
      "subtitle_id": 62,
      "start": 129.759,
      "end": 133.48,
      "text": "कोर्सरा पर आपको फ्लेक्सिबल टाइमिंग के"
    },
    {
      "subtitle_id": 63,
      "start": 131.48,
      "end": 135.4,
      "text": "साथ जॉब फोकस्ड कोर्सेस भी मिल जाएंगे जो"
    },
    {
      "subtitle_id": 64,
      "start": 133.48,
      "end": 137.12,
      "text": "आपके करियर को नेक्स्ट लेवल पर ले जाएंगे"
    },
    {
      "subtitle_id": 65,
      "start": 135.4,
      "end": 138.959,
      "text": "वैसे कोर्सरा का नाम आपने सुना ही होगा"
    },
    {
      "subtitle_id": 66,
      "start": 137.12,
      "end": 140.599,
      "text": "काफी पॉपुलर प्लेटफॉर्म है और जैसे कि"
    },
    {
      "subtitle_id": 67,
      "start": 138.959,
      "end": 142.92,
      "text": "बहुत सारे लोगों को पता है कि कोर्सरा पर"
    },
    {
      "subtitle_id": 68,
      "start": 140.599,
      "end": 145.04,
      "text": "100 200 नहीं 300 से ज्यादा जो टॉप"
    },
    {
      "subtitle_id": 69,
      "start": 142.92,
      "end": 146.8,
      "text": "यूनिवर्सिटीज हैं उनके हजारों कोर्सेस के"
    },
    {
      "subtitle_id": 70,
      "start": 145.04,
      "end": 148.76,
      "text": "ऑप्शंस अवेलेबल है यहां पर आप प्रैक्टिकल"
    },
    {
      "subtitle_id": 71,
      "start": 146.8,
      "end": 150.519,
      "text": "स्किल्स भी सीख सकते हो और इनके कोर्सेस"
    },
    {
      "subtitle_id": 72,
      "start": 148.76,
      "end": 152.08,
      "text": "अफोर्डेबल भी है और साथ ही रियल जॉब"
    },
    {
      "subtitle_id": 73,
      "start": 150.519,
      "end": 153.72,
      "text": "अपॉर्चुनिटी भी आपको यहां पर मिलेगी तो"
    },
    {
      "subtitle_id": 74,
      "start": 152.08,
      "end": 155.56,
      "text": "वेट के इस बात का लिंक नीचे डिस्क्रिप्शन"
    },
    {
      "subtitle_id": 75,
      "start": 153.72,
      "end": 157.64,
      "text": "और कमेंट बॉक्स में दी गई है अब आप सभी को"
    },
    {
      "subtitle_id": 76,
      "start": 155.56,
      "end": 160.36,
      "text": "पता ही है कि स्किल्स तो अपडेट करनी चाहिए"
    },
    {
      "subtitle_id": 77,
      "start": 157.64,
      "end": 162.04,
      "text": "लेकिन कौन सी और कैसे और इसके साथ एक सवाल"
    },
    {
      "subtitle_id": 78,
      "start": 160.36,
      "end": 164.08,
      "text": "आता है कि कौन से कोर्स में एनरोल करना"
    },
    {
      "subtitle_id": 79,
      "start": 162.04,
      "end": 166.48,
      "text": "चाहिए तो इसलिए मैं और मेरी टीम ने घंटों"
    },
    {
      "subtitle_id": 80,
      "start": 164.08,
      "end": 168.2,
      "text": "रिसर्च करके कोसरा के टॉप 10 कोर्सेस की"
    },
    {
      "subtitle_id": 81,
      "start": 166.48,
      "end": 170.08,
      "text": "लिस्ट निकाली है जिसके बारे में अब मैं"
    },
    {
      "subtitle_id": 82,
      "start": 168.2,
      "end": 172.12,
      "text": "आपको एक-एक करके डिटेल में बताऊंगा तो"
    },
    {
      "subtitle_id": 83,
      "start": 170.08,
      "end": 174.319,
      "text": "पहला कोर्स है एआई फॉर एवरीवन बाय डीप"
    },
    {
      "subtitle_id": 84,
      "start": 172.12,
      "end": 176.0,
      "text": "लर्निंग एआई अब इसके डिटेल्स जाना भी आपको"
    },
    {
      "subtitle_id": 85,
      "start": 174.319,
      "end": 177.56,
      "text": "जरूरी है सिर्फ नाम से आपको लगेगा कि ये"
    },
    {
      "subtitle_id": 86,
      "start": 176.0,
      "end": 179.2,
      "text": "जो कोर्स है ये इंजीनियर्स और कोडर्स के"
    },
    {
      "subtitle_id": 87,
      "start": 177.56,
      "end": 180.84,
      "text": "लिए है लेकिन ऐसा बिल्कुल भी नहीं है ये"
    },
    {
      "subtitle_id": 88,
      "start": 179.2,
      "end": 182.519,
      "text": "जो कोर्स है जो नॉन टेक्निकल के लोग हैं"
    },
    {
      "subtitle_id": 89,
      "start": 180.84,
      "end": 184.239,
      "text": "वो भी कर सकते हैं ताकि जो अपनी लाइफ में"
    },
    {
      "subtitle_id": 90,
      "start": 182.519,
      "end": 186.319,
      "text": "और अपनी जॉब स्किल्स में एआई को अप्लाई"
    },
    {
      "subtitle_id": 91,
      "start": 184.239,
      "end": 188.56,
      "text": "करना चाहते हैं और एआई की मदद लेके बहुत"
    },
    {
      "subtitle_id": 92,
      "start": 186.319,
      "end": 190.48,
      "text": "आगे बढ़ना चाहते हैं इस कोर्स में आप एआई"
    },
    {
      "subtitle_id": 93,
      "start": 188.56,
      "end": 192.28,
      "text": "के जो फंडामेंटल्स हैं उसके बेसिक्स हैं"
    },
    {
      "subtitle_id": 94,
      "start": 190.48,
      "end": 194.56,
      "text": "वो सारी चीजें सीखेंगे साथ ही एआई के जो"
