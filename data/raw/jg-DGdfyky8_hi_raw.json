  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.0,
      "end": 3.52,
      "text": "रिसेंटली हाई प्रोफाइल डिवोर्स की केसेस"
    },
    {
      "subtitle_id": 2,
      "start": 1.76,
      "end": 5.92,
      "text": "काफी बढ़ रही है और उसमें से कुछ केसेस"
    },
    {
      "subtitle_id": 3,
      "start": 3.52,
      "end": 7.759,
      "text": "ऐसी भी हैं जहां पर इंडिया के डिवोर्स लॉज"
    },
    {
      "subtitle_id": 4,
      "start": 5.92,
      "end": 9.679,
      "text": "का फायदा लिया जा रहा है देखिए किस्मत"
    },
    {
      "subtitle_id": 5,
      "start": 7.759,
      "end": 11.92,
      "text": "किस्मत की बात है कुछ लोगों की शादियां"
    },
    {
      "subtitle_id": 6,
      "start": 9.679,
      "end": 13.92,
      "text": "सुर्खियों में होती है जैसे कि ये अनंत"
    },
    {
      "subtitle_id": 7,
      "start": 11.92,
      "end": 16.359,
      "text": "अंबानी और राधिका मर्चेंट की शादी जिसमें"
    },
    {
      "subtitle_id": 8,
      "start": 13.92,
      "end": 18.56,
      "text": "00 करोड़ का खर्चा आया और उसमें दिलजीत"
    },
    {
      "subtitle_id": 9,
      "start": 16.359,
      "end": 20.199,
      "text": "दोसांज ने भी काफी अच्छा डांस किया और फिर"
    },
    {
      "subtitle_id": 10,
      "start": 18.56,
      "end": 22.08,
      "text": "दिन रात मीडिया वालों ने इसे टीवी पर"
    },
    {
      "subtitle_id": 11,
      "start": 20.199,
      "end": 24.24,
      "text": "चलाया वहीं दूसरी तरफ कुछ लोगों की"
    },
    {
      "subtitle_id": 12,
      "start": 22.08,
      "end": 25.84,
      "text": "शादियां नहीं बल्कि डिवोर्स सुर्खियों में"
    },
    {
      "subtitle_id": 13,
      "start": 24.24,
      "end": 28.56,
      "text": "होते हैं जैसे कि अभी कुछ ही टाइम पहले"
    },
    {
      "subtitle_id": 14,
      "start": 25.84,
      "end": 30.56,
      "text": "जेब बेजोस का डिवोर्स 2023 में हकीमी का"
    },
    {
      "subtitle_id": 15,
      "start": 28.56,
      "end": 32.239,
      "text": "डिवोर्स जहां पर यह पता चला कि हकीमी ने"
    },
    {
      "subtitle_id": 16,
      "start": 30.56,
      "end": 34.44,
      "text": "अपनी सारी प्रॉपर्टी अपनी मां के नाम कर"
    },
    {
      "subtitle_id": 17,
      "start": 32.239,
      "end": 37.0,
      "text": "दी थी और खुद के नाम पर कुछ भी नहीं रखा"
    },
    {
      "subtitle_id": 18,
      "start": 34.44,
      "end": 39.04,
      "text": "था और अब 2024 की हाई प्रोफाइल डिवोर्स"
    },
    {
      "subtitle_id": 19,
      "start": 37.0,
      "end": 40.96,
      "text": "केसेस में एक और बड़ा नाम जुड़ गया है वो"
    },
    {
      "subtitle_id": 20,
      "start": 39.04,
      "end": 42.76,
      "text": "है हार्दिक पांड्या और उनकी वाइफ नताशा"
    },
    {
      "subtitle_id": 21,
      "start": 40.96,
      "end": 44.44,
      "text": "स्टैनकोविक का अब ये जो न्यूज़ है यह"
    },
    {
      "subtitle_id": 22,
      "start": 42.76,
      "end": 47.039,
      "text": "सिर्फ डिवोर्स की वजह से चर्चा में नहीं"
    },
    {
      "subtitle_id": 23,
      "start": 44.44,
      "end": 50.32,
      "text": "है यह चर्चा में इसलिए है क्योंकि हार्दिक"
    },
    {
      "subtitle_id": 24,
      "start": 47.039,
      "end": 52.68,
      "text": "पांड्या को इस केस में अपनी 70 पर नेटवर्क"
    },
    {
      "subtitle_id": 25,
      "start": 50.32,
      "end": 54.559,
      "text": "अपनी वाइफ को देनी पड़ सकती है अब दोनों"
    },
    {
      "subtitle_id": 26,
      "start": 52.68,
      "end": 56.16,
      "text": "पार्टीज की तरफ से अभी तक कोई कंफर्मेशन"
    },
    {
      "subtitle_id": 27,
      "start": 54.559,
      "end": 57.92,
      "text": "इस पर नहीं आया है दोनों ने भी चुप्पी सा"
    },
    {
      "subtitle_id": 28,
      "start": 56.16,
      "end": 59.96,
      "text": "दी है लेकिन क्योंकि हमारा फाइनेंशियल"
    },
    {
      "subtitle_id": 29,
      "start": 57.92,
      "end": 61.48,
      "text": "चैनल है तो हमें उनकी प्राइवेट लाइफ से"
    },
    {
      "subtitle_id": 30,
      "start": 59.96,
      "end": 64.0,
      "text": "कोई लेना देना नहीं है हमें लेना देना है"
    },
    {
      "subtitle_id": 31,
      "start": 61.48,
      "end": 66.159,
      "text": "फाइनेंस से क्योंकि डिवोर्स के केस में हम"
    },
    {
      "subtitle_id": 32,
      "start": 64.0,
      "end": 67.96,
      "text": "सबको यह जानना जरूरी है कि नेटवर्थ का"
    },
    {
      "subtitle_id": 33,
      "start": 66.159,
      "end": 69.72,
      "text": "कितना हिस्सा डिवाइड होता है और उसका"
    },
    {
      "subtitle_id": 34,
      "start": 67.96,
      "end": 71.6,
      "text": "फाइनेंशियल प्लानिंग पर कितना गहरा असर"
    },
    {
      "subtitle_id": 35,
      "start": 69.72,
      "end": 74.6,
      "text": "पड़ता है और इसी टॉपिक पर काफी सारे"
    },
    {
      "subtitle_id": 36,
      "start": 71.6,
      "end": 74.6,
      "text": "मिसकंफीग्रेशन"
    },
    {
      "subtitle_id": 37,
      "start": 89.92,
      "end": 94.479,
      "text": "था वो जरूर सुन लीजिए बहुत ही इंटरेस्टिंग"
    },
    {
      "subtitle_id": 38,
      "start": 91.64,
      "end": 96.439,
      "text": "है 2023 में हकीमी का डिवोर्स हो जाता है"
    },
    {
      "subtitle_id": 39,
      "start": 94.479,
      "end": 98.72,
      "text": "हकीमी कौन है तो मोरोको का एक बहुत ही"
    },
    {
      "subtitle_id": 40,
      "start": 96.439,
      "end": 101.52,
      "text": "फेमस फुटबॉलर है उसके शादी हुई थी स्पेनिश"
    },
    {
      "subtitle_id": 41,
      "start": 98.72,
      "end": 103.28,
      "text": "एक्ट्रेस हिबा के साथ लेकिन 2023 में उनका"
    },
    {
      "subtitle_id": 42,
      "start": 101.52,
      "end": 106.079,
      "text": "डिवोर्स हो गया अब कई बार आपको डिवोर्स"
    },
    {
      "subtitle_id": 43,
      "start": 103.28,
      "end": 107.6,
      "text": "सेटलमेंट में 50 पर तक देना पड़ता है कई"
    },
    {
      "subtitle_id": 44,
      "start": 106.079,
      "end": 109.479,
      "text": "बार आप थोड़ा बहुत नेगोशिएट कर सकते हैं"
    },
    {
      "subtitle_id": 45,
      "start": 107.6,
      "end": 111.119,
      "text": "जैसे जेब बेजोस ने किया था पर यहां पर"
    },
    {
      "subtitle_id": 46,
      "start": 109.479,
      "end": 112.56,
      "text": "हकीमी की केस हम इसलिए ले रहे हैं क्योंकि"
    },
    {
      "subtitle_id": 47,
      "start": 111.119,
      "end": 114.68,
      "text": "ये बहुत इंटरेस्टिंग है और बहुत अजीब भी"
    },
    {
      "subtitle_id": 48,
      "start": 112.56,
      "end": 117.2,
      "text": "है जब हकीमी के डिवोर्स की सेटलमेंट शुरू"
    },
    {
      "subtitle_id": 49,
      "start": 114.68,
      "end": 118.84,
      "text": "होती है तब यह पता चलता है कि हकीमी के"
    },
    {
      "subtitle_id": 50,
      "start": 117.2,
      "end": 121.56,
      "text": "पास कुछ भी नहीं है हकीमी बिल्कुल एक"
    },
    {
      "subtitle_id": 51,
      "start": 118.84,
      "end": 123.64,
      "text": "कंगाल आदमी है फिर जजेस को भी ये चीज बहुत"
    },
    {
      "subtitle_id": 52,
      "start": 121.56,
      "end": 126.0,
      "text": "शॉकिंग लगती है कि इतना फेमस फुटबॉलर और"
    },
    {
      "subtitle_id": 53,
      "start": 123.64,
      "end": 127.84,
      "text": "उसके पास एक रुपया भी नहीं है फिर उसमें"
    },
    {
      "subtitle_id": 54,
      "start": 126.0,
      "end": 130.239,
      "text": "वो इन्वेस्टिगेशन शुरू करते तो पता चलता"
    },
    {
      "subtitle_id": 55,
      "start": 127.84,
      "end": 133.319,
      "text": "है कि हकीमी ने अपनी सारी जो प्रॉपर्टी है"
    },
    {
      "subtitle_id": 56,
      "start": 130.239,
      "end": 135.44,
      "text": "वो अपनी मां के नाम पर रखी थी और इनफैक्ट"
    },
    {
      "subtitle_id": 57,
      "start": 133.319,
      "end": 137.12,
      "text": "मैच फुटबॉल मैच खेलने के बाद जो फीज हकीमी"
    },
    {
      "subtitle_id": 58,
      "start": 135.44,
      "end": 139.36,
      "text": "को मिलती थी वो पैसा भी उनकी मां के"
    },
    {
      "subtitle_id": 59,
      "start": 137.12,
      "end": 141.68,
      "text": "अकाउंट में ही जाता था तो प्रैक्टिकली"
    },
    {
      "subtitle_id": 60,
      "start": 139.36,
      "end": 143.319,
      "text": "हकीमी के पास कुछ नहीं था अब जब यह न्यूज़"
    },
    {
      "subtitle_id": 61,
      "start": 141.68,
      "end": 145.519,
      "text": "इंडिया पहुंची तो लोगों ने कहा कि हम भी"
    },
    {
      "subtitle_id": 62,
      "start": 143.319,
      "end": 147.68,
      "text": "कुछ ऐसा ही करेंगे ताकि हम भी इस तरह की"
    },
    {
      "subtitle_id": 63,
      "start": 145.519,
      "end": 150.12,
      "text": "चीजों से बच सके और उन कुछ लोगों में से"
    },
    {
      "subtitle_id": 64,
      "start": 147.68,
      "end": 154.08,
      "text": "एक हार्दिक पांड्या भी थे और यह है की"
    },
    {
      "subtitle_id": 65,
      "start": 150.12,
      "end": 154.08,
      "text": "क्लिप जो आपने शायद सोशल मीडिया पे"
    },
    {
      "subtitle_id": 66,
      "start": 159.46,
      "end": 162.52,
      "text": "[प्रशंसा]"
    },
    {
      "subtitle_id": 67,
      "start": 179.92,
      "end": 184.84,
      "text": "सही नहीं है आप गलत हो क्योंकि हकीम वाली"
    },
    {
      "subtitle_id": 68,
      "start": 182.8,
      "end": 186.28,
      "text": "जो स्ट्रेटजी है ये इंडिया में नहीं चलती"
    },
    {
      "subtitle_id": 69,
      "start": 184.84,
      "end": 187.959,
      "text": "अगर आप ये चीज इंडिया में करते हैं तो"
    },
    {
      "subtitle_id": 70,
      "start": 186.28,
      "end": 190.36,
      "text": "इंडिया में आपको सीधा रेड कार्ड दिखा दिया"
    },
    {
      "subtitle_id": 71,
      "start": 187.959,
      "end": 193.239,
      "text": "जाएगा जजेस की तरफ से लेकिन फिर सवाल आता"
    },
    {
      "subtitle_id": 72,
      "start": 190.36,
      "end": 194.799,
      "text": "है कि ऐसा क्यों तो आपको बता दूं कि बाहर"
    },
    {
      "subtitle_id": 73,
      "start": 193.239,
      "end": 196.599,
      "text": "की जो कंट्रीज है दूसरी कंट्रीज उनका"
    },
    {
      "subtitle_id": 74,
      "start": 194.799,
      "end": 198.48,
      "text": "प्लेग्राउंड अलग है और इंडिया का जो"
    },
    {
      "subtitle_id": 75,
      "start": 196.599,
      "end": 200.319,
      "text": "प्लेग्राउंड है वो अलग है उनका"
    },
    {
      "subtitle_id": 76,
      "start": 198.48,
      "end": 202.159,
      "text": "प्लेग्राउंड शायद ग्रीन हो सकता है बाकी"
    },
    {
      "subtitle_id": 77,
      "start": 200.319,
      "end": 204.36,
      "text": "कुछ हो सकता है लेकिन इंडिया के केस में"
    },
    {
      "subtitle_id": 78,
      "start": 202.159,
      "end": 206.36,
      "text": "वो थोड़ा बहुत पिंक पाया गया है यानी कि"
    },
    {
      "subtitle_id": 79,
      "start": 204.36,
      "end": 208.92,
      "text": "इंडिया में डिवोर्स सेटलमेंट लॉज बहुत"
    },
    {
      "subtitle_id": 80,
      "start": 206.36,
      "end": 211.08,
      "text": "ज्यादा स्ट्रिक्ट है एटलीस्ट ऑन द पेपर यह"
    },
    {
      "subtitle_id": 81,
      "start": 208.92,
      "end": 212.68,
      "text": "मामला समझने के लिए हमें पहले यह समझना है"
    },
    {
      "subtitle_id": 82,
      "start": 211.08,
      "end": 214.72,
      "text": "कि डिवोर्स के केस में वाइफ को क्या-क्या"
    },
    {
      "subtitle_id": 83,
      "start": 212.68,
      "end": 216.68,
      "text": "मिलता है पहला है मेंटेनेंस इसमें भी दो"
    },
    {
      "subtitle_id": 84,
      "start": 214.72,
      "end": 218.64,
      "text": "टाइप है पहला है इंटरम जिसमें आपको"
    },
    {
      "subtitle_id": 85,
      "start": 216.68,
      "end": 221.04,
      "text": "डिवोर्स प्रोसेस के दौरान एक मेंटेनेंस"
    },
    {
      "subtitle_id": 86,
      "start": 218.64,
      "end": 223.12,
      "text": "देनी पड़ती है और दूसरा है परमानेंट जो"
    },
    {
      "subtitle_id": 87,
      "start": 221.04,
      "end": 224.799,
      "text": "डिवोर्स के बाद भी देनी पड़ती है दूसरा है"
    },
    {
      "subtitle_id": 88,
      "start": 223.12,
      "end": 226.72,
      "text": "चाइल्ड सपोर्ट ये अमाउंट भी डायरेक्टली"
    },
    {
      "subtitle_id": 89,
      "start": 224.799,
      "end": 228.56,
      "text": "मदर को ही जाता है क्योंकि यूजुअली वही"
    },
    {
      "subtitle_id": 90,
      "start": 226.72,
      "end": 230.92,
      "text": "बच्चों को पालती है तीसरा है रेसिडेंट"
    },
    {
      "subtitle_id": 91,
      "start": 228.56,
      "end": 233.12,
      "text": "राइट वाइफ जिस घर में मैरिज के दौरान रहती"
    },
    {
      "subtitle_id": 92,
      "start": 230.92,
      "end": 234.879,
      "text": "थी उस पर वो क्लेम कर सकती है और चौथा"
    },
    {
      "subtitle_id": 93,
      "start": 233.12,
      "end": 236.36,
      "text": "बड़ा इंटरेस्टिंग है इंडिया में डिवोर्स"
    },
    {
      "subtitle_id": 94,
      "start": 234.879,
      "end": 238.159,
      "text": "केस में प्रॉपर्टी को दो हिस्सों में"
    },
    {
      "subtitle_id": 95,
      "start": 236.36,
      "end": 240.04,
      "text": "बांटा जाता है पहला है मेरिटल प्रॉपर्टी"
    },
