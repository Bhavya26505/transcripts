  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.04,
      "end": 6.2,
      "text": "फेयर एंड लवली हॉर्लिक्स नापतोल केन टार"
    },
    {
      "subtitle_id": 2,
      "start": 3.28,
      "end": 8.28,
      "text": "लाइफ बॉय और अभी पतंजलि इन सब में कॉमन"
    },
    {
      "subtitle_id": 3,
      "start": 6.2,
      "end": 10.519,
      "text": "बात क्या है तो कॉमन बात यह है कि इन सबने"
    },
    {
      "subtitle_id": 4,
      "start": 8.28,
      "end": 12.799,
      "text": "मिसली दिंग एड्स फैलाई है जिसकी वजह से"
    },
    {
      "subtitle_id": 5,
      "start": 10.519,
      "end": 14.96,
      "text": "सीसीपीए यानी सेंट्रल कंज्यूमर प्रोटेक्शन"
    },
    {
      "subtitle_id": 6,
      "start": 12.799,
      "end": 16.88,
      "text": "अथॉरिटी ने उन पर एक्शन लिया जिसके बाद"
    },
    {
      "subtitle_id": 7,
      "start": 14.96,
      "end": 19.16,
      "text": "उन्होंने बहुत शांतिपूर्वक तरीके से उन"
    },
    {
      "subtitle_id": 8,
      "start": 16.88,
      "end": 22.4,
      "text": "एड्स को हटा दिया लेकिन यह जो मामला है"
    },
    {
      "subtitle_id": 9,
      "start": 19.16,
      "end": 24.68,
      "text": "पतंजलि का यह थोड़ा सीरियस है यह सीधा चला"
    },
    {
      "subtitle_id": 10,
      "start": 22.4,
      "end": 26.599,
      "text": "गया सुप्रीम कोर्ट तक और सुप्रीम कोर्ट ने"
    },
    {
      "subtitle_id": 11,
      "start": 24.68,
      "end": 27.92,
      "text": "बहुत ही स्ट्रिक्ट एक्शन अभी उस पर ली है"
    },
    {
      "subtitle_id": 12,
      "start": 26.599,
      "end": 30.039,
      "text": "अब बहुत सारे लोगों को यह लग रहा है कि"
    },
    {
      "subtitle_id": 13,
      "start": 27.92,
      "end": 31.519,
      "text": "पतंजली फूड्स का ये जो पूरा मामला है जो"
    },
    {
      "subtitle_id": 14,
      "start": 30.039,
      "end": 33.16,
      "text": "रिसेंटली काफी हाईलाइट हो रहा है जिसकी"
    },
    {
      "subtitle_id": 15,
      "start": 31.519,
      "end": 35.32,
      "text": "वजह से पतंजलि फूड्स की शेयर प्राइस भी"
    },
    {
      "subtitle_id": 16,
      "start": 33.16,
      "end": 37.68,
      "text": "गिर रही है वो मेनली हो रहा है उनकी मिस"
    },
    {
      "subtitle_id": 17,
      "start": 35.32,
      "end": 40.32,
      "text": "लीडिंग एड्स की वजह से लेकिन अकेला वो"
    },
    {
      "subtitle_id": 18,
      "start": 37.68,
      "end": 43.28,
      "text": "कारण नहीं है एक और बड़ा कारण है अगर वो"
    },
    {
      "subtitle_id": 19,
      "start": 40.32,
      "end": 45.6,
      "text": "गलती पतंजलि नहीं करती तो आज इतनी बड़ी"
    },
    {
      "subtitle_id": 20,
      "start": 43.28,
      "end": 48.32,
      "text": "मुसीबत उन्हें झेलनी नहीं पड़ती तो क्या"
    },
    {
      "subtitle_id": 21,
      "start": 45.6,
      "end": 50.719,
      "text": "है यह पूरा मामला और क्या पतंजलि का फॉल"
    },
    {
      "subtitle_id": 22,
      "start": 48.32,
      "end": 53.16,
      "text": "शुरू हो गया है बात करेंगे इस वीडियो में"
    },
    {
      "subtitle_id": 23,
      "start": 50.719,
      "end": 55.039,
      "text": "बहुत ही डिटेल में नमस्कार मैं प्रसाद"
    },
    {
      "subtitle_id": 24,
      "start": 53.16,
      "end": 57.84,
      "text": "आपका आज के इस वीडियो में स्वागत करता हूं"
    },
    {
      "subtitle_id": 25,
      "start": 55.039,
      "end": 60.44,
      "text": "बात है अगस्त 2022 की जब इंडियन मेडिकल"
    },
    {
      "subtitle_id": 26,
      "start": 57.84,
      "end": 62.92,
      "text": "काउंसिल ने एक पिटीशन फाइल की प किसके"
    },
    {
      "subtitle_id": 27,
      "start": 60.44,
      "end": 65.439,
      "text": "खिलाफ तो पतंजलि के खिलाफ उनकी मिस लीडिंग"
    },
    {
      "subtitle_id": 28,
      "start": 62.92,
      "end": 68.4,
      "text": "ऐड की वजह से अब ये ऐड से मिस लीडिंग नहीं"
    },
    {
      "subtitle_id": 29,
      "start": 65.439,
      "end": 70.28,
      "text": "थी यह कुछ और भी बया कर रही थी ऐसा इंडियन"
    },
    {
      "subtitle_id": 30,
      "start": 68.4,
      "end": 72.6,
      "text": "मेडिकल काउंसिल का कहना था तो देखते हैं"
    },
    {
      "subtitle_id": 31,
      "start": 70.28,
      "end": 74.84,
      "text": "ऐड पर एक बार नजर डालते हैं आप फिर बताइए"
    },
    {
      "subtitle_id": 32,
      "start": 72.6,
      "end": 77.159,
      "text": "कि क्या आपको वो ऐड मिस लीडिंग लगती है या"
    },
    {
      "subtitle_id": 33,
      "start": 74.84,
      "end": 80.32,
      "text": "फिर और कुछ तो ऐड का जो टाइटल है वो है कि"
    },
    {
      "subtitle_id": 34,
      "start": 77.159,
      "end": 82.6,
      "text": "मिसकनसेप्शन स्प्रेड बाय एलोपैथी यानी कि"
    },
    {
      "subtitle_id": 35,
      "start": 80.32,
      "end": 84.88,
      "text": "एलोपैथी फार्म और मेडिकल इंडस्ट्री ये"
    },
    {
      "subtitle_id": 36,
      "start": 82.6,
      "end": 86.759,
      "text": "तीनों आपको पागल बना रहे हैं मिस"
    },
    {
      "subtitle_id": 37,
      "start": 84.88,
      "end": 88.68,
      "text": "इंफॉर्मेशन आपके साथ शेयर कर रहे हैं"
    },
    {
      "subtitle_id": 38,
      "start": 86.759,
      "end": 90.84,
      "text": "लेकिन असली लेकिन बीमारियों का अगर असली"
    },
    {
      "subtitle_id": 39,
      "start": 88.68,
      "end": 92.799,
      "text": "सलूशन किसी के पास है तो हमारे पास है"
    },
    {
      "subtitle_id": 40,
      "start": 90.84,
      "end": 95.68,
      "text": "पतंजलि के पास है यहां पर आप देख सकते हैं"
    },
    {
      "subtitle_id": 41,
      "start": 92.799,
      "end": 98.6,
      "text": "अलग-अलग बीमारियां है जैसे बी बीपी है"
    },
    {
      "subtitle_id": 42,
      "start": 95.68,
      "end": 100.72,
      "text": "शुगर है थायराइड है आप पढ़ सकते हैं कि ब"
    },
    {
      "subtitle_id": 43,
      "start": 98.6,
      "end": 103.399,
      "text": "बीपी की खास दवाइयां लेने के बावजूद भी"
    },
    {
      "subtitle_id": 44,
      "start": 100.72,
      "end": 105.52,
      "text": "कुछ फर्क नहीं पड़ रहा है लेकिन हमारी जो"
    },
    {
      "subtitle_id": 45,
      "start": 103.399,
      "end": 107.759,
      "text": "टेक्निक्स है फिर योगा है हमारे कुछ"
    },
    {
      "subtitle_id": 46,
      "start": 105.52,
      "end": 109.799,
      "text": "टेबलेट्स वगैरह है उससे काम हो रहा है"
    },
    {
      "subtitle_id": 47,
      "start": 107.759,
      "end": 112.84,
      "text": "उससे हमने हजारों लोगों को ब बीपी से"
    },
    {
      "subtitle_id": 48,
      "start": 109.799,
      "end": 115.52,
      "text": "आजादी दिलवाई है बात से बीपी तक नहीं थी"
    },
    {
      "subtitle_id": 49,
      "start": 112.84,
      "end": 119.399,
      "text": "आप शुगर ले लीजिए थायराइड है आंखों के"
    },
    {
      "subtitle_id": 50,
      "start": 115.52,
      "end": 122.079,
      "text": "डिजीज है स्किन डिजीसस अस्थमा और कई सारे"
    },
    {
      "subtitle_id": 51,
      "start": 119.399,
      "end": 124.32,
      "text": "इनके डिसीसेस जिसका कोई इलाज नहीं है"
    },
    {
      "subtitle_id": 52,
      "start": 122.079,
      "end": 126.759,
      "text": "लेकिन पतंजलि कहता है कि हमारी दवाई अगर"
    },
    {
      "subtitle_id": 53,
      "start": 124.32,
      "end": 129.599,
      "text": "आप लेंगे तो आपको इसका सलूशन मिल जाएगा"
    },
    {
      "subtitle_id": 54,
      "start": 126.759,
      "end": 131.8,
      "text": "जैसे इनकी ये ऐड है कि बीपी और शुगर के कई"
    },
    {
      "subtitle_id": 55,
      "start": 129.599,
      "end": 133.319,
      "text": "सारे पेशेंट्स एलोपैथी से हटकर हमारे पास"
    },
    {
      "subtitle_id": 56,
      "start": 131.8,
      "end": 135.68,
      "text": "आ रहे हैं क्यों आ रहे हैं क्योंकि हमारे"
    },
    {
      "subtitle_id": 57,
      "start": 133.319,
      "end": 138.319,
      "text": "पास उसका सलूशन है सॉल्यूशन है मुक्त वटी"
    },
    {
      "subtitle_id": 58,
      "start": 135.68,
      "end": 140.319,
      "text": "और बीपी ग्रीट ये दोनों भी चीजें जो हमने"
    },
    {
      "subtitle_id": 59,
      "start": 138.319,
      "end": 142.48,
      "text": "बनाई हैं इसके लिए हमने 30 साल का रिसर्च"
    },
    {
      "subtitle_id": 60,
      "start": 140.319,
      "end": 144.56,
      "text": "एंड डेवलपमेंट किया है उसके बाद ये दवाई"
    },
    {
      "subtitle_id": 61,
      "start": 142.48,
      "end": 146.319,
      "text": "हमने बनाई है और इन दवाइयों की मदद से"
    },
    {
      "subtitle_id": 62,
      "start": 144.56,
      "end": 149.44,
      "text": "हजारों लोग बी बीपी और शुगर से मुक्त हो"
    },
    {
      "subtitle_id": 63,
      "start": 146.319,
      "end": 151.959,
      "text": "गए अब इन मिस लीडिंग ऐड से पहले 2021 में"
    },
    {
      "subtitle_id": 64,
      "start": 149.44,
      "end": 154.28,
      "text": "इन्होंने एक और मिस लीडिंग ऐड की थी यह ऐड"
    },
    {
      "subtitle_id": 65,
      "start": 151.959,
      "end": 156.48,
      "text": "किस चीज की थी तो कोरोनिल की थी कि"
    },
    {
      "subtitle_id": 66,
      "start": 154.28,
      "end": 158.319,
      "text": "कोरोनिल हमारी ऐसी एक दवाई है जो कोरोना"
    },
    {
      "subtitle_id": 67,
      "start": 156.48,
      "end": 160.04,
      "text": "वायरस से फाइट करती है बाद में काफी सारी"
    },
    {
      "subtitle_id": 68,
      "start": 158.319,
      "end": 162.159,
      "text": "क्रिटिसिजम का सामना भी कोरोनिल को करना"
    },
    {
      "subtitle_id": 69,
      "start": 160.04,
      "end": 163.8,
      "text": "पड़ा अब इंडियन मेडिकल काउंसिल का कहना था"
    },
    {
      "subtitle_id": 70,
      "start": 162.159,
      "end": 166.959,
      "text": "कि यह जो सारी चीजें ये कंपलीटली मिस"
    },
    {
      "subtitle_id": 71,
      "start": 163.8,
      "end": 169.76,
      "text": "लीडिंग है और इसे रोकना बहुत जरूरी है तो"
    },
    {
      "subtitle_id": 72,
      "start": 166.959,
      "end": 172.2,
      "text": "अभी 21 नवंबर 2023 को इसकी पहली हियरिंग"
    },
    {
      "subtitle_id": 73,
      "start": 169.76,
      "end": 176.159,
      "text": "थी कोर्ट ने दोनों साइड सुन ली और यह"
    },
    {
      "subtitle_id": 74,
      "start": 172.2,
      "end": 178.319,
      "text": "बताया कि जो कर रहा है पतंजलि वो कंप्लीट"
    },
    {
      "subtitle_id": 75,
      "start": 176.159,
      "end": 180.879,
      "text": "सही नहीं है कि आप इस तरह की गारंटी नहीं"
    },
    {
      "subtitle_id": 76,
      "start": 178.319,
      "end": 183.04,
      "text": "दे सकते कि हमने सारे डिसीसेस उसको क्योर"
    },
    {
      "subtitle_id": 77,
      "start": 180.879,
      "end": 184.68,
      "text": "किया है तो सुप्रीम कोर्ट ने क्लियर कहा"
    },
    {
      "subtitle_id": 78,
      "start": 183.04,
      "end": 186.319,
      "text": "कि आप इस तरह के क्लेम नहीं कर सकते आपकी"
    },
    {
      "subtitle_id": 79,
      "start": 184.68,
      "end": 189.159,
      "text": "जो एडवर्टाइजमेंट है वो कंप्लीट मिस"
    },
    {
      "subtitle_id": 80,
      "start": 186.319,
      "end": 191.159,
      "text": "लीडिंग है और इसके लिए आपको ₹ करोड़ का"
    },
    {
      "subtitle_id": 81,
      "start": 189.159,
      "end": 193.319,
      "text": "जुर्माना पे करना पड़ेगा साथ ही आपको यह"
    },
    {
      "subtitle_id": 82,
      "start": 191.159,
      "end": 195.799,
      "text": "मेक श्योर करना पड़ेगा कि यहां से आगे इस"
    },
    {
      "subtitle_id": 83,
      "start": 193.319,
      "end": 197.959,
      "text": "तरह के ऐड्स आप नहीं चलाओगे क्योंकि इससे"
    },
    {
      "subtitle_id": 84,
      "start": 195.799,
      "end": 200.2,
      "text": "ऑलरेडी काफी सारा डैमेज हो चुका है पूरी"
    },
    {
      "subtitle_id": 85,
      "start": 197.959,
      "end": 202.159,
      "text": "कंट्री में और और ज्यादा डैमेज हम होने"
    },
    {
      "subtitle_id": 86,
      "start": 200.2,
      "end": 204.28,
      "text": "देना नहीं चाहते हैं तो एक बहुत ही सीरियस"
    },
    {
      "subtitle_id": 87,
      "start": 202.159,
      "end": 206.159,
      "text": "वार्निंग हम आपको दे रहे हैं और आशा करते"
    },
    {
      "subtitle_id": 88,
      "start": 204.28,
      "end": 208.68,
      "text": "हैं कि आगे से ऐसी ऐड नहीं चलेगी ₹ करोड़"
    },
    {
      "subtitle_id": 89,
      "start": 206.159,
      "end": 211.159,
      "text": "जमा कीजिए मामला खत्म तो वैसे तो यह मामला"
    },
    {
      "subtitle_id": 90,
      "start": 208.68,
      "end": 213.799,
      "text": "नवंबर दिसंबर में फफा दफा होने वाला था"
    },
    {
      "subtitle_id": 91,
      "start": 211.159,
      "end": 215.64,
      "text": "लेकिन यहां पर पतंजलि की तरफ से एक ऐसी"
    },
    {
      "subtitle_id": 92,
      "start": 213.799,
      "end": 218.12,
      "text": "चीज हो जाती है जिसकी वजह से यह पूरा"
    },
    {
      "subtitle_id": 93,
      "start": 215.64,
      "end": 220.36,
      "text": "मामला बहुत इंटेंस हो जाता है और इसके जो"
    },
    {
      "subtitle_id": 94,
      "start": 218.12,
      "end": 223.48,
      "text": "साइड इफेक्ट्स है वो अभी पतंजलि को दिखने"
    },
    {
      "subtitle_id": 95,
      "start": 220.36,
      "end": 225.319,
      "text": "ऑलरेडी शुरू हो चुके हैं हुआ ये कि ये सब"
    },
    {
      "subtitle_id": 96,
      "start": 223.48,
      "end": 227.08,
      "text": "चीजें होने के बाद अब आईडियली कोई और"
    },
    {
      "subtitle_id": 97,
      "start": 225.319,
      "end": 229.36,
      "text": "कंपनी रहती तो एडवर्टाइजमेंट वो बंद कर"
    },
    {
      "subtitle_id": 98,
      "start": 227.08,
      "end": 231.319,
      "text": "देती ₹ करोड़ पे करती और साइड में हो जाती"
    },
    {
      "subtitle_id": 99,
      "start": 229.36,
      "end": 232.879,
      "text": "यहां पर पतंजलि ने सुप्रीम कोर्ट के इस"
    },
    {
      "subtitle_id": 100,
      "start": 231.319,
      "end": 235.12,
      "text": "वॉर्निंग के बाद भी अपनी एडवर्टाइजमेंट"
    },
    {
      "subtitle_id": 101,
      "start": 232.879,
      "end": 237.0,
      "text": "जारी रखी अभी एडवर्टाइजमेंट चल रही थी"
    },
    {
      "subtitle_id": 102,
      "start": 235.12,
      "end": 240.079,
      "text": "सुप्रीम कोर्ट को तो पता चल नहीं रहा था"
    },
    {
      "subtitle_id": 103,
      "start": 237.0,
      "end": 243.159,
      "text": "इसी बीच चीफ जस्टिस और जस्टिस अमानतुल्लाह"
    },
    {
      "subtitle_id": 104,
      "start": 240.079,
      "end": 245.36,
      "text": "इन दोनों को एक लेटर आता है लेटर पर नाम"
    },
    {
      "subtitle_id": 105,
      "start": 243.159,
      "end": 247.48,
      "text": "देखते हैं तो कोई नाम मेंशन करने को तैयार"
    },
    {
      "subtitle_id": 106,
      "start": 245.36,
      "end": 250.04,
      "text": "नहीं होता है अंदर जब वो खोलते हैं तो"
    },
    {
      "subtitle_id": 107,
      "start": 247.48,
      "end": 253.159,
      "text": "पढ़ने लगते हैं तो उन्हें ऐसे प्रूफ दिए"
    },
    {
      "subtitle_id": 108,
      "start": 250.04,
      "end": 255.879,
      "text": "जाते हैं जिससे यह पता चलता है कि पतंजलि"
    },
    {
      "subtitle_id": 109,
      "start": 253.159,
      "end": 258.28,
      "text": "अभी भी उन ऐड्स को चला रही है जिसे चलाने"
    },
    {
      "subtitle_id": 110,
      "start": 255.879,
      "end": 260.359,
      "text": "पर कोर्ट ने पाबंदी लगाई थी तुरंत उसकी"
    },
    {
      "subtitle_id": 111,
      "start": 258.28,
      "end": 262.639,
      "text": "पुष्टि की जाती है क्रॉस वेरीफाई किया"
    },
    {
      "subtitle_id": 112,
      "start": 260.359,
      "end": 265.479,
      "text": "जाता है और पता चलता है कि पतंजलि अभी भी"
    },
    {
      "subtitle_id": 113,
      "start": 262.639,
      "end": 267.639,
      "text": "उन ऐड्स को चला रही है जो कि कंटेंप्ट ऑफ"
    },
    {
      "subtitle_id": 114,
      "start": 265.479,
      "end": 270.08,
      "text": "कोर्ट में आता है और ये एक बहुत सीरियस"
    },
    {
      "subtitle_id": 115,
      "start": 267.639,
      "end": 272.16,
      "text": "चीज हो जाती है अब जो है वो मामला सर के"
    },
    {
      "subtitle_id": 116,
      "start": 270.08,
      "end": 274.8,
      "text": "ऊपर चला जाता है मतलब जो मामला जो नवंबर"
    },
    {
      "subtitle_id": 117,
      "start": 272.16,
      "end": 276.88,
      "text": "दिसंबर में रफा दफा होने वाला था वो अब एक"
    },
    {
      "subtitle_id": 118,
      "start": 274.8,
      "end": 279.72,
      "text": "नया मोड ले लेता है अब यहां पर सुप्रीम"
    },
    {
      "subtitle_id": 119,
      "start": 276.88,
      "end": 282.12,
      "text": "कोर्ट कहता है कि आपके पास इतने गट्स है"
    },
    {
      "subtitle_id": 120,
      "start": 279.72,
      "end": 284.52,
      "text": "और इतने करेज है कि आप उन एडवर्टाइजमेंट"
    },
    {
      "subtitle_id": 121,
      "start": 282.12,
      "end": 286.0,
      "text": "को अभी भी चला रहे हैं जिस पर पाबंदी है"
    },
    {
      "subtitle_id": 122,
      "start": 284.52,
      "end": 287.759,
      "text": "और आप उसमें क्या बता रहे हैं कि आपको"
    },
    {
      "subtitle_id": 123,
      "start": 286.0,
      "end": 289.88,
      "text": "परमानेंट रिलीफ मिल जाएगा सारी बीमारियों"
    },
    {
      "subtitle_id": 124,
      "start": 287.759,
      "end": 292.36,
      "text": "से जिसके बाद कोर्ट ने पतंजलि के सारे"
    },
    {
      "subtitle_id": 125,
      "start": 289.88,
      "end": 294.919,
      "text": "एडवर्टाइजमेंट को बैन करने का आदेश दिया"
    },
    {
      "subtitle_id": 126,
      "start": 292.36,
      "end": 297.08,
      "text": "लेकिन बात यहां पर नहीं रुकी ये जो कंटेंट"
    },
    {
      "subtitle_id": 127,
      "start": 294.919,
      "end": 299.16,
      "text": "नोटिस सुप्रीम कोर्ट ने उन्हें भेजी थी"
    },
    {
      "subtitle_id": 128,
      "start": 297.08,
      "end": 300.32,
      "text": "उसको पतंजलि की तरफ से कोई भी रिस्पांस"
    },
    {
      "subtitle_id": 129,
      "start": 299.16,
      "end": 302.6,
      "text": "नहीं आता"
    },
    {
      "subtitle_id": 130,
      "start": 300.32,
      "end": 304.919,
      "text": "जिसकी वजह से अब कोर्ट और ज्यादा नाराज हो"
    },
    {
      "subtitle_id": 131,
      "start": 302.6,
      "end": 306.919,
      "text": "जाता है जिसके बाद वह कंपनी के जो एमडी है"
    },
    {
      "subtitle_id": 132,
      "start": 304.919,
      "end": 309.52,
      "text": "आचार्य बालकृष्ण और रामदेव बाबा उन्हें"
    },
    {
      "subtitle_id": 133,
      "start": 306.919,
      "end": 311.68,
      "text": "नोटिस भेजते हैं कि आप यहां पर आइए फिर हम"
    },
    {
      "subtitle_id": 134,
      "start": 309.52,
      "end": 313.639,
      "text": "आपसे सीधा बात करते हैं जिसके चलते कंपनी"
    },
    {
      "subtitle_id": 135,
      "start": 311.68,
      "end": 315.28,
      "text": "के एमडी अपॉलॉजी देते हैं माफी मांगते हैं"
    },
    {
      "subtitle_id": 136,
      "start": 313.639,
      "end": 317.039,
      "text": "कि जो भी मिस लीडिंग एडवर्टाइजमेंट हमने"
    },
    {
      "subtitle_id": 137,
      "start": 315.28,
      "end": 318.919,
      "text": "की थी उसके लिए हम माफी मांगते हैं अब"
    },
    {
      "subtitle_id": 138,
      "start": 317.039,
      "end": 321.28,
      "text": "सुप्रीम कोर्ट के लॉयर का यह कहना था कि"
    },
    {
      "subtitle_id": 139,
      "start": 318.919,
      "end": 323.16,
      "text": "आदमी है आदमी से गलतियां हो जाती है लेकिन"
    },
    {
      "subtitle_id": 140,
      "start": 321.28,
      "end": 325.8,
      "text": "सुप्रीम कोर्ट का यहां पर कहना था कि आपने"
    },
    {
      "subtitle_id": 141,
      "start": 323.16,
      "end": 329.039,
      "text": "जो मिस लीडिंग ऐड्स की है उससे हजारों"
    },
    {
      "subtitle_id": 142,
      "start": 325.8,
      "end": 331.639,
      "text": "लाखों लोग चीट हुए हैं आपने उनको चीट किया"
    },
    {
      "subtitle_id": 143,
      "start": 329.039,
      "end": 333.84,
      "text": "है जो चीजें एक्चुअल में है नहीं वो करके"
    },
    {
      "subtitle_id": 144,
      "start": 331.639,
      "end": 336.72,
      "text": "बताया आपने ऐसी बीमारियों का भी क्योर"
    },
    {
      "subtitle_id": 145,
      "start": 333.84,
      "end": 338.4,
      "text": "बताया जिसका क्योर आपके पास नहीं है अब"
    },
    {
      "subtitle_id": 146,
      "start": 336.72,
      "end": 340.24,
      "text": "बात सिर्फ यहां पर ही नहीं रुकी सुप्रीम"
    },
    {
      "subtitle_id": 147,
      "start": 338.4,
      "end": 343.039,
      "text": "कोर्ट ने यहां पर उत्तराखंड गवर्नमेंट को"
    },
    {
      "subtitle_id": 148,
      "start": 340.24,
      "end": 344.919,
      "text": "भी पकड़ा और उन्हें भी काफी कुछ सुना दिया"
    },
    {
      "subtitle_id": 149,
      "start": 343.039,
      "end": 346.8,
      "text": "अब देखिए अब इन सारी चीजों का शेयर प्राइस"
    },
    {
      "subtitle_id": 150,
      "start": 344.919,
      "end": 348.44,
      "text": "पर भी फर्क पड़ने लगा जब हम यहां पर"
    },
    {
      "subtitle_id": 151,
      "start": 346.8,
      "end": 350.08,
      "text": "पतंजली और बाकी कंज्यूमर कंपनीज का"
    },
    {
      "subtitle_id": 152,
      "start": 348.44,
      "end": 352.0,
      "text": "एनालिसिस कर रहे हैं तो इन्वेस्टमेंट"
    },
    {
      "subtitle_id": 153,
      "start": 350.08,
      "end": 353.28,
      "text": "पॉइंट ऑफ व्यू से ये पूरा सेक्टर कैसा है"
    },
    {
      "subtitle_id": 154,
      "start": 352.0,
      "end": 355.44,
      "text": "तो उसके बारे में भी कुछ इंटरेस्टिंग"
    },
    {
      "subtitle_id": 155,
      "start": 353.28,
      "end": 357.199,
      "text": "चीजें जो इस रिसर्च के दौरान मुझे पता चली"
    },
    {
      "subtitle_id": 156,
      "start": 355.44,
      "end": 358.639,
      "text": "वो मैं आपके साथ शेयर करता हूं अब देखिए"
    },
    {
      "subtitle_id": 157,
      "start": 357.199,
      "end": 360.479,
      "text": "यहां पर भले ही पतंजलि ने मिस"
    },
    {
      "subtitle_id": 158,
      "start": 358.639,
      "end": 362.68,
      "text": "एडवर्टाइजमेंट किया हो लेकिन इस रिसर्च के"
    },
    {
      "subtitle_id": 159,
      "start": 360.479,
      "end": 364.319,
      "text": "दौरान मुझे एक चीज रिलाइज हुई कि पतंजलि"
    },
    {
      "subtitle_id": 160,
      "start": 362.68,
      "end": 366.24,
      "text": "की जो इतने कम टाइम में इतनी ज्यादा ग्रोथ"
    },
    {
      "subtitle_id": 161,
      "start": 364.319,
      "end": 367.919,
      "text": "हुई है इससे हमें यह तो पता चल जाता है कि"
    },
    {
      "subtitle_id": 162,
      "start": 366.24,
      "end": 369.68,
      "text": "इंडिया का जो कंज्यूमर मार्केट है वो बहुत"
    },
    {
      "subtitle_id": 163,
      "start": 367.919,
      "end": 371.599,
      "text": "तेजी से बढ़ रहा है अब इसके पीछे सबसे"
    },
    {
      "subtitle_id": 164,
      "start": 369.68,
      "end": 373.44,
      "text": "बड़ा रीजन तो यही है कि इंडिया का मिडिल"
    },
    {
      "subtitle_id": 165,
      "start": 371.599,
      "end": 376.16,
      "text": "क्लास बढ़ रहा है लोगों की इनकम बढ़ रही"
    },
    {
      "subtitle_id": 166,
      "start": 373.44,
      "end": 377.8,
      "text": "है और इसकी वजह से कंजमेटेड रही है और फिर"
    },
    {
      "subtitle_id": 167,
      "start": 376.16,
      "end": 379.52,
      "text": "मैंने इस इंडस्ट्री के अलग-अलग कंपनीज को"
    },
    {
      "subtitle_id": 168,
      "start": 377.8,
      "end": 381.36,
      "text": "भी थोड़ा देखना शुरू किया रिसर्च पॉइंट ऑफ"
    },
    {
      "subtitle_id": 169,
      "start": 379.52,
      "end": 383.12,
      "text": "व्यू से तो मुझे पता चला कि एक ऐसा"
    },
    {
      "subtitle_id": 170,
      "start": 381.36,
      "end": 384.96,
      "text": "इंडेक्स भी है जो इस तरह की कंपनीज में"
    },
    {
      "subtitle_id": 171,
      "start": 383.12,
      "end": 386.72,
      "text": "इन्वेस्ट करता है जिसका नाम है निफ्टी नॉन"
    },
    {
      "subtitle_id": 172,
      "start": 384.96,
      "end": 388.16,
      "text": "साइक्लिकल कंज्यूमर इंडेक्स अब ये जो"
    },
    {
      "subtitle_id": 173,
      "start": 386.72,
      "end": 389.919,
      "text": "इंडेक्स है मुझे बड़ा ही इंटरेस्टिंग"
    },
    {
      "subtitle_id": 174,
      "start": 388.16,
      "end": 391.96,
      "text": "मालूम हुआ क्योंकि सिर्फ नॉन साइ लिकल"
    },
    {
      "subtitle_id": 175,
      "start": 389.919,
      "end": 393.52,
      "text": "कंपनीज को ही ये ट्रैक करता है इसका मतलब"
    },
    {
      "subtitle_id": 176,
      "start": 391.96,
      "end": 395.56,
      "text": "कि आपकी जो इन्वेस्टमेंट है वो ऑल विदर"
    },
    {
      "subtitle_id": 177,
      "start": 393.52,
      "end": 397.24,
      "text": "इन्वेस्टमेंट हो जाती है उसमें साइक्लिकल"
    },
    {
      "subtitle_id": 178,
      "start": 395.56,
      "end": 399.16,
      "text": "अप्स एंड डाउंस आपको देखने नहीं मिलेंगे"
    },
    {
      "subtitle_id": 179,
      "start": 397.24,
      "end": 400.919,
      "text": "इसमें मेनली सेवन इंडस्ट्रीज आती है"
    },
    {
      "subtitle_id": 180,
      "start": 399.16,
      "end": 403.12,
      "text": "एफएमसीजी सबसे ज्यादा वेटेज इन्होंने"
    },
    {
      "subtitle_id": 181,
      "start": 400.919,
      "end": 404.72,
      "text": "एफएमसीजी को दिया जब मैंने इसको डिटेल में"
    },
    {
      "subtitle_id": 182,
      "start": 403.12,
      "end": 407.12,
      "text": "देखा तो पता चला कि एफएमसीजी को सबसे"
    },
    {
      "subtitle_id": 183,
      "start": 404.72,
      "end": 409.0,
      "text": "ज्यादा वेटेज दिया है 42 का उसके बाद"
    },
    {
      "subtitle_id": 184,
      "start": 407.12,
      "end": 410.72,
      "text": "कंज्यूमर सर्विस कंज्यूमर ड्यूरेबल और"
    },
    {
      "subtitle_id": 185,
      "start": 409.0,
      "end": 412.72,
      "text": "बाकी जो इंडस्ट्रीज हैं उनको उन्होंने"
    },
    {
      "subtitle_id": 186,
      "start": 410.72,
      "end": 415.24,
      "text": "वेटेज दिया है तो अब इस इंडेक्स में सात"
    },
    {
      "subtitle_id": 187,
      "start": 412.72,
      "end": 416.96,
      "text": "इंडस्ट्रीज की 30 कंपनीज को लाया गया है"
    },
    {
      "subtitle_id": 188,
      "start": 415.24,
      "end": 418.8,
      "text": "अब देखिए जब भी मैं कोई सेक्टरल इंडेक्स"
    },
    {
      "subtitle_id": 189,
      "start": 416.96,
      "end": 421.08,
      "text": "देखता हूं तो सबसे बड़ा कंसर्न मेरे लिए"
    },
    {
      "subtitle_id": 190,
      "start": 418.8,
      "end": 423.28,
      "text": "होता है कि इस में रिस्क कितनी होगी यह"
    },
    {
      "subtitle_id": 191,
      "start": 421.08,
      "end": 425.199,
      "text": "सेफ होगा कि नहीं होगा और यह देखने के लिए"
    },
    {
      "subtitle_id": 192,
      "start": 423.28,
      "end": 427.28,
      "text": "जनरली हम एक चीज यूज़ करते हैं जिसका नाम"
    },
    {
      "subtitle_id": 193,
      "start": 425.199,
      "end": 428.639,
      "text": "है बीटा बीटा यूज़ करके आपको यह पता चलता"
    },
    {
      "subtitle_id": 194,
      "start": 427.28,
      "end": 430.4,
      "text": "है कि आपकी इन्वेस्टमेंट किसी और"
    },
    {
      "subtitle_id": 195,
      "start": 428.639,
      "end": 432.319,
      "text": "इन्वेस्टमेंट के कंपैरेटिव रिस्की है या"
    },
    {
      "subtitle_id": 196,
      "start": 430.4,
      "end": 434.44,
      "text": "नहीं यानी कि अगर बीटा एक से कम है तो"
    },
    {
      "subtitle_id": 197,
      "start": 432.319,
      "end": 436.96,
      "text": "कंपैरेटिव रिस्क कम है और जब मैंने इस"
    },
    {
      "subtitle_id": 198,
      "start": 434.44,
      "end": 439.24,
      "text": "इंडेक्स को निफ्टी 50 से कंपेयर किया तो"
    },
    {
      "subtitle_id": 199,
      "start": 436.96,
      "end": 441.84,
      "text": "शॉकिंगली मुझे पता चला कि इसमें जो बीटा"
    },
    {
      "subtitle_id": 200,
      "start": 439.24,
      "end": 444.12,
      "text": "है वो एक से कम है यानी रिस्क जो है वो"
    },
    {
      "subtitle_id": 201,
      "start": 441.84,
      "end": 445.4,
      "text": "निफ्टी 50 से भी कम है और मैंने सिर्फ एक"
    },
    {
      "subtitle_id": 202,
      "start": 444.12,
      "end": 447.879,
      "text": "साल का डटा नहीं देखा मैंने करीब-करीब"
    },
    {
      "subtitle_id": 203,
      "start": 445.4,
      "end": 449.28,
      "text": "पिछले 10-15 सालों का डटा देखा और इसके"
    },
    {
      "subtitle_id": 204,
      "start": 447.879,
      "end": 451.479,
      "text": "साथ ही मैंने थोड़े और भी डाटा पॉइंट्स"
    },
    {
      "subtitle_id": 205,
      "start": 449.28,
      "end": 454.36,
      "text": "देखे इस इंडेक्स से रिलेटेड तो मुझे पता"
    },
    {
      "subtitle_id": 206,
      "start": 451.479,
      "end": 456.36,
      "text": "चला कि जब जब मार्केट गिरता है तो यह"
    },
    {
      "subtitle_id": 207,
      "start": 454.36,
      "end": 458.319,
      "text": "निफ्टी से कम गिरता है जैसे कि आप यहां पर"
    },
    {
      "subtitle_id": 208,
      "start": 456.36,
      "end": 460.919,
      "text": "देख सकते हैं ऑन एन एवरेज ये निफ्टी से कम"
    },
    {
      "subtitle_id": 209,
      "start": 458.319,
      "end": 463.039,
      "text": "गिरा है और जबजब मार्केट बढ़ा है तो यह"
    },
    {
      "subtitle_id": 210,
      "start": 460.919,
      "end": 465.159,
      "text": "निफ्टी 50 से ज्यादा बढ़ा है और अगर मैं"
    },
    {
      "subtitle_id": 211,
      "start": 463.039,
      "end": 467.56,
      "text": "इसकी रिटर्न भी देखूं 3 साल 5 साल 10 साल"
    },
    {
      "subtitle_id": 212,
      "start": 465.159,
      "end": 469.44,
      "text": "15 साल के तो बड़ी इजली इसने निफ्टी 50 को"
    },
    {
      "subtitle_id": 213,
      "start": 467.56,
      "end": 470.72,
      "text": "बीट किया है अब देखिए किसी इंडेक्स में हम"
    },
    {
      "subtitle_id": 214,
      "start": 469.44,
      "end": 472.159,
      "text": "डायरेक्टली इन्वेस्ट तो नहीं कर सकते"
    },
    {
      "subtitle_id": 215,
      "start": 470.72,
      "end": 473.879,
      "text": "इंडेक्स को आप देख सकते हो कि वो"
    },
    {
      "subtitle_id": 216,
      "start": 472.159,
      "end": 475.599,
      "text": "पर्टिकुलर सेक्टर कैसे परफॉर्म कर रहा है"
    },
    {
      "subtitle_id": 217,
      "start": 473.879,
      "end": 477.68,
      "text": "इसके लिए और आपको यह भी देखना पड़ेगा कि"
    },
    {
      "subtitle_id": 218,
      "start": 475.599,
      "end": 479.68,
      "text": "आपका एनालिसिस क्या कहता है कि कंज्यूमर"
    },
    {
      "subtitle_id": 219,
      "start": 477.68,
      "end": 481.28,
      "text": "मार्केट आने वाले दिनों में कहां रहेगा"
    },
    {
      "subtitle_id": 220,
      "start": 479.68,
      "end": 483.319,
      "text": "अगर आपको लगता है कि वह और ज्यादा ग्रो"
    },
    {
      "subtitle_id": 221,
      "start": 481.28,
      "end": 485.28,
      "text": "करेगा तो इस सेक्टर पर आप ध्यान दे सकते"
    },
    {
      "subtitle_id": 222,
      "start": 483.319,
      "end": 488.08,
      "text": "हैं और इसके बारे में थोड़ा आप रिसर्च कर"
    },
    {
      "subtitle_id": 223,
      "start": 485.28,
      "end": 489.919,
      "text": "सकते हैं पतंजलि ग्रुप के कंपनी रस्टेड है"
    },
    {
      "subtitle_id": 224,
      "start": 488.08,
      "end": 491.52,
      "text": "जिसका नाम है पतंजलि फोर्स जो कि एडिबल"
    },
    {
      "subtitle_id": 225,
      "start": 489.919,
      "end": 493.879,
      "text": "ऑयल खाने का ऑयल बनाती है एफएमसीजी"
    },
    {
      "subtitle_id": 226,
      "start": 491.52,
      "end": 495.479,
      "text": "प्रोडक्ट्स कुछ बेचती है अब इसका पतंजलि"
    },
    {
      "subtitle_id": 227,
      "start": 493.879,
      "end": 497.72,
      "text": "आयुर्वेद से कुछ लेना देना नहीं है और ये"
    },
    {
      "subtitle_id": 228,
      "start": 495.479,
      "end": 500.039,
      "text": "जो पूरा मामला ये पतंजलि आयुर्वेद का है"
    },
    {
      "subtitle_id": 229,
      "start": 497.72,
      "end": 501.96,
      "text": "इसीलिए पतंजलि फूड्स ने भी कह दिया कि यार"
    },
    {
      "subtitle_id": 230,
      "start": 500.039,
      "end": 503.96,
      "text": "हमारे इससे कोई लेना देना नहीं है लेकिन"
    },
    {
      "subtitle_id": 231,
      "start": 501.96,
      "end": 506.319,
      "text": "जब-जब कोर्ट की सुनवाई आई शेयर प्राइस"
    },
    {
      "subtitle_id": 232,
      "start": 503.96,
      "end": 508.159,
      "text": "लगभग 4 से 5 पर से गिर गई पिछले साल शेयर"
    },
    {
      "subtitle_id": 233,
      "start": 506.319,
      "end": 510.56,
      "text": "प्राइस जो है पतंजली फूड्स की 30 पर से"
    },
    {
      "subtitle_id": 234,
      "start": 508.159,
      "end": 513.159,
      "text": "बढ़ गई लेकिन इस साल पिछले 45 दिन में ही"
    },
    {
      "subtitle_id": 235,
      "start": 510.56,
      "end": 514.919,
      "text": "20 पर डाउन है अब आप कहेंगे कि यार पतंजली"
    },
    {
      "subtitle_id": 236,
      "start": 513.159,
      "end": 516.839,
      "text": "फूड्स का तो इस चीज से लेना देना नहीं है"
    },
    {
      "subtitle_id": 237,
      "start": 514.919,
      "end": 518.36,
      "text": "फिर शेयर प्राइस पर इंपैक्ट क्यों मैं आगे"
    },
    {
      "subtitle_id": 238,
      "start": 516.839,
      "end": 519.919,
      "text": "चलके आपको बता देता हूं और अभी हमने"
    },
    {
      "subtitle_id": 239,
      "start": 518.36,
      "end": 522.599,
      "text": "रिसेंटली मैंने आपको बताया था उत्तराखंड"
    },
    {
      "subtitle_id": 240,
      "start": 519.919,
      "end": 524.2,
      "text": "गवर्नमेंट का अब 19 मार्च को कोर्ट ने"
    },
    {
      "subtitle_id": 241,
      "start": 522.599,
      "end": 525.68,
      "text": "उत्तराखंड गवर्नमेंट को भी झाड़ दिया"
    },
    {
      "subtitle_id": 242,
      "start": 524.2,
      "end": 527.839,
      "text": "जिसके बाद वहां की उत्तराखंड के जो"
    },
    {
      "subtitle_id": 243,
      "start": 525.68,
      "end": 529.12,
      "text": "लाइसेंसिंग अथॉरिटी है उन्होंने पतंजलि"
    },
    {
      "subtitle_id": 244,
      "start": 527.839,
      "end": 531.16,
      "text": "आयुर्वेद के 14 प्रोडक्ट्स का"
    },
    {
      "subtitle_id": 245,
      "start": 529.12,
      "end": 533.0,
      "text": "मैन्युफैक्चरिंग लाइसेंस रद्द कर दिया अब"
    },
    {
      "subtitle_id": 246,
      "start": 531.16,
      "end": 535.24,
      "text": "इन 14 में से 13 प्रोडक्ट्स जो है वो"
    },
    {
      "subtitle_id": 247,
      "start": 533.0,
      "end": 537.76,
      "text": "दिव्य योगा फार्मेसी के जो कि पतंजली की"
    },
    {
      "subtitle_id": 248,
      "start": 535.24,
      "end": 539.72,
      "text": "एक सब्सिडियरी कंपनी है तो जो भी"
    },
    {
      "subtitle_id": 249,
      "start": 537.76,
      "end": 541.88,
      "text": "प्रोडक्ट्स बैन हुए हैं उनका नाम आप यहां"
    },
    {
      "subtitle_id": 250,
      "start": 539.72,
      "end": 544.48,
      "text": "पर देख सकते हैं अब इसमें कुछ प्रोडक्ट्स"
    },
    {
      "subtitle_id": 251,
      "start": 541.88,
      "end": 547.64,
      "text": "ऐसे हैं जो बहुत ही ज्यादा उनका यूज है"
    },
    {
      "subtitle_id": 252,
      "start": 544.48,
      "end": 549.48,
      "text": "मतलब पतंजलि दृष्टि आई ड्रॉप यह ड्रॉप"
    },
    {
      "subtitle_id": 253,
      "start": 547.64,
      "end": 551.48,
      "text": "आपको बताता है यह काफी बड़े-बड़े वादे इस"
    },
    {
      "subtitle_id": 254,
      "start": 549.48,
      "end": 553.24,
      "text": "ड्रॉप नहीं किए इसका भी मिस लीडिंग ड में"
    },
    {
      "subtitle_id": 255,
      "start": 551.48,
      "end": 555.24,
      "text": "एक नाम था लेकिन अभी रिसेंटली इसका"
    },
    {
      "subtitle_id": 256,
      "start": 553.24,
      "end": 557.56,
      "text": "मैन्युफैक्चरिंग लाइसेंस ही कैंसिल कर"
    },
    {
      "subtitle_id": 257,
      "start": 555.24,
      "end": 559.48,
      "text": "दिया गया है बी बीपी ग्रीड जिसके बारे में"
    },
    {
      "subtitle_id": 258,
      "start": 557.56,
      "end": 561.12,
      "text": "बात हो रही थी कि ब बीपी आपका हमेशा के"
    },
    {
      "subtitle_id": 259,
      "start": 559.48,
      "end": 563.44,
      "text": "लिए चला जाएगा अगर आप बी बीपी ग्रीट लेते"
    },
    {
      "subtitle_id": 260,
      "start": 561.12,
      "end": 565.48,
      "text": "हैं तो 30 साल का रिसर्च एंड डेवलपमेंट"
    },
    {
      "subtitle_id": 261,
      "start": 563.44,
      "end": 567.36,
      "text": "इसका भी मैन्युफैक्चरिंग लाइसेंस कंपलीटली"
    },
    {
      "subtitle_id": 262,
      "start": 565.48,
      "end": 569.36,
      "text": "रद्द कर दिया गया है इसके साथ ही द"
    },
    {
      "subtitle_id": 263,
      "start": 567.36,
      "end": 572.36,
      "text": "डिस्ट्रिक्ट आयुर्वेदिक एंड नानी ऑफिसर"
    },
    {
      "subtitle_id": 264,
      "start": 569.36,
      "end": 574.519,
      "text": "हरिद्वार इन्होंने बाबा रामदेव आचार्य"
    },
    {
      "subtitle_id": 265,
      "start": 572.36,
      "end": 577.16,
      "text": "बालकृष्ण दिव्य फार्मेसी और पतंजलि"
    },
    {
      "subtitle_id": 266,
      "start": 574.519,
      "end": 579.68,
      "text": "आयुर्वेद इनके खिलाफ सेक्शन 3 4 और सेन ऑफ"
    },
    {
      "subtitle_id": 267,
      "start": 577.16,
      "end": 581.839,
      "text": "द ड्रग्स एंड मैजिक रेमेडीज एक्ट के तहत"
    },
    {
      "subtitle_id": 268,
      "start": 579.68,
      "end": 583.6,
      "text": "क्रिमिनल कंप्लेंट फाइल की है कुछ ही दिन"
    },
    {
      "subtitle_id": 269,
      "start": 581.839,
      "end": 585.44,
      "text": "बाद जीएसटी डिपार्टमेंट ने भी इन पर एक्शन"
    },
    {
      "subtitle_id": 270,
      "start": 583.6,
      "end": 586.88,
      "text": "लेना शुरू किया आपको बता दूं कि पूरा"
    },
    {
      "subtitle_id": 271,
      "start": 585.44,
      "end": 588.64,
      "text": "मामला सिर्फ मिस लीडिंग एड्स का नहीं है"
    },
    {
      "subtitle_id": 272,
      "start": 586.88,
      "end": 590.6,
      "text": "जो मैनेजमेंट का इंटेंशन है वो भी यहां से"
    },
    {
      "subtitle_id": 273,
      "start": 588.64,
      "end": 592.519,
      "text": "क्लियर हो जाता है कि जब सुप्रीम कोर्ट"
    },
    {
      "subtitle_id": 274,
      "start": 590.6,
      "end": 594.68,
      "text": "आपको कहता है कि आपको ऐड रोकनी है अगर आप"
    },
    {
      "subtitle_id": 275,
      "start": 592.519,
      "end": 596.64,
      "text": "वो नहीं रोक रहे हैं और साथ ही जब सुप्रीम"
    },
    {
      "subtitle_id": 276,
      "start": 594.68,
      "end": 598.6,
      "text": "कोर्ट आपको बुला रहा है तब आप नहीं जा रहे"
    },
    {
      "subtitle_id": 277,
      "start": 596.64,
      "end": 600.76,
      "text": "हैं तो इट टेल्स अ लॉट अबाउट द मैनेजमेंट"
    },
    {
      "subtitle_id": 278,
      "start": 598.6,
      "end": 602.959,
      "text": "ऑफ द कंपनी इसीलिए जो इंपैक्ट है यह सिर्फ"
    },
    {
      "subtitle_id": 279,
      "start": 600.76,
      "end": 604.959,
      "text": "पतंजलि की प्राइवेट कंपनीज ही नहीं बल्कि"
    },
    {
      "subtitle_id": 280,
      "start": 602.959,
      "end": 607.36,
      "text": "लिस्टेड कंपनीज में भी दिख रहा है क्योंकि"
    },
    {
      "subtitle_id": 281,
      "start": 604.959,
      "end": 609.399,
      "text": "मैनेजमेंट वहां पर सेम है और यह जो कुछ"
    },
    {
      "subtitle_id": 282,
      "start": 607.36,
      "end": 611.0,
      "text": "बर्ताव है ये लोगों को पसंद नहीं आया अब"
    },
    {
      "subtitle_id": 283,
      "start": 609.399,
      "end": 613.16,
      "text": "इसका दूसरा साइड इफेक्ट क्या होगा कि इन"
    },
    {
      "subtitle_id": 284,
      "start": 611.0,
      "end": 614.92,
      "text": "सारी चीजों की वजह से पतंजलि के प्रोडक्ट"
    },
    {
      "subtitle_id": 285,
      "start": 613.16,
      "end": 616.88,
      "text": "की काफी बदनामी हो रही है कि मार्केट में"
    },
    {
      "subtitle_id": 286,
      "start": 614.92,
      "end": 618.76,
      "text": "जो कॉन्फिडेंस था बिकॉज़ कभी इनके खिलाफ"
    },
    {
      "subtitle_id": 287,
      "start": 616.88,
      "end": 620.64,
      "text": "किसी ने मिस लीडिंग ऐड की कोई कंप्लेंट"
    },
    {
      "subtitle_id": 288,
      "start": 618.76,
      "end": 622.68,
      "text": "फाइल नहीं की लोगों को भी यही लग रहा था"
    },
    {
      "subtitle_id": 289,
      "start": 620.64,
      "end": 624.36,
      "text": "कि जो वह प्रॉमिस कर रहे हैं वह सही है और"
    },
    {
      "subtitle_id": 290,
      "start": 622.68,
      "end": 626.2,
      "text": "वही सोचकर लोग उनके प्रोडक्ट्स भी खरीद"
    },
    {
      "subtitle_id": 291,
      "start": 624.36,
      "end": 627.92,
      "text": "रहे थे लेकिन अब जब सीधा मैन्युफैक्चरिंग"
    },
    {
      "subtitle_id": 292,
      "start": 626.2,
      "end": 629.48,
      "text": "लाइसेंस ही आपका रद्द हो जाता है इसके बाद"
    },
    {
      "subtitle_id": 293,
      "start": 627.92,
      "end": 631.72,
      "text": "लोगों को पता चलता है कि मामला काफी का"
    },
    {
      "subtitle_id": 294,
      "start": 629.48,
      "end": 633.6,
      "text": "सीवियर है काफी गंभीर है और जब यह सारी"
    },
    {
      "subtitle_id": 295,
      "start": 631.72,
      "end": 635.079,
      "text": "चीजें लोगों तक पहुंचना शुरू हो जाती है"
    },
    {
      "subtitle_id": 296,
      "start": 633.6,
      "end": 636.56,
      "text": "तो ऑफकोर्स आप फ्यूचर में जो भी"
    },
    {
      "subtitle_id": 297,
      "start": 635.079,
      "end": 638.68,
      "text": "प्रोडक्ट्स लाने वाले हैं उस पर इंपैक्ट"
    },
    {
      "subtitle_id": 298,
      "start": 636.56,
      "end": 640.44,
      "text": "तो होगा ही होगा तो पतंजलि की क्लियर मंशा"
    },
    {
      "subtitle_id": 299,
      "start": 638.68,
      "end": 642.639,
      "text": "यह थी कि हमें सबसे बड़ा एफएमसीजी प्लेयर"
    },
    {
      "subtitle_id": 300,
      "start": 640.44,
      "end": 644.959,
      "text": "बनना है सबसे बड़ा फार्मा प्लेयर बनना है"
    },
    {
      "subtitle_id": 301,
      "start": 642.639,
      "end": 646.279,
      "text": "साथ ही हम हमारी और चार कंपनीज को लिस्ट"
    },
    {
      "subtitle_id": 302,
      "start": 644.959,
      "end": 648.399,
      "text": "करने की प्लानिंग कर रहे हैं आने वाले कुछ"
    },
    {
      "subtitle_id": 303,
      "start": 646.279,
      "end": 650.88,
      "text": "सालों में लेकिन अब ये दोनों भी चीजें"
    },
    {
      "subtitle_id": 304,
      "start": 648.399,
      "end": 653.32,
      "text": "काफी अनक्लियर दिख रही है इस सारे मामले"
    },
    {
      "subtitle_id": 305,
      "start": 650.88,
      "end": 655.2,
      "text": "की वजह से अब आगे चीजें क्या होती है ये"
    },
    {
      "subtitle_id": 306,
      "start": 653.32,
      "end": 657.44,
      "text": "देखना थोड़ा इंटरेस्टिंग रहेगा लेकिन ये"
    },
    {
      "subtitle_id": 307,
      "start": 655.2,
      "end": 659.32,
      "text": "सारी चीजें आपको पता चले और क्यों प्राइस"
    },
    {
      "subtitle_id": 308,
      "start": 657.44,
      "end": 661.36,
      "text": "गिर रही है पतंजलि फूड्स की वो भी आपको"
    },
    {
      "subtitle_id": 309,
      "start": 659.32,
      "end": 663.48,
      "text": "पता चले इसलिए सोचा कि वीडियो सभी तक"
    },
    {
      "subtitle_id": 310,
      "start": 661.36,
      "end": 665.16,
      "text": "पहुंचना जरूरी है तो जो जो प्रोडक्ट्स बैन"
    },
    {
      "subtitle_id": 311,
      "start": 663.48,
      "end": 667.12,
      "text": "हुए हैं मैन्युफैक्चरिंग बैन हो गई है"
    },
    {
      "subtitle_id": 312,
      "start": 665.16,
      "end": 669.44,
      "text": "उनमें से काफी सारे प्रोडक्ट्स ऐसे हैं जो"
    },
    {
      "subtitle_id": 313,
      "start": 667.12,
      "end": 671.519,
      "text": "अभी भी मार्केट में सर्कुलेट हो रहे हैं"
    },
    {
      "subtitle_id": 314,
      "start": 669.44,
      "end": 673.6,
      "text": "जो आपके घर के बुजुर्ग लोग जनरली काफी यूज"
    },
    {
      "subtitle_id": 315,
      "start": 671.519,
      "end": 674.88,
      "text": "करते हैं तो यूज कर रहे होंगे तो मेक श्यर"
    },
    {
      "subtitle_id": 316,
      "start": 673.6,
      "end": 676.68,
      "text": "कीजिए कि ज्यादा से ज्यादा लोगों तक ये"
    },
    {
      "subtitle_id": 317,
      "start": 674.88,
      "end": 679.32,
      "text": "वीडियो शेयर कीजिए ताकि ये जो प्रोडक्ट्स"
    },
    {
      "subtitle_id": 318,
      "start": 676.68,
      "end": 681.56,
      "text": "की लिस्ट है ये उन तक पहुंचे और वो भी"
    },
    {
      "subtitle_id": 319,
      "start": 679.32,
      "end": 683.72,
      "text": "मतलब थोड़ा केयरफुली अपने डिसीजन ले कि"
    },
    {
      "subtitle_id": 320,
      "start": 681.56,
      "end": 685.279,
      "text": "कौन सी चीज खरीदनी है और कौन सी नहीं तो"
    },
    {
      "subtitle_id": 321,
      "start": 683.72,
      "end": 686.68,
      "text": "फिलहाल हम यही रुक जाते हैं अभी तक अगर"
    },
    {
      "subtitle_id": 322,
      "start": 685.279,
      "end": 688.279,
      "text": "आपने चैनल को सब्सक्राइब नहीं किया है तो"
    },
    {
      "subtitle_id": 323,
      "start": 686.68,
      "end": 690.0,
      "text": "जरूर चैनल को सब्सक्राइब कीजिए और बेल"
    },
    {
      "subtitle_id": 324,
      "start": 688.279,
      "end": 691.639,
      "text": "आइकॉन पर भी क्लिक कीजिए मिलते हैं अगले"
    },
    {
      "subtitle_id": 325,
      "start": 690.0,
      "end": 694.32,
      "text": "वीडियो में थैंक यू सो मच फॉर वाचिंग दिस"
    },
    {
      "subtitle_id": 326,
      "start": 691.639,
      "end": 694.32,
      "text": "वीडियो"
    }
  ]
}