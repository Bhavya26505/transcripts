  "parsing_issues": [],
  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.08,
      "end": 4.48,
      "text": "हिस्टोरिकली दुनिया में जब-जब वॉर हुए"
    },
    {
      "subtitle_id": 2,
      "start": 2.24,
      "end": 6.799,
      "text": "तब-तब गोल्ड बढ़ा है। लेकिन इस बार"
    },
    {
      "subtitle_id": 3,
      "start": 4.48,
      "end": 9.12,
      "text": "सिचुएशन पूरी तरह से अलग है। वॉर तेजी से"
    },
    {
      "subtitle_id": 4,
      "start": 6.799,
      "end": 9.44,
      "text": "चल रहा है। गोल्ड की प्राइस लगातार गिर"
    },
    {
      "subtitle_id": 5,
      "start": 9.12,
      "end": 12.0,
      "text": "रही है।"
    },
    {
      "subtitle_id": 6,
      "start": 9.44,
      "end": 13.519,
      "text": "गोल्ड हैज़ सफर्ड इट्स शार्पेस्ट फॉल इन"
    },
    {
      "subtitle_id": 7,
      "start": 12.0,
      "end": 15.599,
      "text": "मोर देन 12 इयर्स।"
    },
    {
      "subtitle_id": 8,
      "start": 13.519,
      "end": 16.32,
      "text": "सोने और चांदी की कीमतों में भारी गिरावट"
    },
    {
      "subtitle_id": 9,
      "start": 15.599,
      "end": 19.6,
      "text": "दर्ज की गई है।"
    },
    {
      "subtitle_id": 10,
      "start": 16.32,
      "end": 21.76,
      "text": "प्राइसेस हैव डिक्लाइंड बाय एज़ मच एस 7%"
    },
    {
      "subtitle_id": 11,
      "start": 19.6,
      "end": 24.08,
      "text": "इन द लास्ट टू वीक्स। सो वी विटनेस"
    },
    {
      "subtitle_id": 12,
      "start": 21.76,
      "end": 26.64,
      "text": "डिक्लाइन इन गोल्ड प्राइसेस बाय एज़ मच एस"
    },
    {
      "subtitle_id": 13,
      "start": 24.08,
      "end": 28.48,
      "text": "7% इन द लास्ट टू वीक्स।"
    },
    {
      "subtitle_id": 14,
      "start": 26.64,
      "end": 30.08,
      "text": "ऐसा क्यों हो रहा है? इसका कंक्रीट रीजन"
    },
    {
      "subtitle_id": 15,
      "start": 28.48,
      "end": 32.239,
      "text": "आज के इस वीडियो में हम जानेंगे। साथ ही"
    },
    {
      "subtitle_id": 16,
      "start": 30.08,
      "end": 34.559,
      "text": "पिछले कई दशकों से हमने यह देखा है कि"
    },
    {
      "subtitle_id": 17,
      "start": 32.239,
      "end": 36.64,
      "text": "गोल्ड एक बहुत ही बोरिंग एसेट क्लास रहा"
    },
    {
      "subtitle_id": 18,
      "start": 34.559,
      "end": 38.399,
      "text": "है। हमारे पेरेंट्स, ग्रैंड पेरेंट्स"
    },
    {
      "subtitle_id": 19,
      "start": 36.64,
      "end": 40.0,
      "text": "जनरली कहते हैं कि गोल्ड में कुछ ना कुछ"
    },
    {
      "subtitle_id": 20,
      "start": 38.399,
      "end": 42.239,
      "text": "पैसा डाल के रखो क्योंकि यह स्लोली और"
    },
    {
      "subtitle_id": 21,
      "start": 40.0,
      "end": 44.399,
      "text": "स्टेडीली बढ़ते जाता है और एक काफी सेफ"
    },
    {
      "subtitle_id": 22,
      "start": 42.239,
      "end": 46.48,
      "text": "एसेट क्लास है। लेकिन अगर पिछले तीन-चार"
    },
    {
      "subtitle_id": 23,
      "start": 44.399,
      "end": 49.76,
      "text": "सालों के गोल्ड प्राइस पर नजर डालें तो"
    },
    {
      "subtitle_id": 24,
      "start": 46.48,
      "end": 51.68,
      "text": "सिचुएशन काफी अलग है। गोल्ड गोल्ड नहीं"
    },
    {
      "subtitle_id": 25,
      "start": 49.76,
      "end": 54.0,
      "text": "बल्कि रिसेंटली स्टॉक मार्केट की तरह"
    },
    {
      "subtitle_id": 26,
      "start": 51.68,
      "end": 55.92,
      "text": "परफॉर्म कर रहा है। कभी बहुत ऊपर तो कभी"
    },
    {
      "subtitle_id": 27,
      "start": 54.0,
      "end": 58.079,
      "text": "अचानक से बहुत नीचे। तो आज के इस वीडियो"
    },
    {
      "subtitle_id": 28,
      "start": 55.92,
      "end": 60.0,
      "text": "में हम जानेंगे कि रशिया यूक्रेन वॉर के"
    },
    {
      "subtitle_id": 29,
      "start": 58.079,
      "end": 61.68,
      "text": "बाद अचानक से गोल्ड क्यों स्टॉक मार्केट"
    },
    {
      "subtitle_id": 30,
      "start": 60.0,
      "end": 63.28,
      "text": "की तरह परफॉर्म कर रहा है। आने वाले टाइम"
    },
    {
      "subtitle_id": 31,
      "start": 61.68,
      "end": 64.96,
      "text": "में यह किस डायरेक्शन में जाएगा और अभी"
    },
    {
      "subtitle_id": 32,
      "start": 63.28,
      "end": 67.2,
      "text": "वॉर के टाइम यह इतना ज्यादा क्यों गिर रहा"
    },
    {
      "subtitle_id": 33,
      "start": 64.96,
      "end": 68.96,
      "text": "है और साथ ही जिस तरह के रिटर्न्स गोल्ड"
    },
    {
      "subtitle_id": 34,
      "start": 67.2,
      "end": 70.56,
      "text": "ने अब तक हमें दिए हैं पिछले 3-चार सालों"
    },
    {
      "subtitle_id": 35,
      "start": 68.96,
      "end": 72.64,
      "text": "में क्या उस तरह के रिटर्न्स हमें भविष्य"
    },
    {
      "subtitle_id": 36,
      "start": 70.56,
      "end": 74.56,
      "text": "में भी मिलेंगे यह सारी चीजें आपको खुद ही"
    },
    {
      "subtitle_id": 37,
      "start": 72.64,
      "end": 76.4,
      "text": "पता चल जाएगी इस वीडियो के अंत तक।"
    },
    {
      "subtitle_id": 38,
      "start": 74.56,
      "end": 78.0,
      "text": "नमस्कार, मैं प्रसाद आपका आज के इस वीडियो"
    },
    {
      "subtitle_id": 39,
      "start": 76.4,
      "end": 79.68,
      "text": "में स्वागत करता हूं। तो सबसे पहले एक"
    },
    {
      "subtitle_id": 40,
      "start": 78.0,
      "end": 82.479,
      "text": "बहुत ही बेसिक चीज के बारे में बात करते"
    },
    {
      "subtitle_id": 41,
      "start": 79.68,
      "end": 84.56,
      "text": "हैं जिसके बारे में 99.99%"
    },
    {
      "subtitle_id": 42,
      "start": 82.479,
      "end": 86.64,
      "text": "लोगों को पता ही नहीं है कि जब आप गोल्ड"
    },
    {
      "subtitle_id": 43,
      "start": 84.56,
      "end": 88.4,
      "text": "की प्राइस Google पर सर्च करने जाते हो तो"
    },
    {
      "subtitle_id": 44,
      "start": 86.64,
      "end": 90.32,
      "text": "वो प्राइस आती कहां से है? बहुत सारे"
    },
    {
      "subtitle_id": 45,
      "start": 88.4,
      "end": 92.479,
      "text": "लोगों को लगता है कि दिन भर जो हमारे हम"
    },
    {
      "subtitle_id": 46,
      "start": 90.32,
      "end": 93.92,
      "text": "ज्वेलर के पास गोल्ड खरीदने जाते हैं, इधर"
    },
    {
      "subtitle_id": 47,
      "start": 92.479,
      "end": 96.079,
      "text": "खरीदने जाते हैं तो उस सप्लाई एंड डिमांड"
    },
    {
      "subtitle_id": 48,
      "start": 93.92,
      "end": 98.4,
      "text": "से उसकी प्राइस डिसाइड होती है। लेकिन ऐसा"
    },
    {
      "subtitle_id": 49,
      "start": 96.079,
      "end": 100.4,
      "text": "नहीं है। देखिए गोल्ड की प्राइसेस मेनली"
    },
    {
      "subtitle_id": 50,
      "start": 98.4,
      "end": 102.56,
      "text": "दो जगह पर डिसाइड होती है। पहली है"
    },
    {
      "subtitle_id": 51,
      "start": 100.4,
      "end": 104.799,
      "text": "कॉमिक्स यानी कि द कमोडिटी एक्सचेंज इन"
    },
    {
      "subtitle_id": 52,
      "start": 102.56,
      "end": 107.28,
      "text": "न्यूयॉर्क और दूसरा है एलबीएमए यानी कि द"
    },
    {
      "subtitle_id": 53,
      "start": 104.799,
      "end": 109.84,
      "text": "लंदन बुलियन मार्केट एसोसिएशन। यहां पर"
    },
    {
      "subtitle_id": 54,
      "start": 107.28,
      "end": 112.079,
      "text": "दिन में दो बार यानी सुबह 10:30 और दोपहर"
    },
    {
      "subtitle_id": 55,
      "start": 109.84,
      "end": 113.52,
      "text": "के 3:00 बजे लंदन टाइम के अनुसार जो कुछ"
    },
    {
      "subtitle_id": 56,
      "start": 112.079,
      "end": 115.52,
      "text": "मेजर बैंक्स हैं बहुत बड़ी वो"
    },
    {
      "subtitle_id": 57,
      "start": 113.52,
      "end": 117.6,
      "text": "इलेक्ट्रॉनिक ऑक्शन करती है गोल्ड का और"
    },
    {
      "subtitle_id": 58,
      "start": 115.52,
      "end": 119.36,
      "text": "उस ऑक्शन की प्राइस के बेसिस पर गोल्ड की"
    },
    {
      "subtitle_id": 59,
      "start": 117.6,
      "end": 120.88,
      "text": "प्राइस डिसाइड होती है। अब यह तो समझ में"
    },
    {
      "subtitle_id": 60,
      "start": 119.36,
      "end": 122.32,
      "text": "आ गया कि जो भी हम गोल्ड की प्राइस देख"
    },
    {
      "subtitle_id": 61,
      "start": 120.88,
      "end": 124.079,
      "text": "रहे हैं वो आ कहां से रही है। लेकिन ये"
    },
    {
      "subtitle_id": 62,
      "start": 122.32,
      "end": 125.84,
      "text": "डिसाइड कौन कर रहा है? देखिए जो गोल्ड की"
    },
    {
      "subtitle_id": 63,
      "start": 124.079,
      "end": 127.6,
      "text": "प्राइस है इफेक्टिवली हैंडफुल ऑफ"
    },
    {
      "subtitle_id": 64,
      "start": 125.84,
      "end": 130.16,
      "text": "बड़े-बड़े इंस्टीटशंस डिसाइड करते हैं।"
    },
    {
      "subtitle_id": 65,
      "start": 127.6,
      "end": 132.239,
      "text": "जैसे कि जेपी मॉ्गन, एचएसबीसी, गोल्डमैन"
    },
    {
      "subtitle_id": 66,
      "start": 130.16,
      "end": 133.84,
      "text": "सैक, सिटी बैंक, बार्कलेस, यूबीएस"
    },
    {
      "subtitle_id": 67,
      "start": 132.239,
      "end": 136.239,
      "text": "एटसेट्रा। यह बड़ी-बड़ी फाइनेंसियल"
    },
    {
      "subtitle_id": 68,
      "start": 133.84,
      "end": 138.64,
      "text": "इंस्टीटशंस कॉमिक्स का फ्यूचर्स मार्केट"
    },
    {
      "subtitle_id": 69,
      "start": 136.239,
      "end": 140.56,
      "text": "और लंदन ऑक्शन दोनों को डोमिनेट करते हैं।"
    },
    {
      "subtitle_id": 70,
      "start": 138.64,
      "end": 142.56,
      "text": "और अंदर की बात बता दूं तो कई बार यहां पर"
    },
    {
      "subtitle_id": 71,
      "start": 140.56,
      "end": 145.92,
      "text": "छोटे-मोटे मैनिपुलेशन भी होते हैं। जिसके"
    },
    {
      "subtitle_id": 72,
      "start": 142.56,
      "end": 148.0,
      "text": "लिए जेपी मॉ्गन को 2020 में लगभग $900"
    },
    {
      "subtitle_id": 73,
      "start": 145.92,
      "end": 150.48,
      "text": "मिलियन का फाइन भी लगा था। इन्होंने"
    },
    {
      "subtitle_id": 74,
      "start": 148.0,
      "end": 152.48,
      "text": "जानबूझकर गोल्ड की प्राइस बढ़ाई थी। खैर"
    },
    {
      "subtitle_id": 75,
      "start": 150.48,
      "end": 154.4,
      "text": "वो एक अलग मामला है। हिस्टोरिकली देखें तो"
    },
    {
      "subtitle_id": 76,
      "start": 152.48,
      "end": 156.72,
      "text": "गोल्ड सिर्फ एक एसेट नहीं है। हम इंडियंस"
    },
    {
      "subtitle_id": 77,
      "start": 154.4,
      "end": 158.72,
      "text": "के लिए एक इमोशन है। सबसे सेफ सबसे"
    },
    {
      "subtitle_id": 78,
      "start": 156.72,
      "end": 160.8,
      "text": "भरोसेमंद। लेकिन रिसेंट टाइम में गोल्ड के"
    },
    {
      "subtitle_id": 79,
      "start": 158.72,
      "end": 162.4,
      "text": "मार्केट क्रैश ने हमें एक बहुतेंस सीख दी"
    },
    {
      "subtitle_id": 80,
      "start": 160.8,
      "end": 164.48,
      "text": "है कि फाइनेंसियल वर्ल्ड में कुछ भी"
    },
    {
      "subtitle_id": 81,
      "start": 162.4,
      "end": 166.16,
      "text": "परमानेंट नहीं है। लेकिन एक चीज समझिए कि"
    },
    {
      "subtitle_id": 82,
      "start": 164.48,
      "end": 168.239,
      "text": "गोल्ड का क्रैश रिकवर हो सकता है। मार्केट"
    },
    {
      "subtitle_id": 83,
      "start": 166.16,
      "end": 170.64,
      "text": "रिकवर हो जाएगा। लेकिन इंसान का क्रैश,"
    },
    {
      "subtitle_id": 84,
      "start": 168.239,
      "end": 172.4,
      "text": "हेल्थ का क्रैश, लाइफ का क्रैश वो इतनी"
    },
    {
      "subtitle_id": 85,
      "start": 170.64,
      "end": 174.4,
      "text": "जल्दी रिकवर नहीं होता। क्या आपने कभी"
    },
    {
      "subtitle_id": 86,
      "start": 172.4,
      "end": 176.56,
      "text": "सोचा कि अगर कल कोई अनएक्सेक्टेड मेडिकल"
    },
    {
      "subtitle_id": 87,
      "start": 174.4,
      "end": 178.72,
      "text": "इमरजेंसी आई? तो क्या आपके पास हॉस्पिटल"
    },
    {
      "subtitle_id": 88,
      "start": 176.56,
      "end": 180.72,
      "text": "के ₹-10 लाख के बिल्स भरने का बैकअप है?"
    },
    {
      "subtitle_id": 89,
      "start": 178.72,
      "end": 182.72,
      "text": "ऐसे में गोल्ड बेचकर इलाज करवाना पड़े,"
    },
    {
      "subtitle_id": 90,
      "start": 180.72,
      "end": 184.56,
      "text": "इससे बुरी फाइनेंसियल सिचुएशन कोई नहीं हो"
    },
    {
      "subtitle_id": 91,
      "start": 182.72,
      "end": 186.159,
      "text": "सकती। इसके लिए हेल्थ इंश्योरेंस होना आज"
    },
    {
      "subtitle_id": 92,
      "start": 184.56,
      "end": 188.239,
      "text": "के टाइम के लिए सबसे इंपॉर्टेंट"
    },
    {
      "subtitle_id": 93,
      "start": 186.159,
      "end": 190.48,
      "text": "इन्वेस्टमेंट है। सिर्फ ₹700 से ₹900"
    },
    {
      "subtitle_id": 94,
      "start": 188.239,
      "end": 192.48,
      "text": "महीने में आपको 10 से 20 लाख तक का फैमिली"
    },
    {
      "subtitle_id": 95,
      "start": 190.48,
      "end": 194.4,
      "text": "कवर मिल जाता है जो मुश्किल वक्त में आपकी"
    },
    {
      "subtitle_id": 96,
      "start": 192.48,
      "end": 196.48,
      "text": "बरसों की मेहनत की सेविंग्स को प्रोटेक्ट"
    },
    {
      "subtitle_id": 97,
      "start": 194.4,
      "end": 198.72,
      "text": "करता है। और अभी लेना और भी स्मार्ट मूव"
    },
    {
      "subtitle_id": 98,
      "start": 196.48,
      "end": 200.48,
      "text": "है क्योंकि इस पर जो 18% जीएसटी पहले लगता"
    },
    {
      "subtitle_id": 99,
      "start": 198.72,
      "end": 202.159,
      "text": "था वो अभी नहीं लगता है तो 18% की"
    },
    {
      "subtitle_id": 100,
      "start": 200.48,
      "end": 204.56,
      "text": "डायरेक्ट सेविंग। लेकिन प्रॉब्लम यह है कि"
    },
    {
      "subtitle_id": 101,
      "start": 202.159,
      "end": 206.4,
      "text": "ऑनलाइन 25 प्लस कंपनीज़ और 100्स ऑफ प्लांस"
    },
    {
      "subtitle_id": 102,
      "start": 204.56,
      "end": 207.84,
      "text": "हैं। इसीलिए पॉलिसी ऐसे प्लेटफार्म से ले"
    },
    {
      "subtitle_id": 103,
      "start": 206.4,
      "end": 209.599,
      "text": "जो आपको जेन्युइन गाइडेंस दे और सिर्फ"
    },
    {
      "subtitle_id": 104,
      "start": 207.84,
      "end": 211.44,
      "text": "इंश्योरेंस खरीदते टाइम नहीं बल्कि क्लेम"
    },
    {
      "subtitle_id": 105,
      "start": 209.599,
      "end": 213.36,
      "text": "के टाइम आपके साथ खड़े रहे। तो ऐसे ही"
    },
    {
      "subtitle_id": 106,
      "start": 211.44,
      "end": 215.84,
      "text": "मेरा एक फेवरेट प्लेटफार्म है डिट्टो dटो"
    },
    {
      "subtitle_id": 107,
      "start": 213.36,
      "end": 217.44,
      "text": "इज बैक बाय zerधा आईआरडीए सर्टिफाइड एंड"
    },
    {
      "subtitle_id": 108,
      "start": 215.84,
      "end": 219.599,
      "text": "जेन्युइन इंश्योरेंस बाइंग प्लेटफार्म"
    },
    {
      "subtitle_id": 109,
      "start": 217.44,
      "end": 221.44,
      "text": "डिट्टो के तीन खासियत है पहली वो स्पैम"
    },
    {
      "subtitle_id": 110,
      "start": 219.599,
      "end": 223.519,
      "text": "बिल्कुल नहीं करते जहां बाकी प्लेयर्स"
    },
    {
      "subtitle_id": 111,
      "start": 221.44,
      "end": 225.36,
      "text": "बार-बार कॉल करके परेशान करते हैं वहीं पर"
    },
    {
      "subtitle_id": 112,
      "start": 223.519,
      "end": 226.799,
      "text": "यह लोग यह चीज बिल्कुल नहीं करते दूसरी"
    },
    {
      "subtitle_id": 113,
      "start": 225.36,
      "end": 228.72,
      "text": "चीज वो आपको इंश्योरेंस लेने के लिए"
    },
    {
      "subtitle_id": 114,
      "start": 226.799,
      "end": 230.72,
      "text": "बिल्कुल फोर्स नहीं करते और तीसरी चीज वो"
    },
    {
      "subtitle_id": 115,
      "start": 228.72,
      "end": 232.64,
      "text": "आपको मिससेल नहीं करते आपके लिए जो बेस्ट"
    },
    {
      "subtitle_id": 116,
      "start": 230.72,
      "end": 234.319,
      "text": "है वही आपको बताते हैं। साथ ही क्लेम"
    },
    {
      "subtitle_id": 117,
      "start": 232.64,
      "end": 235.92,
      "text": "प्रोसेस में भी वो आपके साथ खड़े रहते"
    },
    {
      "subtitle_id": 118,
      "start": 234.319,
      "end": 237.84,
      "text": "हैं। तो अभी तक आपने हेल्थ टर्म"
    },
    {
      "subtitle_id": 119,
      "start": 235.92,
      "end": 239.439,
      "text": "इंश्योरेंस प्लान नहीं लिया है। काफी सोच"
    },
    {
      "subtitle_id": 120,
      "start": 237.84,
      "end": 241.2,
      "text": "रहे हो बहुत सारे डाउट्स हैं मन में। अभी"
    },
    {
      "subtitle_id": 121,
      "start": 239.439,
      "end": 242.64,
      "text": "डिट्टो के साथ 30 मिनट का काउंसलिंग कॉल"
    },
    {
      "subtitle_id": 122,
      "start": 241.2,
      "end": 244.319,
      "text": "बुक कीजिए नीचे डिस्क्रिप्शन और कमेंट"
    },
    {
      "subtitle_id": 123,
      "start": 242.64,
      "end": 246.319,
      "text": "बॉक्स में दिए गए लिंक पर क्लिक करके और"
    },
    {
      "subtitle_id": 124,
      "start": 244.319,
      "end": 247.92,
      "text": "अपने सारे डाउट्स बेझिझक उनसे पूछिए।"
    },
    {
      "subtitle_id": 125,
      "start": 246.319,
      "end": 249.76,
      "text": "दोनों टर्म एंड हेल्थ इंश्योरेंस का लिंक"
    },
    {
      "subtitle_id": 126,
      "start": 247.92,
      "end": 251.599,
      "text": "आपको नीचे मिल जाएगा और देरी मत कीजिए"
    },
    {
      "subtitle_id": 127,
      "start": 249.76,
      "end": 253.28,
      "text": "जितनी देरी करोगे प्राइसेस उतनी बढ़ती"
    },
    {
      "subtitle_id": 128,
      "start": 251.599,
      "end": 255.599,
      "text": "रहती है। अब बढ़ते हैं वीडियो की तरफ। तो"
    },
    {
      "subtitle_id": 129,
      "start": 253.28,
      "end": 258.4,
      "text": "अब आते हैं अपने मुद्दे पर कि साल 2022"
    },
    {
      "subtitle_id": 130,
      "start": 255.599,
      "end": 260.72,
      "text": "में ऐसा क्या हुआ कि गोल्ड गोल्ड नहीं"
    },
    {
      "subtitle_id": 131,
      "start": 258.4,
      "end": 263.44,
      "text": "बल्कि स्टॉक मार्केट की तरह परफॉर्म करने"
    },
    {
      "subtitle_id": 132,
      "start": 260.72,
      "end": 265.44,
      "text": "लगा। तो देखिए बात है फरवरी 2022 की रशिया"
    },
    {
      "subtitle_id": 133,
      "start": 263.44,
      "end": 268.32,
      "text": "और यूक्रेन के बीच वॉर शुरू हो गई।"
    },
    {
      "subtitle_id": 134,
      "start": 265.44,
      "end": 270.4,
      "text": "यूनाइटेड स्टेट्स और उसके G7 एलीज ने कुछ"
    },
    {
      "subtitle_id": 135,
      "start": 268.32,
      "end": 273.52,
      "text": "ऐसा किया जो पहले कभी नहीं हुआ था।"
    },
    {
      "subtitle_id": 136,
      "start": 270.4,
      "end": 275.36,
      "text": "उन्होंने रशिया के $300 बिलियन के फॉरेन"
    },
    {
      "subtitle_id": 137,
      "start": 273.52,
      "end": 277.28,
      "text": "एक्सचेंज रिजर्व यानी ऐसा पैसा जो"
    },
    {
      "subtitle_id": 138,
      "start": 275.36,
      "end": 279.36,
      "text": "वेस्टर्न बैंक्स में पड़ा था यूरोस में,"
    },
    {
      "subtitle_id": 139,
      "start": 277.28,
      "end": 281.6,
      "text": "डॉलर्स में, पाउंड्स में, यन में वो पूरी"
    },
    {
      "subtitle_id": 140,
      "start": 279.36,
      "end": 283.52,
      "text": "तरह से फ्रीज़ कर दिया। रशिया पिछले कई"
    },
    {
      "subtitle_id": 141,
      "start": 281.6,
      "end": 285.44,
      "text": "सालों से इकोनॉमिक इंश्योरेंस की तरह उस"
    },
    {
      "subtitle_id": 142,
      "start": 283.52,
      "end": 287.44,
      "text": "पैसे को वेस्टर्न बैंक्स में रख रही थी।"
    },
    {
      "subtitle_id": 143,
      "start": 285.44,
      "end": 288.96,
      "text": "यानी कि अगर रशियन करेंसी को रशियन इकॉनमी"
    },
    {
      "subtitle_id": 144,
      "start": 287.44,
      "end": 290.88,
      "text": "को कुछ हो जाता है तो ऐसे केस में एक"
    },
    {
      "subtitle_id": 145,
      "start": 288.96,
      "end": 292.96,
      "text": "बैकअप होना चाहिए। लेकिन अब यह बैकअप"
    },
    {
      "subtitle_id": 146,
      "start": 290.88,
      "end": 295.12,
      "text": "रशिया के लिए इनसेबल था। अब वेस्टर्न"
    },
    {
      "subtitle_id": 147,
      "start": 292.96,
      "end": 297.199,
      "text": "मीडिया की इस चीज पर टिप्पणी यह थी कि"
    },
    {
      "subtitle_id": 148,
      "start": 295.12,
      "end": 299.52,
      "text": "रशिया का जो अग्रेशन है उसे रोकने के लिए"
    },
    {
      "subtitle_id": 149,
      "start": 297.199,
      "end": 301.6,
      "text": "हम ऐसा कर रहे हैं। लेकिन यूएसए और इन G7"
    },
    {
      "subtitle_id": 150,
      "start": 299.52,
      "end": 303.68,
      "text": "कंट्रीज को छोड़ के बाकी कंट्रीज के"
    },
    {
      "subtitle_id": 151,
      "start": 301.6,
      "end": 305.6,
      "text": "फाइनेंस मिनिस्ट्री ने कुछ अलग ही सुना।"
    },
    {
      "subtitle_id": 152,
      "start": 303.68,
      "end": 308.4,
      "text": "मैसेज क्लियर था कि जो आपके डॉलर रिजर्व्स"
    },
    {
      "subtitle_id": 153,
      "start": 305.6,
      "end": 310.72,
      "text": "हैं वो तब तक सेफ है जब तक आपके यूएस के"
    },
    {
      "subtitle_id": 154,
      "start": 308.4,
      "end": 312.479,
      "text": "साथ अच्छे रिलेशन है। लेकिन जिस समय यह"
    },
    {
      "subtitle_id": 155,
      "start": 310.72,
      "end": 314.8,
      "text": "रिलेशन खराब हो जाएंगे उन रिजर्व्स की"
    },
    {
      "subtitle_id": 156,
      "start": 312.479,
      "end": 316.4,
      "text": "कीमत ना के बराबर हो सकती है। तभी दुनिया"
    },
    {
      "subtitle_id": 157,
      "start": 314.8,
      "end": 318.24,
      "text": "भर की कंट्रीज के जो सेंट्रल बैंक्स हैं"
    },
    {
      "subtitle_id": 158,
      "start": 316.4,
      "end": 320.72,
      "text": "इन्होंने सोचा कि ऐसा क्या कर सकते हैं?"
    },
    {
      "subtitle_id": 159,
      "start": 318.24,
      "end": 322.96,
      "text": "जिसे यूएस फ्रीज़ नहीं कर सकता। जवाब था"
    },
    {
      "subtitle_id": 160,
      "start": 320.72,
      "end": 325.12,
      "text": "गोल्ड। गोल्ड एक ऐसा एसेट क्लास है जिसे"
    },
    {
      "subtitle_id": 161,
      "start": 322.96,
      "end": 327.039,
      "text": "कोई सेंशन नहीं कर सकता। कोई फ्रीज भी"
    },
    {
      "subtitle_id": 162,
      "start": 325.12,
      "end": 328.72,
      "text": "नहीं कर सकता। साथ ही इसमें कोई डिफॉल्ट"
    },
    {
      "subtitle_id": 163,
      "start": 327.039,
      "end": 330.96,
      "text": "या काउंटर पार्टी रिस्क भी नहीं है। आप"
    },
    {
      "subtitle_id": 164,
      "start": 328.72,
      "end": 333.52,
      "text": "इसे फिजिकली होल्ड करते हो अपने वॉल्ट में"
    },
    {
      "subtitle_id": 165,
      "start": 330.96,
      "end": 335.6,
      "text": "अपनी सरजमी पर। इसके बाद जो हुआ वो सारी"
    },
    {
      "subtitle_id": 166,
      "start": 333.52,
      "end": 337.84,
      "text": "चीजें डाटा अपने आप बयां करता है। सेंट्रल"
    },
    {
      "subtitle_id": 167,
      "start": 335.6,
      "end": 340.24,
      "text": "बैंक्स ने गोल्ड खरीदना शुरू किया। हां,"
    },
    {
      "subtitle_id": 168,
      "start": 337.84,
      "end": 342.639,
      "text": "डायवर्सिफिकेशन के लिए नहीं अपनी सेफ्टी"
    },
    {
      "subtitle_id": 169,
      "start": 340.24,
      "end": 345.44,
      "text": "के लिए। इन ईयर 2022 सेंट्रल बैंक्स ने"
    },
    {
      "subtitle_id": 170,
      "start": 342.639,
      "end": 348.8,
      "text": "₹182 टन्स ऑफ गोल्ड खरीद लिया। यह फिगर"
    },
    {
      "subtitle_id": 171,
      "start": 345.44,
      "end": 352.16,
      "text": "1950 के बाद हाईएस्ट रही है। अगले साल"
    },
    {
      "subtitle_id": 172,
      "start": 348.8,
      "end": 355.039,
      "text": "2023 में अगेन ₹137 टन्स ऑफ गोल्ड खरीदा"
    },
    {
      "subtitle_id": 173,
      "start": 352.16,
      "end": 357.919,
      "text": "गया। अगले साल 1045 टन्स यानी कि तीन"
    },
    {
      "subtitle_id": 174,
      "start": 355.039,
      "end": 360.32,
      "text": "क्सक्यूटिव इयर्स में 1000 टन से ज्यादा"
    },
    {
      "subtitle_id": 175,
      "start": 357.919,
      "end": 363.6,
      "text": "का गोल्ड खरीदा गया। जबकि इसके पहले दशक"
    },
    {
      "subtitle_id": 176,
      "start": 360.32,
      "end": 366.4,
      "text": "का जो एनुअल एवरेज था वो 473 टन्स का था।"
    },
    {
      "subtitle_id": 177,
      "start": 363.6,
      "end": 368.56,
      "text": "यानी डबल से ज्यादा हुआ। यानी कि वो गोल्ड"
    },
    {
      "subtitle_id": 178,
      "start": 366.4,
      "end": 371.199,
      "text": "जिसे सेंट्रल बैंक्स डायवर्सिफिकेशन के"
    },
    {
      "subtitle_id": 179,
      "start": 368.56,
      "end": 373.919,
      "text": "तौर पर अपने पास रखती थी। अब वो उसे अपना"
    },
    {
      "subtitle_id": 180,
      "start": 371.199,
      "end": 376.479,
      "text": "मेन हथियार बना रही थी। जो एक ऐसा हथियार"
    },
    {
      "subtitle_id": 181,
      "start": 373.919,
      "end": 378.56,
      "text": "जो खराब समय उस कंट्री के काम में आए।"
    },
    {
      "subtitle_id": 182,
      "start": 376.479,
      "end": 380.24,
      "text": "यूएस ट्रेजरी की तरह नहीं जो कभी भी"
    },
    {
      "subtitle_id": 183,
      "start": 378.56,
      "end": 382.24,
      "text": "प्रॉब्लम में आ सकती है। अब देखिए जब भी"
    },
    {
      "subtitle_id": 184,
      "start": 380.24,
      "end": 384.08,
      "text": "ये सेंट्रल बैंक्स गोल्ड खरीदती है तो"
    },
    {
      "subtitle_id": 185,
      "start": 382.24,
      "end": 385.6,
      "text": "तुरंत उसकी प्राइस कॉमिक्स मार्केट में"
    },
    {
      "subtitle_id": 186,
      "start": 384.08,
      "end": 387.36,
      "text": "रिफ्लेक्ट नहीं होती है। क्योंकि जो"
    },
    {
      "subtitle_id": 187,
      "start": 385.6,
      "end": 389.52,
      "text": "सेंट्रल बैंक्स हैं ये बड़ी-बड़ी बैंक्स"
    },
    {
      "subtitle_id": 188,
      "start": 387.36,
      "end": 391.36,
      "text": "की तरह एक्सचेंजेस पर ट्रेड नहीं करते। ये"
    },
    {
      "subtitle_id": 189,
      "start": 389.52,
      "end": 393.36,
      "text": "ट्रेड करते हैं प्राइवेटली और ओवर द"
    },
    {
      "subtitle_id": 190,
      "start": 391.36,
      "end": 395.68,
      "text": "काउंटर। इसीलिए कई बार सेंट्रल बैंक्स की"
    },
    {
      "subtitle_id": 191,
      "start": 393.36,
      "end": 398.0,
      "text": "बाइंग आपको काफी स्लो दिखती है और महीनों"
    },
    {
      "subtitle_id": 192,
      "start": 395.68,
      "end": 400.72,
      "text": "तक अनरपोर्टेड। लेकिन शॉर्ट टर्म में नहीं"
    },
    {
      "subtitle_id": 193,
      "start": 398.0,
      "end": 402.96,
      "text": "लेकिन लॉन्ग टर्म में जो डिमांड है वह"
    },
    {
      "subtitle_id": 194,
      "start": 400.72,
      "end": 405.759,
      "text": "प्राइस में रिफ्लेक्ट होगी ही होगी और इसी"
    },
    {
      "subtitle_id": 195,
      "start": 402.96,
      "end": 407.84,
      "text": "के चलते 2025 के स्टार्टिंग से गोल्ड में"
    },
    {
      "subtitle_id": 196,
      "start": 405.759,
      "end": 411.52,
      "text": "एक बहुत बड़ी रैली देखने मिली। सिर्फ एक"
    },
    {
      "subtitle_id": 197,
      "start": 407.84,
      "end": 413.12,
      "text": "साल में 53 ऑल टाइम हाई देखने मिले। 65%"
    },
    {
      "subtitle_id": 198,
      "start": 411.52,
      "end": 416.24,
      "text": "से गोल्ड की प्राइस एक साल में बढ़ गई"
    },
    {
      "subtitle_id": 199,
      "start": 413.12,
      "end": 418.08,
      "text": "जिसके चलते जो 1979 के बाद किसी साल गोल्ड"
    },
    {
      "subtitle_id": 200,
      "start": 416.24,
      "end": 419.919,
      "text": "की बेस्ट परफॉर्मेंस थी। अब गोल्ड जैसे"
    },
    {
      "subtitle_id": 201,
      "start": 418.08,
      "end": 422.0,
      "text": "एसेट क्लास में जब इस तरह की रैली देखने"
    },
    {
      "subtitle_id": 202,
      "start": 419.919,
      "end": 424.0,
      "text": "मिलती है तो दो चीजें होती हैं। मीडिया"
    },
    {
      "subtitle_id": 203,
      "start": 422.0,
      "end": 426.24,
      "text": "उसे बहुत अग्रेसिवली कवर करना शुरू करती"
    },
    {
      "subtitle_id": 204,
      "start": 424.0,
      "end": 428.319,
      "text": "है और सेकंड रिटेल इन्वेस्टर उस एसेट"
    },
    {
      "subtitle_id": 205,
      "start": 426.24,
      "end": 430.72,
      "text": "क्लास को अग्रेसिवली बाय करना शुरू करते"
    },
    {
      "subtitle_id": 206,
      "start": 428.319,
      "end": 433.52,
      "text": "हैं। फिर इसके बाद क्या था? तो 2025 में"
    },
    {
      "subtitle_id": 207,
      "start": 430.72,
      "end": 436.319,
      "text": "ग्लोबल गोल्ड ईटीएफ होल्डिंग 801 टन से"
    },
    {
      "subtitle_id": 208,
      "start": 433.52,
      "end": 439.12,
      "text": "बढ़ गई। 2025 में गोल्ड की टोटल डिमांड"
    },
    {
      "subtitle_id": 209,
      "start": 436.319,
      "end": 440.96,
      "text": "5000 टन से भी ज्यादा हो गई जो हिस्ट्री"
    },
    {
      "subtitle_id": 210,
      "start": 439.12,
      "end": 443.039,
      "text": "में पहली बार हो रहा था। तो यहां पर"
    },
    {
      "subtitle_id": 211,
      "start": 440.96,
      "end": 444.88,
      "text": "सेंट्रल बैंक्स ने क्वाइटली एक ट्रेन यहां"
    },
    {
      "subtitle_id": 212,
      "start": 443.039,
      "end": 446.72,
      "text": "पर सेट कर लिया था। और जैसे ही यह ट्रेन"
    },
    {
      "subtitle_id": 213,
      "start": 444.88,
      "end": 448.639,
      "text": "विजिबल होने लगा, मीडिया ने उसे छापना"
    },
    {
      "subtitle_id": 214,
      "start": 446.72,
      "end": 450.72,
      "text": "शुरू किया और फिर रिटेल इन्वेस्टर्स ताकत"
    },
    {
      "subtitle_id": 215,
      "start": 448.639,
      "end": 452.639,
      "text": "से उस पर टूट पड़े। रिजल्ट क्या था? तो"
    },
    {
      "subtitle_id": 216,
      "start": 450.72,
      "end": 455.039,
      "text": "गोल्ड जितना बढ़ना चाहिए था, उससे काफी"
    },
    {
      "subtitle_id": 217,
      "start": 452.639,
      "end": 457.36,
      "text": "ज्यादा बढ़ गया। अभी जनवरी 29 को गोल्ड ने"
    },
    {
      "subtitle_id": 218,
      "start": 455.039,
      "end": 460.24,
      "text": "एक नया ऑल टाइम हाई सेट किया। मतलब यह वो"
    },
    {
      "subtitle_id": 219,
      "start": 457.36,
      "end": 462.8,
      "text": "टाइम था जो गोल्ड के बुल रन का पीक था। अब"
    },
    {
      "subtitle_id": 220,
      "start": 460.24,
      "end": 465.599,
      "text": "इसी बुल रन के बीच कुछ ऐसा हुआ जिसने"
    },
    {
      "subtitle_id": 221,
      "start": 462.8,
      "end": 467.759,
      "text": "इंस्टीट्यूशन इन्वेस्टर्स को यह गोल्ड सेल"
    },
    {
      "subtitle_id": 222,
      "start": 465.599,
      "end": 469.599,
      "text": "करने का एक कारण दिया। 28th फरवरी को"
    },
    {
      "subtitle_id": 223,
      "start": 467.759,
      "end": 471.36,
      "text": "यूनाइटेड स्टेट्स ने ईरान पर मिलिट्री"
    },
    {
      "subtitle_id": 224,
      "start": 469.599,
      "end": 472.96,
      "text": "स्ट्राइक शुरू कर दी। इस कॉन्फ्लिक्ट के"
    },
    {
      "subtitle_id": 225,
      "start": 471.36,
      "end": 474.639,
      "text": "चलते क्या हुआ? क्रूड ऑयल की प्राइसेस"
    },
    {
      "subtitle_id": 226,
      "start": 472.96,
      "end": 476.8,
      "text": "बहुत तेजी से आगे बढ़ने लगी। अब जब भी"
    },
    {
      "subtitle_id": 227,
      "start": 474.639,
      "end": 478.72,
      "text": "क्रूड ऑयल की प्राइसेस बढ़ती है तो ऑयल"
    },
    {
      "subtitle_id": 228,
      "start": 476.8,
      "end": 481.68,
      "text": "इंपोर्टिंग कंट्रीज रोती है लेकिन एक"
    },
    {
      "subtitle_id": 229,
      "start": 478.72,
      "end": 483.599,
      "text": "कंट्री है जो हंसती है वो है यूएस। क्यों?"
    },
    {
      "subtitle_id": 230,
      "start": 481.68,
      "end": 485.52,
      "text": "देखिए ये एक मैकेनिज्म है जो आपको बहुत"
    },
    {
      "subtitle_id": 231,
      "start": 483.599,
      "end": 487.52,
      "text": "अच्छे से समझना जरूरी है। तो देखिए ऑयल"
    },
    {
      "subtitle_id": 232,
      "start": 485.52,
      "end": 489.599,
      "text": "डॉलर में खरीदा जाता है। तो जब ये ऑयल की"
    },
    {
      "subtitle_id": 233,
      "start": 487.52,
      "end": 491.52,
      "text": "प्राइस बढ़ती है तो जो ऑयल इंपोर्टिंग"
    },
    {
      "subtitle_id": 234,
      "start": 489.599,
      "end": 493.68,
      "text": "कंट्रीज है फिर उसमें इंडिया हो, जापान"
    },
    {
      "subtitle_id": 235,
      "start": 491.52,
      "end": 495.759,
      "text": "हो, साउथ कोरिया है, जर्मनी है। इन सबको"
    },
    {
      "subtitle_id": 236,
      "start": 493.68,
      "end": 497.599,
      "text": "बहुत ज्यादा डॉलर्स खरीदने पड़ते हैं अपने"
    },
    {
      "subtitle_id": 237,
      "start": 495.759,
      "end": 499.68,
      "text": "इंपोर्ट बिल्स चुकाने के लिए। इससे"
    },
    {
      "subtitle_id": 238,
      "start": 497.599,
      "end": 502.0,
      "text": "ग्लोबली क्या होगा? डॉलर की डिमांड बढ़ेगी"
    },
    {
      "subtitle_id": 239,
      "start": 499.68,
      "end": 504.4,
      "text": "तो डॉलर की प्राइस बढ़ेगी। डॉलर और ज्यादा"
    },
    {
      "subtitle_id": 240,
      "start": 502.0,
      "end": 506.16,
      "text": "स्ट्रांग बन जाएगा और स्ट्रांग डॉलर गोल्ड"
    },
    {
      "subtitle_id": 241,
      "start": 504.4,
      "end": 508.72,
      "text": "को कंप्रेस करता है। और आपको बता दूं कि"
    },
    {
      "subtitle_id": 242,
      "start": 506.16,
      "end": 510.479,
      "text": "जनरली गोल्ड और डॉलर इन्वर्सली चलते हैं।"
    },
    {
      "subtitle_id": 243,
      "start": 508.72,
      "end": 512.08,
      "text": "यानी एक स्ट्रांग हो जाए तो दूसरा थोड़ा"
    },
    {
      "subtitle_id": 244,
      "start": 510.479,
      "end": 513.919,
      "text": "वीक हो जाता है। दूसरा स्ट्रांग हो जाए तो"
    },
    {
      "subtitle_id": 245,
      "start": 512.08,
      "end": 515.76,
      "text": "पहला थोड़ा वीक हो जाता है। अब इसी बीच जो"
    },
    {
      "subtitle_id": 246,
      "start": 513.919,
      "end": 517.839,
      "text": "इंस्टीट्यूशनल इन्वेस्टर्स हैं उन्हें भी"
    },
    {
      "subtitle_id": 247,
      "start": 515.76,
      "end": 519.76,
      "text": "सोचने में इस सिचुएशन ने मजबूर किया। अब"
    },
    {
      "subtitle_id": 248,
      "start": 517.839,
      "end": 522.56,
      "text": "मैं कहता हूं कि आप ही सोचिए कि आप एक हैच"
    },
    {
      "subtitle_id": 249,
      "start": 519.76,
      "end": 524.72,
      "text": "फंड के मैनेजर हो। आप 2022 से गोल्ड खरीद"
    },
    {
      "subtitle_id": 250,
      "start": 522.56,
      "end": 526.88,
      "text": "रहे हो और आपने देखा कि आपको गोल्ड पर 60"
    },
    {
      "subtitle_id": 251,
      "start": 524.72,
      "end": 528.88,
      "text": "80 100% या उससे ज्यादा का प्रॉफिट मिला"
    },
    {
      "subtitle_id": 252,
      "start": 526.88,
      "end": 530.399,
      "text": "है। यानी आपने जो एसेट खरीदा वो ऑल टाइम"
    },
    {
      "subtitle_id": 253,
      "start": 528.88,
      "end": 532.48,
      "text": "हाइप पर है। लेकिन अभी का जो मै"
    },
    {
      "subtitle_id": 254,
      "start": 530.399,
      "end": 534.32,
      "text": "एनवायरमेंट है वो गोल्ड के बिल्कुल अपोजिट"
    },
    {
      "subtitle_id": 255,
      "start": 532.48,
      "end": 536.56,
      "text": "है। तो आप क्या करोगे? कुछ ना कुछ मात्रा"
    },
    {
      "subtitle_id": 256,
      "start": 534.32,
      "end": 538.64,
      "text": "में तो शायद बेच ही दोगे। तो यहां पर तो"
    },
    {
      "subtitle_id": 257,
      "start": 536.56,
      "end": 541.04,
      "text": "यह करंट एनवायरमेंट ने इन इंस्टीट्यूशनल"
    },
    {
      "subtitle_id": 258,
      "start": 538.64,
      "end": 543.36,
      "text": "इन्वेस्टर्स को एक कारण दिया जस्टिफायबल"
    },
    {
      "subtitle_id": 259,
      "start": 541.04,
      "end": 545.279,
      "text": "एग्जिट करने का, कुछ प्रॉफिट बुक करने का।"
    },
    {
      "subtitle_id": 260,
      "start": 543.36,
      "end": 547.36,
      "text": "ईटीएफ के आउटफ्ल्स एक्सलरेटेड हो गए।"
    },
    {
      "subtitle_id": 261,
      "start": 545.279,
      "end": 549.12,
      "text": "कॉमिक्स पर रैपिड प्रॉफिट टेकिंग होने लगी"
    },
    {
      "subtitle_id": 262,
      "start": 547.36,
      "end": 550.8,
      "text": "और डॉलर स्ट्रांग होने की वजह से यह जो"
    },
    {
      "subtitle_id": 263,
      "start": 549.12,
      "end": 552.72,
      "text": "प्रॉब्लम है यह और ज्यादा बढ़ गया। कई"
    },
    {
      "subtitle_id": 264,
      "start": 550.8,
      "end": 554.56,
      "text": "सारी गल्फ कंट्रीज जो अपना ऑइल एक्सपोर्ट"
    },
    {
      "subtitle_id": 265,
      "start": 552.72,
      "end": 556.24,
      "text": "नहीं कर पा रही थी उन्हें भी लिक्विड कैश"
    },
    {
      "subtitle_id": 266,
      "start": 554.56,
      "end": 558.16,
      "text": "की जरूरत पड़ रही थी जिसके चलते उन्होंने"
    },
    {
      "subtitle_id": 267,
      "start": 556.24,
      "end": 560.24,
      "text": "भी अपना गोल्ड लिक्विडेट करना शुरू किया।"
    },
    {
      "subtitle_id": 268,
      "start": 558.16,
      "end": 562.88,
      "text": "यह सारी चीजें एक साथ हुई जिसके चलते"
    },
    {
      "subtitle_id": 269,
      "start": 560.24,
      "end": 565.04,
      "text": "गोल्ड का वर्स्ट टू मंथ डिक्लाइन था 2008"
    },
    {
      "subtitle_id": 270,
      "start": 562.88,
      "end": 567.12,
      "text": "फाइनेंसियल क्राइसिस के बाद। लेकिन अभी भी"
    },
    {
      "subtitle_id": 271,
      "start": 565.04,
      "end": 569.519,
      "text": "अगर गोल्ड को 2025 के शुरुआती प्राइस से"
    },
    {
      "subtitle_id": 272,
      "start": 567.12,
      "end": 571.519,
      "text": "कंपेयर करें तो आज भी गोल्ड 80% अप है।"
    },
    {
      "subtitle_id": 273,
      "start": 569.519,
      "end": 573.279,
      "text": "बेस्ट परफॉर्मिंग एसेट क्लास है पिछले 3"
    },
    {
      "subtitle_id": 274,
      "start": 571.519,
      "end": 575.76,
      "text": "सालों में और आज दुनिया भर की सेंट्रल"
    },
    {
      "subtitle_id": 275,
      "start": 573.279,
      "end": 577.839,
      "text": "बैंक्स अराउंड 5.2 ट्रिलियन ऑफ गोल्ड"
    },
    {
      "subtitle_id": 276,
      "start": 575.76,
      "end": 579.76,
      "text": "होल्ड कर रही है जो उनके यूएस ट्रेजरी"
    },
    {
      "subtitle_id": 277,
      "start": 577.839,
      "end": 581.92,
      "text": "रिजर्व से भी ज्यादा है और मॉडर्न"
    },
    {
      "subtitle_id": 278,
      "start": 579.76,
      "end": 583.36,
      "text": "हिस्ट्री में ऐसा पहली बार हुआ है। अब"
    },
    {
      "subtitle_id": 279,
      "start": 581.92,
      "end": 586.08,
      "text": "पिक्चर बड़ी क्लियर है कि बहुत सारे लोगों"
    },
    {
      "subtitle_id": 280,
      "start": 583.36,
      "end": 588.32,
      "text": "को लग रहा था कि गोल्ड पिछले साल 6065%"
    },
    {
      "subtitle_id": 281,
      "start": 586.08,
      "end": 590.48,
      "text": "बढ़ा है। यह ऐसे ही बढ़ता रहेगा हर साल।"
    },
    {
      "subtitle_id": 282,
      "start": 588.32,
      "end": 592.0,
      "text": "लेकिन ऐसा नहीं होता है। आपको चारप सालों"
    },
    {
      "subtitle_id": 283,
      "start": 590.48,
      "end": 594.16,
      "text": "में एक आध बार ऐसी अपॉर्चुनिटी आती है,"
    },
    {
      "subtitle_id": 284,
      "start": 592.0,
      "end": 596.16,
      "text": "बुल रन आता है जब इस तरह का पैसा बनता है,"
    },
    {
      "subtitle_id": 285,
      "start": 594.16,
      "end": 597.92,
      "text": "यह हर साल आपको देखने नहीं मिलता। तो ऐसे"
    },
    {
      "subtitle_id": 286,
      "start": 596.16,
      "end": 600.48,
      "text": "में जिस गोल्ड की खासियत है कि वह"
    },
    {
      "subtitle_id": 287,
      "start": 597.92,
      "end": 602.56,
      "text": "स्टेडीली स्लोली ग्रो करता है, कंपाउंड"
    },
    {
      "subtitle_id": 288,
      "start": 600.48,
      "end": 604.16,
      "text": "होते रहता है। वहां पर अगर आप एक्सपेक्ट"
    },
    {
      "subtitle_id": 289,
      "start": 602.56,
      "end": 606.64,
      "text": "कर रहे हो अभी कि बहुत क्रेजी रिटर्न्स"
    },
    {
      "subtitle_id": 290,
      "start": 604.16,
      "end": 608.72,
      "text": "आपको मिल जाएंगे तो वो मिलना काफी मुश्किल"
    },
    {
      "subtitle_id": 291,
      "start": 606.64,
      "end": 611.2,
      "text": "है क्योंकि यूएस ने जो एक चीज की रशिया के"
    },
    {
      "subtitle_id": 292,
      "start": 608.72,
      "end": 613.2,
      "text": "अगेंस्ट में उसके चलते काफी बड़ा बूम हमें"
    },
    {
      "subtitle_id": 293,
      "start": 611.2,
      "end": 614.8,
      "text": "देखने मिला गोल्ड में और इस तरह की चीजें"
    },
    {
      "subtitle_id": 294,
      "start": 613.2,
      "end": 616.72,
      "text": "बार-बार नहीं होती है। बहुत सारे लोगों को"
    },
    {
      "subtitle_id": 295,
      "start": 614.8,
      "end": 617.92,
      "text": "लग रहा है कि हम गोल्ड ज्वेलर के पास जाकर"
    },
    {
      "subtitle_id": 296,
      "start": 616.72,
      "end": 619.68,
      "text": "बहुत ज्यादा गोल्ड खरीद रहे हैं इसलिए"
    },
    {
      "subtitle_id": 297,
      "start": 617.92,
      "end": 621.12,
      "text": "गोल्ड की प्राइसेस ज्यादा बढ़ रही है। ऐसा"
    },
    {
      "subtitle_id": 298,
      "start": 619.68,
      "end": 623.12,
      "text": "नहीं है। ऑफ कोर्स वो भी डिमांड बढ़ रही"
    },
    {
      "subtitle_id": 299,
      "start": 621.12,
      "end": 624.88,
      "text": "है। लेकिन वो एक मेन कारण नहीं है। तो"
    },
    {
      "subtitle_id": 300,
      "start": 623.12,
      "end": 626.959,
      "text": "ओवरऑल देखा जाए तो इस तरह की जो चीजें हैं"
    },
    {
      "subtitle_id": 301,
      "start": 624.88,
      "end": 629.04,
      "text": "वो बार-बार होती नहीं है। तो आपको गोल्ड"
    },
    {
      "subtitle_id": 302,
      "start": 626.959,
      "end": 632.0,
      "text": "से कुछ मॉडरेट रिटर्न्स से एक्सपेक्ट करनी"
    },
    {
      "subtitle_id": 303,
      "start": 629.04,
      "end": 634.0,
      "text": "चाहिए जो जनरली हिस्टोरिकली 10 से 12% है"
    },
    {
      "subtitle_id": 304,
      "start": 632.0,
      "end": 636.8,
      "text": "और अगर आप उससे खुश हैं तो ही आप गोल्ड"
    },
    {
      "subtitle_id": 305,
      "start": 634.0,
      "end": 638.8,
      "text": "में जाइए। अदरवाइज बेटर स्टेयर अवे फ्रॉम"
    },
    {
      "subtitle_id": 306,
      "start": 636.8,
      "end": 640.16,
      "text": "इट। तो फिलहाल यहीं पर रुकते हैं और आशा"
    },
    {
      "subtitle_id": 307,
      "start": 638.8,
      "end": 642.56,
      "text": "करता हूं कि गोल्ड का पूरा प्राइसिंग"
    },
    {
      "subtitle_id": 308,
      "start": 640.16,
      "end": 644.399,
      "text": "मैकेनिज्म और गोल्ड किस तरह से परफॉर्म कर"
    },
    {
      "subtitle_id": 309,
      "start": 642.56,
      "end": 646.24,
      "text": "रहा है और करेगा इसकी आपको एक बेटर आईडिया"
    },
    {
      "subtitle_id": 310,
      "start": 644.399,
      "end": 647.68,
      "text": "आ चुकी होगी। तो फिलहाल यहीं पर रुकते हैं"
    },
    {
      "subtitle_id": 311,
      "start": 646.24,
      "end": 649.279,
      "text": "मिलते हैं अगले वीडियो में। थैंक यू सो"
    },
    {
      "subtitle_id": 312,
      "start": 647.68,
      "end": 652.079,
      "text": "मच। चैनल को सब्सक्राइब नहीं किया है तो"
    },
    {
      "subtitle_id": 313,
      "start": 649.279,
      "end": 652.079,
      "text": "जरूर सब्सक्राइब कीजिए।"
    }
  ]
}