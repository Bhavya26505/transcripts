  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.16,
      "end": 4.72,
      "text": "यूनाइटेड स्टेट्स दैट हैज नाउ चार्जड"
    },
    {
      "subtitle_id": 2,
      "start": 2.0,
      "end": 7.64,
      "text": "बिलिनियर गौतम अदानी"
    },
    {
      "subtitle_id": 3,
      "start": 4.72,
      "end": 10.2,
      "text": "अडाड़ा अब एक नई मुश्किल में फंसते नजर आ"
    },
    {
      "subtitle_id": 4,
      "start": 7.64,
      "end": 13.32,
      "text": "रहे हैं न्यूयॉर्क की फेडरल कोर्ट ने गौतम"
    },
    {
      "subtitle_id": 5,
      "start": 10.2,
      "end": 15.599,
      "text": "अदानी पर रिश्वत ऑफर करने और धोखाधड़ी"
    },
    {
      "subtitle_id": 6,
      "start": 13.32,
      "end": 18.72,
      "text": "चार्ज फ्रेम किया है ने ग्रुप की कंपनियों"
    },
    {
      "subtitle_id": 7,
      "start": 15.599,
      "end": 18.72,
      "text": "के शेयर में भारी"
    },
    {
      "subtitle_id": 8,
      "start": 19.96,
      "end": 24.84,
      "text": "गिरावट लगता है अधानी ग्रुप के स्टॉक्स पर"
    },
    {
      "subtitle_id": 9,
      "start": 22.64,
      "end": 26.439,
      "text": "शनि भारी है जिसके चलते हर चार पांच महीने"
    },
    {
      "subtitle_id": 10,
      "start": 24.84,
      "end": 28.64,
      "text": "बाद उनके शेयर्स में लोअर सर्किट हमें"
    },
    {
      "subtitle_id": 11,
      "start": 26.439,
      "end": 30.359,
      "text": "देखने मिलते हैं पहले तो हिंडन बक का केस"
    },
    {
      "subtitle_id": 12,
      "start": 28.64,
      "end": 32.119,
      "text": "था जिसमें अदानी ग्रुप की सारी कंपनीज के"
    },
    {
      "subtitle_id": 13,
      "start": 30.359,
      "end": 34.52,
      "text": "इन्वेस्टर्स को तगड़ा लॉस हुआ उसके बाद"
    },
    {
      "subtitle_id": 14,
      "start": 32.119,
      "end": 37.32,
      "text": "हिंडन ब की एक और दूसरी रिपोर्ट आई जिसमें"
    },
    {
      "subtitle_id": 15,
      "start": 34.52,
      "end": 39.2,
      "text": "उन्होंने अदानी ग्रुप और सेबी चीफ पर आरोप"
    },
    {
      "subtitle_id": 16,
      "start": 37.32,
      "end": 40.68,
      "text": "लगाए लेकिन फिर उससे ज्यादा कुछ नुकसान"
    },
    {
      "subtitle_id": 17,
      "start": 39.2,
      "end": 42.48,
      "text": "नहीं हुआ अदानी के शेयर्स को और इसलिए"
    },
    {
      "subtitle_id": 18,
      "start": 40.68,
      "end": 44.48,
      "text": "लगता है कि अब यूएसए की कोर्ट्स ही मैदान"
    },
    {
      "subtitle_id": 19,
      "start": 42.48,
      "end": 45.719,
      "text": "में उतर गई है आज ही सुबह ये न्यूज़ आई है"
    },
    {
      "subtitle_id": 20,
      "start": 44.48,
      "end": 47.92,
      "text": "कि न्यूयॉर्क के डिस्ट्रिक्ट कोर्ट ने"
    },
    {
      "subtitle_id": 21,
      "start": 45.719,
      "end": 50.719,
      "text": "अदानी को 2000 करोड़ ब्राइब केस में दोषी"
    },
    {
      "subtitle_id": 22,
      "start": 47.92,
      "end": 52.92,
      "text": "करार दे दिया है साथ ही एसीसी जो कि वहां"
    },
    {
      "subtitle_id": 23,
      "start": 50.719,
      "end": 54.76,
      "text": "की शेयर मार्केट रेगुलेटर है उन्होंने भी"
    },
    {
      "subtitle_id": 24,
      "start": 52.92,
      "end": 56.92,
      "text": "केस फाइल कर दी है इंटरेस्टिंग बात बता"
    },
    {
      "subtitle_id": 25,
      "start": 54.76,
      "end": 60.0,
      "text": "दूं तो जो पूरा मामला है यह अदानी ग्रीन"
    },
    {
      "subtitle_id": 26,
      "start": 56.92,
      "end": 62.12,
      "text": "से जुड़ा हुआ है लेकिन इसके बावजूद सारे"
    },
    {
      "subtitle_id": 27,
      "start": 60.0,
      "end": 63.719,
      "text": "अदानी ग्रुप के शेयर्स लोअर सर्किट या फिर"
    },
    {
      "subtitle_id": 28,
      "start": 62.12,
      "end": 66.08,
      "text": "बहुत तेजी से गिर रहे हैं अदानी"
    },
    {
      "subtitle_id": 29,
      "start": 63.719,
      "end": 68.28,
      "text": "एंटरप्राइजेस लगभग 18 से 19 पर डाउन है"
    },
    {
      "subtitle_id": 30,
      "start": 66.08,
      "end": 70.64,
      "text": "अदानी पोर्ट्स लगभग 12 पर डाउन है और"
    },
    {
      "subtitle_id": 31,
      "start": 68.28,
      "end": 73.32,
      "text": "रदानी ग्रीन वीडियो शूट करते टाइम लगभग 16"
    },
    {
      "subtitle_id": 32,
      "start": 70.64,
      "end": 76.04,
      "text": "पर से डाउन है तो ग्रुप की जो 11 कंपनीज"
    },
    {
      "subtitle_id": 33,
      "start": 73.32,
      "end": 79.159,
      "text": "है उन सभी की शेयर प्राइस लगभग 15 टू 20"
    },
    {
      "subtitle_id": 34,
      "start": 76.04,
      "end": 81.52,
      "text": "डाउन चल रही है लगभग 2.25 लाख करोड़"
    },
    {
      "subtitle_id": 35,
      "start": 79.159,
      "end": 84.079,
      "text": "इन्वेस्टर्स का पैसा धुआ हो चुका है तो"
    },
    {
      "subtitle_id": 36,
      "start": 81.52,
      "end": 87.04,
      "text": "सबसे बड़ा सवाल है कि ऐसा क्या आरोप है"
    },
    {
      "subtitle_id": 37,
      "start": 84.079,
      "end": 88.84,
      "text": "जिससे इतनी सनसनी फैल गई है साथ ही जो"
    },
    {
      "subtitle_id": 38,
      "start": 87.04,
      "end": 90.36,
      "text": "आरोप है उसकी डेप्थ में हम जाएंगे क्योंकि"
    },
    {
      "subtitle_id": 39,
      "start": 88.84,
      "end": 92.479,
      "text": "बहुत सारे लोग अभी सोच सोच रहे हैं कि"
    },
    {
      "subtitle_id": 40,
      "start": 90.36,
      "end": 94.32,
      "text": "शेयर्स प्राइस डाउन गई है तो शेयर्स होल्ड"
    },
    {
      "subtitle_id": 41,
      "start": 92.479,
      "end": 95.88,
      "text": "करने कि नहीं दूसरी तरफ ऐसे भी लोग है कि"
    },
    {
      "subtitle_id": 42,
      "start": 94.32,
      "end": 98.079,
      "text": "शेयर प्राइस डाउन हो गई तो एंटर करना है"
    },
    {
      "subtitle_id": 43,
      "start": 95.88,
      "end": 100.68,
      "text": "क्या तो मैटर कितना सीरियस है समझना बहुत"
    },
    {
      "subtitle_id": 44,
      "start": 98.079,
      "end": 102.159,
      "text": "जरूरी है और आखिर में अदानी ग्रुप पर क्या"
    },
    {
      "subtitle_id": 45,
      "start": 100.68,
      "end": 103.759,
      "text": "कारवाही हो सकती है नहीं हो सकती उसके"
    },
    {
      "subtitle_id": 46,
      "start": 102.159,
      "end": 105.92,
      "text": "बारे में भी कुछ इंटरेस्टिंग डाटा और"
    },
    {
      "subtitle_id": 47,
      "start": 103.759,
      "end": 108.0,
      "text": "इंफॉर्मेशन हम लेकर आए हैं आप सभी को बता"
    },
    {
      "subtitle_id": 48,
      "start": 105.92,
      "end": 109.88,
      "text": "है कि ये न्यूज़ आज ही आई है तो काफी कुछ"
    },
    {
      "subtitle_id": 49,
      "start": 108.0,
      "end": 111.6,
      "text": "मेहनत इसमें लगी है बिकॉज़ सुबह-सुबह से"
    },
    {
      "subtitle_id": 50,
      "start": 109.88,
      "end": 113.439,
      "text": "ही हमारी जो पूरी रिसर्च टीम है उस पर बैठ"
    },
    {
      "subtitle_id": 51,
      "start": 111.6,
      "end": 116.0,
      "text": "गई और जो रूलिंग डॉक्यूमेंट है वहां के"
    },
    {
      "subtitle_id": 52,
      "start": 113.439,
      "end": 117.96,
      "text": "कोर्ट का वो हमने उठाया सारे पेजेस पन्ने"
    },
    {
      "subtitle_id": 53,
      "start": 116.0,
      "end": 120.2,
      "text": "पन्ने वन बाय वन पढ़े और उसमें से सारी"
    },
    {
      "subtitle_id": 54,
      "start": 117.96,
      "end": 122.439,
      "text": "क्रुशल चीजें आपके सामने अब मैं लेकर आ"
    },
    {
      "subtitle_id": 55,
      "start": 120.2,
      "end": 124.039,
      "text": "रहा हो तो अगर हमारी मेहनत आपको वर्थ लगे"
    },
    {
      "subtitle_id": 56,
      "start": 122.439,
      "end": 125.92,
      "text": "तो इस वीडियो को जरूर लाइक कर देना शेयर"
    },
    {
      "subtitle_id": 57,
      "start": 124.039,
      "end": 127.88,
      "text": "कर देना और चैनल को जरूर सब्सक्राइब कर"
    },
    {
      "subtitle_id": 58,
      "start": 125.92,
      "end": 130.16,
      "text": "देना तो चलिए बिना किसी देरी के एकदम"
    },
    {
      "subtitle_id": 59,
      "start": 127.88,
      "end": 131.68,
      "text": "पॉइंट पर आते हैं नमस्कार मैं प्रसाद आपका"
    },
    {
      "subtitle_id": 60,
      "start": 130.16,
      "end": 133.04,
      "text": "आज के इस वीडियो में स्वागत करता हूं"
    },
    {
      "subtitle_id": 61,
      "start": 131.68,
      "end": 134.44,
      "text": "वीडियो में आगे बढ़ने से पहले आपको बता"
    },
    {
      "subtitle_id": 62,
      "start": 133.04,
      "end": 136.0,
      "text": "दूं कि दिसंबर से हमारी फाइनेंशियल"
    },
    {
      "subtitle_id": 63,
      "start": 134.44,
      "end": 138.12,
      "text": "मॉडलिंग एंड वैल्युएशन मेंटरशिप यानी"
    },
    {
      "subtitle_id": 64,
      "start": 136.0,
      "end": 140.599,
      "text": "एफएमवीए की नेक्स्ट बैच शुरू हो रही है"
    },
    {
      "subtitle_id": 65,
      "start": 138.12,
      "end": 142.239,
      "text": "100% ऑनलाइन और वीकेंड बैच है जिसे कोई भी"
    },
    {
      "subtitle_id": 66,
      "start": 140.599,
      "end": 144.08,
      "text": "अटेंड कर सकता है अगर आपको फाइनेंस की"
    },
    {
      "subtitle_id": 67,
      "start": 142.239,
      "end": 145.879,
      "text": "फील्ड में करियर बनाना है या फिर फाइनेंस"
    },
    {
      "subtitle_id": 68,
      "start": 144.08,
      "end": 148.0,
      "text": "की फील्ड में बहुत इनपथ नॉलेज हासिल करना"
    },
    {
      "subtitle_id": 69,
      "start": 145.879,
      "end": 149.519,
      "text": "है फाइनेंशियल मॉडलिंग का और डीसीएफ यानी"
    },
    {
      "subtitle_id": 70,
      "start": 148.0,
      "end": 151.519,
      "text": "डिस्काउंटेड कैश मेथड से वैल्यूएशन"
    },
    {
      "subtitle_id": 71,
      "start": 149.519,
      "end": 153.599,
      "text": "निकालना तो यहां पर ये सारी चीजें आपको"
    },
    {
      "subtitle_id": 72,
      "start": 151.519,
      "end": 155.16,
      "text": "सीखने मिल जाती है एफएमवीए में एनरोल करने"
    },
    {
      "subtitle_id": 73,
      "start": 153.599,
      "end": 156.72,
      "text": "की लिंक आपको नीचे डिस्क्रिप्शन और कमेंट"
    },
    {
      "subtitle_id": 74,
      "start": 155.16,
      "end": 158.36,
      "text": "बॉक्स में मिल जाएगी यह कोर्स सबके लिए"
    },
    {
      "subtitle_id": 75,
      "start": 156.72,
      "end": 160.159,
      "text": "नहीं है तो जो लोग फॉर्म फिल करने के बाद"
    },
    {
      "subtitle_id": 76,
      "start": 158.36,
      "end": 162.04,
      "text": "सिलेक्ट होंगे उन्हें हमारी टीम कांटेक्ट"
    },
    {
      "subtitle_id": 77,
      "start": 160.159,
      "end": 163.8,
      "text": "कर लेगी तो चलिए बढ़ते हैं वीडियो की तरफ"
    },
    {
      "subtitle_id": 78,
      "start": 162.04,
      "end": 166.28,
      "text": "तो ये जो स्टोरी है इसकी शुरुआत कुछ इस"
    },
    {
      "subtitle_id": 79,
      "start": 163.8,
      "end": 168.4,
      "text": "तरह हुई है कि आपको पता है कि कुछ ही टाइम"
    },
    {
      "subtitle_id": 80,
      "start": 166.28,
      "end": 170.319,
      "text": "पहले अदानी ग्रीन एनर्जी लिमिटेड ने"
    },
    {
      "subtitle_id": 81,
      "start": 168.4,
      "end": 172.44,
      "text": "दुनिया का सबसे बड़ा रिन्यूएबल एनर्जी का"
    },
    {
      "subtitle_id": 82,
      "start": 170.319,
      "end": 175.12,
      "text": "प्रोजेक्ट जीता था जिसकी वैल्यू थी क्लोज"
    },
    {
      "subtitle_id": 83,
      "start": 172.44,
      "end": 177.2,
      "text": "टू 45000 करोड़ यह एक मैन्युफैक्चरिंग"
    },
    {
      "subtitle_id": 84,
      "start": 175.12,
      "end": 178.84,
      "text": "लिंक प्रोजेक्ट था जिसमें अदानी ग्रुप की"
    },
    {
      "subtitle_id": 85,
      "start": 177.2,
      "end": 180.76,
      "text": "कंपनी मैन्युफैक्चरिंग प्लान भी लगाने"
    },
    {
      "subtitle_id": 86,
      "start": 178.84,
      "end": 182.76,
      "text": "वाली थी साथ ही इलेक्ट्रिसिटी भी सप्लाई"
    },
    {
      "subtitle_id": 87,
      "start": 180.76,
      "end": 184.56,
      "text": "करने वाली थी अब यह जो प्रोजेक्ट था यह"
    },
    {
      "subtitle_id": 88,
      "start": 182.76,
      "end": 187.08,
      "text": "काफी लंबा प्रोजेक्ट होने वाला था 20-2"
    },
    {
      "subtitle_id": 89,
      "start": 184.56,
      "end": 190.239,
      "text": "सालों का और एक अनुमान था कि अदानी ग्रुप"
    },
    {
      "subtitle_id": 90,
      "start": 187.08,
      "end": 192.239,
      "text": "को इस प्रोजेक्ट से करीब 16000 करोड़ का"
    },
    {
      "subtitle_id": 91,
      "start": 190.239,
      "end": 194.68,
      "text": "प्रॉफिट होने वाला था जब अदानी ग्रीन की"
    },
    {
      "subtitle_id": 92,
      "start": 192.239,
      "end": 197.159,
      "text": "ये डील हुई तब अदानी ग्रीन 500 करोड़ के"
    },
    {
      "subtitle_id": 93,
      "start": 194.68,
      "end": 198.879,
      "text": "लॉसेस में था तो आप समझ सकते हो कि अदानी"
    },
    {
      "subtitle_id": 94,
      "start": 197.159,
      "end": 200.879,
      "text": "ग्रीन की पॉइंट ऑफ व्यू से ये कितनी बड़ी"
    },
    {
      "subtitle_id": 95,
      "start": 198.879,
      "end": 203.12,
      "text": "डील थी अब यह डील कुछ इस तरह की थी कि"
    },
    {
      "subtitle_id": 96,
      "start": 200.879,
      "end": 205.44,
      "text": "अदानी ग्रीन एनर्जी को सोलर इलेक्ट्रिसिटी"
    },
    {
      "subtitle_id": 97,
      "start": 203.12,
      "end": 207.319,
      "text": "एससीआई यानी सोलर एनर्जी कॉर्पोरेशन ऑफ"
    },
    {
      "subtitle_id": 98,
      "start": 205.44,
      "end": 210.159,
      "text": "इंडिया जो कि गवर्नमेंट कंपनी है उसे"
    },
    {
      "subtitle_id": 99,
      "start": 207.319,
      "end": 212.0,
      "text": "सप्लाई करनी थी अब यह कंपनी मिनिस्ट ऑफ"
    },
    {
      "subtitle_id": 100,
      "start": 210.159,
      "end": 214.599,
      "text": "न्यू एंड रिन्यूएबल एनर्जी के अंडर आती है"
    },
    {
      "subtitle_id": 101,
      "start": 212.0,
      "end": 216.879,
      "text": "और एससीआई एज एन इंटरमीडियरी काम करती है"
    },
    {
      "subtitle_id": 102,
      "start": 214.599,
      "end": 219.48,
      "text": "बिटवीन प्रोड्यूसर एंड कंज्यूमर तो इस केस"
    },
    {
      "subtitle_id": 103,
      "start": 216.879,
      "end": 221.12,
      "text": "में एससीआई अदानी ग्रीन से इलेक्ट्रिसिटी"
    },
    {
      "subtitle_id": 104,
      "start": 219.48,
      "end": 223.4,
      "text": "खरीदने वाली थी और बाद में स्टेट"
    },
    {
      "subtitle_id": 105,
      "start": 221.12,
      "end": 225.28,
      "text": "गवर्नमेंट को उसे बेचने वाली थी सिंपल सा"
    },
    {
      "subtitle_id": 106,
      "start": 223.4,
      "end": 226.84,
      "text": "यह मॉडल था लेकिन जैसे कि आपको बताया कि"
    },
    {
      "subtitle_id": 107,
      "start": 225.28,
      "end": 228.36,
      "text": "स्टेट गवर्नमेंट की जो कंपनीज होती है"
    },
    {
      "subtitle_id": 108,
      "start": 226.84,
      "end": 230.0,
      "text": "जनरली वही लॉसेस में होती है जैसे"
    },
    {
      "subtitle_id": 109,
      "start": 228.36,
      "end": 232.28,
      "text": "एग्जांपल के लिए आप आंध्र की ये न्यूज़"
    },
    {
      "subtitle_id": 110,
      "start": 230.0,
      "end": 235.36,
      "text": "देख सकते हो इनकी स्टेट इलेक्ट्रिसिटी"
    },
    {
      "subtitle_id": 111,
      "start": 232.28,
      "end": 237.4,
      "text": "कंपनीज 1.29 लाख करोड़ के लॉस में है"
    },
    {
      "subtitle_id": 112,
      "start": 235.36,
      "end": 239.0,
      "text": "इमेजिन कीजिए कितना बड़ा लॉस ये नंबर अगर"
    },
    {
      "subtitle_id": 113,
      "start": 237.4,
      "end": 241.079,
      "text": "देखना है तो ये इतना बड़ा नंबर निकल कर"
    },
    {
      "subtitle_id": 114,
      "start": 239.0,
      "end": 243.439,
      "text": "आता है अब एक इलेक्ट्रिसिटी कंपनी इतने"
    },
    {
      "subtitle_id": 115,
      "start": 241.079,
      "end": 245.36,
      "text": "बड़े लॉसेस में कैसी इसका जवाब भी थोड़ी"
    },
    {
      "subtitle_id": 116,
      "start": 243.439,
      "end": 246.799,
      "text": "देर में आपको पता चल ही जाएगा क्योंकि"
    },
    {
      "subtitle_id": 117,
      "start": 245.36,
      "end": 249.0,
      "text": "जैसे ही आपको पता होगा कि जो सोलर"
    },
    {
      "subtitle_id": 118,
      "start": 246.799,
      "end": 250.92,
      "text": "इलेक्ट्रिसिटी है वो कोल इलेक्ट्रिसिटी से"
    },
    {
      "subtitle_id": 119,
      "start": 249.0,
      "end": 252.76,
      "text": "महंगी होती है तो स्टेट गवर्नमेंट की"
    },
    {
      "subtitle_id": 120,
      "start": 250.92,
      "end": 254.799,
      "text": "कंपनी जो ऑलरेडी लॉसेस में है वो महंगी"
    },
    {
      "subtitle_id": 121,
      "start": 252.76,
      "end": 256.88,
      "text": "इलेक्ट्रिसिटी खरीदकर और लॉसेस में जा रही"
    },
    {
      "subtitle_id": 122,
      "start": 254.799,
      "end": 259.0,
      "text": "थी जिसके चलते ये जो पूरी ऑर्डर थी ये"
    },
    {
      "subtitle_id": 123,
      "start": 256.88,
      "end": 261.079,
      "text": "संकट में थी अब ऐसी सिचुएशंस में इंडिया"
    },
    {
      "subtitle_id": 124,
      "start": 259.0,
      "end": 263.84,
      "text": "में क्या होता है अगर ऑर्डर बनाई रखनी है"
    },
    {
      "subtitle_id": 125,
      "start": 261.079,
      "end": 266.6,
      "text": "तो तो वहां पर यूएसए कोर्ट का ये रूलिंग"
    },
    {
      "subtitle_id": 126,
      "start": 263.84,
      "end": 268.88,
      "text": "आया है कि गौतम मदानी उनके नेफ्यू और बाकी"
    },
    {
      "subtitle_id": 127,
      "start": 266.6,
      "end": 271.199,
      "text": "छह लोगों ने मिलकर जो अलग-अलग स्टेट्स के"
    },
    {
      "subtitle_id": 128,
      "start": 268.88,
      "end": 274.12,
      "text": "गवर्नमेंट ऑफिशियल से उन्हें घुस खिलाई अब"
    },
    {
      "subtitle_id": 129,
      "start": 271.199,
      "end": 277.32,
      "text": "खिलाई तो कितने की खिलाई 100 200 करोड़ की"
    },
    {
      "subtitle_id": 130,
      "start": 274.12,
      "end": 279.44,
      "text": "नहीं 2000 करोड़ की घुस खिलाई यह यूएसए के"
    },
    {
      "subtitle_id": 131,
      "start": 277.32,
      "end": 281.36,
      "text": "कोर्ट का कहना है एक जगह तो यह भी मेंशन"
    },
    {
      "subtitle_id": 132,
      "start": 279.44,
      "end": 284.039,
      "text": "है कि कुछ ऑफिशियल को तो अदानी खुद मिले"
    },
    {
      "subtitle_id": 133,
      "start": 281.36,
      "end": 286.24,
      "text": "थे तो इसके बाद क्या हुआ तो यह घुस मिलने"
    },
    {
      "subtitle_id": 134,
      "start": 284.039,
      "end": 288.479,
      "text": "के बाद जो चार पावर डिस्ट्रीब्यूशन कंपनी"
    },
    {
      "subtitle_id": 135,
      "start": 286.24,
      "end": 290.44,
      "text": "अलग-अलग स्टेट्स की इन्होंने अदानी ग्रुप"
    },
    {
      "subtitle_id": 136,
      "start": 288.479,
      "end": 293.0,
      "text": "से महंगी इलेक्ट्रिसिटी खरीदना शुरू किया"
    },
    {
      "subtitle_id": 137,
      "start": 290.44,
      "end": 294.96,
      "text": "वाया एससीआई तो यहां पर एक पॉइंट यह भी है"
    },
    {
      "subtitle_id": 138,
      "start": 293.0,
      "end": 297.24,
      "text": "इस रूलिंग का कोर्ट की रूलिंग है यूएस की"
    },
    {
      "subtitle_id": 139,
      "start": 294.96,
      "end": 299.16,
      "text": "कि जो पावर कंपनीज ऑलरेडी लॉसेस में थी वो"
    },
    {
      "subtitle_id": 140,
      "start": 297.24,
      "end": 301.12,
      "text": "और भी महंगी इलेक्ट्रिसिटी खरीद रही थी"
    },
    {
      "subtitle_id": 141,
      "start": 299.16,
      "end": 303.639,
      "text": "जिसके चलते वो और भी ज्यादा लॉसेस में चली"
    },
    {
      "subtitle_id": 142,
      "start": 301.12,
      "end": 305.44,
      "text": "गई इसमें कंपनी का नुकसान सभी लोगों का"
    },
    {
      "subtitle_id": 143,
      "start": 303.639,
      "end": 307.32,
      "text": "नुकसान इन्वेस्टर्स का नुकसान और कोर्ट"
    },
    {
      "subtitle_id": 144,
      "start": 305.44,
      "end": 310.479,
      "text": "केस रूलिंग में यह तक भी मेंशन है कि"
    },
    {
      "subtitle_id": 145,
      "start": 307.32,
      "end": 312.44,
      "text": "अदानी ग्रुप ने जो पेमेंट की गई बाकी"
    },
    {
      "subtitle_id": 146,
      "start": 310.479,
      "end": 314.32,
      "text": "लोगों को घुस के तौर पे वो इन्होंने शेल"
    },
    {
      "subtitle_id": 147,
      "start": 312.44,
      "end": 316.32,
      "text": "कंपनीज के जरिए यानी शेल कंपनीज मतलब ऐसी"
    },
    {
      "subtitle_id": 148,
      "start": 314.32,
      "end": 318.68,
      "text": "कंपनी जो नाम के लिए बनाई गई है कुछ काम"
    },
    {
      "subtitle_id": 149,
      "start": 316.32,
      "end": 321.199,
      "text": "नहीं करती है उनके जरिए पेमेंट्स की और यह"
    },
    {
      "subtitle_id": 150,
      "start": 318.68,
      "end": 323.24,
      "text": "दिखाया कि कंसल्टिंग फीज के तौर पर वो फीज"
    },
    {
      "subtitle_id": 151,
      "start": 321.199,
      "end": 325.28,
      "text": "उन्हें मिली है सब मिलाकर जो आंध्र प्रदेश"
    },
    {
      "subtitle_id": 152,
      "start": 323.24,
      "end": 328.44,
      "text": "का ऑर्डर है उसे लेने के लिए क्लोज टू"
    },
    {
      "subtitle_id": 153,
      "start": 325.28,
      "end": 330.84,
      "text": "1600 करोड़ की ब्राइब दी गई सेम चीज"
    },
    {
      "subtitle_id": 154,
      "start": 328.44,
      "end": 332.759,
      "text": "छत्तीसगढ़ ड़ तमिलनाडु और जम्मू एंड"
    },
    {
      "subtitle_id": 155,
      "start": 330.84,
      "end": 335.28,
      "text": "कश्मीर की केस में हुई है अब आप सोच रहे"
    },
    {
      "subtitle_id": 156,
      "start": 332.759,
      "end": 337.639,
      "text": "होंगे कि मामला इंडिया का सामने वाली"
    },
    {
      "subtitle_id": 157,
      "start": 335.28,
      "end": 339.52,
      "text": "दोनों कंपनी ऑफिसर सारे इंडिया के तो"
    },
    {
      "subtitle_id": 158,
      "start": 337.639,
      "end": 341.08,
      "text": "यूएसए वहां पर यह केस इन्वेस्टिगेट क्यों"
    },
    {
      "subtitle_id": 159,
      "start": 339.52,
      "end": 343.24,
      "text": "कर रहा है यह तो इंडिया में इन्वेस्टिगेट"
    },
    {
      "subtitle_id": 160,
      "start": 341.08,
      "end": 345.8,
      "text": "होना चाहिए पूरी स्टोरी का और आज की पूरी"
    },
    {
      "subtitle_id": 161,
      "start": 343.24,
      "end": 347.72,
      "text": "रिसर्च का सबसे इंटरेस्टिंग पार्ट यही है"
    },
    {
      "subtitle_id": 162,
      "start": 345.8,
      "end": 350.759,
      "text": "कि तो यूएसए के कोर्ट रूलिंग के अनुसार जो"
    },
    {
      "subtitle_id": 163,
      "start": 347.72,
      "end": 354.199,
      "text": "000 करोड़ की घुस दी गई वो पैसे आए कहां"
    },
    {
      "subtitle_id": 164,
      "start": 350.759,
      "end": 356.56,
      "text": "से कहां से आए गेस कीजिए ये 2000 करोड़"
    },
    {
      "subtitle_id": 165,
      "start": 354.199,
      "end": 358.28,
      "text": "अदानी ग्रुप के पास कहां से आए यह अदानी"
    },
    {
      "subtitle_id": 166,
      "start": 356.56,
      "end": 360.84,
      "text": "ग्रुप पे आरोप है कि इस अमाउंट का एक"
    },
    {
      "subtitle_id": 167,
      "start": 358.28,
      "end": 362.96,
      "text": "पार्ट यूएसए के इन्वेस्ट से आया था थ्रू"
    },
    {
      "subtitle_id": 168,
      "start": 360.84,
      "end": 364.84,
      "text": "बंड्स जिसमें कनाडा का इंस्टीट्यूशनल"
    },
    {
      "subtitle_id": 169,
      "start": 362.96,
      "end": 366.639,
      "text": "इन्वेस्टर का भी नाम आ रहा है और"
    },
    {
      "subtitle_id": 170,
      "start": 364.84,
      "end": 368.639,
      "text": "इंटरेस्टिंग अभी रिसेंटली अदानी ग्रुप ने"
    },
    {
      "subtitle_id": 171,
      "start": 366.639,
      "end": 370.599,
      "text": "00 मिलियन डलर के बॉन्ड्स यूएसए के"
    },
    {
      "subtitle_id": 172,
      "start": 368.639,
      "end": 372.52,
      "text": "इन्वेस्टर से लिए थे अब इस न्यूज़ के बाद"
    },
    {
      "subtitle_id": 173,
      "start": 370.599,
      "end": 374.52,
      "text": "अदानी ग्रुप वो कैंसिल करने वाला है ऐसा"
    },
    {
      "subtitle_id": 174,
      "start": 372.52,
      "end": 376.16,
      "text": "अदानी ग्रुप ने न्यूज़ मीडिया को बताया है"
    },
    {
      "subtitle_id": 175,
      "start": 374.52,
      "end": 377.759,
      "text": "अब हालांकि पूरा केस इंडिया का है तो"
    },
    {
      "subtitle_id": 176,
      "start": 376.16,
      "end": 379.639,
      "text": "इंडिया में इसका इन्वेस्टिगेशन होना चाहिए"
    },
    {
      "subtitle_id": 177,
      "start": 377.759,
      "end": 381.52,
      "text": "था लेकिन पूरा का पूरा यूएस में चल रहा है"
    },
    {
      "subtitle_id": 178,
      "start": 379.639,
      "end": 384.84,
      "text": "अब इसके पीछे जो एक और मेन कारण है वो है"
    },
    {
      "subtitle_id": 179,
      "start": 381.52,
      "end": 386.599,
      "text": "फॉरेन करप्ट प्रैक्टिसेस एक्ट ऑफ 1977 ये"
    },
    {
      "subtitle_id": 180,
      "start": 384.84,
      "end": 388.52,
      "text": "यूएसए का एक एक्ट है और इस एक्ट के"
    },
    {
      "subtitle_id": 181,
      "start": 386.599,
      "end": 390.479,
      "text": "अकॉर्डिंग अगर कोई कंपनी फॉरेन की"
    },
    {
      "subtitle_id": 182,
      "start": 388.52,
      "end": 393.12,
      "text": "गवर्नमेंट को ब्राइब करती है तो उसे भी"
    },
    {
      "subtitle_id": 183,
      "start": 390.479,
      "end": 395.319,
      "text": "यूएसए में सजा हो सकती है ऐसा प्रावधान है"
    },
    {
      "subtitle_id": 184,
      "start": 393.12,
      "end": 397.479,
      "text": "लेकिन चांसेस है कि इस केस से भी अदानी"
    },
    {
      "subtitle_id": 185,
      "start": 395.319,
      "end": 399.199,
      "text": "ग्रुप बच सकता है अब मैं ऐसा क्यों कह रहा"
    },
    {
      "subtitle_id": 186,
      "start": 397.479,
      "end": 400.639,
      "text": "हूं क्योंकि एक सबसे इंटरेस्टिंग चीज यह"
    },
    {
      "subtitle_id": 187,
      "start": 399.199,
      "end": 402.84,
      "text": "है कि डोनाल्ड ट्रंप जो कि रिसेंटली"
    },
    {
      "subtitle_id": 188,
      "start": 400.639,
      "end": 405.0,
      "text": "प्रेसिडेंट बने हैं वो इस पूरे एक्ट को ही"
    },
    {
      "subtitle_id": 189,
      "start": 402.84,
      "end": 408.08,
      "text": "हटाना चाहते हैं उन्होंने लंबे टाइम से"
    },
    {
      "subtitle_id": 190,
      "start": 405.0,
      "end": 410.759,
      "text": "अपने जो प्रमोशन है उसमें भी वादा किया था"
    },
    {
      "subtitle_id": 191,
      "start": 408.08,
      "end": 412.96,
      "text": "लोगों को कि यह जो एक्ट है यह यूएस की"
    },
    {
      "subtitle_id": 192,
      "start": 410.759,
      "end": 415.0,
      "text": "कंपनीज को काफी हर्ट करता है एंड ही इज"
    },
    {
      "subtitle_id": 193,
      "start": 412.96,
      "end": 416.639,
      "text": "प्लानिंग टू रिमूव दिस एक्ट तो आने वाले"
    },
    {
      "subtitle_id": 194,
      "start": 415.0,
      "end": 418.639,
      "text": "टाइम में इसकी और इन्वेस्टिगेशन हो सकती"
    },
    {
      "subtitle_id": 195,
      "start": 416.639,
      "end": 420.24,
      "text": "है यूएस एजेंसीज द्वारा क्योंकि एसीसी ने"
    },
    {
      "subtitle_id": 196,
      "start": 418.639,
      "end": 422.0,
      "text": "भी केस फाइल की है तो काफी कुछ"
    },
    {
      "subtitle_id": 197,
      "start": 420.24,
      "end": 424.36,
      "text": "इंटरेस्टिंग चीजें आने वाले टाइम में भी आ"
    },
    {
      "subtitle_id": 198,
      "start": 422.0,
      "end": 426.24,
      "text": "सकती है लगातार तो अगर यह एक्ट हटा दिया"
    },
    {
      "subtitle_id": 199,
      "start": 424.36,
      "end": 428.52,
      "text": "जाता है तो मामला यहीं पर रफा दफा हो"
    },
    {
      "subtitle_id": 200,
      "start": 426.24,
      "end": 430.28,
      "text": "जाएगा तो यह कहानी का एंड नहीं है क्योंकि"
    },
    {
      "subtitle_id": 201,
      "start": 428.52,
      "end": 432.44,
      "text": "वहां के रेगुलेटर एससीसी ने भी केस हाथ"
    },
    {
      "subtitle_id": 202,
      "start": 430.28,
      "end": 434.72,
      "text": "में लिया है इंडिया में भी शायद मामला"
    },
    {
      "subtitle_id": 203,
      "start": 432.44,
      "end": 436.8,
      "text": "गर्म हो जाएगा तो आने वाले टाइम में काफी"
    },
    {
      "subtitle_id": 204,
      "start": 434.72,
      "end": 438.039,
      "text": "कुछ यहां पर हो सकता है आने वाले टाइम में"
    },
    {
      "subtitle_id": 205,
      "start": 436.8,
      "end": 439.759,
      "text": "हमें वहां के कोर्ट में और क्या"
    },
    {
      "subtitle_id": 206,
      "start": 438.039,
      "end": 441.8,
      "text": "प्रोसीडिंग्स होती है क्या वो फाइनल"
    },
    {
      "subtitle_id": 207,
      "start": 439.759,
      "end": 443.84,
      "text": "रिजल्ट बताते हैं वो भी आने वाले टाइम में"
    },
    {
      "subtitle_id": 208,
      "start": 441.8,
      "end": 445.56,
      "text": "पता चलेगा सो दिस इज जस्ट अ स्टार्ट अब"
    },
    {
      "subtitle_id": 209,
      "start": 443.84,
      "end": 447.919,
      "text": "कंक्लूजन में एक और बड़ी इंटरेस्टिंग चीज"
    },
    {
      "subtitle_id": 210,
      "start": 445.56,
      "end": 449.879,
      "text": "आपको दिखाना चाहता हूं कि 2019 में अदानी"
    },
    {
      "subtitle_id": 211,
      "start": 447.919,
      "end": 451.72,
      "text": "ग्रीन ने पब्लिकली अनाउंस किया कि"
    },
    {
      "subtitle_id": 212,
      "start": 449.879,
      "end": 454.199,
      "text": "उन्होंने कॉरपोरेट सोशल रिस्पांसिबिलिटी"
    },
    {
      "subtitle_id": 213,
      "start": 451.72,
      "end": 456.24,
      "text": "कमेटी इंप्लीमेंट की है शुरू की है और"
    },
    {
      "subtitle_id": 214,
      "start": 454.199,
      "end": 458.16,
      "text": "इसमें उन्होंने कहा था कि हम कभी भी किसी"
    },
    {
      "subtitle_id": 215,
      "start": 456.24,
      "end": 460.8,
      "text": "को ब्राइब नहीं देंगे एथिक्स के साथ अपना"
    },
    {
      "subtitle_id": 216,
      "start": 458.16,
      "end": 463.039,
      "text": "बिजनेस करेंगे लेकिन अभी जो निकल कर आ रही"
    },
    {
      "subtitle_id": 217,
      "start": 460.8,
      "end": 464.759,
      "text": "है वो चीजें काफी विपरीत है अब एक कितना"
    },
    {
      "subtitle_id": 218,
      "start": 463.039,
      "end": 467.039,
      "text": "अजीब है कि एक बिलिनियर है जो इंडिया में"
    },
    {
      "subtitle_id": 219,
      "start": 464.759,
      "end": 469.759,
      "text": "रहता है उनका खुद का बिजनेस इंडिया में"
    },
    {
      "subtitle_id": 220,
      "start": 467.039,
      "end": 471.4,
      "text": "चलता है वो जिन कंपनीज के साथ या सरकारी"
    },
    {
      "subtitle_id": 221,
      "start": 469.759,
      "end": 473.919,
      "text": "कंपनी के साथ काम करते हैं वो भी इंडियन"
    },
    {
      "subtitle_id": 222,
      "start": 471.4,
      "end": 476.28,
      "text": "कंपनीज हैं स्टेट ओन कंपनीज इंडिया की"
    },
    {
      "subtitle_id": 223,
      "start": 473.919,
      "end": 479.08,
      "text": "लेकिन उन पर जो केस चलती है वो इंडिया में"
    },
    {
      "subtitle_id": 224,
      "start": 476.28,
      "end": 482.0,
      "text": "नहीं चलती है वो चलती है यूएसए में वेरी"
    },
    {
      "subtitle_id": 225,
      "start": 479.08,
      "end": 483.639,
      "text": "शॉकिंग सो आई होप पूरा मामला आपको फटाक से"
    },
    {
      "subtitle_id": 226,
      "start": 482.0,
      "end": 485.159,
      "text": "क्लियर हो गया होगा एकदम ए टू जेड अभी"
    },
    {
      "subtitle_id": 227,
      "start": 483.639,
      "end": 487.28,
      "text": "आपको कुछ देखने की पढ़ने की इसमें जरूरत"
    },
    {
      "subtitle_id": 228,
      "start": 485.159,
      "end": 489.24,
      "text": "नहीं है बट आने वाला अगर कुछ अपडेट आता है"
    },
    {
      "subtitle_id": 229,
      "start": 487.28,
      "end": 490.84,
      "text": "तो उससे आपको अवेयर रहना पड़ेगा अब यहां"
    },
    {
      "subtitle_id": 230,
      "start": 489.24,
      "end": 492.199,
      "text": "पर काफी सारे लोग आएंगे काफी सारे वीडियोस"
    },
    {
      "subtitle_id": 231,
      "start": 490.84,
      "end": 493.96,
      "text": "आएंगे जहां पर लोग अपने-अपने ओपिनियन"
    },
    {
      "subtitle_id": 232,
      "start": 492.199,
      "end": 496.0,
      "text": "देंगे लेकिन मेरा काम था कि आपके सामने"
    },
    {
      "subtitle_id": 233,
      "start": 493.96,
      "end": 498.28,
      "text": "फैक्ट्स रखना विद प्रॉपर डॉक्यूमेंट एंड"
    },
    {
      "subtitle_id": 234,
      "start": 496.0,
      "end": 500.319,
      "text": "डिटेल ये सारे उनके डॉक्यूमेंट पढ़ने में"
    },
    {
      "subtitle_id": 235,
      "start": 498.28,
      "end": 502.52,
      "text": "काफी टाइम लगा हमें वो उठा के हमने आपको"
    },
    {
      "subtitle_id": 236,
      "start": 500.319,
      "end": 504.56,
      "text": "हाईलाइट करके दिखाए हैं कि क्या कुछ चीजें"
    },
    {
      "subtitle_id": 237,
      "start": 502.52,
      "end": 507.0,
      "text": "हैं आप सोचना जो भी ओपिनियन वो आपको बनाना"
    },
    {
      "subtitle_id": 238,
      "start": 504.56,
      "end": 508.84,
      "text": "है मेरा काम है आपको डेटा और फैक्ट्स"
    },
    {
      "subtitle_id": 239,
      "start": 507.0,
      "end": 510.84,
      "text": "बताना और रिसर्च बताना सो मिलते हैं अगले"
    },
    {
      "subtitle_id": 240,
      "start": 508.84,
      "end": 512.839,
      "text": "वीडियो में थैंक यू सो मच फॉर वाचिंग दिस"
    },
    {
      "subtitle_id": 241,
      "start": 510.84,
      "end": 514.36,
      "text": "और चैनल को जरूर सब्सक्राइब कीजिए अगर इसी"
    },
    {
      "subtitle_id": 242,
      "start": 512.839,
      "end": 516.76,
      "text": "तरह का क्वालिटी कंटेंट आपको चाहिए तो"
    },
    {
      "subtitle_id": 243,
      "start": 514.36,
      "end": 522.039,
      "text": "विदाउट एनी ओपिनियन जस्ट फैक्ट्स फिगर्स"
    },
    {
      "subtitle_id": 244,
      "start": 516.76,
      "end": 522.039,
      "text": "एंड प्योर रिसर्च सी यू सून"
    }
  ]
}