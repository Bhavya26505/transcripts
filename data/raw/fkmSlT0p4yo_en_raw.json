      "text": "में प्रॉब्लम है प्रॉब्लम अंदर है तो बेटर"
    },
    {
      "subtitle_id": 191,
      "start": 429.24,
      "end": 434.28,
      "text": "यू सॉल्व इट फर्स्ट एंड देन आप जो भी आपको"
    },
    {
      "subtitle_id": 192,
      "start": 431.879,
      "end": 435.919,
      "text": "करना है दिखाना है दैट यू कैन डू स इतना"
    },
    {
      "subtitle_id": 193,
      "start": 434.28,
      "end": 437.52,
      "text": "ही हम सिंपली कह सकते हैं सो एक"
    },
    {
      "subtitle_id": 194,
      "start": 435.919,
      "end": 440.199,
      "text": "इंपोर्टेंट लेसन सारे इन्वेस्टर्स के लिए"
    },
    {
      "subtitle_id": 195,
      "start": 437.52,
      "end": 442.039,
      "text": "ये है कि स्टे अवे फ्रॉम कंपनीज जहां पर"
    },
    {
      "subtitle_id": 196,
      "start": 440.199,
      "end": 443.879,
      "text": "मैनेजमेंट इस तरह की सिल्ली चीजों में"
    },
    {
      "subtitle_id": 197,
      "start": 442.039,
      "end": 445.759,
      "text": "इंवॉल्व होता है यू नो ये चीजें लोगों को"
    },
    {
      "subtitle_id": 198,
      "start": 443.879,
      "end": 447.479,
      "text": "पहले से पता चलते है लेकिन हमने लास्ट"
    },
    {
      "subtitle_id": 199,
      "start": 445.759,
      "end": 449.039,
      "text": "दो-तीन साल पहले जो एक वीडियो बनाया था"
    },
    {
      "subtitle_id": 200,
      "start": 447.479,
      "end": 451.08,
      "text": "उसके लिए हमने कई सारे एंप्लॉय से बात की"
    },
    {
      "subtitle_id": 201,
      "start": 449.039,
      "end": 453.28,
      "text": "वोला आ के कि क्यों लोग छोड़ के जा रहे"
    },
    {
      "subtitle_id": 202,
      "start": 451.08,
      "end": 455.879,
      "text": "हैं एंड देन जो रिप्लाई थे आई कांट से दैट"
    },
    {
      "subtitle_id": 203,
      "start": 453.28,
      "end": 457.479,
      "text": "हियर बट काफी ज्यादा शॉकिंग थे मेरे लिए"
    },
    {
      "subtitle_id": 204,
      "start": 455.879,
      "end": 459.44,
      "text": "तो कंपनी के एंप्लॉयज भी वहां पर नहीं टिक"
    },
    {
      "subtitle_id": 205,
      "start": 457.479,
      "end": 461.599,
      "text": "पा रहे और कुछ इसी तरह का जिस तरह का अभी"
    },
    {
      "subtitle_id": 206,
      "start": 459.44,
      "end": 463.8,
      "text": "लोगों का रिस्पांस है उस गाड़ी के प्रति"
    },
    {
      "subtitle_id": 207,
      "start": 461.599,
      "end": 465.639,
      "text": "एंप्लॉयज का भी था और ये प्रॉब्लम अभी"
    },
    {
      "subtitle_id": 208,
      "start": 463.8,
      "end": 467.639,
      "text": "धीरे-धीरे बढ़ती जा रही है अब जो भी"
    },
    {
      "subtitle_id": 209,
      "start": 465.639,
      "end": 469.68,
      "text": "बड़ी-बड़ी कंपनीज ले लीजिए आप मुकेश"
    },
    {
      "subtitle_id": 210,
      "start": 467.639,
      "end": 471.319,
      "text": "अंबानी की कंपनीज ले लीजिए जो टॉप 10"
    },
    {
      "subtitle_id": 211,
      "start": 469.68,
      "end": 473.159,
      "text": "रिचेस्ट पर्सन में राधा कृष्ण दमानी आते"
    },
    {
      "subtitle_id": 212,
      "start": 471.319,
      "end": 474.84,
      "text": "हैं उनके कोई इंटरव्यू नहीं मिलेगा किसी"
    },
    {
      "subtitle_id": 213,
      "start": 473.159,
      "end": 476.159,
      "text": "सोशल मीडिया पे लोग एक्टिव नहीं रहते दे"
    },
    {
      "subtitle_id": 214,
      "start": 474.84,
      "end": 477.84,
      "text": "स्टे अवे फ्रॉम दे जस्ट फोकस ऑन द"
    },
    {
      "subtitle_id": 215,
      "start": 476.159,
      "end": 479.52,
      "text": "प्रोडक्ट कि चलो हमें सही प्रोडक्ट बनाना"
    },
    {
      "subtitle_id": 216,
      "start": 477.84,
      "end": 481.44,
      "text": "है सही धंधा बनाना है दैट इट दैट इज व्हाट"
    },
    {
      "subtitle_id": 217,
      "start": 479.52,
      "end": 482.68,
      "text": "व वी नीड टू डू एंड जो शेयर होल्डर्स है"
    },
    {
      "subtitle_id": 218,
      "start": 481.44,
      "end": 484.36,
      "text": "उनके लिए ज्यादा से ज्यादा वैल्यू हम कैसे"
    },
    {
      "subtitle_id": 219,
      "start": 482.68,
      "end": 485.72,
      "text": "क्रिएट कर सकते हैं लेकिन अगर इस तरह की"
    },
    {
      "subtitle_id": 220,
      "start": 484.36,
      "end": 487.759,
      "text": "चीजों में इवॉल्व करते हो तो कभी-कभी"
    },
    {
      "subtitle_id": 221,
      "start": 485.72,
      "end": 490.24,
      "text": "चीजें आपके फेवर में चली जाती है लेकिन"
    },
    {
      "subtitle_id": 222,
      "start": 487.759,
      "end": 492.52,
      "text": "कभी-कभी जब बैकफायर करती है तो बहुत गंदे"
    },
    {
      "subtitle_id": 223,
      "start": 490.24,
      "end": 493.84,
      "text": "तरीके से प्रॉब्लम हो जाती है अब बहुत"
    },
    {
      "subtitle_id": 224,
      "start": 492.52,
      "end": 495.479,
      "text": "सारे लोगों को क्या लग रहा है कि दिस इज अ"
    },
    {
      "subtitle_id": 225,
      "start": 493.84,
      "end": 497.159,
      "text": "टेंपररी प्रॉब्लम लेकिन ऐसा नहीं है"
    },
    {
      "subtitle_id": 226,
      "start": 495.479,
      "end": 499.08,
      "text": "इन्होंने बहुत बड़ी गिगा फैक्ट्री य बना"
    },
    {
      "subtitle_id": 227,
      "start": 497.159,
      "end": 500.159,
      "text": "रहे हैं जिसके लिए काफी सारे इन्वेस्टमेंट"
    },
    {
      "subtitle_id": 228,
      "start": 499.08,
      "end": 501.599,
      "text": "यहां पर डाल रहे हैं बैटरी में"
    },
    {
      "subtitle_id": 229,
      "start": 500.159,
      "end": 504.08,
      "text": "इन्वेस्टमेंट कर रहे हैं लेकिन अगर हम"
    },
    {
      "subtitle_id": 230,
      "start": 501.599,
      "end": 506.0,
      "text": "कस्टमर ही उनसे दूर भागते रहेंगे तो जो"
    },
    {
      "subtitle_id": 231,
      "start": 504.08,
      "end": 507.72,
      "text": "कैपिटल एक्सपेंडिचर है कैपेक्स है बहुत"
    },
    {
      "subtitle_id": 232,
      "start": 506.0,
      "end": 510.0,
      "text": "सारे इन्वेस्टमेंट बिजनेस में है उस पर"
    },
    {
      "subtitle_id": 233,
      "start": 507.72,
      "end": 512.279,
      "text": "आरओ आई नहीं निकल पाएगा और ये कंपनी के"
    },
    {
      "subtitle_id": 234,
      "start": 510.0,
      "end": 514.2,
      "text": "लिए लॉन्ग टर्म प्रॉब्लम बनती चली जाएगी स"
    },
    {
      "subtitle_id": 235,
      "start": 512.279,
      "end": 516.08,
      "text": "ये जो इंस्टेंस हुआ है इसका बहुत बड़ा"
    },
    {
      "subtitle_id": 236,
      "start": 514.2,
      "end": 518.12,
      "text": "इंपैक्ट कंपनी के लॉन्ग टर्म फाइनेंशियल्स"
    },
    {
      "subtitle_id": 237,
      "start": 516.08,
      "end": 519.919,
      "text": "पर होने वाला है इतना तो पक्का है क्योंकि"
    },
    {
      "subtitle_id": 238,
      "start": 518.12,
      "end": 523.719,
      "text": "लोग के दिमाग में चीजें धीरे-धीरे बैठने"
    },
    {
      "subtitle_id": 239,
      "start": 519.919,
      "end": 525.08,
      "text": "लगी है कि ओके ओ में प्रॉब्लम है अच्छा ला"
    },
    {
      "subtitle_id": 240,
      "start": 523.719,
      "end": 527.399,
      "text": "के बारे में कंप्लेंट्स आती है अच्छा इतनी"
    },
    {
      "subtitle_id": 241,
      "start": 525.08,
      "end": 528.839,
      "text": "इतनी गाड़ियां है अब लोग तो ऐसे हैं कि"
    },
    {
      "subtitle_id": 242,
      "start": 527.399,
      "end": 530.6,
      "text": "लोग पुरानी क्लिप्स अब निकाल रहे हैं कि"
    },
    {
      "subtitle_id": 243,
      "start": 528.839,
      "end": 533.0,
      "text": "भावी श अगरवाल को और डिफेंड कैसे किया जा"
    },
    {
      "subtitle_id": 244,
      "start": 530.6,
      "end": 535.08,
      "text": "सकता है लोग अभी लगे पड़े एकदम कि चलो"
    },
    {
      "subtitle_id": 245,
      "start": 533.0,
      "end": 537.04,
      "text": "टॉपिक हॉट है और डिफेम करते हैं तो किसी"
    },
    {
      "subtitle_id": 246,
      "start": 535.08,
      "end": 538.88,
      "text": "ने दो-तीन साल पहले की क्लिप निकाली वेयर"
    },
    {
      "subtitle_id": 247,
      "start": 537.04,
      "end": 540.56,
      "text": "भावी श अगरवाल से कि सैटरडे संडे वाला"
    },
    {
      "subtitle_id": 248,
      "start": 538.88,
      "end": 542.76,
      "text": "कल्चर हमारा हमारा नहीं है वेस्टर्न"
    },
    {
      "subtitle_id": 249,
      "start": 540.56,
      "end": 544.6,
      "text": "कंट्रीज से हमने इंपोर्ट किया है हमें वो"
    },
    {
      "subtitle_id": 250,
      "start": 542.76,
      "end": 546.0,
      "text": "फॉलो नहीं करना चाहिए वगैरह वगैरह एंड देन"
    },
    {
      "subtitle_id": 251,
      "start": 544.6,
      "end": 548.519,
      "text": "पीपल अगेन क्रिटिसाइजिंग कमेंट्स में"
    },
    {
      "subtitle_id": 252,
      "start": 546.0,
      "end": 550.0,
      "text": "वगैरह वगैरह ठीक है हमारा वो कोई उद्देश्य"
    },
    {
      "subtitle_id": 253,
      "start": 548.519,
      "end": 551.56,
      "text": "नहीं रहता कि किसी को डिफेम करना है वगैरह"
    },
    {
      "subtitle_id": 254,
      "start": 550.0,
      "end": 553.76,
      "text": "जो रियलिटी है वो आपके सामने हमने डाटा की"
    },
    {
      "subtitle_id": 255,
      "start": 551.56,
      "end": 555.68,
      "text": "मदद से रख दी बट आईडियली ऐसा होना चाहिए"
    },
    {
      "subtitle_id": 256,
      "start": 553.76,
      "end": 557.64,
      "text": "कि किसी भी सीओ को मतलब बीट भाविश अगर बीट"
    },
    {
      "subtitle_id": 257,
      "start": 555.68,
      "end": 559.72,
      "text": "एनी वन आपको इस तरह की चीजों में इवॉल्व"
    },
    {
      "subtitle_id": 258,
      "start": 557.64,
      "end": 561.36,
      "text": "नहीं होना चाहिए मतलब सही तरीके से कस्टमर"
    },
    {
      "subtitle_id": 259,
      "start": 559.72,
      "end": 563.399,
      "text": "को हैंडल करना लोगों के फ्रस्ट्रेशन को"
    },
    {
      "subtitle_id": 260,
      "start": 561.36,
      "end": 564.92,
      "text": "हैंडल करना इ आल्सो स्किल जो ऑफकोर्स कई"
    },
    {
      "subtitle_id": 261,
      "start": 563.399,
      "end": 567.44,
      "text": "सारी कंपनीज बहुत अच्छे तरीके से मैनेज"
    },
    {
      "subtitle_id": 262,
      "start": 564.92,
      "end": 569.399,
      "text": "करती है उन पर आपको फोकस करना चाहिए और जो"
    },
    {
      "subtitle_id": 263,
      "start": 567.44,
      "end": 571.079,
      "text": "नहीं अच्छे से मैनेज करती है उनसे आपको"
    },
    {
      "subtitle_id": 264,
      "start": 569.399,
      "end": 572.519,
      "text": "कहीं ना कहीं दूर रहना चाहिए सो"
    },
    {
      "subtitle_id": 265,
      "start": 571.079,
      "end": 574.399,
      "text": "इन्वेस्टर्स के लिए बस यही एक मैसेज"
    },
    {
      "subtitle_id": 266,
      "start": 572.519,
      "end": 575.68,
      "text": "इंपोर्टेंट जो यहां पर निकल कर आया है वो"
    },
    {
      "subtitle_id": 267,
      "start": 574.399,
      "end": 577.36,
      "text": "मैं देना चाहूंगा और ये शॉर्ट टर्म"
    },
    {
      "subtitle_id": 268,
      "start": 575.68,
      "end": 579.04,
      "text": "इंपैक्ट नहीं है जो 9 पर ग दैट इज अ शॉर्ट"
    },
    {
      "subtitle_id": 269,
      "start": 577.36,
      "end": 580.68,
      "text": "टर्म इंपैक्ट और लॉन्ग टर्म इंपैक्ट भी"
    },
    {
      "subtitle_id": 270,
      "start": 579.04,
      "end": 582.839,
      "text": "बहुत बड़ा होने वाला है कंपनी के बिजनेस"
    },
    {
      "subtitle_id": 271,
      "start": 580.68,
      "end": 584.72,
      "text": "पर और ये चीज मैंने ओ के आईपीओ के टाइम भी"
    },
    {
      "subtitle_id": 272,
      "start": 582.839,
      "end": 586.72,
      "text": "बोली थी उस वीडियो को आप यहां क्लिक करके"
    },
    {
      "subtitle_id": 273,
      "start": 584.72,
      "end": 588.8,
      "text": "देख सकते हो जिसमें हमने बहुत सारे ला के"
    },
    {
      "subtitle_id": 274,
      "start": 586.72,
      "end": 590.24,
      "text": "बारे में अलग-अलग इश्यूज को रेज किया था"
    },
    {
      "subtitle_id": 275,
      "start": 588.8,
      "end": 592.519,
      "text": "तो मिलते हैं अगले वीडियो में थैंक यू सो"
    },
    {
      "subtitle_id": 276,
      "start": 590.24,
      "end": 594.12,
      "text": "मच फॉर वाचिंग दिस एंड हमारे एफएमवीए को"
    },
    {
      "subtitle_id": 277,
      "start": 592.519,
      "end": 595.64,
      "text": "जाते-जाते जरूर चेक आउट कीजिए लिंक नीचे"
    },
    {
      "subtitle_id": 278,
      "start": 594.12,
      "end": 598.16,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में दी गई है"
    },
    {
      "subtitle_id": 279,
      "start": 595.64,
      "end": 598.16,
      "text": "सी यू"
    }
  ]
}