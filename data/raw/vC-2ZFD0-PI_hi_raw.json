  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.08,
      "end": 4.48,
      "text": "अभी तो सिर्फ एक ही साल हुआ था सर रतन"
    },
    {
      "subtitle_id": 2,
      "start": 2.0,
      "end": 6.56,
      "text": "टाटा को गए हुए और ट्रबल ऑलरेडी टाटा"
    },
    {
      "subtitle_id": 3,
      "start": 4.48,
      "end": 8.48,
      "text": "ग्रुप में शुरू हो चुकी है। वेरियस न्यूज़"
    },
    {
      "subtitle_id": 4,
      "start": 6.56,
      "end": 10.639,
      "text": "सोर्सेस की मानें तो टाटा ट्रस्ट के अंडर"
    },
    {
      "subtitle_id": 5,
      "start": 8.48,
      "end": 13.2,
      "text": "काफी सारे ग्रुप बन गए हैं और वो ग्रुप"
    },
    {
      "subtitle_id": 6,
      "start": 10.639,
      "end": 15.44,
      "text": "आपस में बहस कर रहे हैं फॉर पावर एंड"
    },
    {
      "subtitle_id": 7,
      "start": 13.2,
      "end": 16.96,
      "text": "इनफ्लुएंस। झगड़ा यहां तक बढ़ गया है कि"
    },
    {
      "subtitle_id": 8,
      "start": 15.44,
      "end": 18.56,
      "text": "गवर्नमेंट को भी रिसेंटली उसमें इन्वॉल्व"
    },
    {
      "subtitle_id": 9,
      "start": 16.96,
      "end": 20.64,
      "text": "होना पड़ा क्योंकि Tata ग्रुप का अगर आप"
    },
    {
      "subtitle_id": 10,
      "start": 18.56,
      "end": 23.68,
      "text": "ओवरऑल मार्केट कैप निकालो तो वह निकल कर"
    },
    {
      "subtitle_id": 11,
      "start": 20.64,
      "end": 25.84,
      "text": "आता है 38 लाख करोड़ और Tata ग्रुप डजंस"
    },
    {
      "subtitle_id": 12,
      "start": 23.68,
      "end": 27.84,
      "text": "ऑफ बिनेसेस में है नमक से लेके ऑटोमोबाइल"
    },
    {
      "subtitle_id": 13,
      "start": 25.84,
      "end": 30.0,
      "text": "पावर इलेक्ट्रॉनिक्स एयररोस्पेस और ये"
    },
    {
      "subtitle_id": 14,
      "start": 27.84,
      "end": 32.079,
      "text": "सारे बिनेसेस आते हैं Tata ट्रस्ट के अंडर"
    },
    {
      "subtitle_id": 15,
      "start": 30.0,
      "end": 34.079,
      "text": "और ट्रस्ट को चलाते हैं ट्रस्टी और जो"
    },
    {
      "subtitle_id": 16,
      "start": 32.079,
      "end": 35.84,
      "text": "करंट प्रॉब्लम चल रही है इन ट्रस्टीज के"
    },
    {
      "subtitle_id": 17,
      "start": 34.079,
      "end": 38.239,
      "text": "बीच में ही चल रही है तो क्या है यह"
    },
    {
      "subtitle_id": 18,
      "start": 35.84,
      "end": 40.079,
      "text": "प्रॉब्लम कौन है यह ट्रस्टीज और किस बात"
    },
    {
      "subtitle_id": 19,
      "start": 38.239,
      "end": 42.0,
      "text": "को लेकर चल रहा है यह झगड़ा और क्या इन"
    },
    {
      "subtitle_id": 20,
      "start": 40.079,
      "end": 44.079,
      "text": "झगड़ों का असर टाटा ग्रुप की कंपनीज के जो"
    },
    {
      "subtitle_id": 21,
      "start": 42.0,
      "end": 46.0,
      "text": "शेयर होल्डर्स हैं उन पर पड़ेगा इन सारे"
    },
    {
      "subtitle_id": 22,
      "start": 44.079,
      "end": 47.52,
      "text": "सवालों के जवाब आज के इस वीडियो में आपको"
    },
    {
      "subtitle_id": 23,
      "start": 46.0,
      "end": 49.12,
      "text": "डिटेल में मिल जाएंगे। नमस्कार, मैं"
    },
    {
      "subtitle_id": 24,
      "start": 47.52,
      "end": 50.64,
      "text": "प्रसाद आपका आज के इस वीडियो में स्वागत"
    },
    {
      "subtitle_id": 25,
      "start": 49.12,
      "end": 52.16,
      "text": "करता हूं। वीडियो शुरू करने से पहले मेक"
    },
    {
      "subtitle_id": 26,
      "start": 50.64,
      "end": 53.84,
      "text": "श्योर करना आपने चैनल को सब्सक्राइब किया"
    },
    {
      "subtitle_id": 27,
      "start": 52.16,
      "end": 55.52,
      "text": "हो। साथ ही आप हमारा जॉइ बटन भी अब"
    },
    {
      "subtitle_id": 28,
      "start": 53.84,
      "end": 57.199,
      "text": "एक्सप्लोर कर सकते हो। जहां पर हमने बनाई"
    },
    {
      "subtitle_id": 29,
      "start": 55.52,
      "end": 58.8,
      "text": "है अपनी एक प्रीमियम कम्युनिटी। देखिए"
    },
    {
      "subtitle_id": 30,
      "start": 57.199,
      "end": 61.039,
      "text": "Tata ग्रुप का जो बिज़नेस है वह बहुत"
    },
    {
      "subtitle_id": 31,
      "start": 58.8,
      "end": 62.8,
      "text": "पुराना है इस देश में। 150 साल से चलता आ"
    },
    {
      "subtitle_id": 32,
      "start": 61.039,
      "end": 65.6,
      "text": "रहा यह बिज़नेस एंपायर है जिसका फाउंडेशन"
    },
    {
      "subtitle_id": 33,
      "start": 62.8,
      "end": 67.36,
      "text": "जमशेद जी Tata ने 1968 में रखा था। और एज"
    },
    {
      "subtitle_id": 34,
      "start": 65.6,
      "end": 69.2,
      "text": "आई सेड Tata ग्रुप कंपनीज़ कम अंडर"
    },
    {
      "subtitle_id": 35,
      "start": 67.36,
      "end": 71.52,
      "text": "चैरिटेबल ट्रस्ट। अब ट्रस्ट का ऐसा होता"
    },
    {
      "subtitle_id": 36,
      "start": 69.2,
      "end": 72.96,
      "text": "है कि नोबडी ओन्स द ट्रस्ट। यस, ट्रस्ट को"
    },
    {
      "subtitle_id": 37,
      "start": 71.52,
      "end": 74.64,
      "text": "कोई भी ओन नहीं कर सकता क्योंकि यह"
    },
    {
      "subtitle_id": 38,
      "start": 72.96,
      "end": 76.4,
      "text": "प्राइवेट कंपनीज़ की तरह नहीं होती है। तो"
    },
    {
      "subtitle_id": 39,
      "start": 74.64,
      "end": 78.4,
      "text": "अगर ट्रस्ट को कोई ओन नहीं करता तो यह"
    },
    {
      "subtitle_id": 40,
      "start": 76.4,
      "end": 80.479,
      "text": "ट्रस्ट एग्जैक्टली चलती कैसे है? सवाल तो"
    },
    {
      "subtitle_id": 41,
      "start": 78.4,
      "end": 82.72,
      "text": "आएगा। तो ट्रस्ट को चलाते हैं ट्रस्टीज"
    },
    {
      "subtitle_id": 42,
      "start": 80.479,
      "end": 84.479,
      "text": "जिनका काम है ट्रस्ट को सही ढंग से चलाना।"
    },
    {
      "subtitle_id": 43,
      "start": 82.72,
      "end": 86.4,
      "text": "दैट्स इट। तो ये पूरा मामला समझने के लिए"
    },
    {
      "subtitle_id": 44,
      "start": 84.479,
      "end": 88.159,
      "text": "हमें यह समझना पड़ेगा कि ये Tata S क्या"
    },
    {
      "subtitle_id": 45,
      "start": 86.4,
      "end": 90.08,
      "text": "है और Tata ट्रस्ट क्या है? अब देखिए"
    },
    {
      "subtitle_id": 46,
      "start": 88.159,
      "end": 92.479,
      "text": "स्ट्रक्चर कुछ ऐसा है कि Tata ग्रुप की कई"
    },
    {
      "subtitle_id": 47,
      "start": 90.08,
      "end": 94.88,
      "text": "सारी कंपनीज़ हैं। उनकी ओनरशिप मेजॉरिटी"
    },
    {
      "subtitle_id": 48,
      "start": 92.479,
      "end": 97.759,
      "text": "ओनरशिप Tata SS के पास है। और Tata SS का"
    },
    {
      "subtitle_id": 49,
      "start": 94.88,
      "end": 99.6,
      "text": "66% Tata T के पास है। यानी सबसे ऊपर कौन"
    },
    {
      "subtitle_id": 50,
      "start": 97.759,
      "end": 101.52,
      "text": "है? Tata ट्रस्ट तो सही मायनों में देखें"
    },
    {
      "subtitle_id": 51,
      "start": 99.6,
      "end": 103.439,
      "text": "तो Tata SS असली होल्डिंग कंपनी है जो"
    },
    {
      "subtitle_id": 52,
      "start": 101.52,
      "end": 106.0,
      "text": "Tata ग्रुप के बिनेसेस को कंट्रोल करती"
    },
    {
      "subtitle_id": 53,
      "start": 103.439,
      "end": 108.64,
      "text": "है। जैसे कि Tata Steel, Tata Motors, TCS"
    },
    {
      "subtitle_id": 54,
      "start": 106.0,
      "end": 111.119,
      "text": "और भी सारी Tata ग्रुप की कंपनीज़। बट Tata"
    },
    {
      "subtitle_id": 55,
      "start": 108.64,
      "end": 113.2,
      "text": "ट्रस्ट से ही Tata SS के बोर्ड को नॉमिनेट"
    },
    {
      "subtitle_id": 56,
      "start": 111.119,
      "end": 115.119,
      "text": "करती है। अब इन Tata ट्रस्ट में भी कई"
    },
    {
      "subtitle_id": 57,
      "start": 113.2,
      "end": 117.28,
      "text": "सारे ट्रस्ट्स हैं। उसमें दो बड़े ट्रस्ट्स"
    },
    {
      "subtitle_id": 58,
      "start": 115.119,
      "end": 119.52,
      "text": "हैं। तो पहला है सर दोराब जी Tata ट्रस्ट"
    },
    {
      "subtitle_id": 59,
      "start": 117.28,
      "end": 121.36,
      "text": "और सेकंड है सर रतन टाटा ट्रस्ट। अब जैसे"
    },
    {
      "subtitle_id": 60,
      "start": 119.52,
      "end": 124.719,
      "text": "कि मैंने बोला कि दिस ट्रस्ट आर नॉट ओन"
    },
    {
      "subtitle_id": 61,
      "start": 121.36,
      "end": 126.56,
      "text": "बाय एनीवन बट रन बाय ट्रस्टीज। आप स्क्रीन"
    },
    {
      "subtitle_id": 62,
      "start": 124.719,
      "end": 129.039,
      "text": "पर देख सकते हो कि सर दराज जी टाटा ट्रस्ट"
    },
    {
      "subtitle_id": 63,
      "start": 126.56,
      "end": 132.959,
      "text": "के जो ट्रस्टीज हैं वो है नोएल टाटा वेनू"
    },
    {
      "subtitle_id": 64,
      "start": 129.039,
      "end": 137.2,
      "text": "श्रीनिवासन विजय सिंह और मेहली मिस्त्री"
    },
    {
      "subtitle_id": 65,
      "start": 132.959,
      "end": 139.76,
      "text": "और डेरियस खंभाता प्रम झवेरी वगैरह और सर"
    },
    {
      "subtitle_id": 66,
      "start": 137.2,
      "end": 142.4,
      "text": "रतन टाटा ट्रस्ट के जो ट्रस्टीज हैं उनके"
    },
    {
      "subtitle_id": 67,
      "start": 139.76,
      "end": 144.4,
      "text": "भी नाम आप देख सकते हो लगभग सिमिलर ही नाम"
    },
    {
      "subtitle_id": 68,
      "start": 142.4,
      "end": 146.48,
      "text": "है। इसमें जमी टाटा का भी नाम आता है जो"
    },
    {
      "subtitle_id": 69,
      "start": 144.4,
      "end": 149.12,
      "text": "रतन टाटा के ब्रदर हैं। तो इस कमेटी के"
    },
    {
      "subtitle_id": 70,
      "start": 146.48,
      "end": 151.04,
      "text": "पहले रतन टाटा चेयरमैन हुआ करते थे और"
    },
    {
      "subtitle_id": 71,
      "start": 149.12,
      "end": 153.44,
      "text": "इंपॉर्टेंट मेंबर्स में वेनू श्रीनिवासन"
    },
    {
      "subtitle_id": 72,
      "start": 151.04,
      "end": 155.599,
      "text": "और विजय सिंह थे। अब आते हैं लीडरशिप की"
    },
    {
      "subtitle_id": 73,
      "start": 153.44,
      "end": 157.84,
      "text": "तरफ। तो नोएल टाटा जो रतन टाटा के हाफ"
    },
    {
      "subtitle_id": 74,
      "start": 155.599,
      "end": 160.16,
      "text": "ब्रदर हैं। आज कुछ टाटा कंपनीज़ के लीडर"
    },
    {
      "subtitle_id": 75,
      "start": 157.84,
      "end": 162.879,
      "text": "हैं। जैसे कि ट्रेंट, Tata इंटरनेशनल और"
    },
    {
      "subtitle_id": 76,
      "start": 160.16,
      "end": 164.72,
      "text": "Hols वो Tata Steel और Titan के वाइस"
    },
    {
      "subtitle_id": 77,
      "start": 162.879,
      "end": 166.72,
      "text": "चेयरमैन भी है। उनका एक्सपीरियंस और"
    },
    {
      "subtitle_id": 78,
      "start": 164.72,
      "end": 169.2,
      "text": "कंट्रीब्यूशन इतना इंपॉर्टेंट है कि रतन"
    },
    {
      "subtitle_id": 79,
      "start": 166.72,
      "end": 171.36,
      "text": "टाटा सर के जाने के बाद उन्हें ही चेयरमैन"
    },
    {
      "subtitle_id": 80,
      "start": 169.2,
      "end": 173.2,
      "text": "बनाया गया था। तो Tata ट्रस्ट के अंदर"
    },
    {
      "subtitle_id": 81,
      "start": 171.36,
      "end": 174.959,
      "text": "बोर्ड मेंबर्स के बीच अभी एक इशू है"
    },
    {
      "subtitle_id": 82,
      "start": 173.2,
      "end": 176.959,
      "text": "नॉमिनी डायरेक्टर्स की अपॉइंटमेंट और"
    },
    {
      "subtitle_id": 83,
      "start": 174.959,
      "end": 180.319,
      "text": "डिसीजन मेकिंग को लेकर। अभी क्या हुआ कि"
    },
    {
      "subtitle_id": 84,
      "start": 176.959,
      "end": 181.84,
      "text": "11 सितंबर 2025 लगभग 1 महीना पहले इनकी एक"
    },
    {
      "subtitle_id": 85,
      "start": 180.319,
      "end": 183.76,
      "text": "बोर्ड मीटिंग हुई जिसमें एक बहुत बड़ा"
    },
    {
      "subtitle_id": 86,
      "start": 181.84,
      "end": 185.76,
      "text": "क्लैश हुआ। मेहेली मिस्त्री जो टाटा"
    },
    {
      "subtitle_id": 87,
      "start": 183.76,
      "end": 187.68,
      "text": "ट्रस्ट के ट्रस्टी हैं और रतन टाटा के"
    },
    {
      "subtitle_id": 88,
      "start": 185.76,
      "end": 190.0,
      "text": "बहुत करीबी माने जाते हैं। उन्होंने अपनी"
    },
    {
      "subtitle_id": 89,
      "start": 187.68,
      "end": 191.84,
      "text": "फीलिंग्स ओपनली शेयर की है और कहा कि"
    },
    {
      "subtitle_id": 90,
      "start": 190.0,
      "end": 194.0,
      "text": "उन्होंने हमेशा नोएल टाटा का सपोर्ट किया"
    },
    {
      "subtitle_id": 91,
      "start": 191.84,
      "end": 196.319,
      "text": "है। चाहे जब नोएल टाटा चेयरमैन बनने जा"
    },
    {
      "subtitle_id": 92,
      "start": 194.0,
      "end": 198.319,
      "text": "रहे थे। लेकिन जब मेली मिस्त्री को टाटा"
    },
    {
      "subtitle_id": 93,
      "start": 196.319,
      "end": 200.48,
      "text": "ss बोर्ड का नॉमिनी डायरेक्टर बनने के लिए"
    },
    {
      "subtitle_id": 94,
      "start": 198.319,
      "end": 202.319,
      "text": "रिकमेंड किया गया तो नोएल टाटा ने उनका"
    },
    {
      "subtitle_id": 95,
      "start": 200.48,
      "end": 204.4,
      "text": "सपोर्ट नहीं किया। अब जो डिस्प्यूट है वह"
    },
    {
      "subtitle_id": 96,
      "start": 202.319,
      "end": 206.239,
      "text": "नोएल टाटा के मेहली मिस्त्री को टाटा सनंस"
    },
    {
      "subtitle_id": 97,
      "start": 204.4,
      "end": 208.0,
      "text": "बोर्ड के अपॉइंटमेंट करने से मना करने की"
    },
    {
      "subtitle_id": 98,
      "start": 206.239,
      "end": 209.68,
      "text": "वजह से हुआ है। मेहली मिस्त्री का यहां पर"
    },
    {
      "subtitle_id": 99,
      "start": 208.0,
      "end": 211.36,
      "text": "कहना था कि बोर्ड पर आने के लिए मेरा कुछ"
    },
    {
      "subtitle_id": 100,
      "start": 209.68,
      "end": 213.44,
      "text": "इतना मन नहीं था। लेकिन नोएल टाटा को"
    },
    {
      "subtitle_id": 101,
      "start": 211.36,
      "end": 216.319,
      "text": "ऑब्जेक्शन दिखाता है कि यहां पर पावर को"
    },
    {
      "subtitle_id": 102,
      "start": 213.44,
      "end": 218.08,
      "text": "लेकर अंदर ही कुछ टेंशन चल रही है। मतलब"
    },
    {
      "subtitle_id": 103,
      "start": 216.319,
      "end": 220.159,
      "text": "कि फिलहाल Tata ग्रुप के अंदर तीन ग्रुप"
    },
    {
      "subtitle_id": 104,
      "start": 218.08,
      "end": 221.68,
      "text": "ऐसे बन गए हैं जिनमें पावर के लिए स्ट्रगल"
    },
    {
      "subtitle_id": 105,
      "start": 220.159,
      "end": 223.92,
      "text": "चल रही है। और वीडियो में आगे बढ़ने से"
    },
    {
      "subtitle_id": 106,
      "start": 221.68,
      "end": 226.08,
      "text": "पहले आपको बता दूं कि हमने अपने स्माल केस"
    },
    {
      "subtitle_id": 107,
      "start": 223.92,
      "end": 227.599,
      "text": "ल्च किए हैं। दो है हमारे पहला है इका"
    },
    {
      "subtitle_id": 108,
      "start": 226.08,
      "end": 229.599,
      "text": "वैल्यू इन्वेस्टिंग और दूसरा है इका"
    },
    {
      "subtitle_id": 109,
      "start": 227.599,
      "end": 231.28,
      "text": "इमर्जिंग इंडिया। वैल्यू इन्वेस्टिंग"
    },
    {
      "subtitle_id": 110,
      "start": 229.599,
      "end": 233.599,
      "text": "मार्केट में जो अंडरवैल्यूड स्टॉक्स हैं"
    },
    {
      "subtitle_id": 111,
      "start": 231.28,
      "end": 235.68,
      "text": "उन पर फोकस करता है 12 टू 15 स्टॉक्स।"
    },
    {
      "subtitle_id": 112,
      "start": 233.599,
      "end": 237.84,
      "text": "इमर्जिंग इंडिया ऐसे सेक्टर्स पर फोकस"
    },
    {
      "subtitle_id": 113,
      "start": 235.68,
      "end": 239.599,
      "text": "करता है जो आगे चलके कल का भारत बिल्ड"
    },
    {
      "subtitle_id": 114,
      "start": 237.84,
      "end": 241.68,
      "text": "करेंगे जो बहुत ही तेजी से ग्रो कर रही है"
    },
    {
      "subtitle_id": 115,
      "start": 239.599,
      "end": 243.92,
      "text": "ऐसे सेक्टर्स में अच्छे वैल्यूएशंस पर"
    },
    {
      "subtitle_id": 116,
      "start": 241.68,
      "end": 246.319,
      "text": "कंपनी ढूंढना। यहां पर हम जो इमर्जिंग"
    },
    {
      "subtitle_id": 117,
      "start": 243.92,
      "end": 248.08,
      "text": "सेक्टर्स की कंपनीज़ हैं उसमें से भी अच्छी"
    },
    {
      "subtitle_id": 118,
      "start": 246.319,
      "end": 250.0,
      "text": "कंपनीज़ ढूंढ रहे हैं जो सही वैल्यू्यूएशन"
    },
    {
      "subtitle_id": 119,
      "start": 248.08,
      "end": 252.08,
      "text": "पर भी हो। तो ये भी थीम्स बड़ी इंटरेस्टिंग"
    },
    {
      "subtitle_id": 120,
      "start": 250.0,
      "end": 254.159,
      "text": "है। इसे लाने का मकसद ये था कि वैल्यू"
    },
    {
      "subtitle_id": 121,
      "start": 252.08,
      "end": 256.32,
      "text": "इन्वेस्टिंग मतलब वेरी क्लोज टू माय"
    },
    {
      "subtitle_id": 122,
      "start": 254.159,
      "end": 258.4,
      "text": "हार्ट। और उस तरह का कोई यहां पर मुझे"
    },
    {
      "subtitle_id": 123,
      "start": 256.32,
      "end": 260.16,
      "text": "मॉडल पोर्टफोलियो मिला नहीं कि जो सिर्फ"
    },
    {
      "subtitle_id": 124,
      "start": 258.4,
      "end": 262.079,
      "text": "वैल्यू इन्वेस्टिंग पर फोकस कर रहा हो तो"
    },
    {
      "subtitle_id": 125,
      "start": 260.16,
      "end": 263.44,
      "text": "हमने वह किया और इमर्जिंग सेक्टर्स में"
    },
    {
      "subtitle_id": 126,
      "start": 262.079,
      "end": 265.04,
      "text": "हमने एक अपॉर्चुनिटी देखी कि इंडिया में"
    },
    {
      "subtitle_id": 127,
      "start": 263.44,
      "end": 266.8,
      "text": "बहुत सारे सेक्टर्स बहुत तेजी से बढ़ रहे"
    },
    {
      "subtitle_id": 128,
      "start": 265.04,
      "end": 268.24,
      "text": "हैं और उस पर कोई फोकस नहीं कर रहा है। तो"
    },
    {
      "subtitle_id": 129,
      "start": 266.8,
      "end": 270.16,
      "text": "उस डायरेक्शन में भी हम जा रहे हैं और जो"
    },
    {
      "subtitle_id": 130,
      "start": 268.24,
      "end": 272.24,
      "text": "हाई ग्रोथ है उसे कैप्चर करने की कोशिश कर"
    },
    {
      "subtitle_id": 131,
      "start": 270.16,
      "end": 273.84,
      "text": "रहे हैं। तो ये है हमारे दो स्मॉल केसेस।"
    },
    {
      "subtitle_id": 132,
      "start": 272.24,
      "end": 275.04,
      "text": "इन्हें सब्सक्राइब करने की लिंक आपको नीचे"
    },
    {
      "subtitle_id": 133,
      "start": 273.84,
      "end": 276.96,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में मिल"
    },
    {
      "subtitle_id": 134,
      "start": 275.04,
      "end": 278.479,
      "text": "जाएगी। अगर आपको स्माल केस और मॉडर्न"
    },
    {
      "subtitle_id": 135,
      "start": 276.96,
      "end": 280.96,
      "text": "पोर्टफोलियोस के बारे में ज्यादा पता नहीं"
    },
    {
      "subtitle_id": 136,
      "start": 278.479,
      "end": 282.639,
      "text": "है, कुछ भी डाउट आपके दिमाग में है, तो ये"
    },
    {
      "subtitle_id": 137,
      "start": 280.96,
      "end": 284.72,
      "text": "दो नंबर्स यहां पर स्क्रीन पर दिए गए हैं।"
    },
    {
      "subtitle_id": 138,
      "start": 282.639,
      "end": 286.479,
      "text": "बेझिझक इन्हें कॉल कीजिए और अपने सारे"
    },
    {
      "subtitle_id": 139,
      "start": 284.72,
      "end": 288.24,
      "text": "डाउट्स क्लियर कर लीजिए। फिलहाल यहां पर"
    },
    {
      "subtitle_id": 140,
      "start": 286.479,
      "end": 290.479,
      "text": "इस लॉन्च ऑफर में हमारा डिस्काउंट चल रहा"
    },
    {
      "subtitle_id": 141,
      "start": 288.24,
      "end": 292.08,
      "text": "है। जहां पर YouTube फैमिली को फ्लैट 30%"
    },
    {
      "subtitle_id": 142,
      "start": 290.479,
      "end": 295.52,
      "text": "का डिस्काउंट इस सब्सक्रिप्शन पे मिल रहा"
    },
    {
      "subtitle_id": 143,
      "start": 292.08,
      "end": 297.36,
      "text": "है वि द कूपन कोड फम 30 एफ एम 30। तो जरूर"
    },
    {
      "subtitle_id": 144,
      "start": 295.52,
      "end": 299.36,
      "text": "इन स्मॉल केसेस को चेक आउट कीजिए। वैसे भी"
    },
    {
      "subtitle_id": 145,
      "start": 297.36,
      "end": 301.36,
      "text": "मार्केट अभी अच्छा खासा करेक्ट हो रहा है।"
    },
    {
      "subtitle_id": 146,
      "start": 299.36,
      "end": 303.84,
      "text": "तो जितने कम वैल्यू्यूएशन पे आपको चीजें"
    },
    {
      "subtitle_id": 147,
      "start": 301.36,
      "end": 306.08,
      "text": "मिले उतना बेटर। अब आगे बढ़ते हैं। देखिए"
    },
    {
      "subtitle_id": 148,
      "start": 303.84,
      "end": 308.0,
      "text": "टाटा ट्रस्ट का एक रूल है जो अक्टूबर 2024"
    },
    {
      "subtitle_id": 149,
      "start": 306.08,
      "end": 310.56,
      "text": "में बना पिछले साल कि जब भी किसी नॉमिनी"
    },
    {
      "subtitle_id": 150,
      "start": 308.0,
      "end": 312.88,
      "text": "डायरेक्टर की एज 75 से ऊपर हो जाए तब उसकी"
    },
    {
      "subtitle_id": 151,
      "start": 310.56,
      "end": 314.8,
      "text": "अपॉइंटमेंट हर साल ट्रस्ट की बोर्ड से"
    },
    {
      "subtitle_id": 152,
      "start": 312.88,
      "end": 316.4,
      "text": "रिव्यू होनी चाहिए। फिर विजय सिंह जो टाटा"
    },
    {
      "subtitle_id": 153,
      "start": 314.8,
      "end": 319.039,
      "text": "सनंस के नॉमिनी डायरेक्टर हैं उनकी एज"
    },
    {
      "subtitle_id": 154,
      "start": 316.4,
      "end": 320.72,
      "text": "फिलहाल 77 है और उनकी भी अपॉइंटमेंट को"
    },
    {
      "subtitle_id": 155,
      "start": 319.039,
      "end": 323.44,
      "text": "रिव्यू करना था बोर्ड ने। लेकिन उनकी"
    },
    {
      "subtitle_id": 156,
      "start": 320.72,
      "end": 325.52,
      "text": "रिपॉइंटमेंट को चार ट्रस्टीज ने अपोज किया"
    },
    {
      "subtitle_id": 157,
      "start": 323.44,
      "end": 328.24,
      "text": "जिसमें मेहेली मिस्त्री थे, प्रमित झवेरी,"
    },
    {
      "subtitle_id": 158,
      "start": 325.52,
      "end": 330.56,
      "text": "जहांगीर और डेरियस खंब था। वहीं नोएल टट"
    },
    {
      "subtitle_id": 159,
      "start": 328.24,
      "end": 332.479,
      "text": "और वेनु श्रीनिवासन ने विजय सिंह को यहां"
    },
    {
      "subtitle_id": 160,
      "start": 330.56,
      "end": 334.639,
      "text": "पर रीअपॉइंटमेंट के लिए सपोर्ट किया। अब"
    },
    {
      "subtitle_id": 161,
      "start": 332.479,
      "end": 336.32,
      "text": "जो अपोजिशन थी जो चार लोगों ने अपोज में"
    },
    {
      "subtitle_id": 162,
      "start": 334.639,
      "end": 338.32,
      "text": "वोट किया उनका यह कहना था कि मेहली"
    },
    {
      "subtitle_id": 163,
      "start": 336.32,
      "end": 340.479,
      "text": "मिस्त्री को यहां पर अपॉइंट करना चाहिए"
    },
    {
      "subtitle_id": 164,
      "start": 338.32,
      "end": 343.36,
      "text": "नॉमिनी डायरेक्टर के तौर पर। अब गेम सिंपल"
    },
    {
      "subtitle_id": 165,
      "start": 340.479,
      "end": 345.199,
      "text": "है। यहां पर विजय सिंह वोट में हार गए।"
    },
    {
      "subtitle_id": 166,
      "start": 343.36,
      "end": 346.8,
      "text": "उन्हें तुरंत रेजिग्नेशन देना पड़ा अपना।"
    },
    {
      "subtitle_id": 167,
      "start": 345.199,
      "end": 348.72,
      "text": "अब आपको यहां पर लगेगा कि शायद हमें"
    },
    {
      "subtitle_id": 168,
      "start": 346.8,
      "end": 350.88,
      "text": "स्टोरी समझ में आ गई है। लेकिन ऐसा नहीं"
    },
    {
      "subtitle_id": 169,
      "start": 348.72,
      "end": 352.72,
      "text": "है। आपको सिर्फ वन साइड ऑफ द स्टोरी समझ"
    },
    {
      "subtitle_id": 170,
      "start": 350.88,
      "end": 355.6,
      "text": "में आई है। इस स्टोरी की जो दूसरी साइड है"
    },
    {
      "subtitle_id": 171,
      "start": 352.72,
      "end": 357.52,
      "text": "वो है एसपी ग्रुप। एसपी ग्रुप शाहपुर जी"
    },
    {
      "subtitle_id": 172,
      "start": 355.6,
      "end": 360.72,
      "text": "पालनजी ग्रुप। तो देखिए कहानी ऐसी है कि"
    },
    {
      "subtitle_id": 173,
      "start": 357.52,
      "end": 363.039,
      "text": "1924 से 26 के बीच मतलब आज से करीब 100"
    },
    {
      "subtitle_id": 174,
      "start": 360.72,
      "end": 366.0,
      "text": "साल पहले एफ दिन शाह जो Tata फैमिली के"
    },
    {
      "subtitle_id": 175,
      "start": 363.039,
      "end": 368.24,
      "text": "एडवाइजर फ्रेंड और लेंडर थे उन्होंने Tata"
    },
    {
      "subtitle_id": 176,
      "start": 366.0,
      "end": 370.16,
      "text": "Steel और Tata Hydro को बेचने के लिए"
    },
    {
      "subtitle_id": 177,
      "start": 368.24,
      "end": 372.24,
      "text": "क्रोसर्स का लोन लिया था। अब इस लोन के"
    },
    {
      "subtitle_id": 178,
      "start": 370.16,
      "end": 375.6,
      "text": "रिपेमेंट के लिए Tata ने प्रॉमिस किया था"
    },
    {
      "subtitle_id": 179,
      "start": 372.24,
      "end": 377.84,
      "text": "25% प्रॉफिट शेयर ऑफ Tata Steel और 12.5%"
    },
    {
      "subtitle_id": 180,
      "start": 375.6,
      "end": 380.0,
      "text": "प्रॉफिट शेयर ऑफ Tata Hydro। आगे चलके जो"
    },
    {
      "subtitle_id": 181,
      "start": 377.84,
      "end": 382.0,
      "text": "एफई दीनशाह है उनका जो लोन है वो Tata के"
    },
    {
      "subtitle_id": 182,
      "start": 380.0,
      "end": 384.0,
      "text": "इक्विटी में बदल गया जब Tata Steel"
    },
    {
      "subtitle_id": 183,
      "start": 382.0,
      "end": 386.8,
      "text": "रिपेमेंट नहीं कर पाई। जिसके चलते उन्हें"
    },
    {
      "subtitle_id": 184,
      "start": 384.0,
      "end": 389.199,
      "text": "Tata SS का 12.5% स्टेक मिल गया। अब"
    },
    {
      "subtitle_id": 185,
      "start": 386.8,
      "end": 392.08,
      "text": "इंटरेस्टिंग बात हुई 1936 में जब शापुर जी"
    },
    {
      "subtitle_id": 186,
      "start": 389.199,
      "end": 394.56,
      "text": "पालनजी ग्रुप ने एफई दिनश से ही 12.5%"
    },
    {
      "subtitle_id": 187,
      "start": 392.08,
      "end": 396.639,
      "text": "स्टेक Tata SS का खुद खरीद लिया और यहां"
    },
    {
      "subtitle_id": 188,
      "start": 394.56,
      "end": 399.12,
      "text": "से फिर एसपी ग्रुप Tata SS में एक अच्छा"
    },
    {
      "subtitle_id": 189,
      "start": 396.639,
      "end": 401.84,
      "text": "खासा शेयर होल्डर बन गया। फिर 1975 में"
    },
    {
      "subtitle_id": 190,
      "start": 399.12,
      "end": 404.16,
      "text": "पालन जी शापू जी जो शापू जी पालन जी के"
    },
    {
      "subtitle_id": 191,
      "start": 401.84,
      "end": 405.919,
      "text": "बेटे थे उन्होंने स्टेक और बढ़ाया और उसके"
    },
    {
      "subtitle_id": 192,
      "start": 404.16,
      "end": 408.639,
      "text": "चलते एसपी ग्रुप का जो स्टेक है आने वाले"
    },
    {
      "subtitle_id": 193,
      "start": 405.919,
      "end": 410.96,
      "text": "कुछ सालों में 18% तक चला गया। फिर 2003"
    },
    {
      "subtitle_id": 194,
      "start": 408.639,
      "end": 413.199,
      "text": "में पालन जी शापू जी ने अपने बेटे साइरस"
    },
    {
      "subtitle_id": 195,
      "start": 410.96,
      "end": 415.199,
      "text": "मिस्त्री को टाटा सनंस के बोर्ड पर लाया"
    },
    {
      "subtitle_id": 196,
      "start": 413.199,
      "end": 416.88,
      "text": "और आपको पता ही कि 2012 में वो चेयरमैन भी"
    },
    {
      "subtitle_id": 197,
      "start": 415.199,
      "end": 419.039,
      "text": "बने थे टाटा सनंस। उसके बाद क्या हुआ आपको"
    },
    {
      "subtitle_id": 198,
      "start": 416.88,
      "end": 420.96,
      "text": "पता ही है कोर्ट के मैटर्स हुए। रतन टाटा"
    },
    {
      "subtitle_id": 199,
      "start": 419.039,
      "end": 423.36,
      "text": "सर और साइरस मिस्त्री के बीच भी काफी कुछ"
    },
    {
      "subtitle_id": 200,
      "start": 420.96,
      "end": 425.12,
      "text": "हुआ और फिर 2016 में साइरस मिस्त्री की"
    },
    {
      "subtitle_id": 201,
      "start": 423.36,
      "end": 427.36,
      "text": "ड्रामेटिक एग्जिट हुई और उसके बाद एसपी"
    },
    {
      "subtitle_id": 202,
      "start": 425.12,
      "end": 429.919,
      "text": "ग्रुप को साइडलाइन किया गया। देखा जाए तो"
    },
    {
      "subtitle_id": 203,
      "start": 427.36,
      "end": 431.599,
      "text": "SP ग्रुप के पास अभी भी Tata SS का 18%"
    },
    {
      "subtitle_id": 204,
      "start": 429.919,
      "end": 433.599,
      "text": "स्टेक है लेकिन उन्हें अपने स्टेक को"
    },
    {
      "subtitle_id": 205,
      "start": 431.599,
      "end": 435.68,
      "text": "मोनेटाइज करने नहीं दिया जा रहा। फिलहाल"
    },
    {
      "subtitle_id": 206,
      "start": 433.599,
      "end": 437.28,
      "text": "अगर देखा जाए तो SP ग्रुप डेट क्राइसिस"
    },
    {
      "subtitle_id": 207,
      "start": 435.68,
      "end": 438.96,
      "text": "में चल रहा है जिसके चलते उन्हें Tata"
    },
    {
      "subtitle_id": 208,
      "start": 437.28,
      "end": 441.12,
      "text": "Sans के कुछ शेयर्स गिरवी भी रखने पड़े।"
    },
    {
      "subtitle_id": 209,
      "start": 438.96,
      "end": 443.599,
      "text": "अब SP ग्रुप चाहता है कि Tata Sans स्टॉक"
    },
    {
      "subtitle_id": 210,
      "start": 441.12,
      "end": 446.0,
      "text": "मार्केट में लिस्ट हो जाए ताकि जब चाहे तब"
    },
    {
      "subtitle_id": 211,
      "start": 443.599,
      "end": 448.319,
      "text": "वो SP ग्रुप अपना Tata SS का स्टेक बेच"
    },
    {
      "subtitle_id": 212,
      "start": 446.0,
      "end": 450.08,
      "text": "सके वो भी सही वैल्यू्यूएशन पर। तो शाहपुर"
    },
    {
      "subtitle_id": 213,
      "start": 448.319,
      "end": 451.759,
      "text": "जी पालोंजी मिश्री यहां पर ओपनली कह रहे"
    },
    {
      "subtitle_id": 214,
      "start": 450.08,
      "end": 453.44,
      "text": "हैं कि Tata Sans को स्टॉक मार्केट में"
    },
    {
      "subtitle_id": 215,
      "start": 451.759,
      "end": 454.96,
      "text": "लिस्ट होना चाहिए। उन्होंने यह कहा कि यह"
    },
    {
      "subtitle_id": 216,
      "start": 453.44,
      "end": 456.479,
      "text": "सिर्फ एसपी ग्रुप के लिए नहीं इंडिया के"
    },
    {
      "subtitle_id": 217,
      "start": 454.96,
      "end": 458.4,
      "text": "सारे शेयर होल्डर्स के लिए बहुत अच्छी बात"
    },
    {
      "subtitle_id": 218,
      "start": 456.479,
      "end": 460.479,
      "text": "होगी। मतलब एसपी ग्रुप का तो इंटेंशन था"
    },
    {
      "subtitle_id": 219,
      "start": 458.4,
      "end": 463.039,
      "text": "ही लिस्ट करने का। अब उनको बाद में सपोर्ट"
    },
    {
      "subtitle_id": 220,
      "start": 460.479,
      "end": 465.68,
      "text": "मिल गया आरबीआई का। आरबीआई ने क्या कहा कि"
    },
    {
      "subtitle_id": 221,
      "start": 463.039,
      "end": 467.84,
      "text": "Tata SS है वो एक फाइनेंस कंपनी के तौर पर"
    },
    {
      "subtitle_id": 222,
      "start": 465.68,
      "end": 469.52,
      "text": "काउंट होती है। और जो अपर टियर लेवल की"
    },
    {
      "subtitle_id": 223,
      "start": 467.84,
      "end": 471.919,
      "text": "फाइनेंस कंपनीज़ हैं उन्हें 3 साल में"
    },
    {
      "subtitle_id": 224,
      "start": 469.52,
      "end": 473.52,
      "text": "पब्लिक लिस्ट होना कंपलसरी है। तो Tata SS"
    },
    {
      "subtitle_id": 225,
      "start": 471.919,
      "end": 475.68,
      "text": "को भी इन्होंने 30th सप्टेंबर का टाइम"
    },
    {
      "subtitle_id": 226,
      "start": 473.52,
      "end": 477.599,
      "text": "दिया। लेकिन अभी अक्टूबर चल रहा है। अभी"
    },
    {
      "subtitle_id": 227,
      "start": 475.68,
      "end": 479.52,
      "text": "भी कंपनी लिस्ट नहीं हुई। तो लिस्ट क्यों"
    },
    {
      "subtitle_id": 228,
      "start": 477.599,
      "end": 481.599,
      "text": "नहीं हुई? तो Tata SS ने इससे पहले आरबीआई"
    },
    {
      "subtitle_id": 229,
      "start": 479.52,
      "end": 484.08,
      "text": "को रिक्वेस्ट किया कि वह प्राइवेट ही रहना"
    },
    {
      "subtitle_id": 230,
      "start": 481.599,
      "end": 485.84,
      "text": "चाहते हैं। अभी उनके बीच डिस्कशन चल रहा"
    },
    {
      "subtitle_id": 231,
      "start": 484.08,
      "end": 487.759,
      "text": "है। फाइनल कुछ नहीं आया है आरबीआई की तरफ"
    },
    {
      "subtitle_id": 232,
      "start": 485.84,
      "end": 490.08,
      "text": "से। तो Tata SS अगर पब्लिकली लिस्ट होता"
    },
    {
      "subtitle_id": 233,
      "start": 487.759,
      "end": 492.479,
      "text": "है तो क्या होगा? तो Tata जो ट्रस्ट है जो"
    },
    {
      "subtitle_id": 234,
      "start": 490.08,
      "end": 494.56,
      "text": "66% स्टेक ओन करती है Tata SS में उसका"
    },
    {
      "subtitle_id": 235,
      "start": 492.479,
      "end": 496.8,
      "text": "इन्फ्लुएंस थोड़ा कम हो सकता है। बिकॉज़"
    },
    {
      "subtitle_id": 236,
      "start": 494.56,
      "end": 499.68,
      "text": "पब्लिकली जाना है तो 25% पब्लिक के पास"
    },
    {
      "subtitle_id": 237,
      "start": 496.8,
      "end": 501.599,
      "text": "जाएगा। तो कहीं ना कहीं SP ग्रुप अपना कुछ"
    },
    {
      "subtitle_id": 238,
      "start": 499.68,
      "end": 502.96,
      "text": "बेचेगा। Tata T को भी अपना कुछ स्टेक"
    },
    {
      "subtitle_id": 239,
      "start": 501.599,
      "end": 505.039,
      "text": "बेचना पड़ेगा। और कहीं ना कहीं उनका जो"
    },
    {
      "subtitle_id": 240,
      "start": 502.96,
      "end": 506.879,
      "text": "कंट्रोल है, इन्फ्लुएंस है ऑन दी Tata"
    },
    {
      "subtitle_id": 241,
      "start": 505.039,
      "end": 508.24,
      "text": "ग्रुप एंड Tata S वो थोड़ा सा कम हो"
    },
    {
      "subtitle_id": 242,
      "start": 506.879,
      "end": 510.16,
      "text": "जाएगा। अब कहीं ना कहीं देखा जाए तो दो"
    },
    {
      "subtitle_id": 243,
      "start": 508.24,
      "end": 512.56,
      "text": "क्लियर ग्रुप्स यहां पर बन चुके हैं। एक"
    },
    {
      "subtitle_id": 244,
      "start": 510.16,
      "end": 515.36,
      "text": "वो जो टाटा s के नॉमिनी डायरेक्टर्स हैं"
    },
    {
      "subtitle_id": 245,
      "start": 512.56,
      "end": 518.08,
      "text": "जैसे कि नोइल टाटा और वेनू श्रीनिवासन और"
    },
    {
      "subtitle_id": 246,
      "start": 515.36,
      "end": 520.159,
      "text": "दूसरे जो नहीं है। तो मोटा-मोटी समझे तो"
    },
    {
      "subtitle_id": 247,
      "start": 518.08,
      "end": 522.479,
      "text": "मिस्त्री वर्सेस टाटा का यह खेल फिर से"
    },
    {
      "subtitle_id": 248,
      "start": 520.159,
      "end": 524.399,
      "text": "शुरू हो गया है जो 2012 में भी स्टार्ट"
    },
    {
      "subtitle_id": 249,
      "start": 522.479,
      "end": 526.64,
      "text": "हुआ था। अब इससे हो क्या रहा है कि बिजनेस"
    },
    {
      "subtitle_id": 250,
      "start": 524.399,
      "end": 528.399,
      "text": "पर फोकस करने की बजाय इंटरनल फाइट्स पर"
    },
    {
      "subtitle_id": 251,
      "start": 526.64,
      "end": 530.959,
      "text": "ज्यादा फोकस हो रही हैं। वहां पर ज्यादा"
    },
    {
      "subtitle_id": 252,
      "start": 528.399,
      "end": 532.959,
      "text": "झगड़े हो रहे हैं रादर दन कुछ बिजनेस को"
    },
    {
      "subtitle_id": 253,
      "start": 530.959,
      "end": 534.88,
      "text": "लेकर। अब इसमें कुछ मेंबर्स का यह भी कहना"
    },
    {
      "subtitle_id": 254,
      "start": 532.959,
      "end": 537.36,
      "text": "है कि कई सारी इंपॉर्टेंट इंफॉर्मेशन जैसे"
    },
    {
      "subtitle_id": 255,
      "start": 534.88,
      "end": 539.04,
      "text": "कि आर्टिकल वन टू 1 ए इनकी इंफॉर्मेशन"
    },
    {
      "subtitle_id": 256,
      "start": 537.36,
      "end": 540.8,
      "text": "ट्रस्ट के मेंबर्स को दी नहीं जा रही है।"
    },
    {
      "subtitle_id": 257,
      "start": 539.04,
      "end": 542.88,
      "text": "एक और बड़ी वजह यहां पर जो मीडिया में आई"
    },
    {
      "subtitle_id": 258,
      "start": 540.8,
      "end": 545.04,
      "text": "है वो यह है कि Tata इंटरनेशनल यहां पर"
    },
    {
      "subtitle_id": 259,
      "start": 542.88,
      "end": 546.8,
      "text": "1000 करोड़ की फंडिंग उठाना चाहती है। अब"
    },
    {
      "subtitle_id": 260,
      "start": 545.04,
      "end": 548.56,
      "text": "यह जो फर्म है यह नोएल टाटा के कंट्रोल"
    },
    {
      "subtitle_id": 261,
      "start": 546.8,
      "end": 550.08,
      "text": "में है। पर इस फंडिंग डिसीजन को लेकर"
    },
    {
      "subtitle_id": 262,
      "start": 548.56,
      "end": 551.92,
      "text": "ट्रस्टीज को लग रहा है कि यहां पर"
    },
    {
      "subtitle_id": 263,
      "start": 550.08,
      "end": 553.92,
      "text": "ट्रांसपेरेंसी मेंटेन नहीं की जा रही है।"
    },
    {
      "subtitle_id": 264,
      "start": 551.92,
      "end": 555.839,
      "text": "ट्रस्टीज को कई सारी चीजें नहीं बताई जा"
    },
    {
      "subtitle_id": 265,
      "start": 553.92,
      "end": 557.44,
      "text": "रही है। और इसी के चलते सरकार को भी लगा"
    },
    {
      "subtitle_id": 266,
      "start": 555.839,
      "end": 559.2,
      "text": "कि यार इतना बड़ा ग्रुप सबसे बड़ा ग्रुप"
    },
    {
      "subtitle_id": 267,
      "start": 557.44,
      "end": 561.839,
      "text": "है भारत का। वो अगर प्रॉब्लम में है तो"
    },
    {
      "subtitle_id": 268,
      "start": 559.2,
      "end": 564.16,
      "text": "देखना चाहिए कि कैसे ये प्रॉब्लम सॉल्व हो"
    },
    {
      "subtitle_id": 269,
      "start": 561.839,
      "end": 565.839,
      "text": "और इसी के चलते फिर टाटा ट्रस्ट के जो"
    },
    {
      "subtitle_id": 270,
      "start": 564.16,
      "end": 568.08,
      "text": "लीडर्स हैं इंक्लूडिंग नोल टाटा एन"
    },
    {
      "subtitle_id": 271,
      "start": 565.839,
      "end": 570.8,
      "text": "चंद्रशेखरन जो टाटा सनंस के चेयरमैन हैं"
    },
    {
      "subtitle_id": 272,
      "start": 568.08,
      "end": 572.32,
      "text": "वेनू श्रीनिवासन डेरियस खंभाता इन्होंने"
    },
    {
      "subtitle_id": 273,
      "start": 570.8,
      "end": 574.24,
      "text": "होम मिनिस्टर अमित शाह और फाइनेंस"
    },
    {
      "subtitle_id": 274,
      "start": 572.32,
      "end": 576.0,
      "text": "मिनिस्टर निर्मला सीतारमण से मीटिंग की"
    },
    {
      "subtitle_id": 275,
      "start": 574.24,
      "end": 577.76,
      "text": "गवर्नमेंट ने क्लियर कहा है कि टाटा ग्रुप"
    },
    {
      "subtitle_id": 276,
      "start": 576.0,
      "end": 579.92,
      "text": "को स्टेबिलिटी मेंटेन करनी है बाय"
    },
    {
      "subtitle_id": 277,
      "start": 577.76,
      "end": 582.16,
      "text": "व्हाटएवर मींस नेसेसरी तो जब तक इस पर"
    },
    {
      "subtitle_id": 278,
      "start": 579.92,
      "end": 584.0,
      "text": "आरबीआई से एक डिसीजन नहीं आती कि आगे क्या"
    },
    {
      "subtitle_id": 279,
      "start": 582.16,
      "end": 586.0,
      "text": "होगा तब तक मुझे लगता है यह कॉन्फ्लिक्ट"
    },
    {
      "subtitle_id": 280,
      "start": 584.0,
      "end": 587.44,
      "text": "चलता ही रहेगा और अगर टाटा सनंस लिस्ट"
    },
    {
      "subtitle_id": 281,
      "start": 586.0,
      "end": 589.12,
      "text": "नहीं होती है तो मिस्री फैमिली कंटिन्यू"
    },
    {
      "subtitle_id": 282,
      "start": 587.44,
      "end": 590.959,
      "text": "अपना प्रेशर बनाए रखें कि इसे लिस्ट करो"
    },
    {
      "subtitle_id": 283,
      "start": 589.12,
      "end": 592.88,
      "text": "क्योंकि हमें अपना पैसा लिक्विडेट करना"
    },
    {
      "subtitle_id": 284,
      "start": 590.959,
      "end": 595.36,
      "text": "है। लेकिन अगेन Tata SS को वैसा नहीं करना"
    },
    {
      "subtitle_id": 285,
      "start": 592.88,
      "end": 597.44,
      "text": "है। Tata ग्रुप को वैसा नहीं करना है। तो"
    },
    {
      "subtitle_id": 286,
      "start": 595.36,
      "end": 599.279,
      "text": "फिलहाल यह कुछ ओवरऑल सीन है जो Tata"
    },
    {
      "subtitle_id": 287,
      "start": 597.44,
      "end": 601.68,
      "text": "वर्सेस मिस्त्री चल रहा है। इस पर हमने"
    },
    {
      "subtitle_id": 288,
      "start": 599.279,
      "end": 603.839,
      "text": "कुछ पांच छ साल पहले भी बात की थी जब रतन"
    },
    {
      "subtitle_id": 289,
      "start": 601.68,
      "end": 605.92,
      "text": "टाटा सर और सारस मिस्त्री के बीच ये चल"
    },
    {
      "subtitle_id": 290,
      "start": 603.839,
      "end": 608.08,
      "text": "रहा था। अब देखिए कोई बड़ी फैमिली जहां पर"
    },
    {
      "subtitle_id": 291,
      "start": 605.92,
      "end": 609.519,
      "text": "मेन बिजनेसमैन अचानक से चला जाए तो बाद"
    },
    {
      "subtitle_id": 292,
      "start": 608.08,
      "end": 611.279,
      "text": "में कुछ ना कुछ कॉन्फ्लिक्ट होते रहते"
    },
    {
      "subtitle_id": 293,
      "start": 609.519,
      "end": 613.12,
      "text": "हैं। आपने हमने देखा था कि धीरूभाई अंबानी"
    },
    {
      "subtitle_id": 294,
      "start": 611.279,
      "end": 614.72,
      "text": "के जाने के बाद मुकेश अंबानी और अनिल"
    },
    {
      "subtitle_id": 295,
      "start": 613.12,
      "end": 616.959,
      "text": "अंबानी के बीच भी कॉन्फ्लिक्ट शुरू हुए।"
    },
    {
      "subtitle_id": 296,
      "start": 614.72,
      "end": 619.04,
      "text": "उनकी मां को बीच में आके फिर बराबर"
    },
    {
      "subtitle_id": 297,
      "start": 616.959,
      "end": 620.959,
      "text": "बंटवारा करना पड़ा। तो सिमिलर चीज में"
    },
    {
      "subtitle_id": 298,
      "start": 619.04,
      "end": 623.2,
      "text": "मुझे लगता है किसी ना किसी को आना पड़ेगा"
    },
    {
      "subtitle_id": 299,
      "start": 620.959,
      "end": 625.2,
      "text": "और यहां पर एक प्रॉपर बफरर्केशन या फिर जो"
    },
    {
      "subtitle_id": 300,
      "start": 623.2,
      "end": 627.839,
      "text": "भी चीज है वो करना पड़ेगा। तभी यह मैटर"
    },
    {
      "subtitle_id": 301,
      "start": 625.2,
      "end": 629.44,
      "text": "सुलझेगा। नहीं तो यह कहानी चलती रहेगी आने"
    },
    {
      "subtitle_id": 302,
      "start": 627.839,
      "end": 631.12,
      "text": "वाले कई सालों तक। तो आशा करता हूं कि यह"
    },
    {
      "subtitle_id": 303,
      "start": 629.44,
      "end": 632.959,
      "text": "कॉन्फ्लिक्ट आपको बहुत अच्छे से समझ में आ"
    },
    {
      "subtitle_id": 304,
      "start": 631.12,
      "end": 635.44,
      "text": "गया होगा कि इसकी हिस्ट्री 100 साल पहले"
    },
    {
      "subtitle_id": 305,
      "start": 632.959,
      "end": 637.36,
      "text": "की है। और अब पर्टिकुलर टाइम में अभी"
    },
    {
      "subtitle_id": 306,
      "start": 635.44,
      "end": 638.959,
      "text": "फिलहाल यह क्यों हो रहा है। मतलब मिस्ट्री"
    },
    {
      "subtitle_id": 307,
      "start": 637.36,
      "end": 641.04,
      "text": "ग्रुप का डेट एक साइड मिस्ट्री ग्रुप का"
    },
    {
      "subtitle_id": 308,
      "start": 638.959,
      "end": 642.8,
      "text": "जो डेट क्राइसिस है वो उनको सोने नहीं दे"
    },
    {
      "subtitle_id": 309,
      "start": 641.04,
      "end": 644.8,
      "text": "रहा है। वो उनको फोर्स कर रहा है कि आप"
    },
    {
      "subtitle_id": 310,
      "start": 642.8,
      "end": 646.72,
      "text": "लिस्ट करो। वहीं पर Tata ट्रस्ट चाहती है"
    },
    {
      "subtitle_id": 311,
      "start": 644.8,
      "end": 648.72,
      "text": "कि Tata SS अगर लिस्ट हो गया तो हमारी"
    },
    {
      "subtitle_id": 312,
      "start": 646.72,
      "end": 651.76,
      "text": "पावर उतनी नहीं रहेगी तो बेटर स्टे"
    },
    {
      "subtitle_id": 313,
      "start": 648.72,
      "end": 653.519,
      "text": "प्राइवेट। तो कौन सही कौन गलत आपको क्या"
    },
    {
      "subtitle_id": 314,
      "start": 651.76,
      "end": 655.12,
      "text": "लगता है नीचे कमेंट करके जरूर बताइए और"
    },
    {
      "subtitle_id": 315,
      "start": 653.519,
      "end": 657.04,
      "text": "जाते-जाते हमारी मॉडल पोर्टफोलियोस की"
    },
    {
      "subtitle_id": 316,
      "start": 655.12,
      "end": 658.64,
      "text": "दिवाली ऑफर को जरूर चेक आउट कीजिए। हमारे"
    },
    {
      "subtitle_id": 317,
      "start": 657.04,
      "end": 660.48,
      "text": "दोनों मॉडल पोर्टफोलियोस की लिंक आपको"
    },
    {
      "subtitle_id": 318,
      "start": 658.64,
      "end": 662.24,
      "text": "नीचे डिस्क्रिप्शन और कमेंट बॉक्स में मिल"
    },
    {
      "subtitle_id": 319,
      "start": 660.48,
      "end": 663.6,
      "text": "जाएगी। डोंट मिस आउट ऑन दिस ऑफर। आपको यह"
    },
    {
      "subtitle_id": 320,
      "start": 662.24,
      "end": 665.2,
      "text": "दोबारा नहीं मिलेगी। तो मिलते हैं अगले"
    },
    {
      "subtitle_id": 321,
      "start": 663.6,
      "end": 667.6,
      "text": "वीडियो में। थैंक यू सो मच। बाई बाय, टेक"
    },
    {
      "subtitle_id": 322,
      "start": 665.2,
      "end": 667.6,
      "text": "केयर।"
    }
  ]
}