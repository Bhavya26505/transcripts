  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.04,
      "end": 3.84,
      "text": "आप यह नितिन कामत का ट्वीट देखिए स्क्रीन"
    },
    {
      "subtitle_id": 2,
      "start": 1.88,
      "end": 6.16,
      "text": "पर नितिन कामत कह रहे है कि मोस्ट ऑफ द"
    },
    {
      "subtitle_id": 3,
      "start": 3.84,
      "end": 8.32,
      "text": "इंडियंस सिर्फ एक मेडिकल बिल दूर है बैंकर"
    },
    {
      "subtitle_id": 4,
      "start": 6.16,
      "end": 10.4,
      "text": "पसी से यानी एक बार आप बीमार पड़े और आपको"
    },
    {
      "subtitle_id": 5,
      "start": 8.32,
      "end": 12.2,
      "text": "हॉस्पिटल जाना पड़ा तो काम खत्म क्योंकि"
    },
    {
      "subtitle_id": 6,
      "start": 10.4,
      "end": 14.559,
      "text": "ज्यादातर इंडियंस के पास ना ही इमरजेंसी"
    },
    {
      "subtitle_id": 7,
      "start": 12.2,
      "end": 16.48,
      "text": "फंड्स है ना ही हेल्थ इंश्योरेंस और यही"
    },
    {
      "subtitle_id": 8,
      "start": 14.559,
      "end": 18.279,
      "text": "रियलिटी है और आज अगर आप प्राइवेट"
    },
    {
      "subtitle_id": 9,
      "start": 16.48,
      "end": 20.8,
      "text": "हॉस्पिटल में दो-तीन दिन भी हॉस्पिटलाइज"
    },
    {
      "subtitle_id": 10,
      "start": 18.279,
      "end": 22.439,
      "text": "हो जाते हैं तो लाखों का बिल तो पक्का है"
    },
    {
      "subtitle_id": 11,
      "start": 20.8,
      "end": 24.439,
      "text": "और आने वाले टाइम में यह कम नहीं होने"
    },
    {
      "subtitle_id": 12,
      "start": 22.439,
      "end": 27.0,
      "text": "वाला उल्टा बढ़ने वाला है क्योंकि मेडिकल"
    },
    {
      "subtitle_id": 13,
      "start": 24.439,
      "end": 29.199,
      "text": "कॉस्ट इंडिया में 14 टू 15 पर से सालाना"
    },
    {
      "subtitle_id": 14,
      "start": 27.0,
      "end": 31.92,
      "text": "बढ़ रही है जो कि हमारे इंफ्लेशन रेट से"
    },
    {
      "subtitle_id": 15,
      "start": 29.199,
      "end": 33.84,
      "text": "लगभग दो से ई गुना है और यह तो एक पहलू है"
    },
    {
      "subtitle_id": 16,
      "start": 31.92,
      "end": 35.719,
      "text": "दूसरी तरफ आजकल की जो लाइफ स्टाइल है वो"
    },
    {
      "subtitle_id": 17,
      "start": 33.84,
      "end": 38.239,
      "text": "ऐसी है कि स्ट्रेस नॉर्मल हो चुका है"
    },
    {
      "subtitle_id": 18,
      "start": 35.719,
      "end": 40.2,
      "text": "ओवरवर्क भी नॉर्मल हो चुका है और इसी वजह"
    },
    {
      "subtitle_id": 19,
      "start": 38.239,
      "end": 42.64,
      "text": "से आप न्यूज़ में देख सकते हैं हर तरफ"
    },
    {
      "subtitle_id": 20,
      "start": 40.2,
      "end": 44.879,
      "text": "टॉक्सिक वर्क कल्चर की ही चर्चा चल रही है"
    },
    {
      "subtitle_id": 21,
      "start": 42.64,
      "end": 47.039,
      "text": "और इसी के साथ आजकल एक एवरेज इंडियन की जो"
    },
    {
      "subtitle_id": 22,
      "start": 44.879,
      "end": 50.36,
      "text": "डाइट है वो ऐसी है कि जिससे हार्ट रिलेटेड"
    },
    {
      "subtitle_id": 23,
      "start": 47.039,
      "end": 52.52,
      "text": "डिजीज जो पहले 60 70 में आते थे वो अब 30"
    },
    {
      "subtitle_id": 24,
      "start": 50.36,
      "end": 54.76,
      "text": "और 40 में आने लगे हैं और दुख की बात यह"
    },
    {
      "subtitle_id": 25,
      "start": 52.52,
      "end": 56.64,
      "text": "है कि लग नहीं रहा कि ये चीजें बदलेगी अब"
    },
    {
      "subtitle_id": 26,
      "start": 54.76,
      "end": 58.719,
      "text": "फ इनोवेशंस बाय प्रसाद एक हेल्थ रिलेटेड"
    },
    {
      "subtitle_id": 27,
      "start": 56.64,
      "end": 60.84,
      "text": "चैनल तो नहीं है इसलिए मैं आपको कोई डाइट"
    },
    {
      "subtitle_id": 28,
      "start": 58.719,
      "end": 62.68,
      "text": "प्लांस या क्या खाना क्या नहीं खाना चाहिए"
    },
    {
      "subtitle_id": 29,
      "start": 60.84,
      "end": 64.72,
      "text": "उसके बारे में नहीं बताऊंगा पर हमारा चैनल"
    },
    {
      "subtitle_id": 30,
      "start": 62.68,
      "end": 66.52,
      "text": "फाइनेंशियल हेल्थ रिलेटेड है तो यह मेडिकल"
    },
    {
      "subtitle_id": 31,
      "start": 64.72,
      "end": 68.759,
      "text": "बिल्स बचाने की एक अच्छी दवा मैं आपको बता"
    },
    {
      "subtitle_id": 32,
      "start": 66.52,
      "end": 70.96,
      "text": "सकता हूं व है एक अच्छा हेल्थ इंश्योरेंस"
    },
    {
      "subtitle_id": 33,
      "start": 68.759,
      "end": 72.68,
      "text": "अपने लिए और अपनी पूरी फैमिली के लिए"
    },
    {
      "subtitle_id": 34,
      "start": 70.96,
      "end": 74.92,
      "text": "क्योंकि अगर हम देखें तो आज भी इंडिया में"
    },
    {
      "subtitle_id": 35,
      "start": 72.68,
      "end": 77.159,
      "text": "50 पर मेडिकल बिल्स आउट ऑफ द पॉकेट होते"
    },
    {
      "subtitle_id": 36,
      "start": 74.92,
      "end": 78.92,
      "text": "हैं मतलब लोग अपनी जेब से ये पैसे भरते"
    },
    {
      "subtitle_id": 37,
      "start": 77.159,
      "end": 80.88,
      "text": "हैं जबकि वेस्टर्न कंट्रीज में मोस्टली"
    },
    {
      "subtitle_id": 38,
      "start": 78.92,
      "end": 82.92,
      "text": "मेडिकल बिल्स को हेल्थ इंश्योरेंस कवर"
    },
    {
      "subtitle_id": 39,
      "start": 80.88,
      "end": 85.28,
      "text": "करती है कुछ जगह पर सरकार उसका खर्चा"
    },
    {
      "subtitle_id": 40,
      "start": 82.92,
      "end": 87.28,
      "text": "उठाती है तो कुछ जगह पर लोग इंश्योरेंस के"
    },
    {
      "subtitle_id": 41,
      "start": 85.28,
      "end": 89.119,
      "text": "जरिए उसे हेज कर लेते हैं वहां पर लोगों"
    },
    {
      "subtitle_id": 42,
      "start": 87.28,
      "end": 91.079,
      "text": "को अपनी जेब से पैसे नहीं भरने पड़ते और"
    },
    {
      "subtitle_id": 43,
      "start": 89.119,
      "end": 92.56,
      "text": "इसीलिए हेल्द इंश्योरेंस जरूरी है अब आप"
    },
    {
      "subtitle_id": 44,
      "start": 91.079,
      "end": 94.68,
      "text": "कहेंगे कि प्रसाद यह तो समझ में आ गया कि"
    },
    {
      "subtitle_id": 45,
      "start": 92.56,
      "end": 96.36,
      "text": "हेल्थ इंश्योरेंस जरूरी है और कौन सा"
    },
    {
      "subtitle_id": 46,
      "start": 94.68,
      "end": 98.28,
      "text": "क्योंकि इंडिया में फिलहाल 30 से ज्यादा"
    },
    {
      "subtitle_id": 47,
      "start": 96.36,
      "end": 99.68,
      "text": "कंपनीज हेल्थ इंश्योरेंस ऑफर करती है"
    },
    {
      "subtitle_id": 48,
      "start": 98.28,
      "end": 102.0,
      "text": "जिसमें सिक्स स्टैंड अलोन हेल्थ"
    },
    {
      "subtitle_id": 49,
      "start": 99.68,
      "end": 103.84,
      "text": "इंश्योरेंस कंपनीज हैं और बाकी 24 जनरल"
    },
    {
      "subtitle_id": 50,
      "start": 102.0,
      "end": 106.2,
      "text": "इंश्योरेंस कंपनीज हैं जो हेल्थ के"
    },
    {
      "subtitle_id": 51,
      "start": 103.84,
      "end": 107.88,
      "text": "साथ-साथ दूसरे इंश्योरेंस भी ऑफर करती है"
    },
    {
      "subtitle_id": 52,
      "start": 106.2,
      "end": 109.36,
      "text": "लोगों को हालांकि ज्यादा ऑप्शंस चाहिए"
    },
    {
      "subtitle_id": 53,
      "start": 107.88,
      "end": 111.159,
      "text": "लेकिन जब उन्हें ये ज्यादा ऑप्शंस मिल"
    },
    {
      "subtitle_id": 54,
      "start": 109.36,
      "end": 113.079,
      "text": "जाते हैं वो और ज्यादा कंफ्यूज हो जाते"
    },
    {
      "subtitle_id": 55,
      "start": 111.159,
      "end": 115.28,
      "text": "हैं पर अगर आप इस वीडियो को पूरा देखेंगे"
    },
    {
      "subtitle_id": 56,
      "start": 113.079,
      "end": 117.759,
      "text": "तो मैं आपको गारंटी दे सकता हूं कि आपकी"
    },
    {
      "subtitle_id": 57,
      "start": 115.28,
      "end": 119.399,
      "text": "सारी कंफ्यूजन आज दूर होने वाली है तो"
    },
    {
      "subtitle_id": 58,
      "start": 117.759,
      "end": 120.84,
      "text": "आपको आसानी से समझ में आए इसलिए मैं इस"
    },
    {
      "subtitle_id": 59,
      "start": 119.399,
      "end": 122.52,
      "text": "वीडियो को तीन पार्ट्स में डिवाइड करता"
    },
    {
      "subtitle_id": 60,
      "start": 120.84,
      "end": 124.719,
      "text": "हूं पहले पार्ट में हम बात करेंगे पांच"
    },
    {
      "subtitle_id": 61,
      "start": 122.52,
      "end": 126.52,
      "text": "पैरामीटर्स की जिनकी मदद से आप आसानी से"
    },
    {
      "subtitle_id": 62,
      "start": 124.719,
      "end": 128.52,
      "text": "बेस्ट हेल्थ इंश्योरेंस कंपनीज चुन सकते"
    },
    {
      "subtitle_id": 63,
      "start": 126.52,
      "end": 130.72,
      "text": "हो फिर दूसरे पार्ट में हम बात करेंगे नौ"
    },
    {
      "subtitle_id": 64,
      "start": 128.52,
      "end": 132.72,
      "text": "ऐसे पैरामीटर्स की जो आपको बेस्ट हेल्थ"
    },
    {
      "subtitle_id": 65,
      "start": 130.72,
      "end": 134.68,
      "text": "इंश्योरेंस प्लान चुनने में मदद करेगा और"
    },
    {
      "subtitle_id": 66,
      "start": 132.72,
      "end": 136.68,
      "text": "इस वीडियो के आखरी यानी तीसरे पार्ट में"
    },
    {
      "subtitle_id": 67,
      "start": 134.68,
      "end": 138.28,
      "text": "मैं आपको मेरे जो पर्सनल तीन बेस्ट कंपनीज"
    },
    {
      "subtitle_id": 68,
      "start": 136.68,
      "end": 140.28,
      "text": "हैं और उनके जो बेस्ट प्लांस हैं उनके"
    },
    {
      "subtitle_id": 69,
      "start": 138.28,
      "end": 142.599,
      "text": "बारे में बताऊंगा व्हिच विल बी बैक्ड बाय"
    },
    {
      "subtitle_id": 70,
      "start": 140.28,
      "end": 144.72,
      "text": "डाटा एंड फैक्ट्स तो हेल्थ इंश्योरेंस"
    },
    {
      "subtitle_id": 71,
      "start": 142.599,
      "end": 147.4,
      "text": "रिलेटेड अपनी सारी कंफ्यूजन दूर करने के"
    },
    {
      "subtitle_id": 72,
      "start": 144.72,
      "end": 148.879,
      "text": "लिए यह वीडियो आखिर तक जरूर देखिए नमस्कार"
    },
    {
      "subtitle_id": 73,
      "start": 147.4,
      "end": 150.879,
      "text": "मैं प्रसाद आपका आज के इस वीडियो में"
    },
    {
      "subtitle_id": 74,
      "start": 148.879,
      "end": 152.879,
      "text": "स्वागत करता हूं तो शुरुआत करते हैं पहले"
    },
    {
      "subtitle_id": 75,
      "start": 150.879,
      "end": 154.68,
      "text": "पार्ट से अगर मैं बेस्ट कंपनीज को सिलेक्ट"
    },
    {
      "subtitle_id": 76,
      "start": 152.879,
      "end": 157.319,
      "text": "करने के पैरामीटर्स की बात करूं तो सबसे"
    },
    {
      "subtitle_id": 77,
      "start": 154.68,
      "end": 159.08,
      "text": "पहले आपको देखना है क्लेम सेटलमेंट रेशो"
    },
    {
      "subtitle_id": 78,
      "start": 157.319,
      "end": 161.8,
      "text": "क्लेम सेटलमेंट रेशो का मतलब है कि 100"
    },
    {
      "subtitle_id": 79,
      "start": 159.08,
      "end": 163.8,
      "text": "में से कितने क्लेम्म ने पास किए हैं यह"
    },
    {
      "subtitle_id": 80,
      "start": 161.8,
      "end": 165.36,
      "text": "फिगर जितनी ज्यादा उतनी बढ़िया जब भी आप"
    },
    {
      "subtitle_id": 81,
      "start": 163.8,
      "end": 167.28,
      "text": "हेल्थ इंश्योरेंस लेते हो तो आप यही सोच"
    },
    {
      "subtitle_id": 82,
      "start": 165.36,
      "end": 169.599,
      "text": "कर लेते हैं कि जब भी मैं बीमार पडू या"
    },
    {
      "subtitle_id": 83,
      "start": 167.28,
      "end": 171.879,
      "text": "फिर हॉस्पिटलाइज रहूंगा तब कंपनी मेरा"
    },
    {
      "subtitle_id": 84,
      "start": 169.599,
      "end": 173.879,
      "text": "पैसा पे करे लेकिन अगर क्लेम सेटलमेंट"
    },
    {
      "subtitle_id": 85,
      "start": 171.879,
      "end": 175.76,
      "text": "रेशो कम है ज्यादा क्लम्स पास ही नहीं हो"
    },
    {
      "subtitle_id": 86,
      "start": 173.879,
      "end": 177.319,
      "text": "रहे हैं तो फिर क्या फायदा क्लेम सेटलमेंट"
    },
    {
      "subtitle_id": 87,
      "start": 175.76,
      "end": 179.239,
      "text": "रेशो पर आपको ध्यान देना चाहिए बिफोर"
    },
    {
      "subtitle_id": 88,
      "start": 177.319,
      "end": 181.28,
      "text": "बाइंग एनी हेल्थ इंश्योरेंस अगर मैं क्लेम"
    },
    {
      "subtitle_id": 89,
      "start": 179.239,
      "end": 183.4,
      "text": "सेटलमेंट रेशो और लास्ट 3 साल के डाटा की"
    },
    {
      "subtitle_id": 90,
      "start": 181.28,
      "end": 187.599,
      "text": "बात करूं तो इंडिया एश्योरेंस का हाईएस्ट"
    },
    {
      "subtitle_id": 91,
      "start": 183.4,
      "end": 187.599,
      "text": "है विथ 99 पर उसके बाद आता है"
    },
    {
      "subtitle_id": 92,
      "start": 192.27,
      "end": 195.339,
      "text": "[संगीत]"
    },
    {
      "subtitle_id": 93,
      "start": 209.799,
      "end": 213.28,
      "text": "आप उनकी वेबसाइट पर जाकर फॉर्म फिल करते"
    },
    {
      "subtitle_id": 94,
      "start": 211.36,
      "end": 215.239,
      "text": "हैं नंबर डालते हैं तो आपको स्पैम कॉल"
    },
