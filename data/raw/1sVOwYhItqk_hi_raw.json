  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.16,
      "end": 3.879,
      "text": "इमेजिन कीजिए आप एक रेस्टोरेंट में जाते"
    },
    {
      "subtitle_id": 2,
      "start": 2.0,
      "end": 6.359,
      "text": "हैं जहां पर जो चेयर होती है उस पर दाग"
    },
    {
      "subtitle_id": 3,
      "start": 3.879,
      "end": 8.36,
      "text": "लगे हुए होते हैं आप टेबल की ओर देखते हैं"
    },
    {
      "subtitle_id": 4,
      "start": 6.359,
      "end": 9.92,
      "text": "तो उसमें काफी गंदगी होती है आप एक नजर"
    },
    {
      "subtitle_id": 5,
      "start": 8.36,
      "end": 12.519,
      "text": "रेस्टोरेंट की तरफ डालते हो तो पता चलता"
    },
    {
      "subtitle_id": 6,
      "start": 9.92,
      "end": 14.36,
      "text": "है कि ऊपर से जो छत है वो भी टूटी हुई है"
    },
    {
      "subtitle_id": 7,
      "start": 12.519,
      "end": 16.279,
      "text": "लेकिन क्या है कि आसपास कोई रेस्टोरेंट का"
    },
    {
      "subtitle_id": 8,
      "start": 14.36,
      "end": 18.8,
      "text": "ऑप्शन होता नहीं है और आपको भूख बहुत"
    },
    {
      "subtitle_id": 9,
      "start": 16.279,
      "end": 21.439,
      "text": "ज्यादा लगी होती है इसलिए आप क्या करते हो"
    },
    {
      "subtitle_id": 10,
      "start": 18.8,
      "end": 23.439,
      "text": "एक प्लेट इडली मंगा लेते हो इडली आपके पास"
    },
    {
      "subtitle_id": 11,
      "start": 21.439,
      "end": 25.64,
      "text": "आ जाती है आप देखते हो तो इडली भी बिल्कुल"
    },
    {
      "subtitle_id": 12,
      "start": 23.439,
      "end": 27.32,
      "text": "भी टेस्टी नहीं होती है और सबसे शॉकिंग"
    },
    {
      "subtitle_id": 13,
      "start": 25.64,
      "end": 29.759,
      "text": "बात तो ये होती है कि जब बाद में बिल आता"
    },
    {
      "subtitle_id": 14,
      "start": 27.32,
      "end": 33.92,
      "text": "है तो बिल आता है ₹ का एक प्लेट इडली का"
    },
    {
      "subtitle_id": 15,
      "start": 29.759,
      "end": 35.64,
      "text": "भी ₹ यानी एक इडली 000 की अब आपको आता है"
    },
    {
      "subtitle_id": 16,
      "start": 33.92,
      "end": 37.48,
      "text": "गुस्सा आप सीधे काउंटर पर जाते और बहस"
    },
    {
      "subtitle_id": 17,
      "start": 35.64,
      "end": 40.12,
      "text": "करने लगते हो लेकिन सामने वाला व्यक्ति"
    },
    {
      "subtitle_id": 18,
      "start": 37.48,
      "end": 42.44,
      "text": "कहता है कि मेरा भाई एसपी है अगर आप बिल"
    },
    {
      "subtitle_id": 19,
      "start": 40.12,
      "end": 44.879,
      "text": "पे नहीं करेंगे तो आपको सीधा जेल भिजवा"
    },
    {
      "subtitle_id": 20,
      "start": 42.44,
      "end": 46.76,
      "text": "दूंगा इसलिए डर के मारे आप बिल पे कर देते"
    },
    {
      "subtitle_id": 21,
      "start": 44.879,
      "end": 48.6,
      "text": "हैं लेकिन रेस्टोरेंट के बाहर आने के बाद"
    },
    {
      "subtitle_id": 22,
      "start": 46.76,
      "end": 50.68,
      "text": "एक चीज तो आपको पता चल जाती है कि आपके"
    },
    {
      "subtitle_id": 23,
      "start": 48.6,
      "end": 53.16,
      "text": "साथ बहुत गलत हुआ है क्योंकि रेस्टोरेंट"
    },
    {
      "subtitle_id": 24,
      "start": 50.68,
      "end": 55.28,
      "text": "था वन स्टार वाला और बिल था फाइव स्टार"
    },
    {
      "subtitle_id": 25,
      "start": 53.16,
      "end": 57.399,
      "text": "वाला और कुछ रिसेंट रिपोर्ट्स और न्यूज़"
    },
    {
      "subtitle_id": 26,
      "start": 55.28,
      "end": 58.92,
      "text": "आप पढ़ेंगे तो ऐसा पता चलता है कि काफी"
    },
    {
      "subtitle_id": 27,
      "start": 57.399,
      "end": 61.28,
      "text": "सारे इंडियंस के मन में इस तरह की जो"
    },
    {
      "subtitle_id": 28,
      "start": 58.92,
      "end": 62.879,
      "text": "फीलिंग है वो आ रही है इसीलिए आजकल इस तरह"
    },
    {
      "subtitle_id": 29,
      "start": 61.28,
      "end": 64.879,
      "text": "के कमेंट्स काफी ज्यादा वायरल हो रहे हैं"
    },
    {
      "subtitle_id": 30,
      "start": 62.879,
      "end": 67.2,
      "text": "कि टैक्स लाइक यूरोप एंड सर्विसेस लाइक"
    },
    {
      "subtitle_id": 31,
      "start": 64.879,
      "end": 68.84,
      "text": "युगांडा और ऐसे कमेंट्स के साथ-साथ ऐसी"
    },
    {
      "subtitle_id": 32,
      "start": 67.2,
      "end": 70.52,
      "text": "न्यूज़ भी वायरल हो रही है जहां पर यह बात"
    },
    {
      "subtitle_id": 33,
      "start": 68.84,
      "end": 72.88,
      "text": "हो रही है कि रिच इंडियंस आर लिविंग"
    },
    {
      "subtitle_id": 34,
      "start": 70.52,
      "end": 75.04,
      "text": "इंडिया इन न्यूज़ के पीछे एक रिपोर्ट है"
    },
    {
      "subtitle_id": 35,
      "start": 72.88,
      "end": 77.439,
      "text": "जिसका नाम है नली एंड पार्टनर्स इस"
    },
    {
      "subtitle_id": 36,
      "start": 75.04,
      "end": 79.4,
      "text": "रिपोर्ट की माने तो पिछले साल 4500 मिलि"
    },
    {
      "subtitle_id": 37,
      "start": 77.439,
      "end": 81.6,
      "text": "नियर्स ने इंडिया छोड़ दिया है और इस साल"
    },
    {
      "subtitle_id": 38,
      "start": 79.4,
      "end": 83.479,
      "text": "भी 4300 मिलियन यर्स इंडिया छोड़ने की"
    },
    {
      "subtitle_id": 39,
      "start": 81.6,
      "end": 85.72,
      "text": "प्लानिंग कर रहे हैं इस रिपोर्ट के बाद"
    },
    {
      "subtitle_id": 40,
      "start": 83.479,
      "end": 88.2,
      "text": "इंटरनेट पर हर जगह यही चर्चा होने लगी कि"
    },
    {
      "subtitle_id": 41,
      "start": 85.72,
      "end": 89.6,
      "text": "आखिर क्या कारण हो सकते हैं उसी में काफी"
    },
    {
      "subtitle_id": 42,
      "start": 88.2,
      "end": 92.04,
      "text": "सारे लोग यह कहने लगे कि इंडिया में"
    },
    {
      "subtitle_id": 43,
      "start": 89.6,
      "end": 93.64,
      "text": "ज्यादा टैक्सेस है इसलिए हो रहा है लेकिन"
    },
    {
      "subtitle_id": 44,
      "start": 92.04,
      "end": 96.04,
      "text": "जब हमने इस पर रिसर्च शुरू की तो हमें"
    },
    {
      "subtitle_id": 45,
      "start": 93.64,
      "end": 97.84,
      "text": "काफी शॉकिंग चीजें पता चली और जो नंबर वन"
    },
    {
      "subtitle_id": 46,
      "start": 96.04,
      "end": 100.88,
      "text": "चीज जिसकी वजह से रिच इंडियंस इंडिया छोड़"
    },
    {
      "subtitle_id": 47,
      "start": 97.84,
      "end": 103.2,
      "text": "के जा रहे हैं वो टैक्स नहीं है हां टैक्स"
    },
    {
      "subtitle_id": 48,
      "start": 100.88,
      "end": 105.479,
      "text": "एक बड़ा कारण है लेकिन पहला कारण टैक्स"
    },
    {
      "subtitle_id": 49,
      "start": 103.2,
      "end": 107.56,
      "text": "नहीं है तो जो पहला कारण है और बाकी सारे"
    },
    {
      "subtitle_id": 50,
      "start": 105.479,
      "end": 109.399,
      "text": "कारण है उनकी इस वीडियो में हम बात करेंगे"
    },
    {
      "subtitle_id": 51,
      "start": 107.56,
      "end": 112.0,
      "text": "जो पहला कारण है वो सबके लिए बहुत शॉकिंग"
    },
    {
      "subtitle_id": 52,
      "start": 109.399,
      "end": 114.719,
      "text": "होने वाला है क्योंकि यह काफी किसी ने"
    },
    {
      "subtitle_id": 53,
      "start": 112.0,
      "end": 116.719,
      "text": "सोचा नहीं था कि यह चीज काफी भारी पड़"
    },
    {
      "subtitle_id": 54,
      "start": 114.719,
      "end": 118.28,
      "text": "सकती है इंडिया को और जो बाकी कारण है"
    },
    {
      "subtitle_id": 55,
      "start": 116.719,
      "end": 120.56,
      "text": "उन्हें भी आज हम विस्तार में एग्जांपल्स"
    },
    {
      "subtitle_id": 56,
      "start": 118.28,
      "end": 122.439,
      "text": "के साथ समझेंगे और ये जो अपॉर्चुनिटी है"
    },
    {
      "subtitle_id": 57,
      "start": 120.56,
      "end": 124.24,
      "text": "इंडिया जो प्रॉब्लम क्रिएट कर रही है उसकी"
    },
    {
      "subtitle_id": 58,
      "start": 122.439,
      "end": 126.439,
      "text": "वजह से किन-किन कंट्रीज को फायदा हो रहा"
    },
    {
      "subtitle_id": 59,
      "start": 124.24,
      "end": 128.399,
      "text": "है उनकी भी आज हम डिटेल में बात करेंगे"
    },
    {
      "subtitle_id": 60,
      "start": 126.439,
      "end": 131.76,
      "text": "नमस्कार मैं प्रसाद आपका आज के इस वीडियो"
    },
    {
      "subtitle_id": 61,
      "start": 128.399,
      "end": 133.68,
      "text": "में स्वागत करता हूं 1 फेब्रुअरी 2022 को"
    },
    {
      "subtitle_id": 62,
      "start": 131.76,
      "end": 135.8,
      "text": "फाइनेंस मिनिस्टर इंडिया के सामने आती है"
    },
    {
      "subtitle_id": 63,
      "start": 133.68,
      "end": 137.44,
      "text": "और ऐलान करती है कि अब से क्रिप्टो करेंसी"
    },
    {
      "subtitle_id": 64,
      "start": 135.8,
      "end": 139.92,
      "text": "से बनने वाले प्रॉफिट कंसीडर होगा"
    },
    {
      "subtitle_id": 65,
      "start": 137.44,
      "end": 141.879,
      "text": "स्पेक्युलेटिव इनकम में उस पर लगेगा 30 पर"
    },
    {
      "subtitle_id": 66,
      "start": 139.92,
      "end": 143.56,
      "text": "का टैक्स और टीडीएस अलग से और उसके बाद"
    },
    {
      "subtitle_id": 67,
      "start": 141.879,
      "end": 145.44,
      "text": "इंडिया की जो क्रिप्टो करेंसी कंपनीज हैं"
    },
    {
      "subtitle_id": 68,
      "start": 143.56,
      "end": 147.48,
      "text": "उनमें होते हैं ले ऑफस आप स्क्रीन पर देख"
    },
    {
      "subtitle_id": 69,
      "start": 145.44,
      "end": 149.959,
      "text": "सकते हैं कि वजर एकस ने 40 पर वर्क फोर्स"
    },
    {
      "subtitle_id": 70,
      "start": 147.48,
      "end": 152.16,
      "text": "को ले ऑफ कर दिया अब उसके बाद जो हुआ उससे"
    },
    {
      "subtitle_id": 71,
      "start": 149.959,
      "end": 154.44,
      "text": "आप यह समझ पाएंगे कि हमारा देश और बाकी"
    },
    {
      "subtitle_id": 72,
      "start": 152.16,
      "end": 157.239,
      "text": "देशों में क्या अंतर है इसके अगले ही"
    },
    {
      "subtitle_id": 73,
      "start": 154.44,
      "end": 159.64,
      "text": "महीने यानी मार्च 2022 में यूएई काफी अलग"
    },
    {
      "subtitle_id": 74,
      "start": 157.239,
      "end": 161.36,
      "text": "काम कर दी वो यूएई वर्चुअल रेगुलेटरी"
    },
    {
      "subtitle_id": 75,
      "start": 159.64,
      "end": 163.64,
      "text": "अथॉरिटी नाम से एक इंडिपेंडेंट रेगुलेटरी"
    },
    {
      "subtitle_id": 76,
      "start": 161.36,
      "end": 165.76,
      "text": "बॉडी की स्थापना करती है और रेगुलेटरी"
    },
    {
      "subtitle_id": 77,
      "start": 163.64,
      "end": 167.72,
      "text": "बॉडी क्या करती है यह रेगुलेटरी बॉडी यूएई"
    },
    {
      "subtitle_id": 78,
      "start": 165.76,
      "end": 169.8,
      "text": "में क्रिप्टो करेंसीज कंपनीज को दुनिया भर"
    },
    {
      "subtitle_id": 79,
      "start": 167.72,
      "end": 171.239,
      "text": "के टैक्स इंसेंटिव्स देती है और दुनिया की"
    },
    {
      "subtitle_id": 80,
      "start": 169.8,
      "end": 173.239,
      "text": "सारी क्रिप्टो कंपनीज को अपने हेड"
    },
    {
      "subtitle_id": 81,
      "start": 171.239,
      "end": 175.4,
      "text": "क्वार्टर्स यूएई में खोलने का आमंत्रण"
    },
    {
      "subtitle_id": 82,
      "start": 173.239,
      "end": 177.68,
      "text": "देती है और ऐसा पहली बार नहीं है ऐसे"
    },
    {
      "subtitle_id": 83,
      "start": 175.4,
      "end": 179.44,
      "text": "आर्बिट्री डिसीजंस पहले भी लिए गए हैं अगर"
    },
    {
      "subtitle_id": 84,
      "start": 177.68,
      "end": 181.04,
      "text": "हम वेस्टर्न डेवलप कंट्रीज को भी देखें तो"
    },
    {
      "subtitle_id": 85,
      "start": 179.44,
      "end": 183.519,
      "text": "वहां पर पर भी इस तरह के टैक्सेस"
    },
    {
      "subtitle_id": 86,
      "start": 181.04,
      "end": 185.36,
      "text": "क्रिप्टोकरेंसीज पर नहीं है और इसी चीज को"
    },
    {
      "subtitle_id": 87,
      "start": 183.519,
      "end": 187.4,
      "text": "इंग्लिश भाषा में बोलते हैं रेगुलेटरी"
    },
    {
      "subtitle_id": 88,
      "start": 185.36,
      "end": 190.28,
      "text": "अनसर्टेंटी यानी कि आज शॉर्ट टर्म कैपिटल"
    },
    {
      "subtitle_id": 89,
      "start": 187.4,
      "end": 192.799,
      "text": "गेन टैक्स 15 पर है कल शायद 30 पर हो सकता"
    },
    {
      "subtitle_id": 90,
      "start": 190.28,
      "end": 194.56,
      "text": "है आज ऑप्शंस ट्रेडिंग से जो इनकम आती है"
    },
    {
      "subtitle_id": 91,
      "start": 192.799,
      "end": 196.4,
      "text": "वो बिजनेस में काउंट की जाती है कल वो"
    },
    {
      "subtitle_id": 92,
      "start": 194.56,
      "end": 198.72,
      "text": "स्पेक्युलेटिव इनकम में काउंट हो सकती है"
    },
    {
      "subtitle_id": 93,
      "start": 196.4,
      "end": 200.64,
      "text": "एंड बिजनेसेस डोंट लाइक दिस काइंड ऑफ"
    },
    {
      "subtitle_id": 94,
      "start": 198.72,
      "end": 202.239,
      "text": "अनसर्टेंटी अब वीडियो में आगे बढ़ने से"
    },
    {
      "subtitle_id": 95,
      "start": 200.64,
      "end": 204.08,
      "text": "पहले आपको बता दूं कि ये जो अनसर्टेनटीज"
    },
    {
      "subtitle_id": 96,
      "start": 202.239,
      "end": 205.92,
      "text": "होती है इनका इंपैक्ट सिर्फ बिजनेसेस या"
    },
    {
      "subtitle_id": 97,
      "start": 204.08,
      "end": 207.72,
      "text": "बिजनेस मन तक सीमित नहीं होता है"
    },
    {
      "subtitle_id": 98,
      "start": 205.92,
      "end": 209.76,
      "text": "इन्वेस्टर्स पर भी होता है जिनका पैसा इन"
    },
    {
      "subtitle_id": 99,
      "start": 207.72,
      "end": 211.519,
      "text": "बिजनेसेस में लगा हुआ होता है फिर चाहे वो"
    },
    {
      "subtitle_id": 100,
      "start": 209.76,
      "end": 213.68,
      "text": "बड़े इन्वेस्टर्स हो या आप मेरे जैसे"
    },
    {
      "subtitle_id": 101,
      "start": 211.519,
      "end": 215.519,
      "text": "रिटेल इन्वेस्टर्स हो अब शेयर मार्केट में"
    },
    {
      "subtitle_id": 102,
      "start": 213.68,
      "end": 217.36,
      "text": "इन्हीं सारी रिस्क को हमें समझना होता है"
    },
    {
      "subtitle_id": 103,
      "start": 215.519,
      "end": 219.36,
      "text": "और उसी हिसाब से कंपनी का वैल्युएशन निकाल"
    },
    {
      "subtitle_id": 104,
      "start": 217.36,
      "end": 220.799,
      "text": "के उन्हें खरीदना होता है अब इन रिस्क को"
    },
    {
      "subtitle_id": 105,
      "start": 219.36,
      "end": 222.68,
      "text": "कम करने के लिए जो बड़े और सक्सेसफुल"
    },
    {
      "subtitle_id": 106,
      "start": 220.799,
      "end": 224.64,
      "text": "इन्वेस्टर्स होते हैं वो क्या करते हैं वो"
    },
    {
      "subtitle_id": 107,
      "start": 222.68,
      "end": 226.519,
      "text": "हाई वैल्यू कंपनीज को कम से कम प्राइस में"
    },
    {
      "subtitle_id": 108,
      "start": 224.64,
      "end": 228.28,
      "text": "खरीदने की कोशिश करते हैं और इसीलिए"
    },
    {
      "subtitle_id": 109,
      "start": 226.519,
      "end": 230.439,
      "text": "फाइनेंशियल मॉडल्स बनाए जाते हैं और"
    },
    {
      "subtitle_id": 110,
      "start": 228.28,
      "end": 232.84,
      "text": "डीसीएफ मेथड की बेसिस पर कंपनी की सही"
    },
    {
      "subtitle_id": 111,
      "start": 230.439,
      "end": 234.48,
      "text": "वैल्यू निकाली जाती है और यही सारी चीजें"
    },
    {
      "subtitle_id": 112,
      "start": 232.84,
      "end": 236.159,
      "text": "हम अपने तीन महीने की फाइनेंशियल मॉडलिंग"
    },
    {
      "subtitle_id": 113,
      "start": 234.48,
      "end": 238.28,
      "text": "एंड वैल्यूएशन मेंटरशिप में सीखने वाले"
    },
    {
      "subtitle_id": 114,
      "start": 236.159,
      "end": 240.439,
      "text": "हैं यह मेंटरशिप आपको शेयर मार्केट में"
    },
    {
      "subtitle_id": 115,
      "start": 238.28,
      "end": 242.04,
      "text": "बहुत ही एडवांस लेवल पर लेकर आएगी क्योंकि"
    },
    {
      "subtitle_id": 116,
      "start": 240.439,
      "end": 244.48,
      "text": "रियल केस स्टडीज के बेसिस पर यह आपको"
    },
    {
      "subtitle_id": 117,
      "start": 242.04,
      "end": 246.84,
      "text": "बताएगी कि किसी भी कंपनी का डीसीएफ की मदद"
    },
    {
      "subtitle_id": 118,
      "start": 244.48,
      "end": 248.68,
      "text": "से रियल वैल्युएशन कैसे निकाले तो अगर आप"
    },
    {
      "subtitle_id": 119,
      "start": 246.84,
      "end": 250.439,
      "text": "भी शेयर मार्केट को लेकर बहुत सीरियस है"
    },
    {
      "subtitle_id": 120,
      "start": 248.68,
      "end": 252.28,
      "text": "और अपने वैल्युएशन और फाइनेंशियल मॉडलिंग"
    },
    {
      "subtitle_id": 121,
      "start": 250.439,
      "end": 254.599,
      "text": "गेम को ऊपर ले जाना चाहते हो तो यह"
    },
    {
      "subtitle_id": 122,
      "start": 252.28,
      "end": 256.0,
      "text": "मेंटरशिप आपके लिए है मेंटरशिप को अप्लाई"
    },
    {
      "subtitle_id": 123,
      "start": 254.599,
      "end": 258.199,
      "text": "करने की लिंक आपको नीचे डिस्क्रिप्शन और"
    },
    {
      "subtitle_id": 124,
      "start": 256.0,
      "end": 260.28,
      "text": "कमेंट बॉक्स में मिल जाएगी पहली जो बैच है"
    },
    {
      "subtitle_id": 125,
      "start": 258.199,
      "end": 262.04,
      "text": "वो सिर्फ 100 लोगों की है तो जो पहले 100"
    },
    {
      "subtitle_id": 126,
      "start": 260.28,
      "end": 264.12,
      "text": "लोग सिलेक्ट हो जाएंगे उन्हें इन मेंटरशिप"
    },
    {
      "subtitle_id": 127,
      "start": 262.04,
      "end": 266.72,
      "text": "में एंट्री मिल जाएगी चलिए अब बढ़ते हैं"
    },
    {
      "subtitle_id": 128,
      "start": 264.12,
      "end": 268.479,
      "text": "टॉपिक की तरफ और इसी वजह से बाहर के कोई"
    },
    {
      "subtitle_id": 129,
      "start": 266.72,
      "end": 270.639,
      "text": "लोग हैं तो इंडिया में बिजनेस शुरू करना"
    },
    {
      "subtitle_id": 130,
      "start": 268.479,
      "end": 272.52,
      "text": "पसंद नहीं करते हैं और काफी सारे इंडियंस"
    },
    {
      "subtitle_id": 131,
      "start": 270.639,
      "end": 274.52,
      "text": "भी आजकल बाकी कंट्रीज में अपने बिजनेसेस"
    },
    {
      "subtitle_id": 132,
      "start": 272.52,
      "end": 276.88,
      "text": "रजिस्टर कर रहे हैं और इस चीज को कहते हैं"
    },
    {
      "subtitle_id": 133,
      "start": 274.52,
      "end": 278.56,
      "text": "रेगुलेटरी आर्बिट्राज जिसमें एक कंट्री"
    },
    {
      "subtitle_id": 134,
      "start": 276.88,
      "end": 280.52,
      "text": "दूसरे कंट्री में होने वाली रेगुलेटरी"
    },
    {
      "subtitle_id": 135,
      "start": 278.56,
      "end": 282.639,
      "text": "अनसर्टेंटी का फायदा उठाने लगती है और"
    },
    {
      "subtitle_id": 136,
      "start": 280.52,
      "end": 284.44,
      "text": "दूसरी कंट्रीज की कंपनीज को इंसेंटिव देना"
    },
    {
      "subtitle_id": 137,
      "start": 282.639,
      "end": 287.32,
      "text": "शुरू कर देती है मान लेते हैं कि दो"
    },
    {
      "subtitle_id": 138,
      "start": 284.44,
      "end": 289.44,
      "text": "कंट्रीज है कंट्री ए और कंट्री बी कंट्री"
    },
    {
      "subtitle_id": 139,
      "start": 287.32,
      "end": 291.24,
      "text": "ए की फाइनेंस मिनिस्टर सबके सामने आती है"
    },
    {
      "subtitle_id": 140,
      "start": 289.44,
      "end": 295.32,
      "text": "टीवी पर और कहती है कि आज से जो कॉर्पोरेट"
    },
    {
      "subtitle_id": 141,
      "start": 291.24,
      "end": 297.479,
      "text": "टैक्स वो 15 नहीं 30 हम कर देंगे और वहीं"
    },
    {
      "subtitle_id": 142,
      "start": 295.32,
      "end": 300.16,
      "text": "पर कंट्री बी है जिसका कॉर्पोरेट टैक्स"
    },
    {
      "subtitle_id": 143,
      "start": 297.479,
      "end": 301.84,
      "text": "ऑलरेडी 15 पर था वो ये बात सुन ले"
    },
    {
      "subtitle_id": 144,
      "start": 300.16,
      "end": 305.24,
      "text": "तो वो तुरंत क्या करते हैं अपना कॉर्पोरेट"
    },
    {
      "subtitle_id": 145,
      "start": 301.84,
      "end": 307.44,
      "text": "टैक्स 15 से और 5 पर घटाकर 10 पर कर देते"
    },
    {
      "subtitle_id": 146,
      "start": 305.24,
      "end": 309.639,
      "text": "हैं तो अब क्या होगा कि ए का कॉर्पोरेट"
    },
    {
      "subtitle_id": 147,
      "start": 307.44,
      "end": 311.84,
      "text": "टैक्स फाइनल हो गया 30 पर बी का हो गया"
    },
    {
      "subtitle_id": 148,
      "start": 309.639,
      "end": 314.52,
      "text": "मात्र 10 पर जिसकी वजह से ज्यादातर"
    },
    {
      "subtitle_id": 149,
      "start": 311.84,
      "end": 316.72,
      "text": "बिजनेसेस कंट्री ए से कंट्री बी की तरफ"
    },
    {
      "subtitle_id": 150,
      "start": 314.52,
      "end": 319.0,
      "text": "जाने लग ग और इसी चीज को कहते हैं टेकिंग"
    },
    {
      "subtitle_id": 151,
      "start": 316.72,
      "end": 320.479,
      "text": "एडवांटेज ऑफ रेगुलेटरी अनसर्टेंटी एंड"
    },
    {
      "subtitle_id": 152,
      "start": 319.0,
      "end": 322.8,
      "text": "क्रिएटिंग अ वेरी हाई रेगुलेटरी"
    },
    {
      "subtitle_id": 153,
      "start": 320.479,
      "end": 324.96,
      "text": "आर्बिट्राज सो दैट सारी कंपनीज आपकी"
    },
    {
      "subtitle_id": 154,
      "start": 322.8,
      "end": 326.639,
      "text": "कंट्री में शिफ्ट हो जाए और रियल वर्ल्ड"
    },
    {
      "subtitle_id": 155,
      "start": 324.96,
      "end": 328.639,
      "text": "में इस टेक्निक का सबसे ज्यादा फायदा अगर"
    },
    {
      "subtitle_id": 156,
      "start": 326.639,
      "end": 332.479,
      "text": "किसी ने उठाया है तो आप बताइए किसने उठाया"
    },
    {
      "subtitle_id": 157,
      "start": 328.639,
      "end": 334.4,
      "text": "होगा यूएई और सिंगापुर और यही मेन कारण है"
    },
    {
      "subtitle_id": 158,
      "start": 332.479,
      "end": 336.52,
      "text": "जिसकी वजह से रिच इंडियंस इंडिया छोड़कर"
    },
    {
      "subtitle_id": 159,
      "start": 334.4,
      "end": 338.759,
      "text": "दूसरी कंट्री में जा रहे हैं अब आप कहेंगे"
    },
    {
      "subtitle_id": 160,
      "start": 336.52,
      "end": 340.52,
      "text": "यह तो कंपनीज के साथ हुआ इसका रिच इंडियन"
    },
    {
      "subtitle_id": 161,
      "start": 338.759,
      "end": 342.96,
      "text": "से क्या लेना देना लेकिन आप एक बात को"
    },
    {
      "subtitle_id": 162,
      "start": 340.52,
      "end": 345.08,
      "text": "समझिए कि क्रिप्टो पर लिए गए एक्शन की मदद"
    },
    {
      "subtitle_id": 163,
      "start": 342.96,
      "end": 347.08,
      "text": "से जो क्रिप्टो एक्सपर्ट्स थे जो ब्लॉकचेन"
    },
    {
      "subtitle_id": 164,
      "start": 345.08,
      "end": 348.8,
      "text": "में एक्सपर्ट्स थे उन लोगों का टैलेंट भी"
    },
    {
      "subtitle_id": 165,
      "start": 347.08,
      "end": 351.08,
      "text": "दूसरी कंट्री में चला गया क्योंकि उस तरह"
    },
    {
      "subtitle_id": 166,
      "start": 348.8,
      "end": 352.639,
      "text": "की कंपनीज अब दुबई चली गई और इसी के साथ"
    },
    {
      "subtitle_id": 167,
      "start": 351.08,
      "end": 354.759,
      "text": "जो रिच इंडियंस है उनको एक मैसेज भी"
    },
    {
      "subtitle_id": 168,
      "start": 352.639,
      "end": 356.88,
      "text": "पहुंचा कि इंडिया में रेगुलेटरी सर्टेंटी"
    },
    {
      "subtitle_id": 169,
      "start": 354.759,
      "end": 358.8,
      "text": "नहीं है आज कई सारी मैन्युफैक्चरिंग"
    },
    {
      "subtitle_id": 170,
      "start": 356.88,
      "end": 361.12,
      "text": "कंपनीज भी इंडिया आने से पहले चार बार"
    },
    {
      "subtitle_id": 171,
      "start": 358.8,
      "end": 363.56,
      "text": "सोचती है इस इसी चीज की वजह से जिसका नाम"
    },
    {
      "subtitle_id": 172,
      "start": 361.12,
      "end": 365.039,
      "text": "है रेगुलेटरी सर्टेंटी आज कई सारी कंट्रीज"
    },
    {
      "subtitle_id": 173,
      "start": 363.56,
      "end": 366.72,
      "text": "चाइना में मैन्युफैक्चर नहीं करना चाहती"
    },
    {
      "subtitle_id": 174,
      "start": 365.039,
      "end": 368.72,
      "text": "इसलिए अल्टरनेट ऑप्शन ढूंढ रहे हैं जिसमें"
    },
    {
      "subtitle_id": 175,
      "start": 366.72,
      "end": 370.639,
      "text": "वियतनाम को काफी प्रेफरेंस मिल रहा है"
    },
    {
      "subtitle_id": 176,
      "start": 368.72,
      "end": 372.4,
      "text": "लेकिन इंडिया की बात करें तो कंट्रीज चार"
    },
    {
      "subtitle_id": 177,
      "start": 370.639,
      "end": 375.12,
      "text": "बार सोचती है क्योंकि यहां पर रेगुलेटरी"
    },
    {
      "subtitle_id": 178,
      "start": 372.4,
      "end": 377.319,
      "text": "अनसर्टेंटी का एक इशू तो है और इसी चीज का"
    },
    {
      "subtitle_id": 179,
      "start": 375.12,
      "end": 379.199,
      "text": "फायदा फिर सिंगापुर जैसी कंट्रीज लेती है"
    },
    {
      "subtitle_id": 180,
      "start": 377.319,
      "end": 380.72,
      "text": "और एक आर्बिट्राज क्रिएट कर देती है कि"
    },
    {
      "subtitle_id": 181,
      "start": 379.199,
      "end": 382.88,
      "text": "इंडियन कंपनीज इन देशों में जाकर"
    },
    {
      "subtitle_id": 182,
      "start": 380.72,
      "end": 385.08,
      "text": "रजिस्टर्ड होने लगती है अब ये बात हो गई"
    },
    {
      "subtitle_id": 183,
      "start": 382.88,
      "end": 387.8,
      "text": "रेगुलेटरी अनसर्टेंटी की अब बात करते हैं"
    },
    {
      "subtitle_id": 184,
      "start": 385.08,
      "end": 389.88,
      "text": "टैक्सेस की एक सवाल आपसे पूछता हूं बड़ा"
    },
    {
      "subtitle_id": 185,
      "start": 387.8,
      "end": 391.8,
      "text": "ही आसान सवाल है देखते हैं आप में से"
    },
    {
      "subtitle_id": 186,
      "start": 389.88,
      "end": 393.56,
      "text": "कितने लोग इसका जवाब दे पाएंगे देखिए"
    },
    {
      "subtitle_id": 187,
      "start": 391.8,
      "end": 396.319,
      "text": "स्क्रीन पर आप देख सकते हैं तीन कंट्रीज"
    },
    {
      "subtitle_id": 188,
      "start": 393.56,
      "end": 397.919,
      "text": "हैं तीन में से आपको एक चूज करनी है अब आप"
    },
    {
      "subtitle_id": 189,
      "start": 396.319,
      "end": 401.199,
      "text": "मुझे बताइए कि आप कौन सी कंट्री में"
    },
    {
      "subtitle_id": 190,
      "start": 397.919,
      "end": 403.68,
      "text": "रहेंगे आप अपना टाइम ले सकते हैं ओके चलिए"
    },
    {
      "subtitle_id": 191,
      "start": 401.199,
      "end": 406.319,
      "text": "अब बताइए अब आप में से काफी सारे लोग"
    },
    {
      "subtitle_id": 192,
      "start": 403.68,
      "end": 408.199,
      "text": "कहेंगे कंट्री बी या फिर कंट्री सी"
    },
    {
      "subtitle_id": 193,
      "start": 406.319,
      "end": 410.36,
      "text": "क्योंकि उन दोनों कंट्रीज में कैपिटल गेन"
    },
    {
      "subtitle_id": 194,
      "start": 408.199,
      "end": 412.72,
      "text": "टैक्स और डिविडेंड टैक्स जीरो है और"
    },
    {
      "subtitle_id": 195,
      "start": 410.36,
      "end": 415.52,
      "text": "कंट्री बी में तो इनकम टैक्स भी जीरो है"
    },
    {
      "subtitle_id": 196,
      "start": 412.72,
      "end": 418.039,
      "text": "क्या आप में से किसी ने कंट्री ए चुनी तो"
    },
    {
      "subtitle_id": 197,
      "start": 415.52,
      "end": 420.319,
      "text": "हाई प्रोबेबिलिटी है कि नहीं तो चलिए आपको"
    },
    {
      "subtitle_id": 198,
      "start": 418.039,
      "end": 423.08,
      "text": "रियल टाइम सिनेरियो बताता हूं कंट्री ए है"
    },
    {
      "subtitle_id": 199,
      "start": 420.319,
      "end": 425.8,
      "text": "इंडिया कंट्री बी है यूएई और कंट्री सी है"
    },
    {
      "subtitle_id": 200,
      "start": 423.08,
      "end": 428.0,
      "text": "सिंगापुर चौक गए तो यही रीजन है कि पिछले"
    },
    {
      "subtitle_id": 201,
      "start": 425.8,
      "end": 432.12,
      "text": "20 सालों में सिंगापुर में 8000 से ज्यादा"
    },
    {
      "subtitle_id": 202,
      "start": 428.0,
      "end": 432.12,
      "text": "इंडियन कंपनीज रजिस्टर्ड हुई है"
    },
    {
      "subtitle_id": 203,
      "start": 449.479,
      "end": 452.479,
      "text": "स्टार्ट किया हालांकि अब फोन पे अपना"
    },
    {
      "subtitle_id": 204,
      "start": 451.0,
      "end": 454.479,
      "text": "आईपीओ लाना चाहता है इसलिए उन्होंने"
    },
    {
      "subtitle_id": 205,
      "start": 452.479,
      "end": 456.879,
      "text": "रिसेंटली सिंगापुर वाली जो अपनी पैरेंट"
    },
    {
      "subtitle_id": 206,
      "start": 454.479,
      "end": 459.12,
      "text": "कंपनी है उसे इंडिया में शिफ्ट किया है और"
    },
    {
      "subtitle_id": 207,
      "start": 456.879,
      "end": 461.08,
      "text": "यूएई के बारे में तो डेटा बहुत शॉकिंग है"
    },
    {
      "subtitle_id": 208,
      "start": 459.12,
      "end": 463.44,
      "text": "लास्ट ईयर जितने भी रियल स्टेट बायर्स"
    },
    {
      "subtitle_id": 209,
      "start": 461.08,
      "end": 465.56,
      "text": "वहां पर है उसमें से 40 पर बायर्स इंडियंस"
    },
    {
      "subtitle_id": 210,
      "start": 463.44,
      "end": 467.24,
      "text": "है और इसे टैक्स डिफरेंस की वजह से कई"
    },
    {
      "subtitle_id": 211,
      "start": 465.56,
      "end": 469.8,
      "text": "सारे जो इंडियंस हैं उनका एक मोटो बन गया"
    },
    {
      "subtitle_id": 212,
      "start": 467.24,
      "end": 472.0,
      "text": "है और वो मोटो यह है कि अर्न इन इंडिया बट"
    },
    {
      "subtitle_id": 213,
      "start": 469.8,
      "end": 473.639,
      "text": "लीव आउटसाइड ऑफ इंडिया आप में से कुछ"
    },
    {
      "subtitle_id": 214,
      "start": 472.0,
      "end": 475.44,
      "text": "लोगों को शायद पता होगा लेकिन ज्यादातर"
    },
    {
      "subtitle_id": 215,
      "start": 473.639,
      "end": 477.0,
      "text": "लोगों को आज भी यह नहीं पता है कि वेदांता"
    },
    {
      "subtitle_id": 216,
      "start": 475.44,
      "end": 479.96,
      "text": "ग्रुप के जो प्रमोटर हैं अनिल अगरवाल वो"
    },
    {
      "subtitle_id": 217,
      "start": 477.0,
      "end": 481.52,
      "text": "लंदन में रहते हैं यही नहीं कृष्ण कुमार र"
    },
    {
      "subtitle_id": 218,
      "start": 479.96,
      "end": 483.56,
      "text": "जो ग्रेफाइट इंडिया के चेयरमैन है वो"
    },
    {
      "subtitle_id": 219,
      "start": 481.52,
      "end": 485.24,
      "text": "सिंगापुर में रहते हैं इसके अलावा आयशर"
    },
    {
      "subtitle_id": 220,
      "start": 483.56,
      "end": 487.039,
      "text": "मोटर के एमडीएन सीईओ लंदन में रहते हैं"
    },
    {
      "subtitle_id": 221,
      "start": 485.24,
      "end": 489.0,
      "text": "अपोलो टायर्स के एमडी एंड वाइस चेयरमैन भी"
    },
    {
      "subtitle_id": 222,
      "start": 487.039,
      "end": 490.72,
      "text": "लंडन में रहते हैं और कई सारे इंडियन"
    },
    {
      "subtitle_id": 223,
      "start": 489.0,
      "end": 493.24,
      "text": "स्टार्टअप्स हैं इंक्लूडिंग पॉलिसी बाजार"
    },
    {
      "subtitle_id": 224,
      "start": 490.72,
      "end": 495.08,
      "text": "जिनके फाउंडर्स आज दुबई में रहते हैं इसके"
    },
    {
      "subtitle_id": 225,
      "start": 493.24,
      "end": 497.319,
      "text": "अलावा जितने भी क्रिप्टोकरेंसीज कंपनीज"
    },
    {
      "subtitle_id": 226,
      "start": 495.08,
      "end": 499.319,
      "text": "हैं लगभग उन सब कंपनीज के फाउंडर्स आज"
    },
    {
      "subtitle_id": 227,
      "start": 497.319,
      "end": 500.759,
      "text": "दुबई में रहते हैं मतलब फंडा सिंपल है"
    },
    {
      "subtitle_id": 228,
      "start": 499.319,
      "end": 503.08,
      "text": "बिजनेस इंडिया में है पैसा इंडिया से"
    },
    {
      "subtitle_id": 229,
      "start": 500.759,
      "end": 505.039,
      "text": "कमाना है लेकिन रहना बाहर है अब ये हो गए"
    },
    {
      "subtitle_id": 230,
      "start": 503.08,
      "end": 506.639,
      "text": "रेगुलेशन और टैक्सेस की बातें इसके अलावा"
    },
    {
      "subtitle_id": 231,
      "start": 505.039,
      "end": 509.08,
      "text": "और भी दो रीजंस है जिसकी वजह से रिच"
    },
    {
      "subtitle_id": 232,
      "start": 506.639,
      "end": 511.56,
      "text": "इंडियंस और काफी सारे लोग इंडिया छोड़ रहे"
    },
    {
      "subtitle_id": 233,
      "start": 509.08,
      "end": 514.039,
      "text": "हैं अगला कारण है गोल्डन वीजा कई सारी"
    },
    {
      "subtitle_id": 234,
      "start": 511.56,
      "end": 516.159,
      "text": "कंट्रीज हैं जो आपको पैसे लेकर जो आपको"
    },
    {
      "subtitle_id": 235,
      "start": 514.039,
      "end": 518.519,
      "text": "रेसिडेंसी परमिट्स या सिटीजनशिप दे देते"
    },
    {
      "subtitle_id": 236,
      "start": 516.159,
      "end": 521.039,
      "text": "हैं मतलब सिंपल है पैसा दो और सिटीजनशिप"
    },
    {
      "subtitle_id": 237,
      "start": 518.519,
      "end": 523.12,
      "text": "लो इसका मतलब यह है कि जिनके पास पैसा है"
    },
    {
      "subtitle_id": 238,
      "start": 521.039,
      "end": 524.64,
      "text": "उनके पास ऑप्शंस भी काफी सारे हैं और ऐसा"
    },
    {
      "subtitle_id": 239,
      "start": 523.12,
      "end": 527.04,
      "text": "नहीं कि सिर्फ छोटी-मोटी कंट्रीज ऐसा कर"
    },
    {
      "subtitle_id": 240,
      "start": 524.64,
      "end": 530.16,
      "text": "रही है कई सारी बड़ी-बड़ी कंट्रीज जैसे कि"
    },
    {
      "subtitle_id": 241,
      "start": 527.04,
      "end": 533.04,
      "text": "ऑस्ट्रेलिया यूएसए कनाडा और बाकी कंट्रीज"
    },
    {
      "subtitle_id": 242,
      "start": 530.16,
      "end": 535.32,
      "text": "जैसे कि न्यूजीलैंड स्पेन यूएई पोर्तु यह"
    },
    {
      "subtitle_id": 243,
      "start": 533.04,
      "end": 536.68,
      "text": "सब गोल्डन वीजा देती है स्क्रीन पर आप देख"
    },
    {
      "subtitle_id": 244,
      "start": 535.32,
      "end": 538.48,
      "text": "सकते हो कि एक 2 मिलियन डॉलर का"
    },
    {
      "subtitle_id": 245,
      "start": 536.68,
      "end": 540.36,
      "text": "इन्वेस्टमेंट आप करो जिसके बदले में आपको"
    },
    {
      "subtitle_id": 246,
      "start": 538.48,
      "end": 542.48,
      "text": "सिटीजनशिप या फिर रेसिडेंसी परमिट मिल"
    },
    {
      "subtitle_id": 247,
      "start": 540.36,
      "end": 544.2,
      "text": "जाता है और इसके अलावा एक और मेन रीज़न है"
    },
    {
      "subtitle_id": 248,
      "start": 542.48,
      "end": 546.32,
      "text": "जिसकी वजह से ये लोग इंडिया छोड़ रहे हैं"
    },
    {
      "subtitle_id": 249,
      "start": 544.2,
      "end": 548.16,
      "text": "वो है क्वालिटी ऑफ लाइफ मतलब शायद इस चीज"
    },
    {
      "subtitle_id": 250,
      "start": 546.32,
      "end": 550.0,
      "text": "का पैसों से ज्यादा लेना देना ना हो लेकिन"
    },
    {
      "subtitle_id": 251,
      "start": 548.16,
      "end": 552.079,
      "text": "अगर हम अलग-अलग इंडेक्सेस देखें जैसे कि"
    },
    {
      "subtitle_id": 252,
      "start": 550.0,
      "end": 553.959,
      "text": "एनवायरमेंटल परफॉर्मेंस इंडेक्स है तो ये"
    },
    {
      "subtitle_id": 253,
      "start": 552.079,
      "end": 555.68,
      "text": "इंडेक्स वर्ल्ड इकोनॉमिक फोरम रिलीज करता"
    },
    {
      "subtitle_id": 254,
      "start": 553.959,
      "end": 557.92,
      "text": "है जो अलग-अलग देशों के लिए एनवायरमेंट"
    },
    {
      "subtitle_id": 255,
      "start": 555.68,
      "end": 560.519,
      "text": "पॉलिसीज को रैंक करती है 180 कंट्रीज में"
    },
    {
      "subtitle_id": 256,
      "start": 557.92,
      "end": 563.0,
      "text": "से इंडिया की रैंक कितनी होगी गेस कीजिए"
    },
    {
      "subtitle_id": 257,
      "start": 560.519,
      "end": 565.36,
      "text": "176 इतना ही नहीं आप स्क्रीन पर देख लीजिए"
    },
    {
      "subtitle_id": 258,
      "start": 563.0,
      "end": 568.44,
      "text": "कि क्वालिटी ऑफ लाइफ इन इंडिया 84 में से"
    },
    {
      "subtitle_id": 259,
      "start": 565.36,
      "end": 571.0,
      "text": "70th रैंक पर है हंगर इंडेक्स में 107 पर"
    },
    {
      "subtitle_id": 260,
      "start": 568.44,
      "end": 573.12,
      "text": "हैपी नेक्स इंडेक्स पर 136 और करप्शन के"
    },
    {
      "subtitle_id": 261,
      "start": 571.0,
      "end": 575.0,
      "text": "मामले में 85th यहां पर किसी को शॉक नहीं"
    },
    {
      "subtitle_id": 262,
      "start": 573.12,
      "end": 577.24,
      "text": "होना चाहिए था मुझे लगता है शायद थोड़ा और"
    },
    {
      "subtitle_id": 263,
      "start": 575.0,
      "end": 579.44,
      "text": "ऊपर भी हो सकती थी तो ये सारी रैंकिंग्स"
    },
    {
      "subtitle_id": 264,
      "start": 577.24,
      "end": 581.72,
      "text": "है अगर बड़ी रैंकिंग की बात करें तो एक"
    },
    {
      "subtitle_id": 265,
      "start": 579.44,
      "end": 583.36,
      "text": "रैंकिंग में इंडिया काफी ऊपर है तो जिन"
    },
    {
      "subtitle_id": 266,
      "start": 581.72,
      "end": 586.16,
      "text": "लोगों के नहीं पता उनके लिए आप प्लीज"
    },
    {
      "subtitle_id": 267,
      "start": 583.36,
      "end": 588.279,
      "text": "कमेंट करके बता दीजिए और थोड़े फनी वे में"
    },
    {
      "subtitle_id": 268,
      "start": 586.16,
      "end": 590.12,
      "text": "बता देंगे तो सबको इजली समझ में आ जाएगा"
    },
    {
      "subtitle_id": 269,
      "start": 588.279,
      "end": 591.839,
      "text": "क्वालिटी ऑफ लाइफ के अलावा एक और रीजन है"
    },
    {
      "subtitle_id": 270,
      "start": 590.12,
      "end": 593.92,
      "text": "जिसकी वजह से काफी सारे लोग बाहर जा रहे"
    },
    {
      "subtitle_id": 271,
      "start": 591.839,
      "end": 595.48,
      "text": "हैं वो है बच्चों का एजुकेशन आप देखेंगे"
    },
    {
      "subtitle_id": 272,
      "start": 593.92,
      "end": 596.92,
      "text": "इंडिया में कई सारे ऐसे मिनिस्टर्स हैं एक"
    },
    {
      "subtitle_id": 273,
      "start": 595.48,
      "end": 598.48,
      "text": "दो नहीं कई सारे ऐसे इसलिए मैं एक दो का"
    },
    {
      "subtitle_id": 274,
      "start": 596.92,
      "end": 600.2,
      "text": "नाम नहीं ले रहा हूं क्योंकि कई सारे हैं"
    },
    {
      "subtitle_id": 275,
      "start": 598.48,
      "end": 602.36,
      "text": "कई सारे आईएस ऑफिसर्स हैं कई सारे"
    },
    {
      "subtitle_id": 276,
      "start": 600.2,
      "end": 605.079,
      "text": "बड़े-बड़े पोस्ट पर लोग हैं जिनके बेटे और"
    },
    {
      "subtitle_id": 277,
      "start": 602.36,
      "end": 606.959,
      "text": "बेटियां आज भी पढ़ने के लिए बाहर जाती है"
    },
    {
      "subtitle_id": 278,
      "start": 605.079,
      "end": 609.68,
      "text": "यानी जो लोग एजुकेशन सिस्टम यहां पर बना"
    },
    {
      "subtitle_id": 279,
      "start": 606.959,
      "end": 611.64,
      "text": "रहे हैं उन्हें ही शायद अपने सिस्टम पर"
    },
    {
      "subtitle_id": 280,
      "start": 609.68,
      "end": 613.279,
      "text": "भरोसा नहीं और इसका इंपैक्ट ये हो रहा है"
    },
    {
      "subtitle_id": 281,
      "start": 611.64,
      "end": 614.839,
      "text": "कि कई सारे जो मिलेनियर हैं वो शुरुआत से"
    },
    {
      "subtitle_id": 282,
      "start": 613.279,
      "end": 617.0,
      "text": "अपने बच्चों को अच्छी एजुकेशन देना चाहते"
    },
    {
      "subtitle_id": 283,
      "start": 614.839,
      "end": 618.8,
      "text": "हैं तो शुरुआत में ही बाहर कंट्री में जा"
    },
    {
      "subtitle_id": 284,
      "start": 617.0,
      "end": 620.72,
      "text": "रहे हैं और एक बार वो बाहर जाते हैं तो"
    },
    {
      "subtitle_id": 285,
      "start": 618.8,
      "end": 622.6,
      "text": "पता चलता है कि इंफ्रा बेटर है उस कंट्री"
    },
    {
      "subtitle_id": 286,
      "start": 620.72,
      "end": 624.72,
      "text": "में उस कंट्री में सिविक सेंस अच्छा है"
    },
    {
      "subtitle_id": 287,
      "start": 622.6,
      "end": 626.76,
      "text": "क्लीनलीनेस अच्छी है फिर वो परमानेंटली"
    },
    {
      "subtitle_id": 288,
      "start": 624.72,
      "end": 628.36,
      "text": "वहीं पर रहने लगते हैं बेटर हेल्थ केयर"
    },
    {
      "subtitle_id": 289,
      "start": 626.76,
      "end": 630.32,
      "text": "सिस्टम भी एक रीजन है तो ऐसे बहुत सारे"
    },
    {
      "subtitle_id": 290,
      "start": 628.36,
      "end": 634.079,
      "text": "छोटे-छोटे रीजन से लेकिन मेन रीजंस चार"
    },
    {
      "subtitle_id": 291,
      "start": 630.32,
      "end": 636.36,
      "text": "हैं रेगुलेशन टैक्सेस गोल्डन वीजा और"
    },
    {
      "subtitle_id": 292,
      "start": 634.079,
      "end": 637.959,
      "text": "क्वालिटी ऑफ लाइफ और टैक्सेस की बात करें"
    },
    {
      "subtitle_id": 293,
      "start": 636.36,
      "end": 639.88,
      "text": "तो इतने सारे टैक्सेस यहां पर लगते हैं कि"
    },
    {
      "subtitle_id": 294,
      "start": 637.959,
      "end": 641.76,
      "text": "कई सारे लोग इसे फिर टैक्स टेररिज्म कहने"
    },
    {
      "subtitle_id": 295,
      "start": 639.88,
      "end": 643.2,
      "text": "लगे तो क्या आप इन टैक्सेस पर भी अगर आप"
    },
    {
      "subtitle_id": 296,
      "start": 641.76,
      "end": 645.56,
      "text": "कोई वीडियो चाहते हैं तो कमेंट करके वो"
    },
    {
      "subtitle_id": 297,
      "start": 643.2,
      "end": 647.279,
      "text": "बताइए हम उस पर भी वीडियो बना के डिटेल"
    },
    {
      "subtitle_id": 298,
      "start": 645.56,
      "end": 649.04,
      "text": "वीडियो बनाने की कोशिश करेंगे और मुझे"
    },
    {
      "subtitle_id": 299,
      "start": 647.279,
      "end": 651.16,
      "text": "लगता है कि दिस इज अ हाई टाइम कि इंडिया"
    },
    {
      "subtitle_id": 300,
      "start": 649.04,
      "end": 652.88,
      "text": "के जो सारे लोग हैं उन्हें ये चीजें"
    },
    {
      "subtitle_id": 301,
      "start": 651.16,
      "end": 654.48,
      "text": "गवर्नमेंट से एक्सपेक्ट करना शुरू कर देनी"
    },
    {
      "subtitle_id": 302,
      "start": 652.88,
      "end": 655.88,
      "text": "चाहिए कि अगर हम इतने सारे टैक्सेस पे कर"
    },
    {
      "subtitle_id": 303,
      "start": 654.48,
      "end": 658.0,
      "text": "रहे हैं तो इन चीजों की भी हम धीरे-धीरे"
    },
    {
      "subtitle_id": 304,
      "start": 655.88,
      "end": 660.36,
      "text": "डिमांड करें ऑफकोर्स काफी सारे रिफॉर्म्स"
    },
    {
      "subtitle_id": 305,
      "start": 658.0,
      "end": 662.959,
      "text": "चल रहे हैं लेकिन वो और तेजी से होने की"
    },
    {
      "subtitle_id": 306,
      "start": 660.36,
      "end": 664.76,
      "text": "जरूरत है तो जब भी इलेक्शंस होते हैं या"
    },
    {
      "subtitle_id": 307,
      "start": 662.959,
      "end": 666.72,
      "text": "फिर इलेक्शन के बाद भी इन पॉइंट्स को"
    },
    {
      "subtitle_id": 308,
      "start": 664.76,
      "end": 668.839,
      "text": "उठाना बहुत जरूरी है जब हम इन रियल"
    },
    {
      "subtitle_id": 309,
      "start": 666.72,
      "end": 670.839,
      "text": "प्रॉब्लम्स को सामने रखेंगे विदाउट हैविंग"
    },
    {
      "subtitle_id": 310,
      "start": 668.839,
      "end": 672.44,
      "text": "एनी पॉलिटिकल ओपिनियन इन योर माइंड तो"
    },
    {
      "subtitle_id": 311,
      "start": 670.839,
      "end": 674.24,
      "text": "हमें जरूरत है कि इन सारी चीजों को हमें"
    },
    {
      "subtitle_id": 312,
      "start": 672.44,
      "end": 676.6,
      "text": "प्रेजेंट करने की विदाउट हैविंग एनी"
    },
    {
      "subtitle_id": 313,
      "start": 674.24,
      "end": 678.44,
      "text": "पॉलिटिकल एजेंडा और अगर इस तरह की"
    },
    {
      "subtitle_id": 314,
      "start": 676.6,
      "end": 680.48,
      "text": "रिक्वायरमेंट सभी की होती है सभी लोग"
    },
    {
      "subtitle_id": 315,
      "start": 678.44,
      "end": 682.24,
      "text": "डेवलपमेंट्स के नाम पर वोट करने लगेंगे तो"
    },
    {
      "subtitle_id": 316,
      "start": 680.48,
      "end": 684.2,
      "text": "चीजें जरूर बदलेगी क्योंकि एक बड़ा"
    },
    {
      "subtitle_id": 317,
      "start": 682.24,
      "end": 685.8,
      "text": "प्रॉब्लम यह भी है कि आजकल डेवलपमेंट के"
    },
    {
      "subtitle_id": 318,
      "start": 684.2,
      "end": 687.839,
      "text": "नाम पर कोई वोट नहीं करता है वोट करता है"
    },
    {
      "subtitle_id": 319,
      "start": 685.8,
      "end": 689.839,
      "text": "कास्ट या बाकी चीजों के नाम पर जिसकी वजह"
    },
    {
      "subtitle_id": 320,
      "start": 687.839,
      "end": 691.68,
      "text": "से भी कई सारे पॉलिटिशियन वो डेवलपमेंट पर"
    },
    {
      "subtitle_id": 321,
      "start": 689.839,
      "end": 693.639,
      "text": "नजर नहीं देते हैं तो इन चीजों की हमें"
    },
    {
      "subtitle_id": 322,
      "start": 691.68,
      "end": 695.56,
      "text": "अपने से शुरुआत करनी चाहिए और इन चीजों की"
    },
    {
      "subtitle_id": 323,
      "start": 693.639,
      "end": 697.12,
      "text": "डिमांड भी करनी चाहिए तो जाने से पहले"
    },
    {
      "subtitle_id": 324,
      "start": 695.56,
      "end": 699.0,
      "text": "हमारे फाइनेंशियल मॉडलिंग एंड वैल्युएशन"
    },
    {
      "subtitle_id": 325,
      "start": 697.12,
      "end": 701.48,
      "text": "मेंटरशिप को जरूर अप्लाई करें लिंक नीचे"
    },
    {
      "subtitle_id": 326,
      "start": 699.0,
      "end": 703.44,
      "text": "दी गई है साथ ही आपको बता दूं कि 27 जुलाई"
    },
    {
      "subtitle_id": 327,
      "start": 701.48,
      "end": 705.2,
      "text": "को मैं गोवा जा रहा हूं जहां पर एक इवेंट"
    },
    {
      "subtitle_id": 328,
      "start": 703.44,
      "end": 707.04,
      "text": "है जिसका नाम है ट्रेडर्स ला व्हिच इज"
    },
    {
      "subtitle_id": 329,
      "start": 705.2,
      "end": 708.92,
      "text": "ऑर्गेनाइज बाय फिन ग्राइल तो वहां पर मैं"
    },
    {
      "subtitle_id": 330,
      "start": 707.04,
      "end": 710.68,
      "text": "भी एज अ स्पीकर जाने वाला हूं वहां पर मैं"
    },
    {
      "subtitle_id": 331,
      "start": 708.92,
      "end": 712.519,
      "text": "मेनली इन्वेस्टिंग की बात करने वाला हूं"
    },
    {
      "subtitle_id": 332,
      "start": 710.68,
      "end": 714.12,
      "text": "लेकिन ये जो इवेंट है ये मेनली ट्रेडर्स"
    },
    {
      "subtitle_id": 333,
      "start": 712.519,
      "end": 715.76,
      "text": "के लिए है तो अगर आप ट्रेडर हैं और इन"
    },
    {
      "subtitle_id": 334,
      "start": 714.12,
      "end": 717.12,
      "text": "चीजों में इंटरेस्ट रखते हैं तो यहां पर"
    },
    {
      "subtitle_id": 335,
      "start": 715.76,
      "end": 719.04,
      "text": "काफी सारे इंटरेस्टिंग लोगों से आपको"
    },
    {
      "subtitle_id": 336,
      "start": 717.12,
      "end": 720.88,
      "text": "मिलने मिलेगा साथ ही उनसे काफी कुछ सीखने"
    },
    {
      "subtitle_id": 337,
      "start": 719.04,
      "end": 722.56,
      "text": "मिले मिलेगा तो उसकी भी लिंक हमने नीचे"
    },
    {
      "subtitle_id": 338,
      "start": 720.88,
      "end": 724.56,
      "text": "डिस्क्रिप्शन में डाल दिए हैं तो उसे भी"
    },
    {
      "subtitle_id": 339,
      "start": 722.56,
      "end": 726.519,
      "text": "आप जरूर चेक आउट कीजिए और आज जाते-जाते ये"
    },
    {
      "subtitle_id": 340,
      "start": 724.56,
      "end": 727.92,
      "text": "बता देता हूं कि इस वीडियो का कोई एजेंडा"
    },
    {
      "subtitle_id": 341,
      "start": 726.519,
      "end": 729.72,
      "text": "नहीं है किसी के खिलाफ ये बस रियल"
    },
    {
      "subtitle_id": 342,
      "start": 727.92,
      "end": 731.76,
      "text": "प्रॉब्लम्स है जिसकी वजह से मिलियनर्स जा"
    },
    {
      "subtitle_id": 343,
      "start": 729.72,
      "end": 733.639,
      "text": "रहे हैं जो हमने अपने रिसर्च में पाया और"
    },
    {
      "subtitle_id": 344,
      "start": 731.76,
      "end": 735.32,
      "text": "वही चीजें हमने आपको बताई है तो आप भी"
    },
    {
      "subtitle_id": 345,
      "start": 733.639,
      "end": 736.839,
      "text": "अपना ओपिनियन जरूर बताइए कि इन चीजों को"
    },
    {
      "subtitle_id": 346,
      "start": 735.32,
      "end": 738.8,
      "text": "इंडिया में कैसे ला सकते हैं इंडिया में"
    },
    {
      "subtitle_id": 347,
      "start": 736.839,
      "end": 740.24,
      "text": "रह के हम इंडिया को कैसे बेटर कर सकते हैं"
    },
    {
      "subtitle_id": 348,
      "start": 738.8,
      "end": 742.199,
      "text": "तो मिलते हैं अगले वीडियो में थैंक यू सो"
    },
    {
      "subtitle_id": 349,
      "start": 740.24,
      "end": 743.76,
      "text": "मच फॉर वाचिंग दिस वीडियो अभी तक अगर आपने"
    },
    {
      "subtitle_id": 350,
      "start": 742.199,
      "end": 745.68,
      "text": "चैनल को सब्सक्राइब नहीं किया है तो इसी"
    },
    {
      "subtitle_id": 351,
      "start": 743.76,
      "end": 747.72,
      "text": "तरह के फाइनेंस से रिलेटेड वीडियोस के लिए"
    },
    {
      "subtitle_id": 352,
      "start": 745.68,
      "end": 749.32,
      "text": "चैनल को जरूर सब्सक्राइब कीजिए और फाइनेंस"
    },
    {
      "subtitle_id": 353,
      "start": 747.72,
      "end": 750.839,
      "text": "में अगर आपका सीरियस इंटरेस्ट है तो बेल"
    },
    {
      "subtitle_id": 354,
      "start": 749.32,
      "end": 752.36,
      "text": "आइकॉन पर भी जरूर क्लिक कीजिए मिलते हैं"
    },
    {
      "subtitle_id": 355,
      "start": 750.839,
      "end": 754.959,
      "text": "अगले वीडियो में थैंक यू सो मच फॉर वाचिंग"
    },
    {
      "subtitle_id": 356,
      "start": 752.36,
      "end": 754.959,
      "text": "दिस वीडियो"
    }
  ]
}