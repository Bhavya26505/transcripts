  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.12,
      "end": 3.48,
      "text": "इस वीडियो को आप में से कई सारे लोगों ने"
    },
    {
      "subtitle_id": 2,
      "start": 1.52,
      "end": 5.6,
      "text": "जरूर देखा होगा इसमें एक ब्रोकर फाइनेंस"
    },
    {
      "subtitle_id": 3,
      "start": 3.48,
      "end": 7.879,
      "text": "मिनिस्टर निर्मला सीतारमन से यह कहता है"
    },
    {
      "subtitle_id": 4,
      "start": 5.6,
      "end": 9.96,
      "text": "कि मेरे क्लाइंट्स अपनी मेहनत का पैसा"
    },
    {
      "subtitle_id": 5,
      "start": 7.879,
      "end": 12.08,
      "text": "मार्केट में इन्वेस्ट करते हैं अपनी रिस्क"
    },
    {
      "subtitle_id": 6,
      "start": 9.96,
      "end": 14.12,
      "text": "लगाते हैं जिस पर गवर्नमेंट ढेरों सारे"
    },
    {
      "subtitle_id": 7,
      "start": 12.08,
      "end": 16.359,
      "text": "टैक्सेस लगाती है स्टम ड्यूटी है एसटीटी"
    },
    {
      "subtitle_id": 8,
      "start": 14.12,
      "end": 17.84,
      "text": "है जीएसटी वगैरह वगैरह और उसके बाद भी अगर"
    },
    {
      "subtitle_id": 9,
      "start": 16.359,
      "end": 19.92,
      "text": "गलती से उसे प्रॉफिट होता है तो गवर्नमेंट"
    },
    {
      "subtitle_id": 10,
      "start": 17.84,
      "end": 21.8,
      "text": "अगेन कैपिटल गेन के नाम पर उससे पैसा ले"
    },
    {
      "subtitle_id": 11,
      "start": 19.92,
      "end": 23.16,
      "text": "लेती है टैक्स के रूप में तो उस व्यक्ति"
    },
    {
      "subtitle_id": 12,
      "start": 21.8,
      "end": 26.039,
      "text": "ने कहा कि गवर्नमेंट एक तरह से मेरी"
    },
    {
      "subtitle_id": 13,
      "start": 23.16,
      "end": 27.84,
      "text": "स्लीपिंग पार्टनर बन गई कि प्रॉफिट हुआ तो"
    },
    {
      "subtitle_id": 14,
      "start": 26.039,
      "end": 29.96,
      "text": "उसमें से एक हिस्सा मेरा यानी फिलहाल"
    },
    {
      "subtitle_id": 15,
      "start": 27.84,
      "end": 31.96,
      "text": "सिचुएशंस कुछ ऐसी है कि लॉस हुआ तो भाई"
    },
    {
      "subtitle_id": 16,
      "start": 29.96,
      "end": 34.12,
      "text": "तुम अपना देख लो प्रॉफिट हुआ तो सरकार"
    },
    {
      "subtitle_id": 17,
      "start": 31.96,
      "end": 35.879,
      "text": "उसमें पार्टनर बनेगी और प्रॉफिट ले लेगी"
    },
    {
      "subtitle_id": 18,
      "start": 34.12,
      "end": 37.6,
      "text": "हालांकि सवाल का फाइनेंस मिनिस्टर ने कोई"
    },
    {
      "subtitle_id": 19,
      "start": 35.879,
      "end": 39.84,
      "text": "जवाब नहीं दिया जिसके बाद इलेक्शन का टाइम"
    },
    {
      "subtitle_id": 20,
      "start": 37.6,
      "end": 41.6,
      "text": "था लोगों को लग रहा था कि आने वाले टाइम"
    },
    {
      "subtitle_id": 21,
      "start": 39.84,
      "end": 43.48,
      "text": "में शायद टैक्सेस कम हो जाएंगे और कुछ"
    },
    {
      "subtitle_id": 22,
      "start": 41.6,
      "end": 45.239,
      "text": "इंटरनल सोर्सेस से न्यूज़ आई है जिसके बाद"
    },
    {
      "subtitle_id": 23,
      "start": 43.48,
      "end": 47.039,
      "text": "हर एक फाइनेंशियल न्यूज़पेपर चैनल पर यही"
    },
    {
      "subtitle_id": 24,
      "start": 45.239,
      "end": 49.6,
      "text": "न्यूज़ चल रही है कि फ्यूचर्स एंड ऑप्शंस"
    },
    {
      "subtitle_id": 25,
      "start": 47.039,
      "end": 51.52,
      "text": "ट्रेडिंग पर 30 पर का टीडीएस कट सकता है"
    },
    {
      "subtitle_id": 26,
      "start": 49.6,
      "end": 53.44,
      "text": "जो भी प्रॉफिट आपको होगा उस पर तो इसके"
    },
    {
      "subtitle_id": 27,
      "start": 51.52,
      "end": 55.239,
      "text": "बाद अभी तीन-चार मेन सवाल खड़े हुए हैं"
    },
    {
      "subtitle_id": 28,
      "start": 53.44,
      "end": 57.559,
      "text": "पहला सवाल तो यह है कि क्या सही में ऐसा"
    },
    {
      "subtitle_id": 29,
      "start": 55.239,
      "end": 58.96,
      "text": "हो सकता है क्या प्रोबेबिलिटी है हो सकता"
    },
    {
      "subtitle_id": 30,
      "start": 57.559,
      "end": 61.879,
      "text": "है या नहीं हो सकता उसके बारे में हम बात"
    },
    {
      "subtitle_id": 31,
      "start": 58.96,
      "end": 64.0,
      "text": "करेंगे होता है तो जो छोटे-छोटे ट्रेडर्स"
    },
    {
      "subtitle_id": 32,
      "start": 61.879,
      "end": 65.88,
      "text": "हैं जो आम इन्वेस्टर्स हैं उन पर उसका"
    },
    {
      "subtitle_id": 33,
      "start": 64.0,
      "end": 67.64,
      "text": "क्या असर पड़ेगा उसके बारे में हम बात"
    },
    {
      "subtitle_id": 34,
      "start": 65.88,
      "end": 69.36,
      "text": "करेंगे और साथ ही इसके और भी क्या"
    },
    {
      "subtitle_id": 35,
      "start": 67.64,
      "end": 71.52,
      "text": "सॉल्यूशंस हो सकते हैं जिसे गवर्नमेंट"
    },
    {
      "subtitle_id": 36,
      "start": 69.36,
      "end": 73.479,
      "text": "कंसीडर कर सकती है मतलब यहां पर सिर्फ हम"
    },
    {
      "subtitle_id": 37,
      "start": 71.52,
      "end": 75.32,
      "text": "प्रॉब्लम की बात नहीं कर रहे सॉल्यूशंस भी"
    },
    {
      "subtitle_id": 38,
      "start": 73.479,
      "end": 77.32,
      "text": "देंगे विद केस स्टडी क्योंकि इसी तरह के"
    },
    {
      "subtitle_id": 39,
      "start": 75.32,
      "end": 79.72,
      "text": "जो टैक्सेस हैं वो रिसेंट टाइम में बेटिंग"
    },
    {
      "subtitle_id": 40,
      "start": 77.32,
      "end": 81.96,
      "text": "ऐप पर लगाए गए लेकिन टैक्सेस लगाने के बाद"
    },
    {
      "subtitle_id": 41,
      "start": 79.72,
      "end": 83.479,
      "text": "वहां कुछ अलग ही हो गया जो गवर्नमेंट सोच"
    },
    {
      "subtitle_id": 42,
      "start": 81.96,
      "end": 85.799,
      "text": "रही थी जिस इंटेंशन से उन्होंने टैक्स"
    },
    {
      "subtitle_id": 43,
      "start": 83.479,
      "end": 87.72,
      "text": "लगाया वो इंटेंशन बाजू में हुआ वहां पर ना"
    },
    {
      "subtitle_id": 44,
      "start": 85.799,
      "end": 89.64,
      "text": "गवर्नमेंट को फायदा हुआ ना लोगों को फायदा"
    },
    {
      "subtitle_id": 45,
      "start": 87.72,
      "end": 91.28,
      "text": "हुआ तीसरे को कौन है तीसरा बात करेंगे इस"
    },
    {
      "subtitle_id": 46,
      "start": 89.64,
      "end": 93.04,
      "text": "वीडियो वीडियो में तो इन सारी चीजों को आज"
    },
    {
      "subtitle_id": 47,
      "start": 91.28,
      "end": 95.2,
      "text": "हम डिटेल में बात करने वाले हैं तो इसमें"
    },
    {
      "subtitle_id": 48,
      "start": 93.04,
      "end": 96.84,
      "text": "से कुछ भी मिस ना करें नमस्कार मैं प्रसाद"
    },
    {
      "subtitle_id": 49,
      "start": 95.2,
      "end": 99.0,
      "text": "आपका आज के इस वीडियो में स्वागत करता हूं"
    },
    {
      "subtitle_id": 50,
      "start": 96.84,
      "end": 100.84,
      "text": "आज के इस वीडियो के प्रायोजक है ओडू जिनके"
    },
    {
      "subtitle_id": 51,
      "start": 99.0,
      "end": 103.079,
      "text": "बारे में हम वीडियो में आगे बात करेंगे"
    },
    {
      "subtitle_id": 52,
      "start": 100.84,
      "end": 105.88,
      "text": "देखिए अब इस चीज के दो पहलू है पहला पहलू"
    },
    {
      "subtitle_id": 53,
      "start": 103.079,
      "end": 108.479,
      "text": "यह है कि गवर्नमेंट हर ट्रेड पर 30 पर का"
    },
    {
      "subtitle_id": 54,
      "start": 105.88,
      "end": 110.6,
      "text": "टीडीएस लगा सकती है और जो दूसरा पहलू है"
    },
    {
      "subtitle_id": 55,
      "start": 108.479,
      "end": 113.2,
      "text": "वो यह है कि गवर्नमेंट जो भी आपका प्रॉफिट"
    },
    {
      "subtitle_id": 56,
      "start": 110.6,
      "end": 116.079,
      "text": "होगा फ्यूचर्स ऑप्शन से उसे स्पेक्युलेटिव"
    },
    {
      "subtitle_id": 57,
      "start": 113.2,
      "end": 118.28,
      "text": "कैटेगरी में डाल सकती है जैसे कि जो लॉटरी"
    },
    {
      "subtitle_id": 58,
      "start": 116.079,
      "end": 120.32,
      "text": "है बटिंग का जो इनकम आपको आता है वो भी"
    },
    {
      "subtitle_id": 59,
      "start": 118.28,
      "end": 121.84,
      "text": "स्पेक्युलेटिव कैटेगरी में होता है और अगर"
    },
    {
      "subtitle_id": 60,
      "start": 120.32,
      "end": 123.88,
      "text": "यह न्यूज़ सही साबित होती है तो पूरे"
    },
    {
      "subtitle_id": 61,
      "start": 121.84,
      "end": 125.88,
      "text": "फ्यूचर्स एंड ऑप्शन इंडस्ट्री के लिए और"
    },
    {
      "subtitle_id": 62,
      "start": 123.88,
      "end": 128.72,
      "text": "स्टॉक मार्केट के लिए भी काफी तौर पर ये"
    },
    {
      "subtitle_id": 63,
      "start": 125.88,
      "end": 130.36,
      "text": "एक बहुत बड़ा ब्लो होगा ऐसा क्यों अगर मैं"
    },
    {
      "subtitle_id": 64,
      "start": 128.72,
      "end": 132.48,
      "text": "आज की बात करूं यानी करंट रूल्स और"
    },
    {
      "subtitle_id": 65,
      "start": 130.36,
      "end": 134.319,
      "text": "रेगुलेशंस की बात करूं तो इनकम टैक्स एक्ट"
    },
    {
      "subtitle_id": 66,
      "start": 132.48,
      "end": 136.36,
      "text": "में एफ एंड ओ से होने वाली जो इनकम है वो"
    },
    {
      "subtitle_id": 67,
      "start": 134.319,
      "end": 138.12,
      "text": "बिजनेस कैटेगरी में काउंट की जाती है पर"
    },
    {
      "subtitle_id": 68,
      "start": 136.36,
      "end": 140.8,
      "text": "अगर यहां से होने वाली इनकम स्पेक्युलेटिव"
    },
    {
      "subtitle_id": 69,
      "start": 138.12,
      "end": 142.519,
      "text": "कैटेगरी में काउंट होने लगी तो फिर आपको"
    },
    {
      "subtitle_id": 70,
      "start": 140.8,
      "end": 144.519,
      "text": "काफी भारी भक्कम टैक्स देना पड़ेगा"
    },
    {
      "subtitle_id": 71,
      "start": 142.519,
      "end": 146.72,
      "text": "स्पेक्युलेटिव जो इनकम है उस पर लगभग 30"
    },
    {
      "subtitle_id": 72,
      "start": 144.519,
      "end": 148.64,
      "text": "पर के करीब तगड़ा टैक्स लगता है और दूसरी"
    },
    {
      "subtitle_id": 73,
      "start": 146.72,
      "end": 150.72,
      "text": "चीज स्पेक्युलेटिव इनकम को आप सेट ऑफ भी"
    },
    {
      "subtitle_id": 74,
      "start": 148.64,
      "end": 152.44,
      "text": "नहीं कर सकते बिजनेस इनकम से जैसे कि अभी"
    },
    {
      "subtitle_id": 75,
      "start": 150.72,
      "end": 154.04,
      "text": "क्या है कि अभी एफ एंडो बिजनेस इनकम में"
    },
    {
      "subtitle_id": 76,
      "start": 152.44,
      "end": 156.12,
      "text": "काउंट किया जाता है तो अगर मान लीजिए कि"
    },
    {
      "subtitle_id": 77,
      "start": 154.04,
      "end": 158.28,
      "text": "फ्यूचर्स ऑप्शन से आपको ₹ लाख का किसी साल"
    },
    {
      "subtitle_id": 78,
      "start": 156.12,
      "end": 160.239,
      "text": "प्रॉफिट हो जाता है और उसी साल आपके किसी"
    },
    {
      "subtitle_id": 79,
      "start": 158.28,
      "end": 161.879,
      "text": "और बिजनेस में ₹ लाख का नुकसान होता है तो"
    },
    {
      "subtitle_id": 80,
      "start": 160.239,
      "end": 163.519,
      "text": "नेट नेट आपको क्या हुआ यहां पर हुआ 2 लाख"
    },
    {
      "subtitle_id": 81,
      "start": 161.879,
      "end": 165.519,
      "text": "का प्रॉफिट वहां पर हुआ 5 लाख का नुकसान"
    },
    {
      "subtitle_id": 82,
      "start": 163.519,
      "end": 168.159,
      "text": "तो नेट नेट 3 लाख आप माइनस में हो लॉस में"
    },
    {
      "subtitle_id": 83,
      "start": 165.519,
      "end": 170.2,
      "text": "हो तो ऐसे में आपको जो 2 लाख का प्रॉफिट"
    },
    {
      "subtitle_id": 84,
      "start": 168.159,
      "end": 172.68,
      "text": "हुआ है एफ एंड ओ में उस पर टैक्स देने की"
    },
    {
      "subtitle_id": 85,
      "start": 170.2,
      "end": 174.48,
      "text": "जरूरत नहीं पड़ेगी तो इस तरह से जो आपके"
    },
    {
      "subtitle_id": 86,
      "start": 172.68,
      "end": 176.879,
      "text": "लॉसेस हैं वो भी कई बार सेट ऑफ हो जाते"
    },
    {
      "subtitle_id": 87,
      "start": 174.48,
      "end": 178.319,
      "text": "हैं उससे भी आपको मदद मिलती है तो एफ एंड"
    },
    {
      "subtitle_id": 88,
      "start": 176.879,
      "end": 180.44,
      "text": "के और एक इंटरेस्टिंग चीज ये है कि जो"
    },
    {
      "subtitle_id": 89,
      "start": 178.319,
      "end": 183.2,
      "text": "आपका प्रॉफिट लॉस है उसे आप सेट ऑफ कर"
    },
    {
      "subtitle_id": 90,
      "start": 180.44,
      "end": 185.44,
      "text": "सकते हैं अगले 8 सालों तक तो वहां पर भी"
    },
    {
      "subtitle_id": 91,
      "start": 183.2,
      "end": 187.519,
      "text": "आपके टैक्स बचाने के ऑप्शंस खुल जाते हैं"
    },
    {
      "subtitle_id": 92,
      "start": 185.44,
      "end": 189.44,
      "text": "प्लस कई सारे लोग जो है वो अपना जो रेंटल"
    },
    {
      "subtitle_id": 93,
      "start": 187.519,
      "end": 191.04,
      "text": "इनकम है उसे बिजनेस इनकम दिखाते हैं तो"
    },
    {
      "subtitle_id": 94,
      "start": 189.44,
      "end": 192.84,
      "text": "उसके अगेंस्ट में भी आप अपना फ्यूचर्स एंड"
    },
    {
      "subtitle_id": 95,
      "start": 191.04,
      "end": 194.44,
      "text": "ऑप्शंस का जो लॉस है वो सेट ऑफ कर सकते हो"
    },
    {
      "subtitle_id": 96,
      "start": 192.84,
      "end": 196.36,
      "text": "जिससे आपकी जो टैक्स लायबिलिटी है वो कम"
    },
    {
      "subtitle_id": 97,
      "start": 194.44,
      "end": 198.36,
      "text": "हो जाती है उसमें और भी कई सारी चीजें हैं"
    },
    {
      "subtitle_id": 98,
      "start": 196.36,
      "end": 200.48,
      "text": "बट हां जो भी आपको लॉसेस कई बार होते हैं"
    },
    {
      "subtitle_id": 99,
      "start": 198.36,
      "end": 202.44,
      "text": "तो वो टैक्स बचाने में भी आपको कई और काम"
    },
    {
      "subtitle_id": 100,
      "start": 200.48,
      "end": 204.04,
      "text": "में आ जाते हैं और अगर ये स्पेक्युलेटिव"
    },
    {
      "subtitle_id": 101,
      "start": 202.44,
      "end": 206.48,
      "text": "इनकम में आ जाता है तो यह सारी चीजें भूल"
    },
    {
      "subtitle_id": 102,
      "start": 204.04,
      "end": 208.76,
      "text": "जाइए सीधा फ्लैट लगभग 30 पर आपको देना"
    },
    {
      "subtitle_id": 103,
      "start": 206.48,
      "end": 211.08,
      "text": "पड़ेगा फिर कोई सेट ऑफ नहीं कोई कुछ और"
    },
    {
      "subtitle_id": 104,
      "start": 208.76,
      "end": 213.08,
      "text": "अगर मैं वेस्टर्न कं की देखो कि वहां पर"
    },
    {
      "subtitle_id": 105,
      "start": 211.08,
      "end": 215.599,
      "text": "क्या चल रहा है तो सारी वेस्टर्न कंट्रीज"
    },
    {
      "subtitle_id": 106,
      "start": 213.08,
      "end": 217.959,
      "text": "में जो एफ एंडो से आने वाला प्रॉफिट है"
    },
    {
      "subtitle_id": 107,
      "start": 215.599,
      "end": 219.879,
      "text": "उसे या तो बिजनेस इनकम में दिखाया जाता है"
    },
    {
      "subtitle_id": 108,
      "start": 217.959,
      "end": 222.36,
      "text": "या फिर उस पर कैपिटल गेन टैक्स लगाया जाता"
    },
    {
      "subtitle_id": 109,
      "start": 219.879,
      "end": 224.879,
      "text": "है यानी कहीं पर भी यह नहीं है कि उसको"
    },
    {
      "subtitle_id": 110,
      "start": 222.36,
      "end": 226.959,
      "text": "स्पेक्युलेटिव इनकम में डाल दिया जिससे"
    },
    {
      "subtitle_id": 111,
      "start": 224.879,
      "end": 228.72,
      "text": "सरकार उस पर और ज्यादा टैक्स लगा सकती है"
    },
    {
      "subtitle_id": 112,
      "start": 226.959,
      "end": 230.879,
      "text": "तो ये अगर होता है तो ये सिर्फ इंडिया में"
    },
    {
      "subtitle_id": 113,
      "start": 228.72,
      "end": 232.439,
      "text": "ही होगा तो इसके मतलब वेस्टर्न कंट्रीज"
    },
    {
      "subtitle_id": 114,
      "start": 230.879,
      "end": 235.68,
      "text": "में भी देखें तो बहुत ही कम एक्सेप्शन है"
    },
    {
      "subtitle_id": 115,
      "start": 232.439,
      "end": 238.2,
      "text": "इन चीजों के इंडिया अगर ऐसा करती है तो एक"
    },
    {
      "subtitle_id": 116,
      "start": 235.68,
      "end": 240.04,
      "text": "बड़ी मेजर कंट्री हो जाएगी जो एफ एंड ओ से"
    },
    {
      "subtitle_id": 117,
      "start": 238.2,
      "end": 242.0,
      "text": "आए हुए इनकम को स्पेक्युलेटिव में कैटेगरी"
    },
    {
      "subtitle_id": 118,
      "start": 240.04,
      "end": 243.879,
      "text": "इज करेगी और यहां पर बात सिर्फ पैसों के"
    },
    {
      "subtitle_id": 119,
      "start": 242.0,
      "end": 246.2,
      "text": "लॉस की नहीं है साइकोलॉजिकल इंपैक्ट भी"
    },
    {
      "subtitle_id": 120,
      "start": 243.879,
      "end": 248.56,
      "text": "इसका है क ऐसे देखिए कि आज कई सारे लोग"
    },
    {
      "subtitle_id": 121,
      "start": 246.2,
      "end": 250.239,
      "text": "हैं जो काफी ट्रेडिंग करते हैं खुद को"
    },
    {
      "subtitle_id": 122,
      "start": 248.56,
      "end": 252.519,
      "text": "ट्रेडर कहलाते हैं ऑप्शंस ट्रेडर वगैरह"
    },
    {
      "subtitle_id": 123,
      "start": 250.239,
      "end": 255.32,
      "text": "लेकिन अगर ये एक्ट आ जाता है तो उनका नाम"
    },
    {
      "subtitle_id": 124,
      "start": 252.519,
      "end": 257.16,
      "text": "ऑप्शंस ट्रेडर नहीं ऑप्शन"
    },
    {
      "subtitle_id": 125,
      "start": 255.32,
      "end": 259.239,
      "text": "स्पेक्युलेटिंग का नाम रिप्लेस होकर हो"
    },
    {
      "subtitle_id": 126,
      "start": 257.16,
      "end": 261.44,
      "text": "जाएगा सट्टा और फिर लोग कहे भी क्यों ना"
    },
    {
      "subtitle_id": 127,
      "start": 259.239,
      "end": 263.759,
      "text": "क्योंकि सरकारी अगर वैसा कह रही है तो लोग"
    },
    {
      "subtitle_id": 128,
      "start": 261.44,
      "end": 266.04,
      "text": "भी वैसा ही कहेंगे इसके कुछ और भी साइड"
    },
    {
      "subtitle_id": 129,
      "start": 263.759,
      "end": 268.44,
      "text": "इफेक्ट्स हो सकते हैं जैसे कि जो मार्केट"
    },
    {
      "subtitle_id": 130,
      "start": 266.04,
      "end": 270.199,
      "text": "पार्टिसिपेशन है वो कम हो सकता है ट्रेड"
    },
    {
      "subtitle_id": 131,
      "start": 268.44,
      "end": 271.919,
      "text": "वॉल्यूम कम हो सकता है जिससे लिक्विडिटी"
    },
    {
      "subtitle_id": 132,
      "start": 270.199,
      "end": 273.52,
      "text": "मार्केट में कम हो सकती है और जो नए"
    },
    {
      "subtitle_id": 133,
      "start": 271.919,
      "end": 275.479,
      "text": "पार्टिसिपेंट्स हैं कई सारे लोग होते हैं"
    },
    {
      "subtitle_id": 134,
      "start": 273.52,
      "end": 276.919,
      "text": "जो ऑप्शन के जरिए मार्केट में आते हैं लॉस"
    },
    {
      "subtitle_id": 135,
      "start": 275.479,
      "end": 278.72,
      "text": "खाने के बाद थोड़े समझदार हो जाते हैं और"
    },
    {
      "subtitle_id": 136,
      "start": 276.919,
      "end": 281.24,
      "text": "फिर लॉन्ग टर्म इन्वेस्टिंग करने लगते हैं"
    },
    {
      "subtitle_id": 137,
      "start": 278.72,
      "end": 282.96,
      "text": "और मेजॉरिटी लोग ऐसा ही करते हैं मैंने आज"
    },
    {
      "subtitle_id": 138,
      "start": 281.24,
      "end": 284.759,
      "text": "तक ऐसा कोई नहीं देखा है कि सिर्फ लॉन्ग"
    },
    {
      "subtitle_id": 139,
      "start": 282.96,
      "end": 286.52,
      "text": "टर्म के लिए आया है वो सब जगह चीजें"
    },
    {
      "subtitle_id": 140,
      "start": 284.759,
      "end": 288.6,
      "text": "एक्सप्लोर करता है करता ही करता है जब"
    },
    {
      "subtitle_id": 141,
      "start": 286.52,
      "end": 290.44,
      "text": "उसको समझ आ जाती है लॉसेस से वो खुद"
    },
    {
      "subtitle_id": 142,
      "start": 288.6,
      "end": 292.639,
      "text": "समझदार बनके बेटर इन्वेस्टमेंट की तरफ"
    },
    {
      "subtitle_id": 143,
      "start": 290.44,
      "end": 294.36,
      "text": "बढ़ने लगता है तो ये भी होने के चांसेस कम"
    },
    {
      "subtitle_id": 144,
      "start": 292.639,
      "end": 296.16,
      "text": "हो जाएंगे तो ओवरऑल पार्टिसिपेशन और ओवरऑल"
    },
    {
      "subtitle_id": 145,
      "start": 294.36,
      "end": 298.08,
      "text": "मार्केट के लिए भी ये कोई अच्छा सिग्नल"
    },
    {
      "subtitle_id": 146,
      "start": 296.16,
      "end": 300.0,
      "text": "नहीं है क्योंकि जैसे कि हमें पता है कि"
    },
    {
      "subtitle_id": 147,
      "start": 298.08,
      "end": 301.56,
      "text": "मार्केट में लिक्विडिटी के लिए शॉर्ट टम"
    },
    {
      "subtitle_id": 148,
      "start": 300.0,
      "end": 303.16,
      "text": "जो ट्रेडर्स हैं वो बहुत इंपॉर्टेंट होते"
    },
    {
      "subtitle_id": 149,
      "start": 301.56,
      "end": 306.08,
      "text": "हैं दे प्ले वेरी इंपोर्टेंट रोल उनकी"
    },
    {
      "subtitle_id": 150,
      "start": 303.16,
      "end": 306.08,
      "text": "संख्या अचानक से ड्रास्ट्रिंग"
    },
    {
      "subtitle_id": 151,
      "start": 307.039,
      "end": 310.6,
      "text": "अब बात करते हैं छोटे जो रिटेल"
    },
    {
      "subtitle_id": 152,
      "start": 309.16,
      "end": 312.36,
      "text": "इन्वेस्टर्स हैं उनकी कि उन पर क्या"
    },
    {
      "subtitle_id": 153,
      "start": 310.6,
      "end": 314.16,
      "text": "इंपैक्ट होगा तो देखिए बड़े कई सारे जो"
    },
    {
      "subtitle_id": 154,
      "start": 312.36,
      "end": 315.919,
      "text": "ट्रेडर्स हैं इन्वेस्टर्स है ऑलरेडी 30 पर"
    },
    {
      "subtitle_id": 155,
      "start": 314.16,
      "end": 318.199,
      "text": "स्लैब में आते हैं 30 पर पैसा पे करते हैं"
    },
    {
      "subtitle_id": 156,
      "start": 315.919,
      "end": 320.36,
      "text": "टैक्स में लेकिन जो छोटे लोग हैं उन्हें"
    },
    {
      "subtitle_id": 157,
      "start": 318.199,
      "end": 321.919,
      "text": "अगर 30 पर पैसा भरना पड़ता है तो"
    },
    {
      "subtitle_id": 158,
      "start": 320.36,
      "end": 323.12,
      "text": "गवर्नमेंट तो उनको इनडायरेक्टली खत्म ही"
    },
    {
      "subtitle_id": 159,
      "start": 321.919,
      "end": 325.12,
      "text": "कर रही है बड़े प्लेयर्स तो रहेंगे"
    },
    {
      "subtitle_id": 160,
      "start": 323.12,
      "end": 327.6,
      "text": "मार्केट में छोटे तो कंप्लीट गायब ही हो"
    },
    {
      "subtitle_id": 161,
      "start": 325.12,
      "end": 329.72,
      "text": "जाएंगे यह कंक्लूजन इसका हो सकता है अगर"
    },
    {
      "subtitle_id": 162,
      "start": 327.6,
      "end": 331.479,
      "text": "सरकार ये डिसीजन लेती है तो उस छोटे जो"
    },
    {
      "subtitle_id": 163,
      "start": 329.72,
      "end": 333.72,
      "text": "रिटेल इन्वेस्टर्स हैं उनके लिए सबसे घातक"
    },
    {
      "subtitle_id": 164,
      "start": 331.479,
      "end": 335.88,
      "text": "हो सकती है तो इन जैसी जो चीजें हैं वो"
    },
    {
      "subtitle_id": 165,
      "start": 333.72,
      "end": 338.479,
      "text": "हमें एक चीज हमेशा याद दिलाती है और वो यह"
    },
    {
      "subtitle_id": 166,
      "start": 335.88,
      "end": 340.52,
      "text": "है कि आपको कभी भी एक इनकम सोर्स पर"
    },
    {
      "subtitle_id": 167,
      "start": 338.479,
      "end": 342.319,
      "text": "डिपेंड नहीं रहना है तो लोगों को भी शायद"
    },
    {
      "subtitle_id": 168,
      "start": 340.52,
      "end": 344.039,
      "text": "इसके बाद मल्टीपल इनकम सोर्सेस एक्सप्लोर"
    },
    {
      "subtitle_id": 169,
      "start": 342.319,
      "end": 345.68,
      "text": "करने पड़ेंगे इसमें फ्रीलांसिंग में काफी"
    },
    {
      "subtitle_id": 170,
      "start": 344.039,
      "end": 348.08,
      "text": "सारी अपॉर्चुनिटी लोगों को शायद ढूंढनी"
    },
    {
      "subtitle_id": 171,
      "start": 345.68,
      "end": 350.199,
      "text": "पड़े जिसमें अगर कोई अच्छा डिजाइनर है तो"
    },
    {
      "subtitle_id": 172,
      "start": 348.08,
      "end": 352.16,
      "text": "वो उसमें एक्सप्लोर कर सकता है क्लाइंट्स"
    },
    {
      "subtitle_id": 173,
      "start": 350.199,
      "end": 354.16,
      "text": "ढूंढ सकता है कोई कोडर है या फिर वीडियो"
    },
    {
      "subtitle_id": 174,
      "start": 352.16,
      "end": 356.24,
      "text": "एडिटर है या फिर और भी कोई जो स्किल है"
    },
    {
      "subtitle_id": 175,
      "start": 354.16,
      "end": 358.039,
      "text": "उसके पास कोई टीचर है तो वो अपनी चीजें"
    },
    {
      "subtitle_id": 176,
      "start": 356.24,
      "end": 360.0,
      "text": "एक्सप्लोर करके मार्केट से पैसा कमाने की"
    },
    {
      "subtitle_id": 177,
      "start": 358.039,
      "end": 362.24,
      "text": "कोशिश उनको करनी पड़ेगी और उसके के लिए एक"
    },
    {
      "subtitle_id": 178,
      "start": 360.0,
      "end": 364.039,
      "text": "चीज सबसे ज्यादा जरूरी होती है और वो है"
    },
    {
      "subtitle_id": 179,
      "start": 362.24,
      "end": 365.72,
      "text": "अच्छे से डिजाइन की हुई वेबसाइट अब"
    },
    {
      "subtitle_id": 180,
      "start": 364.039,
      "end": 367.96,
      "text": "वेबसाइट डिजाइन के लिए अगर आप किसी एजेंसी"
    },
    {
      "subtitle_id": 181,
      "start": 365.72,
      "end": 370.44,
      "text": "को हायर करते हो तो आपको हजारों रुपए देने"
    },
    {
      "subtitle_id": 182,
      "start": 367.96,
      "end": 372.56,
      "text": "पड़ेंगे लेकिन u की मदद से आप यह फ्री में"
    },
    {
      "subtitle_id": 183,
      "start": 370.44,
      "end": 374.479,
      "text": "कर सकते हो ू एक ऑल इन वन बिजनेस"
    },
    {
      "subtitle_id": 184,
      "start": 372.56,
      "end": 376.4,
      "text": "मैनेजमेंट सॉफ्टवेयर है जो आपके बिजनेस"
    },
    {
      "subtitle_id": 185,
      "start": 374.479,
      "end": 378.479,
      "text": "प्रोसेसस को स्ट्रीमलाइन और ऑटोमेट करने"
    },
    {
      "subtitle_id": 186,
      "start": 376.4,
      "end": 380.479,
      "text": "के लिए डिजाइन किया गया है ू के वेबसाइट"
    },
    {
      "subtitle_id": 187,
      "start": 378.479,
      "end": 382.599,
      "text": "बिल्डर से आप सिर्फ चार सिंपल स्टेप्स में"
    },
    {
      "subtitle_id": 188,
      "start": 380.479,
      "end": 384.919,
      "text": "अपनी वेबसाइट बना सकते हैं और यह है वो"
    },
    {
      "subtitle_id": 189,
      "start": 382.599,
      "end": 387.319,
      "text": "चार सिंपल स्टेप्स पहला अपनी वेबसाइट का"
    },
    {
      "subtitle_id": 190,
      "start": 384.919,
      "end": 389.4,
      "text": "टाइप कैटेगरी और ऑब्जेक्टिव सिलेक्ट करें"
    },
    {
      "subtitle_id": 191,
      "start": 387.319,
      "end": 391.319,
      "text": "दूसरा अपना प्रेफर्ड कलर पैलेट सिलेक्ट"
    },
    {
      "subtitle_id": 192,
      "start": 389.4,
      "end": 393.599,
      "text": "करें करें या अपने ब्रांडिंग कलर्स के लिए"
    },
    {
      "subtitle_id": 193,
      "start": 391.319,
      "end": 395.96,
      "text": "अपना लोगो अपलोड करें तीसरा जो फीचर है वो"
    },
    {
      "subtitle_id": 194,
      "start": 393.599,
      "end": 398.12,
      "text": "यह है कि पेजेस और फीचर सिलेक्ट करें जो"
    },
    {
      "subtitle_id": 195,
      "start": 395.96,
      "end": 400.24,
      "text": "आप अपनी वेबसाइट में ऐड करना चाहते हैं और"
    },
    {
      "subtitle_id": 196,
      "start": 398.12,
      "end": 402.919,
      "text": "फिर फाइनल चौथा अपनी वेबसाइट के लिए एक"
    },
    {
      "subtitle_id": 197,
      "start": 400.24,
      "end": 405.24,
      "text": "थीम सिलेक्ट करें और आपकी वेबसाइट रेडी है"
    },
    {
      "subtitle_id": 198,
      "start": 402.919,
      "end": 407.12,
      "text": "ये कुछ इतना सिंपल है अब ओडू के दो फायदे"
    },
    {
      "subtitle_id": 199,
      "start": 405.24,
      "end": 409.08,
      "text": "हैं एक अच्छे खासी वेबसाइट यहां पर बड़ी"
    },
    {
      "subtitle_id": 200,
      "start": 407.12,
      "end": 411.28,
      "text": "आसानी से बन जाती है और दूसरा ू का"
    },
    {
      "subtitle_id": 201,
      "start": 409.08,
      "end": 412.96,
      "text": "कम्युनिटी एडिशन आपको फ्री फॉर यूज मिल"
    },
    {
      "subtitle_id": 202,
      "start": 411.28,
      "end": 414.4,
      "text": "जाता है तो अभी डिस्क्रिप्शन और कमेंट"
    },
    {
      "subtitle_id": 203,
      "start": 412.96,
      "end": 416.44,
      "text": "बॉक्स में दिए गई लिंक पर क्लिक करें अपनी"
    },
    {
      "subtitle_id": 204,
      "start": 414.4,
      "end": 418.56,
      "text": "वेबसाइट बनाएं और अपने सेकंड इनकम सोर्स"
    },
    {
      "subtitle_id": 205,
      "start": 416.44,
      "end": 420.4,
      "text": "पर काम करना शुरू करें अगर आपको याद हो तो"
    },
    {
      "subtitle_id": 206,
      "start": 418.56,
      "end": 422.8,
      "text": "ये सेम चीज हुआ था क्रिप्टो और गेम ऑफ"
    },
    {
      "subtitle_id": 207,
      "start": 420.4,
      "end": 424.8,
      "text": "स्किल्स में ये लोग जो पहले उन बेटिंग"
    },
    {
      "subtitle_id": 208,
      "start": 422.8,
      "end": 427.0,
      "text": "एप्स में बेटिंग करते थे जो गवर्नमेंट को"
    },
    {
      "subtitle_id": 209,
      "start": 424.8,
      "end": 429.24,
      "text": "टैक्स देती थी वहां पर उनको 30 पर के"
    },
    {
      "subtitle_id": 210,
      "start": 427.0,
      "end": 431.0,
      "text": "टैक्स देने पड़ते थे तो वो अवॉइड करने के"
    },
    {
      "subtitle_id": 211,
      "start": 429.24,
      "end": 432.96,
      "text": "लिए ये लोग इल्लीगल बेटिंग एप्स में जो"
    },
    {
      "subtitle_id": 212,
      "start": 431.0,
      "end": 435.08,
      "text": "बाहर कंट्री की है और इल्लीगल है उनमें"
    },
    {
      "subtitle_id": 213,
      "start": 432.96,
      "end": 437.36,
      "text": "बेटिंग करने लगे क्योंकि एक तरफ आपको 30"
    },
    {
      "subtitle_id": 214,
      "start": 435.08,
      "end": 439.319,
      "text": "पर टैक्स देना है और इल्लीगल वेटिंग एप्स"
    },
    {
      "subtitle_id": 215,
      "start": 437.36,
      "end": 441.639,
      "text": "से करेंगे तो 0 पर टैक्स देना है तो बहुत"
    },
    {
      "subtitle_id": 216,
      "start": 439.319,
      "end": 444.16,
      "text": "सारे लोग फिर इलीगल बटिंग एप्स में चले गए"
    },
    {
      "subtitle_id": 217,
      "start": 441.639,
      "end": 446.319,
      "text": "हुआ ये कि बहुत सारे जो इलीगल बेटिंग ऐप"
    },
    {
      "subtitle_id": 218,
      "start": 444.16,
      "end": 448.479,
      "text": "से वो भाग गए फिर एक के बाद एक बटिंग ऐप"
    },
    {
      "subtitle_id": 219,
      "start": 446.319,
      "end": 450.08,
      "text": "के स्कैम सुनने में आए तो गवर्नमेंट की जो"
    },
    {
      "subtitle_id": 220,
      "start": 448.479,
      "end": 451.96,
      "text": "डिसीजन थी बेटिंग पप पर पर ज्यादा टैक्स"
    },
    {
      "subtitle_id": 221,
      "start": 450.08,
      "end": 454.16,
      "text": "लगाने की उससे ना गवर्नमेंट को फायदा हुआ"
    },
    {
      "subtitle_id": 222,
      "start": 451.96,
      "end": 456.24,
      "text": "ना ही बिटिंग करने वाले लोगों को उल्टा"
    },
    {
      "subtitle_id": 223,
      "start": 454.16,
      "end": 458.319,
      "text": "इल्लीगल एप्स के जो नंबर्स है वो बढ़ने"
    },
    {
      "subtitle_id": 224,
      "start": 456.24,
      "end": 459.919,
      "text": "लगे और उसमें से एक एग्जांपल है महादेव"
    },
    {
      "subtitle_id": 225,
      "start": 458.319,
      "end": 461.879,
      "text": "बेटिंग पप का जिसकी केस चल रही है बहुत"
    },
    {
      "subtitle_id": 226,
      "start": 459.919,
      "end": 464.68,
      "text": "सारे एक्टर एक्टर का भी नाम आया है उसमें"
    },
    {
      "subtitle_id": 227,
      "start": 461.879,
      "end": 466.44,
      "text": "तो वो बेनिफिशियरी है उस चीज के ना कि लोग"
    },
    {
      "subtitle_id": 228,
      "start": 464.68,
      "end": 468.479,
      "text": "ना कि गवर्नमेंट अब गवर्नमेंट का इस चीज"
    },
    {
      "subtitle_id": 229,
      "start": 466.44,
      "end": 470.44,
      "text": "पर ये आर्गुमेंट है कि 90 पर जो ट्रेडर्स"
    },
    {
      "subtitle_id": 230,
      "start": 468.479,
      "end": 473.52,
      "text": "हैं वो ऑप्शंस में पैसा गवाते हैं लेकिन"
    },
    {
      "subtitle_id": 231,
      "start": 470.44,
      "end": 475.28,
      "text": "मेरा यह सवाल है कि टैक्स ही क्यों अगर"
    },
    {
      "subtitle_id": 232,
      "start": 473.52,
      "end": 477.28,
      "text": "आपको लोगों को सही में बचाना है तो और भी"
    },
    {
      "subtitle_id": 233,
      "start": 475.28,
      "end": 479.639,
      "text": "तरीके हैं सेबी और गवर्नमेंट चाहे तो बड़े"
    },
    {
      "subtitle_id": 234,
      "start": 477.28,
      "end": 481.72,
      "text": "पैमाने पर एक्सपर्ट्स बुला सकते हैं और"
    },
    {
      "subtitle_id": 235,
      "start": 479.639,
      "end": 483.68,
      "text": "लोगों को एजुकेट करने पर फोकस करते हैं"
    },
    {
      "subtitle_id": 236,
      "start": 481.72,
      "end": 485.56,
      "text": "जैसे हम एमफी की बात करें तो सचिन"
    },
    {
      "subtitle_id": 237,
      "start": 483.68,
      "end": 487.56,
      "text": "तेंडुलकर धोनी के जरिए म्यूचुअल फंड के"
    },
    {
      "subtitle_id": 238,
      "start": 485.56,
      "end": 489.56,
      "text": "बारे में अवेयरनेस की जा रही है और जिसका"
    },
    {
      "subtitle_id": 239,
      "start": 487.56,
      "end": 491.44,
      "text": "रिजल्ट भी काफी विजिबल है उसी तरह की"
    },
    {
      "subtitle_id": 240,
      "start": 489.56,
      "end": 493.159,
      "text": "चीजें सेबी भी कर सकता है अपने इन्वेस्टर"
    },
    {
      "subtitle_id": 241,
      "start": 491.44,
      "end": 494.72,
      "text": "एजुकेशन प्रोग्राम के जरिए और यह बात तो"
    },
    {
      "subtitle_id": 242,
      "start": 493.159,
      "end": 496.68,
      "text": "पक्के गए लोगों को इसके बारे में एजुकेट"
    },
    {
      "subtitle_id": 243,
      "start": 494.72,
      "end": 498.68,
      "text": "किया जाए ऑप्शंस के बारे में फ्यूचर्स के"
    },
    {
      "subtitle_id": 244,
      "start": 496.68,
      "end": 500.039,
      "text": "बारे में तो लॉसेस इस तरह से भी कम किए जा"
    },
    {
      "subtitle_id": 245,
      "start": 498.68,
      "end": 501.8,
      "text": "सकते हैं स्कूल कॉलेजेस के बहुत सारे"
    },
    {
      "subtitle_id": 246,
      "start": 500.039,
      "end": 503.44,
      "text": "ग्रेजुएट्स हैं उन्हें भी आज फ्यूचर ऑप्शन"
    },
    {
      "subtitle_id": 247,
      "start": 501.8,
      "end": 507.36,
      "text": "प्रैक्टिकली कैसे काम करता है उसके बारे"
    },
    {
      "subtitle_id": 248,
      "start": 503.44,
      "end": 507.36,
      "text": "में पता नहीं है वो लोग भी यहां पर आकर"
    },
    {
      "subtitle_id": 249,
      "start": 509.52,
      "end": 512.919,
      "text": "और वार्निंग सिस्टम्स और भी अच्छे तरीके"
    },
    {
      "subtitle_id": 250,
      "start": 511.159,
      "end": 515.24,
      "text": "से इंप्लीमेंट करें तो उससे भी काम हो"
    },
    {
      "subtitle_id": 251,
      "start": 512.919,
      "end": 516.479,
      "text": "सकता है तो काम होने के मल्टीपल तरीके हैं"
    },
    {
      "subtitle_id": 252,
      "start": 515.24,
      "end": 518.12,
      "text": "अगर गवर्नमेंट को लगता है कि इसमें"
    },
    {
      "subtitle_id": 253,
      "start": 516.479,
      "end": 519.919,
      "text": "मॉनेटरी एक्सपेंसेस काफी ज्यादा है तो"
    },
    {
      "subtitle_id": 254,
      "start": 518.12,
      "end": 521.719,
      "text": "ब्रोकर्स के जरिए भी कई सारे प्रोग्राम्स"
    },
    {
      "subtitle_id": 255,
      "start": 519.919,
      "end": 523.44,
      "text": "किए जा सकते हैं और जैसे कि हमें पता है"
    },
    {
      "subtitle_id": 256,
      "start": 521.719,
      "end": 525.12,
      "text": "कि ज्यादातर ब्रोकर्स असली अपना जो"
    },
    {
      "subtitle_id": 257,
      "start": 523.44,
      "end": 526.72,
      "text": "ब्रोकरेज है वो फ्यूचर ऑप्शन से ही कमाते"
    },
    {
      "subtitle_id": 258,
      "start": 525.12,
      "end": 528.08,
      "text": "हैं तो उन्हें अगर बोला जाए स्ट्रिक्टली"
    },
    {
      "subtitle_id": 259,
      "start": 526.72,
      "end": 530.08,
      "text": "फॉलो करने के लिए वो भी अलग-अलग"
    },
    {
      "subtitle_id": 260,
      "start": 528.08,
      "end": 532.32,
      "text": "प्रोग्राम्स करेंगे जिसके बाद अवेयरनेस"
    },
    {
      "subtitle_id": 261,
      "start": 530.08,
      "end": 534.0,
      "text": "में काफी ज्यादा बढ़ोतरी होगी तो करने के"
    },
    {
      "subtitle_id": 262,
      "start": 532.32,
      "end": 535.92,
      "text": "कई सारे ऑप्शंस हैं लेकिन गवर्नमेंट को"
    },
    {
      "subtitle_id": 263,
      "start": 534.0,
      "end": 537.76,
      "text": "फिलहाल एक ही चीज समझ रही है और वो है"
    },
    {
      "subtitle_id": 264,
      "start": 535.92,
      "end": 539.839,
      "text": "टैक्सेस बढ़ाना अब एगजैक्टली फाइनेंस"
    },
    {
      "subtitle_id": 265,
      "start": 537.76,
      "end": 542.04,
      "text": "मिनिस्टर क्या करना चाहती है वो वो तो बजट"
    },
    {
      "subtitle_id": 266,
      "start": 539.839,
      "end": 544.72,
      "text": "के दिन ही पता चलेगा जो जुलाई के आई थिंक"
    },
    {
      "subtitle_id": 267,
      "start": 542.04,
      "end": 546.399,
      "text": "थर्ड वीक के करीब रहेगा तो लेट्स सी तब तक"
    },
    {
      "subtitle_id": 268,
      "start": 544.72,
      "end": 548.279,
      "text": "क्या होता है लेकिन अगर ऐसा कुछ होता है"
    },
    {
      "subtitle_id": 269,
      "start": 546.399,
      "end": 550.44,
      "text": "तो दैट विल बी अ बिग ब्लो फॉर द होल"
    },
    {
      "subtitle_id": 270,
      "start": 548.279,
      "end": 552.68,
      "text": "मार्केट और इसमें पार्टिसिपेशन तो काफी"
    },
    {
      "subtitle_id": 271,
      "start": 550.44,
      "end": 554.44,
      "text": "ज्यादा गिरेगा और मुझे लगता है कि कई सारे"
    },
    {
      "subtitle_id": 272,
      "start": 552.68,
      "end": 556.12,
      "text": "लोग हैं इसके अगेंस्ट शायद प्रोटेस्ट भी"
    },
    {
      "subtitle_id": 273,
      "start": 554.44,
      "end": 557.959,
      "text": "करें तो आप अभी कमेंट में बताइए कि"
    },
    {
      "subtitle_id": 274,
      "start": 556.12,
      "end": 560.32,
      "text": "टैक्सेस बढ़ाने के बजाय गवर्नमेंट के पास"
    },
    {
      "subtitle_id": 275,
      "start": 557.959,
      "end": 562.12,
      "text": "वो कौन-कौन से ऑप्शंस है अलग-अलग जिससे"
    },
    {
      "subtitle_id": 276,
      "start": 560.32,
      "end": 564.12,
      "text": "छोटे-छोटे जो ट्रेडर्स हैं उन्हें एजुकेट"
    },
    {
      "subtitle_id": 277,
      "start": 562.12,
      "end": 566.079,
      "text": "किया जा सके उनके लॉसेस कम किए जा सकते"
    },
    {
      "subtitle_id": 278,
      "start": 564.12,
      "end": 567.68,
      "text": "हैं तो आज यहीं पर रुकते हैं जाते-जाते ू"
    },
    {
      "subtitle_id": 279,
      "start": 566.079,
      "end": 569.519,
      "text": "को जरूर चेक आउट कीजिए अपनी नई इनकम"
    },
    {
      "subtitle_id": 280,
      "start": 567.68,
      "end": 570.959,
      "text": "स्ट्रीम बनाइए और साथ ही इस वीडियो भी"
    },
    {
      "subtitle_id": 281,
      "start": 569.519,
      "end": 573.079,
      "text": "ज्यादा से ज्यादा लोगों तक शेयर कीजिए"
    },
    {
      "subtitle_id": 282,
      "start": 570.959,
      "end": 574.92,
      "text": "ताकि उन्हें भी ये पूरा मामला पता चले और"
    },
    {
      "subtitle_id": 283,
      "start": 573.079,
      "end": 576.6,
      "text": "हमने रिसेंटली काफी सारे पॉडकास्ट अपलोड"
    },
    {
      "subtitle_id": 284,
      "start": 574.92,
      "end": 578.72,
      "text": "किए हैं तो रिसेंट वीडियो में जाकर"
    },
    {
      "subtitle_id": 285,
      "start": 576.6,
      "end": 580.36,
      "text": "अलग-अलग पॉडकास्ट चेक करें जहां पर हमने"
    },
    {
      "subtitle_id": 286,
      "start": 578.72,
      "end": 583.079,
