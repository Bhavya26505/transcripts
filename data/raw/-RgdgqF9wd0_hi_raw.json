    {
      "subtitle_id": 100,
      "start": 193.84,
      "end": 199.12,
      "text": "करोड़ का। यानी कि अगर शॉर्ट में बताऊं तो"
    },
    {
      "subtitle_id": 101,
      "start": 196.239,
      "end": 201.04,
      "text": "एनएसडीएल को पिछले फाइनेंसियल ईयर में 343"
    },
    {
      "subtitle_id": 102,
      "start": 199.12,
      "end": 203.2,
      "text": "करोड़ का प्रॉफिट हुआ है। उसमें से ₹"
    },
    {
      "subtitle_id": 103,
      "start": 201.04,
      "end": 205.519,
      "text": "करोड़ का कंट्रीब्यूशन इस पेमेंट बैंक का"
    },
    {
      "subtitle_id": 104,
      "start": 203.2,
      "end": 207.68,
      "text": "है। जहां से कंपनी का 51% रेवेन्यू आया"
    },
    {
      "subtitle_id": 105,
      "start": 205.519,
      "end": 209.84,
      "text": "है। और जहां से 59% रेवेन्यू आया है बचा"
    },
    {
      "subtitle_id": 106,
      "start": 207.68,
      "end": 212.0,
      "text": "हुआ वहां से कंपनी मेन प्रॉफिट बना रही"
    },
    {
      "subtitle_id": 107,
      "start": 209.84,
      "end": 213.84,
      "text": "है। यानी उनका डिपॉजिटरी बिज़नेस ऐसा है"
