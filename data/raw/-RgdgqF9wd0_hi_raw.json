    {
      "subtitle_id": 128,
      "start": 254.48,
      "end": 259.199,
      "text": "कुछ नहीं है। ऊपर से आपको मिलता है ₹1000"
    },
    {
      "subtitle_id": 129,
      "start": 256.72,
      "end": 260.88,
      "text": "का कैशबैक एज अ जॉइनिंग बोनस ऑन लिंकिंग द"
    },
    {
      "subtitle_id": 130,
      "start": 259.199,
      "end": 262.72,
      "text": "कार्ड टू क्रेडिट पे यूपीआई। और इस"
    },
    {
      "subtitle_id": 131,
      "start": 260.88,
      "end": 264.479,
      "text": "क्रेडिट कार्ड में आपको 50 डेज इंटरेस्ट"
    },
    {
      "subtitle_id": 132,
      "start": 262.72,
      "end": 266.4,
      "text": "फ्री पीरियड भी मिलता है। इस कार्ड पर जो"
    },
    {
      "subtitle_id": 133,
      "start": 264.479,
      "end": 268.32,
      "text": "रिवॉर्ड्स है वो डबल है। क्रेडिट पे की"
    },
    {
      "subtitle_id": 134,
      "start": 266.4,
      "end": 269.68,
      "text": "तरफ से आपको यूपीआई कैशबैक मिलता है और"
    },
    {
      "subtitle_id": 135,
      "start": 268.32,
      "end": 271.84,
      "text": "Yes Bank की तरफ से आपको मिलते हैं"
    },
    {
      "subtitle_id": 136,
      "start": 269.68,
      "end": 274.479,
      "text": "रिवॉर्ड पॉइंट्स जब आप बाकी कैटेगरीज में"
    },
    {
      "subtitle_id": 137,
      "start": 271.84,
      "end": 276.479,
      "text": "स्पेंड करते हो। इसी के साथ आपको 1% फ्यूल"
    },
    {
      "subtitle_id": 138,
      "start": 274.479,
      "end": 278.0,
      "text": "सरचार्ज व्यूअर भी मिलेगा। और जैसे कि आप"
