  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.0,
      "end": 3.6,
      "text": "एनएसडीएल का आईपीओ फाइनली आ गया है। 30"
    },
    {
      "subtitle_id": 2,
      "start": 1.92,
      "end": 5.2,
      "text": "तारीख से 1 तारीख के बीच ये खुला रहेगा।"
    },
    {
      "subtitle_id": 3,
      "start": 3.6,
      "end": 7.359,
      "text": "लेकिन जैसे इस आईपीओ की अनाउंसमेंट हुई"
    },
    {
      "subtitle_id": 4,
      "start": 5.2,
      "end": 9.44,
      "text": "दूसरी तरफ इस डीओ ली में एनएसडीएल का जो"
    },
    {
      "subtitle_id": 5,
      "start": 7.359,
      "end": 11.04,
      "text": "दूसरा भागीदार है CDSL उसके शेयर प्राइस"
    },
    {
      "subtitle_id": 6,
      "start": 9.44,
      "end": 13.2,
      "text": "में गिरावट आना शुरू हो गई। आप देख सकते"
    },
    {
      "subtitle_id": 7,
      "start": 11.04,
      "end": 15.44,
      "text": "हो कंपनी के शेयर प्राइस पिछले 5 दिनों"
    },
    {
      "subtitle_id": 8,
      "start": 13.2,
      "end": 17.359,
      "text": "में ही 11% से ज्यादा गिर चुकी है। तो आज"
    },
    {
      "subtitle_id": 9,
      "start": 15.44,
      "end": 19.359,
      "text": "के इस वीडियो में हम बात करेंगे एनएसएल के"
    },
    {
      "subtitle_id": 10,
      "start": 17.359,
      "end": 20.96,
      "text": "बिज़नेस मॉडल के बारे में। देखिए एनएसएल का"
    },
    {
      "subtitle_id": 11,
      "start": 19.359,
      "end": 22.72,
      "text": "फुल फॉर्म क्या है? नेशनल सिक्योरिटीज़"
    },
    {
      "subtitle_id": 12,
      "start": 20.96,
      "end": 24.32,
      "text": "डिपॉज़िटरी लिमिटेड। लेकिन इंटरेस्टिंगली"
    },
    {
      "subtitle_id": 13,
      "start": 22.72,
      "end": 25.92,
      "text": "डिपॉज़िटरी से ज्यादा इनका रेवेन्यू कहीं"
    },
    {
      "subtitle_id": 14,
      "start": 24.32,
      "end": 27.439,
      "text": "और से आ रहा है। वो चीज क्या है? उसके"
    },
    {
      "subtitle_id": 15,
      "start": 25.92,
      "end": 29.439,
      "text": "बारे में आज हम बात करेंगे। कहने के लिए"
    },
    {
      "subtitle_id": 16,
      "start": 27.439,
      "end": 31.119,
      "text": "तो एनएसएल और सीडीएसएल दोनों एक दूसरे के"
    },
    {
      "subtitle_id": 17,
      "start": 29.439,
      "end": 32.64,
      "text": "बड़े टफ कंपिटिटर हैं। लेकिन एक्चुअल में"
    },
    {
      "subtitle_id": 18,
      "start": 31.119,
      "end": 34.239,
      "text": "इनके बिज़नेस मॉडल में काफी ज्यादा अंतर"
    },
    {
      "subtitle_id": 19,
      "start": 32.64,
      "end": 36.8,
      "text": "है। तो उस अंतर की भी आज हम बात करेंगे"
    },
    {
      "subtitle_id": 20,
      "start": 34.239,
      "end": 38.32,
      "text": "ताकि एनएसडीएल का पूरा बिज़नेस आपको एकदम"
    },
    {
      "subtitle_id": 21,
      "start": 36.8,
      "end": 39.76,
      "text": "यूं पता चल जाए। और आखिर में हम बात"
    },
    {
      "subtitle_id": 22,
      "start": 38.32,
      "end": 41.6,
      "text": "करेंगे कंपनी के वैल्यू्यूएशन के बारे में"
    },
    {
      "subtitle_id": 23,
      "start": 39.76,
      "end": 43.36,
      "text": "कि कंपनी अंडरवैल्यूड लगती है या"
    },
    {
      "subtitle_id": 24,
      "start": 41.6,
      "end": 44.96,
      "text": "ओवरवैल्यूड लगती है। साथ ही लिस्टिंग गेन"
    },
    {
      "subtitle_id": 25,
      "start": 43.36,
      "end": 46.64,
      "text": "के मामले में फिलहाल क्या दिख रहा है। तो"
    },
    {
      "subtitle_id": 26,
      "start": 44.96,
      "end": 48.239,
      "text": "चलिए बिना किसी देरी के शुरू करते हैं।"
    },
    {
      "subtitle_id": 27,
      "start": 46.64,
      "end": 50.48,
      "text": "नमस्कार मैं प्रसाद आपका आज के इस वीडियो"
    },
    {
      "subtitle_id": 28,
      "start": 48.239,
      "end": 52.239,
      "text": "में स्वागत करता हूं। देखिए अर्ली 1990 तक"
    },
    {
      "subtitle_id": 29,
      "start": 50.48,
      "end": 54.079,
      "text": "जो भी शेयर्स थे वो फिजिकल फॉर्मेट में"
    },
    {
      "subtitle_id": 30,
      "start": 52.239,
      "end": 55.92,
      "text": "ट्रेड होते थे। यानी कि कोई ऑनलाइन तरीका"
    },
    {
      "subtitle_id": 31,
      "start": 54.079,
      "end": 57.76,
      "text": "नहीं था। आपको फिजिकली वहां पर जाना"
    },
    {
      "subtitle_id": 32,
      "start": 55.92,
      "end": 59.359,
      "text": "पड़ेगा। शेयर्स बाय करने पड़ेंगे। फिजिकल"
    },
    {
      "subtitle_id": 33,
      "start": 57.76,
      "end": 61.6,
      "text": "फॉर्मेट में अपने पास उन्हें रखना पड़ेगा।"
    },
    {
      "subtitle_id": 34,
      "start": 59.359,
      "end": 63.44,
      "text": "बड़ा एकदम टफ प्रोसेस था। बाद में इसे"
    },
    {
      "subtitle_id": 35,
      "start": 61.6,
      "end": 65.04,
      "text": "पूरी तरह से ऑनलाइन किया गया और यहीं से"
    },
    {
      "subtitle_id": 36,
      "start": 63.44,
      "end": 68.159,
      "text": "शुरुआत हुई दो प्लेयर्स की सीडीएसl और"
    },
    {
      "subtitle_id": 37,
      "start": 65.04,
      "end": 70.56,
      "text": "एनएसएल की। CDSL BS प्रमोटेड है तो एनएसएल"
    },
    {
      "subtitle_id": 38,
      "start": 68.159,
      "end": 72.799,
      "text": "एनएससी प्रमोटेड है। हालांकि एनएसएल के और"
    },
    {
      "subtitle_id": 39,
      "start": 70.56,
      "end": 74.56,
      "text": "भी प्रमोटर्स हैं जैसे कि IDBI, State"
    },
    {
      "subtitle_id": 40,
      "start": 72.799,
      "end": 76.56,
      "text": "Bank ऑफ इंडिया, HDFC Bank इनका भी अच्छा"
    },
    {
      "subtitle_id": 41,
      "start": 74.56,
      "end": 78.24,
      "text": "खासा स्टेक एनएसडीएल में है। तो जैसे कि"
    },
    {
      "subtitle_id": 42,
      "start": 76.56,
      "end": 80.159,
      "text": "मैंने शुरुआत में कहा कि दिखने में तो ये"
    },
    {
      "subtitle_id": 43,
      "start": 78.24,
      "end": 81.84,
      "text": "डायरेक्ट कंपिटिट दिखते हैं लेकिन इनके"
    },
    {
      "subtitle_id": 44,
      "start": 80.159,
      "end": 84.0,
      "text": "बिजनेस मॉडल में बहुत ज्यादा फर्क है। फॉर"
    },
    {
      "subtitle_id": 45,
      "start": 81.84,
      "end": 86.24,
      "text": "एग्जांपल अगर हम एनएसडीएल की बात करें तो"
    },
    {
      "subtitle_id": 46,
      "start": 84.0,
      "end": 88.799,
      "text": "इसका मेजॉरिटी रेवेन्यू बैंकिंग सर्विज से"
    },
    {
      "subtitle_id": 47,
      "start": 86.24,
      "end": 91.2,
      "text": "आता है 51%। क्या है वो बैंकिंग सर्विज"
    },
    {
      "subtitle_id": 48,
      "start": 88.799,
      "end": 93.04,
      "text": "आगे बात करेंगे। सिर्फ 43% ही रेवेन्यू है"
    },
    {
      "subtitle_id": 49,
      "start": 91.2,
      "end": 95.04,
      "text": "इनका जो डिपॉजिटरी से आता है और बाकी जो"
    },
    {
      "subtitle_id": 50,
      "start": 93.04,
      "end": 96.799,
      "text": "6% रेवेन्यू है वह आता है इनका डेटाबेस"
    },
    {
      "subtitle_id": 51,
      "start": 95.04,
      "end": 98.56,
      "text": "मैनेजमेंट से। इतना कोई सिग्निफिकेंट नंबर"
    },
    {
      "subtitle_id": 52,
      "start": 96.799,
      "end": 101.04,
      "text": "नहीं है। वहीं पर अगर हम सीडीएसएल की बात"
    },
    {
      "subtitle_id": 53,
      "start": 98.56,
      "end": 103.6,
      "text": "करें तो सीडीएसएल का लगभग 80% रेवेन्यू"
    },
    {
      "subtitle_id": 54,
      "start": 101.04,
      "end": 105.52,
      "text": "डिपॉजिटरी सर्विज से आता है। तो फर्क काफी"
    },
    {
      "subtitle_id": 55,
      "start": 103.6,
      "end": 107.04,
      "text": "क्लियर है। और सीडीएसएल का बैंकिंग सर्विज"
    },
    {
      "subtitle_id": 56,
      "start": 105.52,
      "end": 109.2,
      "text": "से कोई रेवेन्यू नहीं आता है। तो बैंकिंग"
    },
    {
      "subtitle_id": 57,
      "start": 107.04,
      "end": 110.799,
      "text": "सर्विज रेवेन्यू एक बहुत बड़ा डिफरेंशिएटर"
    },
    {
      "subtitle_id": 58,
      "start": 109.2,
      "end": 112.799,
      "text": "है इन दोनों के बीच में। तो इस बैंकिंग"
    },
    {
      "subtitle_id": 59,
      "start": 110.799,
      "end": 114.399,
      "text": "सेगमेंट की अगर मैं बात करूं तो एनएसडीएल"
    },
    {
      "subtitle_id": 60,
      "start": 112.799,
      "end": 116.64,
      "text": "की एक सब्सिडरी कंपनी है जिसका नाम है"
    },
    {
      "subtitle_id": 61,
      "start": 114.399,
      "end": 118.56,
      "text": "एनएसडीएल पेमेंट्स बैंक। यानी इनकी खुद की"
    },
    {
      "subtitle_id": 62,
      "start": 116.64,
      "end": 120.32,
      "text": "एक पेमेंट बैंक है और पेमेंट बैंक की बात"
    },
    {
      "subtitle_id": 63,
      "start": 118.56,
      "end": 122.0,
      "text": "आती है तो वहां पर डिपॉजिट्स ले रहे हैं।"
    },
    {
      "subtitle_id": 64,
      "start": 120.32,
      "end": 123.759,
      "text": "पेमेंट बैंक से तो उस तौर पर बहुत सारी"
    },
    {
      "subtitle_id": 65,
      "start": 122.0,
      "end": 126.0,
      "text": "सर्विज ये ऑफर करते हैं। जैसे कि सेविंग"
    },
    {
      "subtitle_id": 66,
      "start": 123.759,
      "end": 127.68,
      "text": "अकाउंट, पेमेंट सर्विसेज और बाकी कई सारे"
    },
    {
      "subtitle_id": 67,
      "start": 126.0,
      "end": 129.039,
      "text": "फाइनेंसियल प्रोडक्ट्स। यानी कि थोड़ा सा"
    },
    {
      "subtitle_id": 68,
      "start": 127.68,
      "end": 131.12,
      "text": "डिटेल में बताऊं तो कंपनी का रेवेन्यू"
    },
    {
      "subtitle_id": 69,
      "start": 129.039,
      "end": 134.16,
      "text": "लगभग 1400 करोड़ का है और उसमें से लगभग"
    },
    {
      "subtitle_id": 70,
      "start": 131.12,
      "end": 136.48,
      "text": "51% रेवेन्यू यानी 79 करोड़ का रेवेन्यू"
    },
    {
      "subtitle_id": 71,
      "start": 134.16,
      "end": 138.08,
      "text": "इनका एनएसएल के पेमेंट बैंक से आया है।"
    },
    {
      "subtitle_id": 72,
      "start": 136.48,
      "end": 139.68,
      "text": "इंटरेस्टिंग बात यह है कि अभी कुछ साल"
    },
    {
      "subtitle_id": 73,
      "start": 138.08,
      "end": 141.84,
      "text": "पहले ही इन्होंने यह बिज़नेस शुरू किया।"
    },
    {
      "subtitle_id": 74,
      "start": 139.68,
      "end": 143.599,
      "text": "2-4 साल पहले देखें तो 8-10% का इनका"
    },
    {
      "subtitle_id": 75,
      "start": 141.84,
      "end": 145.68,
      "text": "रेवेन्यू यहां से आता था। लेकिन यह बिज़नेस"
    },
    {
      "subtitle_id": 76,
      "start": 143.599,
      "end": 147.44,
      "text": "इनका बहुत तेजी से बढ़ रहा है और इसीलिए"
    },
    {
      "subtitle_id": 77,
      "start": 145.68,
      "end": 149.92,
      "text": "ओवरऑल एनएसडीएल की अगर आप टॉप लाइन"
    },
    {
      "subtitle_id": 78,
      "start": 147.44,
      "end": 151.52,
      "text": "देखेंगे, रेवेन्यू देखेंगे तो वह भी आपको"
    },
    {
      "subtitle_id": 79,
      "start": 149.92,
      "end": 154.56,
      "text": "बहुत तेजी से बढ़ती हुई दिखेगी। फॉर"
    },
    {
      "subtitle_id": 80,
      "start": 151.52,
      "end": 158.16,
      "text": "एग्जांपल 2020 में जहां इनका रेवेन्यू 326"
    },
    {
      "subtitle_id": 81,
      "start": 154.56,
      "end": 160.0,
      "text": "करोड़ का था वो अब 2025 आते-आते 1420"
    },
    {
      "subtitle_id": 82,
      "start": 158.16,
      "end": 162.16,
      "text": "करोड़ का हो चुका है। यानी कि पिछले 5 साल"
    },
    {
      "subtitle_id": 83,
      "start": 160.0,
      "end": 163.84,
      "text": "में इनका रेवेन्यू कंपाउंडेड सालाना 34%"
    },
    {
      "subtitle_id": 84,
      "start": 162.16,
      "end": 166.08,
      "text": "से बढ़ा है। तो यहां पर आप स्क्रीन पर देख"
    },
    {
      "subtitle_id": 85,
      "start": 163.84,
      "end": 168.0,
      "text": "सकते हो कि 2022 में इनके एनएसडीएल"
    },
    {
      "subtitle_id": 86,
      "start": 166.08,
      "end": 171.36,
      "text": "पेमेंट्स ने 300 करोड़ का रेवेन्यू बनाया"
    },
    {
      "subtitle_id": 87,
      "start": 168.0,
      "end": 173.04,
      "text": "था। जो अभी 2025 आते-आते 722 करोड़ पर आ"
    },
    {
      "subtitle_id": 88,
      "start": 171.36,
      "end": 174.72,
      "text": "चुकी है। यानी काफी तेजी से यहां पर ग्रोथ"
    },
    {
      "subtitle_id": 89,
      "start": 173.04,
      "end": 176.64,
      "text": "हो रही है पेमेंट बैंक्स में। लेकिन यहां"
    },
    {
      "subtitle_id": 90,
      "start": 174.72,
      "end": 178.48,
      "text": "अगर आप नेट प्रॉफिट वाले कॉलम को देखेंगे"
    },
    {
      "subtitle_id": 91,
      "start": 176.64,
      "end": 180.08,
      "text": "तो कंपनी यहां पर प्रॉफिट कमाने के लिए"
    },
    {
      "subtitle_id": 92,
      "start": 178.48,
      "end": 181.68,
      "text": "स्ट्रगल कर रही है। तो एक चीज तो आपको पता"
    },
    {
      "subtitle_id": 93,
      "start": 180.08,
      "end": 183.44,
      "text": "चल गई कि ये सेगमेंट बहुत अच्छा परफॉर्म"
    },
    {
      "subtitle_id": 94,
      "start": 181.68,
      "end": 185.44,
      "text": "कर रही है। ये तो हो गई इस चीज की पॉजिटिव"
    },
    {
      "subtitle_id": 95,
      "start": 183.44,
      "end": 187.28,
      "text": "साइड। असली पिक्चर अभी बाकी है। नेट"
    },
    {
      "subtitle_id": 96,
      "start": 185.44,
      "end": 189.84,
      "text": "प्रॉफिट पर अगर हम आते हैं तो आप देख सकते"
