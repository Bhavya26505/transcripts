    {
      "subtitle_id": 139,
      "start": 276.479,
      "end": 279.84,
      "text": "स्क्रीन पर देख रहे हो क्रेडिट पे से"
    },
    {
      "subtitle_id": 140,
      "start": 278.0,
      "end": 282.16,
      "text": "मिलने वाले कैशबैक को यूज करके आप ढेरों"
    },
    {
      "subtitle_id": 141,
      "start": 279.84,
      "end": 284.08,
      "text": "सारी शॉपिंग, oटीt और बाकी एप्स पर"
    },
    {
      "subtitle_id": 142,
      "start": 282.16,
      "end": 286.32,
      "text": "डिस्काउंट के लिए भी उसे यूज कर सकते हो।"
    },
    {
      "subtitle_id": 143,
      "start": 284.08,
      "end": 288.479,
      "text": "जैसे Amazon और बाकी ऐप पर 6% तक का"
