    {
      "subtitle_id": 114,
      "start": 225.28,
      "end": 229.68,
      "text": "क्योंकि क्रेडिट पे से आपको मिलेगा 2%"
    },
    {
      "subtitle_id": 115,
      "start": 227.44,
      "end": 231.76,
      "text": "अनलिमिटेड कैशबैक सारे यूपीआई स्पेंड्स"
