    {
      "subtitle_id": 144,
      "start": 286.32,
      "end": 291.36,
      "text": "डिस्काउंट ले सकते हो। यूजिंग योर कैशबैक"
    },
    {
      "subtitle_id": 145,
      "start": 288.479,
      "end": 295.12,
      "text": "MNTRa D्नी Hotstar पर 12% Dominos पर"
    },
    {
      "subtitle_id": 146,
      "start": 291.36,
      "end": 296.88,
      "text": "24%, Sony LV पर 60% और Swiggy 1 पर 100%"
    },
    {
      "subtitle_id": 147,
      "start": 295.12,
      "end": 298.479,
      "text": "तक का डिस्काउंट आप यहां पर ले सकते हो।"
    },
    {
      "subtitle_id": 148,
      "start": 296.88,
      "end": 300.72,
      "text": "और यही नहीं आने वाले टाइम में आप इनके"
    },
    {
      "subtitle_id": 149,
      "start": 298.479,
      "end": 302.4,
      "text": "कैशबैक्स अपनी यूटिलिटी बिल्स और बाकी कई"
    },
    {
      "subtitle_id": 150,
      "start": 300.72,
      "end": 304.08,
      "text": "सारी चीजों के लिए यूज कर सकते हो। तो"
    },
    {
      "subtitle_id": 151,
      "start": 302.4,
      "end": 306.08,
      "text": "इंतजार किस चीज का? अभी डिस्क्रिप्शन और"
    },
    {
      "subtitle_id": 152,
      "start": 304.08,
      "end": 308.0,
      "text": "कमेंट में दिए लिंक पर क्लिक करके क्रेडिट"
    },
    {
      "subtitle_id": 153,
      "start": 306.08,
      "end": 309.84,
      "text": "पे का ऐप डाउनलोड कीजिए और यूपीआई क्रेडिट"
    },
    {
      "subtitle_id": 154,
      "start": 308.0,
      "end": 311.759,
      "text": "कार्ड के लिए अप्लाई कीजिए। तो चलिए अब"
    },
    {
      "subtitle_id": 155,
      "start": 309.84,
      "end": 313.68,
      "text": "आगे बढ़ते हैं। अगर इनके डिपॉजिटरी"
    },
    {
      "subtitle_id": 156,
      "start": 311.759,
      "end": 317.6,
      "text": "बिज़नेस को देखा जाए तो यह नंबर्स आप देख"
    },
    {
      "subtitle_id": 157,
      "start": 313.68,
      "end": 319.759,
      "text": "लीजिए 202 में एनएसएल के पास 2.15 करोड़"
    },
    {
      "subtitle_id": 158,
      "start": 317.6,
      "end": 322.88,
      "text": "डीमेट अकाउंट्स थे। जो अगले साल 25% से"
    },
    {
      "subtitle_id": 159,
      "start": 319.759,
      "end": 325.039,
      "text": "बढ़कर 2.76 करोड़ हुए। और फिर इस तरह से"
    },
    {
      "subtitle_id": 160,
      "start": 322.88,
      "end": 327.84,
      "text": "2025 आते-आते इनके जो टोटल डीमेट अकाउंट्स"
    },
    {
      "subtitle_id": 161,
      "start": 325.039,
      "end": 329.52,
      "text": "हैं वो पहुंच गए हैं 4.05 करोड़ पर। यानी"
    },
    {
      "subtitle_id": 162,
      "start": 327.84,
      "end": 332.08,
      "text": "कि NSDL की जो डीमेट अकाउंट ग्रोथ है"
    },
    {
      "subtitle_id": 163,
      "start": 329.52,
      "end": 333.84,
      "text": "पिछले 5 सालों की वह कंपाउंडेड सालाना 17%"
    },
    {
      "subtitle_id": 164,
      "start": 332.08,
      "end": 336.08,
      "text": "की है जो कि काफी अच्छी भी है। लेकिन अगर"
    },
    {
      "subtitle_id": 165,
      "start": 333.84,
      "end": 338.96,
      "text": "आप यह ग्राफ देखेंगे CDSL वर्सेस एनएसडीएल"
    },
    {
      "subtitle_id": 166,
      "start": 336.08,
      "end": 341.919,
      "text": "की डीमेट अकाउंट ग्रोथ का तो शायद आप चौंक"
    },
    {
      "subtitle_id": 167,
      "start": 338.96,
      "end": 344.56,
      "text": "जाएंगे। क्योंकि देखिए 2011-12 का पीरियड"
    },
    {
      "subtitle_id": 168,
      "start": 341.919,
      "end": 346.08,
      "text": "अगर आप देखें इनफैक्ट 2016 तक सबसे ज्यादा"
    },
    {
      "subtitle_id": 169,
      "start": 344.56,
      "end": 348.72,
      "text": "मार्केट शेयर डिपॉज़िटरी सेगमेंट में"
    },
    {
      "subtitle_id": 170,
      "start": 346.08,
      "end": 351.28,
      "text": "एनएसएल के पास था। लेकिन 2016 के बाद"
    },
    {
      "subtitle_id": 171,
      "start": 348.72,
      "end": 353.36,
      "text": "धीरे-धीरे पूरा गेम सीडीएसएल के फेवर में"
    },
    {
      "subtitle_id": 172,
      "start": 351.28,
      "end": 355.039,
      "text": "चला गया और आज सीडीएसएल डिपॉज़िटरी गेम में"
    },
    {
      "subtitle_id": 173,
      "start": 353.36,
      "end": 357.52,
      "text": "मार्केट लीडर है। इन शॉर्ट अगर मैं आपको"
    },
    {
      "subtitle_id": 174,
      "start": 355.039,
      "end": 359.759,
      "text": "बता दूं कि 2011 में सीडीएसएल का जो"
    },
    {
      "subtitle_id": 175,
      "start": 357.52,
      "end": 362.4,
      "text": "मार्केट शेयर था डिपॉज़िटरी में वो 40% था"
    },
    {
      "subtitle_id": 176,
      "start": 359.759,
      "end": 364.319,
      "text": "और आज वो चला गया है क्लोज टू 80%। वहीं"
    },
    {
      "subtitle_id": 177,
      "start": 362.4,
      "end": 367.28,
      "text": "उस टाइम एनएसएल का जो मार्केट शेयर था वो"
    },
    {
      "subtitle_id": 178,
      "start": 364.319,
      "end": 368.88,
      "text": "60% था जो अब गिर कर लगभग 20% के करीब आ"
    },
    {
      "subtitle_id": 179,
      "start": 367.28,
      "end": 370.479,
      "text": "चुका है। अगर आप इस ग्राफ को देखेंगे और"
    },
    {
      "subtitle_id": 180,
      "start": 368.88,
      "end": 372.319,
      "text": "अपने आप से पूछेंगे कि ऐसा क्या हुआ कि"
    },
    {
      "subtitle_id": 181,
      "start": 370.479,
      "end": 374.4,
      "text": "CDSL ग्रो हुई और एनएसएल नहीं या फिर"
    },
    {
      "subtitle_id": 182,
      "start": 372.319,
      "end": 376.8,
      "text": "एनएसएल की ग्रोथ CDSL कैसे खा गया? तो"
    },
    {
      "subtitle_id": 183,
      "start": 374.4,
      "end": 378.72,
      "text": "उसका मेन कारण है कि 2017 के अराउंड"
    },
    {
      "subtitle_id": 184,
      "start": 376.8,
      "end": 380.56,
      "text": "ईकेवाईसी स्टार्ट हुई। ईकेवाईसी के"
    },
    {
      "subtitle_id": 185,
      "start": 378.72,
      "end": 382.24,
      "text": "साथ-साथ जो डिस्काउंट ब्रोकर थे जो आपको"
    },
    {
      "subtitle_id": 186,
      "start": 380.56,
      "end": 384.08,
      "text": "ऑनलाइन सर्विज प्रोवाइड करते हैं थोड़ी"
    },
    {
      "subtitle_id": 187,
      "start": 382.24,
      "end": 385.52,
      "text": "डिस्काउंटेड चार्जेस पर उनका जो फ्लो है"
    },
    {
      "subtitle_id": 188,
      "start": 384.08,
      "end": 387.12,
      "text": "मार्केट में वो बढ़ने लगा और जो फुल"
    },
    {
      "subtitle_id": 189,
      "start": 385.52,
      "end": 389.12,
      "text": "सर्विस ब्रोकर्स हैं ICICI सिक्योरिटीज,"
    },
    {
      "subtitle_id": 190,
      "start": 387.12,
      "end": 391.039,
      "text": "HDFC सिक्योरिटीज और मोतीलाल ओसवाल जैसे"
    },
    {
      "subtitle_id": 191,
      "start": 389.12,
      "end": 392.56,
      "text": "इनका जो फ्लो है वो थोड़ा कम हो गया। धीमा"
    },
    {
      "subtitle_id": 192,
      "start": 391.039,
      "end": 394.56,
      "text": "हो गया। इस चीज से आपको आईडिया आ जाएगी।"
    },
    {
      "subtitle_id": 193,
      "start": 392.56,
      "end": 396.72,
      "text": "CDSL के पास अगर देखा जाए तो आज के जो"
    },
    {
      "subtitle_id": 194,
      "start": 394.56,
      "end": 398.88,
      "text": "लीडिंग ब्रोकर्स हैं Zerodha Go Annjal वन"
    },
    {
      "subtitle_id": 195,
      "start": 396.72,
      "end": 401.039,
      "text": "ये तीनों भी CDSL के पास है। USTOK जो है"
    },
    {
      "subtitle_id": 196,
      "start": 398.88,
      "end": 402.8,
      "text": "वो दोनों जगह पे है। CDSL और NSL दोनों"
    },
    {
      "subtitle_id": 197,
      "start": 401.039,
      "end": 404.88,
      "text": "जगह पर है। आज अगर आप देखेंगे तो टॉप के"
    },
    {
      "subtitle_id": 198,
      "start": 402.8,
      "end": 407.12,
      "text": "थ्री प्लेयर्स हैं। नए डीमेट अकाउंट्स में"
    },
    {
      "subtitle_id": 199,
      "start": 404.88,
      "end": 409.52,
      "text": "क्लोज टू 50% ग्रोथ यहीं से आ रही है। इसी"
    },
    {
      "subtitle_id": 200,
      "start": 407.12,
      "end": 411.84,
      "text": "के चलते अगर हम फाइनेंसियल 2024 का डाटा"
    },
    {
      "subtitle_id": 201,
      "start": 409.52,
      "end": 415.199,
      "text": "देखें तो 2024 में कितने डीमेट अकाउंट ओपन"
    },
    {
      "subtitle_id": 202,
      "start": 411.84,
      "end": 417.199,
      "text": "हुए थे? 3.26 करोड़ और उसमें से 88% डीमेट"
    },
    {
      "subtitle_id": 203,
      "start": 415.199,
      "end": 418.8,
      "text": "अकाउंट सीडीएसएल के साथ खुल गए। और वहीं"
    },
    {
      "subtitle_id": 204,
      "start": 417.199,
      "end": 420.479,
      "text": "अगर हम एनएसएल के साथ जो ब्रोकर्स हैं"
    },
    {
      "subtitle_id": 205,
      "start": 418.8,
      "end": 421.919,
      "text": "उनकी बात करें तो उनके पास ज्यादातर फुल"
    },
    {
      "subtitle_id": 206,
      "start": 420.479,
      "end": 423.84,
      "text": "सर्विस ब्रोकर्स हैं। ठीक है? ICI"
    },
    {
      "subtitle_id": 207,
      "start": 421.919,
      "end": 425.52,
      "text": "सिक्योरिटीज मोतीलाल ओसवाल एंड ऑल। अब ये"
    },
    {
      "subtitle_id": 208,
      "start": 423.84,
      "end": 427.599,
      "text": "जो प्लेयर्स हैं ये फुल सर्विस ब्रोकर्स"
    },
    {
      "subtitle_id": 209,
      "start": 425.52,
      "end": 429.919,
      "text": "हैं। इनकी जो स्पीड है, रफ्तार है वो उस"
    },
    {
      "subtitle_id": 210,
      "start": 427.599,
      "end": 431.68,
      "text": "तरह से नहीं रही जितनी डिस्काउंट ब्रोकर"
    },
    {
      "subtitle_id": 211,
      "start": 429.919,
      "end": 433.68,
      "text": "की रही है। और इसी के चलते हमें पता चला"
    },
    {
      "subtitle_id": 212,
      "start": 431.68,
      "end": 435.44,
      "text": "कि सीडीएल की ग्रोथ हुई है। हालांकि इनका"
    },
    {
      "subtitle_id": 213,
      "start": 433.68,
      "end": 437.919,
      "text": "मार्केट शेयर कम हुआ है। लेकिन फिर भी अगर"
    },
    {
      "subtitle_id": 214,
      "start": 435.44,
      "end": 440.08,
      "text": "आप देखेंगे तो एक पॉजिटिव चीज है अभी भी"
    },
    {
      "subtitle_id": 215,
      "start": 437.919,
      "end": 442.319,
      "text": "कि इतना सब होने के बावजूद भी कंपनी का जो"
    },
    {
      "subtitle_id": 216,
      "start": 440.08,
      "end": 445.199,
      "text": "प्रॉफिट है वो बढ़ा है। इट वाज़ 125 करोड़"
    },
    {
      "subtitle_id": 217,
      "start": 442.319,
      "end": 446.96,
      "text": "इन 2020। वहां से बढ़कर यह अभी 343 करोड़"
    },
    {
      "subtitle_id": 218,
      "start": 445.199,
      "end": 448.639,
      "text": "पर आया है। अब आप सोचेंगे कि इसका मार्केट"
    },
    {
      "subtitle_id": 219,
      "start": 446.96,
      "end": 450.56,
      "text": "शेयर तो कम हुआ। फिर प्रॉफिट तो कम होना"
    },
    {
      "subtitle_id": 220,
      "start": 448.639,
      "end": 452.24,
      "text": "चाहिए। लेकिन आपको बता दूं कि डीममेट"
    },
    {
      "subtitle_id": 221,
      "start": 450.56,
      "end": 453.68,
      "text": "अकाउंट की ग्रोथ ही इतनी तेजी से बढ़ रही"
    },
    {
      "subtitle_id": 222,
      "start": 452.24,
      "end": 456.16,
      "text": "थी कि इतना सब कुछ होने के बाद मार्केट"
    },
    {
      "subtitle_id": 223,
      "start": 453.68,
      "end": 458.08,
      "text": "शेयर गवाने के बावजूद भी 17% कंपाउंडेड"
    },
    {
      "subtitle_id": 224,
      "start": 456.16,
      "end": 459.599,
      "text": "सालाना ग्रोथ से एनएसडीएल के पास डीमेट"
    },
    {
      "subtitle_id": 225,
      "start": 458.08,
      "end": 461.759,
      "text": "अकाउंट खुले हैं और इसी का फायदा यह हुआ"
    },
    {
      "subtitle_id": 226,
      "start": 459.599,
      "end": 463.599,
      "text": "है कि अराउंड 20% की ग्रोथ कंपनी ने पिछले"
    },
    {
      "subtitle_id": 227,
      "start": 461.759,
      "end": 464.96,
      "text": "चारप सालों में दिखाई है बोथ रेवेन्यू और"
    },
    {
      "subtitle_id": 228,
      "start": 463.599,
      "end": 466.56,
      "text": "प्रॉफिट सेगमेंट में। अब बात करते हैं"
    },
    {
      "subtitle_id": 229,
      "start": 464.96,
      "end": 468.16,
      "text": "वैल्यू्यूएशन की। शॉर्ट टर्म और लॉन्ग"
    },
    {
      "subtitle_id": 230,
      "start": 466.56,
      "end": 469.68,
      "text": "टर्म दोनों की हम बात करेंगे। शुरुआत करते"
    },
    {
      "subtitle_id": 231,
      "start": 468.16,
      "end": 471.36,
      "text": "हैं लॉन्ग टर्म से। लॉन्ग टर्म की बात"
    },
    {
      "subtitle_id": 232,
      "start": 469.68,
      "end": 473.68,
      "text": "करें तो कंपनी का मार्केट कैपिटलाइजेशन"
    },
    {
      "subtitle_id": 233,
      "start": 471.36,
      "end": 475.199,
      "text": "निकल कर आ रहा है लगभग ₹16,000 करोड़। जिस"
    },
    {
      "subtitle_id": 234,
      "start": 473.68,
      "end": 477.52,
      "text": "हिसाब से कंपनी का जो प्राइस टू अर्निंग"
    },
    {
      "subtitle_id": 235,
      "start": 475.199,
      "end": 479.44,
      "text": "रेशियो है वो है 46 का। 46 का प्राइस टू"
    },
    {
      "subtitle_id": 236,
      "start": 477.52,
      "end": 481.28,
      "text": "अर्निंग रेशियो अगर कंपनी को जस्टिफाई"
    },
    {
      "subtitle_id": 237,
      "start": 479.44,
      "end": 482.96,
      "text": "करना है तो मुझे लगता है इनको अपने एनएसएल"
    },
    {
      "subtitle_id": 238,
      "start": 481.28,
      "end": 484.72,
      "text": "पेमेंट बैंक के बिज़नेस में बहुत कुछ करने"
    },
    {
      "subtitle_id": 239,
      "start": 482.96,
      "end": 486.96,
      "text": "की जरूरत है क्योंकि इस तरह से अगर"
    },
    {
      "subtitle_id": 240,
      "start": 484.72,
      "end": 488.56,
      "text": "प्रॉफिट दबा रहेगा तो इस वैल्यू्यूएशन को"
    },
    {
      "subtitle_id": 241,
      "start": 486.96,
      "end": 490.24,
      "text": "जस्टिफाई करना डिफिकल्ट है क्योंकि अभी"
    },
    {
      "subtitle_id": 242,
      "start": 488.56,
      "end": 491.84,
      "text": "क्या हुआ है कि डीमेट अकाउंट की जो ओवरऑल"
    },
    {
      "subtitle_id": 243,
      "start": 490.24,
      "end": 493.36,
      "text": "ग्रोथ है वो कम हुई है। अब तक तो सारी"
    },
    {
      "subtitle_id": 244,
      "start": 491.84,
      "end": 495.36,
      "text": "चीजें सही थी लेकिन यहां से एक ओवरऑल"
    },
    {
      "subtitle_id": 245,
      "start": 493.36,
      "end": 497.36,
      "text": "डीमेट अकाउंट ग्रोथ काफी धीमी हुई है और"
    },
    {
      "subtitle_id": 246,
      "start": 495.36,
      "end": 499.199,
      "text": "इस चीज को आप कंपनी के पिछले एक साल की जो"
    },
    {
      "subtitle_id": 247,
      "start": 497.36,
      "end": 501.12,
      "text": "ग्रोथ है रेवेन्यू ग्रोथ उसके हिसाब से"
    },
    {
      "subtitle_id": 248,
      "start": 499.199,
      "end": 502.72,
      "text": "समझ भी सकते हैं। जहां पर पिछले 5 सालों"
    },
    {
      "subtitle_id": 249,
      "start": 501.12,
      "end": 505.36,
      "text": "में कंपनी की रेवेन्यू ग्रोथ कंपाउंडेड"
    },
    {
      "subtitle_id": 250,
      "start": 502.72,
      "end": 507.52,
      "text": "सालाना 34% की रही है। वहीं पर पिछले एक"
    },
    {
      "subtitle_id": 251,
      "start": 505.36,
      "end": 509.199,
      "text": "साल की ग्रोथ देखें तो मात्र 12% की रही"
    },
    {
      "subtitle_id": 252,
      "start": 507.52,
      "end": 511.84,
      "text": "है क्योंकि ओवरऑल डीमेट अकाउंट ग्रोथ में"
    },
    {
      "subtitle_id": 253,
      "start": 509.199,
      "end": 513.839,
      "text": "काफी धीमापन एक आ गया है। नंबर वन नंबर टू"
    },
    {
      "subtitle_id": 254,
      "start": 511.84,
      "end": 515.919,
      "text": "अब धीमापन आ गया है उसमें भी ज्यादातर"
    },
    {
      "subtitle_id": 255,
      "start": 513.839,
      "end": 517.76,
      "text": "ब्रोकर्स सीडीएसएल के पास है तो यह धीमापन"
    },
    {
      "subtitle_id": 256,
      "start": 515.919,
      "end": 519.519,
      "text": "आने वाले टाइम में भी जारी रहेगा। यहां पर"
    },
    {
      "subtitle_id": 257,
      "start": 517.76,
      "end": 521.519,
      "text": "एक ही चीज कंपनी यहां पर कर सकती है कि जो"
    },
    {
      "subtitle_id": 258,
      "start": 519.519,
      "end": 523.76,
      "text": "बड़े-बड़े ब्रोकर्स हैं उनको अपनी तरफ"
    },
    {
      "subtitle_id": 259,
      "start": 521.519,
      "end": 525.44,
      "text": "लाना या फिर कुछ तो भी और सशन ढूंढना। अब"
    },
    {
      "subtitle_id": 260,
      "start": 523.76,
      "end": 527.12,
      "text": "ये हो गया एक हिस्सा पार्ट का। सेकंड"
    },
    {
      "subtitle_id": 261,
      "start": 525.44,
      "end": 529.68,
      "text": "हिस्सा यह है कि इनका जो पेमेंट बिज़नेस"
    },
    {
      "subtitle_id": 262,
      "start": 527.12,
      "end": 531.6,
      "text": "है जहां से इनका 51% रेवेन्यू आ रहा है उस"
    },
    {
      "subtitle_id": 263,
      "start": 529.68,
      "end": 533.279,
      "text": "बिजनेस को देखा जाए। हम इसे बाकी प्लेयर्स"
    },
    {
      "subtitle_id": 264,
      "start": 531.6,
      "end": 535.279,
      "text": "से कंपेयर करके देखते हैं। तो यहां पर"
    },
    {
      "subtitle_id": 265,
      "start": 533.279,
      "end": 537.12,
      "text": "Airtel पेमेंट्स, Fino payments, India"
    },
    {
      "subtitle_id": 266,
      "start": 535.279,
      "end": 538.959,
      "text": "पोस्ट पेमेंट्स यह कुछ बड़े प्लेयर्स हैं।"
    },
    {
      "subtitle_id": 267,
      "start": 537.12,
      "end": 541.279,
      "text": "और इसमें प्रॉफिट के हिसाब से सबसे बड़ा"
    },
    {
      "subtitle_id": 268,
      "start": 538.959,
      "end": 543.279,
      "text": "जो प्लेयर है उसे देखकर आपको मजा आ जाएगा"
    },
    {
      "subtitle_id": 269,
      "start": 541.279,
      "end": 545.2,
      "text": "वो है फिलहाल इंडिया पोस्ट पेमेंट्स।"
    },
    {
      "subtitle_id": 270,
      "start": 543.279,
      "end": 547.04,
      "text": "इंडिया पोस्ट पेमेंट्स 134 करोड़ का"
    },
    {
      "subtitle_id": 271,
      "start": 545.2,
      "end": 548.399,
      "text": "प्रॉफिट है इसका। बहुत तेजी से प्रॉफिट भी"
    },
    {
      "subtitle_id": 272,
      "start": 547.04,
      "end": 549.76,
      "text": "उसका बढ़ रहा है। बहुत तेजी से रेवेन्यू"
    },
    {
      "subtitle_id": 273,
      "start": 548.399,
      "end": 551.36,
      "text": "भी बढ़ रहा है। तो कुछ इस तरह की"
    },
    {
      "subtitle_id": 274,
      "start": 549.76,
      "end": 553.2,
      "text": "परफॉर्मेंस एनएसडीएल पेमेंट्स को करनी"
    },
    {
      "subtitle_id": 275,
      "start": 551.36,
      "end": 554.959,
      "text": "पड़ेगी। Fino pmेंटs भी आप देख सकते हो।"
    },
    {
      "subtitle_id": 276,
      "start": 553.2,
      "end": 556.8,
      "text": "उसकी भी परफॉर्मेंस काफी तेजी से बढ़ रही"
    },
    {
      "subtitle_id": 277,
      "start": 554.959,
      "end": 558.399,
      "text": "है। तो यह एक चीज है कि यहां पर इनको जल्द"
    },
    {
      "subtitle_id": 278,
      "start": 556.8,
      "end": 560.24,
      "text": "से जल्द प्रॉफिटेबिलिटी लाने की जरूरत है।"
    },
    {
      "subtitle_id": 279,
      "start": 558.399,
      "end": 562.16,
      "text": "जो डीमेट वाला गेम है उसका पिछले 5 साल"
    },
    {
      "subtitle_id": 280,
      "start": 560.24,
      "end": 563.839,
      "text": "में तो ग्रोथ दिखी लेकिन वैसे ग्रोथ मुझे"
    },
    {
      "subtitle_id": 281,
      "start": 562.16,
      "end": 565.92,
      "text": "नहीं लगता अगले 5 साल में दिखेगी। अनलेस"
    },
    {
      "subtitle_id": 282,
      "start": 563.839,
      "end": 568.32,
      "text": "एंड अंटिल कोई बड़ा ब्रोकर एनएसएल के पास"
    },
    {
      "subtitle_id": 283,
      "start": 565.92,
      "end": 570.16,
      "text": "आता है। जो सिंपल ऑप्शन है उसके पास वो"
    },
    {
      "subtitle_id": 284,
      "start": 568.32,
      "end": 572.0,
      "text": "यही है कि पेमेंट्स बैंक बिनेस से बहुत"
    },
    {
      "subtitle_id": 285,
      "start": 570.16,
      "end": 573.279,
      "text": "अच्छी ग्रोथ लाना और वहां से बहुत अच्छा"
    },
    {
      "subtitle_id": 286,
      "start": 572.0,
      "end": 575.36,
      "text": "प्रॉफिट लाना। लेकिन वहां पर भी एक"
    },
    {
      "subtitle_id": 287,
      "start": 573.279,
      "end": 577.36,
      "text": "प्रॉब्लम यह है कि पेमेंट बैंक्स उनका जो"
    },
    {
      "subtitle_id": 288,
      "start": 575.36,
      "end": 579.92,
      "text": "बिजनेस है वो भी पिछले एक साल में धीमा हो"
    },
    {
      "subtitle_id": 289,
      "start": 577.36,
      "end": 581.68,
      "text": "गया है। 2024 में जहां 720 करोड़ का उनका"
    },
    {
      "subtitle_id": 290,
      "start": 579.92,
      "end": 583.76,
      "text": "रेवेन्यू था वो सिर्फ 2 करोड़ से बढ़ा है।"
    },
    {
      "subtitle_id": 291,
      "start": 581.68,
      "end": 586.0,
      "text": "अगले साल दोनों जगह पर ग्रोथ का एक बहुत"
    },
    {
      "subtitle_id": 292,
      "start": 583.76,
      "end": 587.6,
      "text": "बड़ा चैलेंज एनएसएल के पास है। वहीं पर"
    },
    {
      "subtitle_id": 293,
      "start": 586.0,
      "end": 589.279,
      "text": "अगर मैं शॉर्ट टर्म की बात करूं तो फिलहाल"
    },
    {
      "subtitle_id": 294,
      "start": 587.6,
      "end": 591.68,
      "text": "कंपनी का जो ग्रे मार्केट प्रीमियम है"
    },
    {
      "subtitle_id": 295,
      "start": 589.279,
      "end": 593.44,
      "text": "अराउंड 18% के आसपास चल रहा है। वीडियो"
    },
    {
      "subtitle_id": 296,
      "start": 591.68,
      "end": 594.64,
      "text": "रिकॉर्ड करते टाइम और जब आप आईपीओ में"
    },
    {
      "subtitle_id": 297,
      "start": 593.44,
      "end": 596.32,
      "text": "अप्लाई करेंगे तो उस टाइम भी आप ग्रे"
    },
    {
      "subtitle_id": 298,
      "start": 594.64,
      "end": 597.839,
      "text": "मार्केट प्रीमियम यानी जीएमपी जरूर देख"
    },
    {
      "subtitle_id": 299,
      "start": 596.32,
      "end": 599.44,
      "text": "लेना। लेकिन ओवरऑल अगर लॉन्ग टर्म के"
    },
    {
      "subtitle_id": 300,
      "start": 597.839,
      "end": 601.12,
      "text": "हिसाब से देखें तो मुझे कंपनी कहीं ना"
    },
    {
      "subtitle_id": 301,
      "start": 599.44,
      "end": 603.44,
      "text": "कहीं थोड़ी ओवरवैल्यूड लगती है। और रही"
    },
    {
      "subtitle_id": 302,
      "start": 601.12,
      "end": 605.04,
      "text": "शॉर्ट टर्म की बात तो उसमें पूरा गेम"
    },
    {
      "subtitle_id": 303,
      "start": 603.44,
      "end": 606.8,
      "text": "कितना टाइम सब्सक्राइब होता है आईपीओ और"
    },
    {
      "subtitle_id": 304,
      "start": 605.04,
      "end": 608.32,
      "text": "कितना जीएमपी है वो दोनों चीजें देख के ही"
    },
    {
      "subtitle_id": 305,
      "start": 606.8,
      "end": 609.839,
      "text": "पता किया जा सकता है। तो फिलहाल आज हम"
    },
    {
      "subtitle_id": 306,
      "start": 608.32,
      "end": 611.44,
      "text": "यहां पर रुकते हैं। आई होप एनएसडीएल का"
    },
    {
      "subtitle_id": 307,
      "start": 609.839,
      "end": 613.44,
      "text": "बिज़नेस आपके लिए अब एकदम क्रिस्टल क्लियर"
    },
    {
      "subtitle_id": 308,
      "start": 611.44,
      "end": 614.88,
      "text": "हो गया होगा। ग्रोथ के लिए क्या देखना है"
    },
    {
      "subtitle_id": 309,
      "start": 613.44,
      "end": 616.48,
      "text": "यहां से आगे जो भी कंपनी के क्वार्टरली"
    },
    {
      "subtitle_id": 310,
      "start": 614.88,
      "end": 618.16,
      "text": "रिजल्ट्स आएंगे तो उस टाइम आपको देखना है"
    },
    {
      "subtitle_id": 311,
      "start": 616.48,
      "end": 619.519,
      "text": "कि इनके पेमेंट बिज़नेस से कितना रेवन्यू"
    },
    {
      "subtitle_id": 312,
      "start": 618.16,
      "end": 621.04,
      "text": "कितना प्रॉफिट आ रहा है। तो उस चीज को"
    },
    {
      "subtitle_id": 313,
      "start": 619.519,
      "end": 622.72,
      "text": "आपको बहुत बारीकी से देखना पड़ेगा। और"
    },
    {
      "subtitle_id": 314,
      "start": 621.04,
      "end": 623.839,
      "text": "जाते-जाते क्रेडिट पे को भी जरूर चेक आउट"
    },
    {
      "subtitle_id": 315,
      "start": 622.72,
      "end": 625.279,
      "text": "कीजिए। लिंक नीचे डिस्क्रिप्शन में और"
    },
    {
      "subtitle_id": 316,
      "start": 623.839,
      "end": 626.8,
      "text": "कमेंट बॉक्स में दी गई है। जहां पर आपका"
    },
    {
      "subtitle_id": 317,
      "start": 625.279,
      "end": 628.32,
      "text": "जो क्रेडिट स्कोर है उसे इंप्रूव करने का"
    },
    {
      "subtitle_id": 318,
      "start": 626.8,
      "end": 630.24,
      "text": "एक बहुत अच्छा मौका आपके हाथ में है। कोई"
    },
    {
      "subtitle_id": 319,
      "start": 628.32,
      "end": 631.92,
      "text": "हिडन चार्जेस नहीं। बड़ा ही सिंपल सा यह"
    },
    {
      "subtitle_id": 320,
      "start": 630.24,
      "end": 633.6,
      "text": "कार्ड है। सो यू कैन चेक इट आउट। बट अगेन"
    },
    {
      "subtitle_id": 321,
      "start": 631.92,
      "end": 635.279,
      "text": "इट इज़ अ क्रेडिट कार्ड। तो सही चीजों के"
    },
    {
      "subtitle_id": 322,
      "start": 633.6,
      "end": 637.2,
      "text": "लिए और सही तरीके से उसका इस्तेमाल कीजिए।"
    },
    {
      "subtitle_id": 323,
      "start": 635.279,
      "end": 639.12,
      "text": "अदरवाइज इट इज अ डबल एजेट स्वार्ड। तो दो"
    },
    {
      "subtitle_id": 324,
      "start": 637.2,
      "end": 640.959,
      "text": "धारी तलवार की तरह यह चीज होती है। तो उसे"
    },
    {
      "subtitle_id": 325,
      "start": 639.12,
      "end": 642.56,
      "text": "संभल के इस्तेमाल करना है और अपने फायदे"
    },
    {
      "subtitle_id": 326,
      "start": 640.959,
      "end": 643.92,
      "text": "के लिए ही इस्तेमाल करना है। तो फिलहाल हम"
    },
    {
      "subtitle_id": 327,
      "start": 642.56,
      "end": 645.92,
      "text": "यहीं पर रुकते हैं। थैंक यू सो मच फॉर"
    },
    {
      "subtitle_id": 328,
      "start": 643.92,
      "end": 649.079,
      "text": "वाचिंग। मिलते हैं अगले वीडियो में। बाय-ब"
    },
    {
      "subtitle_id": 329,
      "start": 645.92,
      "end": 649.079,
      "text": "टेक केयर।"
    }
  ]
}