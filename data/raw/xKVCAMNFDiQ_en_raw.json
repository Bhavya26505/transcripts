    },
    {
      "subtitle_id": 257,
      "start": 517.599,
      "end": 520.8,
      "text": "और बहुत सारी रिसर्च रिपोर्ट ये जो कंपनीज़"
    },
    {
      "subtitle_id": 258,
      "start": 519.12,
      "end": 522.719,
      "text": "इशू करती है इसमें से बहुत सारे तो सिर्फ"
    },
    {
      "subtitle_id": 259,
      "start": 520.8,
      "end": 524.0,
      "text": "शॉर्ट टर्म इंट्राडे वगैरह होते हैं। मेरे"
    },
    {
      "subtitle_id": 260,
      "start": 522.719,
      "end": 526.0,
      "text": "हिसाब से रिसर्च रिपोर्ट में एक ही चीज"
    },
    {
      "subtitle_id": 261,
      "start": 524.0,
      "end": 527.44,
      "text": "सेंस बनाती है वो है लॉन्ग टर्म के रिसर्च"
    },
    {
      "subtitle_id": 262,
      "start": 526.0,
      "end": 529.12,
      "text": "रिपोर्ट कि लॉन्ग टर्म में भाई क्या होगा?"
    },
    {
      "subtitle_id": 263,
      "start": 527.44,
      "end": 530.64,
      "text": "एक्चुअली वी आर आल्सो आर लेकिन हम शॉर्ट"
    },
    {
      "subtitle_id": 264,
      "start": 529.12,
      "end": 532.24,
      "text": "टर्म में कभी भी रिसर्च रिपोर्ट नहीं"
    },
    {
      "subtitle_id": 265,
      "start": 530.64,
      "end": 534.08,
      "text": "प्रोवाइड करते। हमारे जो भी रिसर्च"
    },
    {
      "subtitle_id": 266,
      "start": 532.24,
      "end": 535.92,
      "text": "रिपोर्ट्स हैं वो भी लॉन्ग टर्म ही है जो"
    },
    {
      "subtitle_id": 267,
      "start": 534.08,
      "end": 538.0,
      "text": "हमारी कम्युनिटी प्रोमियम प्रोवाइड करते"
    },
    {
      "subtitle_id": 268,
      "start": 535.92,
      "end": 539.68,
      "text": "हैं। और जहां तक बात आती है कस टेक्नोलॉजी"
    },
    {
      "subtitle_id": 269,
      "start": 538.0,
      "end": 541.839,
      "text": "के वैल्यू्यूएशन की तो देखिए 4 नवंबर के"
    },
    {
      "subtitle_id": 270,
      "start": 539.68,
      "end": 543.519,
      "text": "क्वार्टरली रिजल्ट्स अच्छे आए थे। मोतीलाल"
    },
    {
      "subtitle_id": 271,
      "start": 541.839,
      "end": 545.36,
      "text": "की रिपोर्ट भी अच्छे आई थी। लेकिन आप"
    },
    {
      "subtitle_id": 272,
      "start": 543.519,
      "end": 548.08,
      "text": "देखिए शेयर्स के हालात ये 4 नवंबर से ही"
    },
    {
      "subtitle_id": 273,
      "start": 545.36,
      "end": 549.92,
      "text": "गिर रहे हैं। रीजन 100 के ऊपर इसका पीई चल"
    },
    {
      "subtitle_id": 274,
      "start": 548.08,
      "end": 551.279,
      "text": "रहा था और लेकिन जिस हिसाब से क्रेजी"
    },
    {
      "subtitle_id": 275,
      "start": 549.92,
      "end": 553.44,
      "text": "वैल्यू्यूएशन कंपनी का बढ़ा है वो"
    },
    {
      "subtitle_id": 276,
      "start": 551.279,
      "end": 555.44,
      "text": "वैल्यू्यूएशन लंबे समय तक सस्टेन रहना"
    },
    {
      "subtitle_id": 277,
      "start": 553.44,
      "end": 557.519,
      "text": "काफी मुश्किल हो जाता है। तो इसलिए जो भी"
    },
    {
      "subtitle_id": 278,
      "start": 555.44,
      "end": 558.959,
      "text": "लोग रिसर्च रिपोर्ट पर डिपेंड करते हैं"
    },
    {
      "subtitle_id": 279,
      "start": 557.519,
      "end": 561.12,
      "text": "मैं उनसे सजेस्ट करूंगा भाई शॉर्ट टर्म"
    },
    {
      "subtitle_id": 280,
      "start": 558.959,
      "end": 562.959,
      "text": "में तो बिल्कुल भी ध्यान मत दो। लॉन्ग"
    },
    {
      "subtitle_id": 281,
      "start": 561.12,
      "end": 564.88,
      "text": "टर्म का रहेगा तो थोड़ा बहुत रेफरेंस लो"
    },
    {
      "subtitle_id": 282,
      "start": 562.959,
      "end": 566.72,
      "text": "और खुद का भी एनालिसिस करो। तो बाकी आपकी"
    },
    {
      "subtitle_id": 283,
      "start": 564.88,
      "end": 568.88,
      "text": "क्या राय है इस केस पर? नीचे कमेंट करके"
    },
    {
      "subtitle_id": 284,
      "start": 566.72,
      "end": 571.2,
      "text": "जरूर बताइए। और क्या एक ग्रुप में सेल"
    },
    {
      "subtitle_id": 285,
      "start": 568.88,
      "end": 573.279,
      "text": "साइड और बाय साइड दोनों होने चाहिए? यह भी"
    },
    {
      "subtitle_id": 286,
      "start": 571.2,
      "end": 574.88,
      "text": "कमेंट करके जरूर बताइए। सो, मिलते हैं"
    },
    {
      "subtitle_id": 287,
      "start": 573.279,
      "end": 576.399,
      "text": "अगले वीडियो में। एंड थैंक यू सो मच फॉर"
    },
    {
      "subtitle_id": 288,
      "start": 574.88,
      "end": 578.0,
      "text": "वाचिंग दिस। और हां, जाते-जाते वैल्यू"
    },
    {
      "subtitle_id": 289,
      "start": 576.399,
      "end": 580.0,
      "text": "इंस्टिंग कोहर्ट को जरूर चेक आउट कीजिए।"
    },
    {
      "subtitle_id": 290,
      "start": 578.0,
      "end": 582.0,
      "text": "सीट्स बहुत जल्दी फील हो रही है। तो, बैच"
    },
    {
      "subtitle_id": 291,
      "start": 580.0,
      "end": 583.2,
      "text": "फील होने से पहले जरूर एनरोल कीजिए। लिंक"
    },
    {
      "subtitle_id": 292,
      "start": 582.0,
      "end": 585.6,
      "text": "नीचे डिस्क्रिप्शन और कमेंट बॉक्स में"
    },
    {
      "subtitle_id": 293,
      "start": 583.2,
      "end": 585.6,
      "text": "आपको मिल जाएगी।"
    }
  ]
}