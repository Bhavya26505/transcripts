      "subtitle_id": 191,
      "start": 387.599,
      "end": 391.0,
      "text": "हो मतलब अगर प्रॉफिट दो गुना बढ़ रहा है"
    },
    {
      "subtitle_id": 192,
      "start": 389.56,
      "end": 392.56,
      "text": "शेयर प्राइस भी दो-तीन गुना बढ़ रही है तो"
    },
    {
      "subtitle_id": 193,
      "start": 391.0,
      "end": 393.84,
      "text": "बात समझ में आती है लेकिन आजकल ऐसा हो रहा"
    },
    {
      "subtitle_id": 194,
      "start": 392.56,
      "end": 395.759,
      "text": "है कि प्रॉफिट दो गुना बढ़ रहा है शेयर"
    },
    {
      "subtitle_id": 195,
      "start": 393.84,
      "end": 397.599,
      "text": "प्राइस 10 गुना बढ़ रही है तो उन चीजों पर"
    },
    {
      "subtitle_id": 196,
      "start": 395.759,
      "end": 399.24,
      "text": "भी आपको ध्यान रखना पड़ेगा तो इसलिए अपना"
    },
    {
      "subtitle_id": 197,
      "start": 397.599,
      "end": 401.039,
      "text": "फंडामेंटल एनालिसिस खुद करें दूसरों पर"
    },
    {
      "subtitle_id": 198,
      "start": 399.24,
      "end": 402.599,
      "text": "डिपेंड ना रहे आज हर जगह आईसीसीई"
    },
    {
      "subtitle_id": 199,
      "start": 401.039,
      "end": 404.44,
      "text": "सिक्योरिटीज के रिपोर्ट की चर्चा हो रही"
    },
    {
      "subtitle_id": 200,
      "start": 402.599,
      "end": 406.319,
      "text": "है हर कोई इस पर वीडियो बना रहा है कंटेंट"
    },
    {
      "subtitle_id": 201,
      "start": 404.44,
      "end": 408.039,
      "text": "बन रहा है लेकिन आपको यह भी देखने की"
    },
    {
      "subtitle_id": 202,
      "start": 406.319,
      "end": 410.039,
      "text": "जरूरत है कि जो भी इंस्टिट्यूट इस तरह की"
    },
    {
      "subtitle_id": 203,
      "start": 408.039,
      "end": 411.72,
      "text": "रिपोर्ट्स पब्लिश करता है उनकी एक्यूरेसी"
    },
    {
      "subtitle_id": 204,
      "start": 410.039,
      "end": 413.36,
      "text": "अब तक क्या रही है और एक चीज तो मैंने"
    },
    {
      "subtitle_id": 205,
      "start": 411.72,
      "end": 415.68,
      "text": "देखी कि मार्केट में अगर आपको पैसा कमाना"
    },
    {
      "subtitle_id": 206,
      "start": 413.36,
      "end": 417.919,
      "text": "है तो आपके खुद के रिसर्च से ही वह बनेगा"
    },
    {
      "subtitle_id": 207,
      "start": 415.68,
      "end": 419.16,
      "text": "किसी और के टीप पर किसी और के रिपोर्ट पर"
    },
    {
      "subtitle_id": 208,
      "start": 417.919,
      "end": 420.68,
      "text": "या कोई वीडियो देख के अगर आप स्टॉक"
    },
    {
      "subtitle_id": 209,
      "start": 419.16,
      "end": 422.44,
      "text": "सिलेक्ट कर रहे हैं उसमें इन्वेस्ट कर रहे"
    },
    {
      "subtitle_id": 210,
      "start": 420.68,
      "end": 424.12,
      "text": "हैं सो दैट इज नॉट द वे अगर आप उस तरह से"
    },
    {
      "subtitle_id": 211,
      "start": 422.44,
      "end": 425.919,
      "text": "चलेंगे तो आप ज्यादा देर मार्केट में टिक"
    },
    {
      "subtitle_id": 212,
      "start": 424.12,
      "end": 427.639,
      "text": "नहीं पाएंगे इतना मैं गारंटी के साथ बता"
    },
    {
      "subtitle_id": 213,
      "start": 425.919,
      "end": 429.599,
      "text": "सकता हूं तो आज हम यहीं पर रुकते हैं"
    },
    {
      "subtitle_id": 214,
      "start": 427.639,
      "end": 431.24,
      "text": "मिलते हैं अगले वीडियो में और चैनल को"
    },
    {
      "subtitle_id": 215,
      "start": 429.599,
      "end": 432.8,
      "text": "जरूर सब्सक्राइब करके रखिए ताकि शेयर"
    },
    {
      "subtitle_id": 216,
      "start": 431.24,
      "end": 434.24,
      "text": "मार्केट के इसी तरह के आंख खोलने वाले"
    },
    {
      "subtitle_id": 217,
      "start": 432.8,
      "end": 435.8,
      "text": "इंटरेस्टिंग वीडियोस आपको मिलते रहेंगे"
    },
    {
      "subtitle_id": 218,
      "start": 434.24,
      "end": 437.44,
      "text": "अगर आप शेयर मार्केट में बहुत ज्यादा रुचि"
    },
    {
      "subtitle_id": 219,
      "start": 435.8,
      "end": 438.68,
      "text": "रखते हैं तो बेल आइकॉन पर भी क्लिक करें"
    },
    {
      "subtitle_id": 220,
      "start": 437.44,
      "end": 440.68,
      "text": "आपको हमारे इंपोर्टेंट वीडियोस का"
    },
    {
      "subtitle_id": 221,
      "start": 438.68,
      "end": 444.24,
      "text": "नोटिफिकेशन तब आता रहेगा थैंक यू सो मच"
    },
    {
      "subtitle_id": 222,
      "start": 440.68,
      "end": 444.24,
      "text": "फॉर वाचिंग दिस वीडियो"
    }
  ]
}