    {
      "subtitle_id": 1,
      "start": 0.0,
      "end": 7.96,
      "text": "मागा डॉग 77 गिरने वाला है गार्डन रेज 75"
    },
    {
      "subtitle_id": 2,
      "start": 4.16,
      "end": 10.519,
      "text": "इतना ही नहीं s बैंक 23 रुकिए और भी है"
    },
    {
      "subtitle_id": 3,
      "start": 7.96,
      "end": 12.559,
      "text": "रेलटेल 37 पर से गिरने वाला है ऐसा मैं"
    },
    {
      "subtitle_id": 4,
      "start": 10.519,
      "end": 14.28,
      "text": "नहीं आईसीआई की रिसेंट इक्विटी रिपोर्ट कह"
    },
    {
      "subtitle_id": 5,
      "start": 12.559,
      "end": 16.16,
      "text": "रही है तो बात यह कि 15-20 दिन पहले"
    },
    {
      "subtitle_id": 6,
      "start": 14.28,
      "end": 18.24,
      "text": "आईसीआई सिक्योरिटीज ने कुछ स्टॉक्स पर"
    },
    {
      "subtitle_id": 7,
      "start": 16.16,
      "end": 20.0,
      "text": "मल्टीपल रिसर्च रिपोर्ट्स पब्लिश की अब यह"
    },
    {
      "subtitle_id": 8,
      "start": 18.24,
      "end": 21.88,
      "text": "रिपोर्ट्स तब आ रही है जब मासगा डॉक और"
    },
    {
      "subtitle_id": 9,
      "start": 20.0,
      "end": 25.08,
      "text": "गार्डन रीच दोनों अपने जुलाई मंथ के"
    },
    {
      "subtitle_id": 10,
      "start": 21.88,
      "end": 27.96,
      "text": "रिकॉर्ड हाई लेवल से 26 और 37 पर नीचे आए"
    },
    {
      "subtitle_id": 11,
      "start": 25.08,
      "end": 31.64,
      "text": "हैं इस रिपोर्ट के बाद मंडे को मासगा डॉक"
    },
    {
      "subtitle_id": 12,
      "start": 27.96,
      "end": 33.6,
      "text": "9 पर गार्डन रिज 7 पर और रेलटेल 1.22 पर"
    },
    {
      "subtitle_id": 13,
      "start": 31.64,
      "end": 34.96,
      "text": "से गिर चुके हैं इस रिपोर्ट के बाद बहुत"
    },
    {
      "subtitle_id": 14,
      "start": 33.6,
      "end": 36.719,
      "text": "सारे इन्वेस्टर्स के दिमाग में ये सवाल"
    },
    {
      "subtitle_id": 15,
      "start": 34.96,
      "end": 38.84,
      "text": "आने लगा है कि क्या ये इंडिकेशन है कि"
    },
    {
      "subtitle_id": 16,
      "start": 36.719,
      "end": 41.079,
      "text": "इंडियन मार्केट में बहुत सारी कंपनीज बबल"
    },
    {
      "subtitle_id": 17,
      "start": 38.84,
      "end": 42.92,
      "text": "में हैं जिसके बाद पैनिक का माहौल बना है"
    },
    {
      "subtitle_id": 18,
      "start": 41.079,
      "end": 44.48,
      "text": "हर एक सोशल मीडिया प्लेटफॉर्म पर इसी"
    },
    {
      "subtitle_id": 19,
      "start": 42.92,
      "end": 46.199,
      "text": "रिपोर्ट की चर्चा हो रही है और उसका"
    },
    {
      "subtitle_id": 20,
      "start": 44.48,
      "end": 48.079,
      "text": "इंपैक्ट भी हमें मंडे को देखने मिला तो"
    },
    {
      "subtitle_id": 21,
      "start": 46.199,
      "end": 50.32,
      "text": "क्या आईसीआईसी की ये रिपोर्ट सच साबित"
    },
    {
      "subtitle_id": 22,
      "start": 48.079,
      "end": 51.879,
      "text": "होगी और स्टॉक और गिरेंगे या फिर आने वाले"
    },
    {
      "subtitle_id": 23,
      "start": 50.32,
      "end": 53.44,
      "text": "फ्यूचर में इस रिपोर्ट को भी लोग उसी तरह"
    },
    {
      "subtitle_id": 24,
      "start": 51.879,
      "end": 55.28,
      "text": "इग्नोर करेंगे जैसे रिसेंटली लोगों ने"
    },
    {
      "subtitle_id": 25,
      "start": 53.44,
      "end": 56.96,
      "text": "हिंडन बक की रिपोर्ट को किया है इसी के"
    },
    {
      "subtitle_id": 26,
      "start": 55.28,
      "end": 58.519,
      "text": "साथ हम बात करेंगे कि और भी कौन-कौन से"
    },
    {
      "subtitle_id": 27,
      "start": 56.96,
      "end": 60.399,
      "text": "स्टॉक है जिसके बारे में आईसीआई ने यहां"
    },
    {
      "subtitle_id": 28,
      "start": 58.519,
      "end": 62.0,
      "text": "पर बात की है और साथ ही सबसे इंपोर्टेंट"
    },
    {
      "subtitle_id": 29,
      "start": 60.399,
      "end": 63.8,
      "text": "हम आईएसआई सिक्योरिटीज के रिपोर्ट्स का"
    },
    {
      "subtitle_id": 30,
      "start": 62.0,
      "end": 65.799,
      "text": "ट्रैक रिकॉर्ड चेक करेंगे कि पहले"
    },
    {
      "subtitle_id": 31,
      "start": 63.8,
      "end": 67.64,
      "text": "उन्होंने क्या कुछ प्रिडिक्ट किया है और"
    },
    {
      "subtitle_id": 32,
      "start": 65.799,
      "end": 69.24,
      "text": "क्या कुछ हुआ है तो अगर किसी भी गवर्नमेंट"
    },
    {
      "subtitle_id": 33,
      "start": 67.64,
      "end": 70.72,
      "text": "स्टॉक में आपकी इन्वेस्टमेंट है या फिर"
    },
    {
      "subtitle_id": 34,
      "start": 69.24,
      "end": 73.119,
      "text": "करने की प्लानिंग कर रहे हो तो यह वीडियो"
    },
    {
      "subtitle_id": 35,
      "start": 70.72,
      "end": 74.6,
      "text": "बहुत इंपॉर्टेंट होने जा रही है नमस्कार"
    },
    {
      "subtitle_id": 36,
      "start": 73.119,
      "end": 76.4,
      "text": "मैं प्रसाद आपका आज के इस वीडियो में"
    },
    {
      "subtitle_id": 37,
      "start": 74.6,
      "end": 78.72,
      "text": "स्वागत करता हूं तो सबसे पहले बात करते"
    },
    {
      "subtitle_id": 38,
      "start": 76.4,
      "end": 80.2,
      "text": "हैं मासगा डॉक के स्टॉक परफॉर्मेंस की अगर"
    },
    {
      "subtitle_id": 39,
      "start": 78.72,
      "end": 81.759,
      "text": "इस शेयर के रिटर्न्स की बात करें तो इस"
    },
    {
      "subtitle_id": 40,
      "start": 80.2,
      "end": 83.4,
      "text": "स्टॉक ने मल्टीबैगर रिटर्न्स दिए हैं"
    },
    {
      "subtitle_id": 41,
      "start": 81.759,
      "end": 85.72,
      "text": "सिर्फ 2 साल पहले ये स्टॉक ट्रेड कर रहा"
    },
    {
      "subtitle_id": 42,
      "start": 83.4,
      "end": 88.96,
      "text": "था 250 के अराउंड और अब ये ट्रेड कर रहा"
    },
    {
      "subtitle_id": 43,
      "start": 85.72,
      "end": 91.64,
      "text": "है ₹ 300 पर वही 5 साल के रिटर्न्स की बात"
    },
    {
      "subtitle_id": 44,
      "start": 88.96,
      "end": 93.68,
      "text": "करें तो स्टॉक ने क्लोज 2400 पर का रिटर्न"
    },
    {
      "subtitle_id": 45,
      "start": 91.64,
      "end": 95.159,
      "text": "दिया है व्हिच इज रियली रियली क्रेजी पर"
    },
    {
      "subtitle_id": 46,
      "start": 93.68,
      "end": 97.119,
      "text": "क्या यह रिटर्न्स रेवेन्यू और प्रॉफिट"
    },
    {
      "subtitle_id": 47,
      "start": 95.159,
      "end": 99.079,
      "text": "बैकड है मतलब क्या बिजनेस में भी बढ़ोतरी"
    },
    {
      "subtitle_id": 48,
      "start": 97.119,
      "end": 101.36,
      "text": "हुई है तो जैसे कि आप देख सकते हैं कि 3"
    },
    {
      "subtitle_id": 49,
      "start": 99.079,
      "end": 103.84,
      "text": "साल में सेल्स ग्रोथ हुई है 33 की प्रॉफिट"
    },
    {
      "subtitle_id": 50,
      "start": 101.36,
      "end": 106.399,
      "text": "ग्रोथ हुई है कंपाउंड वेट सालाना 47 पर की"
    },
    {
      "subtitle_id": 51,
      "start": 103.84,
      "end": 109.2,
      "text": "और करेंटली जो पी रेशो स्टॉक है वो 37.4"
    },
    {
      "subtitle_id": 52,
      "start": 106.399,
      "end": 110.88,
      "text": "का है जो कि जुलाई 2024 में 60 तक चला गया"
    },
    {
      "subtitle_id": 53,
      "start": 109.2,
      "end": 112.399,
      "text": "था अब मान लेते हैं कि आईएसआई का ये"
    },
    {
      "subtitle_id": 54,
      "start": 110.88,
      "end": 114.28,
      "text": "प्रेडिक्शन सही साबित होता है तो क्या"
    },
    {
      "subtitle_id": 55,
      "start": 112.399,
      "end": 117.039,
      "text": "होगा उसके बारे में एक बार बात करते हैं"
    },
    {
      "subtitle_id": 56,
      "start": 114.28,
      "end": 120.479,
      "text": "तो अगर यह स्टॉक 75 से गिर जाता है तब इस"
    },
    {
      "subtitle_id": 57,
      "start": 117.039,
      "end": 122.479,
      "text": "शेयर की प्राइस ₹ 300 से सीधा ₹ ₹ पर आ"
    },
    {
      "subtitle_id": 58,
      "start": 120.479,
      "end": 124.2,
      "text": "जाएगी इसका ईपीएस लगभग 115 पर आ जाएगा और"
    },
    {
      "subtitle_id": 59,
      "start": 122.479,
      "end": 126.039,
      "text": "प्राइस टू अर्निंग रेशो 10 के भी नीचे चला"
    },
    {
      "subtitle_id": 60,
      "start": 124.2,
      "end": 127.96,
      "text": "जाएगा क्योंकि बिजनेस कंटीन्यूअसली ग्रो"
    },
    {
      "subtitle_id": 61,
      "start": 126.039,
      "end": 129.84,
      "text": "कर रहा है तो पी रेशो काफी तेजी से 10 से"
    },
    {
      "subtitle_id": 62,
      "start": 127.96,
      "end": 131.12,
      "text": "नीचे चला जाएगा अगर हम डाटा की तरफ देखें"
    },
    {
      "subtitle_id": 63,
      "start": 129.84,
      "end": 132.64,
      "text": "तो वो वाला सीन नहीं है कि बस शेयर"
    },
    {
      "subtitle_id": 64,
      "start": 131.12,
      "end": 134.2,
      "text": "प्राइसेस बढ़ रही है और प्रॉफिट बिल्कुल"
    },
    {
      "subtitle_id": 65,
      "start": 132.64,
      "end": 135.68,
      "text": "भी नहीं बढ़ रहा है अब यहां पर देखा जाए"
    },
    {
      "subtitle_id": 66,
      "start": 134.2,
      "end": 137.2,
      "text": "तो दोनों चीजें बढ़ रही है स्टॉक प्राइस"
    },
    {
      "subtitle_id": 67,
      "start": 135.68,
      "end": 138.879,
      "text": "भी बढ़ रही है कंपनी के फाइनेंशियल्स भी"
    },
    {
      "subtitle_id": 68,
      "start": 137.2,
      "end": 140.68,
      "text": "बढ़ रहे हैं पर हां स्टॉक प्राइस जो है वो"
    },
    {
      "subtitle_id": 69,
      "start": 138.879,
      "end": 143.12,
      "text": "बिजनेस परफॉर्मेंस से तेजी से बढ़ रही है"
    },
    {
      "subtitle_id": 70,
      "start": 140.68,
      "end": 145.08,
      "text": "लेकिन मंडे की ड्रॉप के बाद p37 पर पहुंच"
    },
    {
      "subtitle_id": 71,
      "start": 143.12,
      "end": 146.879,
      "text": "गया है जो कि इंडस्ट्री के 35 एवरेज से"
    },
    {
      "subtitle_id": 72,
      "start": 145.08,
      "end": 148.319,
      "text": "काफी क्लोज है तो आईएसआई सिक्योरिटीज की"
    },
    {
      "subtitle_id": 73,
      "start": 146.879,
      "end": 150.319,
      "text": "माने तो ये जो प्राइस टू अर्निंग रेशो है"
    },
    {
      "subtitle_id": 74,
      "start": 148.319,
      "end": 152.44,
      "text": "ये 10 के काफी नीचे होना चाहिए पर क्या ये"
    },
    {
      "subtitle_id": 75,
      "start": 150.319,
      "end": 153.959,
      "text": "प्रैक्टिकल है तो ये चीज आप ही कमेंट करके"
    },
    {
      "subtitle_id": 76,
      "start": 152.44,
      "end": 155.28,
      "text": "बताइए अब इंडिया में देखा जाए तो बहुत"
    },
    {
      "subtitle_id": 77,
      "start": 153.959,
      "end": 156.879,
      "text": "सारे लोग रिसेंटली शेयर मार्केट में"
    },
    {
      "subtitle_id": 78,
      "start": 155.28,
      "end": 158.64,
      "text": "इन्वेस्ट करने लगे हैं लेकिन सेबी के एक"
    },
    {
      "subtitle_id": 79,
      "start": 156.879,
      "end": 161.0,
      "text": "रिपोर्ट के अनुसार इनमें से ज्यादातर लोग"
    },
    {
      "subtitle_id": 80,
      "start": 158.64,
      "end": 162.92,
      "text": "लॉसेस फेस कर रहे हैं इसका प्राइमरी रीजन"
    },
    {
      "subtitle_id": 81,
      "start": 161.0,
      "end": 164.64,
      "text": "यही है कि ये लोग आजूबाजू में जो भी चीजें"
    },
    {
      "subtitle_id": 82,
      "start": 162.92,
      "end": 166.56,
      "text": "हो रही है किसी पर भी भरोसा करते हैं और"
    },
    {
      "subtitle_id": 83,
      "start": 164.64,
      "end": 168.159,
      "text": "उन शेयर्स को खरीदने लगते हैं तो इन चीजों"
    },
    {
      "subtitle_id": 84,
      "start": 166.56,
      "end": 170.12,
      "text": "को रेक्टिफाई करने का सुधारने का एक ही"
    },
    {
      "subtitle_id": 85,
      "start": 168.159,
      "end": 172.36,
      "text": "सलूशन है वोही कि आप इन खुद चीजों को"
    },
    {
      "subtitle_id": 86,
      "start": 170.12,
      "end": 174.36,
      "text": "समझिए और खुद के रिसर्च के बेसिस पर किसी"
    },
    {
      "subtitle_id": 87,
      "start": 172.36,
      "end": 176.08,
      "text": "भी स्टॉक को पिक कीजिए और इसके लिए आपको"
    },
    {
      "subtitle_id": 88,
      "start": 174.36,
      "end": 177.959,
      "text": "एक चीज सीखनी होगी जिसका नाम है फंडामेंटल"
    },
    {
      "subtitle_id": 89,
      "start": 176.08,
      "end": 180.2,
      "text": "एनालिसिस इस इंडिपेंडेंस डे हमने लॉच किया"
    },
    {
      "subtitle_id": 90,
      "start": 177.959,
      "end": 182.28,
      "text": "है फंडामेंटल एनालिसिस 2.0 जहां यहां पर"
    },
    {
      "subtitle_id": 91,
      "start": 180.2,
      "end": 184.0,
      "text": "एक बिगनर भी बड़े आसानी से फंडामेंटल"
    },
    {
      "subtitle_id": 92,
      "start": 182.28,
      "end": 185.92,
      "text": "एलिसिस के बेसिक से लेकर एडवांस तक सारी"
    },
    {
      "subtitle_id": 93,
      "start": 184.0,
      "end": 187.56,
      "text": "चीजें सीख सकता है इंक्लूडिंग फॉरेंसिक"
    },
    {
      "subtitle_id": 94,
      "start": 185.92,
      "end": 189.2,
      "text": "एनालिसिस एंड वैल्युएशन काफी सारी"
