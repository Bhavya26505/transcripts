  "segments": [
    {
      "subtitle_id": 1,
      "start": 3.719,
      "end": 7.56,
      "text": "इनकी ऐड आपने जरूर कभी ना कभी देखी होगी"
    },
    {
      "subtitle_id": 2,
      "start": 5.839,
      "end": 9.92,
      "text": "जो अपने आप को शी वुल्फ ऑफ द स्टॉक"
    },
    {
      "subtitle_id": 3,
      "start": 7.56,
      "end": 11.799,
      "text": "मार्केट कहलाती है और वादा करती कि सिर्फ"
    },
    {
      "subtitle_id": 4,
      "start": 9.92,
      "end": 14.28,
      "text": "15 मिनट के अंदर आप ट्रेडिंग शुरू कर सकते"
    },
    {
      "subtitle_id": 5,
      "start": 11.799,
      "end": 17.199,
      "text": "हो और अगर आप हमारे कोर्सेस लेते हो तो आप"
    },
    {
      "subtitle_id": 6,
      "start": 14.28,
      "end": 18.92,
      "text": "100% प्रॉफिट कमा सकते हो इसी तरह हजारों"
    },
    {
      "subtitle_id": 7,
      "start": 17.199,
      "end": 21.96,
      "text": "की संख्या में लोगों ने इनके कोर्सेस खरीद"
    },
    {
      "subtitle_id": 8,
      "start": 18.92,
      "end": 24.96,
      "text": "लिए लेकिन आगे क्या हुआ जिसके चलते सेबी"
    },
    {
      "subtitle_id": 9,
      "start": 21.96,
      "end": 27.08,
      "text": "ने सीधा इनका 54 करोड़ का फंड फ्रीज कर"
    },
    {
      "subtitle_id": 10,
      "start": 24.96,
      "end": 29.56,
      "text": "दिया है और इसके साथ ही सेबी ने एक शो कॉज"
    },
    {
      "subtitle_id": 11,
      "start": 27.08,
      "end": 31.72,
      "text": "नोटिस भी भेजा है कि और 50 करोड़ आपके हम"
    },
    {
      "subtitle_id": 12,
      "start": 29.56,
      "end": 33.48,
      "text": "क्यों फ्रीज ना करें तो मैं बात कर रहा हं"
    },
    {
      "subtitle_id": 13,
      "start": 31.72,
      "end": 35.68,
      "text": "स्टॉक मार्केट में आए एक नए फ्रॉड की"
    },
    {
      "subtitle_id": 14,
      "start": 33.48,
      "end": 36.879,
      "text": "जिसकी हर जगह चर्चा चल रही है और आज के इस"
    },
    {
      "subtitle_id": 15,
      "start": 35.68,
      "end": 38.64,
      "text": "वीडियो में हम इसके बारे में बहुत ही"
    },
    {
      "subtitle_id": 16,
      "start": 36.879,
      "end": 40.399,
      "text": "डिटेल में बात करेंगे इस वीडियो को बनाने"
    },
    {
      "subtitle_id": 17,
      "start": 38.64,
      "end": 42.52,
      "text": "के लिए हमने अस्मिता पटेल पर सेबी की जो"
    },
    {
      "subtitle_id": 18,
      "start": 40.399,
      "end": 45.12,
      "text": "ऑर्डर आई है उसे डिटेल में पढ़ा और वो"
    },
    {
      "subtitle_id": 19,
      "start": 42.52,
      "end": 47.0,
      "text": "पूरी स्टोरी आज हम आपके सामने लेकर आए हैं"
    },
    {
      "subtitle_id": 20,
      "start": 45.12,
      "end": 48.879,
      "text": "नमस्कार मैं प्रसाद आपका आज के इस वीडियो"
    },
    {
      "subtitle_id": 21,
      "start": 47.0,
      "end": 50.84,
      "text": "में स्वागत करता हूं सो सबसे पहले जानते"
    },
    {
      "subtitle_id": 22,
      "start": 48.879,
      "end": 52.719,
      "text": "हैं कि अस्मिता पटेल है कौन तो अस्मिता"
    },
    {
      "subtitle_id": 23,
      "start": 50.84,
      "end": 54.52,
      "text": "पटेल की कंपनी है अस्मिता पटेल ग्लोबल"
    },
    {
      "subtitle_id": 24,
      "start": 52.719,
      "end": 56.48,
      "text": "स्कूल ऑफ ट्रेडिंग जहां पर वो स्टॉक"
    },
    {
      "subtitle_id": 25,
      "start": 54.52,
      "end": 58.559,
      "text": "ट्रेडिंग की ट्रेनिंग देती है जिसमें उनका"
    },
    {
      "subtitle_id": 26,
      "start": 56.48,
      "end": 61.16,
      "text": "एम पैट यानी मास्टर्स इन प्राइस एक्शन"
    },
    {
      "subtitle_id": 27,
      "start": 58.559,
      "end": 63.399,
      "text": "ट्रेडिंग यह एक कोर्स चलता है एलएम आईटी"
    },
    {
      "subtitle_id": 28,
      "start": 61.16,
      "end": 65.96,
      "text": "यानी लेट्स मेक इंडिया ट्रेड इसके अलावा"
    },
    {
      "subtitle_id": 29,
      "start": 63.399,
      "end": 67.92,
      "text": "ओम यानी ऑप्शंस मल्टीप्लायर और ट्रेड"
    },
    {
      "subtitle_id": 30,
      "start": 65.96,
      "end": 69.92,
      "text": "फॉलोइंग इनकम सिस्टम इस जैसे अलग-अलग"
    },
    {
      "subtitle_id": 31,
      "start": 67.92,
      "end": 72.479,
      "text": "कोर्सेस चलते हैं एक चीज आपने जरूर"
    },
    {
      "subtitle_id": 32,
      "start": 69.92,
      "end": 74.52,
      "text": "ऑब्जर्व की होगी कि इन सबके जो नाम है वो"
    },
    {
      "subtitle_id": 33,
      "start": 72.479,
      "end": 76.759,
      "text": "काफी कूल और फैंसी है ताकि ज्यादा से"
    },
    {
      "subtitle_id": 34,
      "start": 74.52,
      "end": 78.96,
      "text": "ज्यादा लोग उसकी तरफ अट्रैक्ट हो पाए और"
    },
    {
      "subtitle_id": 35,
      "start": 76.759,
      "end": 80.72,
      "text": "एगजैक्टली वैसा हुआ भी इन कोर्सेस का एक"
    },
    {
      "subtitle_id": 36,
      "start": 78.96,
      "end": 82.4,
      "text": "पर्टिकुलर पैटर्न में बता दूं बट अल्टीमेट"
    },
    {
      "subtitle_id": 37,
      "start": 80.72,
      "end": 84.6,
      "text": "गोल यह था इस कोर्सेस का कि नो लॉस"
    },
    {
      "subtitle_id": 38,
      "start": 82.4,
      "end": 86.52,
      "text": "ट्रेनिंग आप सीधा प्रॉफिट ही कमाएंगे तो"
    },
    {
      "subtitle_id": 39,
      "start": 84.6,
      "end": 88.84,
      "text": "इसके लिए शुरुआत में ये लोग प्री एट नाम"
    },
    {
      "subtitle_id": 40,
      "start": 86.52,
      "end": 90.32,
      "text": "का कोर्स बेचते थे जब लोग प्री एट की भी"
    },
    {
      "subtitle_id": 41,
      "start": 88.84,
      "end": 91.88,
      "text": "अच्छी खासी प्राइस पे करते करते थे तो"
    },
    {
      "subtitle_id": 42,
      "start": 90.32,
      "end": 94.28,
      "text": "लोगों को लगता था कि यहां पर कुछ सीखने"
    },
    {
      "subtitle_id": 43,
      "start": 91.88,
      "end": 96.759,
      "text": "मिलेगा लेकिन वहां पर सिखाया नहीं जाता था"
    },
    {
      "subtitle_id": 44,
      "start": 94.28,
      "end": 99.24,
      "text": "वहां पर आपको एम पैट के लिए प्रिपेयर किया"
    },
    {
      "subtitle_id": 45,
      "start": 96.759,
      "end": 101.399,
      "text": "जाता था जो अगला कोर्स है उसके बारे में"
    },
    {
      "subtitle_id": 46,
      "start": 99.24,
      "end": 103.68,
      "text": "आपको बताया जाता था क्यों एट जरूरी है"
    },
    {
      "subtitle_id": 47,
      "start": 101.399,
      "end": 106.159,
      "text": "क्यों एट आपको लेना चाहिए वगैरह वगैरह बता"
    },
    {
      "subtitle_id": 48,
      "start": 103.68,
      "end": 108.24,
      "text": "के आपको एट में लाने की कोशिश की जाती थी"
    },
    {
      "subtitle_id": 49,
      "start": 106.159,
      "end": 111.079,
      "text": "अभी जो एट है ये कोई छोटी-मोटी प्राइस"
    },
    {
      "subtitle_id": 50,
      "start": 108.24,
      "end": 114.52,
      "text": "वाला कोर्स नहीं था इसकी प्राइस थी 8.26"
    },
    {
      "subtitle_id": 51,
      "start": 111.079,
      "end": 116.439,
      "text": "लाख 8 26000 अब आप सोचेंगे कि कोई साधारण"
    },
    {
      "subtitle_id": 52,
      "start": 114.52,
      "end": 118.759,
      "text": "व्यक्ति 8 लाख का कोर्स कैसे खरीदेगा तो"
    },
    {
      "subtitle_id": 53,
      "start": 116.439,
      "end": 120.439,
      "text": "इसके लिए इनके पास ट्रिक्स रेडी थी और"
    },
    {
      "subtitle_id": 54,
      "start": 118.759,
      "end": 123.2,
      "text": "ट्रिक्स की आप समझ लो इनके पास एक लाइन"
    },
    {
      "subtitle_id": 55,
      "start": 120.439,
      "end": 125.88,
      "text": "खड़ी थी एकएक ट्रिक्स एकएक तरीका ये"
    },
    {
      "subtitle_id": 56,
      "start": 123.2,
      "end": 128.039,
      "text": "अपनाते थे और वो चल जाता था इसमें से एक"
    },
    {
      "subtitle_id": 57,
      "start": 125.88,
      "end": 129.8,
      "text": "तरीका यह था कि ये किसी बिजनेसमैन को"
    },
    {
      "subtitle_id": 58,
      "start": 128.039,
      "end": 132.08,
      "text": "सामने खड़े कर देते थे इनके ऑफलाइन सेशन"
    },
    {
      "subtitle_id": 59,
      "start": 129.8,
      "end": 135.04,
      "text": "में और वो बिजनेसमैन बताता था कि कैसे"
    },
    {
      "subtitle_id": 60,
      "start": 132.08,
      "end": 137.76,
      "text": "उसने ₹ लाख से ₹ करोड़ रुपए बना लिए किसकी"
    },
    {
      "subtitle_id": 61,
      "start": 135.04,
      "end": 140.12,
      "text": "वजह से अस्मिता पटेल की वजह से और ये सेवी"
    },
    {
      "subtitle_id": 62,
      "start": 137.76,
      "end": 142.04,
      "text": "ऑर्डर में मेंशन है चीजें सारी फिर एक"
    },
    {
      "subtitle_id": 63,
      "start": 140.12,
      "end": 143.879,
      "text": "चार्टर्ड अकाउंटेंट को लेके आते थे फिर"
    },
    {
      "subtitle_id": 64,
      "start": 142.04,
      "end": 147.08,
      "text": "चार्टर्ड अकाउंटेंट बोलता था कि इनके तो"
    },
    {
      "subtitle_id": 65,
      "start": 143.879,
      "end": 149.28,
      "text": "30 लाख के 3 करोड़ हो गए सुनिए मेरे तो 30"
    },
    {
      "subtitle_id": 66,
      "start": 147.08,
      "end": 151.92,
      "text": "लाख के 12 करोड़ रुप हो गए तालियां बजती"
    },
    {
      "subtitle_id": 67,
      "start": 149.28,
      "end": 155.599,
      "text": "थी लोग अगेन एमेट में रजिस्ट्रेशन करते थे"
    },
    {
      "subtitle_id": 68,
      "start": 151.92,
      "end": 157.48,
      "text": "8.26 लाख पे करके अब कई सारे लोग इनके पास"
    },
    {
      "subtitle_id": 69,
      "start": 155.599,
      "end": 159.319,
      "text": "आते थे ट्रेनिंग इंस्टिट्यूट के पास कि या"
    },
    {
      "subtitle_id": 70,
      "start": 157.48,
      "end": 161.879,
      "text": "फिर क्वेश्चन ए आंसर सेशन होता था तब"
    },
    {
      "subtitle_id": 71,
      "start": 159.319,
      "end": 163.879,
      "text": "बोलते थे कि पैसा बहुत ज्यादा है हमसे पे"
    },
    {
      "subtitle_id": 72,
      "start": 161.879,
      "end": 165.72,
      "text": "नहीं किया जाएगा तो इनके साइड से सजेशन"
    },
    {
      "subtitle_id": 73,
      "start": 163.879,
      "end": 167.4,
      "text": "बहुत सिंपल आता था कि आपके पास म्यूचुअल"
    },
    {
      "subtitle_id": 74,
      "start": 165.72,
      "end": 169.2,
      "text": "फंड्स होंगे आपके पास आपकी और"
    },
    {
      "subtitle_id": 75,
      "start": 167.4,
      "end": 171.44,
      "text": "इन्वेस्टमेंट्स होंगी आपके पास बिजनेस"
    },
    {
      "subtitle_id": 76,
      "start": 169.2,
      "end": 173.36,
      "text": "होंगे कुछ हिस्सा बेच दीजिए म्यूचुअल"
    },
    {
      "subtitle_id": 77,
      "start": 171.44,
      "end": 176.48,
      "text": "फंड्स प्रोविडेंट फंड है पूरा का पूरा बेच"
    },
    {
      "subtitle_id": 78,
      "start": 173.36,
      "end": 178.8,
      "text": "दीजिए कोर्स में आइए सीधा पैसा कमाइए 100%"
    },
    {
      "subtitle_id": 79,
      "start": 176.48,
      "end": 181.2,
      "text": "गारंटी के साथ तो ये इनकी गारंटी थी तो"
    },
    {
      "subtitle_id": 80,
      "start": 178.8,
      "end": 183.56,
      "text": "लोगों को लगता था कि हां गारंटी है तो"
    },
    {
      "subtitle_id": 81,
      "start": 181.2,
      "end": 187.2,
      "text": "हमें खोने के लिए कुछ नहीं है इसके चलते"
    },
    {
      "subtitle_id": 82,
      "start": 183.56,
      "end": 189.239,
      "text": "लोग 8.26 लाख पे करने लगे और जो लोग एमेट"
    },
    {
      "subtitle_id": 83,
      "start": 187.2,
      "end": 191.239,
      "text": "और बाकी कोर्सेस में आते थे बाद में"
    },
    {
      "subtitle_id": 84,
      "start": 189.239,
      "end": 193.519,
      "text": "उन्हें पता चलता था कि जो भी प्रॉमिस किए"
    },
    {
      "subtitle_id": 85,
      "start": 191.239,
      "end": 195.28,
      "text": "गए वो फेक है अब देखिए जिसे मार्केट की"
    },
    {
      "subtitle_id": 86,
      "start": 193.519,
      "end": 197.2,
      "text": "अंडरस्टैंडिंग है उन्हें तो पहले ही पता"
    },
    {
      "subtitle_id": 87,
      "start": 195.28,
      "end": 198.959,
      "text": "होता था तो इसी लिए वो लोग इन कोर्सेस में"
    },
    {
      "subtitle_id": 88,
      "start": 197.2,
      "end": 201.84,
      "text": "आते ही नहीं थे एमेट वगैरह में बिकॉज सभी"
    },
    {
      "subtitle_id": 89,
      "start": 198.959,
      "end": 204.44,
      "text": "को पता है कि 100% प्रॉफिट इज अ मिथ नहीं"
    },
    {
      "subtitle_id": 90,
      "start": 201.84,
      "end": 206.68,
      "text": "बन सकता यहां पर और वो भी इतने क्विकली आप"
    },
    {
      "subtitle_id": 91,
      "start": 204.44,
      "end": 209.92,
      "text": "वादा कर रहे हो कि फटाक से आओ 15 मिनट में"
    },
    {
      "subtitle_id": 92,
      "start": 206.68,
      "end": 211.599,
      "text": "पैसा कमाओ एंड यह सारे प्रॉमिस तो"
    },
    {
      "subtitle_id": 93,
      "start": 209.92,
      "end": 213.48,
      "text": "प्रैक्टिकली ये कुछ चीजें वर्क करती नहीं"
    },
    {
      "subtitle_id": 94,
      "start": 211.599,
      "end": 215.48,
      "text": "है अगर सही में ऐसा होता था तो अस्मिता"
    },
    {
      "subtitle_id": 95,
      "start": 213.48,
      "end": 217.48,
      "text": "पटेल को अपने कोर्सेस बेचने की जरूरत नहीं"
    },
    {
      "subtitle_id": 96,
      "start": 215.48,
      "end": 220.28,
      "text": "पड़ती थी सो मार्केट इज अ लॉन्ग टर्म गेम"
    },
    {
      "subtitle_id": 97,
      "start": 217.48,
      "end": 222.2,
      "text": "ऑफकोर्स अब यहां पर इन प्रॉमिस में फंस के"
    },
    {
      "subtitle_id": 98,
      "start": 220.28,
      "end": 223.799,
      "text": "बहुत सारे लोग अंदर तो आ चुके थे लेकिन"
    },
    {
      "subtitle_id": 99,
      "start": 222.2,
      "end": 225.599,
      "text": "अंदर आने के बाद उन्हें पता चला कि यार"
    },
    {
      "subtitle_id": 100,
      "start": 223.799,
      "end": 227.439,
      "text": "हमने अपनी म्यूचुअल फंड्स भेज दए हमने"
    },
    {
      "subtitle_id": 101,
      "start": 225.599,
      "end": 229.0,
      "text": "अपने प्रोविडेंट फंड भेज दिए हमने अपने"
    },
    {
      "subtitle_id": 102,
      "start": 227.439,
      "end": 230.439,
      "text": "बिजनेस का कुछ हिस्सा बेज दिया लोगों को"
    },
    {
      "subtitle_id": 103,
      "start": 229.0,
      "end": 232.4,
      "text": "ये तक एडवाइस किया गया कि अब अपने जॉब"
    },
    {
      "subtitle_id": 104,
      "start": 230.439,
      "end": 234.879,
      "text": "छोड़ दो क्या जॉब कर रहे हो यहां पर आओ"
    },
    {
      "subtitle_id": 105,
      "start": 232.4,
      "end": 236.959,
      "text": "डेली बैठ के मंडे टू फ्राइडे पैसा छापों"
    },
    {
      "subtitle_id": 106,
      "start": 234.879,
      "end": 238.68,
      "text": "लोगों ने सुन लिया सही में और ऐसे हजारों"
    },
    {
      "subtitle_id": 107,
      "start": 236.959,
      "end": 241.159,
      "text": "की संख्या में लोग हैं जिन्होंने चीजें"
    },
    {
      "subtitle_id": 108,
      "start": 238.68,
      "end": 243.239,
      "text": "सुनी ये चीजें फॉलो कि बाद में पता चला कि"
    },
    {
      "subtitle_id": 109,
      "start": 241.159,
      "end": 245.28,
      "text": "यार अब तो जॉब मिलना भी वापस मुश्किल हो"
    },
    {
      "subtitle_id": 110,
      "start": 243.239,
      "end": 247.76,
      "text": "गया है जो पैसा था सेविंग्स थी सारी खत्म"
    },
    {
      "subtitle_id": 111,
      "start": 245.28,
      "end": 249.4,
      "text": "हो गई एंड नाउ वी आर गॉन इसके बाद"
    },
    {
      "subtitle_id": 112,
      "start": 247.76,
      "end": 251.439,
      "text": "उन्होंने सोचा कि अब कर क्या सकते हैं तो"
    },
    {
      "subtitle_id": 113,
      "start": 249.4,
      "end": 253.92,
      "text": "जो पैसा पे किया है उसे रिकवर तो जरूर कर"
    },
    {
      "subtitle_id": 114,
      "start": 251.439,
      "end": 255.92,
      "text": "सकते हैं तो इसके चलते 42 लोगों ने सेबी"
    },
    {
      "subtitle_id": 115,
      "start": 253.92,
      "end": 256.959,
      "text": "के पास कंप्लेंट फाइल की सेबी के एक"
    },
    {
      "subtitle_id": 116,
      "start": 255.92,
      "end": 259.84,
      "text": "वेबसाइट है"
    },
    {
      "subtitle_id": 117,
      "start": 256.959,
      "end": 261.959,
      "text": "scores.gov.in जहां पर आप कंप्लेंट जनरली"
    },
    {
      "subtitle_id": 118,
      "start": 259.84,
      "end": 263.72,
      "text": "फाइल कर सकते हैं कंप्लेंट फाइल करने के"
    },
    {
      "subtitle_id": 119,
      "start": 261.959,
      "end": 265.68,
      "text": "बाद सेबी की टीम ने इस पर इन्वेस्ट्रन"
    },
    {
      "subtitle_id": 120,
      "start": 263.72,
      "end": 267.68,
      "text": "शुरू किया कि ये एगजैक्टली यहां पर चल"
    },
    {
      "subtitle_id": 121,
      "start": 265.68,
      "end": 270.4,
      "text": "क्या आ रहा है तो इन 42 लोगों ने काफी"
    },
    {
      "subtitle_id": 122,
      "start": 267.68,
      "end": 272.72,
      "text": "सारी चीजें रिवील की जब सीबी के टीम की इन"
    },
    {
      "subtitle_id": 123,
      "start": 270.4,
      "end": 274.96,
      "text": "42 लोगों के साथ बात हुई तो ऐसी कुछ चीजें"
    },
    {
      "subtitle_id": 124,
      "start": 272.72,
      "end": 276.84,
      "text": "बाहर आई जिससे सेबी खुद हैरान थे जिसके"
    },
    {
      "subtitle_id": 125,
      "start": 274.96,
      "end": 278.8,
      "text": "चलते उन्होंने इस चीज पर इ डिटेल"
    },
    {
      "subtitle_id": 126,
      "start": 276.84,
      "end": 281.759,
      "text": "इन्वेस्टिगेशन अपना शुरू किया और उन्हें"
    },
    {
      "subtitle_id": 127,
      "start": 278.8,
      "end": 284.32,
      "text": "फिर आप देखते रहिए काफी अजीब अजीब चीजें"
    },
    {
      "subtitle_id": 128,
      "start": 281.759,
      "end": 286.84,
      "text": "पता चली पहली चीज यह पता चली तो यहां पर"
    },
    {
      "subtitle_id": 129,
      "start": 284.32,
      "end": 288.479,
      "text": "कोर्स तो एक बहाना है और एक्चुअली"
    },
    {
      "subtitle_id": 130,
      "start": 286.84,
      "end": 290.32,
      "text": "इन्होंने काफी सारी चीजें सिखा भी दी"
    },
    {
      "subtitle_id": 131,
      "start": 288.479,
      "end": 291.96,
      "text": "उसमें तो भी लोगों का पैसा नहीं बन रहा था"
    },
    {
      "subtitle_id": 132,
      "start": 290.32,
      "end": 293.919,
      "text": "तो उसके चलते जो अस्मिता पटेल का जो"
    },
    {
      "subtitle_id": 133,
      "start": 291.96,
      "end": 295.56,
      "text": "ट्रेडिंग इंस्टिट्यूट है इन्होंने लोगों"
    },
    {
      "subtitle_id": 134,
      "start": 293.919,
      "end": 297.759,
      "text": "को एक टे ग्रा ग्रुप में ऐड करना शुरू"
    },
    {
      "subtitle_id": 135,
      "start": 295.56,
      "end": 299.759,
      "text": "किया और वहां पर इन्हें टिप्स मिलते थे कि"
    },
    {
      "subtitle_id": 136,
      "start": 297.759,
      "end": 302.039,
      "text": "हम आपको बताएंगे कि कौन सा आपको कॉल लेना"
    },
    {
      "subtitle_id": 137,
      "start": 299.759,
      "end": 304.72,
      "text": "है कौन सा पुट ऑप्शन लेना है अलग-अलग एसेट"
    },
    {
      "subtitle_id": 138,
      "start": 302.039,
      "end": 306.639,
      "text": "कैटेगरी में उनसे ट्रेड करवाया जूम कॉल के"
    },
    {
      "subtitle_id": 139,
      "start": 304.72,
      "end": 308.96,
      "text": "जरिए इन्हें टिप्स दी गई कि अब आप यह कर"
    },
    {
      "subtitle_id": 140,
      "start": 306.639,
      "end": 311.0,
      "text": "लीजिए वो कर लीजिए अब लोगों के क्या है ना"
    },
    {
      "subtitle_id": 141,
      "start": 308.96,
      "end": 313.479,
      "text": "कि 8.26 लाख तो पहले ही चले गए थे कोर्स"
    },
    {
      "subtitle_id": 142,
      "start": 311.0,
      "end": 315.28,
      "text": "फीज में ऊपर से उनको खुद से और पैसा डालना"
    },
    {
      "subtitle_id": 143,
      "start": 313.479,
      "end": 317.6,
      "text": "था इन टिप्स को फॉलो करना था और पैसा"
    },
    {
      "subtitle_id": 144,
      "start": 315.28,
      "end": 319.919,
      "text": "कमाना था जब उन्होंने एक्चुअल में यह पैसा"
    },
    {
      "subtitle_id": 145,
      "start": 317.6,
      "end": 322.28,
      "text": "डाला तो वो पैसा भी चला गया यानी डबल"
    },
    {
      "subtitle_id": 146,
      "start": 319.919,
      "end": 324.8,
      "text": "नुकसान हो गया अब ये डबल नुकसान के बाद आप"
    },
    {
      "subtitle_id": 147,
      "start": 322.28,
      "end": 326.88,
      "text": "करें क्या पैसा उधर से भी चला गया इधर से"
    },
    {
      "subtitle_id": 148,
      "start": 324.8,
      "end": 328.759,
      "text": "भी चला गया तो इसके चलते लोग भी हैरान थे"
    },
    {
      "subtitle_id": 149,
      "start": 326.88,
      "end": 330.8,
      "text": "तो सेबी ने भी ये चीज देखी कि यहां पर तो"
    },
    {
      "subtitle_id": 150,
      "start": 328.759,
      "end": 332.6,
      "text": "ट्रेनिंग तो नाम है एक्चुअल में तो"
    },
    {
      "subtitle_id": 151,
      "start": 330.8,
      "end": 334.199,
      "text": "इन्वेस्टमेंट एडवाइजरी बेची जा रही है अब"
    },
    {
      "subtitle_id": 152,
      "start": 332.6,
      "end": 335.919,
      "text": "इन्वेस्टमेंट एडवाइजरी आपको इंडिया में"
    },
    {
      "subtitle_id": 153,
      "start": 334.199,
      "end": 338.319,
      "text": "देनी है तो आपके पास सेबी का लाइसेंस होना"
    },
    {
      "subtitle_id": 154,
      "start": 335.919,
      "end": 339.84,
      "text": "चाहिए तो चेक किया गया कि उनके पास या"
    },
    {
      "subtitle_id": 155,
      "start": 338.319,
      "end": 342.6,
      "text": "उनके इंस्टिट्यूट के पास कोई सीबी का"
    },
    {
      "subtitle_id": 156,
      "start": 339.84,
      "end": 344.6,
      "text": "लाइसेंस है क्या कोई लाइसेंस नहीं था यानी"
    },
    {
      "subtitle_id": 157,
      "start": 342.6,
      "end": 346.72,
      "text": "कि जो इल्लीगल इन्वेस्टमेंट एडवाइजरी"
    },
    {
      "subtitle_id": 158,
      "start": 344.6,
      "end": 349.6,
      "text": "सर्विसेस है वो कोर्सेस के पीठ पीछे चल"
    },
    {
      "subtitle_id": 159,
      "start": 346.72,
      "end": 351.88,
      "text": "रही थी लोग उसमें आ रहे थे और डबल पैसा"
    },
    {
      "subtitle_id": 160,
      "start": 349.6,
      "end": 355.16,
      "text": "गवा रहे थे कोर्स की फीस का भी और दूसरी"
    },
    {
      "subtitle_id": 161,
      "start": 351.88,
      "end": 357.56,
      "text": "चीज अपना जो कैपिटल डाल दिया मार्केट में"
    },
    {
      "subtitle_id": 162,
      "start": 355.16,
      "end": 358.88,
      "text": "टिप सुनकर उसमें भी लॉस गवा दिया तो सभी"
    },
    {
      "subtitle_id": 163,
      "start": 357.56,
      "end": 360.88,
      "text": "की टीम को यहां इन्वेस्टिगेशन में एक और"
    },
    {
      "subtitle_id": 164,
      "start": 358.88,
      "end": 362.199,
      "text": "चीज इंटरेस्टिंग पता चली कि हालांकि लोगों"
    },
    {
      "subtitle_id": 165,
      "start": 360.88,
      "end": 364.28,
      "text": "का तो पैसा यहां पर नहीं बना है लेकिन"
    },
    {
      "subtitle_id": 166,
      "start": 362.199,
      "end": 366.84,
      "text": "अस्मिता पटेल ने कोर्सेस के नाम पर बहुत"
    },
    {
      "subtitle_id": 167,
      "start": 364.28,
      "end": 369.28,
      "text": "ज्यादा पैसा छाप लिया था 04 करोड़"
    },
    {
      "subtitle_id": 168,
      "start": 366.84,
      "end": 370.8,
      "text": "इन्होंने कमा लिए थे और फिर यह भी पता कर"
    },
    {
      "subtitle_id": 169,
      "start": 369.28,
      "end": 372.84,
      "text": "लिया गया कि इन्होंने ट्रेडिंग से कितना"
    },
    {
      "subtitle_id": 170,
      "start": 370.8,
      "end": 375.12,
      "text": "पैसा कमाया ये कितना कैपिटल ट्रेडिंग पर"
    },
    {
      "subtitle_id": 171,
      "start": 372.84,
      "end": 376.8,
      "text": "लगा रहे हैं तो पता चला कि पिछले चार"
    },
    {
      "subtitle_id": 172,
      "start": 375.12,
      "end": 379.8,
      "text": "सालों में हार्डली इन्होंने छोटा-मोटा कुछ"
    },
    {
      "subtitle_id": 173,
      "start": 376.8,
      "end": 381.16,
      "text": "पैसा बनाया है सो नॉट इवन 1 पर ऑफ द 104"
    },
    {
      "subtitle_id": 174,
      "start": 379.8,
      "end": 382.639,
      "text": "करोड़ जितना उन्होंने कोर्सेस से कमाया"
    },
    {
      "subtitle_id": 175,
      "start": 381.16,
      "end": 384.88,
      "text": "उसका 1 पर भी उन्होंने ट्रेडिंग से नहीं"
    },
    {
      "subtitle_id": 176,
      "start": 382.639,
      "end": 387.28,
      "text": "कमाया किसी साल प्रॉफिट किसी साल लॉस इस"
    },
    {
      "subtitle_id": 177,
      "start": 384.88,
      "end": 389.759,
      "text": "तरह से हार्डली कुछ ₹ लाख उनके बने थे"
    },
    {
      "subtitle_id": 178,
      "start": 387.28,
      "end": 391.96,
      "text": "ओवरऑल इन 4-5 साल के पीरियड में जब क कि"
    },
    {
      "subtitle_id": 179,
      "start": 389.759,
      "end": 393.759,
      "text": "लोग खुद इन्हें 8.26 लाख पे कर रहे थे एक"
    },
    {
      "subtitle_id": 180,
      "start": 391.96,
      "end": 396.479,
      "text": "कोर्स के लिए और इनके मल्टीपल कोर्सेस"
    },
    {
      "subtitle_id": 181,
      "start": 393.759,
      "end": 398.599,
      "text": "खरीद रहे थे जिनकी टोटल अमाउंट 12-13 लाख"
    },
    {
      "subtitle_id": 182,
      "start": 396.479,
      "end": 400.599,
      "text": "के भी ऊपर जा रही थी यानी कि सेबी को पता"
    },
    {
      "subtitle_id": 183,
      "start": 398.599,
      "end": 403.36,
      "text": "चला कि गारंटीड प्रॉफिट का वादा देकर यहां"
    },
    {
      "subtitle_id": 184,
      "start": 400.599,
      "end": 405.639,
      "text": "पर लोगों को 04 करोड़ से ठगा गया इसीलिए"
    },
    {
      "subtitle_id": 185,
      "start": 403.36,
      "end": 407.96,
      "text": "तुरंत एक्शन लेते हुए सेबी ने 554 करोड़"
    },
    {
      "subtitle_id": 186,
      "start": 405.639,
      "end": 410.24,
      "text": "फ्रीज किए और बाकी 50 करोड़ भी फ्रीज करने"
    },
    {
      "subtitle_id": 187,
      "start": 407.96,
      "end": 411.8,
      "text": "की सेबी तैयारी में है लेकिन यहां पर काफी"
    },
    {
      "subtitle_id": 188,
      "start": 410.24,
      "end": 413.24,
      "text": "सारे सवाल अब आपके दिमाग में होंगे सवाल"
    },
    {
      "subtitle_id": 189,
      "start": 411.8,
      "end": 414.8,
      "text": "ये आता है कि जो भी टिप्स ये लोग बता रहे"
    },
    {
      "subtitle_id": 190,
      "start": 413.24,
      "end": 416.56,
      "text": "थे जो भी स्ट्रेटेजी ये लोग बता रहे थे"
    },
    {
      "subtitle_id": 191,
      "start": 414.8,
      "end": 418.479,
      "text": "अपने कोर्सेस में क्या वो प्रॉफिटेबल थी"
    },
    {
      "subtitle_id": 192,
      "start": 416.56,
      "end": 420.16,
      "text": "तो सेबी के अकॉर्डिंग ये सारे जो सिग्नल्स"
    },
    {
      "subtitle_id": 193,
      "start": 418.479,
      "end": 422.199,
      "text": "और टिप्स यहां पर मिलती थी वो सारी"
    },
    {
      "subtitle_id": 194,
      "start": 420.16,
      "end": 424.36,
      "text": "मैनिपुलेटेड थी इनमें किसी भी तरह की"
    },
    {
      "subtitle_id": 195,
      "start": 422.199,
      "end": 426.08,
      "text": "ऑथेंटिसिटी नहीं थी अगला सवाल ये आता है"
    },
    {
      "subtitle_id": 196,
      "start": 424.36,
      "end": 427.96,
      "text": "कि अगर किसी का पैसा इसमें फंसा है या"
    },
    {
      "subtitle_id": 197,
      "start": 426.08,
      "end": 430.199,
      "text": "फ्यूचर में किसी सिमिलर तरीके में फसता है"
    },
    {
      "subtitle_id": 198,
      "start": 427.96,
      "end": 432.24,
      "text": "तो क्या पैसे वापस मिल सकते हैं तो देखिए"
    },
    {
      "subtitle_id": 199,
      "start": 430.199,
      "end": 433.879,
      "text": "चांसेस जनरली बहुत कम रहते हैं बिकॉज़ ये"
    },
    {
      "subtitle_id": 200,
      "start": 432.24,
      "end": 435.68,
      "text": "जो लोग होते हैं इस तरह के कोर्सेस भेजते"
    },
    {
      "subtitle_id": 201,
      "start": 433.879,
      "end": 437.4,
      "text": "हैं इस तरह के टिप्स प्रोवाइड करते हैं या"
    },
    {
      "subtitle_id": 202,
      "start": 435.68,
      "end": 439.919,
      "text": "आपसे कुछ ऐसे कांट्रैक्ट साइन करवा लेते"
    },
    {
      "subtitle_id": 203,
      "start": 437.4,
      "end": 441.68,
      "text": "हैं कि जिसके बाद आपका पैसा मिलना काफी टफ"
    },
    {
      "subtitle_id": 204,
      "start": 439.919,
      "end": 443.44,
      "text": "हो जाता है और दूसरी चीज ये जो"
    },
    {
      "subtitle_id": 205,
      "start": 441.68,
      "end": 445.879,
      "text": "इन्वेस्टिगेशन और बाकी सारी प्रोसेस है अब"
    },
    {
      "subtitle_id": 206,
      "start": 443.44,
      "end": 448.039,
      "text": "इसमें कोर्ट कचरी आएगी काफी लंबी प्रोसेस"
    },
    {
      "subtitle_id": 207,
      "start": 445.879,
      "end": 450.12,
      "text": "चलेगी तो इसमें जल्दी कोई कंक्लूजन इंडिया"
    },
    {
      "subtitle_id": 208,
      "start": 448.039,
      "end": 452.68,
      "text": "में जनरली होता नहीं है टेक्स लॉट मोर"
    },
    {
      "subtitle_id": 209,
      "start": 450.12,
      "end": 455.44,
      "text": "टाइम तो पैसा मिलना इट्ज वेरी वेरी"
    },
    {
      "subtitle_id": 210,
      "start": 452.68,
      "end": 457.479,
      "text": "अनसर्टेन हार्डली यू नो 24 पर केसेस में"
    },
    {
      "subtitle_id": 211,
      "start": 455.44,
      "end": 459.599,
      "text": "ही पैसा लोगों को मिल पाता है मेजॉरिटी"
    },
    {
      "subtitle_id": 212,
      "start": 457.479,
      "end": 461.12,
      "text": "केसेस में पैसा नहीं मिलता है तो लेसेंस"
    },
    {
      "subtitle_id": 213,
      "start": 459.599,
      "end": 462.68,
      "text": "आपका यही होना चाहिए अगर कोई भी आपको"
    },
    {
      "subtitle_id": 214,
      "start": 461.12,
      "end": 464.28,
      "text": "मार्केट में स्टॉक मार्केट में यह बोलता"
    },
    {
      "subtitle_id": 215,
      "start": 462.68,
      "end": 466.319,
      "text": "है कि आप मेरे पास आ जाओ मैं क्विक पैसे"
    },
    {
      "subtitle_id": 216,
      "start": 464.28,
      "end": 467.879,
      "text": "कमा कर दूंगा हजारों इल्लीगल इन्वेस्टमेंट"
    },
    {
      "subtitle_id": 217,
      "start": 466.319,
      "end": 469.52,
      "text": "एडवाइजरी कंपनीज इंडिया में इसी तरह चल"
    },
    {
      "subtitle_id": 218,
      "start": 467.879,
      "end": 471.039,
      "text": "रही है आपको रैंडम कई बार कॉल भी आते"
    },
    {
      "subtitle_id": 219,
      "start": 469.52,
      "end": 473.039,
      "text": "होंगे कि हमारी एडवाइजरी ले लो हम आपको"
    },
    {
      "subtitle_id": 220,
      "start": 471.039,
      "end": 474.879,
      "text": "पैसा कमा कर देंगे इस तरह की चीजें चल रही"
    },
    {
      "subtitle_id": 221,
      "start": 473.039,
      "end": 476.68,
      "text": "है क्योंकि लोग उस पर भरोसा करते हैं और"
    },
    {
      "subtitle_id": 222,
      "start": 474.879,
      "end": 478.68,
      "text": "आज भी लोग उस तरह के झांसे में फंस रहे"
    },
    {
      "subtitle_id": 223,
      "start": 476.68,
      "end": 480.72,
      "text": "हैं तो वो कंपनीज पैसा कमा रही है इसलिए"
    },
    {
      "subtitle_id": 224,
      "start": 478.68,
      "end": 482.36,
      "text": "उस तरह के ऐड्स आप को आज भी दिखती है अदर"
    },
    {
      "subtitle_id": 225,
      "start": 480.72,
      "end": 483.72,
      "text": "वाइज कोई क्यों फ्री में इतने सारा पैसा"
    },
    {
      "subtitle_id": 226,
      "start": 482.36,
      "end": 485.68,
      "text": "डालेगा एडवर्टाइजमेंट में या फिर"
    },
    {
      "subtitle_id": 227,
      "start": 483.72,
      "end": 486.879,
      "text": "टेलीकॉलिंग में तो समझने वाली बात है तो"
    },
    {
      "subtitle_id": 228,
      "start": 485.68,
      "end": 488.639,
      "text": "इंडिया में आज भी लोग फंस रहे हैं तो"
    },
    {
      "subtitle_id": 229,
      "start": 486.879,
      "end": 490.36,
      "text": "इन्हें बचने के लिए आपको मार्केट को सही"
    },
    {
      "subtitle_id": 230,
      "start": 488.639,
      "end": 492.879,
      "text": "तरीके से समझना पड़ेगा कि एगजैक्टली"
    },
    {
      "subtitle_id": 231,
      "start": 490.36,
      "end": 494.52,
      "text": "मार्केट चलता कैसे है ओवरऑल चीजें चलती"
    },
    {
      "subtitle_id": 232,
      "start": 492.879,
      "end": 496.24,
      "text": "कैसी है और मेरा जितने भी टाइम का"
    },
    {
      "subtitle_id": 233,
      "start": 494.52,
      "end": 498.44,
      "text": "एक्सपीरियंस है मुझे उसमें एक चीज समझ में"
    },
    {
      "subtitle_id": 234,
      "start": 496.24,
      "end": 501.24,
      "text": "आ गई है कि इंडिया में जितने भी प्रूवन"
    },
    {
      "subtitle_id": 235,
      "start": 498.44,
      "end": 503.479,
      "text": "मिलियर है बिलिनियर है जो भी मार्केट से"
    },
    {
      "subtitle_id": 236,
      "start": 501.24,
      "end": 506.319,
      "text": "बने हैं इन्वेस्टमेंट से बने हैं मोर देन"
    },
    {
      "subtitle_id": 237,
      "start": 503.479,
      "end": 509.0,
      "text": "98 पर ऑफ देम हैव मेड देयर मनी फ्रॉम"
    },
    {
      "subtitle_id": 238,
      "start": 506.319,
      "end": 511.599,
      "text": "लॉन्ग टर्म इन्वेस्टिंग और जो कि टाइम"
    },
    {
      "subtitle_id": 239,
      "start": 509.0,
      "end": 513.8,
      "text": "लेती है क्विक नहीं है उस पर एक बेसिक"
    },
    {
      "subtitle_id": 240,
      "start": 511.599,
      "end": 516.039,
      "text": "लॉजिक यह है कि अगर कोई बिजनेस बढ़ेगा"
    },
    {
      "subtitle_id": 241,
      "start": 513.8,
      "end": 518.599,
      "text": "अच्छा करेगा तो आपका पैसा बनेगा यानी कि"
    },
    {
      "subtitle_id": 242,
      "start": 516.039,
      "end": 521.12,
      "text": "पिछले 20-2 साल में एडीएसी बैंक एन पेंट्स"
    },
    {
      "subtitle_id": 243,
      "start": 518.599,
      "end": 523.32,
      "text": "कई सारी और कंपनीज ने अच्छा बिजनेस किया"
    },
    {
      "subtitle_id": 244,
      "start": 521.12,
      "end": 524.8,
      "text": "है तो लॉन्ग टर्म में उनका पैसा बना है अब"
    },
    {
      "subtitle_id": 245,
      "start": 523.32,
      "end": 526.6,
      "text": "करेंटली आप इन्वेस्ट कर रहे हो तो आपको"
    },
    {
      "subtitle_id": 246,
      "start": 524.8,
      "end": 528.279,
      "text": "फ्यूचर में ऐसी कौन सी कंपनी जो आने वाले"
    },
    {
      "subtitle_id": 247,
      "start": 526.6,
      "end": 530.16,
      "text": "10-20 साल में बहुत अच्छा परफॉर्म करेगी"
    },
    {
      "subtitle_id": 248,
      "start": 528.279,
      "end": 531.88,
      "text": "उन्हें ढूंढना पड़ेगा एंड दैट इज द रियल"
    },
    {
      "subtitle_id": 249,
      "start": 530.16,
      "end": 533.92,
      "text": "वे टू मेक मनी इन द मार्केट्स अगर आप इस"
    },
    {
      "subtitle_id": 250,
      "start": 531.88,
      "end": 535.88,
      "text": "तरह की चीजों में आओगे कि मैं आपको प्राइस"
    },
    {
      "subtitle_id": 251,
      "start": 533.92,
      "end": 537.72,
      "text": "एक्शन थिरी का कोर्स बेजती हूं और बाकी"
    },
    {
      "subtitle_id": 252,
      "start": 535.88,
      "end": 540.44,
      "text": "चीजें बेचती हूं आई हैव नथिंग अगेंस्ट देम"
    },
    {
      "subtitle_id": 253,
      "start": 537.72,
      "end": 542.64,
      "text": "बट इन रियलिटी यू विल नॉट फाइंड एनी वन हु"
    },
    {
      "subtitle_id": 254,
      "start": 540.44,
      "end": 545.279,
      "text": "हैज मेड मनी और जो मिलिनेयर बिलिनियर के"
    },
    {
      "subtitle_id": 255,
      "start": 542.64,
      "end": 547.76,
      "text": "लिस्ट में आता है बाय डूइंग सच थिंग्स सो"
    },
    {
      "subtitle_id": 256,
      "start": 545.279,
      "end": 549.8,
      "text": "सिंपल सा आपको यही मेरी रिक्वेस्ट है कि"
    },
    {
      "subtitle_id": 257,
      "start": 547.76,
      "end": 551.959,
      "text": "क्विक मनी के पीछे मत भागी ये बहुत सारी"
    },
    {
      "subtitle_id": 258,
      "start": 549.8,
      "end": 553.64,
      "text": "चीजें बहुत फैंसी है मार्केट में पैसा"
    },
    {
      "subtitle_id": 259,
      "start": 551.959,
      "end": 555.72,
      "text": "बनता है तो बोरिंग तरीके से बनता है उसमें"
    },
    {
      "subtitle_id": 260,
      "start": 553.64,
      "end": 557.399,
      "text": "रिसर्च बहुत करना पड़ता है पेशेंस के साथ"
    },
    {
      "subtitle_id": 261,
      "start": 555.72,
      "end": 559.64,
      "text": "लॉन्ग टर्म में इन्वेस्ट करना पड़ता है"
    },
    {
      "subtitle_id": 262,
      "start": 557.399,
      "end": 561.64,
      "text": "जैसे विजय केडिया ने 16000 टाइम्स रिटर्न"
    },
    {
      "subtitle_id": 263,
      "start": 559.64,
      "end": 563.6,
      "text": "बनाया सेरा सैनिटी वेयर में मिस्टर झुंझु"
    },
    {
      "subtitle_id": 264,
      "start": 561.64,
      "end": 566.16,
      "text": "ने जो मेन पैसा बनाया वो टाइटन में बनाया"
    },
    {
      "subtitle_id": 265,
      "start": 563.6,
      "end": 567.72,
      "text": "90000 पर का तो इसके लिए उन्हें काफी 10"
    },
    {
      "subtitle_id": 266,
      "start": 566.16,
      "end": 569.92,
      "text": "12 साल 15 साल होल्ड करने पड़े"
    },
    {
      "subtitle_id": 267,
      "start": 567.72,
      "end": 571.76,
      "text": "अच्छी-अच्छी कंपनीज को तो ये बोरिंग काम"
    },
    {
      "subtitle_id": 268,
      "start": 569.92,
      "end": 573.6,
      "text": "है जो लोगों को पसंद नहीं है लोगों को यंग"
    },
    {
      "subtitle_id": 269,
      "start": 571.76,
      "end": 576.079,
      "text": "जनरेशन को आजकल चाहिए कि कुछ तो भी फैंसी"
    },
    {
      "subtitle_id": 270,
      "start": 573.6,
      "end": 579.839,
      "text": "फटाफट आने वाली चीजें हो जिसमें दिन भर एक"
    },
    {
      "subtitle_id": 271,
      "start": 576.079,
      "end": 582.48,
      "text": "कुछ यू नो माहौल बना रहे और ऐसी चीजें फिर"
    },
    {
      "subtitle_id": 272,
      "start": 579.839,
      "end": 585.36,
      "text": "आपको लॉसेस में ही लेकर जाती है ऐसी चीजें"
    },
    {
      "subtitle_id": 273,
      "start": 582.48,
      "end": 587.12,
      "text": "आपको इसी तरह के जो यू नो ट्रेनर्स हैं"
    },
    {
      "subtitle_id": 274,
      "start": 585.36,
      "end": 589.16,
      "text": "इल्लीगल एडवाइजरीज है उनके पास लेकर जाते"
    },
    {
      "subtitle_id": 275,
      "start": 587.12,
      "end": 591.12,
      "text": "हैं अल्टीमेटली यू लूज योर मनी एंड देन यू"
    },
    {
      "subtitle_id": 276,
      "start": 589.16,
      "end": 592.72,
      "text": "गेट टू अंडरस्टैंड कि अच्छा ये चीजें नहीं"
    },
    {
      "subtitle_id": 277,
      "start": 591.12,
      "end": 594.64,
      "text": "करनी है मार्केट में असली पैसा कहीं और"
    },
    {
      "subtitle_id": 278,
      "start": 592.72,
      "end": 597.16,
      "text": "बनता है तो जैसे कि बड़े-बड़े इन्वेस्टर्स"
    },
    {
      "subtitle_id": 279,
      "start": 594.64,
      "end": 598.76,
      "text": "कहते हैं कि अपनी गलतियों से सीखना इज वन"
    },
    {
      "subtitle_id": 280,
      "start": 597.16,
      "end": 600.36,
      "text": "लेकिन अगर आपको बहुत स्मार्ट इन्वेस्टर"
    },
    {
      "subtitle_id": 281,
      "start": 598.76,
      "end": 602.48,
      "text": "बनना है तो आपको दूसरों की गलतियों से भी"
    },
    {
      "subtitle_id": 282,
      "start": 600.36,
      "end": 604.56,
      "text": "सीखना पड़ेगा सो यहां पर काफी एक बड़ी सीख"
    },
    {
      "subtitle_id": 283,
      "start": 602.48,
      "end": 606.519,
      "text": "है जो मतलब इस तरह के स्कैम्स और जब-जब"
    },
    {
      "subtitle_id": 284,
      "start": 604.56,
      "end": 608.64,
      "text": "बाहर आते हैं तो हमें उससे सीखनी चाहिए और"
    },
    {
      "subtitle_id": 285,
      "start": 606.519,
      "end": 610.36,
      "text": "मेक श्योर करना चाहिए कि हम आने वाले टाइम"
    },
    {
      "subtitle_id": 286,
      "start": 608.64,
      "end": 612.32,
      "text": "में किसी भी उस तरह की चीजों में ना फंसे"
    },
    {
      "subtitle_id": 287,
      "start": 610.36,
