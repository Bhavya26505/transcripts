  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.08,
      "end": 5.04,
      "text": "एक सर्वे के हिसाब से पिछले 3 सालों में"
    },
    {
      "subtitle_id": 2,
      "start": 2.08,
      "end": 7.359,
      "text": "हेल्थ इंश्योरेंस कंपनीज ने 50% क्लेम्स"
    },
    {
      "subtitle_id": 3,
      "start": 5.04,
      "end": 10.0,
      "text": "कंप्लीटली या फिर पार्शियली रिजेक्ट कर"
    },
    {
      "subtitle_id": 4,
      "start": 7.359,
      "end": 12.48,
      "text": "दिए हैं। और जो बचे हुए 50% क्लेम पास हुए"
    },
    {
      "subtitle_id": 5,
      "start": 10.0,
      "end": 14.799,
      "text": "उसमें से 25% क्लेम्स ही ऐसे थे जो"
    },
    {
      "subtitle_id": 6,
      "start": 12.48,
      "end": 17.119,
      "text": "कंप्लीटली अप्रूव्ड थे। बाकी के पार्शियली"
    },
    {
      "subtitle_id": 7,
      "start": 14.799,
      "end": 19.92,
      "text": "अप्रूव हुए। यानी कि अगर हॉस्पिटल बिल ₹1"
    },
    {
      "subtitle_id": 8,
      "start": 17.119,
      "end": 22.16,
      "text": "लाख का था तो 40500 का ही बिल अप्रूव्ड"
    },
    {
      "subtitle_id": 9,
      "start": 19.92,
      "end": 24.4,
      "text": "हुआ है। और फिर अगर चीजें इसी तरह चलती"
    },
    {
      "subtitle_id": 10,
      "start": 22.16,
      "end": 27.279,
      "text": "रही तो हेल्थ इंश्योरेंस पास करना क्रीम"
    },
    {
      "subtitle_id": 11,
      "start": 24.4,
      "end": 29.84,
      "text": "11 पर टीम बनाकर ₹1 करोड़ जीतने जैसा ही"
    },
    {
      "subtitle_id": 12,
      "start": 27.279,
      "end": 32.16,
      "text": "डिफिकल्ट हो सकता है। और यह सब तब हो रहा"
    },
    {
      "subtitle_id": 13,
      "start": 29.84,
      "end": 34.16,
      "text": "है जब आईआरडीआई जो कि इंश्योरेंस कंपनीज़"
    },
    {
      "subtitle_id": 14,
      "start": 32.16,
      "end": 36.239,
      "text": "को रेगुलेट करती है। उन्होंने लास्ट ईयर"
    },
    {
      "subtitle_id": 15,
      "start": 34.16,
      "end": 38.48,
      "text": "एक मैंडेट जारी किया था कि इंश्योरेंस"
    },
    {
      "subtitle_id": 16,
      "start": 36.239,
      "end": 41.04,
      "text": "कंपनीज़ को कैशलेस क्लेम रिक्वेस्ट को 1"
    },
    {
      "subtitle_id": 17,
      "start": 38.48,
      "end": 43.12,
      "text": "घंटे के अंदर अप्रूव करना होगा और 3 घंटे"
    },
    {
      "subtitle_id": 18,
      "start": 41.04,
      "end": 45.28,
      "text": "के अंदर ही डिस्चार्ज के टाइम प्रोसेस भी"
    },
    {
      "subtitle_id": 19,
      "start": 43.12,
      "end": 47.12,
      "text": "करना होगा। लेकिन अगर देखा जाए तो हो"
    },
    {
      "subtitle_id": 20,
      "start": 45.28,
      "end": 48.559,
      "text": "बिल्कुल उल्टा रहा है। और इससे भी ज्यादा"
    },
    {
      "subtitle_id": 21,
      "start": 47.12,
      "end": 50.879,
      "text": "शॉकिंग डाटा यह है कि पिछले साल"
    },
    {
      "subtitle_id": 22,
      "start": 48.559,
      "end": 53.36,
      "text": "इंश्योरेंस कंपनीज़ ने 83,000 करोड़ का"
    },
    {
      "subtitle_id": 23,
      "start": 50.879,
      "end": 55.92,
      "text": "क्लेम पास किया। बट इसके कंपेरेटिवली सब"
    },
    {
      "subtitle_id": 24,
      "start": 53.36,
      "end": 60.079,
      "text": "मिलाकर 26,000 करोड़ के क्लेम्स इन्होंने"
    },
    {
      "subtitle_id": 25,
      "start": 55.92,
      "end": 62.0,
      "text": "रिजेक्ट कर दिए हैं। यस 26,000 करोड़। अब"
    },
    {
      "subtitle_id": 26,
      "start": 60.079,
      "end": 64.32,
      "text": "ये सारी चीजें सुनकर आप बहुत ज्यादा शॉक"
    },
    {
      "subtitle_id": 27,
      "start": 62.0,
      "end": 66.24,
      "text": "हुए होंगे और मैं भी हुआ। तभी मैंने इन"
    },
    {
      "subtitle_id": 28,
      "start": 64.32,
      "end": 68.479,
      "text": "ढेर सारी रिपोर्ट्स को बारीकी से देखना"
    },
    {
      "subtitle_id": 29,
      "start": 66.24,
      "end": 70.64,
      "text": "शुरू किया कि अगर इंश्योरेंस कंपनी किसी"
    },
    {
      "subtitle_id": 30,
      "start": 68.479,
      "end": 73.2,
      "text": "क्लेम को रिजेक्ट कर रही है तो वह कौन से"
    },
    {
      "subtitle_id": 31,
      "start": 70.64,
      "end": 75.6,
      "text": "कॉमन कारण हैं जिनकी वजह से यह क्लेम्स"
    },
    {
      "subtitle_id": 32,
      "start": 73.2,
      "end": 78.159,
      "text": "रिजेक्ट किए जा रहे हैं और मैंने सोचा कि"
    },
    {
      "subtitle_id": 33,
      "start": 75.6,
      "end": 80.08,
      "text": "अगर यह चीजें आप सभी को पता चल जाए तो"
    },
    {
      "subtitle_id": 34,
      "start": 78.159,
      "end": 81.92,
      "text": "आपके क्लेम अप्रूव होने के चांसेस बहुत"
    },
    {
      "subtitle_id": 35,
      "start": 80.08,
      "end": 83.92,
      "text": "ज्यादा बढ़ जाएंगे और उससे आपको बहुत"
    },
    {
      "subtitle_id": 36,
      "start": 81.92,
      "end": 87.04,
      "text": "ज्यादा फायदा भी मिलेगा। तो यह वीडियो"
    },
    {
      "subtitle_id": 37,
      "start": 83.92,
      "end": 88.32,
      "text": "बहुत काम की होने वाली है। इसे अभी सभी के"
    },
    {
      "subtitle_id": 38,
      "start": 87.04,
      "end": 90.479,
      "text": "साथ शेयर कीजिए जिनके पास हेल्थ"
    },
    {
      "subtitle_id": 39,
      "start": 88.32,
      "end": 92.479,
      "text": "इंश्योरेंस है या फिर जो हेल्थ इंश्योरेंस"
    },
    {
      "subtitle_id": 40,
      "start": 90.479,
      "end": 95.28,
      "text": "लेने की प्लानिंग में है। क्योंकि अगर यह"
    },
    {
      "subtitle_id": 41,
      "start": 92.479,
      "end": 97.28,
      "text": "चीजें आपको समझ में नहीं आई तो फिर आपके"
    },
    {
      "subtitle_id": 42,
      "start": 95.28,
      "end": 99.68,
      "text": "लिए आने वाले टाइम में प्रॉब्लम हो सकती"
    },
    {
      "subtitle_id": 43,
      "start": 97.28,
      "end": 102.56,
      "text": "है। और यह रिसर्च करते-करते मुझे एक बहुत"
    },
    {
      "subtitle_id": 44,
      "start": 99.68,
      "end": 104.4,
      "text": "ही बेसिक और कॉमन मिस्टेक्स भी मिली जिनकी"
    },
    {
      "subtitle_id": 45,
      "start": 102.56,
      "end": 106.799,
      "text": "वजह से भी लोगों के क्लेम्स रिजेक्ट हो"
    },
    {
      "subtitle_id": 46,
      "start": 104.4,
      "end": 108.399,
      "text": "जाते हैं। अब वो सुनेंगे आप तो बोलेंगे कि"
    },
    {
      "subtitle_id": 47,
      "start": 106.799,
      "end": 110.24,
      "text": "यार यह तो बहुत छोटी सी चीज है। लेकिन"
    },
    {
      "subtitle_id": 48,
      "start": 108.399,
      "end": 112.64,
      "text": "ज्यादातर टाइम लोग उन चीजों पर ध्यान नहीं"
    },
    {
      "subtitle_id": 49,
      "start": 110.24,
      "end": 115.04,
      "text": "देते क्योंकि उन्हें नहीं पता कि उसकी वजह"
    },
    {
      "subtitle_id": 50,
      "start": 112.64,
      "end": 116.88,
      "text": "से उस छोटी सी चीज की वजह से उनका क्लेम"
    },
    {
      "subtitle_id": 51,
      "start": 115.04,
      "end": 118.799,
      "text": "रिजेक्ट हो सकता है। जिसके चलते उनका"
    },
    {
      "subtitle_id": 52,
      "start": 116.88,
      "end": 121.28,
      "text": "लाखों का नुकसान हो सकता है जिसके चलते एक"
    },
    {
      "subtitle_id": 53,
      "start": 118.799,
      "end": 123.68,
      "text": "फाइनेंसियल बर्डन उनकी पूरी फैमिली पर आ"
    },
    {
      "subtitle_id": 54,
      "start": 121.28,
      "end": 125.52,
      "text": "सकता है। तो क्या है ये कॉमन मिस्टेक्स?"
    },
    {
      "subtitle_id": 55,
      "start": 123.68,
      "end": 127.92,
      "text": "तो इन सारी कॉमन मिस्टेक्स को मैंने दो"
    },
    {
      "subtitle_id": 56,
      "start": 125.52,
      "end": 129.599,
      "text": "पार्ट में डिवाइड किया है। पहला है अपना"
    },
    {
      "subtitle_id": 57,
      "start": 127.92,
      "end": 131.44,
      "text": "फाइव मिस्टेक्स टू अवॉयड व्हाइल बाइंग"
    },
    {
      "subtitle_id": 58,
      "start": 129.599,
      "end": 133.12,
      "text": "हेल्थ इंश्योरेंस और दूसरा है फाइव"
    },
    {
      "subtitle_id": 59,
      "start": 131.44,
      "end": 136.319,
      "text": "मिस्टेक्स टू अवॉयड व्हाइल फिलिंग द"
    },
    {
      "subtitle_id": 60,
      "start": 133.12,
      "end": 137.76,
      "text": "क्लेम। तो चलिए शुरू करते हैं। नमस्कार,"
    },
    {
      "subtitle_id": 61,
      "start": 136.319,
      "end": 139.52,
      "text": "मैं प्रसाद आपका आज के इस वीडियो में"
    },
    {
      "subtitle_id": 62,
      "start": 137.76,
      "end": 141.599,
      "text": "स्वागत करता हूं। अब जिन मिस्टेक्स को"
    },
    {
      "subtitle_id": 63,
      "start": 139.52,
      "end": 143.92,
      "text": "आपको हेल्थ इंश्योरेंस खरीदते टाइम अवॉइड"
    },
    {
      "subtitle_id": 64,
      "start": 141.599,
      "end": 146.4,
      "text": "करना है, उसमें से सबसे पहली मिस्टेक यह"
    },
    {
      "subtitle_id": 65,
      "start": 143.92,
      "end": 148.879,
      "text": "है कि अवॉयड हेल्थ इंश्योरेंस पॉलिसीज विद"
    },
    {
      "subtitle_id": 66,
      "start": 146.4,
      "end": 150.64,
      "text": "कोपेमेंट क्लॉज़। अब जिन्हें नहीं पता उनके"
    },
    {
      "subtitle_id": 67,
      "start": 148.879,
      "end": 151.76,
      "text": "लिए शॉर्ट में बता दूं कि कोपेमेंट क्लॉज़"
    },
    {
      "subtitle_id": 68,
      "start": 150.64,
      "end": 153.92,
      "text": "क्या होता है। मान लेते हैं आप"
    },
    {
      "subtitle_id": 69,
      "start": 151.76,
      "end": 156.239,
      "text": "हॉस्पिटलाइज होते हो। आपका बिल आता है ₹1"
    },
    {
      "subtitle_id": 70,
      "start": 153.92,
      "end": 158.72,
      "text": "लाख का। अब अगर मान लीजिए कि आपकी पॉलिसी"
    },
    {
      "subtitle_id": 71,
      "start": 156.239,
      "end": 161.68,
      "text": "में 20% का कोपेमेंट क्लॉज़ है तो इसका"
    },
    {
      "subtitle_id": 72,
      "start": 158.72,
      "end": 163.84,
      "text": "मतलब है कि 20,000 यानी कि 20% आपको अपनी"
    },
    {
      "subtitle_id": 73,
      "start": 161.68,
      "end": 165.84,
      "text": "जेब से भरने पड़ेंगे और 80,000 फिर"
    },
    {
      "subtitle_id": 74,
      "start": 163.84,
      "end": 167.28,
      "text": "इंश्योरेंस कंपनी आपको पे करेगी। और"
    },
    {
      "subtitle_id": 75,
      "start": 165.84,
      "end": 169.2,
      "text": "यूजुअली क्या होता है तो कुछ लोग हेल्थ"
    },
    {
      "subtitle_id": 76,
      "start": 167.28,
      "end": 171.519,
      "text": "इंश्योरेंस बाय करते हैं तो वो सिर्फ एक"
    },
    {
      "subtitle_id": 77,
      "start": 169.2,
      "end": 174.16,
      "text": "ही चीज देखते हैं प्राइस। वो देखते हैं कि"
    },
    {
      "subtitle_id": 78,
      "start": 171.519,
      "end": 176.48,
      "text": "दो पॉलिसीज हैं। दोनों का कवर ₹1 लाख का"
    },
    {
      "subtitle_id": 79,
      "start": 174.16,
      "end": 179.44,
      "text": "है। पर एक का प्रीमियम ₹10,000 पर ईयर है"
    },
    {
      "subtitle_id": 80,
      "start": 176.48,
      "end": 181.44,
      "text": "तो दूसरे का है ₹8,000 तो आंख बंद करके जो"
    },
    {
      "subtitle_id": 81,
      "start": 179.44,
      "end": 183.84,
      "text": "सस्ती वाली है उसे खरीद लेते हैं। जैसे कि"
    },
    {
      "subtitle_id": 82,
      "start": 181.44,
      "end": 186.08,
      "text": "इस केस में ₹8,000 वाली और फिर आगे जाकर"
    },
    {
      "subtitle_id": 83,
      "start": 183.84,
      "end": 187.92,
      "text": "पछताते हैं। ऐसा कई सारे केसेस में हुआ है"
    },
    {
      "subtitle_id": 84,
      "start": 186.08,
      "end": 190.8,
      "text": "जहां पॉलिसी होल्डर को हॉस्पिटलाइज होने"
    },
    {
      "subtitle_id": 85,
      "start": 187.92,
      "end": 193.28,
      "text": "के बाद पता चला कि उनकी इंश्योरेंस पॉलिसी"
    },
    {
      "subtitle_id": 86,
      "start": 190.8,
      "end": 195.44,
      "text": "में कोपेमेंट का क्लॉज़ है। उससे पहले उनको"
    },
    {
      "subtitle_id": 87,
      "start": 193.28,
      "end": 197.599,
      "text": "पता ही नहीं था। तो यह चीज लिख लो आप कि"
    },
    {
      "subtitle_id": 88,
      "start": 195.44,
      "end": 199.92,
      "text": "जब भी आपको हेल्थ इंश्योरेंस लेनी है आपको"
    },
    {
      "subtitle_id": 89,
      "start": 197.599,
      "end": 203.36,
      "text": "मेक श्योर करना है कि उसमें को का क्लॉज"
    },
    {
      "subtitle_id": 90,
      "start": 199.92,
      "end": 205.2,
      "text": "ना हो। बिल्कुल ना हो। अब को के मामले में"
    },
    {
      "subtitle_id": 91,
      "start": 203.36,
      "end": 207.2,
      "text": "एक चीज ध्यान देने वाली है। यूजुअली"
    },
    {
      "subtitle_id": 92,
      "start": 205.2,
      "end": 209.28,
      "text": "सीनियर सिटीजंस की जो पॉलिसीज हैं, उनका"
    },
    {
      "subtitle_id": 93,
      "start": 207.2,
      "end": 211.12,
      "text": "प्रीमियम ज्यादा होता है। इस चक्कर में कई"
    },
    {
      "subtitle_id": 94,
      "start": 209.28,
      "end": 213.599,
      "text": "बार इंश्योरेंस कंपनीज़ क्या करती है कि"
    },
    {
      "subtitle_id": 95,
      "start": 211.12,
      "end": 216.0,
      "text": "सीनियर सिटीजन की पॉलिसीज में को का क्लॉज़"
    },
    {
      "subtitle_id": 96,
      "start": 213.599,
      "end": 218.239,
      "text": "ऐड कर देती है जिससे प्रीमियम कम हो जाता"
    },
    {
      "subtitle_id": 97,
      "start": 216.0,
      "end": 220.48,
      "text": "है। और फिर बहुत सारे लोग इंश्योरेंस कैसे"
    },
    {
      "subtitle_id": 98,
      "start": 218.239,
      "end": 222.4,
      "text": "खरीदते? तो प्राइस देखकर। तो ऐसी पॉलिसीज"
    },
    {
      "subtitle_id": 99,
      "start": 220.48,
      "end": 224.72,
      "text": "में जिसमें कोपे ज्यादा है उसमें प्रीमियम"
    },
    {
      "subtitle_id": 100,
      "start": 222.4,
      "end": 226.64,
      "text": "कम दिखता है तो लोग तुरंत उन्हें खरीदने"
    },
    {
      "subtitle_id": 101,
      "start": 224.72,
      "end": 228.959,
      "text": "लगते हैं और यह आज की डेट में हो रहा है।"
    },
    {
      "subtitle_id": 102,
      "start": 226.64,
      "end": 231.76,
      "text": "हजारों लाखों लोग इस तरह की चीजों में आज"
    },
    {
      "subtitle_id": 103,
      "start": 228.959,
      "end": 233.519,
      "text": "भी फंस रहे हैं और कई बार जो एजेंट है वो"
    },
    {
      "subtitle_id": 104,
      "start": 231.76,
      "end": 235.68,
      "text": "भी उन्हें नहीं बताता कि पॉलिसी में कोपे"
    },
    {
      "subtitle_id": 105,
      "start": 233.519,
      "end": 237.68,
      "text": "क्लॉज़ है और नाम सुन के भी लोगों को लगता"
    },
    {
      "subtitle_id": 106,
      "start": 235.68,
      "end": 239.439,
      "text": "है कि होगा कुछ तो भी देख लेंगे। तो"
    },
    {
      "subtitle_id": 107,
      "start": 237.68,
      "end": 241.599,
      "text": "इसीलिए सबसे इंपॉर्टेंट एक चीज जो आपको"
    },
    {
      "subtitle_id": 108,
      "start": 239.439,
      "end": 244.0,
      "text": "करनी चाहिए कि आपको कहीं से भी इंश्योरेंस"
    },
    {
      "subtitle_id": 109,
      "start": 241.599,
      "end": 246.239,
      "text": "नहीं लेना चाहिए। आपको उसे एक ट्रस्टेड"
    },
    {
      "subtitle_id": 110,
      "start": 244.0,
      "end": 248.56,
      "text": "प्लेटफार्म से ही लेना चाहिए जहां पर"
    },
    {
      "subtitle_id": 111,
      "start": 246.239,
      "end": 250.56,
      "text": "अच्छे तरीके से आपको गाइडेंस मिलता हो और"
    },
    {
      "subtitle_id": 112,
      "start": 248.56,
      "end": 253.12,
      "text": "ट्रांसपेरेंसी के साथ सारी चीजें आपको"
    },
    {
      "subtitle_id": 113,
      "start": 250.56,
      "end": 255.92,
      "text": "बताई जाती हो और जो आपके इंटरेस्ट को पहले"
    },
    {
      "subtitle_id": 114,
      "start": 253.12,
      "end": 258.56,
      "text": "रखे जिससे आपका भला हो पर क्या आज के"
    },
    {
      "subtitle_id": 115,
      "start": 255.92,
      "end": 260.639,
      "text": "जमाने में ऐसा कोई प्लेटफार्म है जरूर है"
    },
    {
      "subtitle_id": 116,
      "start": 258.56,
      "end": 263.52,
      "text": "और इस प्लेटफार्म का नाम है डिट्टो व्हिच"
    },
    {
      "subtitle_id": 117,
      "start": 260.639,
      "end": 265.36,
      "text": "इज बैक्ड बाय Zerodha और DTO की खास बात"
    },
    {
      "subtitle_id": 118,
      "start": 263.52,
      "end": 267.52,
      "text": "यह है कि यह सिर्फ आपको इंश्योरेंस खरीदने"
    },
    {
      "subtitle_id": 119,
      "start": 265.36,
      "end": 269.44,
      "text": "में मदद नहीं करता है बल्कि क्लेम के समय"
    },
    {
      "subtitle_id": 120,
      "start": 267.52,
      "end": 271.759,
      "text": "भी आपकी मदद करता है अगर आपको क्लेम"
    },
    {
      "subtitle_id": 121,
      "start": 269.44,
      "end": 273.36,
      "text": "रिलेटेड कोई क्वेरीज या फिर इशूज़ हो और"
    },
    {
      "subtitle_id": 122,
      "start": 271.759,
      "end": 275.199,
      "text": "आपको एक चीज चीज बताना चाहता हूं कि बाकी"
    },
    {
      "subtitle_id": 123,
      "start": 273.36,
      "end": 277.04,
      "text": "इंश्योरेंस एग्रीगेटर्स क्या करते हैं?"
    },
    {
      "subtitle_id": 124,
      "start": 275.199,
      "end": 279.12,
      "text": "जैसे ही आप उनकी वेबसाइट पर नंबर शेयर"
    },
    {
      "subtitle_id": 125,
      "start": 277.04,
      "end": 280.96,
      "text": "करते हो, वह बार-बार आपको कॉल करके स्पैम"
    },
    {
      "subtitle_id": 126,
      "start": 279.12,
      "end": 282.96,
      "text": "करते हैं और ऐसे इंश्योरेंस प्लांस आपको"
    },
    {
      "subtitle_id": 127,
      "start": 280.96,
      "end": 285.28,
      "text": "चिपकाते हैं जिनमें आपसे ज्यादा उनका"
    },
    {
      "subtitle_id": 128,
      "start": 282.96,
      "end": 287.44,
      "text": "फायदा हो। लेकिन डिट्टो ऐसा बिल्कुल नहीं"
    },
    {
      "subtitle_id": 129,
      "start": 285.28,
      "end": 289.759,
      "text": "करेगा क्योंकि डिट्टो की नो स्पैम पॉलिसी"
    },
    {
      "subtitle_id": 130,
      "start": 287.44,
      "end": 291.84,
      "text": "है। यानी वो बार-बार आपको कॉल करके परेशान"
    },
    {
      "subtitle_id": 131,
      "start": 289.759,
      "end": 293.84,
      "text": "नहीं करेंगे। ना ही डिट्टो के एक्सपर्ट्स"
    },
    {
      "subtitle_id": 132,
      "start": 291.84,
      "end": 295.84,
      "text": "आपको कोई प्लान सजेस्ट करेंगे जो आपके लिए"
    },
    {
      "subtitle_id": 133,
      "start": 293.84,
      "end": 297.68,
      "text": "सूटेबल ना हो। अगर आपने अपना हेल्थ"
    },
    {
      "subtitle_id": 134,
      "start": 295.84,
      "end": 299.36,
      "text": "इंश्योरेंस नहीं खरीदा और खरीदने का प्लान"
    },
    {
      "subtitle_id": 135,
      "start": 297.68,
      "end": 301.199,
      "text": "कर रहे हो तो अभी नीचे डिस्क्रिप्शन और"
    },
    {
      "subtitle_id": 136,
      "start": 299.36,
      "end": 303.04,
      "text": "कमेंट बॉक्स में दी गई लिंक पर क्लिक करके"
    },
    {
      "subtitle_id": 137,
      "start": 301.199,
      "end": 305.28,
      "text": "डिट्टो के एक्सपर्ट्स के साथ 30 मिनट का"
    },
    {
      "subtitle_id": 138,
      "start": 303.04,
      "end": 306.96,
      "text": "काउंसलिंग सेशन बुक कर लीजिए। जो भी आपको"
    },
    {
      "subtitle_id": 139,
      "start": 305.28,
      "end": 308.96,
      "text": "इंश्योरेंस से रिलेटेड डाउट्स हैं वो आप"
    },
    {
      "subtitle_id": 140,
      "start": 306.96,
      "end": 310.88,
      "text": "बेपर्दा बेझिझक उनसे पूछ लीजिए। तो"
    },
    {
      "subtitle_id": 141,
      "start": 308.96,
      "end": 313.44,
      "text": "इंश्योरेंस से रिलेटेड सारी मुश्किलों का"
    },
    {
      "subtitle_id": 142,
      "start": 310.88,
      "end": 315.84,
      "text": "समाधान सारे प्रॉब्लम्स का सशन आपको वहां"
    },
    {
      "subtitle_id": 143,
      "start": 313.44,
      "end": 318.4,
      "text": "पर मिल जाएगा। नाउ लेट्स गेट बैक टू द"
    },
    {
      "subtitle_id": 144,
      "start": 315.84,
      "end": 320.32,
      "text": "टॉपिक कि को क्लॉज़ वाला कोई भी इंश्योरेंस"
    },
    {
      "subtitle_id": 145,
      "start": 318.4,
      "end": 322.32,
      "text": "आपको नहीं खरीदना है। अब इंश्योरेंस"
    },
    {
      "subtitle_id": 146,
      "start": 320.32,
      "end": 325.44,
      "text": "खरीदते टाइम दूसरी सबसे बड़ी मिस्टेक जो"
    },
    {
      "subtitle_id": 147,
      "start": 322.32,
      "end": 328.08,
      "text": "लोग करते हैं वो है बाइंग पॉलिसी विद रूम"
    },
    {
      "subtitle_id": 148,
      "start": 325.44,
      "end": 330.08,
      "text": "रेंट लिमिट्स। अब यह है तो कॉपी जैसा ही"
    },
    {
      "subtitle_id": 149,
      "start": 328.08,
      "end": 332.16,
      "text": "लेकिन है उससे भी ज्यादा खतरनाक क्योंकि"
    },
    {
      "subtitle_id": 150,
      "start": 330.08,
      "end": 334.08,
      "text": "कोप में तो एक स्पेसिफिक परसेंटेज होता है"
    },
    {
      "subtitle_id": 151,
      "start": 332.16,
      "end": 337.039,
      "text": "पर यहां कोई स्पेसिफिक परसेंटेज नहीं"
    },
    {
      "subtitle_id": 152,
      "start": 334.08,
      "end": 340.479,
      "text": "होता। यहां आप 10 20 तो छोड़ दीजिए। आपको"
    },
    {
      "subtitle_id": 153,
      "start": 337.039,
      "end": 342.8,
      "text": "50% तक का बिल भरना पड़ सकता है। यस। आप"
    },
    {
      "subtitle_id": 154,
      "start": 340.479,
      "end": 344.639,
      "text": "इसे एक एग्जांपल के साथ समझिए। मान लीजिए"
    },
    {
      "subtitle_id": 155,
      "start": 342.8,
      "end": 347.44,
      "text": "कोई एक पॉलिसी लेता है जिसमें रूम रेंट"
    },
    {
      "subtitle_id": 156,
      "start": 344.639,
      "end": 350.32,
      "text": "लिमिट है सिर्फ ₹5,000 का पर कोई इलाज"
    },
    {
      "subtitle_id": 157,
      "start": 347.44,
      "end": 352.56,
      "text": "करवाता है ₹10,000 पर डे के रूम रेंट में"
    },
    {
      "subtitle_id": 158,
      "start": 350.32,
      "end": 353.8,
      "text": "तो आप स्क्रीन पर देख सकते हो कि टोटल बिल"
    },
    {
      "subtitle_id": 159,
      "start": 352.56,
      "end": 356.479,
      "text": "बन सकता है"
    },
    {
      "subtitle_id": 160,
      "start": 353.8,
      "end": 359.12,
      "text": "₹4,28,000। अब होगा क्या कि रूम रेंट"
    },
    {
      "subtitle_id": 161,
      "start": 356.479,
      "end": 362.32,
      "text": "लिमिट तो ₹5,000 की है। वहीं पर आपका रूम"
    },
    {
      "subtitle_id": 162,
      "start": 359.12,
      "end": 365.12,
      "text": "रेंट था ₹10,000 का व्हिच इज 50% ऑफ"
    },
    {
      "subtitle_id": 163,
      "start": 362.32,
      "end": 367.44,
      "text": "एलिजिबल रूम रेंट। अब यहां पर कैच यह है"
    },
    {
      "subtitle_id": 164,
      "start": 365.12,
      "end": 370.24,
      "text": "कि वो अमाउंट सिर्फ रूम रेंट पर ही नहीं"
    },
    {
      "subtitle_id": 165,
      "start": 367.44,
      "end": 372.0,
      "text": "लगेगा। हर चीज में अदर दन मेडिसिंस। अब इस"
    },
    {
      "subtitle_id": 166,
      "start": 370.24,
      "end": 374.4,
      "text": "केस में इंश्योरेंस कंपनी देखो क्या करती"
    },
    {
      "subtitle_id": 167,
      "start": 372.0,
      "end": 377.28,
      "text": "है कि जो भी आपके आईसीयू के चार्जेस होंगे"
    },
    {
      "subtitle_id": 168,
      "start": 374.4,
      "end": 379.039,
      "text": "उस पर भी 50% इंश्योरेंस कंपनी आपको देगी।"
    },
    {
      "subtitle_id": 169,
      "start": 377.28,
      "end": 381.199,
      "text": "टेस्ट के चार्जेस, सर्जरी के चार्जेस,"
    },
    {
      "subtitle_id": 170,
      "start": 379.039,
      "end": 383.36,
      "text": "डॉक्टर विजिट के चार्जेस सारे के सारे"
    },
    {
      "subtitle_id": 171,
      "start": 381.199,
      "end": 385.759,
      "text": "चार्जेस का 50% इंश्योरेंस कंपनीज़ पे"
    },
    {
      "subtitle_id": 172,
      "start": 383.36,
      "end": 387.84,
      "text": "करेगी। क्यों? क्योंकि ये सारे के सारे"
    },
    {
      "subtitle_id": 173,
      "start": 385.759,
      "end": 389.44,
      "text": "चार्जेस रूम रेंट से रिलेटेड है। अब"
    },
    {
      "subtitle_id": 174,
      "start": 387.84,
      "end": 391.28,
      "text": "हॉस्पिटल्स में जनरली क्या होता है कि"
    },
    {
      "subtitle_id": 175,
      "start": 389.44,
      "end": 394.0,
      "text": "जनरल वार्ड है मान लीजिए और एक प्राइवेट"
    },
    {
      "subtitle_id": 176,
      "start": 391.28,
      "end": 395.919,
      "text": "रूम है। जनरल वार्ड मान लीजिए ₹5,000 पर"
    },
    {
      "subtitle_id": 177,
      "start": 394.0,
      "end": 398.16,
      "text": "डे है। प्राइवेट रूम लेट्स से ₹10,000 पर"
    },
    {
      "subtitle_id": 178,
      "start": 395.919,
      "end": 399.759,
      "text": "डे है। तो वहां पर सिर्फ रूम रेंट ही नहीं"
    },
    {
      "subtitle_id": 179,
      "start": 398.16,
      "end": 401.36,
      "text": "बढ़ रहा है आपका। प्राइवेट रूम में आप रह"
    },
    {
      "subtitle_id": 180,
      "start": 399.759,
      "end": 403.68,
      "text": "रहे हो तो आपको सर्जरी की कॉस्ट भी ज्यादा"
    },
    {
      "subtitle_id": 181,
      "start": 401.36,
      "end": 405.84,
      "text": "लगेगी। सेम सर्जरी है। आप जनरल वार्ड में"
    },
    {
      "subtitle_id": 182,
      "start": 403.68,
      "end": 407.28,
      "text": "रहेंगे तो भी वही सर्जरी है। प्राइवेट रूम"
    },
    {
      "subtitle_id": 183,
      "start": 405.84,
      "end": 409.44,
      "text": "में रहेंगे तो भी वही सर्जरी है। अभी यह"
    },
    {
      "subtitle_id": 184,
      "start": 407.28,
      "end": 411.12,
      "text": "मेरा एक सर्जरी हुआ केवायर सर्जरी। इसमें"
    },
    {
      "subtitle_id": 185,
      "start": 409.44,
      "end": 413.12,
      "text": "भी सेम ही था। मैं जिस रूम में था उसके"
    },
    {
      "subtitle_id": 186,
      "start": 411.12,
      "end": 415.6,
      "text": "चार्जेस अलग। किसी और रूम के थे उसके"
    },
    {
      "subtitle_id": 187,
      "start": 413.12,
      "end": 418.56,
      "text": "चार्जेस अलग। सेम सर्जरी। सेम टेस्ट हो"
    },
    {
      "subtitle_id": 188,
      "start": 415.6,
      "end": 420.16,
      "text": "रही है। लेकिन चार्जेस रूम वाइज डिफरेंट"
    },
    {
      "subtitle_id": 189,
      "start": 418.56,
      "end": 422.16,
      "text": "होते हैं। हॉस्पिटल का यह अलग ही गेम है"
    },
    {
      "subtitle_id": 190,
      "start": 420.16,
      "end": 423.759,
      "text": "जो मुझे समझ में नहीं आया अभी तक। तो आप"
    },
    {
      "subtitle_id": 191,
      "start": 422.16,
      "end": 424.599,
      "text": "स्क्रीन पर देख सकते हो कि आपको इस केस"
    },
    {
      "subtitle_id": 192,
      "start": 423.759,
      "end": 427.599,
      "text": "में"
    },
    {
      "subtitle_id": 193,
      "start": 424.599,
      "end": 430.56,
      "text": "₹1,84,000 तक आउट ऑफ पॉकेट भरना पड़ेगा।"
    },
    {
      "subtitle_id": 194,
      "start": 427.599,
      "end": 432.16,
      "text": "इसका मतलब है आपके जेब में से। सो मेक"
    },
    {
      "subtitle_id": 195,
      "start": 430.56,
      "end": 434.8,
      "text": "श्योर करना कि जो भी इंश्योरेंस पॉलिसी आप"
    },
    {
      "subtitle_id": 196,
      "start": 432.16,
      "end": 436.56,
      "text": "खरीद रहे हो आपको उस पर रूम रेंट की लिमिट"
    },
    {
      "subtitle_id": 197,
      "start": 434.8,
      "end": 438.72,
      "text": "ना हो। नहीं तो फिर प्रीमियम तो आपको कम"
    },
    {
      "subtitle_id": 198,
      "start": 436.56,
      "end": 440.72,
      "text": "लगेगा लेकिन बाद में आपको ज्यादा पैसा पे"
    },
    {
      "subtitle_id": 199,
      "start": 438.72,
      "end": 442.479,
      "text": "करना पड़ेगा। और अगर रूम रेंट वाली ले ही"
    },
    {
      "subtitle_id": 200,
      "start": 440.72,
      "end": 444.96,
      "text": "रहे हो तो एटलीस्ट यह मेक श्योर करो कि"
    },
    {
      "subtitle_id": 201,
      "start": 442.479,
      "end": 447.28,
      "text": "सिंगल प्राइवेट रूम तो उसमें हो। इसके बाद"
    },
    {
      "subtitle_id": 202,
      "start": 444.96,
      "end": 449.28,
      "text": "तीसरी बड़ी मिस्टेक जिसकी वजह से लोगों को"
    },
    {
      "subtitle_id": 203,
      "start": 447.28,
      "end": 451.039,
      "text": "लेने के देने पड़ जाते हैं इंश्योरेंस में"
    },
    {
      "subtitle_id": 204,
      "start": 449.28,
      "end": 453.599,
      "text": "वो है आपको मेक श्योर करना है कि डिजीज"
    },
    {
      "subtitle_id": 205,
      "start": 451.039,
      "end": 455.36,
      "text": "वाइज कोई सबमिट पॉलिसी में ना हो। यानी कि"
    },
    {
      "subtitle_id": 206,
      "start": 453.599,
      "end": 457.52,
      "text": "कुछ पॉलिसीज में होता है कि कवरेज तो"
    },
    {
      "subtitle_id": 207,
      "start": 455.36,
      "end": 459.68,
      "text": "10-15 लाख का होता है पर अंदर से अलग-अलग"
    },
    {
      "subtitle_id": 208,
      "start": 457.52,
      "end": 462.16,
      "text": "डिजीजसेस पर सब लिमिट्स लगी हुई होती है।"
    },
    {
      "subtitle_id": 209,
      "start": 459.68,
      "end": 464.639,
      "text": "जैसे हार्ट रिलेटेड इलनेसेस पर ₹2 लाख का"
    },
    {
      "subtitle_id": 210,
      "start": 462.16,
      "end": 467.36,
      "text": "लिमिट तो होगा क्या कि ओवरऑल कवरेज भले ही"
    },
    {
      "subtitle_id": 211,
      "start": 464.639,
      "end": 469.599,
      "text": "₹1 लाख का हो पर अगर हॉस्पिटल बिल ₹4 लाख"
    },
    {
      "subtitle_id": 212,
      "start": 467.36,
      "end": 471.84,
      "text": "का आता है तो सिर्फ ₹ लाख ही इंश्योरेंस"
    },
    {
      "subtitle_id": 213,
      "start": 469.599,
      "end": 473.68,
      "text": "कंपनी पे करेगी। बाकी ₹ लाख आपको अपनी जेब"
    },
    {
      "subtitle_id": 214,
      "start": 471.84,
      "end": 476.319,
      "text": "से ही पे करने हैं। क्यों? क्योंकि डिजीज"
    },
    {
      "subtitle_id": 215,
      "start": 473.68,
      "end": 478.319,
      "text": "वाइज सब लिमिट थी मात्र ₹ लाख की। एक"
    },
    {
      "subtitle_id": 216,
      "start": 476.319,
      "end": 480.879,
      "text": "इंश्योरेंस कंपनी मैं नाम नहीं लूंगा। आप"
    },
    {
      "subtitle_id": 217,
      "start": 478.319,
      "end": 482.72,
      "text": "अगर नाम पता कर पाए तो कमेंट में बता देना"
    },
    {
      "subtitle_id": 218,
      "start": 480.879,
      "end": 485.919,
      "text": "जो इस तरह की हरकतें करने के लिए काफी"
    },
    {
      "subtitle_id": 219,
      "start": 482.72,
      "end": 487.84,
      "text": "फेमस है। यह इस तरह की चीजें डालती है और"
    },
    {
      "subtitle_id": 220,
      "start": 485.919,
      "end": 489.599,
      "text": "फिर बाद में अपनी जो प्रीमियम है उसको भी"
    },
    {
      "subtitle_id": 221,
      "start": 487.84,
      "end": 491.52,
      "text": "थोड़ा कम कर लेती है ताकि ज्यादा से"
    },
    {
      "subtitle_id": 222,
      "start": 489.599,
      "end": 493.759,
      "text": "ज्यादा लोग उनके इंश्योरेंस को प्रेफर"
    },
    {
      "subtitle_id": 223,
      "start": 491.52,
      "end": 496.0,
      "text": "करें कंपेयर टू अदर्स। बट इस तरह की हिडन"
    },
    {
      "subtitle_id": 224,
      "start": 493.759,
      "end": 497.84,
      "text": "चीजें उनके इंश्योरेंस पॉलिसीज में काफी"
    },
    {
      "subtitle_id": 225,
      "start": 496.0,
      "end": 499.759,
      "text": "रहती है जो लोगों को बाद में रियलाइज होती"
    },
    {
      "subtitle_id": 226,
      "start": 497.84,
      "end": 501.44,
      "text": "है कि अरे यह तो गलती हो गई। यह कंपनी"
    },
    {
      "subtitle_id": 227,
      "start": 499.759,
      "end": 503.28,
      "text": "बहुत सारे क्लॉज़ लगाने के लिए फेमस है।"
    },
    {
      "subtitle_id": 228,
      "start": 501.44,
      "end": 506.16,
      "text": "फिर उसमें रूम रेंट लिमिट आता है। आपका"
    },
    {
      "subtitle_id": 229,
      "start": 503.28,
      "end": 508.0,
      "text": "कोप आता है। आपका डिज़ सब लिमिट आता है।"
    },
    {
      "subtitle_id": 230,
      "start": 506.16,
      "end": 510.16,
      "text": "क्यों? ताकि उनके इंश्योरेंस प्रीमियम"
    },
    {
      "subtitle_id": 231,
      "start": 508.0,
      "end": 511.84,
      "text": "काफी कम रहे। फिर अपने प्रीमियम को पूरी"
    },
    {
      "subtitle_id": 232,
      "start": 510.16,
      "end": 514.0,
      "text": "इंडस्ट्री में बहुत कम रखते हैं। क्यों?"
    },
    {
      "subtitle_id": 233,
      "start": 511.84,
      "end": 515.839,
      "text": "क्योंकि इंडिया में सबसे सस्ता ही सबसे"
    },
    {
      "subtitle_id": 234,
      "start": 514.0,
      "end": 518.32,
      "text": "ज्यादा बिकता है व्हेन इट कम्स टू"
    },
    {
      "subtitle_id": 235,
      "start": 515.839,
      "end": 520.479,
      "text": "इंश्योरेंस। तो ऐसी पॉलिसी से दूर रहिए।"
    },
    {
      "subtitle_id": 236,
      "start": 518.32,
      "end": 522.56,
      "text": "यह आज के इस वीडियो का बहुत इंपॉर्टेंट"
    },
    {
      "subtitle_id": 237,
      "start": 520.479,
      "end": 524.56,
      "text": "पॉइंट है। चौथी चीज जो आपको ध्यान में"
    },
    {
      "subtitle_id": 238,
      "start": 522.56,
      "end": 527.519,
      "text": "रखनी है कि आजकल हर एक चीज बहुत तेज हो"
    },
    {
      "subtitle_id": 239,
      "start": 524.56,
      "end": 529.44,
      "text": "चुकी है। इनफैक्ट मेडिकल ऑपरेशंस भी काफी"
    },
    {
      "subtitle_id": 240,
      "start": 527.519,
      "end": 531.6,
      "text": "फास्ट हो गए हैं। पहले जिन प्रोसीजर्स में"
    },
    {
      "subtitle_id": 241,
      "start": 529.44,
      "end": 533.76,
      "text": "दो से तीन दिन लगते थे वो आज कुछ घंटों"
    },
    {
      "subtitle_id": 242,
      "start": 531.6,
      "end": 536.0,
      "text": "में हो जाती है और हेल्थ इंश्योरेंस का"
    },
    {
      "subtitle_id": 243,
      "start": 533.76,
      "end": 538.8,
      "text": "मेन फोकस होता है हॉस्पिटलाइजेशन पर।"
    },
    {
      "subtitle_id": 244,
      "start": 536.0,
      "end": 541.279,
      "text": "इसीलिए कई सारे लोग डे केयर ट्रीटमेंट उस"
    },
    {
      "subtitle_id": 245,
      "start": 538.8,
      "end": 543.36,
      "text": "पॉलिसी में कवर है या नहीं यह चेक करना ही"
    },
    {
      "subtitle_id": 246,
      "start": 541.279,
      "end": 545.92,
      "text": "भूल जाते हैं। जैसे मुझे अपने हाथ में जब"
    },
    {
      "subtitle_id": 247,
      "start": 543.36,
      "end": 547.76,
      "text": "चोट लगी तो यह जो मेरी सर्जरी थी, यह कुछ"
    },
    {
      "subtitle_id": 248,
      "start": 545.92,
      "end": 549.68,
      "text": "ही घंटों में हो गई। इसके लिए मुझे कोई"
    },
    {
      "subtitle_id": 249,
      "start": 547.76,
      "end": 551.68,
      "text": "हॉस्पिटलाइज होने की जरूरत नहीं पड़ी।"
    },
    {
      "subtitle_id": 250,
      "start": 549.68,
      "end": 553.36,
      "text": "लेकिन सर्जरी की कॉज भी बहुत तगड़ी थी। और"
    },
    {
      "subtitle_id": 251,
      "start": 551.68,
      "end": 556.16,
      "text": "मेरा यह मानना है कि धीरे-धीरे जो बड़ी"
    },
    {
      "subtitle_id": 252,
      "start": 553.36,
      "end": 558.32,
      "text": "सर्जरीज है जिसे आज मेजर सर्जरी कहा जाता"
    },
    {
      "subtitle_id": 253,
      "start": 556.16,
      "end": 560.64,
      "text": "है वो भी कुछ घंटों में आने वाले टाइम में"
    },
    {
      "subtitle_id": 254,
      "start": 558.32,
      "end": 562.24,
      "text": "हो पाएगी और वो भी डे केयर कैटेगरी में आ"
    },
    {
      "subtitle_id": 255,
      "start": 560.64,
      "end": 564.399,
      "text": "जाएगी जिसमें आपको हॉस्पिटलाइज होने की"
    },
    {
      "subtitle_id": 256,
      "start": 562.24,
      "end": 565.839,
      "text": "शायद जरूरत ना पड़े। अब फॉर्चूनेटली क्या"
    },
    {
      "subtitle_id": 257,
      "start": 564.399,
      "end": 567.839,
      "text": "था कि मैंने जो पॉलिसी ली थी उसमें डे"
    },
    {
      "subtitle_id": 258,
      "start": 565.839,
      "end": 569.92,
      "text": "केयर का बेनिफिट था। तो इसलिए मैं तो बच"
    },
    {
      "subtitle_id": 259,
      "start": 567.839,
      "end": 571.68,
      "text": "गया। लेकिन कई सारे लोग इस चीज पर ध्यान"
    },
    {
      "subtitle_id": 260,
      "start": 569.92,
      "end": 573.2,
      "text": "नहीं देते हैं। तो हेल्थ इंश्योरेंस लेते"
    },
    {
      "subtitle_id": 261,
      "start": 571.68,
      "end": 576.0,
      "text": "समय आपको यह चीज जरूर ध्यान में रखनी है"
    },
    {
      "subtitle_id": 262,
      "start": 573.2,
      "end": 578.16,
      "text": "कि आपकी पॉलिसी में डे केयर बेनिफिट जरूर"
    },
    {
      "subtitle_id": 263,
      "start": 576.0,
      "end": 579.68,
      "text": "हो। तो इंश्योरेंस खरीदते टाइम जो पांचवी"
    },
    {
      "subtitle_id": 264,
      "start": 578.16,
      "end": 581.92,
      "text": "चीज आपको ध्यान में रखनी है वो है"
    },
    {
      "subtitle_id": 265,
      "start": 579.68,
      "end": 583.519,
      "text": "रिस्टोरेशन बेनिफिट। खासकर जब आप अपनी"
    },
    {
      "subtitle_id": 266,
      "start": 581.92,
      "end": 585.6,
      "text": "फैमिली के लिए हेल्थ इंश्योरेंस ले रहे"
    },
    {
      "subtitle_id": 267,
      "start": 583.519,
      "end": 587.92,
      "text": "हो। रिस्टोरेशन बेनिफिट क्या है? मान"
    },
    {
      "subtitle_id": 268,
      "start": 585.6,
      "end": 589.92,
      "text": "लीजिए आपका कवर है ₹5 लाख का। आप"
    },
    {
      "subtitle_id": 269,
      "start": 587.92,
      "end": 592.399,
      "text": "हॉस्पिटलाइज होते हो और 44 लाख का बिल आता"
    },
    {
      "subtitle_id": 270,
      "start": 589.92,
      "end": 594.56,
      "text": "है और आपका क्लेम पास हो जाता है। पर कुछ"
    },
    {
      "subtitle_id": 271,
      "start": 592.399,
      "end": 596.88,
      "text": "महीने बाद आप फिर से हॉस्पिटलाइज होते हो"
    },
    {
      "subtitle_id": 272,
      "start": 594.56,
      "end": 598.64,
      "text": "और फिर से ₹4 लाख का बिल आता है। तो उस"
    },
    {
      "subtitle_id": 273,
      "start": 596.88,
      "end": 601.519,
      "text": "केस में अगर आपकी पॉलिसी में रिस्टोरेशन"
    },
    {
      "subtitle_id": 274,
      "start": 598.64,
      "end": 603.68,
      "text": "बेनिफिट है तो आपका ₹5 लाख का कवर फिर से"
    },
    {
      "subtitle_id": 275,
      "start": 601.519,
      "end": 605.92,
      "text": "रिस्टोर हो जाएगा और आपका जो सेकंड टाइम"
    },
    {
      "subtitle_id": 276,
      "start": 603.68,
      "end": 609.2,
      "text": "वाला बिल है उसका भी क्लेम पास हो जाएगा।"
    },
    {
      "subtitle_id": 277,
      "start": 605.92,
      "end": 611.519,
      "text": "तो यह जो फाइव मिस्टेक्स है यह बहुत आम हो"
    },
    {
      "subtitle_id": 278,
      "start": 609.2,
      "end": 613.04,
      "text": "गई है। लगभग हर कोई कर रहा है। अगर आप यह"
    },
    {
      "subtitle_id": 279,
      "start": 611.519,
      "end": 616.399,
      "text": "नहीं करते हो तो मैं आपको गारंटी के साथ"
    },
    {
      "subtitle_id": 280,
      "start": 613.04,
      "end": 619.12,
      "text": "बता सकता हूं कि 90% आपका क्लेम पास हो ही"
    },
    {
      "subtitle_id": 281,
      "start": 616.399,
      "end": 620.88,
      "text": "जाएगा। नो मैटर व्हाट। इसके अलावा दो ऐसी"
    },
    {
      "subtitle_id": 282,
      "start": 619.12,
      "end": 622.64,
      "text": "और चीजें जो आपको ध्यान में रखनी चाहिए।"
    },
    {
      "subtitle_id": 283,
      "start": 620.88,
      "end": 624.32,
      "text": "प्री एंड पोस्ट हॉस्पिटलाइजेशन का टाइम"
    },
    {
      "subtitle_id": 284,
      "start": 622.64,
      "end": 626.88,
      "text": "पीरियड भी ज्यादा होना चाहिए। मिनिमम 30"
    },
    {
      "subtitle_id": 285,
      "start": 624.32,
      "end": 628.72,
      "text": "डेज प्री और 60 डेज पोस्ट की होनी चाहिए।"
    },
    {
      "subtitle_id": 286,
      "start": 626.88,
      "end": 631.279,
      "text": "अगर इससे भी ज्यादा तो और भी बेटर है।"
    },
    {
      "subtitle_id": 287,
      "start": 628.72,
      "end": 633.44,
      "text": "यानी कि हॉस्पिटलाइज होने के पहले के 30"
    },
    {
      "subtitle_id": 288,
      "start": 631.279,
      "end": 635.44,
      "text": "दिन और बाद के 60 दिन तक आपको जो अपना जो"
    },
    {
      "subtitle_id": 289,
      "start": 633.44,
      "end": 637.6,
      "text": "खर्चा है एक्सपेंसेस है वो आपको रिबर्स"
    },
    {
      "subtitle_id": 290,
      "start": 635.44,
      "end": 639.279,
      "text": "किए जाएंगे। वापस मिल जाएंगे। सेकंड चीज"
    },
    {
      "subtitle_id": 291,
      "start": 637.6,
      "end": 640.959,
      "text": "लो वेटिंग पीरियड फॉर प्री एकिस्टिंग"
    },
    {
      "subtitle_id": 292,
      "start": 639.279,
      "end": 643.12,
      "text": "डिजीजसेस का भी ध्यान रखें। अगर आपकी"
    },
    {
      "subtitle_id": 293,
      "start": 640.959,
      "end": 645.44,
      "text": "पॉलिसी में ऑप्शन हो तो थोड़ा एक्स्ट्रा"
    },
    {
      "subtitle_id": 294,
      "start": 643.12,
      "end": 647.2,
      "text": "पे करके वेटिंग पीरियड कम आप कर सकते हो।"
    },
    {
      "subtitle_id": 295,
      "start": 645.44,
      "end": 649.68,
      "text": "तो मेरी माने तो यह दोनों भी चीजें आपको"
    },
    {
      "subtitle_id": 296,
      "start": 647.2,
      "end": 651.279,
      "text": "जरूर जरूर कर लेनी चाहिए। तो यह पांच"
    },
    {
      "subtitle_id": 297,
      "start": 649.68,
      "end": 653.6,
      "text": "मिस्टेक्स है जो आपको कंप्लीटली अवॉइड"
    },
    {
      "subtitle_id": 298,
      "start": 651.279,
      "end": 656.16,
      "text": "करनी है। एक बार रिवाइज करता हूं ताकि"
    },
    {
      "subtitle_id": 299,
      "start": 653.6,
      "end": 658.56,
      "text": "हमेशा आपके दिमाग में रहे। पहला है कि बाय"
    },
    {
      "subtitle_id": 300,
      "start": 656.16,
      "end": 660.72,
      "text": "पॉलिसी विदाउट कोपिंग। दूसरा है बाय"
    },
    {
      "subtitle_id": 301,
      "start": 658.56,
      "end": 663.04,
      "text": "पॉलिसी विदाउट रूमरेंट लिमिट या फिर"
    },
    {
      "subtitle_id": 302,
      "start": 660.72,
      "end": 664.48,
      "text": "मिनिमम प्राइवेट रूम तक आपको लेना है।"
    },
    {
      "subtitle_id": 303,
      "start": 663.04,
      "end": 666.64,
      "text": "तीसरा आपको मेक श्योर करना है कि आपकी"
    },
    {
      "subtitle_id": 304,
      "start": 664.48,
      "end": 668.56,
      "text": "पॉलिसी में डिजीज वाइज कोई सब लिमिट ना"
    },
    {
      "subtitle_id": 305,
      "start": 666.64,
      "end": 670.64,
      "text": "हो। और चौथा है कि बहुत सारी जो सर्जरीज"
    },
    {
      "subtitle_id": 306,
      "start": 668.56,
      "end": 672.72,
      "text": "है आजकल घंटों में हो जाती है। इसलिए डे"
    },
    {
      "subtitle_id": 307,
      "start": 670.64,
      "end": 675.12,
      "text": "केयर ट्रीटमेंट आपकी पॉलिसी में होनी होनी"
    },
    {
      "subtitle_id": 308,
      "start": 672.72,
      "end": 677.36,
      "text": "चाहिए। और पांचवा रिस्टोरेशन बेनिफिट आपकी"
    },
    {
      "subtitle_id": 309,
      "start": 675.12,
      "end": 679.6,
      "text": "पॉलिसी में होना चाहिए पर्टिकुलरली तब जब"
    },
    {
      "subtitle_id": 310,
      "start": 677.36,
      "end": 681.839,
      "text": "आपका प्लान फैमिली फ्लोटर हो। और एक"
    },
    {
      "subtitle_id": 311,
      "start": 679.6,
      "end": 683.839,
      "text": "सिक्स्थ बोनस चीज आपको देखनी है कि आपको"
    },
    {
      "subtitle_id": 312,
      "start": 681.839,
      "end": 686.079,
      "text": "अपना इंश्योरेंस एक अच्छे प्लेटफार्म से"
    },
    {
      "subtitle_id": 313,
      "start": 683.839,
      "end": 688.8,
      "text": "ही लेना है जो आपको इंश्योरेंस खरीदते समय"
    },
    {
      "subtitle_id": 314,
      "start": 686.079,
      "end": 691.519,
      "text": "ही नहीं बल्कि क्लेम के समय भी आपकी मदद"
    },
    {
      "subtitle_id": 315,
      "start": 688.8,
      "end": 693.519,
      "text": "करें और डिट्टो एक ऐसा ही प्लेटफार्म है।"
    },
    {
      "subtitle_id": 316,
      "start": 691.519,
      "end": 695.519,
      "text": "आपको यह नो स्पैम इंश्योरेंस प्रोवाइड"
    },
    {
      "subtitle_id": 317,
      "start": 693.519,
      "end": 697.68,
      "text": "करते हैं और साथ ही क्लेम के समय भी आपकी"
    },
    {
      "subtitle_id": 318,
      "start": 695.519,
      "end": 699.519,
      "text": "मदद करते हैं और इसी के साथ डिट्टो के पास"
    },
    {
      "subtitle_id": 319,
      "start": 697.68,
      "end": 701.12,
      "text": "एक डेडिकेटेड क्लेम एक्सपर्ट्स की टीम है"
    },
    {
      "subtitle_id": 320,
      "start": 699.519,
      "end": 703.12,
      "text": "जो पॉलिसी होल्डर्स को मदद करते हैं।"
    },
    {
      "subtitle_id": 321,
      "start": 701.12,
      "end": 704.88,
      "text": "क्लेम में अगर कोई इशू उन्हें आता है तो"
    },
    {
      "subtitle_id": 322,
      "start": 703.12,
      "end": 706.399,
      "text": "तो अगर आपने अभी तक इंश्योरेंस नहीं लिया"
    },
    {
      "subtitle_id": 323,
      "start": 704.88,
      "end": 708.959,
      "text": "है तो डिस्क्रिप्शन और कमेंट बॉक्स में"
    },
    {
      "subtitle_id": 324,
      "start": 706.399,
      "end": 711.12,
      "text": "लिंक दी गई है। अभी जाइए और 30 मिनट का"
    },
    {
      "subtitle_id": 325,
      "start": 708.959,
      "end": 713.279,
      "text": "फ्री कॉल डिट्टो की टीम के साथ बुक कीजिए"
    },
    {
      "subtitle_id": 326,
      "start": 711.12,
      "end": 715.839,
      "text": "और अपने लिए एक बेस्ट इंश्योरेंस आज ही"
    },
    {
      "subtitle_id": 327,
      "start": 713.279,
      "end": 717.76,
      "text": "खरीदिए। अब यह तो थी पांच मिस्टेक्स जो"
    },
    {
      "subtitle_id": 328,
      "start": 715.839,
      "end": 720.079,
      "text": "आपको इंश्योरेंस खरीदते टाइम अवॉइड करनी"
    },
    {
      "subtitle_id": 329,
      "start": 717.76,
      "end": 722.399,
      "text": "है। लेकिन ऐसी भी पांच मिस्टेक्स हैं जब"
    },
    {
      "subtitle_id": 330,
      "start": 720.079,
      "end": 724.56,
      "text": "आप क्लेम करने जाते हो ना तब आपको अवॉइड"
    },
    {
      "subtitle_id": 331,
      "start": 722.399,
      "end": 727.519,
      "text": "करनी है। और उन पांच मिस्टेक्स की वजह से"
    },
    {
      "subtitle_id": 332,
      "start": 724.56,
      "end": 729.92,
      "text": "ही 50% से ज्यादा जो लोग हैं उनके क्लेम्स"
    },
    {
      "subtitle_id": 333,
      "start": 727.519,
      "end": 733.36,
      "text": "रिजेक्ट हो जाते हैं। क्या है वो पांच"
    },
    {
      "subtitle_id": 334,
      "start": 729.92,
      "end": 734.639,
      "text": "चीजें? बात करेंगे नेक्स्ट वीडियो में। तो"
    },
    {
      "subtitle_id": 335,
      "start": 733.36,
      "end": 736.48,
      "text": "फिलहाल हम यहीं रुकते हैं और इस"
    },
    {
      "subtitle_id": 336,
      "start": 734.639,
      "end": 738.16,
      "text": "इंश्योरेंस सीरीज में आशा करते हैं कि आप"
    },
    {
      "subtitle_id": 337,
      "start": 736.48,
      "end": 740.56,
      "text": "बहुत सारी नई-नई चीजें सीख रहे हो तो"
    },
    {
      "subtitle_id": 338,
      "start": 738.16,
      "end": 742.8,
      "text": "उन्हें इंप्लीमेंट भी जरूर करें ताकि उससे"
    },
    {
      "subtitle_id": 339,
      "start": 740.56,
      "end": 744.24,
      "text": "आपका बेस्ट से बेस्ट फायदा हो। अगर आपने"
    },
    {
      "subtitle_id": 340,
      "start": 742.8,
      "end": 745.76,
      "text": "चैनल को अभी तक सब्सक्राइब नहीं किया तो"
    },
    {
      "subtitle_id": 341,
      "start": 744.24,
      "end": 748.24,
      "text": "सब्सक्राइब कर लीजिए और बेल आइकॉन पर भी"
    },
    {
      "subtitle_id": 342,
      "start": 745.76,
      "end": 750.56,
      "text": "क्लिक कीजिए और इसी तरह के वीडियोस देखते"
    },
    {
      "subtitle_id": 343,
      "start": 748.24,
      "end": 753.68,
      "text": "रहिए। अपने आप को अपग्रेड कीजिए। पैसा"
    },
    {
      "subtitle_id": 344,
      "start": 750.56,
      "end": 755.839,
      "text": "बचाइए और पैसा बनाइए। अगर कोई क्वेरी है"
    },
    {
      "subtitle_id": 345,
      "start": 753.68,
      "end": 757.92,
      "text": "तो कमेंट सेक्शन में जरूर बताइए। हम उसका"
    },
    {
      "subtitle_id": 346,
      "start": 755.839,
      "end": 761.12,
      "text": "रिप्लाई देने की जरूर कोशिश करेंगे। सी यू"
    },
    {
      "subtitle_id": 347,
      "start": 757.92,
      "end": 761.12,
      "text": "सून। बाय।"
    }
  ]
}