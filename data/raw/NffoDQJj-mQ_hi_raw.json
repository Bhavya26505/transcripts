    },
    {
      "subtitle_id": 193,
      "start": 504.44,
      "end": 510.52,
      "text": "देखिए यह थोड़ा साइकोलॉजी का गेम था यहां"
    },
    {
      "subtitle_id": 194,
      "start": 507.12,
      "end": 512.24,
      "text": "पर कि जिसके पैसे फंसे हुए हैं वो किसी भी"
    },
    {
      "subtitle_id": 195,
      "start": 510.52,
      "end": 514.44,
      "text": "हालत में चाहेगा कि मेरे पैसे वापस आए और"
    },
    {
      "subtitle_id": 196,
      "start": 512.24,
      "end": 516.839,
      "text": "उसके लिए वो एडिशनल पैसे भी पे करता है यह"
    },
    {
      "subtitle_id": 197,
      "start": 514.44,
      "end": 518.519,
      "text": "साइकोलॉजिकली प्रूवन चीज है इसी चीज का"
    },
    {
      "subtitle_id": 198,
      "start": 516.839,
      "end": 520.519,
      "text": "इस्तेमाल करके कंपनी ने क्या किया कि"
    },
    {
      "subtitle_id": 199,
      "start": 518.519,
      "end": 522.12,
      "text": "लोगों को बताया कि अगर आप ये प्रायोरिटी"
    },
    {
      "subtitle_id": 200,
      "start": 520.519,
      "end": 523.44,
      "text": "पास नहीं खरीदेंगे तो आप पैसा इस्तेमाल"
    },
    {
      "subtitle_id": 201,
      "start": 522.12,
      "end": 525.72,
      "text": "नहीं कर पाएंगे अब कई सारे लोगों ने"
    },
    {
      "subtitle_id": 202,
      "start": 523.44,
      "end": 527.92,
      "text": "प्रायोरिटी पासेस खरीद लिए पास खरीदने के"
    },
    {
      "subtitle_id": 203,
      "start": 525.72,
      "end": 529.32,
      "text": "बाद अब 1000 से ज्यादा का ट्रांजैक्शन ये"
    },
    {
      "subtitle_id": 204,
      "start": 527.92,
      "end": 530.88,
      "text": "कर पा रहे थे कंपनी के अनुसार अब"
    },
    {
      "subtitle_id": 205,
      "start": 529.32,
      "end": 532.519,
      "text": "प्रायोरिटी पास में एक और एडवांटेज इन्हें"
    },
    {
      "subtitle_id": 206,
      "start": 530.88,
      "end": 534.519,
      "text": "बताया गया था कि आप सीधे पैसे अपने बैंक"
    },
    {
      "subtitle_id": 207,
      "start": 532.519,
      "end": 536.48,
      "text": "अकाउंट में ट्रांसफर कर पाएंगे तो लोग का"
    },
    {
      "subtitle_id": 208,
      "start": 534.519,
      "end": 538.36,
      "text": "तो सॉर्टेड था कि वन टाइम ये करते हैं इस"
    },
    {
      "subtitle_id": 209,
      "start": 536.48,
      "end": 540.6,
      "text": "झंझट से मुक्त हो जाते हैं जैसे ही"
    },
    {
      "subtitle_id": 210,
      "start": 538.36,
      "end": 542.32,
      "text": "प्रायोरिटी पास के पैसे पे किए गए रिचार्ज"
    },
    {
      "subtitle_id": 211,
      "start": 540.6,
      "end": 544.56,
      "text": "करने की कोशिश की या फिर पैसे निकालने की"
    },
    {
      "subtitle_id": 212,
      "start": 542.32,
      "end": 545.64,
      "text": "कोशिश की सारे ट्रांजैक्शंस फेल पिछले दो"
    },
    {
      "subtitle_id": 213,
      "start": 544.56,
      "end": 547.399,
      "text": "महीनों में प्लेटफॉर्म पर एक भी"
    },
    {
      "subtitle_id": 214,
      "start": 545.64,
      "end": 550.079,
      "text": "ट्रांजैक्शन नहीं हो रहा है जो पैसे सिर्फ"
    },
    {
      "subtitle_id": 215,
      "start": 547.399,
      "end": 552.72,
      "text": "आपको दिख रहे हैं वॉलेट पे एक्चुअल में"
    },
    {
      "subtitle_id": 216,
      "start": 550.079,
      "end": 554.36,
      "text": "कुछ भी नहीं है यह एक दो नहीं लाखों लोगों"
    },
    {
      "subtitle_id": 217,
      "start": 552.72,
      "end": 556.279,
      "text": "के साथ यह चीजें हुई है अब जिन लोगों ने"
    },
    {
      "subtitle_id": 218,
      "start": 554.36,
      "end": 559.56,
      "text": "मल्टीपल अकाउंट्स खोल के पैसे डाले हैं पा"
    },
    {
      "subtitle_id": 219,
      "start": 556.279,
      "end": 561.04,
      "text": "पा 5 हज उनकी तो हालत ही खराब है अब देखिए"
    },
    {
      "subtitle_id": 220,
      "start": 559.56,
      "end": 562.64,
      "text": "इस तरह की चीज होने लगी तो लोगों ने सबसे"
    },
    {
      "subtitle_id": 221,
      "start": 561.04,
      "end": 564.88,
      "text": "पहले कस्टमर केयर को कांटेक्ट किया कि"
    },
    {
      "subtitle_id": 222,
      "start": 562.64,
      "end": 567.68,
      "text": "क्या चीज है तो कस्टमर केयर कोई बोलने को"
    },
    {
      "subtitle_id": 223,
      "start": 564.88,
      "end": 570.68,
      "text": "तैयार नहीं कुछ लोग ऑफिस में चले गए वहां"
    },
    {
      "subtitle_id": 224,
      "start": 567.68,
      "end": 572.72,
      "text": "जाने के बाद पता चला कि ऑफिस तो क् है जो"
    },
    {
      "subtitle_id": 225,
      "start": 570.68,
      "end": 574.16,
      "text": "भी लोग कर रहे पता नहीं कौन है जो घर से"
    },
    {
      "subtitle_id": 226,
      "start": 572.72,
      "end": 575.92,
      "text": "काम कर रहे हैं कि कंपनी के बारे में"
    },
    {
      "subtitle_id": 227,
      "start": 574.16,
      "end": 577.76,
      "text": "ज्यादा इंफॉर्मेशन भी नहीं है किसी के पास"
    },
    {
      "subtitle_id": 228,
      "start": 575.92,
      "end": 579.6,
      "text": "और ना ही कंपनी ने कोई फंडिंग वगैरह भी"
    },
    {
      "subtitle_id": 229,
      "start": 577.76,
      "end": 582.079,
      "text": "रेज की है अब कई सारे लोगों के दिमाग में"
    },
    {
      "subtitle_id": 230,
      "start": 579.6,
      "end": 583.8,
      "text": "सवाल तो य आ रहा था कि अगर कंपनी इतने"
    },
    {
      "subtitle_id": 231,
      "start": 582.079,
      "end": 585.64,
      "text": "बड़े-बड़े कैशबैक दे रही है तो पैसा कहां"
    },
    {
      "subtitle_id": 232,
      "start": 583.8,
      "end": 587.64,
      "text": "से आएगा लेकिन लोगों ने बोला मिल रहा है"
    },
    {
      "subtitle_id": 233,
      "start": 585.64,
      "end": 591.12,
      "text": "तो ले लो और लोगों के इसी आक्रोश को देखते"
    },
    {
      "subtitle_id": 234,
      "start": 587.64,
      "end": 591.12,
      "text": "हुए बाद में कंपनी ने अपने"
    },
    {
      "subtitle_id": 235,
      "start": 599.44,
      "end": 603.48,
      "text": "पाएंगे लेकिन जब हमने आरबीआई के पोर्टल पर"
    },
    {
      "subtitle_id": 236,
      "start": 601.279,
      "end": 605.56,
      "text": "जाकर देखा तो टॉक चार से रिलेटेड या टॉक"
    },
    {
      "subtitle_id": 237,
      "start": 603.48,
      "end": 607.2,
      "text": "चार को कोई भी नोटिस आरबीआई की तरफ से तो"
    },
    {
      "subtitle_id": 238,
      "start": 605.56,
      "end": 609.32,
      "text": "नहीं आई है किस बेसिस पे उन्होंने अप्रल"
    },
    {
      "subtitle_id": 239,
      "start": 607.2,
      "end": 611.16,
      "text": "लेंड कहा उहे उन्हें ही पता लेकिन मुझे"
    },
    {
      "subtitle_id": 240,
      "start": 609.32,
      "end": 613.32,
      "text": "लगता है कि यह जो कंप्लेंट्स है लोगों की"
    },
    {
      "subtitle_id": 241,
      "start": 611.16,
      "end": 615.079,
      "text": "ये अब आरबीआई तक पहुंच गई है आरबीआई ने"
    },
    {
      "subtitle_id": 242,
      "start": 613.32,
      "end": 617.279,
      "text": "एक्शन लेना शुरू किया है लेकिन जल्द से"
    },
    {
      "subtitle_id": 243,
      "start": 615.079,
      "end": 619.76,
      "text": "जल्द इसका इलाज उन्हें निकालना पड़ेगा कि"
    },
    {
      "subtitle_id": 244,
      "start": 617.279,
      "end": 622.079,
      "text": "किस तरह से हम पैसे लोग उनसे लेकर वापस"
    },
    {
      "subtitle_id": 245,
      "start": 619.76,
      "end": 624.0,
      "text": "करें लेकिन यहां पर इंटरेस्टिंग बात यह है"
    },
    {
      "subtitle_id": 246,
      "start": 622.079,
      "end": 625.8,
      "text": "कि एक तरफ यहां पर एक्जिस्टिंग लोग जो"
    },
    {
      "subtitle_id": 247,
      "start": 624.0,
      "end": 627.48,
      "text": "फंसे हुए हैं उनको पैसा देने से टॉक चार्ज"
    },
    {
      "subtitle_id": 248,
      "start": 625.8,
      "end": 630.92,
      "text": "इंकार कर रहा है यह कह के कि आरबीआई ने"
    },
    {
      "subtitle_id": 249,
      "start": 627.48,
      "end": 633.76,
      "text": "बोला है ऑन द अदर हैंड व अभी भी नए लोगों"
    },
    {
      "subtitle_id": 250,
      "start": 630.92,
      "end": 636.279,
      "text": "को ऑन बोर्ड कर रहे हैं कि आओ आप 499 पे"
    },
    {
      "subtitle_id": 251,
      "start": 633.76,
      "end": 639.079,
      "text": "करो आ जाओ अंदर चलो प्रायोरिटी पास खरीद"
    },
    {
      "subtitle_id": 252,
      "start": 636.279,
      "end": 640.959,
      "text": "लो आ जाओ अंदर इस तरह की चीजें आज भी शुरू"
    },
    {
      "subtitle_id": 253,
      "start": 639.079,
      "end": 642.959,
      "text": "है और इंटरेस्टिंग बात यह है कि मामला"
    },
    {
      "subtitle_id": 254,
      "start": 640.959,
      "end": 644.839,
      "text": "इतना सीरियस है तो कंपनी इसके बारे में"
    },
    {
      "subtitle_id": 255,
      "start": 642.959,
      "end": 646.76,
      "text": "कुछ भी बोलने को फिलहाल तैयार नहीं है तो"
    },
    {
      "subtitle_id": 256,
      "start": 644.839,
      "end": 650.6,
      "text": "मुझे लगता है बहुत ही प्लान चीज थी फ्रीडम"
    },
    {
      "subtitle_id": 257,
      "start": 646.76,
      "end": 652.399,
      "text": "251 की तरह जहां पर लोगों से ₹1 लिए गए"
    },
    {
      "subtitle_id": 258,
      "start": 650.6,
      "end": 654.959,
      "text": "मोबाइल से बहुत पैसा करोड़ों रुपए कलेक्ट"
    },
    {
      "subtitle_id": 259,
      "start": 652.399,
      "end": 656.68,
      "text": "कर दिए गए और फोन कभी डिलीवरी नहीं हुए सो"
    },
    {
      "subtitle_id": 260,
      "start": 654.959,
      "end": 659.36,
      "text": "सिमिलरली यहां पर भी बड़े-बड़े प्रॉमिस"
    },
    {
      "subtitle_id": 261,
      "start": 656.68,
      "end": 661.68,
      "text": "किए गए अब जिन लोगों ने कंपनी पर भरोसा कर"
    },
    {
      "subtitle_id": 262,
      "start": 659.36,
      "end": 662.959,
      "text": "के इन्वेस्ट किया और पैसे मिलने के चांसेस"
    },
    {
      "subtitle_id": 263,
      "start": 661.68,
      "end": 665.079,
      "text": "मेरे हिसाब से तो इस तरह की चीजों में"
    },
    {
      "subtitle_id": 264,
      "start": 662.959,
      "end": 668.36,
      "text": "हिस्टॉरिकली अगर देखा जाए तो बहुत ही कम"
    },
    {
      "subtitle_id": 265,
      "start": 665.079,
      "end": 670.0,
      "text": "होते हैं लेकिन फिर भी आप आरबीआई के सचित"
    },
    {
      "subtitle_id": 266,
      "start": 668.36,
      "end": 671.76,
      "text": "पोर्टल पर जाकर अपनी कंप्लेंट फाइल कर"
    },
    {
      "subtitle_id": 267,
      "start": 670.0,
      "end": 673.399,
      "text": "सकते हैं कंज्यूमर फोरम में कंज्यूमर"
    },
    {
      "subtitle_id": 268,
      "start": 671.76,
      "end": 675.76,
      "text": "कोर्ट में जाके आप कंप्लेंट फाइल कर सकते"
    },
    {
      "subtitle_id": 269,
      "start": 673.399,
      "end": 677.32,
      "text": "हैं और अपना पैसा वापस मांग सकते हैं"
    },
    {
      "subtitle_id": 270,
      "start": 675.76,
      "end": 679.12,
      "text": "मिलेगा नहीं मिलेगा इसकी गारंटी नहीं है"
    },
    {
      "subtitle_id": 271,
      "start": 677.32,
      "end": 680.839,
      "text": "लेकिन आप अपनी तरफ से जरूर कोशिश आपको"
    },
    {
      "subtitle_id": 272,
      "start": 679.12,
      "end": 682.279,
      "text": "करनी चाहिए मैं आशा करता हूं कि वीडियो"
    },
    {
      "subtitle_id": 273,
      "start": 680.839,
      "end": 684.279,
      "text": "ज्यादा से ज्यादा लोगों तक पहुंचेगा मे बी"
    },
    {
      "subtitle_id": 274,
      "start": 682.279,
      "end": 685.959,
      "text": "आरबीआई के कुछ लोगों तक पहुंचेगा जो इस पप"
    },
    {
      "subtitle_id": 275,
      "start": 684.279,
      "end": 688.0,
      "text": "पर एक्शन लेना शुरू करेंगे ताकि नए लोग"
    },
    {
      "subtitle_id": 276,
      "start": 685.959,
      "end": 690.279,
      "text": "इसमें ना फसे लाखों लोगों के करोड़ों रुपए"
    },
    {
      "subtitle_id": 277,
      "start": 688.0,
      "end": 692.079,
      "text": "ऑलरेडी फंसे और इसमें सबसे पहली बात आप"
    },
    {
      "subtitle_id": 278,
      "start": 690.279,
      "end": 694.04,
      "text": "लोगों को अवेयर रहना पड़ेगा मेरे दादा जी"
    },
    {
      "subtitle_id": 279,
      "start": 692.079,
      "end": 695.56,
      "text": "वह हमेशा कहते थे कि अगर कोई इस तरह के"
    },
    {
      "subtitle_id": 280,
      "start": 694.04,
      "end": 697.76,
      "text": "रिटर्न्स आपको दे रहा है तो आपको यह सोचना"
    },
    {
      "subtitle_id": 281,
      "start": 695.56,
      "end": 700.04,
      "text": "पड़ेगा कि वह उतने पैसे कहां से ला रहा है"
    },
    {
      "subtitle_id": 282,
      "start": 697.76,
      "end": 701.68,
      "text": "उसके बाद ऐसी क्या चीज है कि वो उतने सारे"
    },
    {
      "subtitle_id": 283,
      "start": 700.04,
      "end": 703.32,
      "text": "पैसे कमा रहा है और फिर आपको दे रहा है"
    },
    {
      "subtitle_id": 284,
      "start": 701.68,
      "end": 706.04,
      "text": "मोस्ट ऑफ द टाइम आपको पता चलेगा कि एक"
    },
    {
      "subtitle_id": 285,
      "start": 703.32,
      "end": 707.399,
      "text": "बुलबुला होता है बबल होता है किसी को कुछ"
    },
    {
      "subtitle_id": 286,
      "start": 706.04,
      "end": 708.88,
      "text": "नहीं पता होता बट हर कोई सोचता है कि"
    },
    {
      "subtitle_id": 287,
      "start": 707.399,
      "end": 711.8,
      "text": "शुरुआत में लोगों को रिटर्न मिले तो मुझे"
    },
    {
      "subtitle_id": 288,
      "start": 708.88,
      "end": 713.399,
      "text": "भी मिल जाएंगे और इसी चीज का फायदा ये लोग"
    },
    {
      "subtitle_id": 289,
      "start": 711.8,
      "end": 715.32,
      "text": "लेते हैं और हिस्टॉरिकली लेते आए हैं"
    },
    {
      "subtitle_id": 290,
      "start": 713.399,
      "end": 716.76,
      "text": "साइकोलॉजी के साथ ये लोग खेलते हैं तो"
    },
    {
      "subtitle_id": 291,
      "start": 715.32,
      "end": 718.32,
      "text": "साइकोलॉजी के लिए अगर बात करें तो दो"
    },
    {
      "subtitle_id": 292,
      "start": 716.76,
      "end": 721.6,
      "text": "चीजों के साथ ये लोग आपसे खेलते हैं"
    },
    {
      "subtitle_id": 293,
      "start": 718.32,
      "end": 723.72,
      "text": "इमोशंस और ग्रीड यानी लालच अब उसमें"
    },
    {
      "subtitle_id": 294,
      "start": 721.6,
      "end": 725.839,
      "text": "ज्यादातर लोग फंसी जाते हैं तो इस केस में"
    },
    {
      "subtitle_id": 295,
      "start": 723.72,
      "end": 728.16,
      "text": "भी फंसी गए तो यहां पर तो पैसे मिलने के"
    },
    {
      "subtitle_id": 296,
      "start": 725.839,
      "end": 730.0,
      "text": "चांसेस तो बहुत कम है अगर इस पर कुछ"
    },
    {
      "subtitle_id": 297,
      "start": 728.16,
      "end": 731.639,
      "text": "कारवाई भी होती है और बाकी चीज भी होती है"
    },
    {
      "subtitle_id": 298,
      "start": 730.0,
      "end": 734.44,
      "text": "तो पैसे मिलने के चांसेस तो फिर भी बहुत"
    },
    {
      "subtitle_id": 299,
      "start": 731.639,
      "end": 736.36,
      "text": "कम ही है तो बेटर है कि आप इसे किसी भी ऐप"
    },
    {
      "subtitle_id": 300,
      "start": 734.44,
      "end": 738.24,
      "text": "पर ऐसे भरोसा मत रखें देयर आर नो फ्री"
    },
    {
      "subtitle_id": 301,
      "start": 736.36,
      "end": 740.72,
      "text": "लचेस इन दिस वर्ल्ड कुछ भी फ्री में आपको"
    },
    {
      "subtitle_id": 302,
      "start": 738.24,
      "end": 742.76,
      "text": "नहीं मिलेगा और कोई मिल रहा है तो जरूर"
    },
    {
      "subtitle_id": 303,
      "start": 740.72,
      "end": 744.199,
      "text": "आपको उसे क्वेश्चन करना पड़ेगा आशा करते"
    },
    {
      "subtitle_id": 304,
      "start": 742.76,
      "end": 745.92,
      "text": "हैं कि जल्दी लोगों का जो फंसा हुआ पैसा"
    },
    {
      "subtitle_id": 305,
      "start": 744.199,
      "end": 747.959,
      "text": "है आप देख सकते हैं लोगों का क्रेजी पैसा"
    },
    {
      "subtitle_id": 306,
      "start": 745.92,
      "end": 749.76,
      "text": "इसमें फंसा हुआ है उस पर आरबीआई जल्दी कोई"
    },
    {
      "subtitle_id": 307,
      "start": 747.959,
      "end": 751.56,
      "text": "सोल्यूशन निकाल र किसी ना किसी तरीके से"
    },
    {
      "subtitle_id": 308,
      "start": 749.76,
      "end": 754.12,
      "text": "लोगों के पैसे लोगों को वापस दिलाए"
    },
    {
      "subtitle_id": 309,
      "start": 751.56,
      "end": 756.959,
      "text": "एटलीस्ट उतने पैसे जितने उन्होंने खुद लोड"
    },
    {
      "subtitle_id": 310,
      "start": 754.12,
      "end": 758.92,
      "text": "किए हैं बिकॉज़ वही पैसा कई करोड़ों में"
    },
    {
      "subtitle_id": 311,
      "start": 756.959,
      "end": 761.199,
      "text": "जा रहा है इस वीडियो को ज्यादा से ज्यादा"
    },
    {
      "subtitle_id": 312,
      "start": 758.92,
      "end": 762.72,
      "text": "लोगों तक जरूर पहुंचाए क्योंकि शायद हम पर"
    },
    {
      "subtitle_id": 313,
      "start": 761.199,
      "end": 764.399,
      "text": "प्रेशर आ सकता है इस वीडियो को डाउन करने"
    },
    {
      "subtitle_id": 314,
      "start": 762.72,
      "end": 766.079,
      "text": "के लिए तो उससे पहले जरूर इस वीडियो को"
    },
    {
      "subtitle_id": 315,
      "start": 764.399,
      "end": 768.519,
      "text": "ज्यादा से ज्यादा लोग तोक पहुंचाई है"
    },
    {
      "subtitle_id": 316,
      "start": 766.079,
      "end": 770.92,
      "text": "क्योंकि आज भी कई सारे ईमेल्स हमें आ रहे"
    },
    {
      "subtitle_id": 317,
      "start": 768.519,
      "end": 772.839,
      "text": "हैं लगातार नए लोग इस स्कैम में फंसते जा"
    },
    {
      "subtitle_id": 318,
      "start": 770.92,
      "end": 774.72,
      "text": "रहे हैं इसी तरह के स्कैम अवेयरनेस के लिए"
    },
    {
      "subtitle_id": 319,
      "start": 772.839,
      "end": 778.199,
      "text": "हमें जरूर सब्सक्राइब कीजिए और बेल आइकन"
    },
    {
      "subtitle_id": 320,
      "start": 774.72,
      "end": 778.199,
      "text": "पर भी क्लिक कीजिए"
    }
  ]
}