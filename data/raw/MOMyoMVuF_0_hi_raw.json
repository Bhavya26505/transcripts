  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.0,
      "end": 3.12,
      "text": "इन्वेस्टमेंट्स इन सिक्योरिटीज़ मार्केट इज़"
    },
    {
      "subtitle_id": 2,
      "start": 1.52,
      "end": 4.799,
      "text": "सब्जेक्ट टू मार्केट। प्लीज रीड ऑल स्कीम"
    },
    {
      "subtitle_id": 3,
      "start": 3.12,
      "end": 7.279,
      "text": "रिलेटेड डॉक्यूमेंट्स केयरफुली। हैप्पी"
    },
    {
      "subtitle_id": 4,
      "start": 4.799,
      "end": 9.36,
      "text": "दिवाली और जैसे ही दिवाली का नाम आता है"
    },
    {
      "subtitle_id": 5,
      "start": 7.279,
      "end": 11.12,
      "text": "हर साल सभी की एक एक्साइटमेंट होती है कि"
    },
    {
      "subtitle_id": 6,
      "start": 9.36,
      "end": 13.2,
      "text": "मुरा ट्रेडिंग का वीडियो इनोवेशंस का कब"
    },
    {
      "subtitle_id": 7,
      "start": 11.12,
      "end": 14.639,
      "text": "आएगा। तो फाइनली आ गया है और पिछले"
    },
    {
      "subtitle_id": 8,
      "start": 13.2,
      "end": 16.08,
      "text": "तीन-चार सालों से हम ये रिचुअल चला रहे"
    },
    {
      "subtitle_id": 9,
      "start": 14.639,
      "end": 17.6,
      "text": "हैं जहां पर मोहरे ट्रेडिंग के दिन यानी"
    },
    {
      "subtitle_id": 10,
      "start": 16.08,
      "end": 19.279,
      "text": "साल में एक ही बार में ऐसा वीडियो बनाता"
    },
    {
      "subtitle_id": 11,
      "start": 17.6,
      "end": 21.279,
      "text": "हूं जहां पर मैं बात करता हूं कि मैंने"
    },
    {
      "subtitle_id": 12,
      "start": 19.279,
      "end": 22.96,
      "text": "किस स्टॉक में इन्वेस्टमेंट की है और आगे"
    },
    {
      "subtitle_id": 13,
      "start": 21.279,
      "end": 24.56,
      "text": "किस में इन्वेस्ट कर रहा हूं। तो पिछले"
    },
    {
      "subtitle_id": 14,
      "start": 22.96,
      "end": 26.48,
      "text": "वीडियोस के कौन से स्टॉक्स थे उनको मैं"
    },
    {
      "subtitle_id": 15,
      "start": 24.56,
      "end": 28.16,
      "text": "आपको एक बार दिखाता हूं और इस बार किन"
    },
    {
      "subtitle_id": 16,
      "start": 26.48,
      "end": 30.16,
      "text": "स्टॉक्स पर मेरा ध्यान है, मेरी नजर है"
    },
    {
      "subtitle_id": 17,
      "start": 28.16,
      "end": 32.239,
      "text": "उसके बारे में भी आज मैं आपके साथ डिटेल"
    },
    {
      "subtitle_id": 18,
      "start": 30.16,
      "end": 33.92,
      "text": "में बात करूंगा। नमस्कार मैं प्रसाद आपका"
    },
    {
      "subtitle_id": 19,
      "start": 32.239,
      "end": 36.0,
      "text": "आज के इस वीडियो में स्वागत करता हूं। तो"
    },
    {
      "subtitle_id": 20,
      "start": 33.92,
      "end": 37.6,
      "text": "चलिए बढ़ते हैं। तो पिछले एक साल की अगर"
    },
    {
      "subtitle_id": 21,
      "start": 36.0,
      "end": 39.28,
      "text": "बात करें तो मार्केट काफी वोलेटाइल रहा"
    },
    {
      "subtitle_id": 22,
      "start": 37.6,
      "end": 41.52,
      "text": "है। पिछले साल सितंबर से मार्केट में"
    },
    {
      "subtitle_id": 23,
      "start": 39.28,
      "end": 43.52,
      "text": "डाउनफॉल शुरू हुआ। जब दिवाली थी तो"
    },
    {
      "subtitle_id": 24,
      "start": 41.52,
      "end": 45.2,
      "text": "डाउनफॉल का अर्ली फेस था। उसके बाद हमने"
    },
    {
      "subtitle_id": 25,
      "start": 43.52,
      "end": 48.16,
      "text": "देखा कि फरवरी मार्च में मार्केट और भी"
    },
    {
      "subtitle_id": 26,
      "start": 45.2,
      "end": 49.6,
      "text": "ज्यादा गिर गया। फिर अभी पिछले कुछ महीनों"
    },
    {
      "subtitle_id": 27,
      "start": 48.16,
      "end": 51.2,
      "text": "में अगर देखा जाए तो मार्केट धीरे-धीरे"
    },
    {
      "subtitle_id": 28,
      "start": 49.6,
      "end": 53.039,
      "text": "स्टेबल हो रहा है लेकिन रिकवरी उस हिसाब"
    },
    {
      "subtitle_id": 29,
      "start": 51.2,
      "end": 55.44,
      "text": "से हुई नहीं है। तो इसलिए आप पिछले एक साल"
    },
    {
      "subtitle_id": 30,
      "start": 53.039,
      "end": 57.199,
      "text": "के अगर देखेंगे कुछ नंबर्स इंडेक्स के ले"
    },
    {
      "subtitle_id": 31,
      "start": 55.44,
      "end": 58.879,
      "text": "लो या फिर इंडिविजुअल स्टॉक्स में तो कुछ"
    },
    {
      "subtitle_id": 32,
      "start": 57.199,
      "end": 61.44,
      "text": "खास आपको दिखेगा नहीं काफी ज्यादा"
    },
    {
      "subtitle_id": 33,
      "start": 58.879,
      "end": 63.92,
      "text": "वोलेटाइल और डालमडोली मामला मिलेगा। अब"
    },
    {
      "subtitle_id": 34,
      "start": 61.44,
      "end": 66.32,
      "text": "2022 में हमने बात की थी RFC की Federal"
    },
    {
      "subtitle_id": 35,
      "start": 63.92,
      "end": 68.96,
      "text": "Bank की हैप्पीएस्ट Mind LTI Mint Enjal"
    },
    {
      "subtitle_id": 36,
      "start": 66.32,
      "end": 70.64,
      "text": "वन CDSL और ADO खतान अब इसमें से कुछ"
    },
    {
      "subtitle_id": 37,
      "start": 68.96,
      "end": 72.56,
      "text": "स्टॉक्स ऐसे हैं जो अभी भी पोर्टफोलियो"
    },
    {
      "subtitle_id": 38,
      "start": 70.64,
      "end": 76.159,
      "text": "में है। कुछ है कि जो ऑलरेडी मैं एग्जिट"
    },
    {
      "subtitle_id": 39,
      "start": 72.56,
      "end": 79.119,
      "text": "कर चुका हूं। अब यह तो बात हुई 2022 की।"
    },
    {
      "subtitle_id": 40,
      "start": 76.159,
      "end": 81.2,
      "text": "फिर अगर हम नजर डालें 2023 में तो यहां पर"
    },
    {
      "subtitle_id": 41,
      "start": 79.119,
      "end": 83.2,
      "text": "मैंने बात की थी a venे summar की। उसके"
    },
    {
      "subtitle_id": 42,
      "start": 81.2,
      "end": 85.28,
      "text": "बाद ई मुद्रा की और सिग्निटी टेक्नोलॉजीस"
    },
    {
      "subtitle_id": 43,
      "start": 83.2,
      "end": 86.88,
      "text": "की। तो जब-जब मैंने इन कंपनीज़ की बात की"
    },
    {
      "subtitle_id": 44,
      "start": 85.28,
      "end": 90.0,
      "text": "तब-तब मैंने उनके बारे में भी आपको बताया"
    },
    {
      "subtitle_id": 45,
      "start": 86.88,
      "end": 91.68,
      "text": "भी था कि कैसे किस तरह की वो कंपनीज़ हैं?"
    },
    {
      "subtitle_id": 46,
      "start": 90.0,
      "end": 96.32,
      "text": "उनकी स्ट्रेंथ्स क्या है, वीकनेसेस क्या"
    },
    {
      "subtitle_id": 47,
      "start": 91.68,
      "end": 99.36,
      "text": "है? वगैरह-वगैरह और ये तो रहा 2023 में"
    },
    {
      "subtitle_id": 48,
      "start": 96.32,
      "end": 101.84,
      "text": "क्योंकि मार्केट 2023 में ऑलरेडी काफी एक"
    },
    {
      "subtitle_id": 49,
      "start": 99.36,
      "end": 104.479,
      "text": "यू नो पीक पर था। तो काफी कंजर्वेटिव"
    },
    {
      "subtitle_id": 50,
      "start": 101.84,
      "end": 108.159,
      "text": "मैंने कुछ ही यू नो कंपनीज़ की वहां पर बात"
    },
    {
      "subtitle_id": 51,
      "start": 104.479,
      "end": 111.28,
      "text": "की थी। फिर आता है 2024 यानी पिछला पिछला"
    },
    {
      "subtitle_id": 52,
      "start": 108.159,
      "end": 114.159,
      "text": "साल नवंबर 2024 और वहां पर फिर मैंने बात"
    },
    {
      "subtitle_id": 53,
      "start": 111.28,
      "end": 116.479,
      "text": "की Fed FI यानी Fedbank Finance सर्विज जो"
    },
    {
      "subtitle_id": 54,
      "start": 114.159,
      "end": 118.719,
      "text": "कि Federal Bank ग्रुप की कंपनी है। उसके"
    },
    {
      "subtitle_id": 55,
      "start": 116.479,
      "end": 120.32,
      "text": "बाद महाराष्ट्र स्कूटर्स जो कि Bajaj"
    },
    {
      "subtitle_id": 56,
      "start": 118.719,
      "end": 122.399,
      "text": "ग्रुप की एक होल्डिंग कंपनी है। हालांकि"
    },
    {
      "subtitle_id": 57,
      "start": 120.32,
      "end": 123.92,
      "text": "नाम स्कूटर है लेकिन स्कूटर से उसका कोई"
    },
    {
      "subtitle_id": 58,
      "start": 122.399,
      "end": 126.479,
      "text": "लेना देना नहीं था। वो मैंने बात भी की थी"
    },
    {
      "subtitle_id": 59,
      "start": 123.92,
      "end": 129.759,
      "text": "उस वीडियो में। Jio फाइनेंसियल सर्विज"
    },
    {
      "subtitle_id": 60,
      "start": 126.479,
      "end": 131.28,
      "text": "उसके बाद डीसीबी बैंक और नालवासं नालवा"
    },
    {
      "subtitle_id": 61,
      "start": 129.759,
      "end": 134.08,
      "text": "sins अगेन zindal ग्रुप की एक होल्डिंग"
    },
    {
      "subtitle_id": 62,
      "start": 131.28,
      "end": 135.92,
      "text": "कंपनी है। तो लास्ट ईयर एक थोड़ा थोड़ा"
    },
    {
      "subtitle_id": 63,
      "start": 134.08,
      "end": 138.0,
      "text": "बहुत फोकस मेरा होल्डिंग कंपनी की तरफ भी"
    },
    {
      "subtitle_id": 64,
      "start": 135.92,
      "end": 140.239,
      "text": "था। इनफैक्ट Jio फाइनेंसियल सर्विज के पास"
    },
    {
      "subtitle_id": 65,
      "start": 138.0,
      "end": 142.959,
      "text": "भी 70-8,000 के Reliance Industries के"
    },
    {
      "subtitle_id": 66,
      "start": 140.239,
      "end": 146.8,
      "text": "शेयर्स हैं। तो होल्डिंग जो था उसका थोड़ा"
    },
    {
      "subtitle_id": 67,
      "start": 142.959,
      "end": 149.44,
      "text": "बोलबाला था 2024 में। और"
    },
    {
      "subtitle_id": 68,
      "start": 146.8,
      "end": 152.08,
      "text": "फिर ये कुछ नंबर्स हैं जो कुछ हमने उस"
    },
    {
      "subtitle_id": 69,
      "start": 149.44,
      "end": 154.48,
      "text": "वीडियो में बात की थी। और अब आ गया है"
    },
    {
      "subtitle_id": 70,
      "start": 152.08,
      "end": 156.959,
      "text": "2025। अब यह जो कंपनीज़ है कुछ को मैंने"
    },
    {
      "subtitle_id": 71,
      "start": 154.48,
      "end": 159.76,
      "text": "बीच में एग्जिट किया। कुछ को रिप्लेस किया"
    },
    {
      "subtitle_id": 72,
      "start": 156.959,
      "end": 162.239,
      "text": "कुछ और कंपनी से। कुछ में बैलेंस यानी जो"
    },
    {
      "subtitle_id": 73,
      "start": 159.76,
      "end": 164.4,
      "text": "वेटेज है वह बढ़ाया तो किस में वेटेज कम"
    },
    {
      "subtitle_id": 74,
      "start": 162.239,
      "end": 166.4,
      "text": "किया। अब ये क्या है कि थ्रूउ ईयर ये"
    },
    {
      "subtitle_id": 75,
      "start": 164.4,
      "end": 168.16,
      "text": "एक्सरसाइज जो है वो चलती रहती है। अब ये"
    },
    {
      "subtitle_id": 76,
      "start": 166.4,
      "end": 170.16,
      "text": "सारी चीजें क्या है ना कि अलग से बताना इज़"
    },
    {
      "subtitle_id": 77,
      "start": 168.16,
      "end": 172.16,
      "text": "वेरी इंपॉसिबल। और इसीलिए फिर हमने सेबी"
    },
    {
      "subtitle_id": 78,
      "start": 170.16,
      "end": 174.0,
      "text": "रजिस्टर्ड आर का लाइसेंस लिया। वी आर नाउ"
    },
    {
      "subtitle_id": 79,
      "start": 172.16,
      "end": 176.48,
      "text": "रिसर्च एनालिस्ट और हमने कुछ मॉडल"
    },
    {
      "subtitle_id": 80,
      "start": 174.0,
      "end": 178.48,
      "text": "पोर्टफोलियोज़ भी ल्च किए हैं। तो दो हमारे"
    },
    {
      "subtitle_id": 81,
      "start": 176.48,
      "end": 180.319,
      "text": "हैं एक इमर्जिंग इकाशी इमर्जिंग इंडिया है"
    },
    {
      "subtitle_id": 82,
      "start": 178.48,
      "end": 181.92,
      "text": "इका वैल्यू इन्वेस्टिंग है। जहां पर जब"
    },
    {
      "subtitle_id": 83,
      "start": 180.319,
      "end": 183.92,
      "text": "रिबैलेंसिंग होती है तो ऑटोमेटिकली वहां"
    },
    {
      "subtitle_id": 84,
      "start": 181.92,
      "end": 185.519,
      "text": "पर अपडेट आ जाता है। जहां पर कोई स्टॉक"
    },
    {
      "subtitle_id": 85,
      "start": 183.92,
      "end": 187.599,
      "text": "रिप्लेस हो जाता है तो ऑटोमेटिकली वहां पर"
    },
    {
      "subtitle_id": 86,
      "start": 185.519,
      "end": 189.36,
      "text": "भी अपडेट आता है। तो इस तरह की चीजें हमने"
    },
    {
      "subtitle_id": 87,
      "start": 187.599,
      "end": 191.84,
      "text": "बनाई है थोड़ा जिनको रेडीमेड सारी चीजें"
    },
    {
      "subtitle_id": 88,
      "start": 189.36,
      "end": 194.159,
      "text": "चाहिए उनके लिए जिसके बारे में आपसे डिटेल"
    },
    {
      "subtitle_id": 89,
      "start": 191.84,
      "end": 196.64,
      "text": "में आगे बात भी करूंगा और तो खैर अभी बात"
    },
    {
      "subtitle_id": 90,
      "start": 194.159,
      "end": 199.84,
      "text": "करें हम 2025 की तो इस साल वो कौन सी"
    },
    {
      "subtitle_id": 91,
      "start": 196.64,
      "end": 202.0,
      "text": "कंपनी है जिन पर मेरी नजर है तो इस साल"
    },
    {
      "subtitle_id": 92,
      "start": 199.84,
      "end": 204.319,
      "text": "सबसे पहला मेरा जो ध्यान है वो ऐसे सेक्टर"
    },
    {
      "subtitle_id": 93,
      "start": 202.0,
      "end": 206.08,
      "text": "पर है जो काफी इमर्जिंग है और इमर्जिंग की"
    },
    {
      "subtitle_id": 94,
      "start": 204.319,
      "end": 208.48,
      "text": "बात करें और सोलर की बात ना हो तो बात"
    },
    {
      "subtitle_id": 95,
      "start": 206.08,
      "end": 211.44,
      "text": "नहीं बनेगी। सो द फर्स्ट थिंग इज आई एम"
    },
    {
      "subtitle_id": 96,
      "start": 208.48,
      "end": 214.48,
      "text": "फोकसिंग ऑन दी इमर्जिंग सेक्टर्स।"
    },
    {
      "subtitle_id": 97,
      "start": 211.44,
      "end": 216.879,
      "text": "और इस साल इमर्जिंग में भी कुछ कंपनीज़ ऐसी"
    },
    {
      "subtitle_id": 98,
      "start": 214.48,
      "end": 218.319,
      "text": "मिली है मुझे जो मुझे पर्सनली काफी अच्छी"
    },
    {
      "subtitle_id": 99,
      "start": 216.879,
      "end": 221.04,
      "text": "लगी। दिस इज़ अगेन अ नॉट अ बायर सेल"
    },
    {
      "subtitle_id": 100,
      "start": 218.319,
      "end": 222.64,
      "text": "रिकमेंडेशन। दिस इज़ लाइक कि पर्सनली मैं"
    },
    {
      "subtitle_id": 101,
      "start": 221.04,
      "end": 225.68,
      "text": "क्या कर रहा हूं उसके बारे में मैं यहां"
    },
    {
      "subtitle_id": 102,
      "start": 222.64,
      "end": 228.08,
      "text": "पर बता रहा हूं आपको। तो इमर्जिंग में अगर"
    },
    {
      "subtitle_id": 103,
      "start": 225.68,
      "end": 229.76,
      "text": "बात करें तो सोलर सेक्टर रिन्यूएबल एनर्जी"
    },
    {
      "subtitle_id": 104,
      "start": 228.08,
      "end": 231.76,
      "text": "सेक्टर इस पर मैं अभी काफी ध्यान दे रहा"
    },
    {
      "subtitle_id": 105,
      "start": 229.76,
      "end": 236.519,
      "text": "हूं। और यहां पर दो कंपनीज़ की मैं बात"
    },
    {
      "subtitle_id": 106,
      "start": 231.76,
      "end": 236.519,
      "text": "करूंगा। सो द फर्स्ट वन इज"
    },
    {
      "subtitle_id": 107,
      "start": 237.68,
      "end": 242.2,
      "text": "ऑस्ट्रेलियन प्रीमियम सोलर"
    },
    {
      "subtitle_id": 108,
      "start": 242.72,
      "end": 246.239,
      "text": "देखिए नाम ऑस्ट्रेलियन है लेकिन इस कंपनी"
    },
    {
      "subtitle_id": 109,
      "start": 244.56,
      "end": 247.68,
      "text": "का ऑस्ट्रेलिया से दूर-दूर तक कोई लेना"
    },
    {
      "subtitle_id": 110,
      "start": 246.239,
      "end": 249.519,
      "text": "देना नहीं है। जैसे लास्ट ईयर महाराष्ट्र"
    },
    {
      "subtitle_id": 111,
      "start": 247.68,
      "end": 251.519,
      "text": "स्कूटर का जिसका स्कूटर से कोई लेना देना"
    },
    {
      "subtitle_id": 112,
      "start": 249.519,
      "end": 254.4,
      "text": "नहीं था। क्या करें हर साल एक आध ऐसी"
    },
    {
      "subtitle_id": 113,
      "start": 251.519,
      "end": 256.56,
      "text": "कंपनी आ ही जाती है जिसका नाम का यू नो"
    },
    {
      "subtitle_id": 114,
      "start": 254.4,
      "end": 258.32,
      "text": "उसके कुछ जो भी वर्ड यूज़ किए जाते हैं"
    },
    {
      "subtitle_id": 115,
      "start": 256.56,
      "end": 260.4,
      "text": "कंपनी स्टॉक नेम में उससे कुछ लेना देना"
    },
    {
      "subtitle_id": 116,
      "start": 258.32,
      "end": 262.24,
      "text": "नहीं होता है। ऑस्टियन प्रीमियम सोलर की"
    },
    {
      "subtitle_id": 117,
      "start": 260.4,
      "end": 264.96,
      "text": "बात करूं तो फंडामेंटली मुझे यह कंपनी"
    },
    {
      "subtitle_id": 118,
      "start": 262.24,
      "end": 267.36,
      "text": "काफी स्ट्रांग लगी। तो बिजनेस वाइज देखें"
    },
    {
      "subtitle_id": 119,
      "start": 264.96,
      "end": 269.68,
      "text": "तो कंपनी का जो रेवेन्यू है, कंपनी का नेट"
    },
    {
      "subtitle_id": 120,
      "start": 267.36,
      "end": 271.68,
      "text": "प्रॉफिट है, इनमें काफी अच्छी ग्रोथ हो"
    },
    {
      "subtitle_id": 121,
      "start": 269.68,
      "end": 273.36,
      "text": "रही है। जैसे आप देख सकते हो और जहां तक"
    },
    {
      "subtitle_id": 122,
      "start": 271.68,
      "end": 274.88,
      "text": "मेरी अंडरस्टैंडिंग है, सोलर सेक्टर"
    },
    {
      "subtitle_id": 123,
      "start": 273.36,
      "end": 278.32,
      "text": "इंडिया में अगले पांच छ सालों के लिए काफी"
    },
    {
      "subtitle_id": 124,
      "start": 274.88,
      "end": 279.919,
      "text": "मजबूत है। और जब मैंने कंपनी का थोड़ा"
    },
    {
      "subtitle_id": 125,
      "start": 278.32,
      "end": 282.639,
      "text": "एनालिसिस किया तो मुझे भी लगा कि ये"
    },
    {
      "subtitle_id": 126,
      "start": 279.919,
      "end": 284.16,
      "text": "मोमेंटम जो है थोड़ा बहुत 10 20% से कम हो"
    },
    {
      "subtitle_id": 127,
      "start": 282.639,
      "end": 287.36,
      "text": "सकता है। लेकिन उससे ज्यादा तुरंत तो कम"
    },
    {
      "subtitle_id": 128,
      "start": 284.16,
      "end": 288.88,
      "text": "नहीं होगा। और उस हिसाब से जो कंपनी जा"
    },
    {
      "subtitle_id": 129,
      "start": 287.36,
      "end": 291.36,
      "text": "रही है मुझे वैल्यू्यूएशन वाइज़ भी चीजें"
    },
    {
      "subtitle_id": 130,
      "start": 288.88,
      "end": 294.08,
      "text": "यहां पर काफी सही लगी। और इसी के चलते जो"
    },
    {
      "subtitle_id": 131,
      "start": 291.36,
      "end": 297.28,
      "text": "पहली मेरी नजर है वह इस कंपनी पर है। तो"
    },
    {
      "subtitle_id": 132,
      "start": 294.08,
      "end": 299.44,
      "text": "नेक्स्ट जो कंपनी है वह है KPI ग्रीन। KPI"
    },
    {
      "subtitle_id": 133,
      "start": 297.28,
      "end": 300.88,
      "text": "ग्रीन अगेन ग्रीन एनर्जी सेक्टर में काफी"
    },
    {
      "subtitle_id": 134,
      "start": 299.44,
      "end": 302.479,
      "text": "तेजी से काम कर रही है। इस ग्रुप की दो"
    },
    {
      "subtitle_id": 135,
      "start": 300.88,
      "end": 304.96,
      "text": "कंपनीज़ है यहां पर मार्केट में लिस्टेड एक"
    },
    {
      "subtitle_id": 136,
      "start": 302.479,
      "end": 307.039,
      "text": "है KPI ग्रीन एनर्जी और इस ग्रुप की एक और"
    },
    {
      "subtitle_id": 137,
      "start": 304.96,
      "end": 308.8,
      "text": "कंपनी लिस्टेड है जिसका नाम है KP एनर्जी।"
    },
    {
      "subtitle_id": 138,
      "start": 307.039,
      "end": 312.24,
      "text": "लेकिन KP एनर्जी का मैंने जब एनालिसिस"
    },
    {
      "subtitle_id": 139,
      "start": 308.8,
      "end": 314.72,
      "text": "किया तब मुझे कंपेयर टू KPI ग्रीन वो उतनी"
    },
    {
      "subtitle_id": 140,
      "start": 312.24,
      "end": 316.32,
      "text": "बेटर नहीं लगी। ठीक है? तो केपीआई ग्रीन"
    },
    {
      "subtitle_id": 141,
      "start": 314.72,
      "end": 318.16,
      "text": "की बात करें तो यहां पर भी देखेंगे तो"
    },
    {
      "subtitle_id": 142,
      "start": 316.32,
      "end": 321.039,
      "text": "रेवेन्यू और प्रॉफिट में काफी अच्छी ग्रोथ"
    },
    {
      "subtitle_id": 143,
      "start": 318.16,
      "end": 322.72,
      "text": "है और मुझे लगता है कि 10 20% यहां पर भी"
    },
    {
      "subtitle_id": 144,
      "start": 321.039,
      "end": 324.56,
      "text": "परफॉर्मेंस आने वाले चारप सालों में कम"
    },
    {
      "subtitle_id": 145,
      "start": 322.72,
      "end": 327.039,
      "text": "जरूर होगी लेकिन स्टिल दैट स्पीड इज़"
    },
    {
      "subtitle_id": 146,
      "start": 324.56,
      "end": 329.6,
      "text": "क्वाइट हाई अभी 80 90% की ग्रोथ है 60-50"
    },
    {
      "subtitle_id": 147,
      "start": 327.039,
      "end": 331.36,
      "text": "भी आई तो वैल्यू्यूएशन वाइज़ मुझे लगा कि"
    },
    {
      "subtitle_id": 148,
      "start": 329.6,
      "end": 333.039,
      "text": "यहां पर ग्रोथ काफी बेटर है और"
    },
    {
      "subtitle_id": 149,
      "start": 331.36,
      "end": 336.0,
      "text": "वैल्यू्यूएशन भी मुझे पर्सनली काफी अच्छा"
    },
    {
      "subtitle_id": 150,
      "start": 333.039,
      "end": 338.88,
      "text": "लगा एंड तो इसीलिए ये एक कंपनी थी जो मेरी"
    },
    {
      "subtitle_id": 151,
      "start": 336.0,
      "end": 341.199,
      "text": "नजर में थी जो थर्ड कंपनी मेरी नजर में है"
    },
    {
      "subtitle_id": 152,
      "start": 338.88,
      "end": 343.28,
      "text": "उसका नाम है समिट सिक्योरिटीज यानी लास्ट"
    },
    {
      "subtitle_id": 153,
      "start": 341.199,
      "end": 345.199,
      "text": "ईयर जो मेरा मेन थीम था होल्डिंग कंपनीज़"
    },
    {
      "subtitle_id": 154,
      "start": 343.28,
      "end": 346.88,
      "text": "तो इस बार वह नहीं है लेकिन इस बार फिर भी"
    },
    {
      "subtitle_id": 155,
      "start": 345.199,
      "end": 349.039,
      "text": "एक कंपनी होल्डिंग कंपनी मैं ऐड कर रहा"
    },
    {
      "subtitle_id": 156,
      "start": 346.88,
      "end": 352.32,
      "text": "हूं जिसका नाम है समिट सिक्योरिटीज़ यह"
    },
    {
      "subtitle_id": 157,
      "start": 349.039,
      "end": 355.039,
      "text": "गोइंका ग्रुप की होल्डिंग कंपनी है जिसमें"
    },
    {
      "subtitle_id": 158,
      "start": 352.32,
      "end": 357.6,
      "text": "इस कंपनी के अंडर सीए टायर्स हो गया और"
    },
    {
      "subtitle_id": 159,
      "start": 355.039,
      "end": 359.52,
      "text": "गोइका ग्रुप की जो अदर कंपनीज़ हैं वो"
    },
    {
      "subtitle_id": 160,
      "start": 357.6,
      "end": 361.919,
      "text": "इसमें आती है इनके पास अच्छी खासी"
    },
    {
      "subtitle_id": 161,
      "start": 359.52,
      "end": 363.759,
      "text": "होल्डिंग है। खैर आज के इस वीडियो में हम"
    },
    {
      "subtitle_id": 162,
      "start": 361.919,
      "end": 365.68,
      "text": "उतना डिटेल में नहीं जा सकते। समिट"
    },
    {
      "subtitle_id": 163,
      "start": 363.759,
      "end": 367.68,
      "text": "सिक्योरिटी की बात करूं तो इसकी अगर आप"
    },
    {
      "subtitle_id": 164,
      "start": 365.68,
      "end": 370.56,
      "text": "बैलेंस शीट में आएंगे तो बैलेंस शीट में"
    },
    {
      "subtitle_id": 165,
      "start": 367.68,
      "end": 374.24,
      "text": "आप देख सकते हो कि इसकी इन्वेस्टमेंट्स जो"
    },
    {
      "subtitle_id": 166,
      "start": 370.56,
      "end": 376.639,
      "text": "2020 में 2400 करोड़ थी उससे 2 साल पहले"
    },
    {
      "subtitle_id": 167,
      "start": 374.24,
      "end": 378.96,
      "text": "दो-ती साल पहले 500 करोड़ के करीब नाउ इट"
    },
    {
      "subtitle_id": 168,
      "start": 376.639,
      "end": 383.36,
      "text": "हैज़ गॉन टू ₹1878"
    },
    {
      "subtitle_id": 169,
      "start": 378.96,
      "end": 385.199,
      "text": "करोड़ और इस ₹1000 करोड़ में से लगभग 11500"
    },
    {
      "subtitle_id": 170,
      "start": 383.36,
      "end": 387.039,
      "text": "करोड़ की जो इन्वेस्टमेंट्स है वो स्टॉक्स"
    },
    {
      "subtitle_id": 171,
      "start": 385.199,
      "end": 388.96,
      "text": "में इन्वेस्टेड है। थोड़ी बहुत म्यूच्यूल"
    },
    {
      "subtitle_id": 172,
      "start": 387.039,
      "end": 390.56,
      "text": "फंड में इन्वेस्टमेंट है और लिक्विड मतलब"
    },
    {
      "subtitle_id": 173,
      "start": 388.96,
      "end": 392.56,
      "text": "ऐसे स्टॉक्स में इन्वेस्टमेंट है जो"
    },
    {
      "subtitle_id": 174,
      "start": 390.56,
      "end": 394.72,
      "text": "मार्केट में लिस्टेड है। प्राइवेट लिमिटेड"
    },
    {
      "subtitle_id": 175,
      "start": 392.56,
      "end": 396.319,
      "text": "कंपनीज़ में नहीं। और उसमें भी मैंने देखा"
    },
    {
      "subtitle_id": 176,
      "start": 394.72,
      "end": 398.479,
      "text": "कि जो अंडरलाइन स्टॉक्स हैं उनकी क्वालिटी"
    },
    {
      "subtitle_id": 177,
      "start": 396.319,
      "end": 400.319,
      "text": "बड़ी अच्छी है। जनरली जो होल्डिंग कंपनीज़"
    },
    {
      "subtitle_id": 178,
      "start": 398.479,
      "end": 402.319,
      "text": "होती है जनरली 50% डिस्काउंट पर चलती है।"
    },
    {
      "subtitle_id": 179,
      "start": 400.319,
      "end": 405.68,
      "text": "तो वो सारे वैल्यू्यूएशन सारा मैथमेटिक्स"
    },
    {
      "subtitle_id": 180,
      "start": 402.319,
      "end": 407.84,
      "text": "करने के बाद मुझे पता चला कि दिस कंपनी इज़"
    },
    {
      "subtitle_id": 181,
      "start": 405.68,
      "end": 409.84,
      "text": "बिट अंडरवैल्यूड और इसीलिए मैंने सोचा कि"
    },
    {
      "subtitle_id": 182,
      "start": 407.84,
      "end": 412.72,
      "text": "एक आद दो अंडरवैलड स्टॉक्स भी पोर्टफोलियो"
    },
    {
      "subtitle_id": 183,
      "start": 409.84,
      "end": 415.199,
      "text": "में होने चाहिए। एंड सो दैट इज़ व्हाई इस"
    },
    {
      "subtitle_id": 184,
      "start": 412.72,
      "end": 418.639,
      "text": "इस कंपनी की तरफ भी मैंने अपनी नजर बढ़ाई।"
    },
    {
      "subtitle_id": 185,
      "start": 415.199,
      "end": 421.44,
      "text": "एंड इसके बाद जो आखिरी स्टॉक जो मोहरा"
    },
    {
      "subtitle_id": 186,
      "start": 418.639,
      "end": 424.16,
      "text": "ट्रेडिंग 2025 में मैं बात करने वाला हूं।"
    },
    {
      "subtitle_id": 187,
      "start": 421.44,
      "end": 425.68,
      "text": "दैट इज़ NEESCO अब NEESCO की बात करूं तो"
    },
    {
      "subtitle_id": 188,
      "start": 424.16,
      "end": 428.0,
      "text": "मुंबई में रहते होंगे तो NEESCO को देखा"
    },
    {
      "subtitle_id": 189,
      "start": 425.68,
      "end": 430.4,
      "text": "होगा आपने गोरेगांव में बोरीवली जाते टाइम"
    },
    {
      "subtitle_id": 190,
      "start": 428.0,
      "end": 431.759,
      "text": "लेफ्ट साइड में या फिर आप अगर आप चर्चगेट"
    },
    {
      "subtitle_id": 191,
      "start": 430.4,
      "end": 434.08,
      "text": "जा रहे हो सीएसटी जा रहे हो तो राइट साइड"
    },
    {
      "subtitle_id": 192,
      "start": 431.759,
      "end": 437.199,
      "text": "में आपको दिखेगा दादर वगैरह जा रहे हो तो"
    },
    {
      "subtitle_id": 193,
      "start": 434.08,
      "end": 439.68,
      "text": "तो ऐसे में नेस्को में मैंने देखा कि इसके"
    },
    {
      "subtitle_id": 194,
      "start": 437.199,
      "end": 442.72,
      "text": "पास अच्छी खासी लैंड मुझे दिखी। लैंड के"
    },
    {
      "subtitle_id": 195,
      "start": 439.68,
      "end": 444.639,
      "text": "वैल्यूएशंस निकाले गए। हमने जाके वहां के"
    },
    {
      "subtitle_id": 196,
      "start": 442.72,
      "end": 446.319,
      "text": "जो रियलस्टेट ब्रोकर्स हैं उनसे बात की।"
    },
    {
      "subtitle_id": 197,
      "start": 444.639,
      "end": 448.88,
      "text": "जो ऑनलाइन प्लेटफार्म्स हैं वहां पर देखा"
    },
    {
      "subtitle_id": 198,
      "start": 446.319,
      "end": 452.08,
      "text": "कि उस आजूबाजू एरिया में लैंड के क्या भाव"
    },
    {
      "subtitle_id": 199,
      "start": 448.88,
      "end": 454.319,
      "text": "चल रहे हैं। तो इन्होंने सिर्फ 14% 14% ही"
    },
    {
      "subtitle_id": 200,
      "start": 452.08,
      "end": 456.8,
      "text": "जो जमीन है वहां की वो यूटिलाइज किए। वहां"
    },
    {
      "subtitle_id": 201,
      "start": 454.319,
      "end": 458.479,
      "text": "पर आईटी पार्क बनाए हैं। इनका बॉम्बे ने"
    },
    {
      "subtitle_id": 202,
      "start": 456.8,
      "end": 460.16,
      "text": "इसको बॉम्बे एग्बिशन सेंटर है। तो"
    },
    {
      "subtitle_id": 203,
      "start": 458.479,
      "end": 461.919,
      "text": "एक्सिबिशन सेंटर बाजू में रखो। आईटी वाला"
    },
    {
      "subtitle_id": 204,
      "start": 460.16,
      "end": 464.72,
      "text": "बढ़िया बिज़नेस लगा मुझे इनका। आईटी पार्क"
    },
    {
      "subtitle_id": 205,
      "start": 461.919,
      "end": 467.68,
      "text": "बढ़ा बनाओ रेंट पे दो। हाईवे टच है। 100%"
    },
    {
      "subtitle_id": 206,
      "start": 464.72,
      "end": 469.52,
      "text": "ऑक्यूुपेंसी है और 86% जगह भी खाली है।"
    },
    {
      "subtitle_id": 207,
      "start": 467.68,
      "end": 472.72,
      "text": "जहां पर एक और आईटी पार्क ये बना रहे हैं।"
    },
    {
      "subtitle_id": 208,
      "start": 469.52,
      "end": 475.12,
      "text": "लेकिन वो भी बनेगा वो भी जगह खाली खाली।"
    },
    {
      "subtitle_id": 209,
      "start": 472.72,
      "end": 477.199,
      "text": "70 एक्सर्स ऑन द हाईवे दैट्स ह्यूज लैंड"
    },
    {
      "subtitle_id": 210,
      "start": 475.12,
      "end": 479.12,
      "text": "पार्सल। प्लस इनके गुजरात में भी कुछ लैंड"
    },
    {
      "subtitle_id": 211,
      "start": 477.199,
      "end": 481.12,
      "text": "पार्सल है जिसका मैंने वैल्यूएशन निकाला"
    },
    {
      "subtitle_id": 212,
      "start": 479.12,
      "end": 482.96,
      "text": "नहीं। बिकॉज़ टफ बट गोरेगा वाला तो निकाल"
    },
    {
      "subtitle_id": 213,
      "start": 481.12,
      "end": 486.479,
      "text": "दिया। एंड आई फाउंड द कंपनीज़ अंडरवैल्यू।"
    },
    {
      "subtitle_id": 214,
      "start": 482.96,
      "end": 489.12,
      "text": "एंड दैट्स व्हाई आई डिसाइडेड टू यू नो"
    },
    {
      "subtitle_id": 215,
      "start": 486.479,
      "end": 490.96,
      "text": "फोकस इन दिस एरिया। अब यह जो स्टॉक्स हम"
    },
    {
      "subtitle_id": 216,
      "start": 489.12,
      "end": 493.68,
      "text": "निकालते हैं उसके पीछे काफी भारी रिसर्च"
    },
    {
      "subtitle_id": 217,
      "start": 490.96,
      "end": 495.52,
      "text": "रहती है और यह रिसर्च अगर आपको पसंद आती"
    },
    {
      "subtitle_id": 218,
      "start": 493.68,
      "end": 497.919,
      "text": "है तो आपको हमारे मॉडल पोर्टफोलियोस भी"
    },
    {
      "subtitle_id": 219,
      "start": 495.52,
      "end": 499.599,
      "text": "पसंद आएंगे। जहां पर हमारे फिलहाल दो मॉडल"
    },
    {
      "subtitle_id": 220,
      "start": 497.919,
      "end": 501.039,
      "text": "पोर्टफोलियोस हैं। एक है इका वैल्यू"
    },
    {
      "subtitle_id": 221,
      "start": 499.599,
      "end": 503.199,
      "text": "इन्वेस्टिंग मॉडल पोर्टफोलियो जो"
    },
    {
      "subtitle_id": 222,
      "start": 501.039,
      "end": 505.36,
      "text": "अंडरवैल्यूड कंपनीज़ हैं स्टॉक से उनको"
    },
    {
      "subtitle_id": 223,
      "start": 503.199,
      "end": 508.319,
      "text": "ढूंढने पर पूरी ताकत लगाते हैं। और दूसरा"
    },
    {
      "subtitle_id": 224,
      "start": 505.36,
      "end": 511.12,
      "text": "है हमारा इका इमर्जिंग इंडिया जहां पर हम"
    },
    {
      "subtitle_id": 225,
      "start": 508.319,
      "end": 513.279,
      "text": "ऐसे सेक्टर्स को टारगेट करते हैं जिससे कल"
    },
    {
      "subtitle_id": 226,
      "start": 511.12,
      "end": 515.12,
      "text": "का भारत बने। बैंकिंग और आईटी सेक्टर से"
    },
    {
      "subtitle_id": 227,
      "start": 513.279,
      "end": 516.959,
      "text": "अब आप बहुत ज्यादा उम्मीदें नहीं रख सकते।"
    },
    {
      "subtitle_id": 228,
      "start": 515.12,
      "end": 518.719,
      "text": "उन्हें ही सेक्टर से रख सकते हैं। तो"
    },
    {
      "subtitle_id": 229,
      "start": 516.959,
      "end": 520.399,
      "text": "उन्हें हमने इस पर्टिकुलर मॉडल"
    },
    {
      "subtitle_id": 230,
      "start": 518.719,
      "end": 522.24,
      "text": "पोर्टफोलियो में लाया है। यहां पर"
    },
    {
      "subtitle_id": 231,
      "start": 520.399,
      "end": 524.08,
      "text": "कंटीन्यूअस रिसर्च होती है। बीच में कुछ"
    },
    {
      "subtitle_id": 232,
      "start": 522.24,
      "end": 525.92,
      "text": "रिबैलेंसिंग होती है। यानी कोई स्टॉक्स"
    },
    {
      "subtitle_id": 233,
      "start": 524.08,
      "end": 528.32,
      "text": "अगर निकालना है, कोई ऐड करना है तो ये"
    },
    {
      "subtitle_id": 234,
      "start": 525.92,
      "end": 530.8,
      "text": "ऑटोमेटिकली टेक्नोलॉजी की मदद से पॉसिबल"
    },
    {
      "subtitle_id": 235,
      "start": 528.32,
      "end": 532.64,
      "text": "है। उसके साथ रिबैलेंस वेटेज कम ज्यादा"
    },
    {
      "subtitle_id": 236,
      "start": 530.8,
      "end": 534.48,
      "text": "किसी में करना है तो वो भी यहां पर होता"
    },
    {
      "subtitle_id": 237,
      "start": 532.64,
      "end": 536.8,
      "text": "है। तो मॉडल पोर्टफोलियो क्या होता अगर"
    },
    {
      "subtitle_id": 238,
      "start": 534.48,
      "end": 540.72,
      "text": "आपको सिंपली बता दूं तो जनरली दोनों"
    },
    {
      "subtitle_id": 239,
      "start": 536.8,
      "end": 542.32,
      "text": "पोर्टफोलियो में हमारे करीब 15 के अराउंड"
    },
    {
      "subtitle_id": 240,
      "start": 540.72,
      "end": 544.48,
      "text": "स्टॉक्स हैं। मतलब एक मॉडल पोर्टफोलियो"
    },
    {
      "subtitle_id": 241,
      "start": 542.32,
      "end": 545.76,
      "text": "देखें तो हमने 15 रखे हैं। फॉर एग्जांपल"
    },
    {
      "subtitle_id": 242,
      "start": 544.48,
      "end": 547.68,
      "text": "यहां पर कोई स्टॉक ऐसा है कि जिसकी"
    },
    {
      "subtitle_id": 243,
      "start": 545.76,
      "end": 549.68,
      "text": "परफॉर्मेंस खराब हो जाती है या फिर हमें"
    },
    {
      "subtitle_id": 244,
      "start": 547.68,
      "end": 551.279,
      "text": "लगता है कि अभी ये फिट नहीं है और हम उसे"
    },
    {
      "subtitle_id": 245,
      "start": 549.68,
      "end": 553.2,
      "text": "निकालने की कोशिश करते हैं और उसको किसी"
    },
    {
      "subtitle_id": 246,
      "start": 551.279,
      "end": 554.88,
      "text": "और स्टॉक से रिप्लेस करते हैं तो उसके लिए"
    },
    {
      "subtitle_id": 247,
      "start": 553.2,
      "end": 556.72,
      "text": "आपको ज्यादा कुछ नहीं करना होता है। आपको"
    },
    {
      "subtitle_id": 248,
      "start": 554.88,
      "end": 559.12,
      "text": "सिंपली इसका नोटिफिकेशन आ जाता है। एक"
    },
    {
      "subtitle_id": 249,
      "start": 556.72,
      "end": 560.88,
      "text": "क्लिक पर ऑटोमेटिक रिबैलेंस हो जाता है।"
    },
    {
      "subtitle_id": 250,
      "start": 559.12,
      "end": 562.959,
      "text": "तो आपको इसमें ज़्यादा मेहनत नहीं है।"
    },
    {
      "subtitle_id": 251,
      "start": 560.88,
      "end": 564.56,
      "text": "एक्टिवली कुछ नहीं करना है। आपको इसके"
    },
    {
      "subtitle_id": 252,
      "start": 562.959,
      "end": 566.08,
      "text": "नोटिफिकेशन आते रहेंगे। तो उसके लिए"
    },
    {
      "subtitle_id": 253,
      "start": 564.56,
      "end": 567.6,
      "text": "सिंपली आपको नीचे डिस्क्रिप्शन और कमेंट"
    },
    {
      "subtitle_id": 254,
      "start": 566.08,
      "end": 569.2,
      "text": "बॉक्स में दिए गए लिंक पर क्लिक करके"
    },
    {
      "subtitle_id": 255,
      "start": 567.6,
      "end": 570.56,
      "text": "हमारे जो मॉडल पोर्टफोलियोज़ हैं यू कैन"
    },
    {
      "subtitle_id": 256,
      "start": 569.2,
      "end": 572.08,
      "text": "चेक देम आउट। और हमारे जो मॉडल"
    },
    {
      "subtitle_id": 257,
      "start": 570.56,
      "end": 573.92,
      "text": "पोर्टफोलियोज़ है हम स्माल केस के साथ कर"
    },
    {
      "subtitle_id": 258,
      "start": 572.08,
      "end": 575.839,
      "text": "रहे हैं ताकि जो टेक्निकल एग्जीक्यूशन हो"
    },
    {
      "subtitle_id": 259,
      "start": 573.92,
      "end": 577.44,
      "text": "एकदम ही सिंपल हो। आपको कुछ नहीं करना"
    },
    {
      "subtitle_id": 260,
      "start": 575.839,
      "end": 579.36,
      "text": "होता है। ऑटोमेटिकली सारी चीजें आपके"
    },
    {
      "subtitle_id": 261,
      "start": 577.44,
      "end": 581.04,
      "text": "डीमेट अकाउंट में रिफ्लेक्ट होती है। उसके"
    },
    {
      "subtitle_id": 262,
      "start": 579.36,
      "end": 583.04,
      "text": "रिलेटेड कोई भी अगर आपके डाउट है तो आप इन"
    },
    {
      "subtitle_id": 263,
      "start": 581.04,
      "end": 584.64,
      "text": "दो नंबर्स पर कांटेक्ट कर सकते हो। और साथ"
    },
    {
      "subtitle_id": 264,
      "start": 583.04,
      "end": 587.279,
      "text": "ही एक चीज़ आपको बताना चाहता हूं कि फिलहाल"
    },
    {
      "subtitle_id": 265,
      "start": 584.64,
      "end": 589.44,
      "text": "दिवाली ऑफर में फ्लैट 30% का डिस्काउंट आप"
    },
    {
      "subtitle_id": 266,
      "start": 587.279,
      "end": 590.959,
      "text": "सभी को यहां पर मिल रहा है। इन दोनों मॉडल"
    },
    {
      "subtitle_id": 267,
      "start": 589.44,
      "end": 592.48,
      "text": "पोर्टफोलियोज़ में। अगर आप हमारे दोनों"
    },
    {
      "subtitle_id": 268,
      "start": 590.959,
      "end": 593.839,
      "text": "मॉडल पोर्टफोलियोस को सब्सक्राइब करना"
    },
    {
      "subtitle_id": 269,
      "start": 592.48,
      "end": 595.92,
      "text": "चाहते हैं तो उसके लिए भी आप टीम से"
    },
    {
      "subtitle_id": 270,
      "start": 593.839,
      "end": 597.6,
      "text": "कांटेक्ट करें ताकि आपको एडिशनल डिस्काउंट"
    },
    {
      "subtitle_id": 271,
      "start": 595.92,
      "end": 599.44,
      "text": "मिले। वैसे मॉडल पोर्टफोलियो का फंक्शनिंग"
    },
    {
      "subtitle_id": 272,
      "start": 597.6,
      "end": 601.44,
      "text": "बड़ा ही सिंपल है। लेकिन फिर भी अगर आपके"
    },
    {
      "subtitle_id": 273,
      "start": 599.44,
      "end": 603.519,
      "text": "दिमाग में कोई डाउट आता है तो आप कभी भी"
    },
    {
      "subtitle_id": 274,
      "start": 601.44,
      "end": 605.44,
      "text": "हमारी टीम को कांटेक्ट कर सकते हैं"
    },
    {
      "subtitle_id": 275,
      "start": 603.519,
      "end": 606.959,
      "text": "वर्किंग आवर्स में। और एक इंपॉर्टेंट चीज"
    },
    {
      "subtitle_id": 276,
      "start": 605.44,
      "end": 608.24,
      "text": "कि ये दिवाली इन्वेस्टमेंट करने के लिए"
    },
    {
      "subtitle_id": 277,
      "start": 606.959,
      "end": 610.16,
      "text": "काफी अच्छी अपॉर्चुनिटी हो सकती है। बिकॉज़"
    },
    {
      "subtitle_id": 278,
      "start": 608.24,
      "end": 612.0,
      "text": "जो बोनस वगैरह आए हैं सही तरीके से उन्हें"
    },
    {
      "subtitle_id": 279,
      "start": 610.16,
      "end": 613.92,
      "text": "इन्वेस्ट कीजिए। अलग-अलग एसेट क्लासेस में"
    },
    {
      "subtitle_id": 280,
      "start": 612.0,
      "end": 615.68,
      "text": "जहां भी आपको पसंद आए और हमारे इस मॉडल"
    },
    {
      "subtitle_id": 281,
      "start": 613.92,
      "end": 617.839,
      "text": "पोर्टफोलियो ऑफर का भी जरूर फायदा उठाइए।"
    },
    {
      "subtitle_id": 282,
      "start": 615.68,
      "end": 619.92,
      "text": "पिछले एक साल में मार्केट काफी वोलेटाइल"
    },
    {
      "subtitle_id": 283,
      "start": 617.839,
      "end": 621.44,
      "text": "भी रहा है। रिकवरी अभी तक शुरू नहीं हुई"
    },
    {
      "subtitle_id": 284,
      "start": 619.92,
      "end": 622.64,
      "text": "है। तो वह भी एक अपोरर्चुनिटी आपके पास"
    },
    {
      "subtitle_id": 285,
      "start": 621.44,
      "end": 624.32,
      "text": "है। तो फिलहाल यहीं पर रुकते हैं। आपको"
    },
    {
      "subtitle_id": 286,
      "start": 622.64,
      "end": 626.16,
      "text": "वीडियो कैसा लगा नीचे कमेंट करके जरूर"
    },
    {
      "subtitle_id": 287,
      "start": 624.32,
      "end": 627.68,
      "text": "बताइए। और आप में से कौन-कौन ऐसे लोग हैं"
    },
    {
      "subtitle_id": 288,
      "start": 626.16,
      "end": 630.24,
      "text": "जो हर साल हमारा मोरल ट्रेडिंग का वीडियो"
    },
    {
      "subtitle_id": 289,
      "start": 627.68,
      "end": 631.839,
      "text": "देखते हैं। आप भी अपनी अटेंडेंस जरूर"
    },
    {
      "subtitle_id": 290,
      "start": 630.24,
      "end": 633.04,
      "text": "लगाइए। जरूर हमें उसके बारे में बताइए।"
    },
    {
      "subtitle_id": 291,
      "start": 631.839,
      "end": 635.2,
      "text": "मिलते हैं अगले वीडियो में। थैंक यू सो"
    },
    {
      "subtitle_id": 292,
      "start": 633.04,
      "end": 637.68,
      "text": "मच। काफी मजा है आपसे बात करके। बाई बाय,"
    },
    {
      "subtitle_id": 293,
      "start": 635.2,
      "end": 637.68,
      "text": "टेक केयर।"
    }
  ]
}