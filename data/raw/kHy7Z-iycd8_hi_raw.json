    {
      "subtitle_id": 133,
      "start": 453.52,
      "end": 460.36,
      "text": "कुछ तो भी फनी सा कंटेंट क्रिएट करके फूड"
    },
    {
      "subtitle_id": 134,
      "start": 455.52,
      "end": 460.36,
      "text": "डिलीवरी या फिर जोमट से से रिलेट करना यह"
    },
    {
      "subtitle_id": 135,
      "start": 479.68,
      "end": 482.56,
      "text": "ने वहां भी एंट्री की अब मेरा एक"
    },
    {
      "subtitle_id": 136,
      "start": 480.919,
      "end": 484.479,
      "text": "महाराष्ट्र में छोटा सा टियर थ टाउन है"
    },
    {
      "subtitle_id": 137,
      "start": 482.56,
      "end": 487.72,
      "text": "मलकापुर जो कि जलगांव के नजदीक आता है"
    },
    {
      "subtitle_id": 138,
      "start": 484.479,
      "end": 487.72,
      "text": "वहां पर लगभग ढ़ साल से"
    },
    {
      "subtitle_id": 139,
      "start": 509.52,
      "end": 513.44,
      "text": "वो है अलग-अलग नाम से चार्जेस लाना जो कि"
    },
    {
      "subtitle_id": 140,
      "start": 511.68,
      "end": 515.519,
      "text": "लोगों को समझ ही ना पाए कि चार्जेस आखिर"
    },
    {
      "subtitle_id": 141,
      "start": 513.44,
      "end": 517.24,
      "text": "है किस चीज के जैसे कि हैंडलिंग चार्जेस"
