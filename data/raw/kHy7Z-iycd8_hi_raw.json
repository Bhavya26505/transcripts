    {
      "subtitle_id": 147,
      "start": 523.599,
      "end": 526.92,
      "text": "है वो काफी तेजी से बढ़ रहा है अब हुआ ये"
    },
    {
      "subtitle_id": 148,
      "start": 525.32,
      "end": 528.56,
      "text": "कि लोगों को आदत लग गई है तो लोग"
    },
    {
      "subtitle_id": 149,
      "start": 526.92,
      "end": 530.399,
      "text": "एक्स्ट्रा जो चार्जेस है वो भी पे करने के"
    },
    {
      "subtitle_id": 150,
      "start": 528.56,
      "end": 531.6,
      "text": "लिए रेडी हो रहे हैं और इसी चीज का जो"
    },
    {
      "subtitle_id": 151,
      "start": 530.399,
      "end": 533.32,
      "text": "रिफ्लेक्शन है वो आपको कंपनी के"
    },
    {
      "subtitle_id": 152,
      "start": 531.6,
      "end": 535.68,
      "text": "फाइनेंशियल स्टेटमेंट्स में मिलेगा जैसे"
    },
    {
      "subtitle_id": 153,
      "start": 533.32,
      "end": 535.68,
      "text": "कि अगर आप"
    },
