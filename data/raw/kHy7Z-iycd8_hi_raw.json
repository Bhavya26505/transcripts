    {
      "subtitle_id": 158,
      "start": 546.16,
      "end": 549.8,
      "text": "आपको अगेन लॉस में दिख सकती है तो ये अदर"
    },
    {
      "subtitle_id": 159,
      "start": 547.88,
      "end": 551.76,
      "text": "इनकम क्या है तो जैसे कि आप स्क्रीन पर"
    },
    {
      "subtitle_id": 160,
      "start": 549.8,
      "end": 553.56,
      "text": "देख सकते हो कि कंपनी के अदर इनकम में"
    },
    {
      "subtitle_id": 161,
      "start": 551.76,
      "end": 555.92,
      "text": "आपको कंपनी के बैंक डिपॉजिट्स मिलेंगे"
    },
    {
      "subtitle_id": 162,
      "start": 553.56,
      "end": 557.959,
      "text": "जहां से कंपनी को 214 करोड़ का इंटरेस्ट"
    },
    {
      "subtitle_id": 163,
      "start": 555.92,
      "end": 559.64,
      "text": "आया है मात्र इंटरेस्ट इसके बाद गवर्नमेंट"
    },
    {
      "subtitle_id": 164,
      "start": 557.959,
      "end": 561.56,
      "text": "बॉन्ड्स इनके पास हैं इनके पास म्यूचुअल"
    },
    {
      "subtitle_id": 165,
      "start": 559.64,
      "end": 563.68,
      "text": "फंड्स हैं और इन सारी चीजों से जो भी"
    },
    {
      "subtitle_id": 166,
      "start": 561.56,
      "end": 565.44,
      "text": "रिटर्न्स या फिर इंटरेस्ट इन्हें मिलता है"
    },
    {
      "subtitle_id": 167,
      "start": 563.68,
      "end": 567.079,
      "text": "ये अदर इनकम नॉर्मल में रिफ्लेक्ट हो जाता"
