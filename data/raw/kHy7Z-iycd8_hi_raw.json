    {
      "subtitle_id": 47,
      "start": 236.799,
      "end": 241.799,
      "text": "मात्र ₹1 में तो इस ऑफर को किसी भी हालत"
    },
    {
      "subtitle_id": 48,
      "start": 240.28,
      "end": 243.079,
      "text": "में मिस आउट मत कीजिए इसकी डिस्काउंट लिंक"
    },
    {
      "subtitle_id": 49,
      "start": 241.799,
      "end": 244.56,
      "text": "आपको नीचे डिस्क्रिप्शन और कमेंट बॉक्स"
    },
    {
      "subtitle_id": 50,
      "start": 243.079,
      "end": 246.2,
      "text": "में मिल जाएगी और इस प्राइस में आपको ये"
    },
    {
      "subtitle_id": 51,
      "start": 244.56,
      "end": 248.36,
      "text": "कोर्स बाद में आपको कभी नहीं मिलेगा सो"
    },
    {
      "subtitle_id": 52,
      "start": 246.2,
      "end": 250.959,
      "text": "डोंट मिस आउट ऑन दिस अपॉर्चुनिटी एंड ऑफर"
    },
    {
      "subtitle_id": 53,
      "start": 248.36,
      "end": 252.879,
      "text": "इस ऑफर के बस कुछ ही घंटे बचे हैं तो इस"
    },
    {
      "subtitle_id": 54,
      "start": 250.959,
      "end": 254.519,
      "text": "ऑफर का जरूर फायदा ले क्योंकि इस प्राइस"
    },
    {
      "subtitle_id": 55,
      "start": 252.879,
      "end": 256.639,
      "text": "में आपको यह कोर्स बाद में कभी नहीं मिलने"
    },
    {
      "subtitle_id": 56,
      "start": 254.519,
      "end": 258.799,
      "text": "वाला तो चलिए अब बढ़ते हैं वीडियो की तरफ"
    },
    {
      "subtitle_id": 57,
      "start": 256.639,
      "end": 260.72,
      "text": "लेकिन जोमट ने तब जब बलिंट को खरीदा था वो"
    },
    {
      "subtitle_id": 58,
      "start": 258.799,
      "end": 262.4,
      "text": "कोई रैंडम डिसीजन नहीं थी दीपेंद्र गोयल"
    },
    {
      "subtitle_id": 59,
      "start": 260.72,
      "end": 264.56,
      "text": "जब आईआईटी के लिए चंडीगढ़ में प्रिपेयर कर"
    },
    {
      "subtitle_id": 60,
      "start": 262.4,
      "end": 267.24,
      "text": "रहे थे तब उनके साथ उनके क्लासमेट थे"
    },
    {
      "subtitle_id": 61,
      "start": 264.56,
      "end": 269.919,
      "text": "जिनका नाम था अलबीर धंसा जो कि फाउंडर है"
    },
    {
      "subtitle_id": 62,
      "start": 267.24,
      "end": 272.639,
      "text": "ब्लिंकड के यानी दोनों एक दूसरे को पहले"
    },
    {
      "subtitle_id": 63,
      "start": 269.919,
      "end": 274.72,
      "text": "से जानते थे और जो अपॉर्चुनिटी है उसे भी"
    },
    {
      "subtitle_id": 64,
      "start": 272.639,
      "end": 276.6,
      "text": "व अच्छे से समझते थे लेकिन उस टाइम किसी"
    },
    {
      "subtitle_id": 65,
      "start": 274.72,
      "end": 278.8,
      "text": "को यह पता नहीं था कि क्विक कॉमर बिजनेस"
    },
    {
      "subtitle_id": 66,
      "start": 276.6,
      "end": 280.72,
      "text": "बहुत तेजी से बढ़ने वाला है और अगर किसी"
    },
    {
      "subtitle_id": 67,
      "start": 278.8,
      "end": 282.6,
      "text": "को पता भी होता तो उनको यह पता नहीं था कि"
    },
    {
      "subtitle_id": 68,
      "start": 280.72,
      "end": 284.6,
      "text": "क्विक कॉमर्स बिजनेस भी प्रॉफिटेबल बन"
    },
    {
      "subtitle_id": 69,
      "start": 282.6,
      "end": 286.6,
      "text": "सकता है क्योंकि अ रिसेंटली हुए स्टार्टअप"
    },
    {
      "subtitle_id": 70,
      "start": 284.6,
      "end": 288.88,
      "text": "महाकुंभ इवेंट में जोमट के फाउंडर"
    },
    {
      "subtitle_id": 71,
      "start": 286.6,
      "end": 291.32,
      "text": "दीपेंद्र गोयल ने कहा है कि आने वाले एक"
    },
    {
      "subtitle_id": 72,
      "start": 288.88,
      "end": 294.039,
      "text": "दो साल में ब्लिंकड जट से भी बड़ा बन सकता"
    },
    {
      "subtitle_id": 73,
      "start": 291.32,
      "end": 296.639,
      "text": "है व्हिच इज अ वेरी शॉकिंग लेकिन इसके साथ"
    },
    {
      "subtitle_id": 74,
      "start": 294.039,
      "end": 298.639,
      "text": "एक सवाल आता है कैसे इस एग्जांपल से समझते"
    },
    {
      "subtitle_id": 75,
      "start": 296.639,
      "end": 300.759,
      "text": "हैं जोमट का जो फूड डिलीवरी बिजनेस है"
    },
    {
      "subtitle_id": 76,
      "start": 298.639,
      "end": 303.32,
      "text": "उसके जो ग्रॉस ऑर्डर वैलू है वो ईयर ऑन"
    },
    {
      "subtitle_id": 77,
      "start": 300.759,
      "end": 304.88,
      "text": "ईयर पिछले 1 साल में 28 पर से बढ़ी है"
    },
    {
      "subtitle_id": 78,
      "start": 303.32,
      "end": 307.479,
      "text": "वहीं पर अगर मैं ब्लिंकड की बात करूं तो"
    },
    {
      "subtitle_id": 79,
      "start": 304.88,
      "end": 309.44,
      "text": "ईयर ऑन ईयर वो डबल हो गई है लगभग 100% से"
    },
    {
      "subtitle_id": 80,
      "start": 307.479,
      "end": 311.44,
      "text": "बढ़ी है और सिर्फ ग्रॉस ऑर्डर वैल्यू नहीं"
    },
    {
      "subtitle_id": 81,
      "start": 309.44,
      "end": 312.88,
      "text": "उसका रेवेन्यू भी डबल हुआ है अब यहां पर"
    },
    {
      "subtitle_id": 82,
      "start": 311.44,
      "end": 314.68,
      "text": "क्वेश्चन आता है कि रेवेन्यू तो शायद डबल"
    },
    {
      "subtitle_id": 83,
      "start": 312.88,
      "end": 317.6,
      "text": "हुआ होगा प्रॉफिट का क्या तो आपको बता दूं"
    },
    {
      "subtitle_id": 84,
      "start": 314.68,
      "end": 319.4,
      "text": "कि मार्च 2024 में ब्लिंकड एबड पॉजिटिव बन"
    },
    {
      "subtitle_id": 85,
      "start": 317.6,
      "end": 323.08,
      "text": "गया है यानी कि अगले एक डेढ़ साल में"
    },
    {
      "subtitle_id": 86,
      "start": 319.4,
      "end": 323.08,
      "text": "प्रॉफिटेबिलिटी की लाइन पर आ जाएगा जैसे"
    },
    {
      "subtitle_id": 87,
      "start": 329.72,
      "end": 333.24,
      "text": "कर रहा है और आने वाले 2 सालों में ये डबल"
    },
    {
      "subtitle_id": 88,
      "start": 331.56,
      "end": 335.12,
      "text": "से भी ज्यादा होने वाला है ऐसा दीपेंद्र"
    },
    {
      "subtitle_id": 89,
      "start": 333.24,
      "end": 336.84,
      "text": "गोयल का मानना है अब यहां पर एक चीज आपको"
    },
    {
      "subtitle_id": 90,
      "start": 335.12,
      "end": 338.72,
      "text": "समझनी पड़ेगी वो है ग्रॉस ऑर्डर वैल्यू"
    },
    {
      "subtitle_id": 91,
      "start": 336.84,
      "end": 340.68,
      "text": "यानी कितने रुपए का सामान आपने ऑर्डर किया"
    },
    {
      "subtitle_id": 92,
      "start": 338.72,
      "end": 342.28,
      "text": "तो आपने जो भी ऑर्डर की है उस पर ब्लिंकड"
    },
    {
      "subtitle_id": 93,
      "start": 340.68,
      "end": 344.44,
      "text": "आपको अलग-अलग चार्जेस लगाता है प्लेटफॉर्म"
    },
    {
      "subtitle_id": 94,
      "start": 342.28,
      "end": 346.12,
      "text": "फी हो गई बाकी कुछ हो गया और जो भी"
    },
    {
      "subtitle_id": 95,
      "start": 344.44,
      "end": 347.919,
      "text": "प्रोडक्ट सेल कर रहा है उसमें कुछ कमीशन"
    },
    {
      "subtitle_id": 96,
      "start": 346.12,
      "end": 349.96,
      "text": "हो गया ये सारी चीजें उसके रेवेन्यू में"
    },
    {
      "subtitle_id": 97,
      "start": 347.919,
      "end": 351.479,
      "text": "आती है रेवेन्यू के बाद सारे एक्सपेंसेस"
    },
    {
      "subtitle_id": 98,
      "start": 349.96,
      "end": 353.36,
      "text": "हटाने के बाद उसके लिए बचता है नेट"
    },
    {
      "subtitle_id": 99,
      "start": 351.479,
      "end": 355.0,
      "text": "प्रॉफिट तो फिलहाल देखा जाए तो बलिंट की"
