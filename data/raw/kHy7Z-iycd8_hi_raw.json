    {
      "subtitle_id": 129,
      "start": 424.24,
      "end": 426.879,
      "text": "अब बात करते हैं"
    },
    {
      "subtitle_id": 130,
      "start": 438.69,
      "end": 441.79,
      "text": "[संगीत]"
    },
    {
      "subtitle_id": 131,
      "start": 449.479,
      "end": 453.52,
      "text": "स्ट्रेटेजी में आपको दिखेगी कोई भी"
    },
    {
      "subtitle_id": 132,
      "start": 451.199,
      "end": 455.52,
      "text": "इंटरेस्टिंग चीज हुई है उस पर मीम बनाना"
