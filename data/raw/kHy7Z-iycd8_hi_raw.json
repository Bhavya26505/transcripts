      "subtitle_id": 113,
      "start": 395.52,
      "end": 399.52,
      "text": "flipkart-in को अर्जेंट है मैंने भी कुछ"
    },
    {
      "subtitle_id": 114,
      "start": 397.56,
      "end": 400.72,
      "text": "चीजें ऐसी थी जो बहुत अर्जेंट थी तो 10-15"
    },
    {
      "subtitle_id": 115,
      "start": 399.52,
      "end": 402.319,
      "text": "मिनट में मैंने भी इन क्विक कॉमर्स"
    },
    {
      "subtitle_id": 116,
      "start": 400.72,
      "end": 404.08,
      "text": "प्लेटफॉर्म से मंगा ली इसमें एक बहुत"
    },
    {
      "subtitle_id": 117,
      "start": 402.319,
      "end": 405.68,
      "text": "बेहतरीन स्ट्रेटेजी जोमट और ब्लिंकड दोनों"
