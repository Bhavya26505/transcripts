    {
      "subtitle_id": 169,
      "start": 567.079,
      "end": 570.76,
      "text": "फिलहाल"
    },
    {
      "subtitle_id": 170,
      "start": 569.36,
      "end": 572.64,
      "text": "बढ़ाए हैं बाकी चीजें की वो अभी तक"
    },
    {
      "subtitle_id": 171,
      "start": 570.76,
      "end": 574.8,
      "text": "सफिशिएंट नहीं है अभी भी अदर इनकम पर काफी"
    },
    {
      "subtitle_id": 172,
      "start": 572.64,
      "end": 576.8,
      "text": "ज्यादा डिपेंडेंस उनका है बहुत सारी चीजें"
    },
    {
      "subtitle_id": 173,
      "start": 574.8,
      "end": 578.68,
      "text": "बदल कर दिख रही है क्योंकि अदर इनकम इसमें"
    },
    {
      "subtitle_id": 174,
      "start": 576.8,
      "end": 580.16,
      "text": "काफी कुछ कंट्रीब्यूट कर रहा है बट आने"
    },
    {
      "subtitle_id": 175,
      "start": 578.68,
      "end": 581.64,
      "text": "वाले टाइम में कंपनी उस डायरेक्शन में जा"
    },
    {
      "subtitle_id": 176,
      "start": 580.16,
      "end": 585.04,
      "text": "रही है कि हम अच्छा खासा डायरेक्ट प्रॉफिट"
    },
    {
      "subtitle_id": 177,
      "start": 581.64,
      "end": 588.15,
      "text": "कमाएंगे बलिंट से भी और"
    },
    {
      "subtitle_id": 178,
      "start": 585.04,
      "end": 588.15,
      "text": "[संगीत]"
    },
    {
      "subtitle_id": 179,
      "start": 595.279,
      "end": 599.0,
      "text": "zomato.com इसमें ज्यादा कंट्रीब्यूट कर"
    },
    {
      "subtitle_id": 180,
      "start": 597.44,
      "end": 601.16,
      "text": "रहा है तो इस तरह की जो इन्वेस्टमेंट्स"
    },
    {
      "subtitle_id": 181,
      "start": 599.0,
      "end": 603.12,
      "text": "होती है आर वेरी वेरी रिस्की क्योंकि यहां"
    },
    {
      "subtitle_id": 182,
      "start": 601.16,
      "end": 605.16,
      "text": "पर कंपनी ने अभी भी बहुत स्ट्रांग"
    },
    {
      "subtitle_id": 183,
      "start": 603.12,
      "end": 607.399,
      "text": "प्रॉफिटेबिलिटी मॉडल नहीं ढूंढा है बिजनेस"
    },
    {
      "subtitle_id": 184,
      "start": 605.16,
      "end": 609.399,
      "text": "मॉडल जरूर ढूंढा है बहुत तेज से कंपनी बढ़"
    },
    {
      "subtitle_id": 185,
      "start": 607.399,
      "end": 612.04,
      "text": "रही है लेकिन जिस वैल्युएशंस पर आप कंपनी"
    },
    {
      "subtitle_id": 186,
      "start": 609.399,
      "end": 613.76,
      "text": "खरीद रहे हो 400 की पी पर वो मेरे हिसाब"
    },
    {
      "subtitle_id": 187,
      "start": 612.04,
      "end": 615.76,
      "text": "से आपके इन्वेस्टमेंट्स को काफी रिस्की"
    },
    {
      "subtitle_id": 188,
      "start": 613.76,
      "end": 617.36,
      "text": "बना सकता है तो रिस्क ये है कि अगर बलिंट"
    },
    {
      "subtitle_id": 189,
      "start": 615.76,
      "end": 619.92,
      "text": "मॉडल बहुत अच्छे से नहीं चलता है कोई अदर"
    },
    {
      "subtitle_id": 190,
      "start": 617.36,
      "end": 621.76,
      "text": "कंपीटीटर मान लीजिए z2 और कंपटीशन के चलते"
    },
    {
      "subtitle_id": 191,
      "start": 619.92,
      "end": 623.36,
      "text": "फिर प्रॉफिट कमाना ब्लिंकड के लिए टफ हो"
    },
    {
      "subtitle_id": 192,
      "start": 621.76,
      "end": 624.72,
      "text": "जाता है तो वो सारी चीजें आपके"
    },
    {
      "subtitle_id": 193,
      "start": 623.36,
      "end": 626.16,
      "text": "इन्वेस्टमेंट्स को और भी ज्यादा रिस्की"
    },
    {
      "subtitle_id": 194,
      "start": 624.72,
      "end": 627.64,
      "text": "बना सकती हैं तो अगर आप कंपनी में"
    },
    {
      "subtitle_id": 195,
      "start": 626.16,
      "end": 629.92,
      "text": "इन्वेस्टेड है तो क्वार्टरली कॉन्फ्रेंस"
    },
    {
      "subtitle_id": 196,
      "start": 627.64,
      "end": 631.88,
      "text": "कॉल जरूर सुनिए ब्लिंकड की क्या ग्रोथ है"
    },
    {
      "subtitle_id": 197,
      "start": 629.92,
      "end": 633.519,
      "text": "वहां पर प्रॉफिटेबिलिटी कैसी हो रही है"
    },
    {
      "subtitle_id": 198,
      "start": 631.88,
      "end": 635.24,
      "text": "आपको क्वार्टर ऑन क्वार्टर बेसिस पर ही"
    },
    {
      "subtitle_id": 199,
      "start": 633.519,
      "end": 637.24,
      "text": "चीजें ट्रैक करनी पड़ेगी अगर आपने थोड़ा"
    },
    {
      "subtitle_id": 200,
      "start": 635.24,
      "end": 639.12,
      "text": "भी कंपनी के ऊपर से ध्यान हटा दिया तो"
    },
    {
      "subtitle_id": 201,
      "start": 637.24,
      "end": 641.32,
      "text": "आपके लिए नजर हटी दुर्घटना घटी जैसी चीज"
    },
    {
      "subtitle_id": 202,
      "start": 639.12,
      "end": 642.92,
      "text": "यहां पर हो सकती है तो ओवरऑल अगर देखा जाए"
    },
    {
      "subtitle_id": 203,
      "start": 641.32,
      "end": 644.519,
      "text": "तो कंपनी जिस बिजनेस में ऑपरेट करती है"
    },
    {
      "subtitle_id": 204,
      "start": 642.92,
      "end": 646.399,
      "text": "चाहे वो फूड डिलीवरी बिजनेस हो या फिर"
    },
    {
      "subtitle_id": 205,
      "start": 644.519,
      "end": 648.8,
      "text": "इनका ब्लिंक इट का क्विक कॉमर बिजनेस हो"
    },
    {
      "subtitle_id": 206,
      "start": 646.399,
      "end": 650.44,
      "text": "दोनों भी बहुत ही लो मार्जिन बिजनेसेस हैं"
    },
    {
      "subtitle_id": 207,
      "start": 648.8,
      "end": 652.8,
      "text": "जिसमें स्केल बहुत ज्यादा स्केल बहुत"
    },
    {
      "subtitle_id": 208,
      "start": 650.44,
      "end": 655.079,
      "text": "ज्यादा इंपॉर्टेंट है इसीलिए इस बिजनेस"
    },
    {
      "subtitle_id": 209,
      "start": 652.8,
      "end": 656.959,
      "text": "में जो रिस्क है वो हमेशा बना रहेगा हमेशा"
    },
    {
      "subtitle_id": 210,
      "start": 655.079,
      "end": 659.2,
      "text": "बना रहेगा तो इसलिए मेरा ये मानना है कि"
    },
    {
      "subtitle_id": 211,
      "start": 656.959,
      "end": 659.2,
      "text": "अगर आप"
    },
    {
      "subtitle_id": 212,
      "start": 659.279,
      "end": 662.92,
      "text": "सिफाई करने के लिए आप ऐसे भी बिजनेसेस"
    },
    {
      "subtitle_id": 213,
      "start": 660.8,
      "end": 665.12,
      "text": "ढूंढिए जहां पर नेट प्रॉफिट मार्जिन काफी"
    },
    {
      "subtitle_id": 214,
      "start": 662.92,
      "end": 666.92,
      "text": "ज्यादा है तो तीन लाइन में अगर सराइज करूं"
    },
    {
      "subtitle_id": 215,
      "start": 665.12,
      "end": 668.519,
      "text": "तो बिजनेस बहुत तेजी से ग्रो कर रहा है"
    },
    {
      "subtitle_id": 216,
      "start": 666.92,
      "end": 670.12,
      "text": "लेकिन प्रॉफिटेबिलिटी का इशू अभी भी है"
    },
    {
      "subtitle_id": 217,
      "start": 668.519,
      "end": 672.32,
      "text": "दिख रही है आपको लेकिन वो एक्चुअल नहीं है"
    },
    {
      "subtitle_id": 218,
      "start": 670.12,
      "end": 674.48,
      "text": "अदर इनकम की वजह से एफडी इंटरेस्ट या फिर"
    },
    {
      "subtitle_id": 219,
      "start": 672.32,
      "end": 675.959,
      "text": "बॉन्ड वगैरह उससे है तो इसके लिए आपको"
    },
    {
      "subtitle_id": 220,
      "start": 674.48,
      "end": 677.519,
      "text": "एक्सपेक्ट करना पड़ेगा कि ब्लिंकड बहुत"
    },
    {
      "subtitle_id": 221,
      "start": 675.959,
      "end": 679.079,
      "text": "तेज से आगे बढ़े क्योंकि ब्लिंकड का जो"
    },
    {
      "subtitle_id": 222,
      "start": 677.519,
      "end": 680.76,
      "text": "रेवेन्यू है वो बहुत तेज से बढ़ रहा है"
    },
    {
      "subtitle_id": 223,
      "start": 679.079,
      "end": 683.04,
      "text": "अगर वो प्रॉफिट में तब्दील हो जाता है तो"
    },
    {
      "subtitle_id": 224,
      "start": 680.76,
      "end": 683.04,
      "text": "वो"
    },
    {
      "subtitle_id": 225,
      "start": 689.32,
      "end": 693.16,
      "text": "करके इसकी फाइनेंशियल मॉडलिंग निकालो और"
    },
    {
      "subtitle_id": 226,
      "start": 691.399,
      "end": 695.04,
      "text": "उसके बेसिस पर कंपनी की वैल्यू निकालने की"
    },
    {
      "subtitle_id": 227,
      "start": 693.16,
      "end": 696.92,
      "text": "कोशिश कीजिए और जाते-जाते हमारे फ्रीडम"
    },
    {
      "subtitle_id": 228,
      "start": 695.04,
      "end": 698.68,
      "text": "सेल ऑफर को जरूर चेक आउट कीजिए मात्र चंद"
    },
    {
      "subtitle_id": 229,
      "start": 696.92,
      "end": 700.279,
      "text": "घंटे इस ऑफर के अभी बाकी है मिलते हैं"
    },
    {
      "subtitle_id": 230,
      "start": 698.68,
      "end": 703.279,
      "text": "अगले वीडियो में थैंक यू सो मच फॉर वाचिंग"
    },
    {
      "subtitle_id": 231,
      "start": 700.279,
      "end": 703.279,
      "text": "दिस वीडियो"
    }
  ]
}