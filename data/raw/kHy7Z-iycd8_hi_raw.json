    {
      "subtitle_id": 27,
      "start": 153.879,
      "end": 158.36,
      "text": "लिए वो बिल्कुल सेंस नहीं बना रही थी और"
    },
    {
      "subtitle_id": 28,
      "start": 155.48,
      "end": 160.56,
      "text": "कारण भी बड़ा सिंपल था कारण यह था कि 2021"
    },
    {
      "subtitle_id": 29,
      "start": 158.36,
      "end": 160.56,
      "text": "में"
    },
    {
      "subtitle_id": 30,
      "start": 162.26,
      "end": 165.35,
      "text": "[संगीत]"
    },
    {
      "subtitle_id": 31,
      "start": 179.92,
      "end": 183.72,
      "text": "मोर स्ट्रेटेजिक वेंचर्स ने अपने शेयर्स ₹"
    },
    {
      "subtitle_id": 32,
      "start": 181.72,
      "end": 186.08,
      "text": "444 पर शेयर की प्राइस पर बेच दिए"
    },
    {
      "subtitle_id": 33,
      "start": 183.72,
      "end": 186.08,
      "text": "उन्होंने"
    },
    {
      "subtitle_id": 34,
      "start": 209.799,
      "end": 213.64,
      "text": "चीज हमें आनी चाहिए वो है कंपनी का"
    },
    {
      "subtitle_id": 35,
      "start": 211.2,
      "end": 215.76,
      "text": "फंडामेंटल एनालिसिस और यह चीज सीखना अब"
