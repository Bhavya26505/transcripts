    {
      "subtitle_id": 156,
      "start": 542.64,
      "end": 546.16,
      "text": "इनकम नॉर्मल प्रॉफिट आपको दिख रहा है"
    },
    {
      "subtitle_id": 157,
      "start": 544.36,
      "end": 547.88,
      "text": "लेकिन अदर इनकम अगर हटाया जाए तो कंपनी"
