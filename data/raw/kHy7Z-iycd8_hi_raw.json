    {
      "subtitle_id": 36,
      "start": 213.64,
      "end": 217.439,
      "text": "आपके लिए सबसे आसान हो गया है क्योंकि इस"
    },
    {
      "subtitle_id": 37,
      "start": 215.76,
      "end": 220.319,
      "text": "इंडिपेंडेंस डे हम आपके लिए लेकर आए हैं"
