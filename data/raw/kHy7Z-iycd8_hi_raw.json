    {
      "subtitle_id": 40,
      "start": 222.48,
      "end": 226.12,
      "text": "कंपनी के फाइनेंशियल स्टेटमेंट्स"
    },
    {
      "subtitle_id": 41,
      "start": 223.76,
      "end": 227.879,
      "text": "मैनेजमेंट एनालिसिस यहां से लेकर एडवांस"
    },
    {
      "subtitle_id": 42,
      "start": 226.12,
      "end": 229.959,
      "text": "लेवल तक यानी कंपनी के फॉरेंसिक एनालिसिस"
    },
    {
      "subtitle_id": 43,
      "start": 227.879,
      "end": 232.159,
      "text": "पल फार्म सारी चीजें सीख पाएंगे इस कोर्स"
