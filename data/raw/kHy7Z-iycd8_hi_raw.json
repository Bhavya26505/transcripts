    {
      "subtitle_id": 100,
      "start": 353.36,
      "end": 356.96,
      "text": "ग्रॉस ऑर्डर वैल्यू काफी तेजी से बढ़ रही"
    },
    {
      "subtitle_id": 101,
      "start": 355.0,
      "end": 359.12,
      "text": "है साथ ही कंपनी का रेवेन्यू भी बढ़ रहा"
    },
    {
      "subtitle_id": 102,
      "start": 356.96,
      "end": 362.08,
      "text": "है जो कि ग्रॉस ऑर्डर वैल्यू का लगभग 20"
    },
    {
      "subtitle_id": 103,
      "start": 359.12,
      "end": 364.319,
      "text": "पर है व्हिच इज अगेन अ गुड रेशो अब बलिंट"
    },
    {
      "subtitle_id": 104,
      "start": 362.08,
      "end": 367.319,
      "text": "और क्विक कॉमर्स जिसमें बलिंट के अलावा z"
    },
    {
      "subtitle_id": 105,
      "start": 364.319,
      "end": 369.8,
      "text": "आता है स्की का इमा आता है यह सारे"
    },
    {
      "subtitle_id": 106,
      "start": 367.319,
      "end": 371.36,
      "text": "प्लेयर्स बहुत बड़ा बन सकते हैं उसके लिए"
    },
    {
      "subtitle_id": 107,
      "start": 369.8,
      "end": 373.759,
      "text": "सबसे बड़ी अपॉर्चुनिटी है पूरा ई-कॉमर्स"
    },
    {
      "subtitle_id": 108,
      "start": 371.36,
      "end": 375.4,
      "text": "सेगमेंट इन्होंने शुरुआत की ग्रोसरी से"
    },
    {
      "subtitle_id": 109,
      "start": 373.759,
      "end": 379.12,
      "text": "लेकिन अब ये सिर्फ ग्रोसरी में नहीं है"
    },
    {
      "subtitle_id": 110,
      "start": 375.4,
      "end": 379.12,
      "text": "आपको बता दूं कि बलिंट रिसेंट टाइम में"
