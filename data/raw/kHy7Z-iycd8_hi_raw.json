    {
      "subtitle_id": 23,
      "start": 138.16,
      "end": 143.959,
      "text": "4447 करोड़ की स्टॉक स्वैप डील थी जिसमें"
    },
    {
      "subtitle_id": 24,
      "start": 140.959,
      "end": 143.959,
      "text": "zomato.com"
    },
    {
      "subtitle_id": 25,
      "start": 150.2,
      "end": 153.879,
      "text": "वो आपके लिए शायद अब सेंस बना रही होगी"
    },
    {
      "subtitle_id": 26,
      "start": 152.2,
      "end": 155.48,
      "text": "लेकिन उस टाइम मेजॉरिटी इन्वेस्टर्स के"
