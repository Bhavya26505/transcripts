    {
      "subtitle_id": 16,
      "start": 123.079,
      "end": 126.799,
      "text": "कंपनी नहीं बल्कि एक लॉस मेकिंग कंपनी थी"
    },
    {
      "subtitle_id": 17,
      "start": 125.079,
      "end": 128.879,
      "text": "और अगले कुछ ही महीनों में इस लॉस मेकिंग"
    },
    {
      "subtitle_id": 18,
      "start": 126.799,
      "end": 130.479,
      "text": "कंपनी ने एक ऐसी डिसीजन ली जिससे सारे"
    },
    {
      "subtitle_id": 19,
      "start": 128.879,
      "end": 132.879,
      "text": "इन्वेस्टर्स हैरान रह गए सारे शेयर"
    },
    {
      "subtitle_id": 20,
      "start": 130.479,
      "end": 134.72,
      "text": "होल्डर्स हैरान रह गए कंपनी ने एक बहुत"
    },
    {
      "subtitle_id": 21,
      "start": 132.879,
      "end": 138.16,
      "text": "बड़ी लॉस मेकिंग कंपनी को एक्वायर करने का"
    },
    {
      "subtitle_id": 22,
      "start": 134.72,
      "end": 140.959,
      "text": "डिसीजन लिया कंपनी का नाम था ब्लिंकड लगभग"
