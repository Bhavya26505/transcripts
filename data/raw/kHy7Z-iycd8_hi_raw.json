    {
      "subtitle_id": 121,
      "start": 409.84,
      "end": 413.44,
      "text": "फीज धीरे-धीरे बढ़ा रहे हैं अब ये सारी"
    },
    {
      "subtitle_id": 122,
      "start": 411.72,
      "end": 414.72,
      "text": "चीजें धीरे-धीरे हो रही है जिसे लोगों को"
    },
    {
      "subtitle_id": 123,
      "start": 413.44,
      "end": 416.56,
      "text": "ज्यादा रियलाइफ नहीं हो रहा है लेकिन"
    },
    {
      "subtitle_id": 124,
      "start": 414.72,
      "end": 418.919,
      "text": "इन्हीं सारे चार्जेस से कंपनी अच्छा खासा"
    },
    {
      "subtitle_id": 125,
      "start": 416.56,
      "end": 420.599,
      "text": "रेवेन्यू अपना जनरेट कर रही है बलिंट के"
    },
    {
      "subtitle_id": 126,
      "start": 418.919,
      "end": 422.36,
      "text": "पिछले एक साल की ग्रोथ का ये डेटा आप देख"
    },
    {
      "subtitle_id": 127,
      "start": 420.599,
      "end": 424.24,
      "text": "सकते हो जो आपको और भी ज्यादा क्लेरिटी दे"
    },
    {
      "subtitle_id": 128,
      "start": 422.36,
      "end": 426.879,
      "text": "देगा अब ये तो हमने बात की ब्लिंक इट की"
