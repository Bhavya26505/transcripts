  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.32,
      "end": 5.52,
      "text": "देखो वो आ गए हैं। मैं किसकी बात कर रहा"
    },
    {
      "subtitle_id": 2,
      "start": 3.2,
      "end": 7.839,
      "text": "हूं? मैं बात कर रहा हूं एफआईआई की फॉरेन"
    },
    {
      "subtitle_id": 3,
      "start": 5.52,
      "end": 9.84,
      "text": "इंस्टीट्यूशनल इन्वेस्टर्स की। अक्टूबर"
    },
    {
      "subtitle_id": 4,
      "start": 7.839,
      "end": 12.16,
      "text": "महीने से हर जगह आपने एक ही न्यूज़ देखी"
    },
    {
      "subtitle_id": 5,
      "start": 9.84,
      "end": 14.16,
      "text": "होगी कि एफआईआई मार्केट से बहुत तेजी से"
    },
    {
      "subtitle_id": 6,
      "start": 12.16,
      "end": 16.08,
      "text": "पैसा निकाल रहे हैं। जिसके चलते अक्टूबर"
    },
    {
      "subtitle_id": 7,
      "start": 14.16,
      "end": 18.56,
      "text": "महीने के बाद आने वाले चारप महीनों में"
    },
    {
      "subtitle_id": 8,
      "start": 16.08,
      "end": 20.8,
      "text": "काफी गिरावट हमें मार्केट में देखने मिली।"
    },
    {
      "subtitle_id": 9,
      "start": 18.56,
      "end": 23.6,
      "text": "फिर पता चला कि उसमें से काफी सारे लोग"
    },
    {
      "subtitle_id": 10,
      "start": 20.8,
      "end": 25.519,
      "text": "वापस यूएस चले गए एफआईआई और कुछ चाइना चले"
    },
    {
      "subtitle_id": 11,
      "start": 23.6,
      "end": 26.88,
      "text": "गए। अब जो चीज मैं आपको बताने वाला हूं"
    },
    {
      "subtitle_id": 12,
      "start": 25.519,
      "end": 29.679,
      "text": "इसमें दो फैक्टर्स हैं इस पूरे वीडियो"
    },
    {
      "subtitle_id": 13,
      "start": 26.88,
      "end": 31.359,
      "text": "में। एक आपके लिए बहुत खास है, अच्छे हैं।"
    },
    {
      "subtitle_id": 14,
      "start": 29.679,
      "end": 33.12,
      "text": "और कुछ फैक्टर्स ऐसे हैं जो आपके लिए बहुत"
    },
    {
      "subtitle_id": 15,
      "start": 31.359,
      "end": 35.04,
      "text": "शॉकिंग रहने वाले हैं। तो आज की इस वीडियो"
    },
    {
      "subtitle_id": 16,
      "start": 33.12,
      "end": 36.64,
      "text": "में हम बात करेंगे कि एफआईआई किस तरह से"
    },
    {
      "subtitle_id": 17,
      "start": 35.04,
      "end": 38.32,
      "text": "इंडियन मार्केट में वापस आ रहे हैं। वो"
    },
    {
      "subtitle_id": 18,
      "start": 36.64,
      "end": 39.84,
      "text": "डाटा के साथ मैं आपको बताऊंगा। उसका क्या"
    },
    {
      "subtitle_id": 19,
      "start": 38.32,
      "end": 42.559,
      "text": "मार्केट पर इंपैक्ट होगा इसकी हम बात"
    },
    {
      "subtitle_id": 20,
      "start": 39.84,
      "end": 44.719,
      "text": "करेंगे। सेकंड चीज क्यों यह वापस आ रहे"
    },
    {
      "subtitle_id": 21,
      "start": 42.559,
      "end": 46.48,
      "text": "हैं यह समझना भी बहुत ज्यादा जरूरी है और"
    },
    {
      "subtitle_id": 22,
      "start": 44.719,
      "end": 47.84,
      "text": "उसमें काफी इंटरेस्टिंग और फनी चीजें भी"
    },
    {
      "subtitle_id": 23,
      "start": 46.48,
      "end": 49.36,
      "text": "आपको पता चल जाएगी। और इससे आपको"
    },
    {
      "subtitle_id": 24,
      "start": 47.84,
      "end": 51.2,
      "text": "इंस्टीट्यूशन इन्वेस्टर्स जनरली कैसे"
    },
    {
      "subtitle_id": 25,
      "start": 49.36,
      "end": 53.44,
      "text": "सोचते हैं, क्या कुछ देखते हैं, उसकी भी"
    },
    {
      "subtitle_id": 26,
      "start": 51.2,
      "end": 54.879,
      "text": "आईडिया आ जाएगी। और साथ ही जो एफआई हैं यह"
    },
    {
      "subtitle_id": 27,
      "start": 53.44,
      "end": 56.8,
      "text": "किस सेक्टर में और किन कंपनीज में"
    },
    {
      "subtitle_id": 28,
      "start": 54.879,
      "end": 58.879,
      "text": "ज्यादातर खरीददारी कर रहे हैं इसके बारे"
    },
    {
      "subtitle_id": 29,
      "start": 56.8,
      "end": 60.64,
      "text": "में भी आज मैं कंपनी टू कंपनी सेक्टर टू"
    },
    {
      "subtitle_id": 30,
      "start": 58.879,
      "end": 62.239,
      "text": "सेक्टर आपको बताऊंगा। तो चलिए बिना किसी"
    },
    {
      "subtitle_id": 31,
      "start": 60.64,
      "end": 64.799,
      "text": "देरी के शुरू करते हैं और यह सारी चीजें"
    },
    {
      "subtitle_id": 32,
      "start": 62.239,
      "end": 66.32,
      "text": "जल्द से जल्द रिवील करते हैं। नमस्कार मैं"
    },
    {
      "subtitle_id": 33,
      "start": 64.799,
      "end": 67.92,
      "text": "प्रसाद आपका आज के इस वीडियो में स्वागत"
    },
    {
      "subtitle_id": 34,
      "start": 66.32,
      "end": 69.6,
      "text": "करता हूं। आज के इस वीडियो के प्रायोजक है"
    },
    {
      "subtitle_id": 35,
      "start": 67.92,
      "end": 71.76,
      "text": "क्रेडिट पे जिनके बारे में हम वीडियो में"
    },
    {
      "subtitle_id": 36,
      "start": 69.6,
      "end": 75.04,
      "text": "आगे बात करेंगे। सबसे पहले बात करते हैं"
    },
    {
      "subtitle_id": 37,
      "start": 71.76,
      "end": 78.08,
      "text": "अक्टूबर मंथ की जहां पर एफआईआई ने 4 लाख"
    },
    {
      "subtitle_id": 38,
      "start": 75.04,
      "end": 80.08,
      "text": "करोड़ के शेयर्स बेचे थे और 3 लाख लगभग 3"
    },
    {
      "subtitle_id": 39,
      "start": 78.08,
      "end": 83.04,
      "text": "लाख करोड़ के शेयर्स खरीदे थे। तो वहां पर"
    },
    {
      "subtitle_id": 40,
      "start": 80.08,
      "end": 86.0,
      "text": "जो नेट सेल ऑफ था इन एफआई इन्वेस्टर्स का"
    },
    {
      "subtitle_id": 41,
      "start": 83.04,
      "end": 88.32,
      "text": "वो लगभग 1 लाख करोड़ से भी ज्यादा था और"
    },
    {
      "subtitle_id": 42,
      "start": 86.0,
      "end": 90.32,
      "text": "यह ऑलमोस्ट ऑल टाइम हाई पर था। अगले कुछ"
    },
    {
      "subtitle_id": 43,
      "start": 88.32,
      "end": 92.72,
      "text": "महीनों में यह नंबर्स थोड़ा कम था लेकिन"
    },
    {
      "subtitle_id": 44,
      "start": 90.32,
      "end": 95.92,
      "text": "जनवरी 2025 में अगेन ये नंबर पीक पर चला"
    },
    {
      "subtitle_id": 45,
      "start": 92.72,
      "end": 98.32,
      "text": "गया और 87000 करोड़ का नेट सेल ऑफ हमें"
    },
    {
      "subtitle_id": 46,
      "start": 95.92,
      "end": 100.4,
      "text": "जनवरी मंथ में देखने मिला। लेकिन उसके बाद"
    },
    {
      "subtitle_id": 47,
      "start": 98.32,
      "end": 103.04,
      "text": "फिर आया मार्च जहां पर एफआईएस का जो"
    },
    {
      "subtitle_id": 48,
      "start": 100.4,
      "end": 105.439,
      "text": "इनफ्लो था वो आउटफ्ल् से ज्यादा रहा 2000"
    },
    {
      "subtitle_id": 49,
      "start": 103.04,
      "end": 107.52,
      "text": "करोड़ से और उसके बाद अप्रैल मंथ में भी"
    },
    {
      "subtitle_id": 50,
      "start": 105.439,
      "end": 109.6,
      "text": "2700 करोड़ से इनका जो इनफ्लो है वो"
    },
    {
      "subtitle_id": 51,
      "start": 107.52,
      "end": 111.68,
      "text": "आउटफ्लो से ज्यादा रहा। अब अगर आप मई मंथ"
    },
    {
      "subtitle_id": 52,
      "start": 109.6,
      "end": 114.36,
      "text": "की डे बाय डे बात करते हो तो सेकंड मई के"
    },
    {
      "subtitle_id": 53,
      "start": 111.68,
      "end": 117.28,
      "text": "दिन ही जो नेट इनफ्लो था एफआईएस का वो"
    },
    {
      "subtitle_id": 54,
      "start": 114.36,
      "end": 119.439,
      "text": "2769 करोड़ का था जो कि पूरे अप्रैल मंथ"
    },
    {
      "subtitle_id": 55,
      "start": 117.28,
      "end": 121.2,
      "text": "से ज्यादा था और यह कहानी आगे भी जारी"
    },
    {
      "subtitle_id": 56,
      "start": 119.439,
      "end": 122.96,
      "text": "रही। इनफैक्ट इंडिया पाकिस्तान वॉर शुरू"
    },
    {
      "subtitle_id": 57,
      "start": 121.2,
      "end": 124.88,
      "text": "होने के बाद भी यह जो कहानी है यह पॉजिटिव"
    },
    {
      "subtitle_id": 58,
      "start": 122.96,
      "end": 126.479,
      "text": "में ही रही। 8th ऑफ मई को आप यहां पर देख"
    },
    {
      "subtitle_id": 59,
      "start": 124.88,
      "end": 128.319,
      "text": "सकते हो। यहां पर भी आपको नेट इनफ्लो"
    },
    {
      "subtitle_id": 60,
      "start": 126.479,
      "end": 131.36,
      "text": "देखने मिला। और अब तक अगर देखा जाए तो"
    },
    {
      "subtitle_id": 61,
      "start": 128.319,
      "end": 133.92,
      "text": "20th ऑफ़ मई तक 13,000 करोड़ का नेट इनफ्लो"
    },
    {
      "subtitle_id": 62,
      "start": 131.36,
      "end": 136.56,
      "text": "हमें यहां पर देखने मिला। यानी कि दिसंबर"
    },
    {
      "subtitle_id": 63,
      "start": 133.92,
      "end": 139.28,
      "text": "2023 के बाद यानी 1ढ़ साल बाद सबसे ज्यादा"
    },
    {
      "subtitle_id": 64,
      "start": 136.56,
      "end": 141.76,
      "text": "एफआई का इनफ्लो फिलहाल इस मंथ के 20 तारीख"
    },
    {
      "subtitle_id": 65,
      "start": 139.28,
      "end": 143.92,
      "text": "तक इन 20 दिनों में हमें देखने मिला है।"
    },
    {
      "subtitle_id": 66,
      "start": 141.76,
      "end": 146.72,
      "text": "वीडियो में आगे बढ़ने से पहले आपको एक बात"
    },
    {
      "subtitle_id": 67,
      "start": 143.92,
      "end": 149.04,
      "text": "बोलना चाहूंगा कि आप एक चीज मिस कर रहे हो"
    },
    {
      "subtitle_id": 68,
      "start": 146.72,
      "end": 151.04,
      "text": "वो क्या? तो ढेरों सारा कैशबैक पाने का"
    },
    {
      "subtitle_id": 69,
      "start": 149.04,
      "end": 153.12,
      "text": "मौका। व्हाइल डूइंग यूपीआई पेमेंट्स वाया"
    },
    {
      "subtitle_id": 70,
      "start": 151.04,
      "end": 155.599,
      "text": "क्रेडिट कार्ड। लेकिन अब नहीं। क्योंकि"
    },
    {
      "subtitle_id": 71,
      "start": 153.12,
      "end": 157.84,
      "text": "क्रेडिट पे से आपको मिलेगा 2% अनलिमिटेड"
    },
    {
      "subtitle_id": 72,
      "start": 155.599,
      "end": 159.84,
      "text": "कैशबैक सारे यूपीआई स्पेंड्स पर। यूपीआई"
    },
    {
      "subtitle_id": 73,
      "start": 157.84,
      "end": 161.76,
      "text": "लिंकिंग के बाद रुपए क्रेडिट कार्ड की जो"
    },
    {
      "subtitle_id": 74,
      "start": 159.84,
      "end": 163.36,
      "text": "डिमांड है वह एकदम पीक पर चल रही है। इसी"
    },
    {
      "subtitle_id": 75,
      "start": 161.76,
      "end": 166.239,
      "text": "के चलते रुपए क्रेडिट कार्ड का जो मार्केट"
    },
    {
      "subtitle_id": 76,
      "start": 163.36,
      "end": 168.239,
      "text": "शेयर है वह पिछले 2 साल में 3% से 24% हुआ"
    },
    {
      "subtitle_id": 77,
      "start": 166.239,
      "end": 169.76,
      "text": "है यानी आठ गुना बढ़ा है। तो क्रेडिट पे"
    },
    {
      "subtitle_id": 78,
      "start": 168.239,
      "end": 171.76,
      "text": "ने यहां पर ल्च किया है एक सिंपल नो"
    },
    {
      "subtitle_id": 79,
      "start": 169.76,
      "end": 174.4,
      "text": "नॉनसेंस यूपीआई क्रेडिट कार्ड जो लाइफटाइम"
    },
    {
      "subtitle_id": 80,
      "start": 171.76,
      "end": 176.48,
      "text": "फ्री है और 2% का अनलिमिटेड कैशबैक आपको"
    },
    {
      "subtitle_id": 81,
      "start": 174.4,
      "end": 178.4,
      "text": "देती है यूपीआई स्पेंड पर और हां यह Yes"
    },
    {
      "subtitle_id": 82,
      "start": 176.48,
      "end": 180.4,
      "text": "बैंक रुपे क्रेडिट कार्ड लाइफटाइम के लिए"
    },
    {
      "subtitle_id": 83,
      "start": 178.4,
      "end": 182.4,
      "text": "आपको फ्री है। यहां पर ना कोई जॉइनिंग फी"
    },
    {
      "subtitle_id": 84,
      "start": 180.4,
      "end": 184.4,
      "text": "है ना ही कोई एनुअल फी। फी तो कुछ नहीं"
    },
    {
      "subtitle_id": 85,
      "start": 182.4,
      "end": 186.72,
      "text": "है। ऊपर से आपको मिलता है ₹1,000 का"
    },
    {
      "subtitle_id": 86,
      "start": 184.4,
      "end": 188.4,
      "text": "कैशबैक एज अ जॉइनिंग बोनस ऑन लिंकिंग द"
    },
    {
      "subtitle_id": 87,
      "start": 186.72,
      "end": 190.319,
      "text": "कार्ड टू क्रेडिट पे यूपीआई। और इस"
    },
    {
      "subtitle_id": 88,
      "start": 188.4,
      "end": 192.0,
      "text": "क्रेडिट कार्ड में आपको 50 डेज इंटरेस्ट"
    },
    {
      "subtitle_id": 89,
      "start": 190.319,
      "end": 193.92,
      "text": "फ्री पीरियड भी मिलता है। इस कार्ड पर जो"
    },
    {
      "subtitle_id": 90,
      "start": 192.0,
      "end": 195.84,
      "text": "रिवॉर्ड्स है वो डबल है। क्रेडिट पे की"
    },
    {
      "subtitle_id": 91,
      "start": 193.92,
      "end": 197.2,
      "text": "तरफ से आपको यूपीआई कैशबैक मिलता है और"
    },
    {
      "subtitle_id": 92,
      "start": 195.84,
      "end": 199.36,
      "text": "Yes बैंक की तरफ से आपको मिलते हैं"
    },
    {
      "subtitle_id": 93,
      "start": 197.2,
      "end": 202.08,
      "text": "रिवॉर्ड पॉइंट्स जब आप बाकी कैटेगरीज में"
    },
    {
      "subtitle_id": 94,
      "start": 199.36,
      "end": 204.0,
      "text": "स्पेंड करते हो। इसी के साथ आपको 1% फ्यूल"
    },
    {
      "subtitle_id": 95,
      "start": 202.08,
      "end": 205.519,
      "text": "सर्चार्ज व्यूअर भी मिलेगा। और जैसे कि आप"
    },
    {
      "subtitle_id": 96,
      "start": 204.0,
      "end": 207.36,
      "text": "स्क्रीन पर देख रहे हो क्रेडिट पे से"
    },
    {
      "subtitle_id": 97,
      "start": 205.519,
      "end": 209.76,
      "text": "मिलने वाले कैशबैक को यूज़ करके आप ढेरों"
    },
    {
      "subtitle_id": 98,
      "start": 207.36,
      "end": 211.68,
      "text": "सारी शॉपिंग, oटीt और बाकी एप्स पर"
    },
    {
      "subtitle_id": 99,
      "start": 209.76,
      "end": 213.84,
      "text": "डिस्काउंट के लिए भी उसे यूज़ कर सकते हो।"
    },
    {
      "subtitle_id": 100,
      "start": 211.68,
      "end": 216.0,
      "text": "जैसे Amazon और बाकी ऐप पर 6% तक का"
    },
    {
      "subtitle_id": 101,
      "start": 213.84,
      "end": 219.76,
      "text": "डिस्काउंट ले सकते हो। यूजिंग योर कैशबैक"
    },
    {
      "subtitle_id": 102,
      "start": 216.0,
      "end": 222.799,
      "text": "MNTR D्नी Hotstar पर 12% Dominos पर 24%,"
    },
    {
      "subtitle_id": 103,
      "start": 219.76,
      "end": 224.64,
      "text": "Sony Lew पर 60% और Swiggy 1 पर 100% तक"
    },
    {
      "subtitle_id": 104,
      "start": 222.799,
      "end": 226.0,
      "text": "का डिस्काउंट आप यहां पर ले सकते हो। और"
    },
    {
      "subtitle_id": 105,
      "start": 224.64,
      "end": 228.239,
      "text": "यही नहीं आने वाले टाइम में आप इनके"
    },
    {
      "subtitle_id": 106,
      "start": 226.0,
      "end": 229.92,
      "text": "कैशबैक्स अपनी यूटिलिटी बिल्स और बाकी कई"
    },
    {
      "subtitle_id": 107,
      "start": 228.239,
      "end": 231.599,
      "text": "सारी चीजों के लिए यूज कर सकते हो। तो"
    },
    {
      "subtitle_id": 108,
      "start": 229.92,
      "end": 233.599,
      "text": "इंतजार किस चीज का? अभी डिस्क्रिप्शन और"
    },
    {
      "subtitle_id": 109,
      "start": 231.599,
      "end": 235.519,
      "text": "कमेंट में दिए लिंक पर क्लिक करके क्रेडिट"
    },
    {
      "subtitle_id": 110,
      "start": 233.599,
      "end": 237.36,
      "text": "पे का ऐप डाउनलोड कीजिए और यूपीआई क्रेडिट"
    },
    {
      "subtitle_id": 111,
      "start": 235.519,
      "end": 239.599,
      "text": "कार्ड के लिए अप्लाई कीजिए। तो चलिए अब"
    },
    {
      "subtitle_id": 112,
      "start": 237.36,
      "end": 241.2,
      "text": "आगे बढ़ते हैं। अब यह ऐसे कौन से एफआई हैं"
    },
    {
      "subtitle_id": 113,
      "start": 239.599,
      "end": 243.04,
      "text": "जो इंडियन मार्केट में खरीदारी कर रहे"
    },
    {
      "subtitle_id": 114,
      "start": 241.2,
      "end": 246.08,
      "text": "हैं? तो आपको बता दूं कि इंडिया में ब्लैक"
    },
    {
      "subtitle_id": 115,
      "start": 243.04,
      "end": 247.68,
      "text": "रॉक, वेंगार्ड, जेपी मॉ्गन और कुछ ऐसी और"
    },
    {
      "subtitle_id": 116,
      "start": 246.08,
      "end": 249.2,
      "text": "अमेरिकन कंपनीज़ हैं जो हेवीली इंडियन"
    },
    {
      "subtitle_id": 117,
      "start": 247.68,
      "end": 251.36,
      "text": "मार्केट में इन्वेस्ट करती है। इनके कई"
    },
    {
      "subtitle_id": 118,
      "start": 249.2,
      "end": 253.68,
      "text": "सारे ऐसे इमर्जिंग मार्केट फंड्स हैं"
    },
    {
      "subtitle_id": 119,
      "start": 251.36,
      "end": 256.0,
      "text": "जिसमें बहुत बड़ा पैसा ग्लोबली इन्वेस्ट"
    },
    {
      "subtitle_id": 120,
      "start": 253.68,
      "end": 258.239,
      "text": "किया जाता है और फिर वो पैसा ये सारी"
    },
    {
      "subtitle_id": 121,
      "start": 256.0,
      "end": 259.519,
      "text": "कंपनीज़ जो इमर्जिंग कंट्रीज हैं इंडिया"
    },
    {
      "subtitle_id": 122,
      "start": 258.239,
      "end": 261.28,
      "text": "टाइप में उनमें इन्वेस्ट करते हैं।"
    },
    {
      "subtitle_id": 123,
      "start": 259.519,
      "end": 262.8,
      "text": "हालांकि एफआईएस का जो हर ट्रांजैक्शन का"
    },
    {
      "subtitle_id": 124,
      "start": 261.28,
      "end": 264.32,
      "text": "डाटा रहता है वो पब्लिकली अवेलेबल नहीं"
    },
    {
      "subtitle_id": 125,
      "start": 262.8,
      "end": 265.84,
      "text": "रहता। तो दैट इज व्हाई इट इज वेरी"
    },
    {
      "subtitle_id": 126,
      "start": 264.32,
      "end": 267.84,
      "text": "डिफिकल्ट टू फाइंड कि एक्सक्टली किसने"
    },
    {
      "subtitle_id": 127,
      "start": 265.84,
      "end": 269.52,
      "text": "कितना खरीदा है। पर ओवरऑल देखा जाए तो यही"
    },
    {
      "subtitle_id": 128,
      "start": 267.84,
      "end": 271.28,
      "text": "कि टॉप की जो बड़ी कंपनीज़ हैं यह इंडिया"
    },
    {
      "subtitle_id": 129,
      "start": 269.52,
      "end": 273.12,
      "text": "में फिलहाल खरीदारी करती हुई दिखाई दे रही"
    },
    {
      "subtitle_id": 130,
      "start": 271.28,
      "end": 275.84,
      "text": "है। लेकिन ये सारे एफआई आखिर इन्वेस्ट"
    },
    {
      "subtitle_id": 131,
      "start": 273.12,
      "end": 277.84,
      "text": "कहां पर कर रहे हैं? तो इन्होंने अपना 60%"
    },
    {
      "subtitle_id": 132,
      "start": 275.84,
      "end": 279.759,
      "text": "कैपिटल फाइनेंसियल सर्विज कंपनीज़ में"
    },
    {
      "subtitle_id": 133,
      "start": 277.84,
      "end": 282.0,
      "text": "बीएफएसआई में इन्वेस्ट किया है। अगर आप इस"
    },
    {
      "subtitle_id": 134,
      "start": 279.759,
      "end": 284.72,
      "text": "डाटा को देखें तो सेकंड हाफ ऑफ अप्रैल में"
    },
    {
      "subtitle_id": 135,
      "start": 282.0,
      "end": 287.04,
      "text": "एफआई ने ₹38,000 करोड़ इंडियन मार्केट में"
    },
    {
      "subtitle_id": 136,
      "start": 284.72,
      "end": 290.08,
      "text": "इन्वेस्ट किए। इन ₹38,000 करोड़ में से"
    },
    {
      "subtitle_id": 137,
      "start": 287.04,
      "end": 291.759,
      "text": "₹23,000 करोड़ सिर्फ और सिर्फ फाइनेंसियल"
    },
    {
      "subtitle_id": 138,
      "start": 290.08,
      "end": 294.08,
      "text": "स्टॉक्स में इन्वेस्ट किए गए हैं। जो कि"
    },
    {
      "subtitle_id": 139,
      "start": 291.759,
      "end": 295.68,
      "text": "लगभग उनकी टोटल इन्वेस्टमेंट का 60% आता"
    },
    {
      "subtitle_id": 140,
      "start": 294.08,
      "end": 297.52,
      "text": "है। और शायद यही कारण है कि निफ्टी"
    },
    {
      "subtitle_id": 141,
      "start": 295.68,
      "end": 299.759,
      "text": "फाइनेंसियल सर्विज इंडेक्स जो है वो सेकंड"
    },
    {
      "subtitle_id": 142,
      "start": 297.52,
      "end": 301.759,
      "text": "हाफ ऑफ अप्रैल में कुछ इस तरह उछला था।"
    },
    {
      "subtitle_id": 143,
      "start": 299.759,
      "end": 303.52,
      "text": "फाइनशियल्स के बाद कैपिटल गुड्स अगला"
    },
    {
      "subtitle_id": 144,
      "start": 301.759,
      "end": 305.6,
      "text": "सेक्टर जिसमें एफआई काफी इन्वेस्ट कर रहे"
    },
    {
      "subtitle_id": 145,
      "start": 303.52,
      "end": 308.24,
      "text": "हैं। फिर आता है ऑयल एंड गैस, टेलीकॉम"
    },
    {
      "subtitle_id": 146,
      "start": 305.6,
      "end": 310.4,
      "text": "सर्विज, कंज्यूमर सर्विज और उसके बाद ऑटो"
    },
    {
      "subtitle_id": 147,
      "start": 308.24,
      "end": 312.639,
      "text": "और उसके बाद आईटी सेक्टर। अब आप पूछेंगे"
    },
    {
      "subtitle_id": 148,
      "start": 310.4,
      "end": 314.32,
      "text": "कि सेक्टर ठीक है समझ गया स्टॉक्स कौन से"
    },
    {
      "subtitle_id": 149,
      "start": 312.639,
      "end": 315.919,
      "text": "हैं। अब देखिए इन्होंने कौन से शेयर्स में"
    },
    {
      "subtitle_id": 150,
      "start": 314.32,
      "end": 317.6,
      "text": "कितना खरीदा? यह तो जून क्वार्टर के जब"
    },
    {
      "subtitle_id": 151,
      "start": 315.919,
      "end": 319.68,
      "text": "रिजल्ट्स आएंगे तब इनके नए शेयर होल्डिंग"
    },
    {
      "subtitle_id": 152,
      "start": 317.6,
      "end": 321.36,
      "text": "पैटर्न्स में वो चीजें अपडेट होगी। अभी तो"
    },
    {
      "subtitle_id": 153,
      "start": 319.68,
      "end": 323.039,
      "text": "एग्जैक्टली उसके बारे में नहीं बता सकते।"
    },
    {
      "subtitle_id": 154,
      "start": 321.36,
      "end": 324.639,
      "text": "लेकिन अगर हम देखें पर्टिकुलरली"
    },
    {
      "subtitle_id": 155,
      "start": 323.039,
      "end": 326.479,
      "text": "फाइनेंसियल सर्विज सेक्टर में अगर हम ऐसी"
    },
    {
      "subtitle_id": 156,
      "start": 324.639,
      "end": 328.8,
      "text": "कंपनीज़ देखें जो सेकंड हाफ में काफी जिनके"
    },
    {
      "subtitle_id": 157,
      "start": 326.479,
      "end": 331.52,
      "text": "शेयर प्राइस ओली है उनमें HDFC Bank है,"
    },
    {
      "subtitle_id": 158,
      "start": 328.8,
      "end": 333.12,
      "text": "ICICI Bank है, Bajaj Finance और SBI L"
    },
    {
      "subtitle_id": 159,
      "start": 331.52,
      "end": 334.8,
      "text": "इंश्योरेंस है। हालांकि इनकी सारों की"
    },
    {
      "subtitle_id": 160,
      "start": 333.12,
      "end": 336.4,
      "text": "एग्जैक्ट फिगर और एग्जैक्ट नाम जून"
    },
    {
      "subtitle_id": 161,
      "start": 334.8,
      "end": 338.96,
      "text": "क्वार्टर के रिजल्ट के बाद हमें पता"
    },
    {
      "subtitle_id": 162,
      "start": 336.4,
      "end": 341.44,
      "text": "चलेंगे। अब आए तो हैं लेकिन आखिर वापस आए"
    },
    {
      "subtitle_id": 163,
      "start": 338.96,
      "end": 344.24,
      "text": "क्यों? जाते वक्त इन्होंने बहुत सारे कारण"
    },
    {
      "subtitle_id": 164,
      "start": 341.44,
      "end": 346.96,
      "text": "बताए थे कि इंडिया का जो रूपी है वो काफी"
    },
    {
      "subtitle_id": 165,
      "start": 344.24,
      "end": 348.72,
      "text": "तेजी से डिप्रिशिएट हो रहा है। सेकंड चीज"
    },
    {
      "subtitle_id": 166,
      "start": 346.96,
      "end": 350.4,
      "text": "इंडियन इकॉनमी उतनी स्टेबल नहीं लग रही"
    },
    {
      "subtitle_id": 167,
      "start": 348.72,
      "end": 352.639,
      "text": "है। यहां पर एक प्रॉब्लम उनको नजर आ रही"
    },
    {
      "subtitle_id": 168,
      "start": 350.4,
      "end": 354.32,
      "text": "है। थर्ड चीज चाइना में उनको इंडिया से"
    },
    {
      "subtitle_id": 169,
      "start": 352.639,
      "end": 356.96,
      "text": "ज्यादा पोटेंशियल दिख रहा था। इसलिए बहुत"
    },
    {
      "subtitle_id": 170,
      "start": 354.32,
      "end": 358.88,
      "text": "सारे एफआई ने उस टाइम चाइना में अपना पैसा"
    },
    {
      "subtitle_id": 171,
      "start": 356.96,
      "end": 360.4,
      "text": "डाल दिया था और यूएस में भी इंटरेस्ट रेट"
    },
    {
      "subtitle_id": 172,
      "start": 358.88,
      "end": 362.72,
      "text": "बढ़ गए थे। तो वहां पर भी एक अच्छी"
    },
    {
      "subtitle_id": 173,
      "start": 360.4,
      "end": 364.72,
      "text": "इन्वेस्टमेंट अपॉर्चुनिटीज़ काफी सारे एफआई"
    },
    {
      "subtitle_id": 174,
      "start": 362.72,
      "end": 367.199,
      "text": "के लिए आ गई थी। अगर यहां पर अगर देखें तो"
    },
    {
      "subtitle_id": 175,
      "start": 364.72,
      "end": 369.68,
      "text": "पिछले कुछ दिनों में जो इंडियन रूपी है वह"
    },
    {
      "subtitle_id": 176,
      "start": 367.199,
      "end": 372.16,
      "text": "कंपेरेटिवली काफी स्टेबल हुआ है। 87 के लो"
    },
    {
      "subtitle_id": 177,
      "start": 369.68,
      "end": 374.8,
      "text": "पर जाने के बाद यह अभी 85 के आसपास स्टेबल"
    },
    {
      "subtitle_id": 178,
      "start": 372.16,
      "end": 376.639,
      "text": "हुआ है। हालांकि कई सारे जो एफआई हैं वो"
    },
    {
      "subtitle_id": 179,
      "start": 374.8,
      "end": 379.12,
      "text": "हैेज करके इस रिस्क को मिटिगेट भी करते"
    },
    {
      "subtitle_id": 180,
      "start": 376.639,
      "end": 380.96,
      "text": "हैं। लेकिन फिर भी यह मैटर करता है उनके"
    },
    {
      "subtitle_id": 181,
      "start": 379.12,
      "end": 382.72,
      "text": "लिए। उसके बाद एक बहुत बड़ा रीज़न एफआईएस"
    },
    {
      "subtitle_id": 182,
      "start": 380.96,
      "end": 385.039,
      "text": "का था इंडिया से बाहर जाने का वो यह था कि"
    },
    {
      "subtitle_id": 183,
      "start": 382.72,
      "end": 386.72,
      "text": "उस टाइम एक बहुत बड़ा फंड इनफ्यूजन चाइना"
    },
    {
      "subtitle_id": 184,
      "start": 385.039,
      "end": 388.72,
      "text": "की गवर्नमेंट ने चाइना की इकॉनमी में किया"
    },
    {
      "subtitle_id": 185,
      "start": 386.72,
      "end": 390.88,
      "text": "था ताकि वहां पर और तेजी से ग्रोथ आए।"
    },
    {
      "subtitle_id": 186,
      "start": 388.72,
      "end": 392.96,
      "text": "इसलिए बहुत सारी एफआईएस वहां पर चले गए"
    },
    {
      "subtitle_id": 187,
      "start": 390.88,
      "end": 394.88,
      "text": "अपोरर्चुनिटीज ढूंढने। कई सारे इकोनॉमिस्ट"
    },
    {
      "subtitle_id": 188,
      "start": 392.96,
      "end": 398.08,
      "text": "ने यह बताया कि चाइना और तेजी से ग्रो"
    },
    {
      "subtitle_id": 189,
      "start": 394.88,
      "end": 401.199,
      "text": "करेगा और इंडिया की जो ग्रोथ है वो यहां"
    },
    {
      "subtitle_id": 190,
      "start": 398.08,
      "end": 403.84,
      "text": "से कम होने वाली है। लेकिन फिर ट्रंप साहब"
    },
    {
      "subtitle_id": 191,
      "start": 401.199,
      "end": 405.919,
      "text": "जग गए। उन्होंने फिर टेरिफ्स अनाउंस किए।"
    },
    {
      "subtitle_id": 192,
      "start": 403.84,
      "end": 408.319,
      "text": "फिर एक दिन सुबह उठने के बाद पता चलता था"
    },
    {
      "subtitle_id": 193,
      "start": 405.919,
      "end": 410.479,
      "text": "कि यूएस ने टेरिफ बढ़ा दिए। अगले दिन पता"
    },
    {
      "subtitle_id": 194,
      "start": 408.319,
      "end": 413.039,
      "text": "चलता था चाइना ने बढ़ा दिए। ऐसे इनका"
    },
    {
      "subtitle_id": 195,
      "start": 410.479,
      "end": 415.199,
      "text": "कंपटीशन चलता रहा। 150% तक ये बढ़ा। फिर"
    },
    {
      "subtitle_id": 196,
      "start": 413.039,
      "end": 417.919,
      "text": "जिसके चलते बाकी एफआई को फिर से पता चला"
    },
    {
      "subtitle_id": 197,
      "start": 415.199,
      "end": 420.88,
      "text": "कि चाइना में जाते हैं तो यह एक रिस्क है"
    },
    {
      "subtitle_id": 198,
      "start": 417.919,
      "end": 422.8,
      "text": "जो अलग से यहां पर है और फिर उनको पता चला"
    },
    {
      "subtitle_id": 199,
      "start": 420.88,
      "end": 424.72,
      "text": "कि मामला थोड़ा गड़बड़ वाला है। बेटर टू"
    },
    {
      "subtitle_id": 200,
      "start": 422.8,
      "end": 426.72,
      "text": "गेट आउट ऑफ हियर और फिर वो तुरंत चाइना की"
    },
    {
      "subtitle_id": 201,
      "start": 424.72,
      "end": 428.56,
      "text": "दीवार से जंप मार के भागते-भागते इंडियन"
    },
    {
      "subtitle_id": 202,
      "start": 426.72,
      "end": 430.8,
      "text": "मार्केट की तरफ आ गए और यहां से इनफ्लो"
    },
    {
      "subtitle_id": 203,
      "start": 428.56,
      "end": 432.8,
      "text": "अभी तेजी से बढ़ने लगा है। एक और रीज़न यह"
    },
    {
      "subtitle_id": 204,
      "start": 430.8,
      "end": 434.56,
      "text": "भी है कि जहां पर कई सारी जो बड़ी-बड़ी"
    },
    {
      "subtitle_id": 205,
      "start": 432.8,
      "end": 437.199,
      "text": "इंस्टीटशंस बता रहे थे कि इंडिया की ग्रोथ"
    },
    {
      "subtitle_id": 206,
      "start": 434.56,
      "end": 439.12,
      "text": "काफी धीमी होने वाली है। वहीं पर इन"
    },
    {
      "subtitle_id": 207,
      "start": 437.199,
      "end": 440.88,
      "text": "इनफैक्ट आईएमएफ ने भी और कई सारी"
    },
    {
      "subtitle_id": 208,
      "start": 439.12,
      "end": 442.639,
      "text": "बड़ी-बड़ी जो इंस्टीटशंस हैं फाइनेंसियल"
    },
    {
      "subtitle_id": 209,
      "start": 440.88,
      "end": 444.639,
      "text": "इंस्टीटशंस उन्होंने बताया कि इंडिया का"
    },
    {
      "subtitle_id": 210,
      "start": 442.639,
      "end": 446.639,
      "text": "जो ग्रोथ एक्सपेक्टेशन है वह मोर देन 6%"
    },
    {
      "subtitle_id": 211,
      "start": 444.639,
      "end": 448.319,
      "text": "का है। एफआई का बाहर जाने का जो मेन कारण"
    },
    {
      "subtitle_id": 212,
      "start": 446.639,
      "end": 450.24,
      "text": "था जिसके बारे में ज्यादा बात नहीं वो यह"
    },
    {
      "subtitle_id": 213,
      "start": 448.319,
      "end": 452.24,
      "text": "था कि उस टाइम मार्केट एक काफी ओवरवैल्यूड"
    },
    {
      "subtitle_id": 214,
      "start": 450.24,
      "end": 453.599,
      "text": "भी बन चुका था। बाइंग के लिए बहुत सारी"
    },
    {
      "subtitle_id": 215,
      "start": 452.24,
      "end": 455.44,
      "text": "ओपोरर्चुनिटीज मार्केट में नहीं थी।"
    },
    {
      "subtitle_id": 216,
      "start": 453.599,
      "end": 457.36,
      "text": "लगातार शेयर की प्राइसेस इतनी ज्यादा बढ़"
    },
    {
      "subtitle_id": 217,
      "start": 455.44,
      "end": 459.039,
      "text": "चुकी थी कि खरीदने के लिए कुछ ज्यादा"
    },
    {
      "subtitle_id": 218,
      "start": 457.36,
      "end": 461.44,
      "text": "चांसेस ही नहीं थे। लेकिन बीच में जो"
    },
    {
      "subtitle_id": 219,
      "start": 459.039,
      "end": 463.28,
      "text": "करेक्शन आया उससे अगेन तो आप भी अगर खुद"
    },
    {
      "subtitle_id": 220,
      "start": 461.44,
      "end": 465.68,
      "text": "भी देखेंगे तो आपको आज बहुत सारे शेयर्स"
    },
    {
      "subtitle_id": 221,
      "start": 463.28,
      "end": 468.16,
      "text": "बेटर वैल्यू्यूएशन पर नजर आएंगे कंपेयर टू"
    },
    {
      "subtitle_id": 222,
      "start": 465.68,
      "end": 470.24,
      "text": "सप्टेंबर अक्टूबर लेवल्स। तो ये भी चीज है"
    },
    {
      "subtitle_id": 223,
      "start": 468.16,
      "end": 472.08,
      "text": "कि लोगों को अभी जो एफआई है उसमें अभी"
    },
    {
      "subtitle_id": 224,
      "start": 470.24,
      "end": 474.08,
      "text": "डीआईआई भी देखेंगे तो उनका भी इनफ्लो काफी"
    },
    {
      "subtitle_id": 225,
      "start": 472.08,
      "end": 475.84,
      "text": "तेजी से बढ़ रहा है। रिटेल इन्वेस्टर्स भी"
    },
    {
      "subtitle_id": 226,
      "start": 474.08,
      "end": 477.84,
      "text": "धीरे-धीरे वापस आ रहे हैं क्योंकि उन्हें"
    },
    {
      "subtitle_id": 227,
      "start": 475.84,
      "end": 479.68,
      "text": "भी वो एक अच्छी अपोरर्चुनिटीज मार्केट में"
    },
    {
      "subtitle_id": 228,
      "start": 477.84,
      "end": 480.96,
      "text": "दिख रही है। और यही कारण है कि पिछले कुछ"
    },
    {
      "subtitle_id": 229,
      "start": 479.68,
      "end": 483.12,
      "text": "टाइम में 1 डेढ़ महीने में बहुत सारी"
    },
    {
      "subtitle_id": 230,
      "start": 480.96,
      "end": 484.96,
      "text": "कंपनीज़ के शेयर्स बहुत तेजी से बढ़े हैं।"
    },
    {
      "subtitle_id": 231,
      "start": 483.12,
      "end": 487.52,
      "text": "एक और चीज मैं आपको दिखाना चाहता हूं। यह"
    },
    {
      "subtitle_id": 232,
      "start": 484.96,
      "end": 488.8,
      "text": "आप चीज देखिए जब यूएस ने टेरीफ अनाउंस"
    },
    {
      "subtitle_id": 233,
      "start": 487.52,
      "end": 491.759,
      "text": "किया। हालांकि 90 दिनों के लिए इन्होंने"
    },
    {
      "subtitle_id": 234,
      "start": 488.8,
      "end": 493.919,
      "text": "रोक लगा दी उस पर। उसके बाद अब तक अगर हम"
    },
    {
      "subtitle_id": 235,
      "start": 491.759,
      "end": 496.0,
      "text": "शेयर प्राइसेस देखें या फिर अलग-अलग जो"
    },
    {
      "subtitle_id": 236,
      "start": 493.919,
      "end": 497.84,
      "text": "अलग-अलग मार्केट के अलग-अलग इंडाइससेस को"
    },
    {
      "subtitle_id": 237,
      "start": 496.0,
      "end": 499.52,
      "text": "देखें तो यूएस के इंडाइससेस आपको"
    },
    {
      "subtitle_id": 238,
      "start": 497.84,
      "end": 502.0,
      "text": "कंप्लीटली नेगेटिव में दिखेंगे। Dub Jos"
    },
    {
      "subtitle_id": 239,
      "start": 499.52,
      "end": 503.44,
      "text": "है या फिर SNP 500 है। चाइनीज़ इंडाइससेस"
    },
    {
      "subtitle_id": 240,
      "start": 502.0,
      "end": 505.44,
      "text": "भी आपको नेगेटिव में दिखेंगे। शघाई"
    },
    {
      "subtitle_id": 241,
      "start": 503.44,
      "end": 507.28,
      "text": "कंपोजिट ले लीजिए या फिर हैंगसिंग ले"
    },
    {
      "subtitle_id": 242,
      "start": 505.44,
      "end": 508.96,
      "text": "लीजिए। लेकिन यहां पर अगर आप सबसे टॉप में"
    },
    {
      "subtitle_id": 243,
      "start": 507.28,
      "end": 510.96,
      "text": "देखेंगे जिन्होंने सबसे बेस्ट रिटर्न्स"
    },
    {
      "subtitle_id": 244,
      "start": 508.96,
      "end": 513.2,
      "text": "दिए मार्केट में वो है ससेक्स और हमारा"
    },
    {
      "subtitle_id": 245,
      "start": 510.96,
      "end": 515.279,
      "text": "निफ्ट्टी 50। और जब टेरिफ भी लगाए गए तो"
    },
    {
      "subtitle_id": 246,
      "start": 513.2,
      "end": 517.12,
      "text": "इंडिया एक ऐसी पोजीशन पर था कि यहां पर"
    },
    {
      "subtitle_id": 247,
      "start": 515.279,
      "end": 519.44,
      "text": "इंडिया को ज्यादा फर्क नहीं पड़ रहा था।"
    },
    {
      "subtitle_id": 248,
      "start": 517.12,
      "end": 520.719,
      "text": "क्योंकि कंपेयर टू अदर्स इंडिया के जो"
    },
    {
      "subtitle_id": 249,
      "start": 519.44,
      "end": 522.56,
      "text": "इंडिया पर जो टेरिफ लगाए गए वो"
    },
    {
      "subtitle_id": 250,
      "start": 520.719,
      "end": 524.32,
      "text": "कंपेरेटिवली काफी कम थे। अभी फिलहाल की"
    },
    {
      "subtitle_id": 251,
      "start": 522.56,
      "end": 526.8,
      "text": "बात करें तो फिलहाल इंडिया के लिए वो 10%"
    },
    {
      "subtitle_id": 252,
      "start": 524.32,
      "end": 528.64,
      "text": "है और चाइना के लिए अभी भी 30% है। अब 90"
    },
    {
      "subtitle_id": 253,
      "start": 526.8,
      "end": 530.64,
      "text": "दिन बाद क्या होता है वो देखने के बाद और"
    },
    {
      "subtitle_id": 254,
      "start": 528.64,
      "end": 532.399,
      "text": "क्लेरिटी रहेगी। लेकिन फिलहाल तो यही कुछ"
    },
    {
      "subtitle_id": 255,
      "start": 530.64,
      "end": 533.839,
      "text": "नंबर्स हैं। यह जो एफआई का डाटा है इसकी"
    },
    {
      "subtitle_id": 256,
      "start": 532.399,
      "end": 536.08,
      "text": "लिंक मैं आपको डिस्क्रिप्शन में दे देता"
    },
    {
      "subtitle_id": 257,
      "start": 533.839,
      "end": 538.08,
      "text": "हूं। जहां से आप भी डेली बेसिस पर एफआई का"
    },
    {
      "subtitle_id": 258,
      "start": 536.08,
      "end": 539.839,
      "text": "जो इनफ्लो है उसका डाटा ट्रैक कर सकते हो"
    },
    {
      "subtitle_id": 259,
      "start": 538.08,
      "end": 541.519,
      "text": "और पता कर सकते हो कि एग्जैक्टली ये लोग"
    },
    {
      "subtitle_id": 260,
      "start": 539.839,
      "end": 543.36,
      "text": "क्या कर रहे हैं। लेकिन जाते-जाते आपको एक"
    },
    {
      "subtitle_id": 261,
      "start": 541.519,
      "end": 545.2,
      "text": "चीज भी और बताना चाहता हूं कि अभी इंडिया"
    },
    {
      "subtitle_id": 262,
      "start": 543.36,
      "end": 547.12,
      "text": "की जो इकॉनमी है वो सेल्फ रिलायंट होने"
    },
    {
      "subtitle_id": 263,
      "start": 545.2,
      "end": 548.88,
      "text": "लगी है। रिटेल इन्वेस्टर्स का इनफ्लो काफी"
    },
    {
      "subtitle_id": 264,
      "start": 547.12,
      "end": 550.32,
      "text": "बढ़ चुका है। डीआईआई भी बहुत यानी"
    },
    {
      "subtitle_id": 265,
      "start": 548.88,
      "end": 552.24,
      "text": "डोमेस्टिक इंस्टीट्यूशनल इन्वेस्टर्स"
    },
    {
      "subtitle_id": 266,
      "start": 550.32,
      "end": 553.839,
      "text": "हमारे हैं वो भी काफी स्ट्रांग बनते जा"
    },
    {
      "subtitle_id": 267,
      "start": 552.24,
      "end": 555.2,
      "text": "रहे हैं। तो अगर आपको इस मार्केट में कोई"
    },
    {
      "subtitle_id": 268,
      "start": 553.839,
      "end": 557.36,
      "text": "अच्छी अपॉर्चुनिटी मिलती है तो आप उन्हें"
    },
    {
      "subtitle_id": 269,
      "start": 555.2,
      "end": 558.959,
      "text": "कंसीडर कर सकते हो। लेकिन आपको फिलहाल अगर"
    },
    {
      "subtitle_id": 270,
      "start": 557.36,
      "end": 561.2,
      "text": "आप शॉर्ट टर्म के लिए अगर मार्केट को"
    },
    {
      "subtitle_id": 271,
      "start": 558.959,
      "end": 562.959,
      "text": "देखना चाहते हो तो आपको जिओपॉलिटिकल चीजों"
    },
    {
      "subtitle_id": 272,
      "start": 561.2,
      "end": 565.12,
      "text": "पर ध्यान देना पड़ेगा। जो टेरिफ्स हैं उन"
    },
    {
      "subtitle_id": 273,
      "start": 562.959,
      "end": 567.279,
      "text": "पर ध्यान देना पड़ेगा। ऑपरेशन सिंदूर किस"
    },
    {
      "subtitle_id": 274,
      "start": 565.12,
      "end": 568.959,
      "text": "तरह से आगे टर्न आउट करता है उस पर इन"
    },
    {
      "subtitle_id": 275,
      "start": 567.279,
      "end": 570.56,
      "text": "सारी चीजों पर आपका एक ध्यान होना चाहिए।"
    },
    {
      "subtitle_id": 276,
      "start": 568.959,
      "end": 572.24,
      "text": "जिस पर शॉर्ट टर्म में मार्केट निर्भर"
    },
    {
      "subtitle_id": 277,
      "start": 570.56,
      "end": 574.16,
      "text": "करेगा। ओवर अ लॉन्ग पीरियड ऑफ़ टाइम अगर"
    },
    {
      "subtitle_id": 278,
      "start": 572.24,
      "end": 576.88,
      "text": "अच्छी कंपनी है और आपको बेटर वैल्यू्यूएशन"
    },
    {
      "subtitle_id": 279,
      "start": 574.16,
      "end": 579.12,
      "text": "पे मिल रही है सो वहां पर आप बाय एंड"
    },
    {
      "subtitle_id": 280,
      "start": 576.88,
      "end": 580.72,
      "text": "होल्ड स्ट्रेटजी अप्लाई करके उसे होल्ड कर"
    },
    {
      "subtitle_id": 281,
      "start": 579.12,
      "end": 582.24,
      "text": "सकते हो फॉर अ लॉन्ग पीरियड ऑफ़ टाइम। तो"
    },
    {
      "subtitle_id": 282,
      "start": 580.72,
      "end": 584.16,
      "text": "आशा करता हूं कि एफआई के बारे में सारी"
    },
    {
      "subtitle_id": 283,
      "start": 582.24,
      "end": 585.6,
      "text": "इनसाइड आउट इनफेशन आप तक पहुंच गई होगी।"
    },
    {
      "subtitle_id": 284,
      "start": 584.16,
      "end": 587.12,
      "text": "अगर आप स्टॉक मार्केट में इन्वेस्ट करते"
    },
    {
      "subtitle_id": 285,
      "start": 585.6,
      "end": 589.12,
      "text": "हैं तो चैनल को सब्सक्राइब करना बिल्कुल"
    },
    {
      "subtitle_id": 286,
      "start": 587.12,
      "end": 590.56,
      "text": "ना भूलें। और हां, जाते-जाते क्रेडिट पे"
    },
    {
      "subtitle_id": 287,
      "start": 589.12,
      "end": 592.0,
      "text": "को जरूर चेक आउट कीजिए। बहुत ही बढ़िया"
    },
    {
      "subtitle_id": 288,
      "start": 590.56,
      "end": 593.279,
      "text": "प्लेटफार्म है जिसकी लिंक आपको नीचे"
    },
    {
      "subtitle_id": 289,
      "start": 592.0,
      "end": 595.12,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में मिल"
    },
    {
      "subtitle_id": 290,
      "start": 593.279,
      "end": 596.959,
      "text": "जाएगी। तो चेक आउट करके अपने एक्सपीरियंस"
    },
    {
      "subtitle_id": 291,
      "start": 595.12,
      "end": 600.12,
      "text": "जरूर बताना वि क्रेडिट पे। सी यू सून। टेक"
    },
    {
      "subtitle_id": 292,
      "start": 596.959,
      "end": 600.12,
      "text": "केयर। बाय-ब।"
    }
  ]
}