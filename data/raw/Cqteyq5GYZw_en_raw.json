    },
    {
      "subtitle_id": 260,
      "start": 528.08,
      "end": 532.32,
      "text": "प्रोग्राम्स करेंगे जिसके बाद अवेयरनेस"
    },
    {
      "subtitle_id": 261,
      "start": 530.08,
      "end": 534.0,
      "text": "में काफी ज्यादा बढ़ोतरी होगी तो करने के"
    },
    {
      "subtitle_id": 262,
      "start": 532.32,
      "end": 535.92,
      "text": "कई सारे ऑप्शंस हैं लेकिन गवर्नमेंट को"
    },
    {
      "subtitle_id": 263,
      "start": 534.0,
      "end": 537.76,
      "text": "फिलहाल एक ही चीज समझ रही है और वो है"
    },
    {
      "subtitle_id": 264,
      "start": 535.92,
      "end": 539.839,
      "text": "टैक्सेस बढ़ाना अब एगजैक्टली फाइनेंस"
    },
    {
      "subtitle_id": 265,
      "start": 537.76,
      "end": 542.04,
      "text": "मिनिस्टर क्या करना चाहती है वो वो तो बजट"
    },
    {
      "subtitle_id": 266,
      "start": 539.839,
      "end": 544.72,
      "text": "के दिन ही पता चलेगा जो जुलाई के आई थिंक"
    },
    {
      "subtitle_id": 267,
      "start": 542.04,
      "end": 546.399,
      "text": "थर्ड वीक के करीब रहेगा तो लेट्स सी तब तक"
    },
    {
      "subtitle_id": 268,
      "start": 544.72,
      "end": 548.279,
      "text": "क्या होता है लेकिन अगर ऐसा कुछ होता है"
    },
    {
      "subtitle_id": 269,
      "start": 546.399,
      "end": 550.44,
      "text": "तो दैट विल बी अ बिग ब्लो फॉर द होल"
    },
    {
      "subtitle_id": 270,
      "start": 548.279,
      "end": 552.68,
      "text": "मार्केट और इसमें पार्टिसिपेशन तो काफी"
    },
    {
      "subtitle_id": 271,
      "start": 550.44,
      "end": 554.44,
      "text": "ज्यादा गिरेगा और मुझे लगता है कि कई सारे"
    },
    {
      "subtitle_id": 272,
      "start": 552.68,
      "end": 556.12,
      "text": "लोग हैं इसके अगेंस्ट शायद प्रोटेस्ट भी"
    },
    {
      "subtitle_id": 273,
      "start": 554.44,
      "end": 557.959,
      "text": "करें तो आप अभी कमेंट में बताइए कि"
    },
    {
      "subtitle_id": 274,
      "start": 556.12,
      "end": 560.32,
      "text": "टैक्सेस बढ़ाने के बजाय गवर्नमेंट के पास"
    },
    {
      "subtitle_id": 275,
      "start": 557.959,
      "end": 562.12,
      "text": "वो कौन-कौन से ऑप्शंस है अलग-अलग जिससे"
    },
    {
      "subtitle_id": 276,
      "start": 560.32,
      "end": 564.12,
      "text": "छोटे-छोटे जो ट्रेडर्स हैं उन्हें एजुकेट"
    },
    {
      "subtitle_id": 277,
      "start": 562.12,
      "end": 566.079,
      "text": "किया जा सके उनके लॉसेस कम किए जा सकते"
    },
    {
      "subtitle_id": 278,
      "start": 564.12,
      "end": 567.68,
      "text": "हैं तो आज यहीं पर रुकते हैं जाते-जाते ू"
    },
    {
      "subtitle_id": 279,
      "start": 566.079,
      "end": 569.519,
      "text": "को जरूर चेक आउट कीजिए अपनी नई इनकम"
    },
    {
      "subtitle_id": 280,
      "start": 567.68,
      "end": 570.959,
      "text": "स्ट्रीम बनाइए और साथ ही इस वीडियो भी"
    },
    {
      "subtitle_id": 281,
      "start": 569.519,
      "end": 573.079,
      "text": "ज्यादा से ज्यादा लोगों तक शेयर कीजिए"
    },
    {
      "subtitle_id": 282,
      "start": 570.959,
      "end": 574.92,
      "text": "ताकि उन्हें भी ये पूरा मामला पता चले और"
    },
    {
      "subtitle_id": 283,
      "start": 573.079,
      "end": 576.6,
      "text": "हमने रिसेंटली काफी सारे पॉडकास्ट अपलोड"
    },
    {
      "subtitle_id": 284,
      "start": 574.92,
      "end": 578.72,
      "text": "किए हैं तो रिसेंट वीडियो में जाकर"
    },
    {
      "subtitle_id": 285,
      "start": 576.6,
      "end": 580.36,
      "text": "अलग-अलग पॉडकास्ट चेक करें जहां पर हमने"
    },
    {
      "subtitle_id": 286,
      "start": 578.72,
      "end": 583.079,
      "text": "ऐसे सक्सेसफुल लोगों को लाया है जो ज्यादा"
    },
    {
      "subtitle_id": 287,
      "start": 580.36,
      "end": 585.56,
      "text": "पॉपुलर नहीं है लेकिन उनके बिजनेसेस बहुत"
    },
    {
      "subtitle_id": 288,
      "start": 583.079,
      "end": 587.24,
      "text": "ज्यादा पॉपुलर है तो डू चेक इट आउट आपको"
    },
    {
      "subtitle_id": 289,
      "start": 585.56,
      "end": 591.56,
      "text": "काफी मजा आएगा तो मिलते हैं अगले वीडियो"
    },
    {
      "subtitle_id": 290,
      "start": 587.24,
      "end": 591.56,
      "text": "में थैंक यू सो मच फॉर वाचिंग दिस वीडियो"
    }
  ]
}