      "subtitle_id": 195,
      "start": 743.399,
      "end": 747.36,
      "text": "क्योंकि टा m को भी अभी इलेक्ट्रिक व्हीकल"
    },
    {
      "subtitle_id": 196,
      "start": 745.399,
      "end": 749.76,
      "text": "पर बहुत ज्यादा फोकस करने की जरूरत है सो"
    },
    {
      "subtitle_id": 197,
      "start": 747.36,
      "end": 751.8,
      "text": "अभी इनका जो रीलॉन्च और बाकी चीजें जो हो"
    },
    {
      "subtitle_id": 198,
      "start": 749.76,
      "end": 753.44,
      "text": "रही है जेएलआर में वही चीजें इलेक्ट्रिक"
    },
    {
      "subtitle_id": 199,
      "start": 751.8,
      "end": 755.16,
      "text": "व्हीकल में भी होने की जरूरत है क्योंकि"
    },
    {
      "subtitle_id": 200,
      "start": 753.44,
      "end": 757.36,
      "text": "एक बहुत बड़ा प्लेयर बहुत तबाही मचा रहा"
    },
    {
      "subtitle_id": 201,
      "start": 755.16,
      "end": 757.36,
      "text": "है"
    },
    {
      "subtitle_id": 202,
      "start": 779.279,
      "end": 783.44,
      "text": "है एक इंटरेस्टिंग डेटा आपको बता देता हूं"
    },
    {
      "subtitle_id": 203,
      "start": 781.04,
      "end": 786.68,
      "text": "कि अभी कुछ ही महीनों पहले टा m का ईवी"
    },
    {
      "subtitle_id": 204,
      "start": 783.44,
      "end": 789.12,
      "text": "में जो मार्केट शेयर था वोह 72 था और"
    },
    {
      "subtitle_id": 205,
      "start": 786.68,
      "end": 791.839,
      "text": "पिछले साल के मिडिल की बात करें तो दैट"
    },
    {
      "subtitle_id": 206,
      "start": 789.12,
      "end": 793.88,
      "text": "वाज अराउंड 84 पर अनडिस्प्यूटेड किंग था"
    },
    {
      "subtitle_id": 207,
      "start": 791.839,
      "end": 795.76,
      "text": "लेकिन धीरे-धीरे अभी चेंज हो रहा है वो"
    },
    {
      "subtitle_id": 208,
      "start": 793.88,
      "end": 797.88,
      "text": "मेंटेन करना है तो स्पेशल एफर्ट्स वहां पर"
    },
    {
      "subtitle_id": 209,
      "start": 795.76,
      "end": 799.48,
      "text": "लगेंगे तो मल्टीपल सेगमेंट्स ऑलरेडी टाटा"
    },
    {
      "subtitle_id": 210,
      "start": 797.88,
      "end": 802.079,
      "text": "मोट्स में है तो किस पर ध्यान दे किस पर"
    },
    {
      "subtitle_id": 211,
      "start": 799.48,
      "end": 804.079,
      "text": "नहीं ईवी अगर ये अलग से करते हैं तो वो"
    },
    {
      "subtitle_id": 212,
      "start": 802.079,
      "end": 806.279,
      "text": "इनके लिए गेम चेंजर हो सकता है ऐसा मेरा"
    },
    {
      "subtitle_id": 213,
      "start": 804.079,
      "end": 808.519,
      "text": "मानना है बाकी ओवरऑल फिर इनका पैसेंजर"
    },
    {
      "subtitle_id": 214,
      "start": 806.279,
      "end": 810.959,
      "text": "व्हीकल कितना भी बढ़े ईवी कितना भी बढ़े"
    },
    {
      "subtitle_id": 215,
      "start": 808.519,
      "end": 813.0,
      "text": "जहां से 66 पर आ रहा है वो चीज कंपनी को"
    },
    {
      "subtitle_id": 216,
      "start": 810.959,
      "end": 814.959,
      "text": "ड्रैक करती रहेगी तो इसलिए अगर आपको टा"
    },
    {
      "subtitle_id": 217,
      "start": 813.0,
      "end": 817.199,
      "text": "मोर से सही में पैसा बनाना है तो आपका"
    },
    {
      "subtitle_id": 218,
      "start": 814.959,
      "end": 819.0,
      "text": "फोकस ये रहना चाहिए कि जेएलआर में क्या हो"
    },
    {
      "subtitle_id": 219,
      "start": 817.199,
      "end": 821.04,
      "text": "रहा है रास्ते पे ज्यादा टा मोट्स की"
    },
    {
      "subtitle_id": 220,
      "start": 819.0,
      "end": 822.8,
      "text": "गाड़ियां दिखने से फायदा नहीं है जेएलआर"
    },
    {
      "subtitle_id": 221,
      "start": 821.04,
      "end": 824.959,
      "text": "में क्या हो रहा है उनका सेल्स बढ़ रहा"
    },
    {
      "subtitle_id": 222,
      "start": 822.8,
      "end": 827.959,
      "text": "हैगा जब उनका सेल्स बढ़ेगा तभी चीजें"
    },
    {
      "subtitle_id": 223,
      "start": 824.959,
      "end": 829.839,
      "text": "बदलेगी नहीं तो फिर यही चीजें आगे बढ़ती"
    },
    {
      "subtitle_id": 224,
      "start": 827.959,
      "end": 831.399,
      "text": "रहेगी तो फिलहाल हम यहीं पर रुकते हैं"
    },
    {
      "subtitle_id": 225,
      "start": 829.839,
      "end": 833.199,
      "text": "जेएलआर के नंबर्स आप ट्रैक करते रहिए"
    },
    {
      "subtitle_id": 226,
      "start": 831.399,
      "end": 835.16,
      "text": "क्वार्टर ऑन क्वार्टर वहीं से आपको रियल"
    },
    {
      "subtitle_id": 227,
      "start": 833.199,
      "end": 836.92,
      "text": "गेम पता चलेगा कि हो क्या रहा है अगर वहां"
    },
    {
      "subtitle_id": 228,
      "start": 835.16,
      "end": 839.12,
      "text": "पर नंबर्स में रेवेन्यू में वगैरह और कार"
    },
    {
      "subtitle_id": 229,
      "start": 836.92,
      "end": 842.839,
      "text": "के सेल्स में ज्यादा बढ़ोतरी नहीं होती है"
    },
    {
      "subtitle_id": 230,
      "start": 839.12,
      "end": 842.839,
      "text": "तो यही फिर चीजें tata-aig"
    },
    {
      "subtitle_id": 231,
      "start": 869.279,
      "end": 874.16,
      "text": "इस वीडियो का टॉपिक चलो बाय बाय टेक केयर"
    }
  ]
}