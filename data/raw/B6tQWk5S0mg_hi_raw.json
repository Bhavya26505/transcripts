  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.08,
      "end": 5.44,
      "text": "50 साल की मेहनत और 5 दिन में सब कुछ खाक।"
    },
    {
      "subtitle_id": 2,
      "start": 3.28,
      "end": 8.32,
      "text": "ऐसा ही कुछ हो रहा है दुबई के साथ। आज से"
    },
    {
      "subtitle_id": 3,
      "start": 5.44,
      "end": 10.96,
      "text": "करीब 50 साल पहले दुबई के रूलर शेख राशिद"
    },
    {
      "subtitle_id": 4,
      "start": 8.32,
      "end": 13.28,
      "text": "बिन सैयद अल मकतूम ने एक सपना देखा था।"
    },
    {
      "subtitle_id": 5,
      "start": 10.96,
      "end": 15.28,
      "text": "सपना था गल्फ में एक वर्ल्ड क्लास सिटी"
    },
    {
      "subtitle_id": 6,
      "start": 13.28,
      "end": 18.08,
      "text": "बनाने का। यह तब की बात है जब मिडिल ईस्ट"
    },
    {
      "subtitle_id": 7,
      "start": 15.28,
      "end": 20.32,
      "text": "की सारी कंट्रीज बस बंजर जमीन थी। दूर-दूर"
    },
    {
      "subtitle_id": 8,
      "start": 18.08,
      "end": 22.24,
      "text": "तक एक भी पक्का मकान नहीं होता था। मिडिल"
    },
    {
      "subtitle_id": 9,
      "start": 20.32,
      "end": 24.64,
      "text": "ईस्ट में वर्ल्ड क्लास सिटी बनाने के शेख"
    },
    {
      "subtitle_id": 10,
      "start": 22.24,
      "end": 26.4,
      "text": "अल मकतूम के विज़न को सुनकर उनका वेस्टर्न"
    },
    {
      "subtitle_id": 11,
      "start": 24.64,
      "end": 28.0,
      "text": "वर्ल्ड में काफी मजाक उड़ाया गया। लेकिन"
    },
    {
      "subtitle_id": 12,
      "start": 26.4,
      "end": 29.439,
      "text": "उन्होंने ठान लिया था कि वह दुबई को एक"
    },
    {
      "subtitle_id": 13,
      "start": 28.0,
      "end": 31.199,
      "text": "वर्ल्ड क्लास सिटी बनाएंगे। जहां"
    },
    {
      "subtitle_id": 14,
      "start": 29.439,
      "end": 33.04,
      "text": "बड़ी-बड़ी इमारतें होंगी, दुनिया भर के"
    },
    {
      "subtitle_id": 15,
      "start": 31.199,
      "end": 35.04,
      "text": "बिजनेसेस वहां पर अपने ऑफिसिसेस बनाएंगे"
    },
    {
      "subtitle_id": 16,
      "start": 33.04,
      "end": 37.52,
      "text": "और लोग अपनी छुट्टियां मनाने के लिए पेरिस"
    },
    {
      "subtitle_id": 17,
      "start": 35.04,
      "end": 40.48,
      "text": "या वियना की जगह दुबई जाएंगे। बिलियंस ऑफ"
    },
    {
      "subtitle_id": 18,
      "start": 37.52,
      "end": 42.8,
      "text": "डॉलर्स लगे, लाखों मजदूर लगे और 50 साल लग"
    },
    {
      "subtitle_id": 19,
      "start": 40.48,
      "end": 44.64,
      "text": "गए और तब जाकर दुबई दुनिया के सबसे मॉडर्न"
    },
    {
      "subtitle_id": 20,
      "start": 42.8,
      "end": 46.879,
      "text": "और सेफेस्ट सिटी बन गए। लेकिन अब लगता है"
    },
    {
      "subtitle_id": 21,
      "start": 44.64,
      "end": 48.96,
      "text": "कि पिछले कुछ दिनों से दुबई को नजर लग गई"
    },
    {
      "subtitle_id": 22,
      "start": 46.879,
      "end": 50.8,
      "text": "है। हालत ऐसी है कि वहां पिछले कुछ दिनों"
    },
    {
      "subtitle_id": 23,
      "start": 48.96,
      "end": 52.719,
      "text": "में आसमान में हजारों की संख्या में"
    },
    {
      "subtitle_id": 24,
      "start": 50.8,
      "end": 55.12,
      "text": "ड्रोंस और मिसाइल देखने को मिल रहे हैं और"
    },
    {
      "subtitle_id": 25,
      "start": 52.719,
      "end": 57.52,
      "text": "सोशल मीडिया पर कुछ लोग मजाक उड़ा रहे हैं"
    },
    {
      "subtitle_id": 26,
      "start": 55.12,
      "end": 59.359,
      "text": "कि हबीब भी डोंट कम टू दुबई। और यह भी"
    },
    {
      "subtitle_id": 27,
      "start": 57.52,
      "end": 61.76,
      "text": "स्पेकुलेशन किया जा रहा है कि शायद यह"
    },
    {
      "subtitle_id": 28,
      "start": 59.359,
      "end": 63.68,
      "text": "दुबई के एंड की शुरुआत है। तो कितना दम है"
    },
    {
      "subtitle_id": 29,
      "start": 61.76,
      "end": 66.08,
      "text": "इन दांव में? साथियों और भी कुछ सवाल है।"
    },
    {
      "subtitle_id": 30,
      "start": 63.68,
      "end": 67.68,
      "text": "जैसे क्यों ईरान दुबई पर सबसे ज्यादा अटैक"
    },
    {
      "subtitle_id": 31,
      "start": 66.08,
      "end": 70.159,
      "text": "कर रहा है? और कौन से वो दुबई के चार"
    },
    {
      "subtitle_id": 32,
      "start": 67.68,
      "end": 72.0,
      "text": "पिलर्स हैं जहां पर ईरान सबसे ज्यादा अटैक"
    },
    {
      "subtitle_id": 33,
      "start": 70.159,
      "end": 73.84,
      "text": "कर रहा है। इसका इंपैक्ट दुबई पर क्या"
    },
    {
      "subtitle_id": 34,
      "start": 72.0,
      "end": 75.84,
      "text": "होगा और इसका सबसे ज्यादा फायदा किसे"
    },
    {
      "subtitle_id": 35,
      "start": 73.84,
      "end": 77.68,
      "text": "होगा? क्या इंडिया को इसका फायदा होगा? और"
    },
    {
      "subtitle_id": 36,
      "start": 75.84,
      "end": 79.36,
      "text": "साथ ही आखिर में यह भी समझेंगे कि दुबई का"
    },
    {
      "subtitle_id": 37,
      "start": 77.68,
      "end": 81.28,
      "text": "फ्यूचर यहां से आगे कैसा होगा? तो इन"
    },
    {
      "subtitle_id": 38,
      "start": 79.36,
      "end": 82.96,
      "text": "ढेरों सारे सवालों के जवाब आपको मिलेंगे"
    },
    {
      "subtitle_id": 39,
      "start": 81.28,
      "end": 84.32,
      "text": "आज के इस वीडियो में। नमस्कार, मैं प्रसाद"
    },
    {
      "subtitle_id": 40,
      "start": 82.96,
      "end": 86.0,
      "text": "आपका आज के इस वीडियो में स्वागत करता"
    },
    {
      "subtitle_id": 41,
      "start": 84.32,
      "end": 87.6,
      "text": "हूं। आज के इस वीडियो के प्रायोजक हैं"
    },
    {
      "subtitle_id": 42,
      "start": 86.0,
      "end": 89.84,
      "text": "क्रेडिट पे जिनके बारे में हम वीडियो में"
    },
    {
      "subtitle_id": 43,
      "start": 87.6,
      "end": 91.52,
      "text": "आगे बात करेंगे। अब एक सवाल जो बार-बार"
    },
    {
      "subtitle_id": 44,
      "start": 89.84,
      "end": 93.68,
      "text": "मेरे ख्याल में आ रहा था जब मैं इस वीडियो"
    },
    {
      "subtitle_id": 45,
      "start": 91.52,
      "end": 96.0,
      "text": "की रिसर्च कर रहा था वो यह कि जब यह फाइट"
    },
    {
      "subtitle_id": 46,
      "start": 93.68,
      "end": 97.92,
      "text": "ईरान वर्सेस इजराइल एंड यूएस की है तो फिर"
    },
    {
      "subtitle_id": 47,
      "start": 96.0,
      "end": 99.6,
      "text": "वो मिसाइल्स और ड्रोन मिडिल ईस्ट के दूसरी"
    },
    {
      "subtitle_id": 48,
      "start": 97.92,
      "end": 101.92,
      "text": "कंट्रीज पर क्यों मार रहे हैं? और उसमें"
    },
    {
      "subtitle_id": 49,
      "start": 99.6,
      "end": 104.159,
      "text": "भी खास करके यूएई की सिटी दुबई पर क्यों?"
    },
    {
      "subtitle_id": 50,
      "start": 101.92,
      "end": 107.119,
      "text": "आप यह रिपोर्ट देखिए। ईरान अब तक यूएई पर"
    },
    {
      "subtitle_id": 51,
      "start": 104.159,
      "end": 109.439,
      "text": "लगभग 1660 मिसाइल्स और ड्रोन से अटैक कर"
    },
    {
      "subtitle_id": 52,
      "start": 107.119,
      "end": 111.2,
      "text": "चुका है। वो भी सिर्फ पहले एक हफ्ते में।"
    },
    {
      "subtitle_id": 53,
      "start": 109.439,
      "end": 113.6,
      "text": "और सब मिलाकर अगर देखा जाए तो जो जो भी"
    },
    {
      "subtitle_id": 54,
      "start": 111.2,
      "end": 116.159,
      "text": "टोटल अटैक्स हुए हैं उनमें से लगभग 50%"
    },
    {
      "subtitle_id": 55,
      "start": 113.6,
      "end": 118.32,
      "text": "अटैक्स यूएई पर कर दिए गए हैं खासकर दुबई"
    },
    {
      "subtitle_id": 56,
      "start": 116.159,
      "end": 120.24,
      "text": "पर। और वह भी कुछ चुनिंदा फेमस लोकेशनेशंस"
    },
    {
      "subtitle_id": 57,
      "start": 118.32,
      "end": 121.759,
      "text": "पर। तो आखिर ऐसा क्यों? तो देखिए ईरान"
    },
    {
      "subtitle_id": 58,
      "start": 120.24,
      "end": 124.0,
      "text": "यहां पर जो स्ट्रेटजी इस्तेमाल कर रहा है"
    },
    {
      "subtitle_id": 59,
      "start": 121.759,
      "end": 126.159,
      "text": "वो ये है कि हिट देम व्हेयर इट हर्ट्स द"
    },
    {
      "subtitle_id": 60,
      "start": 124.0,
      "end": 128.0,
      "text": "मोस्ट। मतलब वहां अटैक करो जहां दर्द सबसे"
    },
    {
      "subtitle_id": 61,
      "start": 126.159,
      "end": 130.319,
      "text": "ज्यादा और ये जो गल्फ की कंट्रीज हैं"
    },
    {
      "subtitle_id": 62,
      "start": 128.0,
      "end": 132.16,
      "text": "इन्हें सबसे ज्यादा दर्द कब होगा? जब उनकी"
    },
    {
      "subtitle_id": 63,
      "start": 130.319,
      "end": 133.92,
      "text": "इकॉनमी हिट हो जाए। अब सवाल ये है कि इन"
    },
    {
      "subtitle_id": 64,
      "start": 132.16,
      "end": 135.52,
      "text": "मिडिल ईस्ट कंट्रीज की इकॉनमी ज्यादातर"
    },
    {
      "subtitle_id": 65,
      "start": 133.92,
      "end": 137.92,
      "text": "किस चीज पर डिपेंड करती है? आप देख सकते"
    },
    {
      "subtitle_id": 66,
      "start": 135.52,
      "end": 140.319,
      "text": "हो स्क्रीन पर ऑइल पर। सऊदी अरेबिया की 40"
    },
    {
      "subtitle_id": 67,
      "start": 137.92,
      "end": 142.239,
      "text": "45% जीडीपी वहीं से आती है। ओमान ले लो,"
    },
    {
      "subtitle_id": 68,
      "start": 140.319,
      "end": 144.08,
      "text": "कुवैत ले लो, कतार ले लो, सब उसी पर"
    },
    {
      "subtitle_id": 69,
      "start": 142.239,
      "end": 145.599,
      "text": "डिपेंडेंट है। लेकिन दुबई के साथ प्रॉब्लम"
    },
    {
      "subtitle_id": 70,
      "start": 144.08,
      "end": 147.68,
      "text": "कुछ और है। क्या आपको पता है कि दुबई की"
    },
    {
      "subtitle_id": 71,
      "start": 145.599,
      "end": 151.52,
      "text": "इकॉनमी का कितना परसेंट ऑयल पर डिपेंड"
    },
    {
      "subtitle_id": 72,
      "start": 147.68,
      "end": 153.76,
      "text": "करता है? मात्र 0.5%। हां, 1% से भी कम।"
    },
    {
      "subtitle_id": 73,
      "start": 151.52,
      "end": 156.0,
      "text": "इसका मतलब साफ है कि अगर आप सऊदी, ओमान,"
    },
    {
      "subtitle_id": 74,
      "start": 153.76,
      "end": 157.76,
      "text": "कुवैत, कतार या इराक के ऑयल रिफाइनरीज या"
    },
    {
      "subtitle_id": 75,
      "start": 156.0,
      "end": 159.599,
      "text": "ऑयल साइट्स पर अटैक करते हो तो उनकी"
    },
    {
      "subtitle_id": 76,
      "start": 157.76,
      "end": 161.28,
      "text": "इकॉनमी डायरेक्टली इंपैक्ट हो जाएगी।"
    },
    {
      "subtitle_id": 77,
      "start": 159.599,
      "end": 162.48,
      "text": "लेकिन यह चीज आप दुबई के साथ नहीं कर सकते"
    },
    {
      "subtitle_id": 78,
      "start": 161.28,
      "end": 164.4,
      "text": "क्योंकि उन्हें उससे कुछ फर्क नहीं"
    },
    {
      "subtitle_id": 79,
      "start": 162.48,
      "end": 166.239,
      "text": "पड़ेगा। और फिर इसीलिए दुबई को अलग-अलग"
    },
    {
      "subtitle_id": 80,
      "start": 164.4,
      "end": 168.239,
      "text": "तरीके से अटैक किया जा रहा है क्योंकि जो"
    },
    {
      "subtitle_id": 81,
      "start": 166.239,
      "end": 170.0,
      "text": "दुबई है यह बाकी मिडिल ईस्ट कंट्रीज से"
    },
    {
      "subtitle_id": 82,
      "start": 168.239,
      "end": 171.76,
      "text": "बिल्कुल अलग है। वीडियो में आगे बढ़ने से"
    },
    {
      "subtitle_id": 83,
      "start": 170.0,
      "end": 173.68,
      "text": "पहले मेरा आपसे एक सवाल है कि क्या आप"
    },
    {
      "subtitle_id": 84,
      "start": 171.76,
      "end": 176.239,
      "text": "पेमेंट करने के लिए यूपीआई का इस्तेमाल"
    },
    {
      "subtitle_id": 85,
      "start": 173.68,
      "end": 178.4,
      "text": "करते हो? अगर हां तो मेरे पास आपके लिए एक"
    },
    {
      "subtitle_id": 86,
      "start": 176.239,
      "end": 180.64,
      "text": "इंटरेस्टिंग ऑफर है। क्रेडिट Pay ने लांच"
    },
    {
      "subtitle_id": 87,
      "start": 178.4,
      "end": 182.879,
      "text": "किया है क्रेडिट Pay Yes Bank एस कार्ड जो"
    },
    {
      "subtitle_id": 88,
      "start": 180.64,
      "end": 185.12,
      "text": "एक लाइफट फ्री क्रेडिट कार्ड है। मतलब कि"
    },
    {
      "subtitle_id": 89,
      "start": 182.879,
      "end": 187.68,
      "text": "ना जॉइनिंग फी ना ही कोई एनुअल फी और सबसे"
    },
    {
      "subtitle_id": 90,
      "start": 185.12,
      "end": 190.239,
      "text": "अच्छी बात जैसे ही आप इस कार्ड को यूपीआई"
    },
    {
      "subtitle_id": 91,
      "start": 187.68,
      "end": 192.319,
      "text": "से लिंक करते हो आपको ₹1000 को जॉइनिंग"
    },
    {
      "subtitle_id": 92,
      "start": 190.239,
      "end": 194.159,
      "text": "कैशबैक बोनस भी मिलता है। और सबसे अच्छी"
    },
    {
      "subtitle_id": 93,
      "start": 192.319,
      "end": 196.239,
      "text": "बात यह है कि यह एक ऐसा यूपीआई क्रेडिट"
    },
    {
      "subtitle_id": 94,
      "start": 194.159,
      "end": 198.4,
      "text": "कार्ड है जो ₹10 के ट्रांजैक्शन पर भी"
    },
    {
      "subtitle_id": 95,
      "start": 196.239,
      "end": 200.319,
      "text": "आपको कैशबैक देता है। लेकिन इस कार्ड का"
    },
    {
      "subtitle_id": 96,
      "start": 198.4,
      "end": 202.08,
      "text": "सबसे यूनिक फीचर यह है कि यह आपको"
    },
    {
      "subtitle_id": 97,
      "start": 200.319,
      "end": 204.08,
      "text": "कंफ्यूजिंग रिवॉर्ड पॉइंट्स नहीं देता है"
    },
    {
      "subtitle_id": 98,
      "start": 202.08,
      "end": 206.982,
      "text": "बल्कि आपको मिलता है डायरेक्ट कैशबैक।"
    },
    {
      "subtitle_id": 99,
      "start": 204.08,
      "end": 209.12,
      "text": "₹25,000 तक के मंथली पेमेंट्स पर फ्लैट 3%"
    },
    {
      "subtitle_id": 100,
      "start": 206.982,
      "end": 212.159,
      "text": "[संगीत] का कैशबैक और ₹25,000 के बाद"
    },
    {
      "subtitle_id": 101,
      "start": 209.12,
      "end": 214.959,
      "text": "फ्लैट 5% कैशबैक। और हां हर मंथ आप अपने"
    },
    {
      "subtitle_id": 102,
      "start": 212.159,
      "end": 217.68,
      "text": "कैशबैक का 10% 24 के डिजिटल गोल्ड में"
    },
    {
      "subtitle_id": 103,
      "start": 214.959,
      "end": 219.519,
      "text": "कन्वर्ट कर सकते हो ₹500 पर मंथ तक और"
    },
    {
      "subtitle_id": 104,
      "start": 217.68,
      "end": 221.76,
      "text": "बाकी कैशबैक से शॉपिंग डिस्काउंट्स ले"
    },
    {
      "subtitle_id": 105,
      "start": 219.519,
      "end": 224.959,
      "text": "सकते हो। जैसे Dig या Amazon, Flipkart पर"
    },
    {
      "subtitle_id": 106,
      "start": 221.76,
      "end": 228.4,
      "text": "7%, Swiggy, Myntra, Zomato पर 14% और"
    },
    {
      "subtitle_id": 107,
      "start": 224.959,
      "end": 230.959,
      "text": "Dominos, Uber और OTT पर अप टू 70%। अगर"
    },
    {
      "subtitle_id": 108,
      "start": 228.4,
      "end": 233.84,
      "text": "कैशबैक कम भी हो तब भी आप डिजिटल गोल्ड"
    },
    {
      "subtitle_id": 109,
      "start": 230.959,
      "end": 235.44,
      "text": "खरीदते वक्त 5% कैशबैक अर्न कर सकते हो।"
    },
    {
      "subtitle_id": 110,
      "start": 233.84,
      "end": 237.12,
      "text": "यूपीआई के अलावा अगर आप इस कार्ड को"
    },
    {
      "subtitle_id": 111,
      "start": 235.44,
      "end": 239.04,
      "text": "नॉर्मल क्रेडिट कार्ड की तरह इस्तेमाल"
    },
    {
      "subtitle_id": 112,
      "start": 237.12,
      "end": 241.28,
      "text": "करते हो तो Yes Bank रिवॉर्ड पॉइंट्स भी"
    },
    {
      "subtitle_id": 113,
      "start": 239.04,
      "end": 243.84,
      "text": "आपको मिलते हैं। ₹200 ऑनलाइन शॉपिंग पर 8"
    },
    {
      "subtitle_id": 114,
      "start": 241.28,
      "end": 245.599,
      "text": "पॉइंट्स, ₹200 की ऑफलाइन पर आपको फोर"
    },
    {
      "subtitle_id": 115,
      "start": 243.84,
      "end": 247.519,
      "text": "पॉइंट्स और यूटिलिटी इंश्योरेंस और"
    },
    {
      "subtitle_id": 116,
      "start": 245.599,
      "end": 250.159,
      "text": "गवर्नमेंट पेमेंट्स पर टू पॉइंट्स। साथ ही"
    },
    {
      "subtitle_id": 117,
      "start": 247.519,
      "end": 252.159,
      "text": "₹400 टू ₹5,000 के फ्यूल स्पेंड्स पर 1%"
    },
    {
      "subtitle_id": 118,
      "start": 250.159,
      "end": 254.159,
      "text": "फ्यूल सरचार्ज व्यूअर भी आपको मिलता है।"
    },
    {
      "subtitle_id": 119,
      "start": 252.159,
      "end": 255.92,
      "text": "और क्योंकि यह रुपए जेसीबी कार्ड है। तो"
    },
    {
      "subtitle_id": 120,
      "start": 254.159,
      "end": 258.799,
      "text": "एशियन कंट्रीज में इंटरनेशनल पीओएस"
    },
    {
      "subtitle_id": 121,
      "start": 255.92,
      "end": 261.44,
      "text": "स्पेंड्स पर 25% कैशबैक ऑफर भी आपको मिलते"
    },
    {
      "subtitle_id": 122,
      "start": 258.799,
      "end": 263.68,
      "text": "हैं अप्रैल 2026 से। और एक चीज जो इस"
    },
    {
      "subtitle_id": 123,
      "start": 261.44,
      "end": 265.6,
      "text": "कार्ड को बहुत आसान बनाती है वो यह है कि"
    },
    {
      "subtitle_id": 124,
      "start": 263.68,
      "end": 267.84,
      "text": "ऑनबोर्डिंग से लेकर कार्ड मैनेजमेंट और"
    },
    {
      "subtitle_id": 125,
      "start": 265.6,
      "end": 269.919,
      "text": "बिल पेमेंट तक। सब कुछ क्रेडिट पे ऐप के"
    },
    {
      "subtitle_id": 126,
      "start": 267.84,
      "end": 271.52,
      "text": "अंदर ही सिमलेसली हो जाता है। अगर आप भी"
    },
    {
      "subtitle_id": 127,
      "start": 269.919,
      "end": 272.88,
      "text": "डेली यूपीआई इस्तेमाल करते हो तो"
    },
    {
      "subtitle_id": 128,
      "start": 271.52,
      "end": 274.88,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में दी गई"
    },
    {
      "subtitle_id": 129,
      "start": 272.88,
      "end": 276.479,
      "text": "लिंक पर क्लिक करके क्रेडिट पे एप डाउनलोड"
    },
    {
      "subtitle_id": 130,
      "start": 274.88,
      "end": 278.24,
      "text": "करके Yes Bank एस क्रेडिट कार्ड के लिए"
    },
    {
      "subtitle_id": 131,
      "start": 276.479,
      "end": 279.759,
      "text": "अप्लाई कीजिए। बस एक चीज मेक श्योर कीजिए"
    },
    {
      "subtitle_id": 132,
      "start": 278.24,
      "end": 281.52,
      "text": "कि क्रेडिट कार्ड की वजह से ज्यादा"
    },
    {
      "subtitle_id": 133,
      "start": 279.759,
      "end": 283.199,
      "text": "स्पेंडिंग की हैबिट्स मत लगाइए। चलिए"
    },
    {
      "subtitle_id": 134,
      "start": 281.52,
      "end": 285.6,
      "text": "बढ़ते हैं वीडियो की तरफ। अब आते हैं अगले"
    },
    {
      "subtitle_id": 135,
      "start": 283.199,
      "end": 287.84,
      "text": "सवाल पर यानी चार पिलर्स पर। तो अगर दुबई"
    },
    {
      "subtitle_id": 136,
      "start": 285.6,
      "end": 290.32,
      "text": "की इकॉनमी के चार पिलर्स अगर देखे जाए तो"
    },
    {
      "subtitle_id": 137,
      "start": 287.84,
      "end": 292.8,
      "text": "पहला है ट्रेड जहां से उनकी इकॉनमी का 26"
    },
    {
      "subtitle_id": 138,
      "start": 290.32,
      "end": 295.36,
      "text": "टू 27% आता है। तो देखिए दुबई की जो"
    },
    {
      "subtitle_id": 139,
      "start": 292.8,
      "end": 297.28,
      "text": "जीडीपी है लगभग 96 बिलियन डॉलर के आसपास"
    },
    {
      "subtitle_id": 140,
      "start": 295.36,
      "end": 299.199,
      "text": "की है जिसमें सबसे ज्यादा हिस्सा आता है"
    },
    {
      "subtitle_id": 141,
      "start": 297.28,
      "end": 300.72,
      "text": "ट्रेड का जिसमें होलसेल ट्रेड और रिटेल"
    },
    {
      "subtitle_id": 142,
      "start": 299.199,
      "end": 302.32,
      "text": "ट्रेड दोनों इंक्लूड है। थोड़ा अगर आपको"
    },
    {
      "subtitle_id": 143,
      "start": 300.72,
      "end": 304.56,
      "text": "कंफ्यूजिंग लग रहा है तो आसान करता हूं एक"
    },
    {
      "subtitle_id": 144,
      "start": 302.32,
      "end": 306.479,
      "text": "शब्दों में कि दुबई की जीडीपी का 30%"
    },
    {
      "subtitle_id": 145,
      "start": 304.56,
      "end": 308.16,
      "text": "ट्रेड से आता है। चलिए इसे आपको एक सिंपल"
    },
    {
      "subtitle_id": 146,
      "start": 306.479,
      "end": 310.32,
      "text": "एग्जांपल के साथ बताता हूं। तो देखा जाए"
    },
    {
      "subtitle_id": 147,
      "start": 308.16,
      "end": 312.32,
      "text": "तो दुबई दुनिया की एक बहुत बड़ी मंडी है।"
    },
    {
      "subtitle_id": 148,
      "start": 310.32,
      "end": 314.4,
      "text": "जैसे आप सब्जी लेने जाते हो और एक ही"
    },
    {
      "subtitle_id": 149,
      "start": 312.32,
      "end": 316.08,
      "text": "सब्जी मंडी में आपको तरह-तरह की सब्जियां"
    },
    {
      "subtitle_id": 150,
      "start": 314.4,
      "end": 317.919,
      "text": "मिल जाती है। पर क्या वो सब्जी मंडी के"
    },
    {
      "subtitle_id": 151,
      "start": 316.08,
      "end": 320.0,
      "text": "अंदर उगती है? नहीं। वो सब्जी अलग-अलग"
    },
    {
      "subtitle_id": 152,
      "start": 317.919,
      "end": 322.32,
      "text": "जगहों से लाई जाती है और मंडी में बेची"
    },
    {
      "subtitle_id": 153,
      "start": 320.0,
      "end": 324.08,
      "text": "जाती है। बिल्कुल इसी तरह दुबई भी एक"
    },
    {
      "subtitle_id": 154,
      "start": 322.32,
      "end": 325.68,
      "text": "ग्लोबल मंडी है। यानी कि दुबई में कोई"
    },
    {
      "subtitle_id": 155,
      "start": 324.08,
      "end": 327.759,
      "text": "एक्चुअल मैन्युफैक्चरिंग नहीं हो रही है।"
    },
    {
      "subtitle_id": 156,
      "start": 325.68,
      "end": 329.52,
      "text": "वहां पर होती है ट्रेडिंग। दुनिया भर की"
    },
    {
      "subtitle_id": 157,
      "start": 327.759,
      "end": 331.6,
      "text": "अलग-अलग चीजें यहां आती है। चाइना से"
    },
    {
      "subtitle_id": 158,
      "start": 329.52,
      "end": 333.44,
      "text": "इलेक्ट्रॉनिक गुड्स, जापान से कार, यूरोप"
    },
    {
      "subtitle_id": 159,
      "start": 331.6,
      "end": 335.039,
      "text": "से मशीनरीज, अफ्रीका से गोल्ड और"
    },
    {
      "subtitle_id": 160,
      "start": 333.44,
      "end": 336.72,
      "text": "डायमंड्स, बांग्लादेश से गारमेंट्स और"
    },
    {
      "subtitle_id": 161,
      "start": 335.039,
      "end": 338.639,
      "text": "इंडिया से फार्मा प्रोडक्ट्स। यानी कि"
    },
    {
      "subtitle_id": 162,
      "start": 336.72,
      "end": 340.8,
      "text": "दुबई में ज्यादा कुछ बनता नहीं है। दुबई"
    },
    {
      "subtitle_id": 163,
      "start": 338.639,
      "end": 342.4,
      "text": "में माल आता है। वहां पर वह माल अलग-अलग"
    },
    {
      "subtitle_id": 164,
      "start": 340.8,
      "end": 344.16,
      "text": "वेयर हाउसेस में स्टोर किया जाता है और"
    },
    {
      "subtitle_id": 165,
      "start": 342.4,
      "end": 346.0,
      "text": "वहां पर दुनिया भर की कंट्रीज में वह"
    },
    {
      "subtitle_id": 166,
      "start": 344.16,
      "end": 348.639,
      "text": "पहुंचाया जाता है। एक प्रैक्टिकल एग्जांपल"
    },
    {
      "subtitle_id": 167,
      "start": 346.0,
      "end": 350.16,
      "text": "बताऊं तो देखिए दुबई दुनिया के सबसे बड़े"
    },
    {
      "subtitle_id": 168,
      "start": 348.639,
      "end": 352.24,
      "text": "गोल्ड ट्रेडिंग सेंटर्स में से एक है।"
    },
    {
      "subtitle_id": 169,
      "start": 350.16,
      "end": 353.68,
      "text": "गोल्ड पहले अफ्रीका से दुबई आता है। फिर"
    },
    {
      "subtitle_id": 170,
      "start": 352.24,
      "end": 355.199,
      "text": "यहां से दुनिया भर में एक्सपोर्ट किया"
    },
    {
      "subtitle_id": 171,
      "start": 353.68,
      "end": 356.96,
      "text": "जाता है। खासकर इंडिया का मेजॉरिटी"
    },
    {
      "subtitle_id": 172,
      "start": 355.199,
      "end": 359.28,
      "text": "इंपोर्टेड गोल्ड दुबई के थ्रू ही आता है।"
    },
    {
      "subtitle_id": 173,
      "start": 356.96,
      "end": 362.32,
      "text": "इसीलिए आज दुबई ग्लोबल फिजिकल गोल्ड ट्रेड"
    },
    {
      "subtitle_id": 174,
      "start": 359.28,
      "end": 364.639,
      "text": "का लगभग 25 टू 30% हैंडल करता है। और इसी"
    },
    {
      "subtitle_id": 175,
      "start": 362.32,
      "end": 366.56,
      "text": "वजह से दुबई को सिटी ऑफ गोल्ड भी कहा जाता"
    },
    {
      "subtitle_id": 176,
      "start": 364.639,
      "end": 368.88,
      "text": "है। अब प्रॉब्लम यह है कि यह चीजें ईरान"
    },
    {
      "subtitle_id": 177,
      "start": 366.56,
      "end": 371.28,
      "text": "को भी पता है। अब आप बताइए कि अगर ईरान को"
    },
    {
      "subtitle_id": 178,
      "start": 368.88,
      "end": 372.96,
      "text": "दुबई के ट्रेड बेस्ड इकॉनमी को डिसरप्ट"
    },
    {
      "subtitle_id": 179,
      "start": 371.28,
      "end": 374.8,
      "text": "करना है, खराब करना है तो उसका सबसे"
    },
    {
      "subtitle_id": 180,
      "start": 372.96,
      "end": 376.88,
      "text": "इफेक्टिव तरीका क्या होगा? पोर्ट्स पर"
    },
    {
      "subtitle_id": 181,
      "start": 374.8,
      "end": 378.96,
      "text": "अटैक करना। क्योंकि अगर पोर्ट्स बंद हो गए"
    },
    {
      "subtitle_id": 182,
      "start": 376.88,
      "end": 380.88,
      "text": "ना माल अंदर आ पाएगा ना माल बाहर जा"
    },
    {
      "subtitle_id": 183,
      "start": 378.96,
      "end": 382.8,
      "text": "पाएगा। और ईरान ने एग्जैक्टली यही किया।"
    },
    {
      "subtitle_id": 184,
      "start": 380.88,
      "end": 384.639,
      "text": "ईरान ने दुबई का जो मेन पोर्ट है जबल अली"
    },
    {
      "subtitle_id": 185,
      "start": 382.8,
      "end": 386.4,
      "text": "पोर्ट वहां पर अटैक किया और फिलहाल हालत"
    },
    {
      "subtitle_id": 186,
      "start": 384.639,
      "end": 388.8,
      "text": "यह है कि उन्हें उस पोर्ट को टेंपरेरी"
    },
    {
      "subtitle_id": 187,
      "start": 386.4,
      "end": 391.12,
      "text": "बेसिस पर क्लोज करना पड़ा। शिप्स वहां आने"
    },
    {
      "subtitle_id": 188,
      "start": 388.8,
      "end": 392.96,
      "text": "से अब डर रही है। दुबई का दूसरा सबसे बड़ा"
    },
    {
      "subtitle_id": 189,
      "start": 391.12,
      "end": 395.199,
      "text": "पिलर क्या है? अब दुबई एक ट्रेडिंग हब तो"
    },
    {
      "subtitle_id": 190,
      "start": 392.96,
      "end": 396.96,
      "text": "है ही और ट्रेडिंग के साथ-साथ दो बिज़नेसेस"
    },
    {
      "subtitle_id": 191,
      "start": 395.199,
      "end": 399.36,
      "text": "हमेशा कॉम्प्लीमेंट्री होते हैं। वो है"
    },
    {
      "subtitle_id": 192,
      "start": 396.96,
      "end": 400.88,
      "text": "बैंकिंग एंड फाइनेंसियल सर्विसेज। क्योंकि"
    },
    {
      "subtitle_id": 193,
      "start": 399.36,
      "end": 402.72,
      "text": "अगर ट्रेडिंग करनी हो तो बैंक्स और"
    },
    {
      "subtitle_id": 194,
      "start": 400.88,
      "end": 405.039,
      "text": "इंश्योरेंस सर्विसेज तो जरूर लगेंगे और"
    },
    {
      "subtitle_id": 195,
      "start": 402.72,
      "end": 406.8,
      "text": "इसीलिए दुबई में दुनिया के लगभग सभी मेजर"
    },
    {
      "subtitle_id": 196,
      "start": 405.039,
      "end": 408.56,
      "text": "बैंक्स की प्रेजेंस है। सिर्फ इंटरनेशनल"
    },
    {
      "subtitle_id": 197,
      "start": 406.8,
      "end": 410.319,
      "text": "बैंक्स ही नहीं इंडिया के कई सारी बैंक्स"
    },
    {
      "subtitle_id": 198,
      "start": 408.56,
      "end": 412.08,
      "text": "की ब्रांचेस भी आपको दुबई में मिल जाएगी।"
    },
    {
      "subtitle_id": 199,
      "start": 410.319,
      "end": 413.68,
      "text": "अब यहां पर ईरान क्या करेगा? तो फिजिकली"
    },
    {
      "subtitle_id": 200,
      "start": 412.08,
      "end": 415.12,
      "text": "इन बैंक्स पर अटैक करना तो पॉसिबल नहीं"
    },
    {
      "subtitle_id": 201,
      "start": 413.68,
      "end": 417.28,
      "text": "है। तो ईरान क्या कर रहा है? साइबर"
    },
    {
      "subtitle_id": 202,
      "start": 415.12,
      "end": 419.12,
      "text": "अटैक्स। वो इन बैंक्स पर साइबर अटैक्स कर"
    },
    {
      "subtitle_id": 203,
      "start": 417.28,
      "end": 420.8,
      "text": "रहे हैं ताकि बैंकिंग सिस्टम डिसरप्ट हो"
    },
    {
      "subtitle_id": 204,
      "start": 419.12,
      "end": 422.479,
      "text": "जाए। ट्रांजैक्शंस रुक जाए और ट्रेडिंग"
    },
    {
      "subtitle_id": 205,
      "start": 420.8,
      "end": 424.319,
      "text": "एक्टिविटीज में प्रॉब्लम्स क्रिएट हो।"
    },
    {
      "subtitle_id": 206,
      "start": 422.479,
      "end": 426.24,
      "text": "आपको नहीं पता तो आपको बता दूं कि ईरान"
    },
    {
      "subtitle_id": 207,
      "start": 424.319,
      "end": 428.24,
      "text": "साइबर अटैक्स में एक बहुत बड़ा प्लेयर है।"
    },
    {
      "subtitle_id": 208,
      "start": 426.24,
      "end": 429.919,
      "text": "तो यहां पर ईरान विदाउट फायरिंग अ सिंगल"
    },
    {
      "subtitle_id": 209,
      "start": 428.24,
      "end": 431.68,
      "text": "मिसाइल दुबई और मिडिल ईस्ट के पूरे"
    },
    {
      "subtitle_id": 210,
      "start": 429.919,
      "end": 433.919,
      "text": "फाइनेंस सेक्टर पर अटैक कर रहा है। अब"
    },
    {
      "subtitle_id": 211,
      "start": 431.68,
      "end": 436.16,
      "text": "इसके बाद दुबई का जो तीसरा पिलर है वो है"
    },
    {
      "subtitle_id": 212,
      "start": 433.919,
      "end": 438.319,
      "text": "ट्रांसपोर्ट एंड स्टोरेज जिसमें सबसे बड़ा"
    },
    {
      "subtitle_id": 213,
      "start": 436.16,
      "end": 440.319,
      "text": "हिस्सा एिएशन सेक्टर का है। जैसे कि हम सब"
    },
    {
      "subtitle_id": 214,
      "start": 438.319,
      "end": 442.24,
      "text": "जानते हैं कि दुबई के पास दुनिया के सबसे"
    },
    {
      "subtitle_id": 215,
      "start": 440.319,
      "end": 444.88,
      "text": "बड़ी एयरलाइंस में से एक है एमिरेट्स।"
    },
    {
      "subtitle_id": 216,
      "start": 442.24,
      "end": 446.639,
      "text": "एमिरेट्स लगातार पिछले कई सालों से बेस्ट"
    },
    {
      "subtitle_id": 217,
      "start": 444.88,
      "end": 448.479,
      "text": "एयरलाइन का खिताब पा रही है। और यह जो"
    },
    {
      "subtitle_id": 218,
      "start": 446.639,
      "end": 450.319,
      "text": "दुबई एयरपोर्ट है यह भी कोई छोटा-मोटा"
    },
    {
      "subtitle_id": 219,
      "start": 448.479,
      "end": 452.88,
      "text": "एयरपोर्ट नहीं है। यहां पर पिछले साल ही"
    },
    {
      "subtitle_id": 220,
      "start": 450.319,
      "end": 454.96,
      "text": "9.5 करोड़ पैसेंजर्स हैंडल किए गए जो कि"
    },
    {
      "subtitle_id": 221,
      "start": 452.88,
      "end": 456.72,
      "text": "हाईएस्ट इन द वर्ल्ड है सबसे ज्यादा। अब"
    },
    {
      "subtitle_id": 222,
      "start": 454.96,
      "end": 458.56,
      "text": "आप बताइए यहां पर ईरान का प्लान क्या है?"
    },
    {
      "subtitle_id": 223,
      "start": 456.72,
      "end": 460.88,
      "text": "पूरी तरह से इस सेक्टर को हैंडीकैप करना।"
    },
    {
      "subtitle_id": 224,
      "start": 458.56,
      "end": 462.639,
      "text": "कैसे? तो इसलिए ईरान ने कंटीन्यूअसली दुबई"
    },
    {
      "subtitle_id": 225,
      "start": 460.88,
      "end": 464.56,
      "text": "एयरपोर्ट्स पर अटैक किया। नतीजा दुबई"
    },
    {
      "subtitle_id": 226,
      "start": 462.639,
      "end": 466.319,
      "text": "इंटरनेशनल एयरपोर्ट पर फ्लाइट्स टेंपरेरी"
    },
    {
      "subtitle_id": 227,
      "start": 464.56,
      "end": 468.24,
      "text": "सस्पेंड करनी पड़ी। अभी भी मोस्ट ऑफ द"
    },
    {
      "subtitle_id": 228,
      "start": 466.319,
      "end": 470.08,
      "text": "फ्लाइट्स वहां पर ग्राउंडेड हैं। अब इसके"
    },
    {
      "subtitle_id": 229,
      "start": 468.24,
      "end": 472.639,
      "text": "बाद दुबई का जो चौथा पिलर है वह है"
    },
    {
      "subtitle_id": 230,
      "start": 470.08,
      "end": 474.24,
      "text": "रियलस्टेट जो कि क्लोज टू 7% ऑफ दुबई का"
    },
    {
      "subtitle_id": 231,
      "start": 472.639,
      "end": 475.759,
      "text": "जीडीपी है। दुबई में देखा जाए तो उनका"
    },
    {
      "subtitle_id": 232,
      "start": 474.24,
      "end": 477.52,
      "text": "रियलस्टेट सेक्टर बहुत तेजी से बढ़ रहा"
    },
    {
      "subtitle_id": 233,
      "start": 475.759,
      "end": 479.28,
      "text": "है। हर जगह आपको दुबई के रियलस्टेट की"
    },
    {
      "subtitle_id": 234,
      "start": 477.52,
      "end": 481.52,
      "text": "एडवर्टाइजमेंट मिल जाएगी। सोशल मीडिया पर"
    },
    {
      "subtitle_id": 235,
      "start": 479.28,
      "end": 483.28,
      "text": "मिस्टर साजन करके आते हैं कई बार और जब भी"
    },
    {
      "subtitle_id": 236,
      "start": 481.52,
      "end": 484.8,
      "text": "आप दुबई के लिए कोई फ्लाइट लोगे तो प्लेन"
    },
    {
      "subtitle_id": 237,
      "start": 483.28,
      "end": 486.879,
      "text": "में आपके सीट के सामने शायद आपने"
    },
    {
      "subtitle_id": 238,
      "start": 484.8,
      "end": 488.879,
      "text": "रियलस्टेट की ऐड जरूर देखी होगी और साथ ही"
    },
    {
      "subtitle_id": 239,
      "start": 486.879,
      "end": 490.639,
      "text": "आपने मुंबई पुणे जैसी सिटीज में इस तरह के"
    },
    {
      "subtitle_id": 240,
      "start": 488.879,
      "end": 492.16,
      "text": "बिलबोर्ड्स भी देखे होंगे। अभी कुछ ही"
    },
    {
      "subtitle_id": 241,
      "start": 490.639,
      "end": 494.4,
      "text": "टाइम पहले एक न्यूज़ भी आई थी कि वहां पर"
    },
    {
      "subtitle_id": 242,
      "start": 492.16,
      "end": 497.12,
      "text": "शाहरुख खान के नाम पर एक टावर भी बन रहा"
    },
    {
      "subtitle_id": 243,
      "start": 494.4,
      "end": 499.28,
      "text": "है। तो डाटा से जाए तो इनफैक्ट इंडियंस आर"
    },
    {
      "subtitle_id": 244,
      "start": 497.12,
      "end": 501.599,
      "text": "नंबर वन बायरर्स ऑफ दुबई रियलस्टेट राइट"
    },
    {
      "subtitle_id": 245,
      "start": 499.28,
      "end": 504.56,
      "text": "नाउ। पिछले सिर्फ एक साल में हम भारतीयों"
    },
    {
      "subtitle_id": 246,
      "start": 501.599,
      "end": 506.479,
      "text": "ने 95,000 करोड़ वर्थ ऑफ रियलस्टेट दुबई"
    },
    {
      "subtitle_id": 247,
      "start": 504.56,
      "end": 508.319,
      "text": "में खरीदी है। अब इस चौथे पिलर को भी अगर"
    },
    {
      "subtitle_id": 248,
      "start": 506.479,
      "end": 510.4,
      "text": "खराब करना है ईरान को तो वो क्या करेगा?"
    },
    {
      "subtitle_id": 249,
      "start": 508.319,
      "end": 512.959,
      "text": "तो उसने फेमस रेजिडेंशियल एरियाज पर अटैक"
    },
    {
      "subtitle_id": 250,
      "start": 510.4,
      "end": 515.519,
      "text": "करना शुरू किया। ईरान ने बुर्ज खलीफा पर"
    },
    {
      "subtitle_id": 251,
      "start": 512.959,
      "end": 517.76,
      "text": "अटैक करने की कोशिश की। जहां पर 900"
    },
    {
      "subtitle_id": 252,
      "start": 515.519,
      "end": 520.399,
      "text": "प्राइवेट रेजिडेंशियल यूनिट्स हैं। जिसमें"
    },
    {
      "subtitle_id": 253,
      "start": 517.76,
      "end": 522.8,
      "text": "से 150 इंडियंस ओन करते हैं। इसके अलावा"
    },
    {
      "subtitle_id": 254,
      "start": 520.399,
      "end": 524.8,
      "text": "कई सारे रेजिडेंशियल टॉवर्स जैसे कि मरीना"
    },
    {
      "subtitle_id": 255,
      "start": 522.8,
      "end": 526.56,
      "text": "टावर को भी ईरान ने अटैक किया। यानी कि"
    },
    {
      "subtitle_id": 256,
      "start": 524.8,
      "end": 528.56,
      "text": "ईरान इन्वेस्टर्स के मन में डर बिठाना"
    },
    {
      "subtitle_id": 257,
      "start": 526.56,
      "end": 530.32,
      "text": "चाहता है कि कोई दुबई के रियलस्टेट में"
    },
    {
      "subtitle_id": 258,
      "start": 528.56,
      "end": 532.08,
      "text": "इन्वेस्ट करने की हिम्मत ही ना करें। तो"
    },
    {
      "subtitle_id": 259,
      "start": 530.32,
      "end": 533.839,
      "text": "देखिए आपको दूर से लग रहा होगा कि ईरान"
    },
    {
      "subtitle_id": 260,
      "start": 532.08,
      "end": 535.92,
      "text": "रैंडमली कहीं पर भी मिसाइल या ड्रोन से"
    },
    {
      "subtitle_id": 261,
      "start": 533.839,
      "end": 537.68,
      "text": "अटैक कर रहा है। लेकिन ईरान का एक भी"
    },
    {
      "subtitle_id": 262,
      "start": 535.92,
      "end": 539.44,
      "text": "ड्रोन रैंडम नहीं है। हर ड्रोन एक"
    },
    {
      "subtitle_id": 263,
      "start": 537.68,
      "end": 541.44,
      "text": "प्लानिंग के साथ भेजा जा रहा है। दे आर"
    },
    {
      "subtitle_id": 264,
      "start": 539.44,
      "end": 543.68,
      "text": "हिटिंग ईच गल कंट्री वेयर इट हर्ट्स द"
    },
    {
      "subtitle_id": 265,
      "start": 541.44,
      "end": 545.68,
      "text": "मोस्ट। सऊदी की इकॉनमी ऑयल पर है तो इनकी"
    },
    {
      "subtitle_id": 266,
      "start": 543.68,
      "end": 547.92,
      "text": "रिफाइनरीज पर अटैक करो। इनकी इकॉनमी"
    },
    {
      "subtitle_id": 267,
      "start": 545.68,
      "end": 549.76,
      "text": "ऑटोमेटिक बर्बाद हो जाएगी। दुबई की इकॉनमी"
    },
    {
      "subtitle_id": 268,
      "start": 547.92,
      "end": 551.839,
      "text": "ट्रेड पर है तो फोर्ट पर ड्रोन मारो।"
    },
    {
      "subtitle_id": 269,
      "start": 549.76,
      "end": 554.08,
      "text": "बैंक्स पर है तो साइबर अटैक करो। एिएशन पर"
    },
    {
      "subtitle_id": 270,
      "start": 551.839,
      "end": 556.16,
      "text": "है तो एयरपोर्ट पर अटैक करो और रियलस्टेट"
    },
    {
      "subtitle_id": 271,
      "start": 554.08,
      "end": 558.56,
      "text": "पर है तो फेमस रेजिडेंशियल बिल्डिंग्स और"
    },
    {
      "subtitle_id": 272,
      "start": 556.16,
      "end": 560.399,
      "text": "होटल्स पर अटैक करो। नथिंग इज इत्तफाक"
    },
    {
      "subtitle_id": 273,
      "start": 558.56,
      "end": 562.08,
      "text": "हियर। और इस हर एक्शन का रिजल्ट अब"
    },
    {
      "subtitle_id": 274,
      "start": 560.399,
      "end": 563.839,
      "text": "धीरे-धीरे ईरान को देखने मिल रहा है।"
    },
    {
      "subtitle_id": 275,
      "start": 562.08,
      "end": 566.08,
      "text": "पोर्ट पर अटैक करने के बाद दुबई को अपना"
    },
    {
      "subtitle_id": 276,
      "start": 563.839,
      "end": 567.92,
      "text": "जो सबसे बड़ा पोर्ट है उसे बंद करना पड़ा।"
    },
    {
      "subtitle_id": 277,
      "start": 566.08,
      "end": 570.24,
      "text": "इसके बाद बैंकिंग इंडस्ट्री की बात करें"
    },
    {
      "subtitle_id": 278,
      "start": 567.92,
      "end": 572.16,
      "text": "तो काफी सारी बैंक्स दुबई में अपने फ्यूचर"
    },
    {
      "subtitle_id": 279,
      "start": 570.24,
      "end": 574.8,
      "text": "एक्सपेंशन प्लांस रिकंसीडर कर रहे हैं।"
    },
    {
      "subtitle_id": 280,
      "start": 572.16,
      "end": 576.48,
      "text": "जिसमें से एक जेपी मॉ्गन भी है। एिएशन की"
    },
    {
      "subtitle_id": 281,
      "start": 574.8,
      "end": 578.88,
      "text": "बात करें तो फिलहाल दुबई एयरपोर्ट बिल्कुल"
    },
    {
      "subtitle_id": 282,
      "start": 576.48,
      "end": 580.72,
      "text": "शट है। मोस्ट ऑफ द फ्लाइट्स आर ग्राउंडेड।"
    },
    {
      "subtitle_id": 283,
      "start": 578.88,
      "end": 583.44,
      "text": "और वहीं रियलस्टेट की बात करें तो दुबई"
    },
    {
      "subtitle_id": 284,
      "start": 580.72,
      "end": 585.92,
      "text": "रियलस्टेट इंडेक्स सिर्फ एक दिन में 20%"
    },
    {
      "subtitle_id": 285,
      "start": 583.44,
      "end": 587.68,
      "text": "गिर चुका है। और इसी बीच ईरान ने Amazon"
    },
    {
      "subtitle_id": 286,
      "start": 585.92,
      "end": 589.76,
      "text": "के एक डाटा सेंटर पर भी ड्रोन अटैक किया"
    },
    {
      "subtitle_id": 287,
      "start": 587.68,
      "end": 592.399,
      "text": "है। दिस इज अगेन अ बैड न्यूज़ फॉर बिनेसेस"
    },
    {
      "subtitle_id": 288,
      "start": 589.76,
      "end": 594.32,
      "text": "एंड रियलस्टेट ऑफ दुबई। अब सबसेेंट सवाल"
    },
    {
      "subtitle_id": 289,
      "start": 592.399,
      "end": 596.0,
      "text": "यह आता है कि इस चीज का फायदा कैसे हो"
    },
    {
      "subtitle_id": 290,
      "start": 594.32,
      "end": 598.08,
      "text": "सकता है? तो देखिए दुबई स्ट्रेटेजिकली"
    },
    {
      "subtitle_id": 291,
      "start": 596.0,
      "end": 600.08,
      "text": "देखा जाए तो बहुत स्ट्रांग लोकेशन पर है।"
    },
    {
      "subtitle_id": 292,
      "start": 598.08,
      "end": 601.92,
      "text": "यहां से मिडिल ईस्ट पास है। अफ्रीका भी"
    },
    {
      "subtitle_id": 293,
      "start": 600.08,
      "end": 603.76,
      "text": "ज्यादा दूर नहीं है और इंडिया भी काफी"
    },
    {
      "subtitle_id": 294,
      "start": 601.92,
      "end": 605.36,
      "text": "करीब है। तो दुनिया वेट करेगी कि कब यह"
    },
    {
      "subtitle_id": 295,
      "start": 603.76,
      "end": 607.519,
      "text": "वॉर खत्म होता है। अब इसमें भी तीन"
    },
    {
      "subtitle_id": 296,
      "start": 605.36,
      "end": 609.2,
      "text": "सिनेरियो है। अगर ईरान और यूएस के बीच"
    },
    {
      "subtitle_id": 297,
      "start": 607.519,
      "end": 611.12,
      "text": "टेंशन कुछ हफ्तों में कंट्रोल हो जाता है"
    },
    {
      "subtitle_id": 298,
      "start": 609.2,
      "end": 612.959,
      "text": "तो दुबई की जो रिकवरी है वो रिलेटिवली"
    },
    {
      "subtitle_id": 299,
      "start": 611.12,
      "end": 614.72,
      "text": "फास्ट हो सकती है। टूरिज्म धीरे-धीरे वापस"
    },
    {
      "subtitle_id": 300,
      "start": 612.959,
      "end": 616.48,
      "text": "आ जाएगा और जो इन्वेस्टर कॉन्फिडेंस है वो"
    },
    {
      "subtitle_id": 301,
      "start": 614.72,
      "end": 618.56,
      "text": "भी धीरे-धीरे टाइम लगेगा लेकिन वापस आ"
    },
    {
      "subtitle_id": 302,
      "start": 616.48,
      "end": 620.88,
      "text": "जाएगा। एंड दुबई विल रिमेन दुबई। लेकिन"
    },
    {
      "subtitle_id": 303,
      "start": 618.56,
      "end": 622.8,
      "text": "अगर बाय एनी चांस यह कॉन्फ्लिक्ट कहीं"
    },
    {
      "subtitle_id": 304,
      "start": 620.88,
      "end": 625.04,
      "text": "महीनों तक चलता है तो इन्वेस्टर्स अपनी"
    },
    {
      "subtitle_id": 305,
      "start": 622.8,
      "end": 626.88,
      "text": "वेल डवर्सिफाई करना शुरू करेंगे। कैपिटल"
    },
    {
      "subtitle_id": 306,
      "start": 625.04,
      "end": 628.56,
      "text": "धीरे-धीरे सिंगापुर, स्विट्जरलैंड, लंदन"
    },
    {
      "subtitle_id": 307,
      "start": 626.88,
      "end": 630.72,
      "text": "जैसे फाइनेंसियल हब्स की तरफ मूव करेंगे"
    },
    {
      "subtitle_id": 308,
      "start": 628.56,
      "end": 632.72,
      "text": "और इसका दुबई के सेफ हेवन रेपुटेशन पर"
    },
    {
      "subtitle_id": 309,
      "start": 630.72,
      "end": 634.8,
      "text": "लॉन्ग टर्म प्रेशर पड़ सकता है। और जो"
    },
    {
      "subtitle_id": 310,
      "start": 632.72,
      "end": 637.279,
      "text": "तीसरा सिनेरियो है वो सबसे डेंजरस साबित"
    },
    {
      "subtitle_id": 311,
      "start": 634.8,
      "end": 639.2,
      "text": "हो सकता है। वो है फुल एस्केलेशन का। अगर"
    },
    {
      "subtitle_id": 312,
      "start": 637.279,
      "end": 640.88,
      "text": "गल्फ रीजन डायरेक्ट कॉन्फ्लिक्ट ज़ोन बन"
    },
    {
      "subtitle_id": 313,
      "start": 639.2,
      "end": 642.8,
      "text": "जाता है तो इसका इंपैक्ट सिर्फ मिडिल ईस्ट"
    },
    {
      "subtitle_id": 314,
      "start": 640.88,
      "end": 644.88,
      "text": "तक ही लिमिटेड नहीं रहेगा। वो पूरे वर्ल्ड"
    },
    {
      "subtitle_id": 315,
      "start": 642.8,
      "end": 646.8,
      "text": "पर पड़ेगा। एंड ऑफिशियली दुबई ड्रीम विल"
    },
    {
      "subtitle_id": 316,
      "start": 644.88,
      "end": 648.72,
      "text": "बी ओवर। और अगर इंडिया की बात करें तो"
    },
    {
      "subtitle_id": 317,
      "start": 646.8,
      "end": 650.959,
      "text": "दुबई का इंडिया कनेक्शन काफी स्ट्रांग है।"
    },
    {
      "subtitle_id": 318,
      "start": 648.72,
      "end": 652.959,
      "text": "जनरली दुबई को इंडियन सिटी आउट ऑफ इंडियन"
    },
    {
      "subtitle_id": 319,
      "start": 650.959,
      "end": 654.959,
      "text": "भी कहा जाता है मजाक-मज़ाक में। इनफैक्ट जब"
    },
    {
      "subtitle_id": 320,
      "start": 652.959,
      "end": 656.959,
      "text": "मैं दुबई गया था तो मेरे पूरे दो दिन के"
    },
    {
      "subtitle_id": 321,
      "start": 654.959,
      "end": 658.56,
      "text": "ट्रिप में मैं हिंदी में ही बात कर रहा था"
    },
    {
      "subtitle_id": 322,
      "start": 656.959,
      "end": 660.8,
      "text": "क्योंकि वहां पर बहुत सारे इंडियंस ही"
    },
    {
      "subtitle_id": 323,
      "start": 658.56,
      "end": 663.04,
      "text": "हैं। दुबई की पॉपुलेशन लगभग 1 करोड़ की है"
    },
    {
      "subtitle_id": 324,
      "start": 660.8,
      "end": 665.279,
      "text": "जिसमें करीब 40 लाख इंडियंस रहते हैं और"
    },
    {
      "subtitle_id": 325,
      "start": 663.04,
      "end": 667.519,
      "text": "काम करते हैं। और यह इंडियंस लगभग हर साल"
    },
    {
      "subtitle_id": 326,
      "start": 665.279,
      "end": 669.279,
      "text": "50 बिलियन डॉलर के रेमिटेंस इंडिया भेजते"
    },
    {
      "subtitle_id": 327,
      "start": 667.519,
      "end": 671.12,
      "text": "हैं। तो अगर दुबई को कुछ होता है तो उसका"
    },
    {
      "subtitle_id": 328,
      "start": 669.279,
      "end": 673.12,
      "text": "डायरेक्ट इंपैक्ट इन 40 लाख इंडियंस पर"
    },
    {
      "subtitle_id": 329,
      "start": 671.12,
      "end": 674.72,
      "text": "होगा। तो ओवरऑल देखा जाए तो रिमिटेंस कम"
    },
    {
      "subtitle_id": 330,
      "start": 673.12,
      "end": 676.64,
      "text": "होगा। बाकी भी और चीजें हैं तो इंडिया को"
    },
    {
      "subtitle_id": 331,
      "start": 674.72,
      "end": 678.399,
      "text": "अल्टीमेटली ज्यादा नुकसान ही होगा। लेकिन"
    },
    {
      "subtitle_id": 332,
      "start": 676.64,
      "end": 680.0,
      "text": "यहीं पर भारत में कुछ ऐसे सेक्टर्स भी हैं"
    },
    {
      "subtitle_id": 333,
      "start": 678.399,
      "end": 682.16,
      "text": "जिन्हें इस प्रॉब्लम का फायदा हो सकता है।"
    },
    {
      "subtitle_id": 334,
      "start": 680.0,
      "end": 684.64,
      "text": "यानी ब्लेसिंग इन डिसगाइस उनके लिए यह चीज"
    },
    {
      "subtitle_id": 335,
      "start": 682.16,
      "end": 686.56,
      "text": "साबित हो सकती है। उसमें से एक है लग्जरी"
    },
    {
      "subtitle_id": 336,
      "start": 684.64,
      "end": 688.16,
      "text": "रियलस्टेट। खासकर मुंबई, गुड़गांव और"
    },
    {
      "subtitle_id": 337,
      "start": 686.56,
      "end": 689.839,
      "text": "हैदराबाद जैसी सिटीज में। लेकिन अगर"
    },
    {
      "subtitle_id": 338,
      "start": 688.16,
      "end": 692.079,
      "text": "फाइनेंसियल सेक्टर की बात करें तो इसका"
    },
    {
      "subtitle_id": 339,
      "start": 689.839,
      "end": 693.839,
      "text": "सबसे ज्यादा फायदा लंदन और सिंगापुर जैसे"
    },
    {
      "subtitle_id": 340,
      "start": 692.079,
      "end": 695.36,
      "text": "फाइनेंसियल हब्स को होगा। इंडिया को जो"
    },
    {
      "subtitle_id": 341,
      "start": 693.839,
      "end": 697.279,
      "text": "डायरेक्ट बेनिफिट है वो उतना नहीं मिलेगा।"
    },
    {
      "subtitle_id": 342,
      "start": 695.36,
      "end": 699.519,
      "text": "तो आपको क्या लगता है? नीचे कमेंट करके"
    },
    {
      "subtitle_id": 343,
      "start": 697.279,
      "end": 700.959,
      "text": "जरूर बताइए। और हां, जाते-जाते क्रेडिट पे"
    },
    {
      "subtitle_id": 344,
      "start": 699.519,
      "end": 702.399,
      "text": "को जरूर चेक आउट कीजिए। बहुत ही बढ़िया"
    },
    {
      "subtitle_id": 345,
      "start": 700.959,
      "end": 703.68,
      "text": "प्लेटफार्म है जिसकी लिंक आपको नीचे"
    },
    {
      "subtitle_id": 346,
      "start": 702.399,
      "end": 705.68,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में मिल"
    },
    {
      "subtitle_id": 347,
      "start": 703.68,
      "end": 709.72,
      "text": "जाएगी और वीडियो अच्छी लगी है तो चैनल को"
    },
    {
      "subtitle_id": 348,
      "start": 705.68,
      "end": 709.72,
      "text": "जरूर जरूर सब्सक्राइब कीजिए।"
    }
  ]
}