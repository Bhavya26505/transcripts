  "segments": [
    {
      "subtitle_id": 1,
      "start": 1.04,
      "end": 5.4,
      "text": "सही है म्यूचुअल फंड्स में पेशेंस रखना"
    },
    {
      "subtitle_id": 2,
      "start": 3.199,
      "end": 7.0,
      "text": "सही है एमफी ने बनाई हुई ये म्यूचुअल फंड"
    },
    {
      "subtitle_id": 3,
      "start": 5.4,
      "end": 8.679,
      "text": "की ऐड आपने कभी ना कभी तो जरूर देखी होगी"
    },
    {
      "subtitle_id": 4,
      "start": 7.0,
      "end": 11.719,
      "text": "और इसकी एक लाइन आपके दिमाग में हमेशा"
    },
    {
      "subtitle_id": 5,
      "start": 8.679,
      "end": 13.88,
      "text": "चलती होंगी कि म्यूचुअल फंड सही है लेकिन"
    },
    {
      "subtitle_id": 6,
      "start": 11.719,
      "end": 15.719,
      "text": "इंडिया में 4800 से ज्यादा म्यूचुअल फंड"
    },
    {
      "subtitle_id": 7,
      "start": 13.88,
      "end": 17.88,
      "text": "स्कीम्स है और अगर मैं एक्टिव म्यूचुअल"
    },
    {
      "subtitle_id": 8,
      "start": 15.719,
      "end": 19.32,
      "text": "फंड्स की बात करूं तो 89 पर एक्टिव"
    },
    {
      "subtitle_id": 9,
      "start": 17.88,
      "end": 21.359,
      "text": "म्यूचुअल फंड स्कीम्स अपने बेंचमार्क"
    },
    {
      "subtitle_id": 10,
      "start": 19.32,
      "end": 23.84,
      "text": "इंडेक्स को भी बीट नहीं कर पाती है तो"
    },
    {
      "subtitle_id": 11,
      "start": 21.359,
      "end": 26.88,
      "text": "इसके बाद दिमाग में जरूर यह सवाल आता है"
    },
    {
      "subtitle_id": 12,
      "start": 23.84,
      "end": 29.08,
      "text": "कि म्यूचुअल फंड सही तो है लेकिन कौन सा"
    },
    {
      "subtitle_id": 13,
      "start": 26.88,
      "end": 31.08,
      "text": "और इसी सवाल का जवाब आपको आज के इस वीडियो"
    },
    {
      "subtitle_id": 14,
      "start": 29.08,
      "end": 32.84,
      "text": "में मिल जाएगा जहां पर हम बात करने वाले"
    },
    {
      "subtitle_id": 15,
      "start": 31.08,
      "end": 34.48,
      "text": "हैं कुछ म्यूचुअल फंड हैक्स के बारे में"
    },
    {
      "subtitle_id": 16,
      "start": 32.84,
      "end": 36.36,
      "text": "म्यूचुअल फंड सिलेक्शन प्रोसेस के बारे"
    },
    {
      "subtitle_id": 17,
      "start": 34.48,
      "end": 38.8,
      "text": "में जो आपको बेटर म्यूचुअल फंड सिलेक्ट"
    },
    {
      "subtitle_id": 18,
      "start": 36.36,
      "end": 40.68,
      "text": "करने में मदद करेगा नमस्कार मैं प्रसाद"
    },
    {
      "subtitle_id": 19,
      "start": 38.8,
      "end": 43.36,
      "text": "आपका आज के इस वीडियो में स्वागत करता हूं"
    },
    {
      "subtitle_id": 20,
      "start": 40.68,
      "end": 45.32,
      "text": "अभी रिसेंटली मैं एक इंडिया के बहुत बड़े"
    },
    {
      "subtitle_id": 21,
      "start": 43.36,
      "end": 48.039,
      "text": "म्यूचुअल फंड मैनेजर के साथ बैठा था"
    },
    {
      "subtitle_id": 22,
      "start": 45.32,
      "end": 49.719,
      "text": "मिस्टर राजू ठक्कर जो कि इंडिया का तीसरा"
    },
    {
      "subtitle_id": 23,
      "start": 48.039,
      "end": 51.719,
      "text": "सबसे बड़ा एक्टिव म्यूचुअल फंड मैनेज करते"
    },
    {
      "subtitle_id": 24,
      "start": 49.719,
      "end": 54.6,
      "text": "हैं पराक पारिक फ्लेग कप जहां पर वो लगभग"
    },
    {
      "subtitle_id": 25,
      "start": 51.719,
      "end": 56.719,
      "text": "0000 करोड़ मैनेज करते हैं और उनके साथ"
    },
    {
      "subtitle_id": 26,
      "start": 54.6,
      "end": 58.28,
      "text": "बैठकर जब हमने पॉडकास्ट भी शूट किया तो तो"
    },
    {
      "subtitle_id": 27,
      "start": 56.719,
      "end": 59.8,
      "text": "यहां पर हमें पता चला कि लोगों को कई सारी"
    },
    {
      "subtitle_id": 28,
      "start": 58.28,
      "end": 61.84,
      "text": "ऐसी प्रोसेसेस है म्यूचुअल फंड पिक करने"
    },
    {
      "subtitle_id": 29,
      "start": 59.8,
      "end": 63.76,
      "text": "की पता ही नहीं है तो अभी वन बाय वन एक-एक"
    },
    {
      "subtitle_id": 30,
      "start": 61.84,
      "end": 66.56,
      "text": "हैक के बारे में हम बात करते हैं तो सबसे"
    },
    {
      "subtitle_id": 31,
      "start": 63.76,
      "end": 68.72,
      "text": "बड़ा प्रॉब्लम यह है कि देखिए इंडिया में"
    },
    {
      "subtitle_id": 32,
      "start": 66.56,
      "end": 71.04,
      "text": "दो तरह के एक्टिव इक्विटी म्यूचुअल फंड्स"
    },
    {
      "subtitle_id": 33,
      "start": 68.72,
      "end": 73.32,
      "text": "है पहला होता है एक्टिव और दूसरा होता है"
    },
    {
      "subtitle_id": 34,
      "start": 71.04,
      "end": 74.88,
      "text": "पैसिव एक्टिव मतलब जहां पर एक फंड मैनेजर"
    },
    {
      "subtitle_id": 35,
      "start": 73.32,
      "end": 76.92,
      "text": "होता है उनके नीचे रिसर्च टीम होती है और"
    },
    {
      "subtitle_id": 36,
      "start": 74.88,
      "end": 78.96,
      "text": "वो लोग आपके लिए अलग-अलग स्टॉक्स ढूंढते"
    },
    {
      "subtitle_id": 37,
      "start": 76.92,
      "end": 80.88,
      "text": "हैं पैसिव म्यूचुअल फंड में क्या होता है"
    },
    {
      "subtitle_id": 38,
      "start": 78.96,
      "end": 82.52,
      "text": "कि कोई फंड मैनेजर नहीं होता है एस सच"
    },
    {
      "subtitle_id": 39,
      "start": 80.88,
      "end": 85.04,
      "text": "जिसको स्टॉक सिलेक्शन का भी काम नहीं होता"
    },
    {
      "subtitle_id": 40,
      "start": 82.52,
      "end": 86.56,
      "text": "है आप बस इंडेक्स में इन्वेस्ट करते हैं"
    },
    {
      "subtitle_id": 41,
      "start": 85.04,
      "end": 88.32,
      "text": "यानी सेंसेक्स का इंडेक्स फंड है तो"
    },
    {
      "subtitle_id": 42,
      "start": 86.56,
      "end": 90.479,
      "text": "सेंसेक्स की 30 कंपनीज में उसके वेटेज के"
    },
    {
      "subtitle_id": 43,
      "start": 88.32,
      "end": 92.399,
      "text": "अनुसार इन्वेस्ट करेगा निफ्टी 50 का"
    },
    {
      "subtitle_id": 44,
      "start": 90.479,
      "end": 94.159,
      "text": "इंडेक्स फंड है तो निफ्टी 50 की 50 कंपनीज"
    },
    {
      "subtitle_id": 45,
      "start": 92.399,
      "end": 96.52,
      "text": "में इन्वेस्ट कर देगा उसके वेटेज के"
    },
    {
      "subtitle_id": 46,
      "start": 94.159,
      "end": 98.479,
      "text": "अनुसार कुछ दिमाग नहीं लगाना है मिड कैप"
    },
    {
      "subtitle_id": 47,
      "start": 96.52,
      "end": 100.88,
      "text": "इंडेक्स है कोई स्मॉल कैप है तो उन"
    },
    {
      "subtitle_id": 48,
      "start": 98.479,
      "end": 102.799,
      "text": "स्टॉक्स में वो इन्वेस्ट कर देगा उनके"
    },
    {
      "subtitle_id": 49,
      "start": 100.88,
      "end": 104.96,
      "text": "वेटेज के अनुसार कोई दिमाग नहीं लगाना है"
    },
    {
      "subtitle_id": 50,
      "start": 102.799,
      "end": 107.159,
      "text": "तो जैसे इंडेक्स के रिटर्न्स रहेंगे वैसे"
    },
    {
      "subtitle_id": 51,
      "start": 104.96,
      "end": 108.719,
      "text": "फंड के रिटर्न आ जाते हैं लेकिन यहां पर"
    },
    {
      "subtitle_id": 52,
      "start": 107.159,
      "end": 111.0,
      "text": "इंडिया में अगर देखा जाए तो कई सारे लोग"
    },
    {
      "subtitle_id": 53,
      "start": 108.719,
      "end": 113.2,
      "text": "ऐसे हैं जो चाहते हैं कि वो इंडेक्स को"
    },
    {
      "subtitle_id": 54,
      "start": 111.0,
      "end": 114.92,
      "text": "बीट करें बेटर रिटर्न्स लाए और इसीलिए वो"
    },
    {
      "subtitle_id": 55,
      "start": 113.2,
      "end": 116.92,
      "text": "एक्टिव म्यूचुअल फंड की तरफ जाते हैं और"
    },
    {
      "subtitle_id": 56,
      "start": 114.92,
      "end": 119.159,
      "text": "ज्यादातर टाइम निराश होकर ही आते हैं तो"
    },
    {
      "subtitle_id": 57,
      "start": 116.92,
      "end": 121.28,
      "text": "पहला रीजन है कि लोग रिटर्न्स को सही से"
    },
    {
      "subtitle_id": 58,
      "start": 119.159,
      "end": 122.88,
      "text": "समझ नहीं पाते हैं अगर मैं रिटर्न्स की"
    },
    {
      "subtitle_id": 59,
      "start": 121.28,
      "end": 126.159,
      "text": "बात करूं तो मैं आपको दो एग्जांपल देता"
    },
    {
      "subtitle_id": 60,
      "start": 122.88,
      "end": 128.2,
      "text": "हूं एक फंड है जिसने 12 पर का रिटर्न दिया"
    },
    {
      "subtitle_id": 61,
      "start": 126.159,
      "end": 130.959,
      "text": "है दूसरा है जिसने 13 पर का रिटर्न दिया"
    },
    {
      "subtitle_id": 62,
      "start": 128.2,
      "end": 134.08,
      "text": "है आपके अनुसार बेस्ट कौन है तो आप कहेंगे"
    },
    {
      "subtitle_id": 63,
      "start": 130.959,
      "end": 137.239,
      "text": "कि दूसरा वाला 13 पर के रिटर्न दिए है"
    },
    {
      "subtitle_id": 64,
      "start": 134.08,
      "end": 139.319,
      "text": "लेकिन कई बार लोग नेट रिटर्न्स देखते ही"
    },
    {
      "subtitle_id": 65,
      "start": 137.239,
      "end": 141.16,
      "text": "नहीं है अब ये नेट रिटर्न्स कैसे निकालने"
    },
    {
      "subtitle_id": 66,
      "start": 139.319,
      "end": 143.04,
      "text": "होते हैं उसे मैं जरा आपको बता देता हूं"
    },
    {
      "subtitle_id": 67,
      "start": 141.16,
      "end": 144.879,
      "text": "तो देखिए जो भी म्यूचुअल फंड की कंपनी है"
    },
    {
      "subtitle_id": 68,
      "start": 143.04,
      "end": 146.64,
      "text": "वह आपसे हर फंड के लिए एक एक्सपेंस रेशो"
    },
    {
      "subtitle_id": 69,
      "start": 144.879,
      "end": 148.239,
      "text": "चार्ज करती है यानी सालाना फीज आपको"
    },
    {
      "subtitle_id": 70,
      "start": 146.64,
      "end": 150.76,
      "text": "उन्हें देनी पड़ती है जो ऑटोमेटिक कट हो"
    },
    {
      "subtitle_id": 71,
      "start": 148.239,
      "end": 152.8,
      "text": "जाती है आपको पता भी नहीं चलता है तो 12"
    },
    {
      "subtitle_id": 72,
      "start": 150.76,
      "end": 156.0,
      "text": "पर जिसने रिटर्न दिया मान लेते हैं कि"
    },
    {
      "subtitle_id": 73,
      "start": 152.8,
      "end": 161.2,
      "text": "उसका एक्सपेंस रेश 0.2 था तो नेट रिटर्न"
    },
    {
      "subtitle_id": 74,
      "start": 156.0,
      "end": 163.92,
      "text": "आपका कितना हुआ 12 पर - 0.2 = 11.8 वहीं"
    },
    {
      "subtitle_id": 75,
      "start": 161.2,
      "end": 167.4,
      "text": "पर जो 13 पर वाला था उसका जो एक्सपेंस"
    },
    {
      "subtitle_id": 76,
      "start": 163.92,
      "end": 171.44,
      "text": "रेशो है वह 1.5 हम पकड़ लेते हैं तो 13 -"
    },
    {
      "subtitle_id": 77,
      "start": 167.4,
      "end": 173.959,
      "text": "1.5 = 11.5 तो नेट रिटर्न की बात करें तो"
    },
    {
      "subtitle_id": 78,
      "start": 171.44,
      "end": 176.04,
      "text": "पहला वाला बेटर निकला जबकि दिखने वाले"
    },
    {
      "subtitle_id": 79,
      "start": 173.959,
      "end": 177.8,
      "text": "रिटर्न्स दूसरे वाले के सही है तो सबसे"
    },
    {
      "subtitle_id": 80,
      "start": 176.04,
      "end": 180.04,
      "text": "पहले जब भी आप म्यूचुअल फंड के रिटर्न्स"
    },
    {
      "subtitle_id": 81,
      "start": 177.8,
      "end": 181.599,
      "text": "देखो सिर्फ नॉर्मल रिटर्न्स मत देखिए उसके"
    },
    {
      "subtitle_id": 82,
      "start": 180.04,
      "end": 183.959,
      "text": "नेट रिटर्न्स देखिए उसके लिए थोड़े बहुत"
    },
    {
      "subtitle_id": 83,
      "start": 181.599,
      "end": 185.239,
      "text": "आपको दिमाग में य कैलकुलेशंस करने पड़ेंगे"
    },
    {
      "subtitle_id": 84,
      "start": 183.959,
      "end": 186.92,
      "text": "तो इसका क्या यह मतलब है कि जिसका"
    },
    {
      "subtitle_id": 85,
      "start": 185.239,
      "end": 189.48,
      "text": "एक्सपेंस रेशो ज्यादा है वह खराब है और"
    },
    {
      "subtitle_id": 86,
      "start": 186.92,
      "end": 192.28,
      "text": "जिसका कम है वो बढ़िया है ऐसा नहीं है"
    },
    {
      "subtitle_id": 87,
      "start": 189.48,
      "end": 194.08,
      "text": "देखिए अल्टीमेटली चीजें एक्सपेंस रेशो की"
    },
    {
      "subtitle_id": 88,
      "start": 192.28,
      "end": 196.04,
      "text": "नहीं है अल्टीमेटली नेट रिटर्न्स की बातें"
    },
    {
      "subtitle_id": 89,
      "start": 194.08,
      "end": 198.4,
      "text": "हैं फॉर एग्जांपल मैं यहां पर एक इंडेक्स"
    },
    {
      "subtitle_id": 90,
      "start": 196.04,
      "end": 200.36,
      "text": "फंड उठाता हूं निफ्टी 50 का जहां पर मुझे"
    },
    {
      "subtitle_id": 91,
      "start": 198.4,
      "end": 202.68,
      "text": "5 साल में कंपाउंडेड सालाना 15 पर के"
    },
    {
      "subtitle_id": 92,
      "start": 200.36,
      "end": 205.239,
      "text": "रिटर्न मिले हैं और एक्सपेंस रेशो 0.2 टू"
    },
    {
      "subtitle_id": 93,
      "start": 202.68,
      "end": 207.76,
      "text": "0.3 ऐसा वैरी हो रहा है तो 0.2 का मैं"
    },
    {
      "subtitle_id": 94,
      "start": 205.239,
      "end": 209.76,
      "text": "पकड़ लेता हूं तो नेट रिटर्न मेरे 14.8 पर"
    },
    {
      "subtitle_id": 95,
      "start": 207.76,
      "end": 211.599,
      "text": "के निकल कर आ रहे हैं वहीं पर निपन का"
    },
    {
      "subtitle_id": 96,
      "start": 209.76,
      "end": 213.56,
      "text": "लार्ज कैप म्यूचुअल फंड है जिसने पिछले 5"
    },
    {
      "subtitle_id": 97,
      "start": 211.599,
      "end": 216.28,
      "text": "साल में कंपाउंडेड सालना 18 पर का रिटर्न"
    },
    {
      "subtitle_id": 98,
      "start": 213.56,
      "end": 218.799,
      "text": "दिया है उसका एक्सपेंस रेशो है 0.73 पर"
    },
    {
      "subtitle_id": 99,
      "start": 216.28,
      "end": 221.36,
      "text": "उसको मैं हटा देता हूं तो मुझे लगभग"
    },
    {
      "subtitle_id": 100,
      "start": 218.799,
      "end": 223.72,
      "text": "17.2 का रिटर्न मिल रहा है जो कि इंडेक्स"
    },
    {
      "subtitle_id": 101,
      "start": 221.36,
      "end": 227.08,
      "text": "के नेट रिटर्न से बेटर ही है तो इस तरह से"
    },
    {
      "subtitle_id": 102,
      "start": 223.72,
      "end": 229.2,
      "text": "आपको चीजें देखनी है अगर कोई 1 पर का 24"
    },
    {
      "subtitle_id": 103,
      "start": 227.08,
      "end": 231.04,
      "text": "पर का भी एक्सपेंस रेशो लगाता है आपसे"
    },
    {
      "subtitle_id": 104,
      "start": 229.2,
      "end": 232.799,
      "text": "लेकिन आपको अगर बहुत बेटर रिटर्न्स दे रहा"
    },
    {
      "subtitle_id": 105,
      "start": 231.04,
      "end": 234.76,
      "text": "है तो आपका फोकस नेट रिटर्न्स की तरफ होना"
    },
    {
      "subtitle_id": 106,
      "start": 232.799,
      "end": 236.4,
      "text": "चाहिए ना कि सिर्फ एक्सपेंस रेशो की तरफ"
    },
    {
      "subtitle_id": 107,
      "start": 234.76,
      "end": 238.159,
      "text": "तो यह बहुत बड़ी गलती लोग करते हैं कि"
    },
    {
      "subtitle_id": 108,
      "start": 236.4,
      "end": 240.879,
      "text": "ज्यादा एक्सपेंस रेशो है तो अवॉइड कर लेता"
    },
    {
      "subtitle_id": 109,
      "start": 238.159,
      "end": 242.079,
      "text": "हूं रिटर्न्स से तो ऊपर वाले रिटर्न्स देख"
    },
    {
      "subtitle_id": 110,
      "start": 240.879,
      "end": 243.879,
      "text": "लेता हूं लेकिन आपको इस तरह के नेट"
    },
    {
      "subtitle_id": 111,
      "start": 242.079,
      "end": 245.439,
      "text": "रिटर्न्स देखने हैं और इस तरह के नेट"
    },
    {
      "subtitle_id": 112,
      "start": 243.879,
      "end": 247.439,
      "text": "रिटर्न्स देखोगे तो आगे आपको कई सारी"
    },
    {
      "subtitle_id": 113,
      "start": 245.439,
      "end": 250.2,
      "text": "शॉकिंग चीजें पता चलेगी कि मेजॉरिटी"
    },
    {
      "subtitle_id": 114,
      "start": 247.439,
      "end": 253.36,
      "text": "मिडकैप फंड्स मिडकैप इंडेक्स को नहीं बिट"
    },
    {
      "subtitle_id": 115,
      "start": 250.2,
      "end": 255.519,
      "text": "कर पा रहे और यही रियलिटी है जबकि वह"
    },
    {
      "subtitle_id": 116,
      "start": 253.36,
      "end": 257.04,
      "text": "एक्टिव मिडकैप म्यूचुअल फंड काफी ज्यादा"
    },
    {
      "subtitle_id": 117,
      "start": 255.519,
      "end": 259.84,
      "text": "एक्सपेंस चार्ज कर रहे हैं लेकिन नेट"
    },
    {
      "subtitle_id": 118,
      "start": 257.04,
      "end": 261.56,
      "text": "रिटर्न्स उनके इंडेक्स से भी कम है तो यह"
    },
    {
      "subtitle_id": 119,
      "start": 259.84,
      "end": 263.68,
      "text": "तो हो गया नेट रिटर्न्स का अब बात करते"
    },
    {
      "subtitle_id": 120,
      "start": 261.56,
      "end": 265.68,
      "text": "हैं अगली हैक के बारे में म्यूचुअल फंड"
    },
    {
      "subtitle_id": 121,
      "start": 263.68,
      "end": 267.919,
      "text": "में एनालाइज करने वाली जो अगली चीज है वह"
    },
    {
      "subtitle_id": 122,
      "start": 265.68,
      "end": 270.039,
      "text": "सबसे इंपॉर्टेंट चीज है जिसे आप बिल्कुल"
    },
    {
      "subtitle_id": 123,
      "start": 267.919,
      "end": 271.8,
      "text": "भी नजरअंदाज नहीं कर सकते अगर आप इस चीज"
    },
    {
      "subtitle_id": 124,
      "start": 270.039,
      "end": 274.12,
      "text": "को नजरअंदाज करते तो यह आपको और आपके"
    },
    {
      "subtitle_id": 125,
      "start": 271.8,
      "end": 275.8,
      "text": "इन्वेस्टमेंट को काफी महंगा पड़ सकता है"
    },
    {
      "subtitle_id": 126,
      "start": 274.12,
      "end": 278.68,
      "text": "देखिए मैं आपको बताता हूं कि हुआ यह कि"
    },
    {
      "subtitle_id": 127,
      "start": 275.8,
      "end": 281.52,
      "text": "साल 2003 की बात है दिवी लैब करके एक"
    },
    {
      "subtitle_id": 128,
      "start": 278.68,
      "end": 284.08,
      "text": "कंपनी है फार्मा कंपनी और उनका आईपीओ आया"
    },
    {
      "subtitle_id": 129,
      "start": 281.52,
      "end": 285.8,
      "text": "आईपीओ आने के बाद उस साल जो फार्मा कंपनीज"
    },
    {
      "subtitle_id": 130,
      "start": 284.08,
      "end": 290.28,
      "text": "थी काफी अंडर वैल्यूड थी और बिजनेस ग्रोथ"
    },
    {
      "subtitle_id": 131,
      "start": 285.8,
      "end": 290.28,
      "text": "उनमें काफी ज्यादा थी तो इसी चीज को देखकर"
    },
    {
      "subtitle_id": 132,
      "start": 299.72,
      "end": 303.52,
      "text": "एनालिसिस भी अच्छे से पूरा हो जाएगा और"
    },
    {
      "subtitle_id": 133,
      "start": 301.44,
      "end": 305.36,
      "text": "मैं फिर स्टॉक खरीदने के लिए रेडी हो"
    },
    {
      "subtitle_id": 134,
      "start": 303.52,
      "end": 307.919,
      "text": "जाऊंगा लेकिन मैनेजमेंट मीडिया के सामने"
    },
    {
      "subtitle_id": 135,
      "start": 305.36,
      "end": 309.96,
      "text": "आने के लिए तैयार ही नहीं था और इसीलिए"
    },
    {
      "subtitle_id": 136,
      "start": 307.919,
      "end": 312.24,
      "text": "फिर मिस्टर केला का यह था कि सब अच्छा है"
    },
    {
      "subtitle_id": 137,
      "start": 309.96,
      "end": 314.72,
      "text": "तो किसी ना किसी तरीके से कोशिश करते कि"
    },
    {
      "subtitle_id": 138,
      "start": 312.24,
      "end": 317.96,
      "text": "इन तक पहुंचा जाए फिर उन्हें कहीं से पता"
    },
    {
      "subtitle_id": 139,
      "start": 314.72,
      "end": 320.24,
      "text": "चला कि दिविज लैब के जो प्रमोटर्स हैं वो"
    },
    {
      "subtitle_id": 140,
      "start": 317.96,
      "end": 322.88,
      "text": "किसी कारण लंडन जा रहे हैं तो मिस्टर केला"
    },
    {
      "subtitle_id": 141,
      "start": 320.24,
      "end": 324.639,
      "text": "ने तुरंत बिजनेस क्लास के टिकट बुक की"
    },
    {
      "subtitle_id": 142,
      "start": 322.88,
      "end": 327.479,
      "text": "जहां पर उनके बा बाजू की सीट उन्हें मिल"
    },
    {
      "subtitle_id": 143,
      "start": 324.639,
      "end": 329.199,
      "text": "गई और फिर उस उन 10 घंटों में उन्होंने"
    },
    {
      "subtitle_id": 144,
      "start": 327.479,
      "end": 331.6,
      "text": "कंपनी का हर एक कच्चा चिट्ठा उनसे निकाल"
    },
    {
      "subtitle_id": 145,
      "start": 329.199,
      "end": 334.12,
      "text": "लिया उन्होंने वह सारी इंफॉर्मेशन उनसे"
    },
    {
      "subtitle_id": 146,
      "start": 331.6,
      "end": 336.319,
      "text": "पता कर ली कि कंपनी का बिजनेस का यूएसपी"
    },
    {
      "subtitle_id": 147,
      "start": 334.12,
      "end": 338.319,
      "text": "क्या है अगर इस तरह की सिचुएशन आती है तो"
    },
    {
      "subtitle_id": 148,
      "start": 336.319,
      "end": 340.199,
      "text": "कंपनी कैसे रिएक्ट करती है मैनेजमेंट को"
    },
    {
      "subtitle_id": 149,
      "start": 338.319,
      "end": 342.44,
      "text": "समझ लिया और वो सारी चीजें समझने के बाद"
    },
    {
      "subtitle_id": 150,
      "start": 340.199,
      "end": 344.759,
      "text": "उन्हें पता चला कि यार कंपनी बहुत अच्छी"
    },
    {
      "subtitle_id": 151,
      "start": 342.44,
      "end": 346.56,
      "text": "है फिर वहां पहुंचने के बाद उन्हें करना"
    },
    {
      "subtitle_id": 152,
      "start": 344.759,
      "end": 348.56,
      "text": "तो कुछ नहीं था लंडन रिटर्न फ्लाइट लेकर"
    },
    {
      "subtitle_id": 153,
      "start": 346.56,
      "end": 351.759,
      "text": "इंडिया आ गए और उन्होंने 10 पर स्टेक"
    },
    {
      "subtitle_id": 154,
      "start": 348.56,
      "end": 354.4,
      "text": "दिविज लैब में खरीद लिया जिसकी वजह से साल"
    },
    {
      "subtitle_id": 155,
      "start": 351.759,
      "end": 356.28,
      "text": "2003 से लेकर 2010 तक इन सात सालों में उस"
    },
    {
      "subtitle_id": 156,
      "start": 354.4,
      "end": 358.759,
      "text": "म्यूचुअल फंड स्कीम ने कंपाउंडेड सालाना"
    },
    {
      "subtitle_id": 157,
      "start": 356.28,
      "end": 361.56,
      "text": "32 पर के एक्स्ट्राऑर्डिनरी रिटर्न्स दिए"
    },
    {
      "subtitle_id": 158,
      "start": 358.759,
      "end": 363.96,
      "text": "बहुत क्रेजी रिटर्नस रिटनस तो देखिए इस"
    },
    {
      "subtitle_id": 159,
      "start": 361.56,
      "end": 365.319,
      "text": "तरह के जो मैनेजर्स होते हैं जो कुछ भी"
    },
    {
      "subtitle_id": 160,
      "start": 363.96,
      "end": 366.72,
      "text": "करने के लिए तैयार हो जाते हैं अपने"
    },
    {
      "subtitle_id": 161,
      "start": 365.319,
      "end": 368.84,
      "text": "इन्वेस्टर्स को रिटर्न्स देने के लिए इस"
    },
    {
      "subtitle_id": 162,
      "start": 366.72,
      "end": 370.56,
      "text": "तरह के मैनेजर्स बहुत कम होते हैं और"
    },
    {
      "subtitle_id": 163,
      "start": 368.84,
      "end": 372.199,
      "text": "म्यूचुअल फंड सिलेक्ट करते टाइम सबसे"
    },
    {
      "subtitle_id": 164,
      "start": 370.56,
      "end": 373.599,
      "text": "ज्यादा फोकस अगर आपका किस चीज पर होना"
    },
    {
      "subtitle_id": 165,
      "start": 372.199,
      "end": 376.4,
      "text": "चाहिए तो वो है उस म्यूचुअल फंड के"
    },
    {
      "subtitle_id": 166,
      "start": 373.599,
      "end": 378.16,
      "text": "मैनेजर्स पर अब देखिए मैनेजर को देखना है"
    },
    {
      "subtitle_id": 167,
      "start": 376.4,
      "end": 380.039,
      "text": "तो कई सारी चीजें आपको ऑफकोर्स देखनी है"
    },
    {
      "subtitle_id": 168,
      "start": 378.16,
      "end": 383.0,
      "text": "लेकिन यहां पर कई बार लोग गलती यह करते"
    },
    {
      "subtitle_id": 169,
      "start": 380.039,
      "end": 385.12,
      "text": "हैं कि रिटर्न्स देखते देखते टाइम दो से"
    },
    {
      "subtitle_id": 170,
      "start": 383.0,
      "end": 387.16,
      "text": "ती साल के रिटर्न्स देख लेते हैं आईएल आप"
    },
    {
      "subtitle_id": 171,
      "start": 385.12,
      "end": 389.56,
      "text": "देखते हैं तो एक चीज का जवाब आप दे पाएंगे"
    },
    {
      "subtitle_id": 172,
      "start": 387.16,
      "end": 392.0,
      "text": "अभी मुझे देखिए सचिन तेंडुलकर विराट कोहली"
    },
    {
      "subtitle_id": 173,
      "start": 389.56,
      "end": 393.88,
      "text": "रोहित शर्मा ये सारे जो प्लेयर्स है और भी"
    },
    {
      "subtitle_id": 174,
      "start": 392.0,
      "end": 396.759,
      "text": "कई सारे ग्रेट प्लेयर्स हैं ये ग्रेट"
    },
    {
      "subtitle_id": 175,
      "start": 393.88,
      "end": 398.36,
      "text": "क्यों बने उनकी कंसिस्टेंसी की वजह से ये"
    },
    {
      "subtitle_id": 176,
      "start": 396.759,
      "end": 400.639,
      "text": "नहीं कि एक सीजन में खेले दूसरे में नहीं"
    },
    {
      "subtitle_id": 177,
      "start": 398.36,
      "end": 403.56,
      "text": "खेले आईपीएल में कई सारे ऐसे प्लेयर आते"
    },
    {
      "subtitle_id": 178,
      "start": 400.639,
      "end": 406.639,
      "text": "हैं आप तो शायद आपके सामने कई सारे नाम भी"
    },
    {
      "subtitle_id": 179,
      "start": 403.56,
      "end": 408.8,
      "text": "आ चुके होंगे जो एक दो सीजन में खेलते हैं"
    },
    {
      "subtitle_id": 180,
      "start": 406.639,
      "end": 410.56,
      "text": "फिर बाद में नहीं कर पाते कई बार उनको एक"
    },
    {
      "subtitle_id": 181,
      "start": 408.8,
      "end": 412.36,
      "text": "दो सीजन के चलते ही टीम इंडिया में बुलाया"
    },
    {
      "subtitle_id": 182,
      "start": 410.56,
      "end": 415.24,
      "text": "जाता है फिर वहां पर भी वो कुछ नहीं कर"
    },
    {
      "subtitle_id": 183,
      "start": 412.36,
      "end": 417.919,
      "text": "पाते और ऐसे ढेरों सारे प्लेयर्स है लेकिन"
    },
    {
      "subtitle_id": 184,
      "start": 415.24,
      "end": 420.56,
      "text": "जो कंसिस्टेंट है मतलब किसी भी चीज में"
    },
    {
      "subtitle_id": 185,
      "start": 417.919,
      "end": 422.96,
      "text": "चाहे बिजनेस में हो स्पोर्ट्स में हो हो"
    },
    {
      "subtitle_id": 186,
      "start": 420.56,
      "end": 424.72,
      "text": "और किसी चीज में हो वही सबसे ज्यादा मैटर"
    },
    {
      "subtitle_id": 187,
      "start": 422.96,
      "end": 427.639,
      "text": "करते हैं और फंड मैनेजर के बारे में भी"
    },
    {
      "subtitle_id": 188,
      "start": 424.72,
      "end": 429.039,
      "text": "यही सबसे इंपॉर्टेंट बात है अचानक से एक"
    },
    {
      "subtitle_id": 189,
      "start": 427.639,
      "end": 431.0,
      "text": "दो साल रिटर्न देने वाले आपको कई सारे"
    },
    {
      "subtitle_id": 190,
      "start": 429.039,
      "end": 432.84,
      "text": "मिलेंगे अब लोग क्या करते हैं उन एक दो"
    },
    {
      "subtitle_id": 191,
      "start": 431.0,
      "end": 434.919,
      "text": "साल के रिटर्न्स के बेसिस पर यह सोचते हैं"
    },
    {
      "subtitle_id": 192,
      "start": 432.84,
      "end": 437.0,
      "text": "कि आगे आगे भी हमें इसी तरह के रिटर्न्स"
    },
    {
      "subtitle_id": 193,
      "start": 434.919,
      "end": 439.24,
      "text": "मिलेंगे लेकिन आपको यह पता करना होगा कि"
    },
    {
      "subtitle_id": 194,
      "start": 437.0,
      "end": 441.599,
      "text": "वह एक दो सीजन वाले प्लेयर हैं या फिर"
    },
    {
      "subtitle_id": 195,
      "start": 439.24,
      "end": 444.12,
      "text": "लंबे टाइम से बहुत अच्छा खेल रहे हैं और"
    },
    {
      "subtitle_id": 196,
      "start": 441.599,
      "end": 446.12,
      "text": "इसीलिए एक मैनेजमेंट का एनालिसिस करना"
    },
    {
      "subtitle_id": 197,
      "start": 444.12,
      "end": 447.72,
      "text": "बहुत जरूरी है आप क्रिकेट देखते हो तो"
    },
    {
      "subtitle_id": 198,
      "start": 446.12,
      "end": 449.72,
      "text": "क्रिकेट का एनालिसिस आपके सामने है आपके"
    },
    {
      "subtitle_id": 199,
      "start": 447.72,
      "end": 452.28,
      "text": "पास नंबर्स है किसने कितनी सेंचुरी मारी"
    },
    {
      "subtitle_id": 200,
      "start": 449.72,
      "end": 454.12,
      "text": "कौन कितने एवरेज से खेलता है ऑन एन एवरेज"
    },
    {
      "subtitle_id": 201,
      "start": 452.28,
      "end": 455.96,
      "text": "कितने रन बनाता है यह तो ऊपर ऊपर से सभी"
    },
    {
      "subtitle_id": 202,
      "start": 454.12,
      "end": 457.52,
      "text": "को पता ही है तो रिजल्ट चाहे जो भी आए"
    },
    {
      "subtitle_id": 203,
      "start": 455.96,
      "end": 459.68,
      "text": "लेकिन कई सारी चीजें लोगों को पता होती है"
    },
    {
      "subtitle_id": 204,
      "start": 457.52,
      "end": 461.24,
      "text": "कि ये प्लेयर खेल पाएगा नहीं खेल पाएगा तो"
    },
    {
      "subtitle_id": 205,
      "start": 459.68,
      "end": 463.36,
      "text": "ये चीजें आपको इसलिए पता होती है क्योंकि"
    },
    {
      "subtitle_id": 206,
      "start": 461.24,
      "end": 465.319,
      "text": "आपके पास डाटा है आप काफी बार मैच में"
    },
    {
      "subtitle_id": 207,
      "start": 463.36,
      "end": 467.879,
      "text": "अपना टाइम इन्वेस्ट करते हैं मैचेस देखते"
    },
    {
      "subtitle_id": 208,
      "start": 465.319,
      "end": 469.68,
      "text": "हैं लेकिन म्यूचुअल फंड करते टाइम ये चीज"
    },
    {
      "subtitle_id": 209,
      "start": 467.879,
      "end": 471.319,
      "text": "हम थोड़ी मिस करते हैं तो स्टेप बाय स्टेप"
    },
    {
      "subtitle_id": 210,
      "start": 469.68,
      "end": 472.879,
      "text": "इस प्रोसेस में आपको यह देखना होगा कि"
    },
    {
      "subtitle_id": 211,
      "start": 471.319,
      "end": 474.36,
      "text": "दो-तीन साल के रिटर्न्स नहीं आपको कम से"
    },
    {
      "subtitle_id": 212,
      "start": 472.879,
      "end": 476.08,
      "text": "कम पांच से सा साल के रिटर्न देखने"
    },
    {
      "subtitle_id": 213,
      "start": 474.36,
      "end": 477.44,
      "text": "पड़ेंगे और उसी से फंड मैनेजर की"
    },
    {
      "subtitle_id": 214,
      "start": 476.08,
      "end": 479.8,
      "text": "परफॉर्मेंस आपके सामने आएगी कि ये"
    },
    {
      "subtitle_id": 215,
      "start": 477.44,
      "end": 481.479,
      "text": "कंसिस्टेंट है या नहीं उसमें भी आप सीधा"
    },
    {
      "subtitle_id": 216,
      "start": 479.8,
      "end": 483.4,
      "text": "सीएजीआर रिटर्न्स मत देखिए उसका ग्राफ"
    },
    {
      "subtitle_id": 217,
      "start": 481.479,
      "end": 485.84,
      "text": "देखिए कि किस तरह के रिटर्न्स देखिए और"
    },
    {
      "subtitle_id": 218,
      "start": 483.4,
      "end": 488.919,
      "text": "उसे उसके बेंचमार्क इंडेक्स के ग्राफ से"
    },
    {
      "subtitle_id": 219,
      "start": 485.84,
      "end": 491.08,
      "text": "कंपेयर कीजिए जैसे कोई लार्ज कै फंड है तो"
    },
    {
      "subtitle_id": 220,
      "start": 488.919,
      "end": 492.72,
      "text": "उसका जो बेंचमार्क इंडेक्स है वह मोस्ट"
    },
    {
      "subtitle_id": 221,
      "start": 491.08,
      "end": 494.199,
      "text": "प्रोबेबली निफ्टी या सेंसेक्स होगा तो"
    },
    {
      "subtitle_id": 222,
      "start": 492.72,
      "end": 496.319,
      "text": "निफ्टी सेंसेक्स से उन रिटर्न्स को चेक"
    },
    {
      "subtitle_id": 223,
      "start": 494.199,
      "end": 498.159,
      "text": "कीजिए और लंबे टाइम तक चेक कीजिए और जो भी"
    },
    {
      "subtitle_id": 224,
      "start": 496.319,
      "end": 500.039,
      "text": "फंड मैनेजर है वह भी देखिए कि कितने लंबे"
    },
    {
      "subtitle_id": 225,
      "start": 498.159,
      "end": 502.319,
      "text": "टाइम से उस फंड से जुड़े हुए हैं अगर मैं"
    },
    {
      "subtitle_id": 226,
      "start": 500.039,
      "end": 506.08,
      "text": "दिविज लैब की बात करूं तो 2003 के स्टार्ट"
    },
    {
      "subtitle_id": 227,
      "start": 502.319,
      "end": 508.72,
      "text": "में उसकी शेयर प्राइस 1015 थी जो 2010 तक"
    },
    {
      "subtitle_id": 228,
      "start": 506.08,
      "end": 511.28,
      "text": "00 4400 के भी ऊपर चली गई यानी कि 20 से"
    },
    {
      "subtitle_id": 229,
      "start": 508.72,
      "end": 513.36,
      "text": "25 गुना रिटर्न्स यहां पर मिस्टर केला को"
    },
    {
      "subtitle_id": 230,
      "start": 511.28,
      "end": 514.839,
      "text": "मिला उन सात सालों में जिसकी वजह से उनके"
    },
    {
      "subtitle_id": 231,
      "start": 513.36,
      "end": 517.839,
      "text": "जो म्यूचुअल फंड स्कीम है उसने बहुत ही"
    },
    {
      "subtitle_id": 232,
      "start": 514.839,
      "end": 520.0,
      "text": "आउट परफॉर्म किया कंपट सनने 32 पर इज नॉट"
    },
    {
      "subtitle_id": 233,
      "start": 517.839,
      "end": 521.719,
      "text": "अ जोक लेकिन जब मैनेजमेंट को एनालाइज करने"
    },
    {
      "subtitle_id": 234,
      "start": 520.0,
      "end": 523.719,
      "text": "की बात आती है तो सेवन स्टेप एनालिटिकल"
    },
    {
      "subtitle_id": 235,
      "start": 521.719,
      "end": 525.519,
      "text": "प्रोसेस आपको एक फॉलो करनी होती है जो"
    },
    {
      "subtitle_id": 236,
      "start": 523.719,
      "end": 527.399,
      "text": "आपको बेस्ट से बेस्ट म्यूचुअल फंड मैनेजर"
    },
    {
      "subtitle_id": 237,
      "start": 525.519,
      "end": 529.2,
      "text": "सिलेक्ट करने में मदद करता है और यह जो"
    },
    {
      "subtitle_id": 238,
      "start": 527.399,
      "end": 531.16,
      "text": "सारी चीजें शॉर्ट में समझाना पॉसिबल नहीं"
    },
    {
      "subtitle_id": 239,
      "start": 529.2,
      "end": 533.08,
      "text": "है और म्यूचुअल फंड से रिलेटेड क्रैश"
    },
    {
      "subtitle_id": 240,
      "start": 531.16,
      "end": 535.56,
      "text": "कोर्स चाहिए यह एक बहुत ही ज्यादा"
    },
    {
      "subtitle_id": 241,
      "start": 533.08,
      "end": 538.079,
      "text": "रिक्वेस्टेड कोर्स था और इसी चीज का अब हम"
    },
    {
      "subtitle_id": 242,
      "start": 535.56,
      "end": 540.279,
      "text": "सलूशन लेकर आए हैं जिसका नाम है द एडवांस"
    },
    {
      "subtitle_id": 243,
      "start": 538.079,
      "end": 542.839,
      "text": "कोर्स ऑन म्यूचुअल फंड 2 घंटे का क्रैश"
    },
    {
      "subtitle_id": 244,
      "start": 540.279,
      "end": 544.72,
      "text": "कोर्स है आपको एकदम मास्टर बना देगा यह"
    },
    {
      "subtitle_id": 245,
      "start": 542.839,
      "end": 546.36,
      "text": "आपको उस लेवल तक पहुंचा देगा कि आप सही"
    },
    {
      "subtitle_id": 246,
      "start": 544.72,
      "end": 549.2,
      "text": "म्यूचुअल फंड अपने लिए तो पिक करोगे ही"
    },
    {
      "subtitle_id": 247,
      "start": 546.36,
      "end": 550.56,
      "text": "करोगे प्लस इसके बाद आप सीधा एनएम के"
    },
    {
      "subtitle_id": 248,
      "start": 549.2,
      "end": 552.04,
      "text": "म्यूचुअल फंड डिस्ट्रीब्यूटर के एग्जाम"
    },
    {
      "subtitle_id": 249,
      "start": 550.56,
      "end": 554.76,
      "text": "देकर म्यूचुअल फंड डिस्ट्रीब्यूटर भी बन"
    },
    {
      "subtitle_id": 250,
      "start": 552.04,
      "end": 556.24,
      "text": "सकते हैं इस क्वालिटी का यह कोर्स है 100%"
    },
    {
      "subtitle_id": 251,
      "start": 554.76,
      "end": 558.68,
      "text": "प्रैक्टिकल है कोई थियोरेटिकल बातें नहीं"
    },
    {
      "subtitle_id": 252,
      "start": 556.24,
      "end": 560.44,
      "text": "है तो इस होली ₹1 799 में कोर्स लॉन्च हो"
    },
    {
      "subtitle_id": 253,
      "start": 558.68,
      "end": 562.24,
      "text": "रहा है लेकिन अब इस प्री बुकिंग ऑफर में"
    },
    {
      "subtitle_id": 254,
      "start": 560.44,
      "end": 564.68,
      "text": "आपको यह कोर्स 50 पर डिस्काउंट में मिल"
    },
    {
      "subtitle_id": 255,
      "start": 562.24,
      "end": 566.56,
      "text": "सकता है होली यह कूपन कोड यूज़ करके लेकिन"
    },
    {
      "subtitle_id": 256,
      "start": 564.68,
      "end": 568.64,
      "text": "यह जो ऑफर है यह सिर्फ अगले दो दिनों तक"
    },
    {
      "subtitle_id": 257,
      "start": 566.56,
      "end": 570.519,
      "text": "ही है और जैसे कि आपको पता है कि हमारी जो"
    },
    {
      "subtitle_id": 258,
      "start": 568.64,
      "end": 572.48,
      "text": "प्री बुकिंग ऑफर र होती है प्री लच ऑफर"
    },
    {
      "subtitle_id": 259,
      "start": 570.519,
      "end": 574.399,
      "text": "होती है वह आपको बाद में कभी नहीं मिलती"
    },
    {
      "subtitle_id": 260,
      "start": 572.48,
      "end": 577.0,
      "text": "है तो एक बार कोर्स लॉन्च हो गया तो उसके"
    },
    {
      "subtitle_id": 261,
      "start": 574.399,
      "end": 579.839,
      "text": "बाद यह प्राइस आपको कभी नहीं मिलेगी और यह"
    },
    {
      "subtitle_id": 262,
      "start": 577.0,
      "end": 582.12,
      "text": "कई गुना फिर बढ़ती चली जाती है तो इस ऑफर"
    },
    {
      "subtitle_id": 263,
      "start": 579.839,
      "end": 583.92,
      "text": "को बिल्कुल भी मिस मत कीजिए और एक कंप्लीट"
    },
    {
      "subtitle_id": 264,
      "start": 582.12,
      "end": 586.44,
      "text": "इंडिपेंडेंट म्यूचुअल फंड इन्वेस्टर बनने"
    },
    {
      "subtitle_id": 265,
      "start": 583.92,
      "end": 588.48,
      "text": "के लिए यह कोर्स जरूर लीजिए यह आपको अपने"
    },
    {
      "subtitle_id": 266,
      "start": 586.44,
      "end": 591.16,
      "text": "सारे प्लांस करने में मदद करेगा चाहे घर"
    },
    {
      "subtitle_id": 267,
      "start": 588.48,
      "end": 593.0,
      "text": "का हो गाड़ी का हो या अर्ली रिटायरमेंट का"
    },
    {
      "subtitle_id": 268,
      "start": 591.16,
      "end": 595.72,
      "text": "प्लान हो सारी चीजें म्यूचुअल फंड की मदद"
    },
    {
      "subtitle_id": 269,
      "start": 593.0,
      "end": 597.839,
      "text": "से अचीव कर सकते हैं जिसके लिए बस आपको यह"
    },
    {
      "subtitle_id": 270,
      "start": 595.72,
      "end": 600.959,
      "text": "सारी चीजें सीखने की जरूरत है ताकि आप खुद"
    },
    {
      "subtitle_id": 271,
      "start": 597.839,
      "end": 600.959,
      "text": "से यह चीजें कर पाओ"
    }
  ]
}