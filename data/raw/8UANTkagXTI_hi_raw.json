  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.12,
      "end": 4.96,
      "text": "हाउ टू सेव मनी आज की घड़ी का एक सबसे"
    },
    {
      "subtitle_id": 2,
      "start": 2.56,
      "end": 7.359,
      "text": "बड़ा प्रॉब्लम और इस प्रॉब्लम का सलूशन"
    },
    {
      "subtitle_id": 3,
      "start": 4.96,
      "end": 10.16,
      "text": "आपको इस वीडियो के एंड तक मिल जाएगा यह जो"
    },
    {
      "subtitle_id": 4,
      "start": 7.359,
      "end": 12.4,
      "text": "सलूशन है यह 100% प्रैक्टिकल सलूशन है यह"
    },
    {
      "subtitle_id": 5,
      "start": 10.16,
      "end": 12.4,
      "text": "कोई"
    },
    {
      "subtitle_id": 6,
      "start": 12.519,
      "end": 17.88,
      "text": "थोरेट्स बता सकता हूं कि इस वीडियो को"
    },
    {
      "subtitle_id": 7,
      "start": 15.2,
      "end": 19.8,
      "text": "देखने के बाद आपको कभी भी हाउ टू सेव मनी"
    },
    {
      "subtitle_id": 8,
      "start": 17.88,
      "end": 21.48,
      "text": "के बारे में सोचना ही नहीं पड़ेगा इसके"
    },
    {
      "subtitle_id": 9,
      "start": 19.8,
      "end": 23.72,
      "text": "लिए आपको सिंपली पांच प्रैक्टिकल स्टेप्स"
    },
    {
      "subtitle_id": 10,
      "start": 21.48,
      "end": 25.599,
      "text": "फॉलो करनी है नमस्कार मैं प्रसाद अपका आज"
    },
    {
      "subtitle_id": 11,
      "start": 23.72,
      "end": 27.519,
      "text": "के इस वीडियो में स्वागत करता हूं देखिए"
    },
    {
      "subtitle_id": 12,
      "start": 25.599,
      "end": 29.039,
      "text": "जो सारी चीजें मैं आपसे बहुत प्रैक्टिकली"
    },
    {
      "subtitle_id": 13,
      "start": 27.519,
      "end": 31.279,
      "text": "करवाऊंगी अभी के अभी इस वीडियो के दौरान"
    },
    {
      "subtitle_id": 14,
      "start": 29.039,
      "end": 32.88,
      "text": "ही ताकि इस वीडियो के बाद कुछ प्रॉब्लम"
    },
    {
      "subtitle_id": 15,
      "start": 31.279,
      "end": 34.92,
      "text": "हीना रहे हैं ये जो प्रॉब्लम है वीडियो के"
    },
    {
      "subtitle_id": 16,
      "start": 32.88,
      "end": 36.68,
      "text": "खत्म होते होते उसका सलूशन आपके पास आ"
    },
    {
      "subtitle_id": 17,
      "start": 34.92,
      "end": 39.239,
      "text": "जाएगा वो भी"
    },
    {
      "subtitle_id": 18,
      "start": 36.68,
      "end": 42.12,
      "text": "प्रैक्टिकली सबसे पहले स्टेप वन आपको क्या"
    },
    {
      "subtitle_id": 19,
      "start": 39.239,
      "end": 44.96,
      "text": "करना है एक डेट सिलेक्ट करनी है अब कौन सी"
    },
    {
      "subtitle_id": 20,
      "start": 42.12,
      "end": 47.28,
      "text": "डेट सिलेक्ट करें अगर आपकी सैलरी एक तारीख"
    },
    {
      "subtitle_id": 21,
      "start": 44.96,
      "end": 49.76,
      "text": "को हो रही है तो आप दो या तीन तारीख"
    },
    {
      "subtitle_id": 22,
      "start": 47.28,
      "end": 52.32,
      "text": "सिलेक्ट कर सकते हैं अगर आपकी सैलरी लेट"
    },
    {
      "subtitle_id": 23,
      "start": 49.76,
      "end": 53.8,
      "text": "से 5 तारीख को हो रही है तो आप छ या सात"
    },
    {
      "subtitle_id": 24,
      "start": 52.32,
      "end": 56.68,
      "text": "तारीख सिलेक्ट कर सकते"
    },
    {
      "subtitle_id": 25,
      "start": 53.8,
      "end": 59.48,
      "text": "हैं अगर ऐसा है कि आपकी सैलरी थोड़ी बहुत"
    },
    {
      "subtitle_id": 26,
      "start": 56.68,
      "end": 61.8,
      "text": "आगे पीछे होती है तो थोड़ी आगे की फिगर आप"
    },
    {
      "subtitle_id": 27,
      "start": 59.48,
      "end": 63.48,
      "text": "या फिर आगे के डेटा पिक कर सकते हैं यह एक"
    },
    {
      "subtitle_id": 28,
      "start": 61.8,
      "end": 66.56,
      "text": "बार आप फाइनल कर लीजिए अभी के अभी फाइनल"
    },
    {
      "subtitle_id": 29,
      "start": 63.48,
      "end": 70.24,
      "text": "कर लीजिए कमेंट करके बताइए यह फाइनल हो"
    },
    {
      "subtitle_id": 30,
      "start": 66.56,
      "end": 73.119,
      "text": "गया अब बढ़ते हैं स्टेप टू की"
    },
    {
      "subtitle_id": 31,
      "start": 70.24,
      "end": 75.119,
      "text": "तरफ स्टेप टू के लिए आपको कुछ करना है जो"
    },
    {
      "subtitle_id": 32,
      "start": 73.119,
      "end": 76.92,
      "text": "मैं आपको बाद में बताऊंगा स्टेप थ्री में"
    },
    {
      "subtitle_id": 33,
      "start": 75.119,
      "end": 79.68,
      "text": "आपको क्या करना है एक लिक्विड फंड ढूंढना"
    },
    {
      "subtitle_id": 34,
      "start": 76.92,
      "end": 81.52,
      "text": "है यह लिक्विड फंड क्या होता है यह मैं"
    },
    {
      "subtitle_id": 35,
      "start": 79.68,
      "end": 83.479,
      "text": "आपको समझाता हूं और कौन सा लिक्विड फंड है"
    },
    {
      "subtitle_id": 36,
      "start": 81.52,
      "end": 85.84,
      "text": "इसके भी ऑप्शन आपके सामने में वीडियो के"
    },
    {
      "subtitle_id": 37,
      "start": 83.479,
      "end": 88.04,
      "text": "एंड तक रख दूंगा पूरा 100% सलूशन में"
    },
    {
      "subtitle_id": 38,
      "start": 85.84,
      "end": 90.64,
      "text": "दूंगा कोई भी चीज छोडूंगा नहीं लिक्विड"
    },
    {
      "subtitle_id": 39,
      "start": 88.04,
      "end": 92.64,
      "text": "फंड मतलब क्या होता है कि एक इन्वेस्टमेंट"
    },
    {
      "subtitle_id": 40,
      "start": 90.64,
      "end": 94.479,
      "text": "एवेन्यू है एक तरीका है जहां पर आप"
    },
    {
      "subtitle_id": 41,
      "start": 92.64,
      "end": 96.72,
      "text": "टेंपररी पैसा पार कर सकते हैं ये एक"
    },
    {
      "subtitle_id": 42,
      "start": 94.479,
      "end": 99.079,
      "text": "एक्चुअल इन्वेस्टमेंट ऑप्शन नहीं है यह"
    },
    {
      "subtitle_id": 43,
      "start": 96.72,
      "end": 100.88,
      "text": "बिल्कुल सेफ ऑप्शन है टेंपररी आपका पैसा"
    },
    {
      "subtitle_id": 44,
      "start": 99.079,
      "end": 102.92,
      "text": "पार्क करने के लिए यानी साइड में रखने के"
    },
    {
      "subtitle_id": 45,
      "start": 100.88,
      "end": 104.68,
      "text": "लिए तो लिक्विड फंड में क्या है कि आपको"
    },
    {
      "subtitle_id": 46,
      "start": 102.92,
      "end": 107.439,
      "text": "कभी भी आप पैसा विड्रॉ कर सकते हैं यहां"
    },
    {
      "subtitle_id": 47,
      "start": 104.68,
      "end": 110.04,
      "text": "पर और यहां पर जैसे कि नाम में लिखा है यह"
    },
    {
      "subtitle_id": 48,
      "start": 107.439,
      "end": 111.6,
      "text": "लिक्विड है यानी कि कोई लॉकइन इसमें नहीं"
    },
    {
      "subtitle_id": 49,
      "start": 110.04,
      "end": 114.119,
      "text": "होता है कोई कुछ नहीं होता है जब चाहे"
    },
    {
      "subtitle_id": 50,
      "start": 111.6,
      "end": 115.96,
      "text": "पैसा निकाल सकते हो कोई कमीशन आपको इस पर"
    },
    {
      "subtitle_id": 51,
      "start": 114.119,
      "end": 118.64,
      "text": "नहीं लगता है अब इस लिक्विड फंड के लिए"
    },
    {
      "subtitle_id": 52,
      "start": 115.96,
      "end": 120.799,
      "text": "आपको क्या करना है एक एसआईपी शुरू करनी है"
    },
    {
      "subtitle_id": 53,
      "start": 118.64,
      "end": 123.2,
      "text": "अब ये एसआईपी शुरू कर करने के लिए आपको एक"
    },
    {
      "subtitle_id": 54,
      "start": 120.799,
      "end": 124.36,
      "text": "फ्री अकाउंट ओपन करना पड़ेगा जो कि स्टेप"
    },
    {
      "subtitle_id": 55,
      "start": 123.2,
      "end": 127.28,
      "text": "टू का पार्ट"
    },
    {
      "subtitle_id": 56,
      "start": 124.36,
      "end": 129.64,
      "text": "है फ्री अकाउंट फ्री अकाउंट के लिए आपको"
    },
    {
      "subtitle_id": 57,
      "start": 127.28,
      "end": 131.68,
      "text": "नीचे दो लिंक्स दी गई है अपॉक्स और जजल वन"
    },
    {
      "subtitle_id": 58,
      "start": 129.64,
      "end": 133.52,
      "text": "अपॉक्स जो कि मिस्टर रतन टाटा फंडेड कंपनी"
    },
    {
      "subtitle_id": 59,
      "start": 131.68,
      "end": 135.36,
      "text": "है तो ट्रस्ट का आपको ज्यादा सोचने की"
    },
    {
      "subtitle_id": 60,
      "start": 133.52,
      "end": 136.64,
      "text": "जरूरत नहीं है ट्रस्ट के बारे में जजल वन"
    },
    {
      "subtitle_id": 61,
      "start": 135.36,
      "end": 139.28,
      "text": "की बात करें तो बहुत पुरानी स्टॉप"
    },
    {
      "subtitle_id": 62,
      "start": 136.64,
      "end": 140.76,
      "text": "ब्रोकिंग कंपनी है अब ये दोनों भी ऐप आपको"
    },
    {
      "subtitle_id": 63,
      "start": 139.28,
      "end": 142.4,
      "text": "डायरेक्ट प्लांस प्रोवाइड करते हैं ये"
    },
    {
      "subtitle_id": 64,
      "start": 140.76,
      "end": 145.239,
      "text": "डायरेक्ट प्लांस क्या है ये समझना जरूरी"
    },
    {
      "subtitle_id": 65,
      "start": 142.4,
      "end": 147.4,
      "text": "है लिक्विड फंड क्या है म्यूचुअल फंड का"
    },
    {
      "subtitle_id": 66,
      "start": 145.239,
      "end": 148.72,
      "text": "एक टाइप है जो सेफ है और शॉर्ट टर्म"
    },
    {
      "subtitle_id": 67,
      "start": 147.4,
      "end": 150.48,
      "text": "इन्वेस्टमेंट के लिए या शॉर्ट टर्म पैसा"
    },
    {
      "subtitle_id": 68,
      "start": 148.72,
      "end": 152.36,
      "text": "पार करने के लिए यूज़ किया जाता है इसमें"
    },
    {
      "subtitle_id": 69,
      "start": 150.48,
      "end": 154.08,
      "text": "अगर आपको इन्वेस्ट करना है तो डायरेक्ट"
    },
    {
      "subtitle_id": 70,
      "start": 152.36,
      "end": 155.64,
      "text": "प्लान और रेगुलर प्लान ऐसे दो ऑप्शन आपको"
    },
    {
      "subtitle_id": 71,
      "start": 154.08,
      "end": 157.8,
      "text": "मिलते हैं रेगुलर प्लान में क्या है कि"
    },
    {
      "subtitle_id": 72,
      "start": 155.64,
      "end": 159.36,
      "text": "एजेंट को थोड़ा बहुत कमीशन चला जाएगा"
    },
    {
      "subtitle_id": 73,
      "start": 157.8,
      "end": 161.48,
      "text": "डायरेक्ट प्लान में कोई कमीशन नहीं जाएगा"
    },
    {
      "subtitle_id": 74,
      "start": 159.36,
      "end": 163.12,
      "text": "किसी को तो अगर आप अपॉक्स एंजल वन से ये"
    },
    {
      "subtitle_id": 75,
      "start": 161.48,
      "end": 164.4,
      "text": "करते हैं तो आपको कोई भी कमीशन देना नहीं"
    },
    {
      "subtitle_id": 76,
      "start": 163.12,
      "end": 166.04,
      "text": "पड़ता है क्योंकि वो डायरेक्ट प्लान के"
    },
    {
      "subtitle_id": 77,
      "start": 164.4,
      "end": 167.599,
      "text": "अंदर आता है इसकी लिंक आपको नीचे"
    },
    {
      "subtitle_id": 78,
      "start": 166.04,
      "end": 169.36,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में दी गई है"
    },
    {
      "subtitle_id": 79,
      "start": 167.599,
      "end": 171.239,
      "text": "तो सबसे पहले अभी आपको तुरंत अभी के अभी"
    },
    {
      "subtitle_id": 80,
      "start": 169.36,
      "end": 173.0,
      "text": "अकाउंट खोलना है 5 मिनट लगते हैं बस आपका"
    },
    {
      "subtitle_id": 81,
      "start": 171.239,
      "end": 175.239,
      "text": "मोबाइल नंबर आधार कार्ड पैन कार्ड वगैरह"
    },
    {
      "subtitle_id": 82,
      "start": 173.0,
      "end": 177.959,
      "text": "डिटेल्स आप डाल दो आपका अकाउंट 5 मिनट में"
    },
    {
      "subtitle_id": 83,
      "start": 175.239,
      "end": 178.76,
      "text": "खुल जाएगा यह जैसे ही खुल जाता है तो आपको"
    },
    {
      "subtitle_id": 84,
      "start": 177.959,
      "end": 181.8,
      "text": "वहां"
    },
    {
      "subtitle_id": 85,
      "start": 178.76,
      "end": 183.64,
      "text": "पर लिक्विड फंड के नाम टाइप करने हैं यहां"
    },
    {
      "subtitle_id": 86,
      "start": 181.8,
      "end": 186.64,
      "text": "पर देखिए एसबीआई लिक्विड फंड आईसीआई का"
    },
    {
      "subtitle_id": 87,
      "start": 183.64,
      "end": 186.64,
      "text": "प्रेंसलॉवर"
    },
    {
      "subtitle_id": 88,
      "start": 209.799,
      "end": 214.84,
      "text": "का 5 पर अमाउंट आपको इनमें से कोई भी या"
    },
    {
      "subtitle_id": 89,
      "start": 213.12,
      "end": 216.879,
      "text": "फिर और भी कोई लिक्विड फंड है जो आप चाहते"
    },
    {
      "subtitle_id": 90,
      "start": 214.84,
      "end": 219.08,
      "text": "हैं उसमें एज एन एसआईपी शुरू करने है अब"
    },
    {
      "subtitle_id": 91,
      "start": 216.879,
      "end": 221.319,
      "text": "एसआईपी की ब्यूटी क्या है पता है एसआईपी"
    },
    {
      "subtitle_id": 92,
      "start": 219.08,
      "end": 223.48,
      "text": "की ब्यूटी ये है कि जो भी अमाउंट आप"
    },
    {
      "subtitle_id": 93,
      "start": 221.319,
      "end": 225.2,
      "text": "इन्वेस्ट करेंगे वो ऑटोमेटिक डिडक्ट होती"
    },
    {
      "subtitle_id": 94,
      "start": 223.48,
      "end": 227.92,
      "text": "चली जाएगी जो भी अमाउंट आप सिलेक्ट करते"
    },
    {
      "subtitle_id": 95,
      "start": 225.2,
      "end": 230.04,
      "text": "जैसे आपने लेट से मंथली 000 सिलेक्ट कर"
    },
    {
