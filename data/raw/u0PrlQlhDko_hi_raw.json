  "parsing_issues": [],
  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.199,
      "end": 5.08,
      "text": "क्या आपको पता है कि टाटा कैपिटल एनएसी"
    },
    {
      "subtitle_id": 2,
      "start": 2.6,
      "end": 7.56,
      "text": "एचडीबी फाइनेंशियल सर्विसेस और बोट इन"
    },
    {
      "subtitle_id": 3,
      "start": 5.08,
      "end": 9.48,
      "text": "कंपनीज में क्या कॉमन है यह सारी की सारी"
    },
    {
      "subtitle_id": 4,
      "start": 7.56,
      "end": 11.719,
      "text": "अनलिस्टेड यानी प्राइवेट कंपनीज हैं जो"
    },
    {
      "subtitle_id": 5,
      "start": 9.48,
      "end": 13.4,
      "text": "अपने आईपीओ का प्लान कर रही है तो आप में"
    },
    {
      "subtitle_id": 6,
      "start": 11.719,
      "end": 16.0,
      "text": "से कितने लोग ऐसे हैं जो इन अनलिस्टेड"
    },
    {
      "subtitle_id": 7,
      "start": 13.4,
      "end": 17.92,
      "text": "कंपनीज में अभी यस अभी इन्वेस्ट करना"
    },
    {
      "subtitle_id": 8,
      "start": 16.0,
      "end": 20.16,
      "text": "चाहेंगे अब आप सोच रहे होंगे कि आपको क्या"
    },
    {
      "subtitle_id": 9,
      "start": 17.92,
      "end": 22.56,
      "text": "हो गया सर यह कंपनीज आईपीओ प्लान कर रही"
    },
    {
      "subtitle_id": 10,
      "start": 20.16,
      "end": 24.24,
      "text": "है आया तो नहीं है अगर इसका आईपीओ ही नहीं"
    },
    {
      "subtitle_id": 11,
      "start": 22.56,
      "end": 26.64,
      "text": "आया तो इसमें कैसे हम इन्वेस्ट कर सकते"
    },
    {
      "subtitle_id": 12,
      "start": 24.24,
      "end": 30.039,
      "text": "हैं जब आईपीओ आएगा तभी तो इन्वेस्ट कर"
    },
    {
      "subtitle_id": 13,
      "start": 26.64,
      "end": 32.0,
      "text": "सकते हैं राइट रॉन्ग तो आज मैं आपको ऐसे"
    },
    {
      "subtitle_id": 14,
      "start": 30.039,
      "end": 34.04,
      "text": "चीज के बारे में बताऊंगा जिससे आपको आईपीओ"
    },
    {
      "subtitle_id": 15,
      "start": 32.0,
      "end": 36.52,
      "text": "का वेट नहीं करना पड़ेगा और कंपनी में आप"
    },
    {
      "subtitle_id": 16,
      "start": 34.04,
      "end": 39.16,
      "text": "आईपीओ से पहले भी इन्वेस्ट कर पाओगे तो आप"
    },
    {
      "subtitle_id": 17,
      "start": 36.52,
      "end": 41.0,
      "text": "पूछेंगे कैसे इंजल इन्वेस्टर बन के नहीं"
    },
    {
      "subtitle_id": 18,
      "start": 39.16,
      "end": 43.28,
      "text": "नहीं उसी के बारे में इस वीडियो में हम"
    },
    {
      "subtitle_id": 19,
      "start": 41.0,
      "end": 45.079,
      "text": "बात करेंगे वो भी बहुत डिटेल में और यह भी"
    },
    {
      "subtitle_id": 20,
      "start": 43.28,
      "end": 47.0,
      "text": "जानेंगे कि आईओ के पहले इन्वेस्ट करने का"
    },
    {
      "subtitle_id": 21,
      "start": 45.079,
      "end": 48.92,
      "text": "प्रोसेस क्या है और आप कौन से प्लेटफॉर्म"
    },
    {
      "subtitle_id": 22,
      "start": 47.0,
      "end": 51.0,
      "text": "से ये शेयर्स खरीद सकते हो क्या ऑनलाइन"
    },
    {
      "subtitle_id": 23,
      "start": 48.92,
      "end": 52.96,
      "text": "खरीदना पॉसिबल है और आईपीओ से पहले"
    },
    {
      "subtitle_id": 24,
      "start": 51.0,
      "end": 54.399,
      "text": "इन्वेस्ट करने में क्या-क्या रिस्क है तो"
    },
    {
      "subtitle_id": 25,
      "start": 52.96,
      "end": 55.8,
      "text": "इन सारे पॉइंट्स के बारे में आज के इस"
    },
    {
      "subtitle_id": 26,
      "start": 54.399,
      "end": 57.92,
      "text": "वीडियो में हम डिटेल में बात करने वाले"
    },
    {
      "subtitle_id": 27,
      "start": 55.8,
      "end": 60.28,
      "text": "हैं तो एक ऑल इन वन टाइप का वीडियो आज का"
    },
    {
      "subtitle_id": 28,
      "start": 57.92,
      "end": 62.28,
      "text": "यह होने वाला है वीडियो शुरू करने से पहले"
    },
    {
      "subtitle_id": 29,
      "start": 60.28,
      "end": 64.0,
      "text": "आपसे रिक्वेस्ट है कि फश की वीडियो आपको"
    },
    {
      "subtitle_id": 30,
      "start": 62.28,
      "end": 65.88,
      "text": "पसंद आ रहे हैं तो जरूर इन्हें अपने"
    },
    {
      "subtitle_id": 31,
      "start": 64.0,
      "end": 67.799,
      "text": "दोस्तों के साथ भी शेयर करें ताकि उनके"
    },
    {
      "subtitle_id": 32,
      "start": 65.88,
      "end": 69.68,
      "text": "पास भी फाइनेंशियल नॉलेज पहुंच सके वो भी"
    },
    {
      "subtitle_id": 33,
      "start": 67.799,
      "end": 71.04,
      "text": "फाइनेंशियल अवेयर हो जाए और नीचे देख ही"
    },
    {
      "subtitle_id": 34,
      "start": 69.68,
      "end": 72.56,
      "text": "रहे हो तो सब्सक्राइब बटन भी देख लेना"
    },
    {
      "subtitle_id": 35,
      "start": 71.04,
      "end": 74.28,
      "text": "आपने चैनल को सब्सक्राइब किया है कि नहीं"
    },
    {
      "subtitle_id": 36,
      "start": 72.56,
      "end": 76.08,
      "text": "किया है और अगर नहीं किया है तो वहां पर"
    },
    {
      "subtitle_id": 37,
      "start": 74.28,
      "end": 78.04,
      "text": "सब्सक्राइब बटन पर क्लिक कीजिए और बेल"
    },
    {
      "subtitle_id": 38,
      "start": 76.08,
      "end": 80.079,
      "text": "आइकॉन पर भी क्लिक कीजिए ताकि हमारे सारे"
    },
    {
      "subtitle_id": 39,
      "start": 78.04,
      "end": 82.68,
      "text": "क्वालिटी वीडियोस की नोटिफिकेशंस भी आपको"
    },
    {
      "subtitle_id": 40,
      "start": 80.079,
      "end": 84.159,
      "text": "मिलती रहे नमस्कार मैं प्रसाद आपका आज के"
    },
    {
      "subtitle_id": 41,
      "start": 82.68,
      "end": 86.04,
      "text": "इस वीडियो में स्वागत करता हूं तो सबसे"
    },
    {
      "subtitle_id": 42,
      "start": 84.159,
      "end": 88.079,
      "text": "पहला सवाल है कि आखिर इन कंपनीज के शेयर्स"
    },
    {
      "subtitle_id": 43,
      "start": 86.04,
      "end": 90.28,
      "text": "को कहते क्या है अब ये अनलिस्टेड शेयर्स"
    },
    {
      "subtitle_id": 44,
      "start": 88.079,
      "end": 92.399,
      "text": "कह लो ओवर द काउंटर शेयर्स कह लो प्राइवेट"
    },
    {
      "subtitle_id": 45,
      "start": 90.28,
      "end": 94.92,
      "text": "शेयर्स कह लो या फिर ऑफ मार्केट शेयर्स कह"
    },
    {
      "subtitle_id": 46,
      "start": 92.399,
      "end": 96.96,
      "text": "लो इन सबका मतलब एक ही है कि यह उन कंपनीज"
    },
    {
      "subtitle_id": 47,
      "start": 94.92,
      "end": 98.88,
      "text": "के शेयर्स हैं जो इंडिया के जो स्टॉक"
    },
    {
      "subtitle_id": 48,
      "start": 96.96,
      "end": 101.119,
      "text": "एक्सचेंज से है जैसे कि एनएससी और बीएससी"
    },
    {
      "subtitle_id": 49,
      "start": 98.88,
      "end": 102.799,
      "text": "इन पर लिस्टेड नहीं है तो सवाल यह कि ये"
    },
    {
      "subtitle_id": 50,
      "start": 101.119,
      "end": 105.88,
      "text": "जो अनलिस्टेड शेयर्स है क्या इन्हें एक आम"
    },
    {
      "subtitle_id": 51,
      "start": 102.799,
      "end": 107.759,
      "text": "नागरिक खरीद सकता है तो जवाब है हां और"
    },
    {
      "subtitle_id": 52,
      "start": 105.88,
      "end": 110.28,
      "text": "सिर्फ खरीद ही नहीं सकते जो अनलिस्टेड"
    },
    {
      "subtitle_id": 53,
      "start": 107.759,
      "end": 111.84,
      "text": "शेयर्स आपने खरीदे हैं वह आपके डिपॉजिटरी"
    },
    {
      "subtitle_id": 54,
      "start": 110.28,
      "end": 114.0,
      "text": "अकाउंट में रिफ्लेक्ट होंगे बिल्कुल उसी"
    },
    {
      "subtitle_id": 55,
      "start": 111.84,
      "end": 115.56,
      "text": "तरह जिस तरह से लिस्टेड शेयर्स होते हैं"
    },
    {
      "subtitle_id": 56,
      "start": 114.0,
      "end": 117.52,
      "text": "क्योंकि मिनिस्ट्री ऑफ कॉर्पोरेट अफेयर्स"
    },
    {
      "subtitle_id": 57,
      "start": 115.56,
      "end": 120.039,
      "text": "के मुताबिक अनलिस्टेड कंपनीज के शेयर्स भी"
    },
    {
      "subtitle_id": 58,
      "start": 117.52,
      "end": 121.759,
      "text": "अब डीमेट फॉर्म में होंगे और बायर के डीम"
    },
    {
      "subtitle_id": 59,
      "start": 120.039,
      "end": 123.36,
      "text": "अकाउंट में रिफ्लेक्ट भी होंगे अब जो"
    },
    {
      "subtitle_id": 60,
      "start": 121.759,
      "end": 125.039,
      "text": "एमसीए यानी मिनिस्ट्री ऑफ कॉर्पोरेट"
    },
    {
      "subtitle_id": 61,
      "start": 123.36,
      "end": 127.32,
      "text": "अफेयर्स है यह टाइम टू टाइम नए-नए"
    },
    {
      "subtitle_id": 62,
      "start": 125.039,
      "end": 129.28,
      "text": "रेगुलेशंस लाते रहते हैं अनलिस्टेड कंपनीज"
    },
    {
      "subtitle_id": 63,
      "start": 127.32,
      "end": 131.319,
      "text": "के लिए जिसमें से एक स्क्रीन पर आप देख"
    },
    {
      "subtitle_id": 64,
      "start": 129.28,
      "end": 133.08,
      "text": "सकते हो एमसी की रूलिंग के बारे में भी अब"
    },
    {
      "subtitle_id": 65,
      "start": 131.319,
      "end": 134.68,
      "text": "यह बात हो रही है कि जो अनलिस्टेड शेयर्स"
    },
    {
      "subtitle_id": 66,
      "start": 133.08,
      "end": 136.68,
      "text": "हैं उनके लिए भी जो फाइनेंशियल्स हैं"
    },
    {
      "subtitle_id": 67,
      "start": 134.68,
      "end": 139.08,
      "text": "उन्हें क्वार्टरली रिलीज करना मैंडेटरी"
    },
    {
      "subtitle_id": 68,
      "start": 136.68,
      "end": 140.92,
      "text": "बनाया जा सकता है जैसे कि लिस्टेड कंपनीज"
    },
    {
      "subtitle_id": 69,
      "start": 139.08,
      "end": 142.64,
      "text": "के केस में होता है और ये जो अनलिस्टेड"
    },
    {
      "subtitle_id": 70,
      "start": 140.92,
      "end": 144.239,
      "text": "कंपनीज के फाइनेंशियल रिजल्ट्स हैं वह"
    },
    {
      "subtitle_id": 71,
      "start": 142.64,
      "end": 146.28,
      "text": "आपको प्री साइज की वेबसाइट पर भी मिल"
    },
    {
      "subtitle_id": 72,
      "start": 144.239,
      "end": 148.36,
      "text": "जाएंगे तो अनलिस्टेड कैटेगरी की बात करें"
    },
    {
      "subtitle_id": 73,
      "start": 146.28,
      "end": 150.519,
      "text": "तो डजन ऑफ कंपनीज आपको इस कैटेगरी में मिल"
    },
    {
      "subtitle_id": 74,
      "start": 148.36,
      "end": 152.16,
      "text": "जाएगी जैसे कि अगर मैं प्र इस प्लेटफॉर्म"
    },
    {
      "subtitle_id": 75,
      "start": 150.519,
      "end": 154.4,
      "text": "पर देखूं तो यहां पर बहुत सारे अनलिस्टेड"
    },
    {
      "subtitle_id": 76,
      "start": 152.16,
      "end": 156.319,
      "text": "शेयर्स देखने को मिलते हैं इसके अलावा कैप"
    },
    {
      "subtitle_id": 77,
      "start": 154.4,
      "end": 158.44,
      "text": "जमनाय जो कि फ्रांस की एक बहुत बड़ी आईटी"
    },
    {
      "subtitle_id": 78,
      "start": 156.319,
      "end": 160.599,
      "text": "कंपनी है उसके शेयर्स आपको मिलते हैं बीरा"
    },
    {
      "subtitle_id": 79,
      "start": 158.44,
      "end": 163.76,
      "text": "भी आपको यहां मिलेगी अमन गुप्ता की बोट"
    },
    {
      "subtitle_id": 80,
      "start": 160.599,
      "end": 165.68,
      "text": "ओयो टपारिया टूल्स एनसी टा कैपिटल और भी"
    },
    {
      "subtitle_id": 81,
      "start": 163.76,
      "end": 168.0,
      "text": "बहुत सारी कंपनीज आप स्क्रीन पर देख सकते"
    },
    {
      "subtitle_id": 82,
      "start": 165.68,
      "end": 171.319,
      "text": "हो अब कुछ लोगों के मन में यह बात आ रही"
    },
    {
      "subtitle_id": 83,
      "start": 168.0,
      "end": 173.44,
      "text": "होगी कि ऑलरेडी एनएसी पर लगभग 2300 कंपनीज"
    },
    {
      "subtitle_id": 84,
      "start": 171.319,
      "end": 176.04,
      "text": "लिस्टेड हैं बॉम्बे स्टॉक एक्सचेंज पर"
    },
    {
      "subtitle_id": 85,
      "start": 173.44,
      "end": 177.8,
      "text": "5500 से ज्यादा कंपनीज लिस्टेड हैं इसके"
    },
    {
      "subtitle_id": 86,
      "start": 176.04,
      "end": 179.28,
      "text": "अलावा गोल्ड का ऑप्शन है म्यूचुअल फंड्स"
    },
    {
      "subtitle_id": 87,
      "start": 177.8,
      "end": 181.44,
      "text": "का ऑप्शन है और भी कई प्रकार के"
    },
    {
      "subtitle_id": 88,
      "start": 179.28,
      "end": 183.08,
      "text": "इन्वेस्टमेंट ऑप्शंस है तो फिर आखिर में"
    },
    {
      "subtitle_id": 89,
      "start": 181.44,
      "end": 185.44,
      "text": "अनलिस्टेड शेयर्स की तरफ देखना क्यों"
    },
    {
      "subtitle_id": 90,
      "start": 183.08,
      "end": 187.0,
      "text": "जरूरी है यह सवाल वाजिब भी है लेकिन"
    },
    {
      "subtitle_id": 91,
      "start": 185.44,
      "end": 189.2,
      "text": "अनलिस्टेड शेयर्स में इन्वेस्ट करने के"
    },
    {
      "subtitle_id": 92,
      "start": 187.0,
      "end": 190.84,
      "text": "कुछ ऐसे भी फायदे हैं जिसकी वजह से रिसेंट"
    },
    {
      "subtitle_id": 93,
      "start": 189.2,
      "end": 192.68,
      "text": "टाइम में कई सारे इन्वेस्टर्स इसकी तरफ"
    },
    {
      "subtitle_id": 94,
      "start": 190.84,
      "end": 194.76,
      "text": "आकर्षित हो रहे हैं अब वो कारण क्या है"
    },
    {
      "subtitle_id": 95,
      "start": 192.68,
      "end": 197.12,
      "text": "मैं एक-एक करके गिना आता हूं सबसे पहला"
    },
    {
      "subtitle_id": 96,
      "start": 194.76,
      "end": 198.959,
      "text": "रीजन है रिटर्न्स यस क्योंकि इन्वेस्टमेंट"
    },
    {
      "subtitle_id": 97,
      "start": 197.12,
      "end": 200.879,
      "text": "का एक मात्र उद्देश्य ही रिटर्न्स होता है"
    },
    {
      "subtitle_id": 98,
      "start": 198.959,
      "end": 202.68,
      "text": "अगर हम अनलिस्टेड शेयर्स के पास्ट के कुछ"
    },
    {
      "subtitle_id": 99,
      "start": 200.879,
      "end": 204.159,
      "text": "एग्जांपल्स देखें तो कुछ केसेस में"
    },
    {
      "subtitle_id": 100,
      "start": 202.68,
      "end": 206.159,
      "text": "रिटर्न्स इतने क्रेजी मिले हैं कि आप"
    },
    {
      "subtitle_id": 101,
      "start": 204.159,
      "end": 208.159,
      "text": "बिलीव नहीं करेंगे अब दूसरा कारण बहुत"
    },
    {
      "subtitle_id": 102,
      "start": 206.159,
      "end": 210.56,
      "text": "इंटरेस्टिंग है कि जो अच्छे आईपीओ है वो"
    },
    {
      "subtitle_id": 103,
      "start": 208.159,
      "end": 212.36,
      "text": "मिलना नेक्स्ट टू इंपॉसिबल हो चुका है 808"
    },
    {
      "subtitle_id": 104,
      "start": 210.56,
      "end": 214.12,
      "text": "100 100 टाइम्स आईपीओ सब्सक्राइब होते हैं"
    },
    {
      "subtitle_id": 105,
      "start": 212.36,
      "end": 216.4,
      "text": "तो 100 में से एक की प्रोबेबिलिटी आपकी"
    },
    {
      "subtitle_id": 106,
      "start": 214.12,
      "end": 218.64,
      "text": "बनती है तो चांसेस आपके नहीं के बराबर हो"
    },
    {
      "subtitle_id": 107,
      "start": 216.4,
      "end": 220.68,
      "text": "जाते हैं कुछ लोगों के तो आईपीओ के मामले"
    },
    {
      "subtitle_id": 108,
      "start": 218.64,
      "end": 222.239,
      "text": "में किस्मत इतनी खराब है कि 20-25 आईपीओ"
    },
    {
      "subtitle_id": 109,
      "start": 220.68,
      "end": 224.12,
      "text": "में अप्लाई करने के बाद भी एक भी आईपीओ"
    },
    {
      "subtitle_id": 110,
      "start": 222.239,
      "end": 225.84,
      "text": "उन्हें अलॉट नहीं हुआ है अगर आप में से"
    },
    {
      "subtitle_id": 111,
      "start": 224.12,
      "end": 228.48,
      "text": "किसी के साथ इस तरह की सिचुएशन हुई है तो"
    },
    {
      "subtitle_id": 112,
      "start": 225.84,
      "end": 230.36,
      "text": "कमेंट करके जरूर बताइए और मैं भी एक्टिवली"
    },
    {
      "subtitle_id": 113,
      "start": 228.48,
      "end": 232.36,
      "text": "आईपीओ में अप्लाई करता हूं बट यू नो मोस्ट"
    },
    {
      "subtitle_id": 114,
      "start": 230.36,
      "end": 234.36,
      "text": "ऑफ द टाइम वही प्रॉब्लम आती है और अगर"
    },
    {
      "subtitle_id": 115,
      "start": 232.36,
      "end": 237.0,
      "text": "एसएम आईपीओ की बात करें तो वो तो एक अलग"
    },
    {
      "subtitle_id": 116,
      "start": 234.36,
      "end": 239.28,
      "text": "ही यूनिवर्स है जहां पर बहुत ही क्रेजी"
    },
    {
      "subtitle_id": 117,
      "start": 237.0,
      "end": 241.2,
      "text": "लेवल पर सब्सक्रिप्शन आता है तो मैं तो"
    },
    {
      "subtitle_id": 118,
      "start": 239.28,
      "end": 243.72,
      "text": "पर्सन लिए किसी एक बंदे को नहीं जानता"
    },
    {
      "subtitle_id": 119,
      "start": 241.2,
      "end": 245.72,
      "text": "जिसमें एसएमई में आईपीओ अलट हुआ हो अगर"
    },
    {
      "subtitle_id": 120,
      "start": 243.72,
      "end": 247.599,
      "text": "आपको एएमए में कोई आईओ लगा है तो कमेंट"
    },
    {
      "subtitle_id": 121,
      "start": 245.72,
      "end": 250.2,
      "text": "करके जरूर बताइए कौन सा लगा है और कब लगा"
    },
    {
      "subtitle_id": 122,
      "start": 247.599,
      "end": 251.879,
      "text": "है और कितने आईपीओ लगाने के बाद लगा है तो"
    },
    {
      "subtitle_id": 123,
      "start": 250.2,
      "end": 253.84,
      "text": "इसमें एक अच्छी स्ट्रेटेजी आप यह बना सकते"
    },
    {
      "subtitle_id": 124,
      "start": 251.879,
      "end": 255.959,
      "text": "हो कि अब आपको लगता है कि कोई कंपनी है"
    },
    {
      "subtitle_id": 125,
      "start": 253.84,
      "end": 257.56,
      "text": "जिसका आईपीओ आ रहा है फंडामेंटली और सारी"
    },
    {
      "subtitle_id": 126,
      "start": 255.959,
      "end": 259.44,
      "text": "चीजों की वजह से लिस्टिंग गेन के हिसाब से"
    },
    {
      "subtitle_id": 127,
      "start": 257.56,
      "end": 261.32,
      "text": "वो काफी अच्छी हो सकती है और उसके"
    },
    {
      "subtitle_id": 128,
      "start": 259.44,
      "end": 263.08,
      "text": "अनलिस्टेड शेयर्स आपको मिल जाते हैं तो"
    },
    {
      "subtitle_id": 129,
      "start": 261.32,
      "end": 265.24,
      "text": "वहां पर काफी सारे लोग अनलिस्टेड शेयर्स"
    },
    {
      "subtitle_id": 130,
      "start": 263.08,
      "end": 267.12,
      "text": "के जरिए एंट्री ले लेते हैं और फिर लिस्ट"
    },
    {
      "subtitle_id": 131,
      "start": 265.24,
      "end": 269.0,
      "text": "होने के बाद उसका फायदा उठाते हैं अब बात"
    },
    {
      "subtitle_id": 132,
      "start": 267.12,
      "end": 270.68,
      "text": "आती है कि इनमें इन्वेस्ट कैसे करें तो"
    },
    {
      "subtitle_id": 133,
      "start": 269.0,
      "end": 272.52,
      "text": "आपको बता दूं कि कि अनलिस्टेड शेयर्स में"
    },
    {
      "subtitle_id": 134,
      "start": 270.68,
      "end": 274.759,
      "text": "इन्वेस्ट करना पहले बहुत मुश्किल हुआ करता"
    },
    {
      "subtitle_id": 135,
      "start": 272.52,
      "end": 276.56,
      "text": "था ज्यादातर जो डीलिंग अनलिस्टेड शेयर्स"
    },
    {
      "subtitle_id": 136,
      "start": 274.759,
      "end": 278.759,
      "text": "में होती थी वो ग्रे मार्केट में ओवर द"
    },
    {
      "subtitle_id": 137,
      "start": 276.56,
      "end": 281.0,
      "text": "काउंटर होती थी जिसकी वजह से काफी लोगों"
    },
    {
      "subtitle_id": 138,
      "start": 278.759,
      "end": 283.08,
      "text": "को एक डर रहता था कि यह प्रोसेस सेफ है कि"
    },
    {
      "subtitle_id": 139,
      "start": 281.0,
      "end": 284.8,
      "text": "नहीं लेकिन अब टेक्नोलॉजी काफी एडवांस हो"
    },
    {
      "subtitle_id": 140,
      "start": 283.08,
      "end": 287.12,
      "text": "चुकी है तो अनलिस्टेड शेयर्स आज की डेट"
    },
    {
      "subtitle_id": 141,
      "start": 284.8,
      "end": 289.199,
      "text": "में अब ऑनलाइन भी खरीद सकते हो सेफ और"
    },
    {
      "subtitle_id": 142,
      "start": 287.12,
      "end": 291.4,
      "text": "सिक्योर तरीके से अब सवाल यह आता है कि"
    },
    {
      "subtitle_id": 143,
      "start": 289.199,
      "end": 293.44,
      "text": "कहां से खरीदें तो प्री साइज एक काफी"
    },
    {
      "subtitle_id": 144,
      "start": 291.4,
      "end": 295.32,
      "text": "अच्छा प्लेटफॉर्म है जहां पर आप बड़े ही"
    },
    {
      "subtitle_id": 145,
      "start": 293.44,
      "end": 297.52,
      "text": "आसानी से और ट्रस्ट के साथ अनलिस्टेड"
    },
    {
      "subtitle_id": 146,
      "start": 295.32,
      "end": 300.0,
      "text": "शेयर्स खरीद सकते हो आप स्क्रीन पर देख"
    },
    {
      "subtitle_id": 147,
      "start": 297.52,
      "end": 301.759,
      "text": "सकते हो कि प्रेसा इज पर आपको ढेर सारी"
    },
    {
      "subtitle_id": 148,
      "start": 300.0,
      "end": 303.68,
      "text": "कंपनीज के ऑप्शंस मिल जाएंगे लेट्स"
    },
    {
      "subtitle_id": 149,
      "start": 301.759,
      "end": 305.759,
      "text": "एक्सप्लोर बोट के अनलिस्टेड शेयर्स अब"
    },
    {
      "subtitle_id": 150,
      "start": 303.68,
      "end": 307.56,
      "text": "प्रिसा इज की एक बात मुझे बहुत अच्छी लगी"
    },
    {
      "subtitle_id": 151,
      "start": 305.759,
      "end": 309.56,
      "text": "कि वहां पर आपको रिसर्च रिपोर्ट के सेक्शन"
    },
    {
      "subtitle_id": 152,
      "start": 307.56,
      "end": 311.72,
      "text": "में बोट पर एक डिटेल रिसर्च रिपोर्ट देखने"
    },
    {
      "subtitle_id": 153,
      "start": 309.56,
      "end": 313.84,
      "text": "मिलेगी इसमें पहले पेज पर आपको सेक्टर का"
    },
    {
      "subtitle_id": 154,
      "start": 311.72,
      "end": 315.96,
      "text": "पूरा डाटा मिलेगा पर यह तो सिर्फ शुरुआत"
    },
    {
      "subtitle_id": 155,
      "start": 313.84,
      "end": 317.6,
      "text": "है यहां पर आपको पूरा मार्केट डाटा मिलेगा"
    },
    {
      "subtitle_id": 156,
      "start": 315.96,
      "end": 319.639,
      "text": "प्रोडक्ट्स कैटेगरी की जानकारी है"
    },
    {
      "subtitle_id": 157,
      "start": 317.6,
      "end": 321.759,
      "text": "मैनेजमेंट की पूरी लिस्ट है फाइनेंशियल"
    },
    {
      "subtitle_id": 158,
      "start": 319.639,
      "end": 323.759,
      "text": "डाटा है फिर सारे इंपॉर्टेंट रेश्योस"
    },
    {
      "subtitle_id": 159,
      "start": 321.759,
      "end": 325.96,
      "text": "कंपीटीटर्स की पूरी लिस्ट शेयर होल्डिंग"
    },
    {
      "subtitle_id": 160,
      "start": 323.759,
      "end": 328.199,
      "text": "पैटर्न की पूरी जानकारी फंडिंग की पूरी"
    },
    {
      "subtitle_id": 161,
      "start": 325.96,
      "end": 330.199,
      "text": "जानकारी है और भी कई सारी जानकारी आपको इस"
    },
    {
      "subtitle_id": 162,
      "start": 328.199,
      "end": 331.96,
      "text": "रिपोर्ट में मिल जाएगी इस इसी तरह अगर आप"
    },
    {
      "subtitle_id": 163,
      "start": 330.199,
      "end": 333.72,
      "text": "इनकी वेबसाइट पर जाकर अलग-अलग कंपनीज पर"
    },
    {
      "subtitle_id": 164,
      "start": 331.96,
      "end": 335.4,
      "text": "जाते हो तो इसी तरह की डिटेल रिसर्च"
    },
    {
      "subtitle_id": 165,
      "start": 333.72,
      "end": 337.759,
      "text": "रिपोर्ट आपको वहां पर पता चलेगी पढ़ने"
    },
    {
      "subtitle_id": 166,
      "start": 335.4,
      "end": 339.44,
      "text": "मिलेगी वो पढ़ने के बाद उसका डिटेल"
    },
    {
      "subtitle_id": 167,
      "start": 337.759,
      "end": 341.479,
      "text": "एनालिसिस करके उसका वैल्यूएशन निकाल के"
    },
    {
      "subtitle_id": 168,
      "start": 339.44,
      "end": 343.319,
      "text": "फिर आप आसानी से डिसाइड कर सकते हो कि"
    },
    {
      "subtitle_id": 169,
      "start": 341.479,
      "end": 345.4,
      "text": "वेदर टू इन्वेस्ट इन दैट अनलिस्टेड कंपनी"
    },
    {
      "subtitle_id": 170,
      "start": 343.319,
      "end": 346.8,
      "text": "र नॉट इसके अलावा कंपनी के पिछले कुछ"
    },
    {
      "subtitle_id": 171,
      "start": 345.4,
      "end": 348.759,
      "text": "सालों के फाइनेंशियल रिपोर्ट्स भी आपको"
    },
    {
      "subtitle_id": 172,
      "start": 346.8,
      "end": 350.28,
      "text": "वहां पर पढ़ने मिल जाएंगे इसके बाद एक"
    },
    {
      "subtitle_id": 173,
      "start": 348.759,
      "end": 352.36,
      "text": "न्यूज़ का सेक्शन आपको वहां पर देखने"
    },
    {
      "subtitle_id": 174,
      "start": 350.28,
      "end": 354.479,
      "text": "मिलता है जहां आपको सारी उस कंपनी से"
    },
    {
      "subtitle_id": 175,
      "start": 352.36,
      "end": 356.08,
      "text": "रिलेटेड लेटेस्ट न्यूज़ देखने मिलती है"
    },
    {
      "subtitle_id": 176,
      "start": 354.479,
      "end": 358.36,
      "text": "यहां पर इन्वेस्ट करने की प्रोसेस बहुत"
    },
    {
      "subtitle_id": 177,
      "start": 356.08,
      "end": 360.08,
      "text": "सिंपल है और हां बाय करते ही शेयर्स आपके"
    },
    {
      "subtitle_id": 178,
      "start": 358.36,
      "end": 362.28,
      "text": "डीपी यानी डिपॉजिटरी पार्ट पार्टिसिपेंट"
    },
    {
      "subtitle_id": 179,
      "start": 360.08,
      "end": 364.12,
      "text": "अकाउंट में 24 टू 48 आवर्स के अंदर"
    },
    {
      "subtitle_id": 180,
      "start": 362.28,
      "end": 366.16,
      "text": "रिफ्लेक्ट हो जाएंगे मतलब आपके डीमेट"
    },
    {
      "subtitle_id": 181,
      "start": 364.12,
      "end": 368.599,
      "text": "अकाउंट में वो आपको देखना शुरू हो जाएंगे"
    },
    {
      "subtitle_id": 182,
      "start": 366.16,
      "end": 370.599,
      "text": "और अगर आपको फ्यूचर में उस कंपनी के शेयर"
    },
    {
      "subtitle_id": 183,
      "start": 368.599,
      "end": 372.599,
      "text": "सेल करने हैं तो आप प्रिसा इज के सेलिंग"
    },
    {
      "subtitle_id": 184,
      "start": 370.599,
      "end": 374.52,
      "text": "स्पेशलिस्ट से कनेक्ट कर सकते हो वो आपकी"
    },
    {
      "subtitle_id": 185,
      "start": 372.599,
      "end": 376.319,
      "text": "मदद सेलिंग प्रोसेस को स्मूथली कंप्लीट"
    },
    {
      "subtitle_id": 186,
      "start": 374.52,
      "end": 377.759,
      "text": "करने में करेंगे इसके अलावा यहां पर"
    },
    {
      "subtitle_id": 187,
      "start": 376.319,
      "end": 379.08,
      "text": "इन्वेस्ट करने के लिए आपको लाखों करोड़ों"
    },
    {
      "subtitle_id": 188,
      "start": 377.759,
      "end": 381.16,
      "text": "रुपए होने की जरूरत नहीं है मात्र"
    },
    {
      "subtitle_id": 189,
      "start": 379.08,
      "end": 383.599,
      "text": "₹1000000 से भी आप प्रि साइज पर अनलिस्टेड"
    },
    {
      "subtitle_id": 190,
      "start": 381.16,
      "end": 385.28,
      "text": "शेयर्स में इन्वेस्टमेंट शुरू कर सकते हो"
    },
    {
      "subtitle_id": 191,
      "start": 383.599,
      "end": 386.96,
      "text": "सिमिलरली अगर आपको किसी कंपनी को लेकर"
    },
    {
      "subtitle_id": 192,
      "start": 385.28,
      "end": 389.28,
      "text": "डाउट या क्वेरी है तो आप प्रिसा के"
    },
    {
      "subtitle_id": 193,
      "start": 386.96,
      "end": 391.24,
      "text": "स्पेशलिस्ट से चैट कॉल या फिर टेक्स्ट"
    },
    {
      "subtitle_id": 194,
      "start": 389.28,
      "end": 392.84,
      "text": "करके अपनी बात कर सकते हो तो अगर आप"
    },
    {
      "subtitle_id": 195,
      "start": 391.24,
      "end": 394.44,
      "text": "अनलिस्टेड शेयर्स में इन्वेस्ट करना चाहते"
    },
    {
      "subtitle_id": 196,
      "start": 392.84,
      "end": 396.12,
      "text": "हो अनलिस्टेड कंपनीज को एक्सप्लोर करना"
    },
    {
      "subtitle_id": 197,
      "start": 394.44,
      "end": 397.44,
      "text": "चाहते हो तो प्रिसा इज का लिंक आपको नीचे"
    },
    {
      "subtitle_id": 198,
      "start": 396.12,
      "end": 399.8,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में मिल"
    },
    {
      "subtitle_id": 199,
      "start": 397.44,
      "end": 402.039,
      "text": "जाएगा अब कैसे इन्वेस्ट करना है यह तो समझ"
    },
    {
      "subtitle_id": 200,
      "start": 399.8,
      "end": 404.44,
      "text": "लिया लेकिन यह समझना भी बहुत जरूरी है कि"
    },
    {
      "subtitle_id": 201,
      "start": 402.039,
      "end": 406.919,
      "text": "ये जो अनलिस्टेड कंपनीज हैं इनसे रिलेटेड"
    },
    {
      "subtitle_id": 202,
      "start": 404.44,
      "end": 408.96,
      "text": "क्या कुछ रिस्क होती है अगर हम अनलिस्टेड"
    },
    {
      "subtitle_id": 203,
      "start": 406.919,
      "end": 410.919,
      "text": "शेयर्स का रिस्क लिस्टेड कंपनी से कंपेयर"
    },
    {
      "subtitle_id": 204,
      "start": 408.96,
      "end": 413.039,
      "text": "करें तो अनलिस्टेड शेयर्स रिलेटिवली"
    },
    {
      "subtitle_id": 205,
      "start": 410.919,
      "end": 414.72,
      "text": "ज्यादा रिस्की होते हैं इसका मेन रीजन यह"
    },
    {
      "subtitle_id": 206,
      "start": 413.039,
      "end": 416.44,
      "text": "है कि जो लिस्टेड कंपनीज होती है उन्हें"
    },
    {
      "subtitle_id": 207,
      "start": 414.72,
      "end": 418.72,
      "text": "सेबी यानी सिक्योरिटीज एंड एक्सचेंज बोर्ड"
    },
    {
      "subtitle_id": 208,
      "start": 416.44,
      "end": 420.759,
      "text": "ऑफ इंडिया काफी क्लोजी रेगुलेट करती है"
    },
    {
      "subtitle_id": 209,
      "start": 418.72,
      "end": 423.44,
      "text": "जबकि जो अन स्टेड कंपनीज है वो सेबी के"
    },
    {
      "subtitle_id": 210,
      "start": 420.759,
      "end": 425.0,
      "text": "अंडर नहीं आती वो आती है एमसीए के अंडर इस"
    },
    {
      "subtitle_id": 211,
      "start": 423.44,
      "end": 427.68,
      "text": "वजह से इन्वेस्टर्स के लिए यहां पर थोड़ा"
    },
    {
      "subtitle_id": 212,
      "start": 425.0,
      "end": 429.24,
      "text": "रिस्क बढ़ जाता है अगर आईपीओ आ भी गया तो"
    },
    {
      "subtitle_id": 213,
      "start": 427.68,
      "end": 431.36,
      "text": "उस केस में सिक्स मंथ्स का एक लॉकइन"
    },
    {
      "subtitle_id": 214,
      "start": 429.24,
      "end": 433.8,
      "text": "पीरियड होता है मतलब आईपीओ लिस्टिंग के 6"
    },
    {
      "subtitle_id": 215,
      "start": 431.36,
      "end": 435.44,
      "text": "महीने बाद ही आप अपने शेयर्स बेच पाओगे ये"
    },
    {
      "subtitle_id": 216,
      "start": 433.8,
      "end": 437.24,
      "text": "जो सारे रूल्स है ये प्रमोटर्स के हिसाब"
    },
    {
      "subtitle_id": 217,
      "start": 435.44,
      "end": 438.8,
      "text": "से बनाए गए हैं कंपनी का जो मैनेजमेंट है"
    },
    {
      "subtitle_id": 218,
      "start": 437.24,
      "end": 441.08,
      "text": "कंपनी के ओनर्स हैं उनके हिसाब से बनाया"
    },
    {
      "subtitle_id": 219,
      "start": 438.8,
      "end": 443.199,
      "text": "गया है कि कंपनी के प्रमोटर्स आईपीओ आते"
    },
    {
      "subtitle_id": 220,
      "start": 441.08,
      "end": 445.24,
      "text": "ही अपने सारे शेयर्स ऑफ लोड ना करें बेच"
    },
    {
      "subtitle_id": 221,
      "start": 443.199,
      "end": 447.08,
      "text": "ना डाले तो इसीलिए सिक्स मंथ्स का लॉकइन"
    },
    {
      "subtitle_id": 222,
      "start": 445.24,
      "end": 448.84,
      "text": "रहता है अब क्योंकि आप आईपीओ के पहले"
    },
    {
      "subtitle_id": 223,
      "start": 447.08,
      "end": 450.879,
      "text": "इन्वेस्ट करते हो तो आपके लिए भी वही रूल"
    },
    {
      "subtitle_id": 224,
      "start": 448.84,
      "end": 452.56,
      "text": "अप्लाई होता है है ट्रांसपेरेंसी की बात"
    },
    {
      "subtitle_id": 225,
      "start": 450.879,
      "end": 454.68,
      "text": "करें तो अनलिस्टेड शेयर्स में लिस्टेड"
    },
    {
      "subtitle_id": 226,
      "start": 452.56,
      "end": 457.039,
      "text": "शेयर्स के कंपेरटिवली जो ट्रांसपेरेंसी है"
    },
    {
      "subtitle_id": 227,
      "start": 454.68,
      "end": 458.96,
      "text": "वो थोड़ी कम होती है यहां पर डटा फज करना"
    },
    {
      "subtitle_id": 228,
      "start": 457.039,
      "end": 460.879,
      "text": "लिस्टेड कंपनीज के मुकाबले आसान होता है"
    },
    {
      "subtitle_id": 229,
      "start": 458.96,
      "end": 462.8,
      "text": "हालांकि यह डर लिस्टेड कंपनीज के केस में"
    },
    {
      "subtitle_id": 230,
      "start": 460.879,
      "end": 464.879,
      "text": "भी होता है पर अनलिस्टेड कंपनीज के केस"
    },
    {
      "subtitle_id": 231,
      "start": 462.8,
      "end": 466.599,
      "text": "में यह रिस्क ज्यादा होता है तो यह सब"
    },
    {
      "subtitle_id": 232,
      "start": 464.879,
      "end": 468.84,
      "text": "रिस्क होते हैं अनलिस्टेड कंपनीज में"
    },
    {
      "subtitle_id": 233,
      "start": 466.599,
      "end": 470.24,
      "text": "इन्वेस्ट करने के तो मेरा काम है कि जो भी"
    },
    {
      "subtitle_id": 234,
      "start": 468.84,
      "end": 471.8,
      "text": "इन्वेस्टमेंट कैटेगरी है उसके क्या-क्या"
    },
    {
      "subtitle_id": 235,
      "start": 470.24,
      "end": 473.84,
      "text": "फायदे हैं क्या-क्या नुकसान है वह सारी"
    },
    {
      "subtitle_id": 236,
      "start": 471.8,
      "end": 475.68,
      "text": "चीजें आपके सामने रखूं और यही काम मैं कर"
    },
    {
      "subtitle_id": 237,
      "start": 473.84,
      "end": 477.199,
      "text": "रहा हूं और इसके अलावा एक और चीज है जिसके"
    },
    {
      "subtitle_id": 238,
      "start": 475.68,
      "end": 479.879,
      "text": "बारे में हम भूल नहीं सकते बता सकते हो"
    },
    {
      "subtitle_id": 239,
      "start": 477.199,
      "end": 482.0,
      "text": "क्या है टैक्सेस टैक्सेस की अगर बात करें"
    },
    {
      "subtitle_id": 240,
      "start": 479.879,
      "end": 483.879,
      "text": "तो जैसे कि अ लिस्टेड शेयर्स में आपको"
    },
    {
      "subtitle_id": 241,
      "start": 482.0,
      "end": 485.8,
      "text": "लॉन्ग टर्म कैपिटल गेन टैक्स और शॉर्ट"
    },
    {
      "subtitle_id": 242,
      "start": 483.879,
      "end": 488.12,
      "text": "टर्म कैपिटल गेन टैक्स लगता है एगजैक्टली"
    },
    {
      "subtitle_id": 243,
      "start": 485.8,
      "end": 490.319,
      "text": "वही सेम चीज अनलिस्टेड शेयर्स में भी लागू"
    },
    {
      "subtitle_id": 244,
      "start": 488.12,
      "end": 491.68,
      "text": "होती है जहां पर लिस्टेड शेयर्स में 12"
    },
    {
      "subtitle_id": 245,
      "start": 490.319,
      "end": 493.919,
      "text": "मंथ से ज्यादा की इन्वेस्टमेंट को लॉन्ग"
    },
    {
      "subtitle_id": 246,
      "start": 491.68,
      "end": 496.12,
      "text": "टर्म कंसीडर किया जाता है वही अनलिस्टेड"
    },
    {
      "subtitle_id": 247,
      "start": 493.919,
      "end": 498.0,
      "text": "शेयर्स के केस में यह 24 मंथ्स है तो"
    },
    {
      "subtitle_id": 248,
      "start": 496.12,
      "end": 499.759,
      "text": "लॉन्ग टर्म में यहां पर 12.5 पर का"
    },
    {
      "subtitle_id": 249,
      "start": 498.0,
      "end": 501.759,
      "text": "एलटीसीजी आपको लगता है और शॉर्ट टर्म में"
    },
    {
      "subtitle_id": 250,
      "start": 499.759,
      "end": 503.84,
      "text": "20 पर का एसटीसीजी आपको लगता है मतलब"
    },
    {
      "subtitle_id": 251,
      "start": 501.759,
      "end": 506.319,
      "text": "टैक्सेस के मामले में अगर ड्यूरेशन को"
    },
    {
      "subtitle_id": 252,
      "start": 503.84,
      "end": 508.0,
      "text": "छोड़ दे लॉन्ग टर्म के लिए तो सारी चीजें"
    },
    {
      "subtitle_id": 253,
      "start": 506.319,
      "end": 509.68,
      "text": "सेम ही है टैक्स के परसेंटेज और बाकी"
    },
    {
      "subtitle_id": 254,
      "start": 508.0,
      "end": 511.56,
      "text": "चीजें तो आशा करता हूं कि आप आपको"
    },
    {
      "subtitle_id": 255,
      "start": 509.68,
      "end": 513.88,
      "text": "अनलिस्टेड शेयर्स के बारे में ए टू जेड"
    },
    {
      "subtitle_id": 256,
      "start": 511.56,
      "end": 515.68,
      "text": "जानकारी मिल गई होगी क्या होता है कैसे"
    },
    {
      "subtitle_id": 257,
      "start": 513.88,
      "end": 517.719,
      "text": "इन्वेस्ट किया जाता है क्या कुछ रिस्क है"
    },
    {
      "subtitle_id": 258,
      "start": 515.68,
      "end": 520.039,
      "text": "क्या कुछ टैक्सेस है अब इसमें जाना है कि"
    },
    {
      "subtitle_id": 259,
      "start": 517.719,
      "end": 521.959,
      "text": "नहीं जाना वो आपकी डिसीजन है लेकिन एक चीज"
    },
    {
      "subtitle_id": 260,
      "start": 520.039,
      "end": 523.399,
      "text": "मेरा जो पर्सनल ओपिनियन है वो यह है कि"
    },
    {
      "subtitle_id": 261,
      "start": 521.959,
      "end": 525.48,
      "text": "कोई भी इन्वेस्टमेंट अगर आप कर रहे हो तो"
    },
    {
      "subtitle_id": 262,
      "start": 523.399,
      "end": 527.76,
      "text": "तीन चीजों को आपको देखना बहुत जरूरी है"
    },
    {
      "subtitle_id": 263,
      "start": 525.48,
      "end": 529.48,
      "text": "पहली है रिटर्न दूसरा है रिस्क और तीसरी"
    },
    {
      "subtitle_id": 264,
      "start": 527.76,
      "end": 531.959,
      "text": "है रिस्क एपेटाइट आपकी रिस्क लेने की"
    },
    {
      "subtitle_id": 265,
      "start": 529.48,
      "end": 533.64,
      "text": "एबिलिटी या कैपेसिटी क्योंकि अनलिस्टेड"
    },
    {
      "subtitle_id": 266,
      "start": 531.959,
      "end": 535.92,
      "text": "शेयर्स जो है वो हाई रिस्क और हाई रिवॉर्ड"
    },
    {
      "subtitle_id": 267,
      "start": 533.64,
      "end": 537.64,
      "text": "का गेम है तो यहां पर आपको यह भी पता होना"
    },
    {
      "subtitle_id": 268,
      "start": 535.92,
      "end": 539.88,
      "text": "चाहिए कि किस तरह के रिस्क मैं ले रहा हूं"
    },
    {
      "subtitle_id": 269,
      "start": 537.64,
      "end": 541.56,
      "text": "और क्या वह मेरी कैपेसिटी है कि नहीं तो"
    },
    {
      "subtitle_id": 270,
      "start": 539.88,
      "end": 543.0,
      "text": "वीडियो को यही समाप्त करते हैं आशा करता"
    },
    {
      "subtitle_id": 271,
      "start": 541.56,
      "end": 544.56,
      "text": "हूं कि आपको वीडियो काफी पसंद आया होगा"
    },
    {
      "subtitle_id": 272,
      "start": 543.0,
      "end": 546.76,
      "text": "इसे तो अपने दोस्तों के साथ भी जरूर शेयर"
    },
    {
      "subtitle_id": 273,
      "start": 544.56,
      "end": 548.24,
      "text": "कीजिए और प्रिसा एक काफी अच्छा प्लेटफॉर्म"
    },
    {
      "subtitle_id": 274,
      "start": 546.76,
      "end": 549.92,
      "text": "है जहां पर सारी इंफॉर्मेशन आपको मिलती है"
    },
    {
      "subtitle_id": 275,
      "start": 548.24,
      "end": 551.6,
      "text": "अनलिस्टेड शेयर से रिलेटेड तो इस"
    },
    {
      "subtitle_id": 276,
      "start": 549.92,
      "end": 553.04,
      "text": "इंफॉर्मेशन को भी आपको आईपीओ आने से पहले"
    },
    {
      "subtitle_id": 277,
      "start": 551.6,
      "end": 554.8,
      "text": "एक्सप्लोर करना है तो प्रिसा इज इज अ गुड"
    },
    {
      "subtitle_id": 278,
      "start": 553.04,
      "end": 556.279,
      "text": "प्लेटफॉर्म टू चेक आउट जिसके लिंक आपको"
    },
    {
      "subtitle_id": 279,
      "start": 554.8,
      "end": 558.2,
      "text": "नीचे डिस्क्रिप्शन और कमेंट बॉक्स में मिल"
    },
    {
      "subtitle_id": 280,
      "start": 556.279,
      "end": 560.2,
      "text": "जाएगी तो चलिए मिलते हैं अगले वीडियो में"
    },
    {
      "subtitle_id": 281,
      "start": 558.2,
      "end": 561.88,
      "text": "अगले वीडियो में आप क्या कुछ जानना चाहते"
    },
    {
      "subtitle_id": 282,
      "start": 560.2,
      "end": 563.72,
      "text": "हैं सीखना चाहते हैं नीचे कमेंट करके जरूर"
    },
    {
      "subtitle_id": 283,
      "start": 561.88,
      "end": 565.76,
      "text": "बताएं वो चीज हम कवर करने की आने वाले"
    },
    {
      "subtitle_id": 284,
      "start": 563.72,
      "end": 569.44,
      "text": "वीडियो में कोशिश करेंगे थैंक यू सो मच"
    },
    {
      "subtitle_id": 285,
      "start": 565.76,
      "end": 569.44,
      "text": "टेक केयर बाय बाय"
    }
  ]
}