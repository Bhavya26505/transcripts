  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.12,
      "end": 5.68,
      "text": "10000 पर यस 10000 पर का रिटर्न इस कंपनी"
    },
    {
      "subtitle_id": 2,
      "start": 3.32,
      "end": 8.48,
      "text": "ने दिया है पिछले 20-2 सालों में नहीं"
    },
    {
      "subtitle_id": 3,
      "start": 5.68,
      "end": 11.639,
      "text": "सिर्फ 1 साल में इस कंपनी का शेयर नवंबर"
    },
    {
      "subtitle_id": 4,
      "start": 8.48,
      "end": 15.56,
      "text": "2023 में सिर्फ ₹1 का था और वहीं पर नवंबर"
    },
    {
      "subtitle_id": 5,
      "start": 11.639,
      "end": 18.52,
      "text": "2024 आते-आते शेयर की प्राइस हो गई"
    },
    {
      "subtitle_id": 6,
      "start": 15.56,
      "end": 20.48,
      "text": "₹1000000 की इन्वेस्टमेंट आपकी 1 करोड़ से"
    },
    {
      "subtitle_id": 7,
      "start": 18.52,
      "end": 22.0,
      "text": "भी ज्यादा की हो जाती अब यह सारी बातें"
    },
    {
      "subtitle_id": 8,
      "start": 20.48,
      "end": 23.76,
      "text": "सुनकर आपके दिमाग में बहुत सारे सवाल आ"
    },
    {
      "subtitle_id": 9,
      "start": 22.0,
      "end": 26.24,
      "text": "जाएंगे कि कंपनी क्या करती है कौन से"
    },
    {
      "subtitle_id": 10,
      "start": 23.76,
      "end": 27.519,
      "text": "इंडस्ट्री से है ग्रीन एंड एनर्जी में काम"
    },
    {
      "subtitle_id": 11,
      "start": 26.24,
      "end": 29.08,
      "text": "करती है या फिर इंजीनियरिंग एंड"
    },
    {
      "subtitle_id": 12,
      "start": 27.519,
      "end": 31.0,
      "text": "इंफ्रास्ट्रक्चर में काम करती है या फिर"
    },
    {
      "subtitle_id": 13,
      "start": 29.08,
      "end": 32.68,
      "text": "एरो स्पेस एंड डिफ में काम करती है"
    },
    {
      "subtitle_id": 14,
      "start": 31.0,
      "end": 34.68,
      "text": "एग्रीकल्चर या फिर वेस्ट मैनेजमेंट"
    },
    {
      "subtitle_id": 15,
      "start": 32.68,
      "end": 36.32,
      "text": "सर्विसेस में है तो यह कंपनी इन पांचों"
    },
    {
      "subtitle_id": 16,
      "start": 34.68,
      "end": 38.16,
      "text": "इंडस्ट्री में काम करती है और इसके अलावा"
    },
    {
      "subtitle_id": 17,
      "start": 36.32,
      "end": 41.12,
      "text": "एक और इंडस्ट्री में यह कंपनी काम करती है"
    },
    {
      "subtitle_id": 18,
      "start": 38.16,
      "end": 43.16,
      "text": "बताओ कौन सी स्कैम इंडस्ट्री यह न्यूज़"
    },
    {
      "subtitle_id": 19,
      "start": 41.12,
      "end": 45.36,
      "text": "देखिए मैं बात कर रहा हूं भारत ग्लोबल"
    },
    {
      "subtitle_id": 20,
      "start": 43.16,
      "end": 47.68,
      "text": "डेवलपर्स की जिसकी ट्रेडिंग पर सेबी ने"
    },
    {
      "subtitle_id": 21,
      "start": 45.36,
      "end": 49.6,
      "text": "रिसेंटली बैन लगाया है आरोप क्या है इन पर"
    },
    {
      "subtitle_id": 22,
      "start": 47.68,
      "end": 50.84,
      "text": "तो इसकी एक बहुत बड़ी लिस्ट है तो इन पर"
    },
    {
      "subtitle_id": 23,
      "start": 49.6,
      "end": 53.0,
      "text": "बहुत सारे आरोप है जैसे कि उन्होंने"
    },
    {
      "subtitle_id": 24,
      "start": 50.84,
      "end": 55.44,
      "text": "फाइनेंशियल स्टेटमेंट्स को फच किया है मनी"
    },
    {
      "subtitle_id": 25,
      "start": 53.0,
      "end": 57.68,
      "text": "पलेट किया है उसके बाद पंप एंड डम किया है"
    },
    {
      "subtitle_id": 26,
      "start": 55.44,
      "end": 59.96,
      "text": "अपनी शेयर प्राइस को पंप करके रिटेलर्स के"
    },
    {
      "subtitle_id": 27,
      "start": 57.68,
      "end": 61.559,
      "text": "पास उसे डम कर दिया है फेक ऑर्डर्स दिखा"
    },
    {
      "subtitle_id": 28,
      "start": 59.96,
      "end": 63.32,
      "text": "आई है फेक इंडस्ट्री में होने का दावा"
    },
    {
      "subtitle_id": 29,
      "start": 61.559,
      "end": 64.72,
      "text": "किया है ऐसे बहुत सारी चीजें इन्होंने की"
    },
    {
      "subtitle_id": 30,
      "start": 63.32,
      "end": 66.32,
      "text": "है जिसके बारे में आज के इस वीडियो में हम"
    },
    {
      "subtitle_id": 31,
      "start": 64.72,
      "end": 67.68,
      "text": "बात करेंगे साथ ही इस वीडियो में ऐसी"
    },
    {
      "subtitle_id": 32,
      "start": 66.32,
      "end": 70.0,
      "text": "मोस्ट इंपोर्टेंट चीज के बारे में बात"
    },
    {
      "subtitle_id": 33,
      "start": 67.68,
      "end": 72.0,
      "text": "करेंगे जिससे आप इस तरह की कंपनी से पहले"
    },
    {
      "subtitle_id": 34,
      "start": 70.0,
      "end": 74.759,
      "text": "ही दूर रह सकते हो और उनमें होने वाले"
    },
    {
      "subtitle_id": 35,
      "start": 72.0,
      "end": 77.32,
      "text": "फ्रॉड को पहले ही पता कर सकते हो हां यह"
    },
    {
      "subtitle_id": 36,
      "start": 74.759,
      "end": 79.439,
      "text": "पॉसिबल है और आज मैं आपको बता भी दूंगा तो"
    },
    {
      "subtitle_id": 37,
      "start": 77.32,
      "end": 81.0,
      "text": "इस वीडियो को अंत तक जरूर देखें और इस"
    },
    {
      "subtitle_id": 38,
      "start": 79.439,
      "end": 82.36,
      "text": "वीडियो को अपने ज्यादा से ज्यादा शेयर"
    },
    {
      "subtitle_id": 39,
      "start": 81.0,
      "end": 84.4,
      "text": "मार्केट में इन्वेस्ट करने वाले दोस्तों"
    },
    {
      "subtitle_id": 40,
      "start": 82.36,
      "end": 86.4,
      "text": "के साथ शेयर कीजिए ताकि वो लोग भी इस तरह"
    },
    {
      "subtitle_id": 41,
      "start": 84.4,
      "end": 87.96,
      "text": "की कंपनीज में कभी फंस ही ना पाए और हां"
    },
    {
      "subtitle_id": 42,
      "start": 86.4,
      "end": 89.52,
      "text": "वीडियो शुरू करने से पहले आप यह मेक श्यर"
    },
    {
      "subtitle_id": 43,
      "start": 87.96,
      "end": 91.04,
      "text": "कीजिए कि आपने चैनल को सब्सक्राइब किया है"
    },
    {
      "subtitle_id": 44,
      "start": 89.52,
      "end": 92.68,
      "text": "हम देखते देखते कि बहुत सारे लोग हैं जो"
    },
    {
      "subtitle_id": 45,
      "start": 91.04,
      "end": 94.64,
      "text": "हमारे वीडियोस को रेगुलरली देखते हैं"
    },
    {
      "subtitle_id": 46,
      "start": 92.68,
      "end": 96.479,
      "text": "लेकिन सब्सक्राइब करना भूल जाते हैं तो"
    },
    {
      "subtitle_id": 47,
      "start": 94.64,
      "end": 98.159,
      "text": "मेक श्यर कीजिए कि आप सब्सक्राइब कीजिए और"
    },
    {
      "subtitle_id": 48,
      "start": 96.479,
      "end": 100.079,
      "text": "साथ ही बेल आइकन पर भी क्लिक कीजिए"
    },
    {
      "subtitle_id": 49,
      "start": 98.159,
      "end": 102.36,
      "text": "क्योंकि घंटी बजाओ ग तो प्रसाद जरूर"
    },
    {
      "subtitle_id": 50,
      "start": 100.079,
      "end": 103.96,
      "text": "मिलेगा नमस्कार मैं प्रसाद आपका आज के इस"
    },
    {
      "subtitle_id": 51,
      "start": 102.36,
      "end": 105.439,
      "text": "वीडियो में स्वागत करता हूं और वीडियो में"
    },
    {
      "subtitle_id": 52,
      "start": 103.96,
      "end": 107.439,
      "text": "आगे बढ़ने से पहले आपको बता दूं कि हमारी"
    },
    {
      "subtitle_id": 53,
      "start": 105.439,
      "end": 109.36,
      "text": "न्यू ईयर न्यू मल्टीबैगर ऑफर के बस आखिरी"
    },
    {
      "subtitle_id": 54,
      "start": 107.439,
      "end": 110.96,
      "text": "दो दिन बाकी है जिसमें हमारे जो कमो"
    },
    {
      "subtitle_id": 55,
      "start": 109.36,
      "end": 112.92,
      "text": "कोर्सेस है जहां पर आप स्टॉक मार्केट के"
    },
    {
      "subtitle_id": 56,
      "start": 110.96,
      "end": 114.36,
      "text": "बेसिक से लेकर एडवांस लेवल तक मैनेजमेंट"
    },
    {
      "subtitle_id": 57,
      "start": 112.92,
      "end": 116.56,
      "text": "एनालिसिस हो फाइनेंशियल स्टेटमेंट का"
    },
    {
      "subtitle_id": 58,
      "start": 114.36,
      "end": 118.399,
      "text": "एनालिसिस हो फॉरेंसिक एनालिसिस हो जो"
    },
    {
      "subtitle_id": 59,
      "start": 116.56,
      "end": 120.88,
      "text": "लोगों को इन्वेस्ट करते वक्त इस कंपनी में"
    },
    {
      "subtitle_id": 60,
      "start": 118.399,
      "end": 123.28,
      "text": "करना चाहिए था यह सारी वैल्युएशन के साथ"
    },
    {
      "subtitle_id": 61,
      "start": 120.88,
      "end": 125.039,
      "text": "समझ सकते हो वो भी बहुत डिटेल में बहुत"
    },
    {
      "subtitle_id": 62,
      "start": 123.28,
      "end": 126.479,
      "text": "सिंपल लैंग्वेज में कि कोई अगर फोर्थ"
    },
    {
      "subtitle_id": 63,
      "start": 125.039,
      "end": 128.56,
      "text": "फिफ्थ स्टैंडर्ड का स्टूडेंट भी है तो वो"
    },
    {
      "subtitle_id": 64,
      "start": 126.479,
      "end": 130.44,
      "text": "भी बड़े आसानी से यहां पर चीजें समझ पाएगे"
    },
    {
      "subtitle_id": 65,
      "start": 128.56,
      "end": 131.92,
      "text": "इतनी आसानी से चीजें समझाई है फाइनेंस"
    },
    {
      "subtitle_id": 66,
      "start": 130.44,
      "end": 133.44,
      "text": "बैकग्राउंड होना ही चाहिए समझने के लिए"
    },
    {
      "subtitle_id": 67,
      "start": 131.92,
      "end": 135.879,
      "text": "ऐसा जरूरी नहीं है आप भी एक अच्छे"
    },
    {
      "subtitle_id": 68,
      "start": 133.44,
      "end": 137.64,
      "text": "फंडामेंटल एनालिस्ट बन सकते हो इन कमो से"
    },
    {
      "subtitle_id": 69,
      "start": 135.879,
      "end": 138.92,
      "text": "काफी कुछ चीजें सीखकर वो भी प्रैक्टिकल"
    },
    {
      "subtitle_id": 70,
      "start": 137.64,
      "end": 140.16,
      "text": "तरीके से इसकी लिंक आपको नीचे"
    },
    {
      "subtitle_id": 71,
      "start": 138.92,
      "end": 143.56,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में मिल"
    },
    {
      "subtitle_id": 72,
      "start": 140.16,
      "end": 146.08,
      "text": "जाएगी दो कॉम्बोस कोर्स ऑन स्टॉक मार्केट"
    },
    {
      "subtitle_id": 73,
      "start": 143.56,
      "end": 147.92,
      "text": "प्लस फंडामेंटल एनालिसिस 2.0 का और दूसरा"
    },
    {
      "subtitle_id": 74,
      "start": 146.08,
      "end": 150.56,
      "text": "है चार कोर्सेस का जिसमें फाउंडेशन कोर्स"
    },
    {
      "subtitle_id": 75,
      "start": 147.92,
      "end": 152.879,
      "text": "फंडामेंटल एनालिसिस 2.0 ट्रेडिंग फॉर"
    },
    {
      "subtitle_id": 76,
      "start": 150.56,
      "end": 154.56,
      "text": "बिगिनर्स फॉर हेजिंग और म्यूचुअल फंड"
    },
    {
      "subtitle_id": 77,
      "start": 152.879,
      "end": 156.319,
      "text": "फ्रॉम बिगनर टू एक्सपर्ट ये दोनों भी"
    },
    {
      "subtitle_id": 78,
      "start": 154.56,
      "end": 157.84,
      "text": "कॉम्बोस बहुत ही ज्यादा डिस्काउंट पर अभी"
    },
    {
      "subtitle_id": 79,
      "start": 156.319,
      "end": 159.56,
      "text": "आपको मिल रहे हैं मोर दन 50 पर का"
    },
    {
      "subtitle_id": 80,
      "start": 157.84,
      "end": 161.599,
      "text": "डिस्काउंट अभी इन पर चल रहा है और यह"
    },
    {
      "subtitle_id": 81,
      "start": 159.56,
      "end": 163.44,
      "text": "प्राइस आपको इस न्यू ईयर ऑफर के बाद बाद"
    },
    {
      "subtitle_id": 82,
      "start": 161.599,
      "end": 165.48,
      "text": "में कभी नहीं मिलेगी यह प्राइस हमेशा"
    },
    {
      "subtitle_id": 83,
      "start": 163.44,
      "end": 167.48,
      "text": "बढ़ती रहती है सो डोंट मिस आउट ऑन दिस"
    },
    {
      "subtitle_id": 84,
      "start": 165.48,
      "end": 169.159,
      "text": "अपॉर्चुनिटी और यह जो कमो इनके साथ आपको"
    },
    {
      "subtitle_id": 85,
      "start": 167.48,
      "end": 171.959,
      "text": "फिनस का सर्टिफिकेट मिलता है और इनकी"
    },
    {
      "subtitle_id": 86,
      "start": 169.159,
      "end": 174.2,
      "text": "वैलिडिटी लाइफ टाइम है आप कभी भी कितनी"
    },
    {
      "subtitle_id": 87,
      "start": 171.959,
      "end": 175.72,
      "text": "बार भी इसे देख सकते हैं बस फर्क यही है"
    },
    {
      "subtitle_id": 88,
      "start": 174.2,
      "end": 177.519,
      "text": "कि यह प्राइस बाद में आपको कभी नहीं"
    },
    {
      "subtitle_id": 89,
      "start": 175.72,
      "end": 179.36,
      "text": "मिलेगी तो यह ऑफर खत्म होने से पहले जरूर"
    },
    {
      "subtitle_id": 90,
      "start": 177.519,
      "end": 181.36,
      "text": "इसका फायदा लीजिए बढ़ते हैं वीडियो की तरफ"
    },
    {
      "subtitle_id": 91,
      "start": 179.36,
      "end": 183.36,
      "text": "तो इसका कंपनी का प्रेजेंटली जो नाम है वह"
    },
    {
      "subtitle_id": 92,
      "start": 181.36,
      "end": 184.84,
      "text": "है भारत ग्लोबल डेवलपर्स अब आप पूछेंगे"
    },
    {
      "subtitle_id": 93,
      "start": 183.36,
      "end": 187.44,
      "text": "प्रेजेंटली का मतलब क्या होता है नाम तो"
    },
    {
      "subtitle_id": 94,
      "start": 184.84,
      "end": 190.04,
      "text": "एक ही होता है यह कंपनी नाम पर नाम बदल"
    },
    {
      "subtitle_id": 95,
      "start": 187.44,
      "end": 192.36,
      "text": "चुकी है 1993 में कंपनी का नाम था परफेक्ट"
    },
    {
      "subtitle_id": 96,
      "start": 190.04,
      "end": 194.959,
      "text": "विंग्स 2000 में इसने नाम चेंज करके अपना"
    },
    {
      "subtitle_id": 97,
      "start": 192.36,
      "end": 197.76,
      "text": "रख दिया सीक्वेल ए राउटर्स 2017 में अपना"
    },
    {
      "subtitle_id": 98,
      "start": 194.959,
      "end": 200.12,
      "text": "नाम रख दिया क्राफ्ट डेवलपर्स और 2024 में"
    },
    {
      "subtitle_id": 99,
      "start": 197.76,
      "end": 202.68,
      "text": "भारत ग्लोबल डेवलपर्स और यह कंपनी कोई नई"
    },
    {
      "subtitle_id": 100,
      "start": 200.12,
      "end": 204.319,
      "text": "कंपनी नहीं है 1992 में इस गुजरात बेस्ड"
    },
    {
      "subtitle_id": 101,
      "start": 202.68,
      "end": 205.959,
      "text": "कंपनी की शुरुआत हुई थी जैसे कि मैंने"
    },
    {
      "subtitle_id": 102,
      "start": 204.319,
      "end": 207.36,
      "text": "थोड़ी देर पहले आपको बताया कि यह कंपनी"
    },
    {
      "subtitle_id": 103,
      "start": 205.959,
      "end": 209.319,
      "text": "ग्रीन एनर्जी इंजीनियरिंग एंड"
    },
    {
      "subtitle_id": 104,
      "start": 207.36,
      "end": 211.48,
      "text": "इंफ्रास्ट्रक्चर डिफेंस एग्रीकल्चर वेस्ट"
    },
    {
      "subtitle_id": 105,
      "start": 209.319,
      "end": 212.92,
      "text": "मैनेजमेंट सर्विसेस इन सब में है यह तो"
    },
    {
      "subtitle_id": 106,
      "start": 211.48,
      "end": 214.48,
      "text": "इनके वेबसाइट के अकॉर्डिंग लेकिन"
    },
    {
      "subtitle_id": 107,
      "start": 212.92,
      "end": 216.599,
      "text": "फाइनेंशियल स्टेटमेंट के हिसाब से यह"
    },
    {
      "subtitle_id": 108,
      "start": 214.48,
      "end": 218.68,
      "text": "कंपनी क्या करती है तो कंस्ट्रक्शन से"
    },
    {
      "subtitle_id": 109,
      "start": 216.599,
      "end": 221.08,
      "text": "इनका 8.4 करोड़ का रेवेन्यू आता है गोल्ड"
    },
    {
      "subtitle_id": 110,
      "start": 218.68,
      "end": 223.799,
      "text": "से 27 करोड़ का एग्री प्रोडक्ट से लगभग"
    },
    {
      "subtitle_id": 111,
      "start": 221.08,
      "end": 225.519,
      "text": "100 करोड़ का और टेक्सटाइल से 77 करोड़ का"
    },
    {
      "subtitle_id": 112,
      "start": 223.799,
      "end": 228.4,
      "text": "अब यह तो थी रिसेंट क्वार्टर की बात अगर"
    },
    {
      "subtitle_id": 113,
      "start": 225.519,
      "end": 230.72,
      "text": "हम डिसंबर 2023 में इनका सेल्स देखेंगे तो"
    },
    {
      "subtitle_id": 114,
      "start": 228.4,
      "end": 235.079,
      "text": "सिर्फ 1 करोड़ का हुआ करता था और सितंबर"
    },
    {
      "subtitle_id": 115,
      "start": 230.72,
      "end": 237.959,
      "text": "2024 में यह चला गया 216 करोड़ पर यानी"
    },
    {
      "subtitle_id": 116,
      "start": 235.079,
      "end": 239.879,
      "text": "कितने गुना छलांग मार ली आप देख लीजिए तो"
    },
    {
      "subtitle_id": 117,
      "start": 237.959,
      "end": 242.36,
      "text": "सवाल आता है कि ऐसा क्या हुआ कि कंपनी का"
    },
    {
      "subtitle_id": 118,
      "start": 239.879,
      "end": 245.12,
      "text": "रेवेन्यू सिर्फ 9 महीनों में 1 करोड़ से"
    },
    {
      "subtitle_id": 119,
      "start": 242.36,
      "end": 246.84,
      "text": "सीधा 216 करोड़ हो गया तो ये आपको थोड़ी"
    },
    {
      "subtitle_id": 120,
      "start": 245.12,
      "end": 248.76,
      "text": "देर में पता चलेगा क्योंकि ये जो स्कैम है"
    },
    {
      "subtitle_id": 121,
      "start": 246.84,
      "end": 251.0,
      "text": "इन्हीं 9 महीनों में किया गया है अब यह"
    },
    {
      "subtitle_id": 122,
      "start": 248.76,
      "end": 252.599,
      "text": "स्कैम कैसे हुआ अब स्कैम हुआ दो चीजें"
    },
    {
      "subtitle_id": 123,
      "start": 251.0,
      "end": 255.04,
      "text": "करके पहले तो शेयर्स के नंबर्स की"
    },
    {
      "subtitle_id": 124,
      "start": 252.599,
      "end": 256.919,
      "text": "लिक्विडिटी बढ़ाकर और दूसरा फेक ऑर्डर"
    },
    {
      "subtitle_id": 125,
      "start": 255.04,
      "end": 260.079,
      "text": "डिस्क्लोजर बताकर कंपनी के जो पांच"
    },
    {
      "subtitle_id": 126,
      "start": 256.919,
      "end": 262.919,
      "text": "प्रमोटर्स है उनके पास जून 2020 तक कंपनी"
    },
    {
      "subtitle_id": 127,
      "start": 260.079,
      "end": 264.52,
      "text": "का 16 पर स्टेक था और उसके बाद प्रमोटर्स"
    },
    {
      "subtitle_id": 128,
      "start": 262.919,
      "end": 267.84,
      "text": "ने अपना सारा स्टेक बेच दिया जिसके बाद"
    },
    {
      "subtitle_id": 129,
      "start": 264.52,
      "end": 270.039,
      "text": "100% का 100% स्टेक पब्लिक के पास आ गया"
    },
    {
      "subtitle_id": 130,
      "start": 267.84,
      "end": 271.759,
      "text": "यानी कि कंपनी का कोई मां-बाप नहीं था ऐसे"
    },
    {
      "subtitle_id": 131,
      "start": 270.039,
      "end": 273.919,
      "text": "में कंपनी के मैनेजमेंट पर एक बहुत बड़ी"
    },
    {
      "subtitle_id": 132,
      "start": 271.759,
      "end": 275.56,
      "text": "रिस्पांसिबिलिटी आ जाती है तो ऐसे टाइम"
    },
    {
      "subtitle_id": 133,
      "start": 273.919,
      "end": 278.12,
      "text": "में अगर कंपनी का मैनेजमेंट बुरा हो तो"
    },
    {
      "subtitle_id": 134,
      "start": 275.56,
      "end": 280.479,
      "text": "चीजें बहुत बिगड़ सकती है और इस कंपनी के"
    },
    {
      "subtitle_id": 135,
      "start": 278.12,
      "end": 283.639,
      "text": "साथ एगजैक्टली यही हुआ तो हुआ यह कि"
    },
    {
      "subtitle_id": 136,
      "start": 280.479,
      "end": 285.88,
      "text": "दिसंबर 2023 यानी लगभग 1 साल पहले कंपनी"
    },
    {
      "subtitle_id": 137,
      "start": 283.639,
      "end": 287.24,
      "text": "के सारे जो बोर्ड ऑफ डायरेक्टर्स थे वो नए"
    },
    {
      "subtitle_id": 138,
      "start": 285.88,
      "end": 289.28,
      "text": "लोग"
    },
    {
      "subtitle_id": 139,
      "start": 287.24,
      "end": 291.68,
      "text": "अपॉइंटमेंट ने यहां पर बड़ी इंटरेस्टिंग"
    },
    {
      "subtitle_id": 140,
      "start": 289.28,
      "end": 293.639,
      "text": "चीज की कि जो नए लोग आए थे मैनेजमेंट में"
    },
    {
      "subtitle_id": 141,
      "start": 291.68,
      "end": 295.56,
      "text": "उन्हें प्रेफरेंस शेयर्स अलॉट कर दिए और"
    },
    {
      "subtitle_id": 142,
      "start": 293.639,
      "end": 297.72,
      "text": "छोटी-मोटी अमाउंट के नहीं 170 करोड़ के"
    },
    {
      "subtitle_id": 143,
      "start": 295.56,
      "end": 299.68,
      "text": "शेयर्स अलॉट किए गए कौन थे ये लोग तो सारे"
    },
    {
      "subtitle_id": 144,
      "start": 297.72,
      "end": 301.16,
      "text": "के सारे मैनेजमेंट या फिर मैनेजमेंट से"
    },
    {
      "subtitle_id": 145,
      "start": 299.68,
      "end": 302.24,
      "text": "जुड़े हुए लोग थे अब यह चीज उन्होंने"
    },
    {
      "subtitle_id": 146,
      "start": 301.16,
      "end": 303.96,
      "text": "क्यों की वो भी मैं बता देता हूं"
    },
    {
      "subtitle_id": 147,
      "start": 302.24,
      "end": 305.479,
      "text": "प्रेफरेंस शेयर वाला अब प्रेफरेंस शेयर"
    },
    {
      "subtitle_id": 148,
      "start": 303.96,
      "end": 307.199,
      "text": "उन्होंने जो मैनेजमेंट रिलेटेड पार्टीज को"
    },
    {
      "subtitle_id": 149,
      "start": 305.479,
      "end": 309.16,
      "text": "अलॉट किए थोड़ी कम प्राइस पर अलॉट किए"
    },
    {
      "subtitle_id": 150,
      "start": 307.199,
      "end": 311.24,
      "text": "उसके बाद उन्होंने क्या किया कि बहुत सारी"
    },
    {
      "subtitle_id": 151,
      "start": 309.16,
      "end": 313.44,
      "text": "फेक ऑर्डर्स बताई कि आप स्क्रीन पर देख"
    },
    {
      "subtitle_id": 152,
      "start": 311.24,
      "end": 315.68,
      "text": "सकते हो कि मैं फलाना धमकाना कंपनी से 120"
    },
    {
      "subtitle_id": 153,
      "start": 313.44,
      "end": 317.8,
      "text": "करोड़ की ऑर्डर आ गई किसी से 300 करोड़ की"
    },
    {
      "subtitle_id": 154,
      "start": 315.68,
      "end": 320.08,
      "text": "ऑर्डर आ गई और बहुत बड़ी ऑर्डर बुक है"
    },
    {
      "subtitle_id": 155,
      "start": 317.8,
      "end": 321.36,
      "text": "ताकि ये लगातार न्यूज़ में रहे और लोगों"
    },
    {
      "subtitle_id": 156,
      "start": 320.08,
      "end": 323.759,
      "text": "को लगे कि कंपनी को बहुत बड़ी-बड़ी"
    },
    {
      "subtitle_id": 157,
      "start": 321.36,
      "end": 326.56,
      "text": "ऑर्डर्स मिल रही है लेट्स एंटर इन टू द"
    },
    {
      "subtitle_id": 158,
      "start": 323.759,
      "end": 328.36,
      "text": "कंपनी और एगजैक्टली लोगों ने यही किया"
    },
    {
      "subtitle_id": 159,
      "start": 326.56,
      "end": 330.919,
      "text": "कंपनी का प्लान था बहुत सक्सेसफुल हो रहा"
    },
    {
      "subtitle_id": 160,
      "start": 328.36,
      "end": 332.639,
      "text": "था वैसे में कंपनी ने प्लान किया कि अभी"
    },
    {
      "subtitle_id": 161,
      "start": 330.919,
      "end": 334.52,
      "text": "लोगों का इंटरेस्ट तो काफी बढ़ रहा है तो"
    },
    {
      "subtitle_id": 162,
      "start": 332.639,
      "end": 336.68,
      "text": "क्यों ना लोगों को और लूटा जाए तो इसलिए"
    },
    {
      "subtitle_id": 163,
      "start": 334.52,
      "end": 339.36,
      "text": "कंपनी वाज प्लानिंग 10 ए1 का स्टॉक"
    },
    {
      "subtitle_id": 164,
      "start": 336.68,
      "end": 341.24,
      "text": "स्प्लिट और 8 ए2 10 का बोनस इशू जिससे"
    },
    {
      "subtitle_id": 165,
      "start": 339.36,
      "end": 343.12,
      "text": "क्या होता कि नंबर ऑफ शेयर्स और बढ़ जाते"
    },
    {
      "subtitle_id": 166,
      "start": 341.24,
      "end": 344.68,
      "text": "शेयर प्राइस और कम हो जाती जिससे और"
    },
    {
      "subtitle_id": 167,
      "start": 343.12,
      "end": 346.6,
      "text": "ज्यादा रिटेल इन्वेस्टर उस स्टॉक में आ"
    },
    {
      "subtitle_id": 168,
      "start": 344.68,
      "end": 347.8,
      "text": "जाते क्योंकि रिटेल इन्वेस्टर्स कभी स्टॉक"
    },
    {
      "subtitle_id": 169,
      "start": 346.6,
      "end": 350.759,
      "text": "में वैल्यू नहीं देखते वो देखते हैं"
    },
    {
      "subtitle_id": 170,
      "start": 347.8,
      "end": 353.0,
      "text": "प्राइस कम प्राइस वाला मतलब अपना और इसी"
    },
    {
      "subtitle_id": 171,
      "start": 350.759,
      "end": 355.0,
      "text": "चीज को इसी लोगों की वीकनेस को कंपनी ने"
    },
    {
      "subtitle_id": 172,
      "start": 353.0,
      "end": 356.479,
      "text": "बहुत जबरदस्त तरीके से पकड़ लिया अब देखिए"
    },
    {
      "subtitle_id": 173,
      "start": 355.0,
      "end": 359.199,
      "text": "प्रेफरेंस शेयर्स तो कम प्राइस में अलॉट"
    },
    {
      "subtitle_id": 174,
      "start": 356.479,
      "end": 361.84,
      "text": "कर दिए थे अ फेक ऑर्डर दिखाकर लोगों को"
    },
    {
      "subtitle_id": 175,
      "start": 359.199,
      "end": 364.12,
      "text": "अट्रैक्ट भी किया अब ऐसे में टाइम था"
    },
    {
      "subtitle_id": 176,
      "start": 361.84,
      "end": 366.199,
      "text": "प्रॉफिट को बुक करने का कि अब यहां से"
    },
    {
      "subtitle_id": 177,
      "start": 364.12,
      "end": 368.0,
      "text": "एग्जिट कर लेते हैं अब इंटरेस्टिंग बात यह"
    },
    {
      "subtitle_id": 178,
      "start": 366.199,
      "end": 370.039,
      "text": "है कि सेबी ने यह जो ऑर्डर बुक है इसे"
    },
    {
      "subtitle_id": 179,
      "start": 368.0,
      "end": 372.919,
      "text": "वेरीफाई करने का सोचा तो उन्हें पता चला"
    },
    {
      "subtitle_id": 180,
      "start": 370.039,
      "end": 374.84,
      "text": "कि यार यह जो कंपनीज का नाम बता रहे हैं"
    },
    {
      "subtitle_id": 181,
      "start": 372.919,
      "end": 377.039,
      "text": "उन्होंने तो इन्हें ऑर्डर दी ही नहीं है"
    },
    {
      "subtitle_id": 182,
      "start": 374.84,
      "end": 379.12,
      "text": "और सबसे इंटरेस्टिंग बात अब ये जो मैकन"
    },
    {
      "subtitle_id": 183,
      "start": 377.039,
      "end": 381.08,
      "text": "इंडिया एग्रो प्राइवेट लिमिटेड है जिसमें"
    },
    {
      "subtitle_id": 184,
      "start": 379.12,
      "end": 383.16,
      "text": "कंपनी ने बताया कि हमें इस कंपनी से 300"
    },
    {
      "subtitle_id": 185,
      "start": 381.08,
      "end": 385.24,
      "text": "करोड़ की ऑर्डर मिली है पता चला कि वो"
    },
    {
      "subtitle_id": 186,
      "start": 383.16,
      "end": 387.28,
      "text": "कंपनी तो एजिस्ट ही नहीं करती है तो ऑर्डर"
    },
    {
      "subtitle_id": 187,
      "start": 385.24,
      "end": 389.16,
      "text": "कहां से देगी और सेबी के इन्वेस्टिगेशन"
    },
    {
      "subtitle_id": 188,
      "start": 387.28,
      "end": 390.84,
      "text": "में यह भी पता चला कि कंपनी ने बताया कि"
    },
    {
      "subtitle_id": 189,
      "start": 389.16,
      "end": 393.4,
      "text": "हमारे एक सब्सिडियरी है दुबई में उसे भी"
    },
    {
      "subtitle_id": 190,
      "start": 390.84,
      "end": 395.44,
      "text": "251 करोड़ की ऑर्डर मिली है इन्वेस्टिगेशन"
    },
    {
      "subtitle_id": 191,
      "start": 393.4,
      "end": 397.24,
      "text": "में पता चला कोई सब्सिडियरी कंपनी नहीं है"
    },
    {
      "subtitle_id": 192,
      "start": 395.44,
      "end": 399.36,
      "text": "इनकी दुबई में अब इस तरह से इन लोगों के"
    },
    {
      "subtitle_id": 193,
      "start": 397.24,
      "end": 401.12,
      "text": "दोनों प्लान सक्सेसफुल हुए कि प्रेफरेंस"
    },
    {
      "subtitle_id": 194,
      "start": 399.36,
      "end": 402.8,
      "text": "शेयर्स देकर मैनेजमेंट से रिलेटेड लोगों"
    },
    {
      "subtitle_id": 195,
      "start": 401.12,
      "end": 405.08,
      "text": "के पास कंपनी की मेजॉरिटी शेयर्स इन्होंने"
    },
    {
      "subtitle_id": 196,
      "start": 402.8,
      "end": 406.96,
      "text": "दे दिए दूसरी चीज फेक ऑर्डर बता बताकर"
    },
    {
      "subtitle_id": 197,
      "start": 405.08,
      "end": 408.919,
      "text": "बहुत तेजी से आ रही है ऐसा वैसा दिखाकर"
    },
    {
      "subtitle_id": 198,
      "start": 406.96,
      "end": 410.599,
      "text": "शेयर प्राइस बढ़ा दी और शेयर प्राइस ऐसी"
    },
    {
      "subtitle_id": 199,
      "start": 408.919,
      "end": 412.599,
      "text": "वैसी नहीं बढ़ी आप स्क्रीन पर देख सकते हो"
    },
    {
      "subtitle_id": 200,
      "start": 410.599,
      "end": 414.599,
      "text": "100 गुना से ज्यादा कंपनी की शेयर प्राइस"
    },
    {
      "subtitle_id": 201,
      "start": 412.599,
      "end": 416.08,
      "text": "बढ़ गई अब क्या था टाइम था प्रॉफिट बुक"
    },
    {
      "subtitle_id": 202,
      "start": 414.599,
      "end": 417.56,
      "text": "करने का तो जिन्हें प्रेफरेंस शेयर्स"
    },
    {
      "subtitle_id": 203,
      "start": 416.08,
      "end": 419.84,
      "text": "मिलते हैं तो प्रेफरेंस शेयर्स के साथ एक"
    },
    {
      "subtitle_id": 204,
      "start": 417.56,
      "end": 421.44,
      "text": "लॉकइन पीरियड रहता है कि आप एक स्पेस सिक"
    },
    {
      "subtitle_id": 205,
      "start": 419.84,
      "end": 423.24,
      "text": "टाइम पीरियड के लिए शेयर्स नहीं बेच सकते"
    },
    {
      "subtitle_id": 206,
      "start": 421.44,
      "end": 425.479,
      "text": "लेकिन जैसे वो टाइम पीरियड खत्म हो गया"
    },
    {
      "subtitle_id": 207,
      "start": 423.24,
      "end": 427.16,
      "text": "फटाफट जो मैनेजमेंट से रिलेटेड लोग थे"
    },
    {
      "subtitle_id": 208,
      "start": 425.479,
      "end": 429.879,
      "text": "उन्होंने अपने प्रेफरेंस शेयर्स बेचना"
    },
    {
      "subtitle_id": 209,
      "start": 427.16,
      "end": 432.12,
      "text": "शुरू कर दिया और प्रॉफिट कितना तो आप गिनी"
    },
    {
      "subtitle_id": 210,
      "start": 429.879,
      "end": 434.8,
      "text": "है महादेव मकवाना ने 70 करोड़ का प्रॉफिट"
    },
    {
      "subtitle_id": 211,
      "start": 432.12,
      "end": 436.919,
      "text": "बुक किया चंदन चौरसिया ने 43 करोड़ का"
    },
    {
      "subtitle_id": 212,
      "start": 434.8,
      "end": 439.28,
      "text": "प्रॉफिट बुक कर लिया एंड बड़े-बड़े नंबर्स"
    },
    {
      "subtitle_id": 213,
      "start": 436.919,
      "end": 442.199,
      "text": "आप यहां पर देख सकते हो तो इस तरह से कुल"
    },
    {
      "subtitle_id": 214,
      "start": 439.28,
      "end": 444.199,
      "text": "मिलाकर 271 करोड़ का प्रॉफिट बस कुछ ही"
    },
    {
      "subtitle_id": 215,
      "start": 442.199,
      "end": 446.639,
      "text": "दिनों में बुक किया गया यह पैसा और किसी"
    },
    {
      "subtitle_id": 216,
      "start": 444.199,
      "end": 448.36,
      "text": "का नहीं है आम रिटेल इन्वेस्टर्स का है"
    },
    {
      "subtitle_id": 217,
      "start": 446.639,
      "end": 450.4,
      "text": "जिन्हें इस पूरे स्कैम में फ्रॉड में"
    },
    {
      "subtitle_id": 218,
      "start": 448.36,
      "end": 454.08,
      "text": "फंसाया गया है यानी कि जो प्रेफरेंस"
    },
    {
      "subtitle_id": 219,
      "start": 450.4,
      "end": 454.08,
      "text": "शेयर्स मैनेजमेंट से रिलेटेड लोगों ने"
    },
    {
      "subtitle_id": 220,
      "start": 479.599,
      "end": 482.919,
      "text": "चीज की बात करते हैं कि इस तरह की जो"
    },
    {
      "subtitle_id": 221,
      "start": 481.159,
      "end": 484.44,
      "text": "चीजें होती है ना इन्हें पहले भी पकड़ा जा"
    },
    {
      "subtitle_id": 222,
      "start": 482.919,
      "end": 486.72,
      "text": "सकता है और बड़ी आसानी से पकड़ा जा सकता"
    },
    {
      "subtitle_id": 223,
      "start": 484.44,
      "end": 488.68,
      "text": "है बहुत सारे लोग मुझे बोलते हैं फिर कि"
    },
    {
      "subtitle_id": 224,
      "start": 486.72,
      "end": 490.319,
      "text": "आपने पहले क्यों नहीं बताया हमें तो आपको"
    },
    {
      "subtitle_id": 225,
      "start": 488.68,
      "end": 491.72,
      "text": "बता दूं कि ऐसी हंड्रेड्स ऑफ कंपनीज"
    },
    {
      "subtitle_id": 226,
      "start": 490.319,
      "end": 493.72,
      "text": "मार्केट में हैं जो इस तरह की चीजें कर"
    },
    {
      "subtitle_id": 227,
      "start": 491.72,
      "end": 495.639,
      "text": "रही हैं और आज भी आप उन्हें जाकर पकड़"
    },
    {
      "subtitle_id": 228,
      "start": 493.72,
      "end": 497.759,
      "text": "सकते हो और मैं भी नाम ले सकता हूं और ऐसे"
    },
    {
      "subtitle_id": 229,
      "start": 495.639,
      "end": 499.52,
      "text": "कई सारे लॉसूट ऑलरेडी झेल रहा हूं तो यहां"
    },
    {
      "subtitle_id": 230,
      "start": 497.759,
      "end": 501.479,
      "text": "पर कुछ दो-तीन पैटर्स मैं आपको बताता हूं"
    },
    {
      "subtitle_id": 231,
      "start": 499.52,
      "end": 503.759,
      "text": "जिससे आप बड़ी आसानी से यहां पर भी पता कर"
    },
    {
      "subtitle_id": 232,
      "start": 501.479,
      "end": 505.72,
      "text": "सकते थे और बहुत सारे इन्वेस्टर्स हैं"
    },
    {
      "subtitle_id": 233,
      "start": 503.759,
      "end": 507.479,
      "text": "जिनको फंडामेंटल एनालिसिस बढ़िया अच्छे"
    },
    {
      "subtitle_id": 234,
      "start": 505.72,
      "end": 509.479,
      "text": "तरीके से आता है उन्होंने भी यहां पर यह"
    },
    {
      "subtitle_id": 235,
      "start": 507.479,
      "end": 510.879,
      "text": "प्रॉब्लम्स डिटेक्ट की होगी सबसे पहले"
    },
    {
      "subtitle_id": 236,
      "start": 509.479,
      "end": 512.88,
      "text": "पहला पॉइंट तो यह है कि अगर कंपनी के"
    },
    {
      "subtitle_id": 237,
      "start": 510.879,
      "end": 515.32,
      "text": "प्रमोटर्स लगातार शेयर बेच रहे हैं या फिर"
    },
    {
      "subtitle_id": 238,
      "start": 512.88,
      "end": 517.519,
      "text": "कंप्लीट शेयर्स बेच रहे हैं तो वहां पर"
    },
    {
      "subtitle_id": 239,
      "start": 515.32,
      "end": 520.279,
      "text": "कुछ ना कुछ गड़बड़ हो सकती है वो पहला"
    },
    {
      "subtitle_id": 240,
      "start": 517.519,
      "end": 522.479,
      "text": "इंडिकेटर है हालांकि 100% ये नहीं बता था"
    },
    {
      "subtitle_id": 241,
      "start": 520.279,
      "end": 524.48,
      "text": "कि गड़बड़ होगी होगी लेकिन पहला रेड फ्लैग"
    },
    {
      "subtitle_id": 242,
      "start": 522.479,
      "end": 526.24,
      "text": "है तो आपको यह भी देखना है कि प्रमोटर अगर"
    },
    {
      "subtitle_id": 243,
      "start": 524.48,
      "end": 527.959,
      "text": "बहुत तेजी से शेयर्स बेच रहे हैं तो वहां"
    },
    {
      "subtitle_id": 244,
      "start": 526.24,
      "end": 529.92,
      "text": "पर आपको थोड़ा अलर्ट हो जाना है फिर आपको"
    },
    {
      "subtitle_id": 245,
      "start": 527.959,
      "end": 532.2,
      "text": "आना है कंपनी के प्रॉफिट एंड लॉस पर और"
    },
    {
      "subtitle_id": 246,
      "start": 529.92,
      "end": 535.04,
      "text": "यहां पर आप देख रहे हो कि 2023 तक"
    },
    {
      "subtitle_id": 247,
      "start": 532.2,
      "end": 537.12,
      "text": "रिवेन्यू जीरो है अचानक से वो 296 करोड़"
    },
    {
      "subtitle_id": 248,
      "start": 535.04,
      "end": 539.16,
      "text": "हो गया अभी कुछ ही टाइम में अब ये अचानक"
    },
    {
      "subtitle_id": 249,
      "start": 537.12,
      "end": 541.56,
      "text": "बढ़ गया तो ठीक है लेकिन इंटरेस्टिंग चीज"
    },
    {
      "subtitle_id": 250,
      "start": 539.16,
      "end": 543.72,
      "text": "कि कंपनी कुछ डेप्रिसिएशन बताना ही भूल गई"
    },
    {
      "subtitle_id": 251,
      "start": 541.56,
      "end": 546.079,
      "text": "है हालांकि कंपनी की बोरोंग आप देख सकते"
    },
    {
      "subtitle_id": 252,
      "start": 543.72,
      "end": 548.04,
      "text": "हो 4 करोड़ 5 करोड़ और अभी रिसेंटली 54"
    },
    {
      "subtitle_id": 253,
      "start": 546.079,
      "end": 549.72,
      "text": "करोड़ की हुई है इसके बाद भी कंपनी का"
    },
    {
      "subtitle_id": 254,
      "start": 548.04,
      "end": 551.72,
      "text": "इंटरेस्ट यहां पर एब्सलूट ज़ीरो आपको दिख"
    },
    {
      "subtitle_id": 255,
      "start": 549.72,
      "end": 553.32,
      "text": "रहा है तो यहां पर जो डेप्रिसिएशन है शायद"
    },
    {
      "subtitle_id": 256,
      "start": 551.72,
      "end": 555.12,
      "text": "फाइनेंशियल स्टेटमेंट को मैनिपुलेट करते"
    },
    {
      "subtitle_id": 257,
      "start": 553.32,
      "end": 557.16,
      "text": "वक्त ये लोग भूल गए कि डेप्रिसिएशन भी"
    },
    {
      "subtitle_id": 258,
      "start": 555.12,
      "end": 559.64,
      "text": "हमें कुछ दिखाना पड़ेगा फिक्स एसेट दिखाना"
    },
    {
      "subtitle_id": 259,
      "start": 557.16,
      "end": 561.32,
      "text": "भी कंपनी भूल गई 200 300 करोड़ का"
    },
    {
      "subtitle_id": 260,
      "start": 559.64,
      "end": 563.88,
      "text": "रेवेन्यू तो दिखा रहे हैं बट फिक्स एसेट्स"
    },
    {
      "subtitle_id": 261,
      "start": 561.32,
      "end": 565.839,
      "text": "हम दिखाना भूल गए चलिए यहां तक तो बात ठीक"
    },
    {
      "subtitle_id": 262,
      "start": 563.88,
      "end": 568.12,
      "text": "है पर एक चीज आपको बता दूं कि ठीक है"
    },
    {
      "subtitle_id": 263,
      "start": 565.839,
      "end": 570.32,
      "text": "रेवेन्यू बढ़ गया प्रॉफिट भी बढ़ गया"
    },
    {
      "subtitle_id": 264,
      "start": 568.12,
      "end": 571.959,
      "text": "लेकिन क्या वो रियल है तो इसे वेरीफाई"
    },
    {
      "subtitle_id": 265,
      "start": 570.32,
      "end": 574.92,
      "text": "करने के लिए सबसे इंपॉर्टेंट चीज है वो है"
    },
    {
      "subtitle_id": 266,
      "start": 571.959,
      "end": 577.04,
      "text": "कैश फ्लो देखिए इंडिया में जो सिस्टम चलता"
    },
    {
      "subtitle_id": 267,
      "start": 574.92,
      "end": 579.12,
      "text": "है वो है एक्यूरल बेसिस पर यानी आप इनवॉइस"
    },
    {
      "subtitle_id": 268,
      "start": 577.04,
      "end": 580.8,
      "text": "दिखा दी आपने तो आप रेवेन्यू से नोट डाउन"
    },
    {
      "subtitle_id": 269,
      "start": 579.12,
      "end": 582.8,
      "text": "कर सकते हो उसके बेसिस पर प्रॉफिट दिखा"
    },
    {
      "subtitle_id": 270,
      "start": 580.8,
      "end": 584.959,
      "text": "सकते हो लेकिन वो इनवॉइस सच्ची वाली है या"
    },
    {
      "subtitle_id": 271,
      "start": 582.8,
      "end": 586.56,
      "text": "फिर झूठी वाली यह कैसे पता करें और सही"
    },
    {
      "subtitle_id": 272,
      "start": 584.959,
      "end": 588.8,
      "text": "में इस इनवॉइस के बेसिस पर कंपनी को"
    },
    {
      "subtitle_id": 273,
      "start": 586.56,
      "end": 591.0,
      "text": "बिजनेस आया है कि नहीं आया इसे चेक करने"
    },
    {
      "subtitle_id": 274,
      "start": 588.8,
      "end": 592.56,
      "text": "का एक मात्र तरीका है और वो है कैश फ्लो"
    },
    {
      "subtitle_id": 275,
      "start": 591.0,
      "end": 594.399,
      "text": "स्टेटमेंट और इसीलिए कैश फ्लो स्टेटमेंट"
    },
    {
      "subtitle_id": 276,
      "start": 592.56,
      "end": 597.2,
      "text": "को तैयार भी किया जाता है टू वेरीफाई द"
    },
    {
      "subtitle_id": 277,
      "start": 594.399,
      "end": 598.88,
      "text": "थिंग्स और यहां पर अगर हम कंपनी का कैश"
    },
    {
      "subtitle_id": 278,
      "start": 597.2,
      "end": 600.68,
      "text": "जनरेट फ्रॉम ऑपरेटिंग एक्टिविटीज देखते"
    },
    {
      "subtitle_id": 279,
      "start": 598.88,
      "end": 603.72,
      "text": "हैं तो यह लगातार नेगेटिव में है जिसका"
    },
    {
      "subtitle_id": 280,
      "start": 600.68,
      "end": 606.04,
      "text": "मतलब यह है कि कंपनी अपना प्रॉफिट तो बता"
    },
    {
      "subtitle_id": 281,
      "start": 603.72,
      "end": 607.959,
      "text": "रही है कंपनी ने दिखा दिया कि भाई हमें 16"
    },
    {
      "subtitle_id": 282,
      "start": 606.04,
      "end": 610.0,
      "text": "करोड़ का प्रॉफिट हो गया पिछले 12 महीनों"
    },
    {
      "subtitle_id": 283,
      "start": 607.959,
      "end": 611.72,
      "text": "में उससे पहले 3 करोड़ का हो गया लेकिन"
    },
    {
      "subtitle_id": 284,
      "start": 610.0,
      "end": 613.839,
      "text": "कैश फ्लो स्टेटमेंट हमें यह बताता है कि"
    },
    {
      "subtitle_id": 285,
      "start": 611.72,
      "end": 615.88,
      "text": "कंपनी का कैश फ्लो एब्सलूट नेगेटिव है"
    },
    {
      "subtitle_id": 286,
      "start": 613.839,
      "end": 617.88,
      "text": "कंपनी के पास प्रॉफिट के तौर पर एक्चुअल"
    },
    {
      "subtitle_id": 287,
      "start": 615.88,
      "end": 619.68,
      "text": "में कैश कुछ भी नहीं आ रही अब ये कुछ बहुत"
    },
    {
      "subtitle_id": 288,
      "start": 617.88,
      "end": 621.959,
      "text": "इंडे फिल्टर्स नहीं है यह बहुत सिंपल"
    },
    {
      "subtitle_id": 289,
      "start": 619.68,
      "end": 624.959,
      "text": "फिल्टर्स है लेकिन और इस तरह के इनप"
    },
    {
      "subtitle_id": 290,
      "start": 621.959,
      "end": 626.959,
      "text": "फिल्टर्स यूज करके आप जो मतलब इससे भी"
    },
    {
      "subtitle_id": 291,
      "start": 624.959,
      "end": 628.68,
      "text": "ज्यादा स्मार्ट मैनेजमेंट है जो फ्रॉड"
    },
    {
      "subtitle_id": 292,
      "start": 626.959,
      "end": 630.48,
      "text": "करने की कोशिश कर रहा है उसे भी पता कर"
    },
    {
      "subtitle_id": 293,
      "start": 628.68,
      "end": 632.68,
      "text": "सकते हो तो इसलिए जरूरी है कि आप"
    },
    {
      "subtitle_id": 294,
      "start": 630.48,
      "end": 634.88,
      "text": "फंडामेंटल एनालिस्ट बनो बाय लर्निंग"
    },
    {
      "subtitle_id": 295,
      "start": 632.68,
      "end": 636.56,
      "text": "फंडामेंटल एनालिसिस और यह सारी चीजें अगर"
    },
    {
      "subtitle_id": 296,
      "start": 634.88,
      "end": 638.279,
      "text": "आपको सीखनी है तो मैं समझता हूं कि यह"
    },
    {
      "subtitle_id": 297,
      "start": 636.56,
      "end": 640.16,
      "text": "बेस्ट टाइम है न्यू ईयर न्यू ईयर में नई"
    },
    {
      "subtitle_id": 298,
      "start": 638.279,
      "end": 642.12,
      "text": "शुरुआत आप कर सकते हैं और हमारे इस न्यू"
    },
    {
      "subtitle_id": 299,
      "start": 640.16,
      "end": 643.959,
      "text": "ईयर न्यू मल्टीबैगर ऑफर में आपको हमारा"
    },
    {
      "subtitle_id": 300,
      "start": 642.12,
      "end": 648.399,
      "text": "फाउंडेशन कोर्स ऑन स्टॉक मार्केट प्लस"
    },
    {
      "subtitle_id": 301,
      "start": 643.959,
      "end": 648.399,
      "text": "फंडामेंटल एनालिसिस 2.0 यह ₹2500000"
    },
    {
      "subtitle_id": 302,
      "start": 659.519,
      "end": 662.16,
      "text": "और कमेंट बॉक्स में मिल जाएगी सबसे"
    },
    {
      "subtitle_id": 303,
      "start": 660.56,
      "end": 663.8,
      "text": "इंपोर्टेंट चीज लाइफ टाइम एक्सेस है आप"
    },
    {
      "subtitle_id": 304,
      "start": 662.16,
      "end": 666.44,
      "text": "कितनी भी बार इसे देख सकते हैं मल्टीपल"
    },
    {
      "subtitle_id": 305,
      "start": 663.8,
      "end": 668.24,
      "text": "सर्टिफिकेट्स आपको मिलते हैं और काफी सारा"
    },
    {
      "subtitle_id": 306,
      "start": 666.44,
      "end": 670.56,
      "text": "नॉलेज आपको मिलेगा था कि इस तरह की कंपनीज"
    },
    {
      "subtitle_id": 307,
      "start": 668.24,
      "end": 672.24,
      "text": "में आप कभी फंसी ना पाए यह पूरा कोर्स"
    },
    {
      "subtitle_id": 308,
      "start": 670.56,
      "end": 674.2,
      "text": "करने के बाद अगर आप मार्केट में उतरेंगे"
    },
    {
      "subtitle_id": 309,
      "start": 672.24,
      "end": 676.399,
      "text": "देखेंगे तो आपको ढेरों सारी भारत ग्लोबल"
    },
    {
      "subtitle_id": 310,
      "start": 674.2,
      "end": 678.72,
      "text": "डेवलपर जैसी कंपनीज मिलेगी जिससे आप"
    },
    {
      "subtitle_id": 311,
      "start": 676.399,
      "end": 680.8,
      "text": "नुकसान होने से बड़ी आसानी से बच सकते हो"
    },
    {
      "subtitle_id": 312,
      "start": 678.72,
      "end": 682.279,
      "text": "तो सीखने की शुरुआत नई ईयर से अभी कीजिए"
    },
    {
      "subtitle_id": 313,
      "start": 680.8,
      "end": 684.16,
      "text": "लिंक नीचे डिस्क्रिप्शन और कमेंट बॉक्स"
    },
    {
      "subtitle_id": 314,
      "start": 682.279,
      "end": 685.56,
      "text": "में दी गई है इस वीडियो को अपने सा ज्यादा"
    },
    {
      "subtitle_id": 315,
      "start": 684.16,
      "end": 687.399,
      "text": "से ज्यादा दोस्तों के साथ शेयर कीजिए जो"
    },
    {
      "subtitle_id": 316,
      "start": 685.56,
      "end": 690.2,
      "text": "कम प्राइस देखकर तुरंत शेयर की तरफ बढ़ते"
    },
    {
      "subtitle_id": 317,
      "start": 687.399,
      "end": 692.04,
      "text": "हैं और आजकल लोग जो है कंपनी के प्रमोटर्स"
    },
    {
      "subtitle_id": 318,
      "start": 690.2,
      "end": 693.959,
      "text": "हैं बहुत सारे फ्रॉड प्रमोटर्स हैं जो"
    },
    {
      "subtitle_id": 319,
      "start": 692.04,
      "end": 695.639,
      "text": "बहुत शातिर बन गए उन्हें पता है कि लोगों"
    },
    {
      "subtitle_id": 320,
      "start": 693.959,
      "end": 697.04,
      "text": "की वीकनेसेस क्या है नए लोग जो मार्केट"
    },
    {
      "subtitle_id": 321,
      "start": 695.639,
      "end": 698.68,
      "text": "में आ रहे हैं उन्हें नहीं पता होता यह"
    },
    {
      "subtitle_id": 322,
      "start": 697.04,
      "end": 700.88,
      "text": "सारी चीजें चेक करनी है उन्हें टैप करते"
    },
    {
      "subtitle_id": 323,
      "start": 698.68,
      "end": 703.48,
      "text": "हैं लाते हैं और उनका पैसा अपनी तरफ"
    },
    {
      "subtitle_id": 324,
      "start": 700.88,
      "end": 705.48,
      "text": "ट्रांसफर कर लेते हैं और यह चीज यनो बहुत"
    },
    {
      "subtitle_id": 325,
      "start": 703.48,
      "end": 707.48,
      "text": "बड़ी मात्रा में बड़े बहुत बड़े मायने में"
    },
    {
      "subtitle_id": 326,
      "start": 705.48,
      "end": 709.44,
      "text": "आजकल हो रही है और उसे रोकने का एक ही"
    },
    {
      "subtitle_id": 327,
      "start": 707.48,
      "end": 711.44,
      "text": "तरीका है वो है फाइनेंशियल अवेयरनेस तो और"
    },
    {
      "subtitle_id": 328,
      "start": 709.44,
      "end": 713.36,
      "text": "फंडामेंटल एनालिसिस सीखना और यह सारी"
    },
    {
      "subtitle_id": 329,
      "start": 711.44,
      "end": 714.88,
      "text": "चीजें समझना सो आशा करता हूं कि आप आने"
    },
    {
      "subtitle_id": 330,
      "start": 713.36,
      "end": 716.6,
      "text": "वाले टाइम में इस तरह की कंपनी से आराम से"
    },
    {
      "subtitle_id": 331,
      "start": 714.88,
      "end": 718.12,
      "text": "बच पाएंगे क्योंकि मिन फूड्स ने भी"
    },
    {
      "subtitle_id": 332,
      "start": 716.6,
      "end": 720.519,
      "text": "रिसेंटली इसी तरह का स्कैम किया बहुत बड़ा"
    },
    {
      "subtitle_id": 333,
      "start": 718.12,
      "end": 722.279,
      "text": "स्कैम है वो सिमिलर तरीके की चीजें थी य"
    },
    {
      "subtitle_id": 334,
      "start": 720.519,
      "end": 724.24,
      "text": "वहां पर भी और इस तरह की चीजें आजकल"
    },
    {
      "subtitle_id": 335,
      "start": 722.279,
      "end": 725.839,
      "text": "इंडिया में बहुत बढ़ रही है तो हमें जगना"
    },
    {
      "subtitle_id": 336,
      "start": 724.24,
      "end": 727.959,
      "text": "होगा और सेल्फ अवेयर होकर एक अच्छा"
    },
    {
      "subtitle_id": 337,
      "start": 725.839,
      "end": 729.639,
      "text": "फंडामेंटल एनालिस्ट बनकर ही मार्केट में"
    },
    {
      "subtitle_id": 338,
      "start": 727.959,
      "end": 731.639,
      "text": "इन्वेस्ट करना होगा ताकि इस तरह से हमें"
    },
    {
      "subtitle_id": 339,
      "start": 729.639,
      "end": 733.36,
      "text": "कोई भी फंसा ना पाए सो आज तो रुकते हैं"
    },
    {
      "subtitle_id": 340,
      "start": 731.639,
      "end": 736.72,
      "text": "यहीं पर थैंक यू सो मच फॉर वाचिंग दिस टेक"
    },
    {
      "subtitle_id": 341,
      "start": 733.36,
      "end": 736.72,
      "text": "केयर बाय बाय"
    }
  ]
}