  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.08,
      "end": 4.72,
      "text": "अगर आप हाईएस्ट कैशबैक लोएस्ट या ज़ीरो"
    },
    {
      "subtitle_id": 2,
      "start": 2.48,
      "end": 7.04,
      "text": "एनुअल फीज और बेस्ट ऑफर्स वाला क्रेडिट"
    },
    {
      "subtitle_id": 3,
      "start": 4.72,
      "end": 8.96,
      "text": "कार्ड ढूंढ रहे हो तो आप सही जगह पर आए हो"
    },
    {
      "subtitle_id": 4,
      "start": 7.04,
      "end": 10.88,
      "text": "इस वीडियो में आपकी यह तलाश खत्म होने जा"
    },
    {
      "subtitle_id": 5,
      "start": 8.96,
      "end": 12.759,
      "text": "रही है क्योंकि यहां पर मैं आपके साथ ऐसे"
    },
    {
      "subtitle_id": 6,
      "start": 10.88,
      "end": 15.16,
      "text": "टॉप क्रेडिट कार्ड शेयर करने वाला हूं जो"
    },
    {
      "subtitle_id": 7,
      "start": 12.759,
      "end": 17.08,
      "text": "आपको हाईएस्ट कैशबैक देंगे बेस्ट ऑफर्स भी"
    },
    {
      "subtitle_id": 8,
      "start": 15.16,
      "end": 19.6,
      "text": "देंगे और ऊपर से इनके चार्जेस भी बहुत कम"
    },
    {
      "subtitle_id": 9,
      "start": 17.08,
      "end": 21.439,
      "text": "रहेंगे तो आज के इस वीडियो में 2025 के"
    },
    {
      "subtitle_id": 10,
      "start": 19.6,
      "end": 23.84,
      "text": "बेस्ट क्रेडिट कार्ड ऑप्शंस आपके सामने"
    },
    {
      "subtitle_id": 11,
      "start": 21.439,
      "end": 25.519,
      "text": "होंगे विद प्रॉपर डिटेल्स क्या-क्या आपको"
    },
    {
      "subtitle_id": 12,
      "start": 23.84,
      "end": 27.599,
      "text": "फायदे मिलने वाले हैं बहुत डिटेल में बात"
    },
    {
      "subtitle_id": 13,
      "start": 25.519,
      "end": 29.4,
      "text": "करेंगे और यहां पर किन-किन चीजों का आपको"
    },
    {
      "subtitle_id": 14,
      "start": 27.599,
      "end": 31.16,
      "text": "ध्यान भी रखना है क्योंकि कुछ-कुछ क्रेडिट"
    },
    {
      "subtitle_id": 15,
      "start": 29.4,
      "end": 32.64,
      "text": "कार्ड्स के कुछ ड्रॉबैक्स भी होते हैं तो"
    },
    {
      "subtitle_id": 16,
      "start": 31.16,
      "end": 34.68,
      "text": "जिसे हम आज के इस वीडियो में बहुत ही"
    },
    {
      "subtitle_id": 17,
      "start": 32.64,
      "end": 36.879,
      "text": "डिटेल में समझाने वाले हैं तो इस वीडियो"
    },
    {
      "subtitle_id": 18,
      "start": 34.68,
      "end": 39.0,
      "text": "में आपको बेस्ट क्रेडिट कार्ड 100% मिल"
    },
    {
      "subtitle_id": 19,
      "start": 36.879,
      "end": 40.52,
      "text": "जाएगा और हां चीजें और आसान करने के लिए"
    },
    {
      "subtitle_id": 20,
      "start": 39.0,
      "end": 41.92,
      "text": "इन सारे कार्ड्स की लिंक आपको नीचे"
    },
    {
      "subtitle_id": 21,
      "start": 40.52,
      "end": 43.239,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में मिल"
    },
    {
      "subtitle_id": 22,
      "start": 41.92,
      "end": 45.64,
      "text": "जाएगी जहां से आप इन कार्ड्स के लिए"
    },
    {
      "subtitle_id": 23,
      "start": 43.239,
      "end": 47.239,
      "text": "डायरेक्टली अप्लाई कर सकते हो नमस्कार मैं"
    },
    {
      "subtitle_id": 24,
      "start": 45.64,
      "end": 49.0,
      "text": "प्रसाद आपका आज के इस वीडियो में स्वागत"
    },
    {
      "subtitle_id": 25,
      "start": 47.239,
      "end": 50.92,
      "text": "करता हूं देखिए बेस्ट कार्ड सिलेक्ट करने"
    },
    {
      "subtitle_id": 26,
      "start": 49.0,
      "end": 53.039,
      "text": "के लिए कई सारे फिल्टर्स हमने लगाए कि"
    },
    {
      "subtitle_id": 27,
      "start": 50.92,
      "end": 54.92,
      "text": "सबसे बेस्ट कैशबैक कहां पर मिल रहा है साथ"
    },
    {
      "subtitle_id": 28,
      "start": 53.039,
      "end": 58.44,
      "text": "ही आपके जैसे जो अलग-अलग फीस जाती है वो"
    },
    {
      "subtitle_id": 29,
      "start": 54.92,
      "end": 58.44,
      "text": "कम से कम कहां पर है और इसके अलावा"
    },
    {
      "subtitle_id": 30,
      "start": 60.32,
      "end": 63.879,
      "text": "उसके कैशबैक्स के लिए और कौन से कार्ड्स"
    },
    {
      "subtitle_id": 31,
      "start": 62.12,
      "end": 65.72,
      "text": "हैं तो इन जैसे कई सारे फैक्टर्स का हमने"
    },
    {
      "subtitle_id": 32,
      "start": 63.879,
      "end": 67.72,
      "text": "यहां पर ध्यान रखा है तो चलिए शुरुआत करते"
    },
    {
      "subtitle_id": 33,
      "start": 65.72,
      "end": 69.6,
      "text": "हैं हमारे पहले कार्ड से जिसका नाम है एब"
    },
    {
      "subtitle_id": 34,
      "start": 67.72,
      "end": 71.08,
      "text": "कैशबैक क्रेडिट कार्ड तो जैसे कि यहां पर"
    },
    {
      "subtitle_id": 35,
      "start": 69.6,
      "end": 72.72,
      "text": "नाम में ही मेंशन है तो यह क्रेडिट कार्ड"
    },
    {
      "subtitle_id": 36,
      "start": 71.08,
      "end": 74.439,
      "text": "उन लोगों के लिए परफेक्ट है जो ज्यादा से"
    },
    {
      "subtitle_id": 37,
      "start": 72.72,
      "end": 76.479,
      "text": "ज्यादा कैशबैक देख रहे हैं तो कितना"
    },
    {
      "subtitle_id": 38,
      "start": 74.439,
      "end": 78.52,
      "text": "कैशबैक यहां पर आपको मिलता है तो फ्लैट 5"
    },
    {
      "subtitle_id": 39,
      "start": 76.479,
      "end": 80.04,
      "text": "पर का कैशबैक यहां पर आपको मिलता है और"
    },
    {
      "subtitle_id": 40,
      "start": 78.52,
      "end": 81.84,
      "text": "मोस्ट इंपॉर्टेंट थिंग कोई मर्चेंट"
    },
    {
      "subtitle_id": 41,
      "start": 80.04,
      "end": 84.439,
      "text": "रिस्ट्रिक्शन नहीं कि इसी प्लेटफॉर्म से"
    },
    {
      "subtitle_id": 42,
      "start": 81.84,
      "end": 86.2,
      "text": "खरीदोगे तो ही आपको कैशबैक मिलेगा उससे"
    },
    {
      "subtitle_id": 43,
      "start": 84.439,
      "end": 88.36,
      "text": "खरीदोगे तो य किसी भी प्लेटफॉर्म से"
    },
    {
      "subtitle_id": 44,
      "start": 86.2,
      "end": 90.439,
      "text": "ऑनलाइन आपका जो भी स्पेंड है उस पर फ्लैट"
    },
    {
      "subtitle_id": 45,
      "start": 88.36,
      "end": 92.56,
      "text": "5 पर आपको यहां पर कैशबैक मिल मिलता है"
    },
    {
      "subtitle_id": 46,
      "start": 90.439,
      "end": 94.52,
      "text": "अगर ऑफलाइन में भी आप स्पेंड कर रहे हो तो"
    },
    {
      "subtitle_id": 47,
      "start": 92.56,
      "end": 96.28,
      "text": "वहां पर भी आपको 1 पर का डायरेक्ट कैशबैक"
    },
    {
      "subtitle_id": 48,
      "start": 94.52,
      "end": 98.52,
      "text": "मिलता है यहां पर एक जॉइनिंग फीज आपको"
    },
    {
      "subtitle_id": 49,
      "start": 96.28,
      "end": 101.399,
      "text": "देनी पड़ती है 99 की लेकिन यह आप बड़ी"
    },
    {
      "subtitle_id": 50,
      "start": 98.52,
      "end": 104.079,
      "text": "इजली रिकवर कर सकते हो अगर आप ₹2000000 की"
    },
    {
      "subtitle_id": 51,
      "start": 101.399,
      "end": 106.079,
      "text": "शॉपिंग करते हो तो उसका % होता है ₹1 तो"
    },
    {
      "subtitle_id": 52,
      "start": 104.079,
      "end": 108.56,
      "text": "20000 की शॉपिंग तो साल में इजली हो ही"
    },
    {
      "subtitle_id": 53,
      "start": 106.079,
      "end": 110.24,
      "text": "जाती है तो व पैसा आपका तभी कवर हो जाता"
    },
    {
      "subtitle_id": 54,
      "start": 108.56,
      "end": 113.0,
      "text": "है और उसके एडिशन में जितना भी आपका"
    },
    {
      "subtitle_id": 55,
      "start": 110.24,
      "end": 115.88,
      "text": "स्पेंड रहेगा उसका 5 पर आपको लगातार मिलता"
    },
    {
      "subtitle_id": 56,
      "start": 113.0,
      "end": 118.24,
      "text": "रहेगा तो हर महीने 000 तक का कैशबैक यहां"
    },
    {
      "subtitle_id": 57,
      "start": 115.88,
      "end": 120.079,
      "text": "पर आपको मिलता है इसके अलावा 1 पर का"
    },
    {
      "subtitle_id": 58,
      "start": 118.24,
      "end": 121.759,
      "text": "फ्यूल सरचार्ज व्यूअर भी आपको यहां पर"
    },
    {
      "subtitle_id": 59,
      "start": 120.079,
      "end": 124.24,
      "text": "मिलता है अक्रॉस ऑल पेट्रोल पंप्स इन"
    },
    {
      "subtitle_id": 60,
      "start": 121.759,
      "end": 126.0,
      "text": "इंडिया नो लिमिट्स की किसी एक एचपी का ही"
    },
    {
      "subtitle_id": 61,
      "start": 124.24,
      "end": 127.88,
      "text": "होना चाहिए बीपीसीएल का होना चाहिए यानी"
    },
    {
      "subtitle_id": 62,
      "start": 126.0,
      "end": 129.52,
      "text": "कि कैशबैक के नाम पे बिना ज्यादा टर्म्स"
    },
    {
      "subtitle_id": 63,
      "start": 127.88,
      "end": 131.36,
      "text": "एंड कंडीशन डायरेक्ट कैशबैक यहां पर आपको"
    },
    {
      "subtitle_id": 64,
      "start": 129.52,
      "end": 133.2,
      "text": "मिलता है अब देखिए कार्ड्स की बात कर रहे"
    },
    {
      "subtitle_id": 65,
      "start": 131.36,
      "end": 135.56,
      "text": "हैं तो अलग-अलग फीज चार्जेस की भी बात"
    },
    {
      "subtitle_id": 66,
      "start": 133.2,
      "end": 137.64,
      "text": "होनी चाहिए तो यहां पर ₹ 9 की रिन्यूएबल"
    },
    {
      "subtitle_id": 67,
      "start": 135.56,
      "end": 139.72,
      "text": "फीज आपको लगती है एवरी ईयर आपको पे करनी"
    },
    {
      "subtitle_id": 68,
      "start": 137.64,
      "end": 141.28,
      "text": "है तो अगर आप इस कार से ₹ लाख से ज्यादा"
    },
    {
      "subtitle_id": 69,
      "start": 139.72,
      "end": 143.4,
      "text": "की अमाउंट स्पेंड कर रहे हो तो आपकी जो"
    },
    {
      "subtitle_id": 70,
      "start": 141.28,
      "end": 145.28,
      "text": "रिन्यूएबल फीज है वो आपको वापस मिल जाती"
    },
    {
      "subtitle_id": 71,
      "start": 143.4,
      "end": 147.16,
      "text": "है इसके अलावा इस कार्ड की एक और खासियत"
    },
    {
      "subtitle_id": 72,
      "start": 145.28,
      "end": 148.92,
      "text": "है जो मुझे काफी पसंद आई वो है कि अप टू"
    },
    {
      "subtitle_id": 73,
      "start": 147.16,
      "end": 150.92,
      "text": "थ्री एडऑन कार्ड्स की फैसिलिटी यहां पर"
    },
    {
      "subtitle_id": 74,
      "start": 148.92,
      "end": 152.84,
      "text": "मिलती है जिस में आप अपने फैमिली मेंबर्स"
    },
    {
      "subtitle_id": 75,
      "start": 150.92,
      "end": 154.56,
      "text": "को ऐड कर सकते हो वैसे ड ऑन क्रेडिट कार्ड"
    },
    {
      "subtitle_id": 76,
      "start": 152.84,
      "end": 156.04,
      "text": "एक सेकेंडरी क्रेडिट कार्ड होता है जो"
    },
    {
      "subtitle_id": 77,
      "start": 154.56,
      "end": 157.92,
      "text": "लिंक होता है प्राइमरी क्रेडिट कार्ड"
    },
    {
      "subtitle_id": 78,
      "start": 156.04,
      "end": 159.72,
      "text": "होल्डर के क्रेडिट कार्ड से इसका मतलब कि"
    },
    {
      "subtitle_id": 79,
      "start": 157.92,
      "end": 161.64,
      "text": "जो ड ऑन क्रेडिट कार्ड है इसके भी"
    },
    {
      "subtitle_id": 80,
      "start": 159.72,
      "end": 163.4,
      "text": "कैशबैक्स आपको अपने स्टेटमेंट में दिख"
    },
    {
      "subtitle_id": 81,
      "start": 161.64,
      "end": 165.519,
      "text": "जाएंगे यानी कि इस कार्ड में मिलने वाला"
    },
    {
      "subtitle_id": 82,
      "start": 163.4,
      "end": 167.239,
      "text": "कैशबैक आपके क्रेडिट कार्ड स्टेटमेंट में"
    },
    {
      "subtitle_id": 83,
      "start": 165.519,
      "end": 168.959,
      "text": "अपने आप क्रेडिट हो जाता है यानी कि"
    },
    {
      "subtitle_id": 84,
      "start": 167.239,
      "end": 170.64,
      "text": "बार-बार रिवॉर्ड पॉइंट्स को रिडीम करने की"
    },
    {
      "subtitle_id": 85,
      "start": 168.959,
      "end": 173.159,
      "text": "टेंशन ही नहीं तो यह कार्ड उन लोगों के"
    },
    {
      "subtitle_id": 86,
      "start": 170.64,
      "end": 174.879,
      "text": "लिए बेस्ट है जो यूनिवर्सल कैशबैक देख रहे"
    },
    {
      "subtitle_id": 87,
      "start": 173.159,
      "end": 176.56,
      "text": "हैं यानी किसी एक या दो प्लेटफॉर्म के"
    },
    {
      "subtitle_id": 88,
      "start": 174.879,
      "end": 178.599,
      "text": "जरिए नहीं जो भी ऑनलाइन स्पेंड करें उस पर"
    },
    {
      "subtitle_id": 89,
      "start": 176.56,
      "end": 180.56,
      "text": "उ जिन्हें कैशबैक चाहिए उनके लिए कार्ड"
    },
    {
      "subtitle_id": 90,
      "start": 178.599,
      "end": 182.4,
      "text": "काफी बेस्ट है हां एक छोटा सा ड्रॉबैक इस"
    },
    {
      "subtitle_id": 91,
      "start": 180.56,
      "end": 184.28,
      "text": "क्रेडिट कार्ड का है कि जो एयरपोर्ट फ्री"
    },
    {
      "subtitle_id": 92,
      "start": 182.4,
      "end": 186.0,
      "text": "लाउंज एक्सेस है वो इस कार्ड के साथ आपको"
    },
    {
      "subtitle_id": 93,
      "start": 184.28,
      "end": 187.959,
      "text": "नहीं मिलता है सो ट्रेवल अगर आपका"
    },
    {
      "subtitle_id": 94,
      "start": 186.0,
