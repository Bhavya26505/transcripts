    {
      "subtitle_id": 37,
      "start": 92.72,
      "end": 98.72,
      "text": "जाओगे सच बताओ तो समस्या चारों तरफ से आ"
    },
    {
      "subtitle_id": 38,
      "start": 95.119,
      "end": 101.24,
      "text": "रही है कैसे बताता हूं डीमार्ड तीन"
    },
    {
      "subtitle_id": 39,
      "start": 98.72,
      "end": 104.04,
      "text": "कैटेगरी से आती है पहला है फूड जहां से"
    },
    {
      "subtitle_id": 40,
      "start": 101.24,
      "end": 106.0,
      "text": "56.4 पर रेवेन्यू आता है जिसमें फूड"
    },
    {
      "subtitle_id": 41,
      "start": 104.04,
      "end": 107.719,
      "text": "वेजिटेबल कुकिंग ऑयल ये सारी चीजें भी आती"
    },
    {
      "subtitle_id": 42,
      "start": 106.0,
      "end": 109.799,
      "text": "है ये कैटेगरी डी मार् की मेजोरिटी"
