    {
      "subtitle_id": 20,
      "start": 54.559,
      "end": 58.359,
      "text": "वीडियो में बहुत डिटेल में बात करने वाला"
    },
    {
      "subtitle_id": 21,
      "start": 56.16,
      "end": 61.12,
      "text": "हूं तो आज हम जानेंगे कि क्यामा पर जो घने"
    },
    {
      "subtitle_id": 22,
      "start": 58.359,
      "end": 63.32,
      "text": "बादल छाए हैं वो छट तो अंत तक जरूर बने"
    },
    {
      "subtitle_id": 23,
      "start": 61.12,
      "end": 65.439,
      "text": "रहिए वीडियो शुरू करने से पहले आप सभी से"
