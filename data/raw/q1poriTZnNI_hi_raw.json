      "start": 779.76,
      "end": 782.72,
      "text": "काम करेगा तो गलती तो एक्सेप्ट कर ली है"
    },
    {
      "subtitle_id": 291,
      "start": 781.36,
      "end": 784.44,
      "text": "किस तरह से काम करते हैं आने वाले एक दो"
    },
    {
      "subtitle_id": 292,
      "start": 782.72,
      "end": 786.48,
      "text": "क्वार्टर में हमें पता चलेगा उसके बारे"
    },
    {
      "subtitle_id": 293,
      "start": 784.44,
      "end": 788.44,
      "text": "में भी मैं आपको अपडेट करूंगा अब बात करते"
    },
    {
      "subtitle_id": 294,
      "start": 786.48,
      "end": 790.36,
      "text": "हैं कंपनी के वैल्यूएशन की तो एक जमाने"
    },
    {
      "subtitle_id": 295,
      "start": 788.44,
      "end": 793.24,
      "text": "में कंपनी का जो पी रेशो था 200 से भी"
    },
    {
      "subtitle_id": 296,
      "start": 790.36,
      "end": 794.88,
      "text": "ज्यादा था अभी वो 95 पर आ चुका है अभी भी"
    },
    {
      "subtitle_id": 297,
      "start": 793.24,
      "end": 796.92,
      "text": "मैं देखूं तो ग्रोथ आपकी उतनी नहीं हो"
    },
    {
      "subtitle_id": 298,
      "start": 794.88,
      "end": 798.399,
      "text": "पाएगी ये क्लियर है इसीलिए शेयर प्राइस"
    },
    {
      "subtitle_id": 299,
      "start": 796.92,
      "end": 800.0,
      "text": "गिर रही है और ये शेयर प्राइस नहीं गिर"
    },
    {
      "subtitle_id": 300,
      "start": 798.399,
      "end": 801.36,
      "text": "रही है ये आपको जो हाई वैल्यूएशन है वो"
    },
    {
      "subtitle_id": 301,
      "start": 800.0,
      "end": 802.839,
      "text": "कहीं ना कहीं करेक्ट हो रहा है और आने"
    },
    {
      "subtitle_id": 302,
      "start": 801.36,
      "end": 805.279,
      "text": "वाले टाइम में ये और भी ज्यादा करेक्ट हो"
    },
    {
      "subtitle_id": 303,
      "start": 802.839,
      "end": 808.519,
      "text": "सकता है क्योंकि उतनी ग्रोथ मिलना बहुत टफ"
    },
    {
      "subtitle_id": 304,
      "start": 805.279,
      "end": 810.44,
      "text": "है 30 35 30 35 मिलेगी तो 7080 का पी ओके"
    },
    {
      "subtitle_id": 305,
      "start": 808.519,
      "end": 812.519,
      "text": "है लेकिन लोगों ने काफी ज्यादा वैल्यूएशन"
    },
    {
      "subtitle_id": 306,
      "start": 810.44,
      "end": 814.24,
      "text": "कंपनी को देकर रखा था तो एक और वैल्यूड"
    },
    {
      "subtitle_id": 307,
      "start": 812.519,
      "end": 816.0,
      "text": "कंपनी बन चुकी थी ये और अभी उस तरह की"
    },
    {
      "subtitle_id": 308,
      "start": 814.24,
      "end": 818.079,
      "text": "ग्रोथ पॉसिबल नहीं है इसलिए वैल्यूएशन में"
    },
    {
      "subtitle_id": 309,
      "start": 816.0,
      "end": 819.68,
      "text": "एक क्लियर करेक्शन हमें देखने मिल रहा है"
    },
    {
      "subtitle_id": 310,
      "start": 818.079,
      "end": 821.32,
      "text": "लास्ट में इतना बोलूंगा कि राधाकृष्ण"
    },
    {
      "subtitle_id": 311,
      "start": 819.68,
      "end": 823.16,
      "text": "दमानी जो है वो काफी एक्सपीरियंस प्लेयर"
    },
    {
      "subtitle_id": 312,
      "start": 821.32,
      "end": 825.279,
      "text": "हैं तो उन्हें पता है कि क्या कुछ चीजें"
    },
    {
      "subtitle_id": 313,
      "start": 823.16,
      "end": 826.959,
      "text": "करनी पड़ेगी कंपनी के जो सीईओ है वो भी"
    },
    {
      "subtitle_id": 314,
      "start": 825.279,
      "end": 828.639,
      "text": "काफी एक्सपीरियंस्ड है उन्हें भी पता है"
    },
    {
      "subtitle_id": 315,
      "start": 826.959,
      "end": 830.36,
      "text": "कि कैसे चीजें करनी है तो अगले एक दो"
    },
    {
      "subtitle_id": 316,
      "start": 828.639,
      "end": 832.48,
      "text": "क्वार्टर में क्लोजल ट्रैक करना जरूरी है"
    },
    {
      "subtitle_id": 317,
      "start": 830.36,
      "end": 834.44,
      "text": "कि क्या ये कुछ नया करते हैं अगर नया नहीं"
    },
    {
      "subtitle_id": 318,
      "start": 832.48,
      "end": 837.0,
      "text": "करेंगे सेम स्ट्रेटेजी को अडॉप्ट करके"
    },
    {
      "subtitle_id": 319,
      "start": 834.44,
      "end": 839.36,
      "text": "रुकेंगे तो ग्रोथ और धीमी हो जाएगी ऐसा"
    },
    {
      "subtitle_id": 320,
      "start": 837.0,
      "end": 841.12,
      "text": "क्लियर दिखाई दे रहा है फिलहाल हम यहीं पर"
    },
    {
      "subtitle_id": 321,
      "start": 839.36,
      "end": 843.24,
      "text": "रुकते हैं जाते-जाते हमारी कमो ऑफर को"
    },
    {
      "subtitle_id": 322,
      "start": 841.12,
      "end": 845.24,
      "text": "जरूर चेक आउट कीजिए इसके बास आखिरी दो"
    },
    {
      "subtitle_id": 323,
      "start": 843.24,
      "end": 847.079,
      "text": "घंटे बाकी है इसके बाद इस प्राइस पर यह"
    },
    {
      "subtitle_id": 324,
      "start": 845.24,
      "end": 849.0,
      "text": "कमो आपको बाद में कभी नहीं मिलेंगे सो"
    },
    {
      "subtitle_id": 325,
      "start": 847.079,
      "end": 850.48,
      "text": "एनरोल नाउ मिलते हैं कमो के पहले एपिसोड"
    },
    {
      "subtitle_id": 326,
      "start": 849.0,
      "end": 852.639,
      "text": "में लिंक नीचे डिस्क्रिप्शन और कमेंट"
    },
    {
      "subtitle_id": 327,
      "start": 850.48,
      "end": 855.639,
      "text": "बॉक्स में दी गई है बाय बाय टेक केयर सी"
    },
    {
      "subtitle_id": 328,
      "start": 852.639,
      "end": 855.639,
      "text": "यू"
    }
  ]
}