      "start": 188.04,
      "end": 191.4,
      "text": "लेकर एडवांस लेवल तक सीख सकते हो जिसके"
    },
    {
      "subtitle_id": 78,
      "start": 189.72,
      "end": 193.319,
      "text": "बाद आपको किसी पर भी डिपेंड रहने की जरूरत"
    },
    {
      "subtitle_id": 79,
      "start": 191.4,
      "end": 195.519,
      "text": "नहीं 100% प्रैक्टिकल ये कोर्स है सारे"
    },
    {
      "subtitle_id": 80,
      "start": 193.319,
      "end": 197.48,
      "text": "एग्जांपल्स लाइव और प्रैक्टिकल लिए हैं जो"
    },
    {
      "subtitle_id": 81,
      "start": 195.519,
      "end": 199.4,
      "text": "आपको काफी मजेदार तरीके से मार्केट सीखने"
