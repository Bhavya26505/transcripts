      "end": 31.08,
      "text": "अपने ऑल टाइम हाई ₹ 323 से 26 पर नीचे है"
    },
    {
      "subtitle_id": 9,
      "start": 29.439,
      "end": 32.68,
      "text": "और अगर मैं सेकंड क्वार्टर के रिजल्ट्स की"
    },
    {
      "subtitle_id": 10,
      "start": 31.08,
      "end": 35.239,
      "text": "बात करूं तो रेवेन्यू फर्स्ट क्वार्टर के"
    },
    {
      "subtitle_id": 11,
      "start": 32.68,
      "end": 38.16,
      "text": "मुकाबले बिल्कुल ही फ्लैट है और अगर नेट"
    },
    {
      "subtitle_id": 12,
      "start": 35.239,
      "end": 40.28,
      "text": "प्रॉफिट की बात करूं तो वो था 659 करोड़"
    },
    {
      "subtitle_id": 13,
      "start": 38.16,
      "end": 42.48,
      "text": "जो कि फर्स्ट क्वार्टर के मुकाबले कम हुआ"
    },
    {
      "subtitle_id": 14,
      "start": 40.28,
      "end": 44.559,
      "text": "है अब नंबर्स इतने भी बुरे नहीं है कि"
    },
    {
      "subtitle_id": 15,
      "start": 42.48,
      "end": 46.559,
      "text": "शेयर प्राइस एक ही महीने में 13 पर से गिर"
    },
    {
      "subtitle_id": 16,
      "start": 44.559,
      "end": 49.32,
      "text": "जाए लेकिन कहते हैं ना कि दुनिया में कोई"
    },
    {
      "subtitle_id": 17,
      "start": 46.559,
      "end": 51.879,
      "text": "भी चीज बगैर रीजन के नहीं होती उसी तरह ार"
    },
    {
      "subtitle_id": 18,
      "start": 49.32,
      "end": 54.559,
      "text": "के शेयर प्राइस फॉल के पीछे एक नहीं बल्कि"
    },
    {
      "subtitle_id": 19,
      "start": 51.879,
      "end": 56.16,
      "text": "मल्टीपल रीजंस है और इस सब रीजंस की मैं"
