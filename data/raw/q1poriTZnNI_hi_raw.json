      "end": 201.48,
      "text": "में मदद करेगा ये हमारा जो बिग कमबोको"
    },
    {
      "subtitle_id": 83,
      "start": 199.4,
      "end": 203.4,
      "text": "मिलता है विथ लाइफ टाइम एक्सेस एंड फोर"
    },
    {
      "subtitle_id": 84,
      "start": 201.48,
      "end": 205.239,
      "text": "सर्टिफिकेट्स तो इस ऑफर को बिल्कुल भी मिस"
    },
    {
      "subtitle_id": 85,
      "start": 203.4,
      "end": 207.04,
      "text": "ना करें ये जो हमारी प्राइस है ये बहुत"
    },
    {
      "subtitle_id": 86,
      "start": 205.239,
      "end": 208.879,
      "text": "ज्यादा डिस्काउंटेड है इन चार कोर्सेस की"
    },
    {
      "subtitle_id": 87,
      "start": 207.04,
      "end": 210.959,
      "text": "वैल्यू के हिसाब से तो इस ऑफर को बिल्कुल"
    },
    {
      "subtitle_id": 88,
      "start": 208.879,
      "end": 213.0,
      "text": "भी मिस ना करें क्योंकि इन दो घंटों के"
    },
    {
      "subtitle_id": 89,
      "start": 210.959,
      "end": 214.72,
      "text": "बाद इस प्राइस में आपको यह कमो बाद में"
    },
    {
      "subtitle_id": 90,
      "start": 213.0,
      "end": 216.04,
      "text": "कभी नहीं मिलने वाला इसकी लिंक आपको नीचे"
    },
    {
      "subtitle_id": 91,
      "start": 214.72,
      "end": 217.84,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में मिल"
    },
    {
      "subtitle_id": 92,
      "start": 216.04,
      "end": 219.84,
      "text": "जाएगी अभी के अभी इस ऑफर का फायदा ले"
    },
