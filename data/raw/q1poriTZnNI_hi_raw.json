    {
      "subtitle_id": 27,
      "start": 69.4,
      "end": 73.52,
      "text": "नहीं किया है अभी कीजिए और इसके साथ ही"
    },
    {
      "subtitle_id": 28,
      "start": 71.56,
      "end": 76.0,
      "text": "घंटी भी दबा दीजिए क्योंकि घंटी बजाएंगे"
