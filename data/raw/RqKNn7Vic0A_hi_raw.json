  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.199,
      "end": 5.08,
      "text": "जिसका डर था आखिर वही हुआ आप यह न्यूज़"
    },
    {
      "subtitle_id": 2,
      "start": 2.879,
      "end": 7.279,
      "text": "देख लीजिए इंडिया के इंफ्लेशन रेट पहुंच"
    },
    {
      "subtitle_id": 3,
      "start": 5.08,
      "end": 8.96,
      "text": "गई है 14 मंथ्स के हाई पर पिछले साल"
    },
    {
      "subtitle_id": 4,
      "start": 7.279,
      "end": 12.799,
      "text": "अक्टूबर में जो रिटेल इंफ्लेशन थी इंडिया"
    },
    {
      "subtitle_id": 5,
      "start": 8.96,
      "end": 14.04,
      "text": "की वो 4.87 पर थी जोब अक्टूबर 2024 में"
    },
    {
      "subtitle_id": 6,
      "start": 12.799,
      "end": 16.88,
      "text": "बढ़कर हो गई है"
    },
    {
      "subtitle_id": 7,
      "start": 14.04,
      "end": 18.68,
      "text": "6.21 काफी बड़ा इजाफा इसमें हुआ है अब जो"
    },
    {
      "subtitle_id": 8,
      "start": 16.88,
      "end": 20.519,
      "text": "रिजर्व बैंक ऑफ इंडिया यानी आरबीआई है व"
    },
    {
      "subtitle_id": 9,
      "start": 18.68,
      "end": 22.84,
      "text": "हमेशा चाहता है कि ये जो इंफ्लेशन है ये 6"
    },
    {
      "subtitle_id": 10,
      "start": 20.519,
      "end": 25.32,
      "text": "पर से कम रहे लेकिन अब उस सीलिंग से भी"
    },
    {
      "subtitle_id": 11,
      "start": 22.84,
      "end": 28.279,
      "text": "ऊपर चला गया है यानी कि चीजें अब महंगी हो"
    },
    {
      "subtitle_id": 12,
      "start": 25.32,
      "end": 30.759,
      "text": "रही है अब यह तो न्यूज़ नंबर वन थी न्यूज़"
    },
    {
      "subtitle_id": 13,
      "start": 28.279,
      "end": 32.599,
      "text": "नंबर टू पर थोड़ी नजर डालिए ले इंडिया के"
    },
    {
      "subtitle_id": 14,
      "start": 30.759,
      "end": 34.399,
      "text": "मैनेजिंग डायरेक्टर ने कहा है कि मिडिल"
    },
    {
      "subtitle_id": 15,
      "start": 32.599,
      "end": 36.239,
      "text": "क्लास का जो नंबर है इंडिया में श्रिंक"
    },
    {
      "subtitle_id": 16,
      "start": 34.399,
      "end": 37.879,
      "text": "होता जा रहा है यानी कम होता जा रहा है"
    },
    {
      "subtitle_id": 17,
      "start": 36.239,
      "end": 40.44,
      "text": "उन्होंने यह भी कहा कि इस वजह से ले"
    },
    {
      "subtitle_id": 18,
      "start": 37.879,
      "end": 42.28,
      "text": "इंडिया के जो सेल्स है सिर्फ 1 से 2 पर से"
    },
    {
      "subtitle_id": 19,
      "start": 40.44,
      "end": 43.76,
      "text": "ही बढ़ रही है नेसली इंडिया के प्रोडक्ट्स"
    },
    {
      "subtitle_id": 20,
      "start": 42.28,
      "end": 45.96,
      "text": "तो आपको पता ही है अलग-अलग कॉफी ब्रांड्स"
    },
    {
      "subtitle_id": 21,
      "start": 43.76,
      "end": 47.68,
      "text": "मैगी वगैरह ये सब ये लोग बनाते हैं अब ये"
    },
    {
      "subtitle_id": 22,
      "start": 45.96,
      "end": 50.64,
      "text": "बात फाइनेंस मिनिस्ट्री ने भी मान ली है"
    },
    {
      "subtitle_id": 23,
      "start": 47.68,
      "end": 52.96,
      "text": "कि कंजमेट स्लो डाउन हो रही है अब आप इस"
    },
    {
      "subtitle_id": 24,
      "start": 50.64,
      "end": 55.239,
      "text": "न्यूज़ नंबर थ्री पर नजर डालिए पैसेंजर"
    },
    {
      "subtitle_id": 25,
      "start": 52.96,
      "end": 57.64,
      "text": "व्हीकल के जो सेल्स है वो 19 पर डाउन है"
    },
    {
      "subtitle_id": 26,
      "start": 55.239,
      "end": 60.239,
      "text": "19 पर से और जो इन्वेंटरीज है कार कंपनीज"
    },
    {
      "subtitle_id": 27,
      "start": 57.64,
      "end": 62.039,
      "text": "की वो लगातार बढ़ती जा रही है और मैं आपको"
    },
    {
      "subtitle_id": 28,
      "start": 60.239,
      "end": 64.72,
      "text": "ऐसी दर्जनों न्यूज़ दिखा सकता हूं जो एक"
    },
    {
      "subtitle_id": 29,
      "start": 62.039,
      "end": 66.6,
      "text": "ही ओर इशारा कर रही है और वो यह कि भारत"
    },
    {
      "subtitle_id": 30,
      "start": 64.72,
      "end": 68.759,
      "text": "में अगर रियल सेंस में कोई प्रॉब्लम में"
    },
    {
      "subtitle_id": 31,
      "start": 66.6,
      "end": 71.56,
      "text": "है दिक्कत में है तो वो है इंडिया का"
    },
    {
      "subtitle_id": 32,
      "start": 68.759,
      "end": 73.6,
      "text": "मिडिल क्लास यह जो प्रजाति है मिडिल क्लास"
    },
    {
      "subtitle_id": 33,
      "start": 71.56,
      "end": 75.4,
      "text": "वो ईमानदारी से टैक्स भरती आई है लेकिन"
    },
    {
      "subtitle_id": 34,
      "start": 73.6,
      "end": 77.759,
      "text": "उसके बदले में उन्हें मिला क्या तो"
    },
    {
      "subtitle_id": 35,
      "start": 75.4,
      "end": 80.04,
      "text": "हिस्टॉरिकली अगर देखा जाए तो उन पर टैक्स"
    },
    {
      "subtitle_id": 36,
      "start": 77.759,
      "end": 82.36,
      "text": "लगातार बढ़ाए गए हैं और उसके बदले में"
    },
    {
      "subtitle_id": 37,
      "start": 80.04,
      "end": 83.96,
      "text": "उन्हें बेसिक फैसिलिटी तक नहीं मिलती है"
    },
    {
      "subtitle_id": 38,
      "start": 82.36,
      "end": 85.96,
      "text": "मैं यह न्यूज़ काफी दिनों से देख रहा हूं"
    },
    {
      "subtitle_id": 39,
      "start": 83.96,
      "end": 88.4,
      "text": "कि ओवरऑल इंडियन इकॉनमी की हालत पिछले कुछ"
    },
    {
      "subtitle_id": 40,
      "start": 85.96,
      "end": 90.56,
      "text": "महीनों से धीरे-धीरे वीक होती जा रही है"
    },
    {
      "subtitle_id": 41,
      "start": 88.4,
      "end": 92.28,
      "text": "और इसका इंपैक्ट आप सब सिबर क्वार्टर के"
    },
    {
      "subtitle_id": 42,
      "start": 90.56,
      "end": 94.24,
      "text": "कंपनी के रिजल्ट्स पर देख ही सकते हो बहुत"
    },
    {
      "subtitle_id": 43,
      "start": 92.28,
      "end": 96.6,
      "text": "सारी जो कंज्यूमर कंपनीज हैं दे आर"
    },
    {
      "subtitle_id": 44,
      "start": 94.24,
      "end": 98.479,
      "text": "स्ट्रगलिंग एंड उस वजह से और फिर एक दो"
    },
    {
      "subtitle_id": 45,
      "start": 96.6,
      "end": 100.479,
      "text": "चीजें और हो गई जिसकी वजह से शेयर मार्केट"
    },
    {
      "subtitle_id": 46,
      "start": 98.479,
      "end": 102.24,
      "text": "में भी उसका इंपैक्ट आपको देखने मिला पर"
    },
    {
      "subtitle_id": 47,
      "start": 100.479,
      "end": 105.479,
      "text": "फिनो शंस पर हम जो भी बात करते हैं वो"
    },
    {
      "subtitle_id": 48,
      "start": 102.24,
      "end": 106.96,
      "text": "फीलिंग्लेस की करते हैं जब हमने अपना"
    },
    {
      "subtitle_id": 49,
      "start": 105.479,
      "end": 109.0,
      "text": "रिसर्च शुरू किया डेटा और फैक्ट्स को"
    },
    {
      "subtitle_id": 50,
      "start": 106.96,
      "end": 111.119,
      "text": "ढूंढने का तो ऐसे काफी सारी सीरियस और"
    },
    {
      "subtitle_id": 51,
      "start": 109.0,
      "end": 113.439,
      "text": "इंटरेस्टिंग चीजें हमारे सामने आई जो बहुत"
    },
    {
      "subtitle_id": 52,
      "start": 111.119,
      "end": 115.759,
      "text": "शॉकिंग है और आप सभी को जानना बहुत जरूरी"
    },
    {
      "subtitle_id": 53,
      "start": 113.439,
      "end": 117.719,
      "text": "है और इसीलिए हम इस वीडियो को आपके सामने"
    },
    {
      "subtitle_id": 54,
      "start": 115.759,
      "end": 119.6,
      "text": "लेकर आए हैं तो इस वीडियो में हम बात"
    },
    {
      "subtitle_id": 55,
      "start": 117.719,
      "end": 123.759,
      "text": "करेंगे कि आखिर मिडिल क्लास पर हाई टेक्स"
    },
    {
      "subtitle_id": 56,
      "start": 119.6,
      "end": 123.759,
      "text": "का क्या असर पड़ा है डिमांड इनकम"
    },
    {
      "subtitle_id": 57,
      "start": 124.28,
      "end": 128.8,
      "text": "कंजमेट पर भी बात करेंगे कि क्या यह"
    },
    {
      "subtitle_id": 58,
      "start": 126.56,
      "end": 130.119,
      "text": "समस्या आने वाले दिनों में कम होगी तो"
    },
    {
      "subtitle_id": 59,
      "start": 128.8,
      "end": 132.12,
      "text": "डिटेल में इस वीडियो में इसके बारे में"
    },
    {
      "subtitle_id": 60,
      "start": 130.119,
      "end": 133.92,
      "text": "बात करते हैं नमस्कार मैं प्रसाद आपका आज"
    },
    {
      "subtitle_id": 61,
      "start": 132.12,
      "end": 136.08,
      "text": "के इस वीडियो में स्वागत करता हूं आज के"
    },
    {
      "subtitle_id": 62,
      "start": 133.92,
      "end": 138.12,
      "text": "इस वीडियो के प्रायोजक है ओडू जिनके बारे"
    },
    {
      "subtitle_id": 63,
      "start": 136.08,
      "end": 139.959,
      "text": "में हम वीडियो में आगे बात करेंगे बहुत"
    },
    {
      "subtitle_id": 64,
      "start": 138.12,
      "end": 142.4,
      "text": "सारे लोगों को लगता है कि कार सेल्स के जो"
    },
    {
      "subtitle_id": 65,
      "start": 139.959,
      "end": 145.239,
      "text": "नंबर है वो ऑटोमोबिल कंपनीज की ग्रोथ"
    },
    {
      "subtitle_id": 66,
      "start": 142.4,
      "end": 147.239,
      "text": "दिखाते हैं लेकिन उसके साथ-साथ वो इकोनॉमी"
    },
    {
      "subtitle_id": 67,
      "start": 145.239,
      "end": 149.239,
      "text": "के लिए एक इंपोर्टेंट इंडिकेटर भी है फॉर"
    },
    {
      "subtitle_id": 68,
      "start": 147.239,
      "end": 151.72,
      "text": "एग्जांपल जब-जब रिसेशन आता है पैसेंजर"
    },
    {
      "subtitle_id": 69,
      "start": 149.239,
      "end": 153.76,
      "text": "व्हीकल की सेल्स डीप होने लगती है जितने"
    },
    {
      "subtitle_id": 70,
      "start": 151.72,
      "end": 155.959,
      "text": "भी रिसेशन पहले हुए हैं उसमें आप ये डाटा"
    },
    {
      "subtitle_id": 71,
      "start": 153.76,
      "end": 158.16,
      "text": "क्रॉस वेरीफाई कर सकते हो इससे हमें यह"
    },
    {
      "subtitle_id": 72,
      "start": 155.959,
      "end": 160.08,
      "text": "पता चलता है कि जो एवरेज सिटीजन है उसके"
    },
    {
      "subtitle_id": 73,
      "start": 158.16,
      "end": 161.599,
      "text": "पास पैसों की कमी हो रही है जिससे वो"
    },
    {
      "subtitle_id": 74,
      "start": 160.08,
      "end": 163.84,
      "text": "पैसों का इस्तेमाल नेसेसरी चीजों को"
    },
    {
      "subtitle_id": 75,
      "start": 161.599,
      "end": 166.28,
      "text": "खरीदने के लिए लगा रहा है राद देन बाइंग"
    },
    {
      "subtitle_id": 76,
      "start": 163.84,
      "end": 168.04,
      "text": "कार्स अब अगर हम इंडिया के ऑटोमोबिल सेल्स"
    },
    {
      "subtitle_id": 77,
      "start": 166.28,
      "end": 170.12,
      "text": "नंबर पर ध्यान दें तो हमें एक पैटर्न"
    },
    {
      "subtitle_id": 78,
      "start": 168.04,
      "end": 172.2,
      "text": "दिखाई देता है फॉर एग्जांपल अगर हम इंडिया"
    },
    {
      "subtitle_id": 79,
      "start": 170.12,
      "end": 174.04,
      "text": "के मेन व्हीकल्स को कैटेगरी इज करते हैं"
    },
    {
      "subtitle_id": 80,
      "start": 172.2,
      "end": 175.959,
      "text": "तो पहली कैटेगरी निकल कर आती है अफोर्डेबल"
    },
    {
      "subtitle_id": 81,
      "start": 174.04,
      "end": 178.04,
      "text": "टू व्हीलर्स जो ज्यादातर लोअर क्लास और"
    },
    {
      "subtitle_id": 82,
      "start": 175.959,
      "end": 180.44,
      "text": "मिडिल क्लास प्रेफर करते हैं फिर आते हैं"
    },
    {
      "subtitle_id": 83,
      "start": 178.04,
      "end": 182.72,
      "text": "पैसेंजर व्हीकल्स यानी कि आपकी कार जो कि"
    },
    {
      "subtitle_id": 84,
      "start": 180.44,
      "end": 184.84,
      "text": "ज्यादातर मिडिल क्लास बाय करती है फिर आती"
    },
    {
      "subtitle_id": 85,
      "start": 182.72,
      "end": 186.68,
      "text": "है आपकी एसयूवी और हाई एंड कार्स जो कि"
    },
    {
      "subtitle_id": 86,
      "start": 184.84,
      "end": 188.64,
      "text": "अप्पर मिडिल क्लास और रिच लोग बाय करते"
    },
    {
      "subtitle_id": 87,
      "start": 186.68,
      "end": 190.36,
      "text": "हैं तो अगर आप रिसेंट डटा पर ध्यान देंगे"
    },
    {
      "subtitle_id": 88,
      "start": 188.64,
      "end": 192.44,
      "text": "तो आपको पता चलेगा कि इंडिया में कार"
    },
    {
      "subtitle_id": 89,
      "start": 190.36,
      "end": 194.92,
      "text": "सेल्स ऑल टाइम लो है पर एक नंबर भी आप"
    },
    {
      "subtitle_id": 90,
      "start": 192.44,
      "end": 198.76,
      "text": "देखिए वोह है एसयूवी का एसयूवी का सेल्स"
    },
    {
      "subtitle_id": 91,
      "start": 194.92,
      "end": 201.239,
      "text": "ऑल टाइम हाइपर है maruti's की जो एसज है"
    },
    {
      "subtitle_id": 92,
      "start": 198.76,
      "end": 204.519,
      "text": "उनमें 20 पर की ईयर ऑन ईयर ग्रोथ हुई है"
    },
    {
      "subtitle_id": 93,
      "start": 201.239,
      "end": 204.519,
      "text": "वही mahindra-ecat"
    },
    {
      "subtitle_id": 94,
      "start": 209.879,
      "end": 214.2,
      "text": "रहे हैं जहां पिछले साल अक्टूबर में टू"
    },
    {
      "subtitle_id": 95,
      "start": 211.84,
      "end": 215.48,
      "text": "व्हीलर सेल्स क्लोज टू 19 लाख थी वही"
