    },
    {
      "subtitle_id": 288,
      "start": 642.76,
      "end": 646.0,
      "text": "बहुत बड़ा चैलेंज होने वाला है तो आने"
    },
    {
      "subtitle_id": 289,
      "start": 644.519,
      "end": 647.839,
      "text": "वाले टाइम में फिगर्स कहा जाती है मैं"
    },
    {
      "subtitle_id": 290,
      "start": 646.0,
      "end": 651.04,
      "text": "आपको अपडेट करता रहूंगा बट फिलहाल पिछले"
    },
    {
      "subtitle_id": 291,
      "start": 647.839,
      "end": 654.68,
      "text": "कुछ महीनों से नंबर्स न नॉट गुड नॉट फॉर द"
    },
    {
      "subtitle_id": 292,
      "start": 651.04,
      "end": 656.68,
      "text": "कंपनीज नॉट फॉर द पीपल और थोड़ी चीजें"
    },
    {
      "subtitle_id": 293,
      "start": 654.68,
      "end": 658.56,
      "text": "यहां पर कंसर्न वाली हो गई है तो अथॉरिटीज"
    },
    {
      "subtitle_id": 294,
      "start": 656.68,
      "end": 660.519,
      "text": "और जो कंपनीज है वो यहां पर क्या कुछ करती"
    },
    {
      "subtitle_id": 295,
      "start": 658.56,
      "end": 662.2,
      "text": "है आने वाले क्वार्टर्स में वो देखना बड़ा"
    },
    {
      "subtitle_id": 296,
      "start": 660.519,
      "end": 663.839,
      "text": "इंटरेस्टिंग रहेगा सो फिलहाल हम यहीं पर"
    },
    {
      "subtitle_id": 297,
      "start": 662.2,
      "end": 668.279,
      "text": "रुकते हैं मिलते हैं अगले वीडियो में थैंक"
    },
    {
      "subtitle_id": 298,
      "start": 663.839,
      "end": 668.279,
      "text": "यू सो मच सी यू टेक केयर बाय बाय"
    }
  ]
}