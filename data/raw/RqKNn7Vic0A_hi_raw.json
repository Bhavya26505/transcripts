    {
      "subtitle_id": 149,
      "start": 331.56,
      "end": 335.6,
      "text": "मैनेजमेंट मैन्युफैक्चरिंग एचआर"
    },
    {
      "subtitle_id": 150,
      "start": 333.56,
      "end": 337.88,
      "text": "मार्केटिंग प्रोडक्टिविटी या फिर कंपनी के"
