    {
      "subtitle_id": 107,
      "start": 239.799,
      "end": 244.56,
      "text": "लगातार बढ़ता जा रहा है 10 साल पहले 100"
    },
    {
      "subtitle_id": 108,
      "start": 242.079,
      "end": 247.799,
      "text": "में से 18 कार्स ऐसी थी जो हाई एंड कार्स"
    },
    {
      "subtitle_id": 109,
      "start": 244.56,
      "end": 250.159,
      "text": "थी उसका नंबर ऑफ 57 पर चला गया है अब यहां"
    },
    {
      "subtitle_id": 110,
      "start": 247.799,
      "end": 252.2,
      "text": "पर तीन चीजें सोची जा सकती है कि क्या यह"
    },
    {
      "subtitle_id": 111,
      "start": 250.159,
      "end": 254.48,
      "text": "सिर्फ लोगों के प्रेफरेंस का चेंज है या"
    },
    {
      "subtitle_id": 112,
      "start": 252.2,
      "end": 256.72,
      "text": "फिर यहां पर मिडिल क्लास की बाइंग पावर कम"
    },
    {
      "subtitle_id": 113,
      "start": 254.48,
      "end": 258.759,
      "text": "हो रही है या फिर ओरल मिडिल क्लास ही कम"
    },
    {
      "subtitle_id": 114,
      "start": 256.72,
      "end": 260.84,
      "text": "हो रहा है और टैक्सेस की बात करूंगा तो आप"
    },
    {
      "subtitle_id": 115,
      "start": 258.759,
      "end": 262.759,
      "text": "सब गुस्सा हो जाएंगे तो वैसे मिडिल क्लास"
    },
    {
      "subtitle_id": 116,
      "start": 260.84,
      "end": 265.08,
      "text": "के पास बहुत कम ऑप्शंस होते हैं उसमें से"
    },
    {
      "subtitle_id": 117,
      "start": 262.759,
      "end": 267.199,
      "text": "एक है बिजनेस खोलना क्योंकि आजकल सब कुछ"
    },
    {
      "subtitle_id": 118,
      "start": 265.08,
      "end": 270.479,
      "text": "ऑनलाइन हो गया है जिससे बहुत सारी चीजें"
    },
    {
      "subtitle_id": 119,
      "start": 267.199,
      "end": 272.28,
      "text": "आसान हुई हैं एक्सेप्ट वन चीज साइन करना"
    },
    {
      "subtitle_id": 120,
      "start": 270.479,
      "end": 274.759,
      "text": "और इसी चीज को सॉल्व करने के लिए ू ने"
    },
    {
      "subtitle_id": 121,
      "start": 272.28,
      "end": 276.12,
      "text": "लाया है अपना डिजिटल सिग्नेचर प्लेटफॉर्म"
    },
    {
      "subtitle_id": 122,
      "start": 274.759,
      "end": 278.039,
      "text": "जहां पर आप बड़े आसानी से ऑनलाइन"
    },
    {
      "subtitle_id": 123,
      "start": 276.12,
      "end": 279.88,
      "text": "डॉक्यूमेंट पर साइन कर सकते हो और फिर"
    },
    {
      "subtitle_id": 124,
      "start": 278.039,
      "end": 281.88,
      "text": "बड़ी आसानी से दूसरों से साइन करवा सकते"
    },
    {
      "subtitle_id": 125,
      "start": 279.88,
      "end": 283.8,
      "text": "हो यह पूरा प्रोसेस होता है 1 मिनट के"
    },
    {
      "subtitle_id": 126,
      "start": 281.88,
      "end": 285.68,
      "text": "अंदर बस आपको अपना डॉक्यूमेंट यहां पर"
    },
    {
      "subtitle_id": 127,
      "start": 283.8,
      "end": 287.88,
      "text": "अपलोड करना है फिर आपको मिलते हैं ड्रैग"
    },
    {
      "subtitle_id": 128,
      "start": 285.68,
      "end": 290.039,
      "text": "एंड ड्रॉप के ऑप्शंस जैसे कि नाम डेट"
    },
    {
      "subtitle_id": 129,
      "start": 287.88,
      "end": 291.68,
      "text": "एड्रेस ईमेल एक्सट्रा आप इजली ऑप्शंस को"
    },
    {
      "subtitle_id": 130,
      "start": 290.039,
      "end": 293.88,
      "text": "ड्रैग एंड ड्रॉप करके अपने डॉक्यूमेंट में"
    },
    {
      "subtitle_id": 131,
      "start": 291.68,
      "end": 295.72,
      "text": "डाल सकते हो जैसे मैंने सिग्नेचर का ऑप्शन"
    },
    {
      "subtitle_id": 132,
      "start": 293.88,
      "end": 297.72,
      "text": "ड्रैग करके इस डॉक्यूमेंट में जहां मुझे"
    },
    {
      "subtitle_id": 133,
      "start": 295.72,
      "end": 299.759,
      "text": "अपने एंप्लॉई का सिग्नेचर चाहिए था वहां"
    },
    {
      "subtitle_id": 134,
      "start": 297.72,
      "end": 301.68,
      "text": "डाल दिया अब मुझे कुछ नहीं करना है बस"
    },
    {
      "subtitle_id": 135,
      "start": 299.759,
      "end": 303.759,
      "text": "सेंड ऑप्शन पर क्लिक करना है ईमेल आईडी"
    },
    {
      "subtitle_id": 136,
      "start": 301.68,
      "end": 305.72,
      "text": "डालनी है और हो गया काम वो अपना साइन"
    },
    {
      "subtitle_id": 137,
      "start": 303.759,
      "end": 307.88,
      "text": "मैनुअली कर सकते हैं या फिर ऑटो मोड का"
    },
    {
      "subtitle_id": 138,
      "start": 305.72,
      "end": 309.919,
      "text": "ऑप्शन भी यहां पर यूज कर सकते हैं अब माउस"
    },
    {
      "subtitle_id": 139,
      "start": 307.88,
      "end": 312.24,
      "text": "से साइन करना दुनिया का एक बहुत टफ टास्क"
    },
    {
      "subtitle_id": 140,
      "start": 309.919,
      "end": 314.56,
      "text": "है तो यहां पर जो ओडू है आपको एक बहुत"
    },
    {
      "subtitle_id": 141,
      "start": 312.24,
      "end": 317.32,
      "text": "बेहतरीन ऑप्शन देता है आप अपना सिग्नेचर"
    },
    {
      "subtitle_id": 142,
      "start": 314.56,
      "end": 319.52,
      "text": "अपलोड भी कर सकते हो जस्ट अपलोड करो साइन"
    },
    {
      "subtitle_id": 143,
      "start": 317.32,
      "end": 322.4,
      "text": "पर क्लिक करो एंड डन और हां हमने तो सिर्फ"
    },
    {
      "subtitle_id": 144,
      "start": 319.52,
      "end": 324.52,
      "text": "ू के एक फीचर की बात की ू ऐसी डजन ऑफ"
    },
    {
      "subtitle_id": 145,
      "start": 322.4,
      "end": 327.16,
      "text": "चीजें आसान बनाता है जैसे आपकी कंपनी की"
    },
    {
      "subtitle_id": 146,
      "start": 324.52,
      "end": 329.88,
      "text": "वेबसाइट बनानी हो ओडू कर सकता है सेल्स"
    },
    {
      "subtitle_id": 147,
      "start": 327.16,
      "end": 331.56,
      "text": "डाटा को मैनेज करना है ओडू कर सकता है"
    },
    {
      "subtitle_id": 148,
      "start": 329.88,
      "end": 333.56,
      "text": "चाहे फाइनेंस अकाउंटिंग इन्वेंटरी"
