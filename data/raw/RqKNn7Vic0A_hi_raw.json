    {
      "subtitle_id": 151,
      "start": 335.6,
      "end": 339.84,
      "text": "एप्स को कस्टमाइज करना हो सब कुछ एक ही"
    },
    {
      "subtitle_id": 152,
      "start": 337.88,
      "end": 342.639,
      "text": "प्लेटफॉर्म ू कर सकता है और सबसे"
    },
    {
      "subtitle_id": 153,
      "start": 339.84,
      "end": 345.039,
      "text": "इंटरेस्टिंग बात u आपको एक ऐप लाइफ टाइम"
    },
    {
      "subtitle_id": 154,
      "start": 342.639,
      "end": 346.52,
      "text": "के लिए फ्री में देगा लाइफ टाइम के लिए तो"
    },
    {
      "subtitle_id": 155,
      "start": 345.039,
      "end": 347.84,
      "text": "वेट क्यों करना इसकी लिंक आपको नीचे"
    },
    {
      "subtitle_id": 156,
      "start": 346.52,
      "end": 350.24,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में मिल"
    },
    {
      "subtitle_id": 157,
      "start": 347.84,
      "end": 352.28,
      "text": "जाएगी तो अभी जाकर ू पर साइन अप कीजिए और"
    },
    {
      "subtitle_id": 158,
      "start": 350.24,
      "end": 354.36,
      "text": "अपना काम इंटेलिजेंट तरीके से और आसान"
    },
    {
      "subtitle_id": 159,
      "start": 352.28,
      "end": 356.8,
      "text": "बनाइए अब बढ़ते हैं वीडियो की तरफ एक और"
    },
    {
      "subtitle_id": 160,
      "start": 354.36,
      "end": 358.759,
      "text": "चीज आपको दिखाना चाहता हूं कंजमेट के आप"
    },
    {
      "subtitle_id": 161,
      "start": 356.8,
      "end": 360.4,
      "text": "नंबर्स देखिए जैसे कि आप स्क्रीन पर देख"
    },
    {
      "subtitle_id": 162,
      "start": 358.759,
      "end": 362.16,
      "text": "सकते हो कि अगर एफ एफएमसीजी कंपनी के"
    },
    {
      "subtitle_id": 163,
      "start": 360.4,
      "end": 363.96,
      "text": "सेल्स पर नजर डाले तो इंडिया की जो बड़ी"
    },
    {
      "subtitle_id": 164,
      "start": 362.16,
      "end": 366.12,
      "text": "एफएमसीजी कंपनीज हैं उनके सेल्स नंबर"
    },
    {
      "subtitle_id": 165,
      "start": 363.96,
      "end": 367.639,
      "text": "बिल्कुल फ्लैट हैं उनके शेयर प्राइसेस पर"
    },
    {
      "subtitle_id": 166,
      "start": 366.12,
      "end": 369.96,
      "text": "आप नजर डालेंगे तो आपको पता चलेगा कि"
    },
    {
      "subtitle_id": 167,
      "start": 367.639,
      "end": 373.24,
      "text": "हिंदुस्तान यूनिलीवर 14 पर से डाउन है"
    },
    {
      "subtitle_id": 168,
      "start": 369.96,
      "end": 375.599,
      "text": "नेसले 12 पर से डाउन है ब्रिटानिया 17 और"
    },
    {
      "subtitle_id": 169,
      "start": 373.24,
      "end": 378.28,
      "text": "बाकी कंपनीज भी आप देख सकते हो आप कोई भी"
    },
    {
      "subtitle_id": 170,
      "start": 375.599,
      "end": 380.44,
      "text": "एफएमसीजी कंपनी उठाकर देखिए वो स्ट्रगल"
    },
    {
      "subtitle_id": 171,
      "start": 378.28,
      "end": 382.12,
      "text": "करती हुई दिखाई दे रही है पिछले एक महीने"
    },
    {
      "subtitle_id": 172,
      "start": 380.44,
      "end": 384.759,
      "text": "में एफएमसीजी कंपनीज की जो शेयर प्राइस है"
    },
    {
      "subtitle_id": 173,
      "start": 382.12,
      "end": 386.479,
      "text": "ऑन एन एवरेज 15 टू 20 पर गिर चुकी है अब"
    },
    {
      "subtitle_id": 174,
      "start": 384.759,
      "end": 388.599,
      "text": "ऐसा क्यों हो रहा है तो इंफ्लेशन के बढ़ने"
    },
    {
      "subtitle_id": 175,
      "start": 386.479,
      "end": 388.599,
      "text": "से"
    },
    {
      "subtitle_id": 176,
      "start": 389.56,
      "end": 393.96,
      "text": "ए सजी कंपनीज करंट फाइनेंशियल ईयर में 8"
    },
    {
      "subtitle_id": 177,
      "start": 391.72,
      "end": 395.759,
      "text": "टू 9 पर से ग्रो करेगी वहीं पर अभ ये"
    },
    {
      "subtitle_id": 178,
      "start": 393.96,
      "end": 399.0,
      "text": "अनुमान लगाया जा रहा है कि यह नंबर गिरकर"
    },
    {
      "subtitle_id": 179,
      "start": 395.759,
      "end": 401.039,
      "text": "5 टू 6 पर ही रहेगा अब ये तो कंजमेट है जो"
    },
    {
      "subtitle_id": 180,
      "start": 399.0,
      "end": 402.84,
      "text": "काफी खराब है अब इसे डिटेल में समझने के"
    },
    {
      "subtitle_id": 181,
      "start": 401.039,
      "end": 405.639,
      "text": "लिए हमें यह समझना पड़ेगा कि जो कंज्यूमर"
    },
    {
      "subtitle_id": 182,
      "start": 402.84,
      "end": 408.16,
      "text": "है उसकी अर्निंग्स पर क्या इंपैक्ट पड़ा"
    },
    {
      "subtitle_id": 183,
      "start": 405.639,
      "end": 410.08,
      "text": "है इंडिया की जो हाउसहोल्ड इनकम है वह"
    },
    {
      "subtitle_id": 184,
      "start": 408.16,
      "end": 411.96,
      "text": "बढ़ने की बजाय कुछ रिपोर्ट बता रही है कि"
    },
    {
      "subtitle_id": 185,
      "start": 410.08,
      "end": 414.639,
      "text": "पिछले कुछ महीनों में वह लगातार गिरती जा"
    },
    {
      "subtitle_id": 186,
      "start": 411.96,
      "end": 417.24,
      "text": "रही है और एक सर्वे में तो यह तक पाया गया"
    },
    {
      "subtitle_id": 187,
      "start": 414.639,
      "end": 419.759,
      "text": "है कि हाफ ऑफ इंडियंस बिफोर बजट वर सेइंग"
    },
    {
      "subtitle_id": 188,
      "start": 417.24,
      "end": 421.8,
      "text": "कि उनकी इनकम इस साल पिछले साल से कम हुई"
    },
    {
      "subtitle_id": 189,
      "start": 419.759,
      "end": 423.639,
      "text": "है और फिर आपको तो पता ही है कि इस बजट"
    },
    {
      "subtitle_id": 190,
      "start": 421.8,
      "end": 425.52,
      "text": "में बाद में मिडिल क्लास को क्या मिला और"
    },
    {
      "subtitle_id": 191,
      "start": 423.639,
      "end": 427.919,
      "text": "वहीं पर इंडिया की अगर हम सेविंग रेट की"
    },
    {
      "subtitle_id": 192,
      "start": 425.52,
      "end": 429.879,
      "text": "बात करें तो हर साल वह कम होती जा रही है"
