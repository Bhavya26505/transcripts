      "subtitle_id": 192,
      "start": 449.68,
      "end": 453.96,
      "text": "ये लोग दावा करते हैं कि इसमें 108 तरह की"
    },
    {
      "subtitle_id": 193,
      "start": 451.479,
      "end": 455.96,
      "text": "जड़ी बूटियां हैं पर इनके पास किसी भी तरह"
    },
    {
      "subtitle_id": 194,
      "start": 453.96,
      "end": 458.0,
      "text": "का लैब टेस्टिंग का सर्टिफिकेट नहीं है"
    },
    {
      "subtitle_id": 195,
      "start": 455.96,
      "end": 459.72,
      "text": "इनका दावा यह है कि ग्रे हेयर को फिर से"
    },
    {
      "subtitle_id": 196,
      "start": 458.0,
      "end": 461.68,
      "text": "ब्लैक कर सकते हैं देखिए कई सारी"
    },
    {
      "subtitle_id": 197,
      "start": 459.72,
      "end": 463.84,
      "text": "साइंटिफिक स्टडी प्रूव कर चुकी है कि हेयर"
    },
    {
      "subtitle_id": 198,
      "start": 461.68,
      "end": 465.72,
      "text": "की जो ग्रोथ है वो सिर्फ ऑइल पर डिपेंड"
    },
    {
      "subtitle_id": 199,
      "start": 463.84,
      "end": 468.08,
      "text": "नहीं करती है और भी अलग-अलग फैक्टर्स होते"
    },
    {
      "subtitle_id": 200,
      "start": 465.72,
      "end": 470.159,
      "text": "हैं स्ट्रेस इसमें एक मेजर फैक्टर है डाइट"
    },
    {
      "subtitle_id": 201,
      "start": 468.08,
      "end": 472.24,
      "text": "एक मेजर फैक्टर है इसके अलावा जेनेटिक्स"
    },
    {
      "subtitle_id": 202,
      "start": 470.159,
      "end": 474.36,
      "text": "एक मेजर फैक्टर है यानी कि अगर आपके"
    },
    {
      "subtitle_id": 203,
      "start": 472.24,
      "end": 476.199,
      "text": "पिताजी और दादाजी टकले हैं तो आपके टकले"
    },
    {
      "subtitle_id": 204,
      "start": 474.36,
      "end": 477.879,
      "text": "होने के चांसेस भी यहां पर बन जाते हैं और"
    },
    {
      "subtitle_id": 205,
      "start": 476.199,
      "end": 479.68,
      "text": "कई स्टडीज ने ये प्रूव किया है कि इंडिया"
    },
    {
      "subtitle_id": 206,
      "start": 477.879,
      "end": 481.319,
      "text": "की जो ट्राइबल कम्युनिटी है उ उनके"
    },
    {
      "subtitle_id": 207,
      "start": 479.68,
      "end": 483.52,
      "text": "जेनेटिक्स की वजह से उनके जो हेयर है वो"
    },
    {
      "subtitle_id": 208,
      "start": 481.319,
      "end": 485.4,
      "text": "थिक और लंबे होते हैं अब आप मुंबई दिल्ली"
    },
    {
      "subtitle_id": 209,
      "start": 483.52,
      "end": 487.879,
      "text": "में रहकर आदिवासी हीरोइन लगाकर उम्मीद"
    },
    {
      "subtitle_id": 210,
      "start": 485.4,
      "end": 489.479,
      "text": "करते हो कि इन ऐड में दिखाए गए जो ट्राइबल"
    },
    {
      "subtitle_id": 211,
      "start": 487.879,
      "end": 491.759,
      "text": "से उनकी तरह मेरे बाल घने और लंबे हो"
    },
    {
      "subtitle_id": 212,
      "start": 489.479,
      "end": 494.199,
      "text": "जाएंगे तो आप गलत हो आप यह वीडियो देख"
    },
    {
      "subtitle_id": 213,
      "start": 491.759,
      "end": 496.52,
      "text": "लीजिए इस वीडियो में अनंत अंबानी का सर आप"
    },
    {
      "subtitle_id": 214,
      "start": 494.199,
      "end": 498.879,
      "text": "देखिए यह इंडिया के सबसे अमीर आदमी के"
    },
    {
      "subtitle_id": 215,
      "start": 496.52,
      "end": 501.44,
      "text": "बेटे हैं क्या यह ₹ का आदिवासी हेरल"
    },
    {
      "subtitle_id": 216,
      "start": 498.879,
      "end": 503.759,
      "text": "अफोर्ड नहीं कर सकते यह तो 2000 करोड़ की"
    },
    {
      "subtitle_id": 217,
      "start": 501.44,
      "end": 505.8,
      "text": "शादी अफोर्ड कर सकते हैं दिस इज नथिंग बट"
    },
    {
      "subtitle_id": 218,
      "start": 503.759,
      "end": 507.96,
      "text": "मॉडर्न डे स्नेक ऑयल जिसे अगर आज रोका"
    },
    {
      "subtitle_id": 219,
      "start": 505.8,
      "end": 510.8,
      "text": "नहीं गया तो ये और फैले और सिर्फ ऑयल तक"
    },
    {
      "subtitle_id": 220,
      "start": 507.96,
      "end": 512.64,
      "text": "सीमित नहीं रहेगा उसके बाद शैंपू साबुन सब"
    },
    {
      "subtitle_id": 221,
      "start": 510.8,
      "end": 514.279,
      "text": "में फैले और इस पूरे स्कैम का साइज आने"
    },
    {
      "subtitle_id": 222,
      "start": 512.64,
      "end": 516.479,
      "text": "वाले टाइम में शायद इतना होगा जितना आप"
    },
    {
      "subtitle_id": 223,
      "start": 514.279,
      "end": 518.519,
      "text": "सोच भी नहीं सकते फिलहाल तो गवर्नमेंट"
    },
    {
      "subtitle_id": 224,
      "start": 516.479,
      "end": 520.12,
      "text": "एजेंसीज के नाक के नीचे सब कुछ हो रहा है"
    },
    {
      "subtitle_id": 225,
      "start": 518.519,
      "end": 521.8,
      "text": "कोई कुछ एक्शन लेने के लिए तैयार नहीं है"
    },
    {
      "subtitle_id": 226,
      "start": 520.12,
      "end": 523.719,
      "text": "ना ही क्वालिटी के मामले में ना ही"
    },
    {
      "subtitle_id": 227,
      "start": 521.8,
      "end": 525.72,
      "text": "फाइनेंशियल चीजों के बारे में पर मैं आपसे"
    },
    {
      "subtitle_id": 228,
      "start": 523.719,
      "end": 527.68,
      "text": "यही गुजारिश करूंगा कि इन सारी चीजों से"
    },
    {
      "subtitle_id": 229,
      "start": 525.72,
      "end": 529.08,
      "text": "दूर रहे उन्हीं चीजों पर भरोसा करर जो"
    },
    {
      "subtitle_id": 230,
      "start": 527.68,
      "end": 531.04,
      "text": "लाइफ टेस्टेड है उनके प्रोडक्ट्स"
    },
    {
      "subtitle_id": 231,
      "start": 529.08,
      "end": 532.959,
      "text": "इंग्रेडिएंट्स सारी चीजों का थोड़ा स्टडी"
    },
    {
      "subtitle_id": 232,
      "start": 531.04,
      "end": 534.88,
      "text": "कीजिए क्योंकि कई सारे ऐसी चीजें लाइफ"
    },
    {
      "subtitle_id": 233,
      "start": 532.959,
      "end": 536.76,
      "text": "टेस्टेड नहीं होती है उनमें कुछ डेंजरस"
    },
    {
      "subtitle_id": 234,
      "start": 534.88,
      "end": 538.88,
      "text": "केमिकल्स भी यूज किए जाते हैं जो आपके लिए"
    },
    {
      "subtitle_id": 235,
      "start": 536.76,
      "end": 541.0,
      "text": "और ज्यादा प्रॉब्लम्स क्रिएट कर सकते हैं"
    },
    {
      "subtitle_id": 236,
      "start": 538.88,
      "end": 543.04,
      "text": "किसी भी इनफ्लुएंसर्स की बातों पर भरोसा"
    },
    {
      "subtitle_id": 237,
      "start": 541.0,
      "end": 545.2,
      "text": "ना करें इस वीडियो को ज्यादा से ज्यादा"
    },
    {
      "subtitle_id": 238,
      "start": 543.04,
      "end": 547.48,
      "text": "शेयर करें ताकि सब लोगों को इसकी रियलिटी"
    },
    {
      "subtitle_id": 239,
      "start": 545.2,
      "end": 549.64,
      "text": "पता चले कि इसके पीछे आखिर क्या कुछ चल"
    },
    {
      "subtitle_id": 240,
      "start": 547.48,
      "end": 551.24,
      "text": "रहा है और जाते-जाते हमारे एफएमवीए"
    },
    {
      "subtitle_id": 241,
      "start": 549.64,
      "end": 552.959,
      "text": "प्रोग्राम को भी जरूर चेक आउट कीजिए जिसकी"
    },
    {
      "subtitle_id": 242,
      "start": 551.24,
      "end": 554.959,
      "text": "लिंक आपको नीचे डिस्क्रिप्शन और कमेंट"
    },
    {
      "subtitle_id": 243,
      "start": 552.959,
      "end": 556.36,
      "text": "बॉक्स में मिल जाएगी यह एक बहुत बेहतरीन"
    },
    {
      "subtitle_id": 244,
      "start": 554.959,
      "end": 558.48,
      "text": "अपॉर्चुनिटी आप लोगों के लिए अगर आपको"
    },
    {
      "subtitle_id": 245,
      "start": 556.36,
      "end": 560.48,
      "text": "फाइनेंस में करियर करना है या फिर फाइनेंस"
    },
    {
      "subtitle_id": 246,
      "start": 558.48,
      "end": 562.2,
      "text": "की फील्ड में इन डेप्थ नॉलेज हासिल करना"
    },
    {
      "subtitle_id": 247,
      "start": 560.48,
      "end": 564.49,
      "text": "है मिलते हैं अगले वीडियो में थैंक यू सो"
    },
    {
      "subtitle_id": 248,
      "start": 562.2,
      "end": 567.679,
      "text": "मच फॉर वाचिंग दिस"
    },
    {
      "subtitle_id": 249,
      "start": 564.49,
      "end": 567.679,
      "text": "[संगीत]"
    }
  ]
}