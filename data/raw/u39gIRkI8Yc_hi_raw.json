  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.16,
      "end": 3.24,
      "text": "मैं पिछले कई सालों से"
    },
    {
      "subtitle_id": 2,
      "start": 7.2,
      "end": 11.28,
      "text": "youtube3 पारिक स्कैम पर वीडियो बनाया"
    },
    {
      "subtitle_id": 3,
      "start": 9.4,
      "end": 13.88,
      "text": "इनफैक्ट जो रिसेंट स्कैम्स हुए हैं उन पर"
    },
    {
      "subtitle_id": 4,
      "start": 11.28,
      "end": 15.639,
      "text": "भी डिटेल वीडियोस बनाए हैं ताकि ज्यादा से"
    },
    {
      "subtitle_id": 5,
      "start": 13.88,
      "end": 17.68,
      "text": "ज्यादा लोग स्कैम के बारे में अवेयर हो"
    },
    {
      "subtitle_id": 6,
      "start": 15.639,
      "end": 19.88,
      "text": "सके पर इस वीडियो को बनाने के लिए जब"
    },
    {
      "subtitle_id": 7,
      "start": 17.68,
      "end": 21.8,
      "text": "मैंने रिसर्च शुरू की तो कई सारी ऐसी"
    },
    {
      "subtitle_id": 8,
      "start": 19.88,
      "end": 23.92,
      "text": "शॉकिंग चीजें मुझे पता चली जिससे मैं पूरी"
    },
    {
      "subtitle_id": 9,
      "start": 21.8,
      "end": 26.16,
      "text": "तरह से हक्की पिक्की रह गया सॉरी हक्का"
    },
    {
      "subtitle_id": 10,
      "start": 23.92,
      "end": 28.92,
      "text": "बक्का रह गया और इस स्कैम का नाम है"
    },
    {
      "subtitle_id": 11,
      "start": 26.16,
      "end": 30.519,
      "text": "आदिवासी हेयर ऑयल स्कैम इस ऑयल को बेचने"
    },
    {
      "subtitle_id": 12,
      "start": 28.92,
      "end": 32.48,
      "text": "वाले जो लोग हैं वो यह दवा करते हैं कि"
    },
    {
      "subtitle_id": 13,
      "start": 30.519,
      "end": 35.28,
      "text": "अगर आप इस ऑयल को सर पर लगाते हो तो आप"
    },
    {
      "subtitle_id": 14,
      "start": 32.48,
      "end": 37.52,
      "text": "रातों-रात अनुपम खेर से सीधा अनिल कपूर बन"
    },
    {
      "subtitle_id": 15,
      "start": 35.28,
      "end": 40.079,
      "text": "जाओगे और इस कैम में छोटे से छोटा और बड़े"
    },
    {
      "subtitle_id": 16,
      "start": 37.52,
      "end": 42.399,
      "text": "से बड़ा ट भी शामिल है और मुझे यह कहने"
    },
    {
      "subtitle_id": 17,
      "start": 40.079,
      "end": 45.16,
      "text": "में कोई झिझक नहीं है कि यह करंट टाइम में"
    },
    {
      "subtitle_id": 18,
      "start": 42.399,
      "end": 47.32,
      "text": "इंटरनेट पर छाने वाला सबसे बड़ा स्कैम है"
    },
    {
      "subtitle_id": 19,
      "start": 45.16,
      "end": 49.52,
      "text": "जो गवर्नमेंट की सारी एजेंसीज के नाक के"
    },
    {
      "subtitle_id": 20,
      "start": 47.32,
      "end": 51.44,
      "text": "नीचे से हो रहा है और अब तक इन पर कोई भी"
    },
    {
      "subtitle_id": 21,
      "start": 49.52,
      "end": 53.64,
      "text": "कार्रवाई नहीं हुई क्योंकि इनके जो"
    },
    {
      "subtitle_id": 22,
      "start": 51.44,
      "end": 55.64,
      "text": "कनेक्शंस की जड़े हैं वो बहुत ही गहरी और"
    },
    {
      "subtitle_id": 23,
      "start": 53.64,
      "end": 57.48,
      "text": "मजबूत है देखिए इस कैम पर मैं बहुत पहले"
    },
    {
      "subtitle_id": 24,
      "start": 55.64,
      "end": 60.359,
      "text": "ही वीडियो बनाना चाहता था लेकिन मुझे लगा"
    },
    {
      "subtitle_id": 25,
      "start": 57.48,
      "end": 62.48,
      "text": "कि शायद यह फैट है टेंपररी है कु उस टाइम"
    },
    {
      "subtitle_id": 26,
      "start": 60.359,
      "end": 64.72,
      "text": "में चला जाएगा लेकिन अब मुझे एहसास हो गया"
    },
    {
      "subtitle_id": 27,
      "start": 62.48,
      "end": 66.799,
      "text": "कि यह कोई छोटा मोटा स्कैम नहीं है आने"
    },
    {
      "subtitle_id": 28,
      "start": 64.72,
      "end": 69.04,
      "text": "वाले टाइम में यह बहुत ज्यादा बड़ा बन"
    },
    {
      "subtitle_id": 29,
      "start": 66.799,
      "end": 72.28,
      "text": "जाएगा और फिर यह सिर्फ हेयर ऑयल नहीं"
    },
    {
      "subtitle_id": 30,
      "start": 69.04,
      "end": 75.0,
      "text": "शैंपू टूथपेस्ट साबुन इन सब तक पहुंच"
    },
    {
      "subtitle_id": 31,
      "start": 72.28,
      "end": 77.04,
      "text": "जाएगा और फिर इसे रोकना एक गंजे के सर पर"
    },
    {
      "subtitle_id": 32,
      "start": 75.0,
      "end": 78.52,
      "text": "बाल लाने जितना डिफिकल्ट हो जाएगा बहुत"
    },
    {
      "subtitle_id": 33,
      "start": 77.04,
      "end": 80.52,
      "text": "सारे लोगों तो यह लगता है कि यह बस एक"
    },
    {
      "subtitle_id": 34,
      "start": 78.52,
      "end": 83.2,
      "text": "अनइथिकल मार्केटिंग करके किया जाने वाला"
    },
    {
      "subtitle_id": 35,
      "start": 80.52,
      "end": 85.32,
      "text": "स्कैम है लेकिन यह पूरी सच्चाई नहीं है यह"
    },
    {
      "subtitle_id": 36,
      "start": 83.2,
      "end": 88.88,
      "text": "अनइथिकल मार्केटिंग से भी ज्यादा एक बहुत"
    },
    {
      "subtitle_id": 37,
      "start": 85.32,
      "end": 90.64,
      "text": "बड़ा फाइनेंशियल फ्रॉड है लेकिन कैसे बात"
    },
    {
      "subtitle_id": 38,
      "start": 88.88,
      "end": 93.079,
      "text": "करेंगे आज के इस वीडियो वीडियो में बहुत"
    },
    {
      "subtitle_id": 39,
      "start": 90.64,
      "end": 94.479,
      "text": "डिटेल में और गहराई में जाकर बहुत स्पेशल"
    },
    {
      "subtitle_id": 40,
      "start": 93.079,
      "end": 96.88,
      "text": "रिसर्च हमने इस वीडियो में की है बहुत"
    },
    {
      "subtitle_id": 41,
      "start": 94.479,
      "end": 98.72,
      "text": "सारे दिन भी लगे रिसर्च करने में लेकिन जो"
    },
    {
      "subtitle_id": 42,
      "start": 96.88,
      "end": 100.759,
      "text": "आउटपुट आज आपको मिलेगा जो डाटा आपको"
    },
    {
      "subtitle_id": 43,
      "start": 98.72,
      "end": 103.079,
      "text": "मिलेगा जिसके साथ हम ये प्रूव करेंगे बहुत"
    },
    {
      "subtitle_id": 44,
      "start": 100.759,
      "end": 104.88,
      "text": "शॉकिंग होने वाला है नमस्कार मैं प्रसाद"
    },
    {
      "subtitle_id": 45,
      "start": 103.079,
      "end": 106.399,
      "text": "आपका आज के इस वीडियो में स्वागत करता हूं"
    },
    {
      "subtitle_id": 46,
      "start": 104.88,
      "end": 108.119,
      "text": "वीडियो में आगे बढ़ने से पहले आपको बता"
    },
    {
      "subtitle_id": 47,
      "start": 106.399,
      "end": 109.88,
      "text": "दूं कि हमारी एफएमवीए यानी फाइनेंशियल"
    },
    {
      "subtitle_id": 48,
      "start": 108.119,
      "end": 111.6,
      "text": "मॉडलिंग एंड वैल्युएशन मेंटरशिप की बैच"
    },
    {
      "subtitle_id": 49,
      "start": 109.88,
      "end": 113.24,
      "text": "अभी अक्टूबर में शुरू हो रही है अगर आपको"
    },
    {
      "subtitle_id": 50,
      "start": 111.6,
      "end": 115.079,
      "text": "फाइनेंस में बहुत डिटेल में जाकर ये चेक"
    },
    {
      "subtitle_id": 51,
      "start": 113.24,
      "end": 117.2,
      "text": "करना है कि कंपनी के फाइनेंशियल्स आगे"
    },
    {
      "subtitle_id": 52,
      "start": 115.079,
      "end": 118.92,
      "text": "चलकर कैसे परफॉर्म करेंगे आने वाले टाइम"
    },
    {
      "subtitle_id": 53,
      "start": 117.2,
      "end": 121.0,
      "text": "में कंपनी की ग्रोथ किस तरह से होगी उसकी"
    },
    {
      "subtitle_id": 54,
      "start": 118.92,
      "end": 122.96,
      "text": "फाइनेंशियल मॉडलिंग फिर कैसे करनी है और"
    },
    {
      "subtitle_id": 55,
      "start": 121.0,
      "end": 124.6,
      "text": "उसके बेसिस पर उसका डीसीएफ मेथड से यानी"
    },
    {
      "subtitle_id": 56,
      "start": 122.96,
      "end": 126.56,
      "text": "डिस्काउंटेड कैशफ्लो मेथड से वैल्युएशन"
    },
    {
      "subtitle_id": 57,
      "start": 124.6,
      "end": 128.16,
      "text": "निकाल के कैसे पता करें कि कंपनी अंडर"
    },
    {
      "subtitle_id": 58,
      "start": 126.56,
      "end": 129.84,
      "text": "वैल्यूड है या फिर ओवर वैल्यूड तो ये सारी"
    },
    {
      "subtitle_id": 59,
      "start": 128.16,
      "end": 131.76,
      "text": "चीजें सीखने की अपॉर्चुनिटी अभी आपके पास"
    },
    {
      "subtitle_id": 60,
      "start": 129.84,
      "end": 133.64,
      "text": "है न महीने की ये वीकेंड बैच चलती है"
    },
    {
      "subtitle_id": 61,
      "start": 131.76,
      "end": 135.08,
      "text": "जिसके बाद आखिरी चंद सीटें बची है तो अभी"
    },
    {
      "subtitle_id": 62,
      "start": 133.64,
      "end": 137.879,
      "text": "नीचे डिस्क्रिप्शन और कमेंट बॉक्स में दी"
    },
    {
      "subtitle_id": 63,
      "start": 135.08,
      "end": 137.879,
      "text": "गई लिंक पर क्लिक करके"
    },
    {
      "subtitle_id": 64,
      "start": 149.92,
      "end": 153.56,
      "text": "के बारे में और दूसरे पार्ट में बात"
    },
    {
      "subtitle_id": 65,
      "start": 151.4,
      "end": 156.239,
      "text": "करेंगे इनकी अनइथिकल मार्केटिंग टैक्टिक्स"
    },
    {
      "subtitle_id": 66,
      "start": 153.56,
      "end": 158.04,
      "text": "के बारे में देखिए अगर आपको हमारी कंट्री"
    },
    {
      "subtitle_id": 67,
      "start": 156.239,
      "end": 160.36,
      "text": "में हेयर ऑयल या फिर कोई प्रोडक्ट बेचना"
    },
    {
      "subtitle_id": 68,
      "start": 158.04,
      "end": 162.48,
      "text": "है तो ढेरों सारे रूल्स और रेगुलेशंस आपको"
    },
    {
      "subtitle_id": 69,
      "start": 160.36,
      "end": 164.44,
      "text": "फॉलो करने हैं कई सारे लाइसेंसेस आपको"
    },
    {
      "subtitle_id": 70,
      "start": 162.48,
      "end": 166.2,
      "text": "लेने पड़ेंगे पर यह हुआ नॉर्मल लोगों के"
    },
    {
      "subtitle_id": 71,
      "start": 164.44,
      "end": 168.599,
      "text": "लिए नॉर्मल बिजनेसमैन के लिए लेकिन"
    },
    {
      "subtitle_id": 72,
      "start": 166.2,
      "end": 170.84,
      "text": "आदिवासी हेयर ऑयल वाले मेंटोस जिंदगी जी"
    },
    {
      "subtitle_id": 73,
      "start": 168.599,
      "end": 172.519,
      "text": "रहे हैं इनका इट फाइव स्टार और डू नथिंग"
    },
    {
      "subtitle_id": 74,
      "start": 170.84,
      "end": 174.599,
      "text": "वाला फार्मूला है क्योंकि आदिवासी हेयर"
    },
    {
      "subtitle_id": 75,
      "start": 172.519,
      "end": 176.48,
      "text": "ऑयल को इन रूल्स और रेगुलेशन से कोई लेना"
    },
    {
      "subtitle_id": 76,
      "start": 174.599,
      "end": 178.2,
      "text": "देना नहीं है जैसे मान लो आपको एक हेयर"
    },
    {
      "subtitle_id": 77,
      "start": 176.48,
      "end": 180.4,
      "text": "ऑयल बनाकर बेचना है तो आपको क्या-क्या"
    },
    {
      "subtitle_id": 78,
      "start": 178.2,
      "end": 182.519,
      "text": "करना पड़ेगा सबसे पहले ले आपको अपना"
    },
    {
      "subtitle_id": 79,
      "start": 180.4,
      "end": 184.72,
      "text": "बिजनेस रजिस्टर करना होगा उसके लिए आपको"
    },
    {
      "subtitle_id": 80,
      "start": 182.519,
      "end": 186.76,
      "text": "ढेरों सारे डॉक्यूमेंट लगेंगे उसके लिए"
    },
    {
      "subtitle_id": 81,
      "start": 184.72,
      "end": 189.28,
      "text": "आपको कंपनी के नाम का अप्रूवल लेना पड़ेगा"
    },
    {
      "subtitle_id": 82,
      "start": 186.76,
      "end": 191.12,
      "text": "आपको डायरेक्टर आइडेंटिफिकेशन नंबर डिजिटल"
    },
    {
      "subtitle_id": 83,
      "start": 189.28,
      "end": 193.48,
      "text": "सिग्नेचर सर्टिफिकेट ये सारी चीजें लेनी"
    },
    {
      "subtitle_id": 84,
      "start": 191.12,
      "end": 195.239,
      "text": "होगी कंपनी इनकॉरपोरेशन एप्लीकेशन सबमिट"
    },
    {
      "subtitle_id": 85,
      "start": 193.48,
      "end": 197.599,
      "text": "करना पड़ेगा डायरेक्टर्स के डिटेल्स लगते"
    },
    {
      "subtitle_id": 86,
      "start": 195.239,
      "end": 200.08,
      "text": "हैं पैन कार्ड आधार कार्ड आईटीआर सब लगता"
    },
    {
      "subtitle_id": 87,
      "start": 197.599,
      "end": 202.0,
      "text": "है कंपनी का पैन कार्ड बनाना पड़ेगा एनओसी"
    },
    {
      "subtitle_id": 88,
      "start": 200.08,
      "end": 204.239,
      "text": "लगती है स्क्रीन पर आप देख सकते हो ये"
    },
    {
      "subtitle_id": 89,
      "start": 202.0,
      "end": 206.44,
      "text": "ढेरों सारी चीजें आपको लगती है पर यह तो"
    },
    {
      "subtitle_id": 90,
      "start": 204.239,
      "end": 207.76,
      "text": "सिर्फ पहला स्टेप है इसके अलावा अगर आप"
    },
    {
      "subtitle_id": 91,
      "start": 206.44,
      "end": 209.92,
      "text": "मैन्युफैक्चरिंग कर रहे हो तो आपको"
    },
    {
      "subtitle_id": 92,
      "start": 207.76,
      "end": 211.72,
      "text": "मैन्युफैक्चरिंग से रिलेटेड लाइसेंसेस ले"
    },
    {
      "subtitle_id": 93,
      "start": 209.92,
      "end": 214.04,
      "text": "होंगे अगर हेयर ऑयल की बात करें तो इसमें"
    },
    {
      "subtitle_id": 94,
      "start": 211.72,
      "end": 215.959,
