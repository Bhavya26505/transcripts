  "parsing_issues": [],
  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.12,
      "end": 4.44,
      "text": "यह एक सरकारी कंपनी है जिसके फाइनेंशियल्स"
    },
    {
      "subtitle_id": 2,
      "start": 2.52,
      "end": 6.48,
      "text": "आपके सामने हैं सरकार इससे इतना परेशान"
    },
    {
      "subtitle_id": 3,
      "start": 4.44,
      "end": 8.679,
      "text": "हुई है कि सरकार ने डिसीजन ले लिया है कि"
    },
    {
      "subtitle_id": 4,
      "start": 6.48,
      "end": 10.639,
      "text": "हमें इस कंपनी को बंद करना है कारण क्या"
    },
    {
      "subtitle_id": 5,
      "start": 8.679,
      "end": 13.48,
      "text": "है तो कारण आप यहां पर देख सकते हैं कंपनी"
    },
    {
      "subtitle_id": 6,
      "start": 10.639,
      "end": 15.28,
      "text": "की सेल्स ग्रोथ सीधा नेगेटिव में है कंपनी"
    },
    {
      "subtitle_id": 7,
      "start": 13.48,
      "end": 17.4,
      "text": "की प्रॉफिट ग्रोथ अगर देखें तो वो कभी"
    },
    {
      "subtitle_id": 8,
      "start": 15.28,
      "end": 18.92,
      "text": "खुशी कभी कम वाली है लेकिन कंपनी की शेयर"
    },
    {
      "subtitle_id": 9,
      "start": 17.4,
      "end": 21.039,
      "text": "प्राइस देखी जाए तो पिछले पांच सालों में"
    },
    {
      "subtitle_id": 10,
      "start": 18.92,
      "end": 23.599,
      "text": "कंपाउंडेड सालाना 40 पर के रिटर्न और"
    },
    {
      "subtitle_id": 11,
      "start": 21.039,
      "end": 25.92,
      "text": "पिछले एक साल में 169 पर के रिटर्न स्टॉक"
    },
    {
      "subtitle_id": 12,
      "start": 23.599,
      "end": 28.279,
      "text": "ने दिए हैं ये वही सरकारी कंपनी है जिसे"
    },
    {
      "subtitle_id": 13,
      "start": 25.92,
      "end": 30.279,
      "text": "सरकार बंद करने जा रही है यह कुछ हालत है"
    },
    {
      "subtitle_id": 14,
      "start": 28.279,
      "end": 32.079,
      "text": "फिलहाल भारत के पीएसयू सेक्टर की यानी"
    },
    {
      "subtitle_id": 15,
      "start": 30.279,
      "end": 33.32,
      "text": "सरकारी कंपनियों की तो मुझे सिंपली यही"
    },
    {
      "subtitle_id": 16,
      "start": 32.079,
      "end": 35.2,
      "text": "लगता है कि काफी सारे लोगों ने हमारे"
    },
    {
      "subtitle_id": 17,
      "start": 33.32,
      "end": 37.6,
      "text": "प्राइम मिनिस्टर का जो डायलॉग है इसे काफी"
    },
    {
      "subtitle_id": 18,
      "start": 35.2,
      "end": 40.32,
      "text": "सीरियसली लिया है जो सरकारी कंपनियों के"
    },
    {
      "subtitle_id": 19,
      "start": 37.6,
      "end": 42.6,
      "text": "लोग गाली देना आप उसमें दांव लगा दीजिए"
    },
    {
      "subtitle_id": 20,
      "start": 40.32,
      "end": 44.68,
      "text": "साहब अच्छा ही होने वाला है और आज हम बात"
    },
    {
      "subtitle_id": 21,
      "start": 42.6,
      "end": 46.52,
      "text": "करने वाले हैं पीएसओ सेक्टर के वैल्यूएशन"
    },
    {
      "subtitle_id": 22,
      "start": 44.68,
      "end": 49.079,
      "text": "के बारे में कि क्या पीएसओ सेक्टर में अभी"
    },
    {
      "subtitle_id": 23,
      "start": 46.52,
      "end": 51.44,
      "text": "भी अपॉर्चुनिटी है उसे हम पता करेंगे साथ"
    },
    {
      "subtitle_id": 24,
      "start": 49.079,
      "end": 53.719,
      "text": "ही क्या पीएसओ सेक्टर ओवर वैल्यूड है है"
    },
    {
      "subtitle_id": 25,
      "start": 51.44,
      "end": 55.84,
      "text": "तो क्यों लॉजिक के साथ और रीजनिंग के साथ"
    },
    {
      "subtitle_id": 26,
      "start": 53.719,
      "end": 57.48,
      "text": "आज हम बात करेंगे यहां पर हम इतने डिटेल"
    },
    {
      "subtitle_id": 27,
      "start": 55.84,
      "end": 59.199,
      "text": "में बात करने वाले हैं कि अगर आप पीएस"
    },
    {
      "subtitle_id": 28,
      "start": 57.48,
      "end": 61.359,
      "text": "सेक्टर में इन्वेस्टेड है या फिर इन्वेस्ट"
    },
    {
      "subtitle_id": 29,
      "start": 59.199,
      "end": 63.68,
      "text": "करने की प्लानिंग कर रहे हैं तो यह वीडियो"
    },
    {
      "subtitle_id": 30,
      "start": 61.359,
      "end": 65.68,
      "text": "आपके लिए बहुत इंपॉर्टेंट होने वाला है"
    },
    {
      "subtitle_id": 31,
      "start": 63.68,
      "end": 68.04,
      "text": "नमस्कार मैं प्रसाद आपका आज के इस वीडियो"
    },
    {
      "subtitle_id": 32,
      "start": 65.68,
      "end": 70.68,
      "text": "में स्वागत करता हूं इंडिया में 607"
    },
    {
      "subtitle_id": 33,
      "start": 68.04,
      "end": 72.759,
      "text": "पीएसयू यानी सरकारी कंपनीज हैं जिनमें से"
    },
    {
      "subtitle_id": 34,
      "start": 70.68,
      "end": 74.32,
      "text": "181 कंपनीज ऐसी है जो सरकार को बहुत"
    },
    {
      "subtitle_id": 35,
      "start": 72.759,
      "end": 76.08,
      "text": "ज्यादा लॉसेस दे रही है जिसकी वजह से"
    },
    {
      "subtitle_id": 36,
      "start": 74.32,
      "end": 78.72,
      "text": "सरकार प्लान कर रही कि अब इन्हें बंद करते"
    },
    {
      "subtitle_id": 37,
      "start": 76.08,
      "end": 80.6,
      "text": "हैं जिसमें से एक एमएमटीसी है जिसके अलावा"
    },
    {
      "subtitle_id": 38,
      "start": 78.72,
      "end": 82.799,
      "text": "एसटीसी यानी स्टेट ट्रेडिंग कॉर्पोरेशन"
    },
    {
      "subtitle_id": 39,
      "start": 80.6,
      "end": 84.6,
      "text": "अगेन लिस्टेड कंपनी है उसे भी सरकार बंद"
    },
    {
      "subtitle_id": 40,
      "start": 82.799,
      "end": 86.56,
      "text": "करने की प्लानिंग कर रही है और इसके अलावा"
    },
    {
      "subtitle_id": 41,
      "start": 84.6,
      "end": 88.4,
      "text": "21 कंपनीज को गवर्नमेंट ने क्लोजिंग के"
    },
    {
      "subtitle_id": 42,
      "start": 86.56,
      "end": 90.56,
      "text": "लिए अप्रूव किया है यानी इन दोनों के"
    },
    {
      "subtitle_id": 43,
      "start": 88.4,
      "end": 92.6,
      "text": "अलावा 19 और कंपनीज हैं जिन्हें सरकार बंद"
    },
    {
      "subtitle_id": 44,
      "start": 90.56,
      "end": 94.759,
      "text": "करने की प्लानिंग कर रही है लेकिन बिना इन"
    },
    {
      "subtitle_id": 45,
      "start": 92.6,
      "end": 96.759,
      "text": "चीजों को समझे कई सारे लोग इन स्टॉक्स में"
    },
    {
      "subtitle_id": 46,
      "start": 94.759,
      "end": 98.6,
      "text": "ब्लाइंड इन्वेस्ट कर रहे हैं यहां पर मैं"
    },
    {
      "subtitle_id": 47,
      "start": 96.759,
      "end": 100.119,
      "text": "कंपनी का एक बेसिक फाइनेंशियल आपको दिखाता"
    },
    {
      "subtitle_id": 48,
      "start": 98.6,
      "end": 102.72,
      "text": "हूं तो आप देख सकते हो कि कंपनी का"
    },
    {
      "subtitle_id": 49,
      "start": 100.119,
      "end": 105.56,
      "text": "रेवेन्यू लगभग नहीं के बराबर हो गया है"
    },
    {
      "subtitle_id": 50,
      "start": 102.72,
      "end": 107.719,
      "text": "जहां पर 3500 करोड़ का रेवेन्यू था 2023"
    },
    {
      "subtitle_id": 51,
      "start": 105.56,
      "end": 109.92,
      "text": "में वो रेवेन्यू कंपनी का मात्र 5 करोड़"
    },
    {
      "subtitle_id": 52,
      "start": 107.719,
      "end": 112.24,
      "text": "पर आ गया है यानी कि 99 पर से भी रेवेन्यू"
    },
    {
      "subtitle_id": 53,
      "start": 109.92,
      "end": 113.92,
      "text": "कंपनी का कम हो गया है यहां पर अदर इनकम"
    },
    {
      "subtitle_id": 54,
      "start": 112.24,
      "end": 115.88,
      "text": "और एक्सेप्शनल आइटम के चलते कंपनी ने"
    },
    {
      "subtitle_id": 55,
      "start": 113.92,
      "end": 117.92,
      "text": "थोड़ा बहुत प्रॉफिट तो दिखा दिया है लेकिन"
    },
    {
      "subtitle_id": 56,
      "start": 115.88,
      "end": 120.119,
      "text": "एक चीज तो कंफर्म है कि सरकार इसे बंद"
    },
    {
      "subtitle_id": 57,
      "start": 117.92,
      "end": 122.119,
      "text": "करने जा रही है लेकिन यह चीज कई स आम"
    },
    {
      "subtitle_id": 58,
      "start": 120.119,
      "end": 123.759,
      "text": "इन्वेस्टर्स को समझ में नहीं आ रही है समझ"
    },
    {
      "subtitle_id": 59,
      "start": 122.119,
      "end": 126.119,
      "text": "में इसलिए नहीं आ रही है क्योंकि इसके"
    },
    {
      "subtitle_id": 60,
      "start": 123.759,
      "end": 127.88,
      "text": "पीछे दो मेन रीजंस है पहला सबसे बड़ा रीजन"
    },
    {
      "subtitle_id": 61,
      "start": 126.119,
      "end": 129.879,
      "text": "है कि पिछले ढ़ दो सालों में कई सारे"
    },
    {
      "subtitle_id": 62,
      "start": 127.88,
      "end": 132.36,
      "text": "सरकारी स्टॉक्स बहुत तेजी से बढ़ रहे हैं"
    },
    {
      "subtitle_id": 63,
      "start": 129.879,
      "end": 135.2,
      "text": "जैसे कि कोचिंग शिपर लगभग 800 पर से बढा"
    },
    {
      "subtitle_id": 64,
      "start": 132.36,
      "end": 137.239,
      "text": "है आईआरएफसी लगभग 600 पर से बढ़ा है रेल"
    },
    {
      "subtitle_id": 65,
      "start": 135.2,
      "end": 140.0,
      "text": "विकास निगम लिमिटेड पिछले 2 साल में लगभग"
    },
    {
      "subtitle_id": 66,
      "start": 137.239,
      "end": 141.599,
      "text": "2000 पर से बढ़ा है अब इन अचानक बढ़े हुई"
    },
    {
      "subtitle_id": 67,
      "start": 140.0,
      "end": 143.599,
      "text": "शेयर प्राइसेस के चलते लोगों को समझ में"
    },
    {
      "subtitle_id": 68,
      "start": 141.599,
      "end": 145.92,
      "text": "आया कि हमें अगर जल्दी अमीर बनना है गेट"
    },
    {
      "subtitle_id": 69,
      "start": 143.599,
      "end": 148.44,
      "text": "रिच क्विक होना है तो हमें पीएसयू स्टॉक्स"
    },
    {
      "subtitle_id": 70,
      "start": 145.92,
      "end": 150.239,
      "text": "में आना पड़ेगा अब पीएसयू स्टॉक्स फिर कौन"
    },
    {
      "subtitle_id": 71,
      "start": 148.44,
      "end": 152.16,
      "text": "सा भी हो सकता है क्योंकि हर कोई बढ़ रहा"
    },
    {
      "subtitle_id": 72,
      "start": 150.239,
      "end": 154.56,
      "text": "तो लोगों ने किसी भी इस पीएस स्टॉक पर दाव"
    },
    {
      "subtitle_id": 73,
      "start": 152.16,
      "end": 156.519,
      "text": "लगाना शुरू कर दिया अब इसका रिजल्ट क्या"
    },
    {
      "subtitle_id": 74,
      "start": 154.56,
      "end": 159.159,
      "text": "हुआ तो ऐसे कई सारी कंपनीज में दिखाता हूं"
    },
    {
      "subtitle_id": 75,
      "start": 156.519,
      "end": 160.959,
      "text": "जिसमें से कि हिंदुस्तान कॉपर जिसकी अगर"
    },
    {
      "subtitle_id": 76,
      "start": 159.159,
      "end": 163.68,
      "text": "रेवेन्यू ग्रोथ देखें तो पिछले 10 साल में"
    },
    {
      "subtitle_id": 77,
      "start": 160.959,
      "end": 165.28,
      "text": "1 पर की है प्रॉफिट ग्रोथ भी 1 पर की है"
    },
    {
      "subtitle_id": 78,
      "start": 163.68,
      "end": 167.44,
      "text": "शॉर्ट टर्म ग्रोथ भी देखें तो वो भी कुछ"
    },
    {
      "subtitle_id": 79,
      "start": 165.28,
      "end": 170.04,
      "text": "खास नहीं है लेकिन अगर शेयर प्राइस ग्रोथ"
    },
    {
      "subtitle_id": 80,
      "start": 167.44,
      "end": 171.519,
      "text": "देखें तो वो बहुत क्रेजी पिछले एक साल में"
    },
    {
      "subtitle_id": 81,
      "start": 170.04,
      "end": 173.36,
      "text": "ही स्टॉक डबल हुआ है जबकि बिजनेस"
    },
    {
      "subtitle_id": 82,
      "start": 171.519,
      "end": 175.76,
      "text": "परफॉर्मेंस में कुछ भी खास बढ़ोतरी नहीं"
    },
    {
      "subtitle_id": 83,
      "start": 173.36,
      "end": 177.599,
      "text": "है और यह कोई एक एग्जांपल नहीं है कई सारी"
    },
    {
      "subtitle_id": 84,
      "start": 175.76,
      "end": 178.959,
      "text": "लॉस मेकिंग कंपनीज भी इसमें है जो प्रॉफिट"
    },
    {
      "subtitle_id": 85,
      "start": 177.599,
      "end": 181.159,
      "text": "भी नहीं कमा पा रही है जैसे आईटीआई"
    },
    {
      "subtitle_id": 86,
      "start": 178.959,
      "end": 183.48,
      "text": "लिमिटेड ये एक सरकारी कंपनी है जो लगातार"
    },
    {
      "subtitle_id": 87,
      "start": 181.159,
      "end": 185.239,
      "text": "लॉसेस में चल रही है लेकिन इस कंपनी के"
    },
    {
      "subtitle_id": 88,
      "start": 183.48,
      "end": 187.48,
      "text": "शेयर प्राइस पिछले 1 साल में 150 पर से"
    },
    {
      "subtitle_id": 89,
      "start": 185.239,
      "end": 189.08,
      "text": "बढ़ी है तो एक चीज सबको समझ में आ गई कि"
    },
    {
      "subtitle_id": 90,
      "start": 187.48,
      "end": 191.319,
      "text": "गेट रिच क् का सबसे बड़ा शॉर्टकट है"
    },
    {
      "subtitle_id": 91,
      "start": 189.08,
      "end": 193.2,
      "text": "पीएसयू अब अगर आप इन सारी चीजों से बचने"
    },
    {
      "subtitle_id": 92,
      "start": 191.319,
      "end": 195.12,
      "text": "के लिए कंपनी के फंडामेंटल्स और कंपनी के"
    },
    {
      "subtitle_id": 93,
      "start": 193.2,
      "end": 197.4,
      "text": "वैल्युएशन को अच्छे से समझना चाहते हो"
    },
    {
      "subtitle_id": 94,
      "start": 195.12,
      "end": 199.799,
      "text": "सीखना चाहते हो तो मेरे पास आपके लिए एक"
    },
    {
      "subtitle_id": 95,
      "start": 197.4,
      "end": 201.64,
      "text": "बहुत बेहतरीन ऑफर है हर इंडिपेंडेंस डे हम"
    },
    {
      "subtitle_id": 96,
      "start": 199.799,
      "end": 203.799,
      "text": "फंडामेंटल एनालिसिस का कोर्स लॉन्च करते"
    },
    {
      "subtitle_id": 97,
      "start": 201.64,
      "end": 205.159,
      "text": "हैं बहुत ही स्पेशल प्राइस पर इस कोर्स"
    },
    {
      "subtitle_id": 98,
      "start": 203.799,
      "end": 207.12,
      "text": "में हम सिखाते कि कैसे कंपनी के"
    },
    {
      "subtitle_id": 99,
      "start": 205.159,
      "end": 208.68,
      "text": "फंडामेंटल्स देखने हैं उसका फॉरेंसिक"
    },
    {
      "subtitle_id": 100,
      "start": 207.12,
      "end": 210.72,
      "text": "एनालिसिस करना है उसके बाद कंपनी का"
    },
    {
      "subtitle_id": 101,
      "start": 208.68,
      "end": 212.36,
      "text": "वैल्युएशन निकाल के ये पता करना है कि"
    },
    {
      "subtitle_id": 102,
      "start": 210.72,
      "end": 214.4,
      "text": "शेयर्स अंडर वैल्यूड है या फिर ओवर"
    },
    {
      "subtitle_id": 103,
      "start": 212.36,
      "end": 216.319,
      "text": "वैल्यूड इस पूरे कोर्स के बाद बड़े आसानी"
    },
    {
      "subtitle_id": 104,
      "start": 214.4,
      "end": 218.56,
      "text": "से आप ये सारी चीजें चुटकी में कर पाएंगे"
    },
    {
      "subtitle_id": 105,
      "start": 216.319,
      "end": 220.239,
      "text": "अगर आप बिगनर हैं तो भी तो अगर आपको स्टॉक"
    },
    {
      "subtitle_id": 106,
      "start": 218.56,
      "end": 222.159,
      "text": "सिलेक्शन की पूरी प्रोसेस स्टार्ट टू एंड"
    },
    {
      "subtitle_id": 107,
      "start": 220.239,
      "end": 224.159,
      "text": "समझनी है तो आप इस कोर्स में एनरोल कर"
    },
    {
      "subtitle_id": 108,
      "start": 222.159,
      "end": 226.72,
      "text": "सकते हैं जहां पर इस इंडिपेंडेंस डे हमारी"
    },
    {
      "subtitle_id": 109,
      "start": 224.159,
      "end": 230.239,
      "text": "फ्रीडम सेल ऑफर में आपको ये 7000 का कोर्स"
    },
    {
      "subtitle_id": 110,
      "start": 226.72,
      "end": 233.12,
      "text": "मिलेगा मात्र ₹1 में विथ नॉट वन ईयर टू"
    },
    {
      "subtitle_id": 111,
      "start": 230.239,
      "end": 235.079,
      "text": "ईयर सीधे लाइफ टाइम वैलिडिटी के साथ अब ये"
    },
    {
      "subtitle_id": 112,
      "start": 233.12,
      "end": 236.72,
      "text": "जो प्राइस है ये प्रीलॉन्च ऑफर प्राइस है"
    },
    {
      "subtitle_id": 113,
      "start": 235.079,
      "end": 238.319,
      "text": "इस प्राइस में आपको ये कोर्स बाद में कभी"
    },
    {
      "subtitle_id": 114,
      "start": 236.72,
      "end": 239.76,
      "text": "नहीं मिलेगा सो डोंट मिस आउट ऑन दिस"
    },
    {
      "subtitle_id": 115,
      "start": 238.319,
      "end": 241.959,
      "text": "अपॉर्चुनिटी अगर आपको कंपनी के"
    },
    {
      "subtitle_id": 116,
      "start": 239.76,
      "end": 243.599,
      "text": "फंडामेंटल्स बहुत डिटेल में समझने है तो"
    },
    {
      "subtitle_id": 117,
      "start": 241.959,
      "end": 246.079,
      "text": "लेकिन अब ये समझना भी जरूरी है कि क्या"
    },
    {
      "subtitle_id": 118,
      "start": 243.599,
      "end": 247.84,
      "text": "सारे पीएसएस ओवर वैल्यूड है तो उस पर आते"
    },
    {
      "subtitle_id": 119,
      "start": 246.079,
      "end": 249.439,
      "text": "हैं देखिए होता क्या है वैल्युएशन को"
    },
    {
      "subtitle_id": 120,
      "start": 247.84,
      "end": 251.799,
      "text": "समझने के लिए आपको समझना पड़ेगा कि"
    },
    {
      "subtitle_id": 121,
      "start": 249.439,
      "end": 254.12,
      "text": "वैल्युएशन की साइकल्स होती है साइकल किस"
    },
    {
      "subtitle_id": 122,
      "start": 251.799,
      "end": 255.76,
      "text": "तरह की तो कई सारे स्टॉक्स जो फंडामेंटली"
    },
    {
      "subtitle_id": 123,
      "start": 254.12,
      "end": 257.519,
      "text": "स्ट्रांग होते हैं फिर भी कई बार वो अंडर"
    },
    {
      "subtitle_id": 124,
      "start": 255.76,
      "end": 259.199,
      "text": "वैल्यूड रहते हैं और फिर कई बार होता है"
    },
    {
      "subtitle_id": 125,
      "start": 257.519,
      "end": 261.799,
      "text": "कि एक बार वो ओवर वैल्यूड बन गए तो कई"
    },
    {
      "subtitle_id": 126,
      "start": 259.199,
      "end": 263.32,
      "text": "सालों तक ओवर वैल्यूड भी रहते हैं जिसे"
    },
    {
      "subtitle_id": 127,
      "start": 261.799,
      "end": 265.24,
      "text": "समझने के लिए मैं आपको एक सिंपल सी चीज"
    },
    {
      "subtitle_id": 128,
      "start": 263.32,
      "end": 267.72,
      "text": "बता द हूं कि स्टॉक मार्केट में सारे"
    },
    {
      "subtitle_id": 129,
      "start": 265.24,
      "end": 270.68,
      "text": "डिसीजंस ह्यूमंस लेते हैं लोग लेते हैं और"
    },
    {
      "subtitle_id": 130,
      "start": 267.72,
      "end": 272.6,
      "text": "लोग स्टूपिडिटी करते हैं वरन बफेट कहते कि"
    },
    {
      "subtitle_id": 131,
      "start": 270.68,
      "end": 274.72,
      "text": "मैं एक बार लास वेगस गया था वहां पर मैंने"
    },
    {
      "subtitle_id": 132,
      "start": 272.6,
      "end": 276.72,
      "text": "देखा कि हजारों माइल्स ट्रेवल करके लोग"
    },
    {
      "subtitle_id": 133,
      "start": 274.72,
      "end": 278.84,
      "text": "सूट बूट पहन के यहां पर आते हैं और यहां"
    },
    {
      "subtitle_id": 134,
      "start": 276.72,
      "end": 280.039,
      "text": "पर आकर गैंबलिंग करते हैं कसीनो खेलते हैं"
    },
    {
      "subtitle_id": 135,
      "start": 278.84,
      "end": 282.8,
      "text": "जहां पर उन्हें भी पता है कि उन्हें"
    },
    {
      "subtitle_id": 136,
      "start": 280.039,
      "end": 284.44,
      "text": "नुकसान ही होने वाला है तो वरन बफेट बोलते"
    },
    {
      "subtitle_id": 137,
      "start": 282.8,
      "end": 286.36,
      "text": "हैं कि मुझे यही स्टुपिड लोगों की बहुत"
    },
    {
      "subtitle_id": 138,
      "start": 284.44,
      "end": 288.479,
      "text": "पसंद है क्योंकि शेयर मार्केट में शेयर की"
    },
    {
      "subtitle_id": 139,
      "start": 286.36,
      "end": 290.28,
      "text": "प्राइसेस यही स्टुपिड लोग डिसाइड करते हैं"
    },
    {
      "subtitle_id": 140,
      "start": 288.479,
      "end": 292.199,
      "text": "जिनकी वजह से कई बार शेयर प्राइसेस अंडर"
    },
    {
      "subtitle_id": 141,
      "start": 290.28,
      "end": 294.36,
      "text": "वैल्यूड होती हैं तो कई बार और वैल्यूड"
    },
    {
      "subtitle_id": 142,
      "start": 292.199,
      "end": 295.88,
      "text": "होती है फेयरली वैल्यूड और बहुत ही कम बार"
    },
    {
      "subtitle_id": 143,
      "start": 294.36,
      "end": 298.08,
      "text": "होती है अब हुआ क्या है कि जैसे ये"
    },
    {
      "subtitle_id": 144,
      "start": 295.88,
      "end": 299.96,
      "text": "स्टॉक्स आईआरएफसी है फॉर एग्जांपल इसकी"
    },
    {
      "subtitle_id": 145,
      "start": 298.08,
      "end": 302.16,
      "text": "मैं शेयर प्राइस आपको पिछले पाच सा लो की"
    },
    {
      "subtitle_id": 146,
      "start": 299.96,
      "end": 305.84,
      "text": "दिखा देता हूं तो स्टॉक को कोई खरीदने को"
    },
    {
      "subtitle_id": 147,
      "start": 302.16,
      "end": 307.96,
      "text": "तैयार नहीं था 20 ₹1 पर जबकि कंपनी 2025"
    },
    {
      "subtitle_id": 148,
      "start": 305.84,
      "end": 310.199,
      "text": "पर से कंपाउंडेड सालाना ग्रो कर रही थी और"
    },
    {
      "subtitle_id": 149,
      "start": 307.96,
      "end": 312.759,
      "text": "उस टाइम कंपनी का जो पी रेशो था वह मात्र"
    },
    {
      "subtitle_id": 150,
      "start": 310.199,
      "end": 314.88,
      "text": "4 पाछ के करीब चल रहा था अब उस पर मैं"
    },
    {
      "subtitle_id": 151,
      "start": 312.759,
      "end": 316.32,
      "text": "आऊंगा पी रेशो क्या है क्यों इंपॉर्टेंट"
    },
    {
      "subtitle_id": 152,
      "start": 314.88,
      "end": 318.6,
      "text": "है और क्या सिर्फ पी रेशो से आपको सारी"
    },
    {
      "subtitle_id": 153,
      "start": 316.32,
      "end": 320.36,
      "text": "चीजें समझ में आ जाएगी उस पर मैं आता हूं"
    },
    {
      "subtitle_id": 154,
      "start": 318.6,
      "end": 322.36,
      "text": "तो कोई भी व्यक्ति इस कंपनी को ₹ पर"
    },
    {
      "subtitle_id": 155,
      "start": 320.36,
      "end": 324.759,
      "text": "खरीदने के लिए तैयार नहीं था लेकिन बाद"
    },
    {
      "subtitle_id": 156,
      "start": 322.36,
      "end": 326.639,
      "text": "में लोग इस कंपनी को ₹ पर भी खरीदने के"
    },
    {
      "subtitle_id": 157,
      "start": 324.759,
      "end": 328.68,
      "text": "लिए रेडी हो गए अब यह ऐसा क्यों होता है"
    },
    {
      "subtitle_id": 158,
      "start": 326.639,
      "end": 331.039,
      "text": "यह वैल्यूएशन साइकल्स की वजह से होता है"
    },
    {
      "subtitle_id": 159,
      "start": 328.68,
      "end": 333.08,
      "text": "तो आप कंपनी यहां पर पी रेशो का ग्राफ मैं"
    },
    {
      "subtitle_id": 160,
      "start": 331.039,
      "end": 335.72,
      "text": "आपको दिखा देता हूं सो अर्ली पी रेशो वाज"
    },
    {
      "subtitle_id": 161,
      "start": 333.08,
      "end": 337.4,
      "text": "फोर फव समथिंग लाइक दैट सिर्फ आईआरएफसी"
    },
    {
      "subtitle_id": 162,
      "start": 335.72,
      "end": 339.84,
      "text": "नहीं आप यहां पर रेल विकास निगम लिमिटेड"
    },
    {
      "subtitle_id": 163,
      "start": 337.4,
      "end": 341.96,
      "text": "डाल दीजिए अब मासगा डॉग डाल दीजिए अब बाकी"
    },
    {
      "subtitle_id": 164,
      "start": 339.84,
      "end": 343.919,
      "text": "कोई भी पीएसयू कंपनीज देख लीजिए 2022 तक"
    },
    {
      "subtitle_id": 165,
      "start": 341.96,
      "end": 346.08,
      "text": "वो बिल्कुल आराम से ठंडे पड़े थे नोबडी"
    },
    {
      "subtitle_id": 166,
      "start": 343.919,
      "end": 347.759,
      "text": "वाज विलिंग टू बाय देम और उसमें से सरकारी"
    },
    {
      "subtitle_id": 167,
      "start": 346.08,
      "end": 349.56,
      "text": "कंपनीज में से कुछ कंपनीज बहुत तेजी से"
    },
    {
      "subtitle_id": 168,
      "start": 347.759,
      "end": 350.919,
      "text": "बढ़ रही थी अब बिजनेस परफॉर्मेंस हो रही"
    },
    {
      "subtitle_id": 169,
      "start": 349.56,
      "end": 353.08,
      "text": "है लेकिन वैल्युएशन नहीं बढ़ रहा है ऐसा"
    },
    {
      "subtitle_id": 170,
      "start": 350.919,
      "end": 356.28,
      "text": "ज्यादा देर मार्केट में चलता नहीं है आपके"
    },
    {
      "subtitle_id": 171,
      "start": 353.08,
      "end": 358.0,
      "text": "बिजनेस परफॉम बढ़ रही है तो सनर और लेटर"
    },
    {
      "subtitle_id": 172,
      "start": 356.28,
      "end": 359.88,
      "text": "मार्केट को बढ़ना पड़ेगा शेयर प्राइस को"
    },
    {
      "subtitle_id": 173,
      "start": 358.0,
      "end": 361.16,
      "text": "बढ़ना पड़ेगा इसलिए बेंजामिन ग्रा हम कहते"
    },
    {
      "subtitle_id": 174,
      "start": 359.88,
      "end": 363.319,
      "text": "हैं कि शॉर्ट टर्म में स्टॉक मार्केट इज"
    },
    {
      "subtitle_id": 175,
      "start": 361.16,
      "end": 366.08,
      "text": "लाइक अ वोटिंग मशीन बट इन द लॉन्ग रन इट"
    },
    {
      "subtitle_id": 176,
      "start": 363.319,
      "end": 368.28,
      "text": "इज लाइक अ वेइंग मशीन जो वेट है वो दिखेगा"
    },
    {
      "subtitle_id": 177,
      "start": 366.08,
      "end": 370.08,
      "text": "अब यहां पर 2022 के आसपास लोगों को वेट"
    },
    {
      "subtitle_id": 178,
      "start": 368.28,
      "end": 372.4,
      "text": "दिखना धीरे-धीरे शुरू हो गया लोगों ने"
    },
    {
      "subtitle_id": 179,
      "start": 370.08,
      "end": 373.919,
      "text": "खरीददारी करना शुरू की और उसके बाद कंपनी"
    },
    {
      "subtitle_id": 180,
      "start": 372.4,
      "end": 376.479,
      "text": "के शेयर प्राइस बहुत तेजी से आगे बढ़ने"
    },
    {
      "subtitle_id": 181,
      "start": 373.919,
      "end": 378.4,
      "text": "लगी अब इसमें कई सारे ऑपरेटर घुस गए कई"
    },
    {
      "subtitle_id": 182,
      "start": 376.479,
      "end": 380.0,
      "text": "सारे बिगिनर्स उस टाइम आए वो भी घुस गए अब"
    },
    {
      "subtitle_id": 183,
      "start": 378.4,
      "end": 381.8,
      "text": "उन्हें ये लगा कि सरकारी स्टॉक्स मतलब"
    },
    {
      "subtitle_id": 184,
      "start": 380.0,
      "end": 383.96,
      "text": "खजाना है इनकी शेयर प्राइस पिछले एक साल"
    },
    {
      "subtitle_id": 185,
      "start": 381.8,
      "end": 386.0,
      "text": "में डबल हुई है ट्रिपल हुई है तो आने वाले"
    },
    {
      "subtitle_id": 186,
      "start": 383.96,
      "end": 387.479,
      "text": "टाइम में भी होती रहेगी इसी ब्लाइंड आशा"
    },
    {
      "subtitle_id": 187,
      "start": 386.0,
      "end": 389.08,
      "text": "में लोगों ने कंपनीज में इन्वेस्ट करना"
    },
    {
      "subtitle_id": 188,
      "start": 387.479,
      "end": 390.88,
      "text": "शुरू किया अब इसमें हुआ क्या कि जो"
    },
    {
      "subtitle_id": 189,
      "start": 389.08,
      "end": 393.479,
      "text": "फंडामेंट स्ट्रंग कंपनीज थी उनके शेयर"
    },
    {
      "subtitle_id": 190,
      "start": 390.88,
      "end": 395.319,
      "text": "प्राइस तो बढ़ी बढ़ी जो फंडामेंटली वीक थी"
    },
    {
      "subtitle_id": 191,
      "start": 393.479,
      "end": 397.88,
      "text": "जो बिल्कुल ग्रो नहीं कर रही थी लॉसेस में"
    },
    {
      "subtitle_id": 192,
      "start": 395.319,
      "end": 399.319,
      "text": "है पड़ी है सरकार परेशान है बेचने की"
    },
    {
      "subtitle_id": 193,
      "start": 397.88,
      "end": 401.28,
      "text": "प्लानिंग कर रही है उनमें भी बहुत ज्यादा"
    },
    {
      "subtitle_id": 194,
      "start": 399.319,
      "end": 403.72,
      "text": "डिमांड आई और उनकी शेयर प्राइस भी बहुत"
    },
    {
      "subtitle_id": 195,
      "start": 401.28,
      "end": 405.319,
      "text": "ज्यादा बढ़ने लगी सो अब पता कैसे करें कि"
    },
    {
      "subtitle_id": 196,
      "start": 403.72,
      "end": 407.68,
      "text": "कौन सा स्टॉक ओवर वैल्यूड है कौन सा अंडर"
    },
    {
      "subtitle_id": 197,
      "start": 405.319,
      "end": 409.72,
      "text": "वैल्यूड है अब इसकी अंडरस्टैंडिंग कैसे ले"
    },
    {
      "subtitle_id": 198,
      "start": 407.68,
      "end": 411.16,
      "text": "तो चलिए उस पर आता हूं ये आईआरएफसी की मैं"
    },
    {
      "subtitle_id": 199,
      "start": 409.72,
      "end": 413.08,
      "text": "बात करता हूं पहले जिसे मैंने खरीदा था"
    },
    {
      "subtitle_id": 200,
      "start": 411.16,
      "end": 414.56,
      "text": "लगभग 2 साल पहले हर साल महूरत ट्रेडिंग के"
    },
    {
      "subtitle_id": 201,
      "start": 413.08,
      "end": 416.08,
      "text": "दिन मैं एक वीडियो बनाता हूं जिसमें मैं"
    },
    {
      "subtitle_id": 202,
      "start": 414.56,
      "end": 418.16,
      "text": "बताता हूं कि क्या कुछ मैं बाय करने वाला"
    },
    {
      "subtitle_id": 203,
      "start": 416.08,
      "end": 420.4,
      "text": "हूं उस वीडियो को जाकर आप भी देख सकते हो"
    },
    {
      "subtitle_id": 204,
      "start": 418.16,
      "end": 422.639,
      "text": "तो वहां पर भी मेरा लॉजिक यही था कि कंपनी"
    },
    {
      "subtitle_id": 205,
      "start": 420.4,
      "end": 425.68,
      "text": "का पी रेशो 45 का चल रहा है लेकिन कंपनी"
    },
    {
      "subtitle_id": 206,
      "start": 422.639,
      "end": 427.4,
      "text": "की जो ग्रोथ है सालाना वो 2025 की चल रही"
    },
    {
      "subtitle_id": 207,
      "start": 425.68,
      "end": 429.12,
      "text": "है जैसे कि आप यहां पर देख सकते हो कि"
    },
    {
      "subtitle_id": 208,
      "start": 427.4,
      "end": 432.039,
      "text": "पिछले 5 साल की रेवेन्यू और प्रॉफिट ग्रोथ"
    },
    {
      "subtitle_id": 209,
      "start": 429.12,
      "end": 433.36,
      "text": "कंपनी की अराउंड 2025 पर थी अब इसके पीछे"
    },
    {
      "subtitle_id": 210,
      "start": 432.039,
      "end": 435.039,
      "text": "और भी लॉजिक थे कि क्यों ये ग्रोथ"
    },
    {
      "subtitle_id": 211,
      "start": 433.36,
      "end": 436.52,
      "text": "कंटिन्यू करेगी क्योंकि अकेली ऐसी कंपनी"
    },
    {
      "subtitle_id": 212,
      "start": 435.039,
      "end": 437.8,
      "text": "है जो रेलवे को लोन दे सकते हो और रेलवे"
    },
    {
      "subtitle_id": 213,
      "start": 436.52,
      "end": 439.52,
      "text": "में काफी सारा एक्सपेंशन चल रहा है तो"
    },
    {
      "subtitle_id": 214,
      "start": 437.8,
      "end": 441.44,
      "text": "पैसा भी लगने वाला था अब उसमें हम डिटेल"
    },
    {
      "subtitle_id": 215,
      "start": 439.52,
      "end": 444.0,
      "text": "में नहीं जाएंगे बट कहने का तात्पर्य यह"
    },
    {
      "subtitle_id": 216,
      "start": 441.44,
      "end": 446.68,
      "text": "है अगर किसी कंपनी का पी रेशो 50 का है"
    },
    {
      "subtitle_id": 217,
      "start": 444.0,
      "end": 448.44,
      "text": "लेकिन कंपनी की ग्रोथ 5 पर की है तो वो"
    },
    {
      "subtitle_id": 218,
      "start": 446.68,
      "end": 450.599,
      "text": "कंपनी कुछ काम की नहीं वो बिल्कुल ओवर"
    },
    {
      "subtitle_id": 219,
      "start": 448.44,
      "end": 453.28,
      "text": "वैल्यूड है वहीं पर किसी कंपनी का पी रेशो"
    },
    {
      "subtitle_id": 220,
      "start": 450.599,
      "end": 455.12,
      "text": "पांच का है लेकिन उसकी ग्रोथ 50 पर की है"
    },
    {
      "subtitle_id": 221,
      "start": 453.28,
      "end": 457.759,
      "text": "इट मींस इट्स अ वेरी वेरी अंडरवैल्यूड"
    },
    {
      "subtitle_id": 222,
      "start": 455.12,
      "end": 459.4,
      "text": "कंपनी तो पी रेशो से सिर्फ काम नहीं चलता"
    },
    {
      "subtitle_id": 223,
      "start": 457.759,
      "end": 461.52,
      "text": "है आपको ग्रोथ पैरामीटर्स भी देखने"
    },
    {
      "subtitle_id": 224,
      "start": 459.4,
      "end": 464.0,
      "text": "पड़ेंगे और यहां पर अगर पीएस स्टॉक में"
    },
    {
      "subtitle_id": 225,
      "start": 461.52,
      "end": 466.52,
      "text": "अगर देखा जाए तो इनके पी रेशो किसी के 50"
    },
    {
      "subtitle_id": 226,
      "start": 464.0,
      "end": 468.599,
      "text": "है किसी के 100 है किसी के 500 है जिसमें"
    },
    {
      "subtitle_id": 227,
      "start": 466.52,
      "end": 470.879,
      "text": "कई सारी कंपनीज तो ऐसी है भेल जैसी भारत"
    },
    {
      "subtitle_id": 228,
      "start": 468.599,
      "end": 472.84,
      "text": "हैवी इलेक्ट्रिकल्स लिमिटेड जिसकी सेल्स"
    },
    {
      "subtitle_id": 229,
      "start": 470.879,
      "end": 475.68,
      "text": "ग्रोथ नेगेटिव में है जिसकी प्रॉफिट ग्रोथ"
    },
    {
      "subtitle_id": 230,
      "start": 472.84,
      "end": 477.319,
      "text": "नेगेटिव में है लेकिन शेयर प्राइस पिछले 1"
    },
    {
      "subtitle_id": 231,
      "start": 475.68,
      "end": 479.68,
      "text": "साल में तीन गुना बढ़ी है जिसके चलते"
    },
    {
      "subtitle_id": 232,
      "start": 477.319,
      "end": 480.96,
      "text": "कंपनी का पी रेशो 1000 के ऊपर चला गया है"
    },
    {
      "subtitle_id": 233,
      "start": 479.68,
      "end": 482.759,
      "text": "अब मैं यहां पर क्रिटिसाइज नहीं कर रहा"
    },
    {
      "subtitle_id": 234,
      "start": 480.96,
      "end": 484.319,
      "text": "हूं पीएसयू स्टॉक्स को ठीक है बहुत सारे"
    },
    {
      "subtitle_id": 235,
      "start": 482.759,
      "end": 486.52,
      "text": "अच्छे स्टॉक्स है फंडामेंटली नॉट अ"
    },
    {
      "subtitle_id": 236,
      "start": 484.319,
      "end": 488.44,
      "text": "प्रॉब्लम बट जब भी आप इन्वेस्ट कर रहे हो"
    },
    {
      "subtitle_id": 237,
      "start": 486.52,
      "end": 490.56,
      "text": "तो मेक श्यर करो कि आप बेसिक फंडामेंटल्स"
    },
    {
      "subtitle_id": 238,
      "start": 488.44,
      "end": 492.479,
      "text": "एटलीस्ट कंपनी के देख रहे हो ताकि उसके"
    },
    {
      "subtitle_id": 239,
      "start": 490.56,
      "end": 494.159,
      "text": "बेसिस पर आप सही स्टॉक्स चुनो और इस तरह"
    },
    {
      "subtitle_id": 240,
      "start": 492.479,
      "end": 495.759,
      "text": "के ट्रेंड्स और बबल में पार्टिसिपेट मत"
    },
    {
      "subtitle_id": 241,
      "start": 494.159,
      "end": 497.319,
      "text": "कीजिए क्योंकि इसमें अल्टीमेटली आपको लॉस"
    },
    {
      "subtitle_id": 242,
      "start": 495.759,
      "end": 499.4,
      "text": "ही होगा फायदा अगर किसी को मिलेगा तो"
    },
    {
      "subtitle_id": 243,
      "start": 497.319,
      "end": 500.72,
      "text": "ऑपरेटर्स को मिलेगा क्योंकि वो टारगेट"
    },
    {
      "subtitle_id": 244,
      "start": 499.4,
      "end": 502.44,
      "text": "करते हैं ऐसे लोगों को जो ब्लाइंड"
    },
    {
      "subtitle_id": 245,
      "start": 500.72,
      "end": 504.599,
      "text": "इन्वेस्ट करते हैं बिना कुछ देखे बिना कुछ"
    },
    {
      "subtitle_id": 246,
      "start": 502.44,
      "end": 506.44,
      "text": "समझे सो इस वीडियो का कंक्लूजन यही है कि"
    },
    {
      "subtitle_id": 247,
      "start": 504.599,
      "end": 508.8,
      "text": "कई सारे पीएसओ स्टॉक्स में बबल क्लियर"
    },
    {
      "subtitle_id": 248,
      "start": 506.44,
      "end": 510.319,
      "text": "विजिबल है अब कब फटेगा कोई नहीं बता सकता"
    },
    {
      "subtitle_id": 249,
      "start": 508.8,
      "end": 511.84,
      "text": "बिकॉज स्टॉक मार्केट इज लाइक अ वोटिंग"
    },
    {
      "subtitle_id": 250,
      "start": 510.319,
      "end": 513.599,
      "text": "मशीन इनन द शॉर्ट रन एंड इट इज लाइक अ"
    },
    {
      "subtitle_id": 251,
      "start": 511.84,
      "end": 515.8,
      "text": "वेइंग मशीन इन द लॉन्ग रन तो लॉन्ग रन में"
    },
    {
      "subtitle_id": 252,
      "start": 513.599,
      "end": 517.479,
      "text": "जरूर जो वेट रहेगा वही दिखेगा तो लॉन्ग"
    },
    {
      "subtitle_id": 253,
      "start": 515.8,
      "end": 519.64,
      "text": "टर्म में जरूर ये करेक्ट होंगे बहुत सारे"
    },
    {
      "subtitle_id": 254,
      "start": 517.479,
      "end": 521.64,
      "text": "जो फंडामेंटली कुछ नहीं कर रहे अल्टीमेटली"
    },
    {
      "subtitle_id": 255,
      "start": 519.64,
      "end": 523.719,
      "text": "सरकारी एमएमटीसी और एसटीसी जैसी कंपनीज को"
    },
    {
      "subtitle_id": 256,
      "start": 521.64,
      "end": 525.64,
      "text": "बंद करने जा रही है तो इसीलिए जब भी किसी"
    },
    {
      "subtitle_id": 257,
      "start": 523.719,
      "end": 527.839,
      "text": "स्टॉक में इन्वेस्ट करें सोच समझ कर"
    },
    {
      "subtitle_id": 258,
      "start": 525.64,
      "end": 529.8,
      "text": "एनालिसिस करके ही इन्वेस्ट करें नहीं तो"
    },
    {
      "subtitle_id": 259,
      "start": 527.839,
      "end": 531.88,
      "text": "यहां पर पैसा गवाने के अलावा आपको कुछ"
    },
    {
      "subtitle_id": 260,
      "start": 529.8,
      "end": 533.48,
      "text": "नहीं मिलेगा और यह सारी चीजें होने के बाद"
    },
    {
      "subtitle_id": 261,
      "start": 531.88,
      "end": 535.12,
      "text": "होता यह है कि लोग शेयर मार्केट को गाली"
    },
    {
      "subtitle_id": 262,
      "start": 533.48,
      "end": 537.2,
      "text": "गलोज करके निकल जाते हैं बोलते कि शेयर"
    },
    {
      "subtitle_id": 263,
      "start": 535.12,
      "end": 539.399,
      "text": "मार्केट सट्टा है तो यहां पर पहले आपको"
    },
    {
      "subtitle_id": 264,
      "start": 537.2,
      "end": 540.76,
      "text": "सारी चीजों को समझना पड़ेगा एनालिसिस करना"
    },
    {
      "subtitle_id": 265,
      "start": 539.399,
      "end": 542.839,
      "text": "करना पड़ेगा उसके बाद ही आपको"
    },
    {
      "subtitle_id": 266,
      "start": 540.76,
      "end": 544.44,
      "text": "इन्वेस्टमेंट का यह पूरा खेल समझ में आएगा"
    },
    {
      "subtitle_id": 267,
      "start": 542.839,
      "end": 546.32,
      "text": "सो आशा करता हूं कि आप इस वीडियो से जरूर"
    },
    {
      "subtitle_id": 268,
      "start": 544.44,
      "end": 548.079,
      "text": "अवेयर हुए होंगे इस वीडियो को ज्यादा से"
    },
    {
      "subtitle_id": 269,
      "start": 546.32,
      "end": 549.839,
      "text": "ज्यादा लोगों तक जरूर शेयर कीजिए ताकि"
    },
    {
      "subtitle_id": 270,
      "start": 548.079,
      "end": 551.76,
      "text": "उन्हें भी पीएसयू स्टॉक्स की जो रियलिटी"
    },
    {
      "subtitle_id": 271,
      "start": 549.839,
      "end": 553.48,
      "text": "है वो पता चले कंपनी के वैल्युएशंस के"
    },
    {
      "subtitle_id": 272,
      "start": 551.76,
      "end": 554.8,
      "text": "बारे में अच्छा अंडरस्टैंडिंग मिले और इसी"
    },
    {
      "subtitle_id": 273,
      "start": 553.48,
      "end": 556.839,
      "text": "तरह के वीडियोस के लिए हमें जरूर"
    },
    {
      "subtitle_id": 274,
      "start": 554.8,
      "end": 558.68,
      "text": "सब्सक्राइब कीजिए और बेल आइकन पर भी क्लिक"
    },
    {
      "subtitle_id": 275,
      "start": 556.839,
      "end": 562.12,
      "text": "कीजिए मिलते हैं अगले वीडियो में थैंक यू"
    },
    {
      "subtitle_id": 276,
      "start": 558.68,
      "end": 562.12,
      "text": "सो मच फॉर वाचिंग दिस वीडियो"
    }
  ]
}