    {
      "subtitle_id": 191,
      "start": 430.44,
      "end": 434.319,
      "text": "पड़ा हुआ है तो सितंबर क्वार्टर में तो नए"
    },
    {
      "subtitle_id": 192,
      "start": 432.52,
      "end": 435.44,
      "text": "माल की जरूरत ही नहीं थी जिसकी वजह से भी"
    },
    {
      "subtitle_id": 193,
      "start": 434.319,
      "end": 436.68,
      "text": "सितंबर क्वार्टर में फिर उन"
    },
    {
      "subtitle_id": 194,
      "start": 435.44,
      "end": 438.039,
      "text": "डिस्ट्रीब्यूटर्स को देने के लिए ज्यादा"
    },
    {
      "subtitle_id": 195,
      "start": 436.68,
      "end": 440.12,
      "text": "कुछ था नहीं उन डीलर्स को देने के लिए"
    },
    {
      "subtitle_id": 196,
      "start": 438.039,
      "end": 442.96,
      "text": "ज्यादा कुछ था नहीं जिसकी वजह से नंबर्स"
    },
    {
      "subtitle_id": 197,
      "start": 440.12,
      "end": 445.16,
      "text": "काफी खराब रहे ऐसा कई सारे डीलर्स का कहना"
    },
    {
      "subtitle_id": 198,
      "start": 442.96,
      "end": 447.36,
      "text": "है आप यह न्यूज़ देख सकते हो मामार ने"
    },
    {
      "subtitle_id": 199,
      "start": 445.16,
      "end": 449.52,
      "text": "भारी मात्रा में अपनी जो इन्वेंटरी है इन"
    },
    {
      "subtitle_id": 200,
      "start": 447.36,
      "end": 450.759,
      "text": "डिस्ट्रीब्यूटर्स को आगे भेज दी थी और इसी"
    },
    {
      "subtitle_id": 201,
      "start": 449.52,
      "end": 452.24,
      "text": "इसी की वजह से कई सारे डिस्ट्रीब्यूटर्स"
    },
    {
      "subtitle_id": 202,
      "start": 450.759,
      "end": 454.199,
      "text": "का कहना है कि उन्हें 100 करोड़ तक का"
    },
    {
      "subtitle_id": 203,
      "start": 452.24,
      "end": 455.879,
      "text": "नुकसान हुआ है और इसके साथ कई सारे"
    },
    {
      "subtitle_id": 204,
      "start": 454.199,
      "end": 458.879,
      "text": "डिस्ट्रीब्यूटर्स ने ये भी कंप्लेंट की कि"
    },
    {
      "subtitle_id": 205,
      "start": 455.879,
      "end": 460.8,
      "text": "उनके पास यू नो काफी लंबे टाइम से ज्यादा"
    },
    {
      "subtitle_id": 206,
      "start": 458.879,
      "end": 462.759,
      "text": "माल पहुंच गया है जिसकी वजह से अभी वो जो"
    },
    {
      "subtitle_id": 207,
      "start": 460.8,
      "end": 464.759,
      "text": "प्रोडक्ट्स है जो बहुत एक साथ ही उन्हें"
    },
    {
      "subtitle_id": 208,
      "start": 462.759,
      "end": 467.159,
      "text": "बेचे गए थे दिए गए थे वो अभी एक्सपायरी के"
    },
    {
      "subtitle_id": 209,
      "start": 464.759,
      "end": 469.36,
      "text": "नजदीक आए हैं तो उन्हें भी डर है कि ये"
    },
    {
      "subtitle_id": 210,
      "start": 467.159,
      "end": 471.639,
      "text": "खराब हो गए एक्सपायरी हो गई इनकी तो हमारे"
    },
    {
      "subtitle_id": 211,
      "start": 469.36,
      "end": 473.759,
      "text": "लिए भी काफी जो लॉस है वो बढ़ सकता है"
    },
    {
      "subtitle_id": 212,
      "start": 471.639,
      "end": 475.319,
      "text": "हालांकि जब अभी मामा आर्थ लॉस में चली गई"
    },
    {
      "subtitle_id": 213,
      "start": 473.759,
      "end": 477.8,
      "text": "सप्टेंबर क्वार्टर में तो कंपनी के जो"
    },
    {
      "subtitle_id": 214,
      "start": 475.319,
      "end": 480.44,
      "text": "फाउंडर हैं उन्होंने एक स्टेटमेंट दिया और"
    },
    {
      "subtitle_id": 215,
      "start": 477.8,
      "end": 482.72,
      "text": "स्टेटमेंट काफी अजीब था उनका ये कहना था"
    },
    {
      "subtitle_id": 216,
      "start": 480.44,
      "end": 484.28,
      "text": "कि हमारा जो सप्लाई चेन है उसे सॉर्ट आउट"
    },
    {
      "subtitle_id": 217,
      "start": 482.72,
      "end": 486.12,
      "text": "करने के लिए हमने न्यू नाम का प्रोजेक्ट"
    },
    {
      "subtitle_id": 218,
      "start": 484.28,
      "end": 488.24,
      "text": "शुरू किया जिसमें उन्होंने कहा कि अब हम"
    },
    {
      "subtitle_id": 219,
      "start": 486.12,
      "end": 490.08,
      "text": "सुपर स्टॉकिस्ट को माल भेजने की बजाय सीधे"
    },
    {
      "subtitle_id": 220,
      "start": 488.24,
      "end": 491.84,
      "text": "डायरेक्ट डिस्ट्रीब्यूटर्स को माल भेजेंगे"
    },
    {
      "subtitle_id": 221,
      "start": 490.08,
      "end": 493.56,
      "text": "और यही फिर जो चेंजेज हम कर रहे थे उसकी"
    },
    {
      "subtitle_id": 222,
      "start": 491.84,
      "end": 495.639,
      "text": "वजह से लॉसेस हुए लेकिन ये जो स्टेटमेंट"
    },
    {
      "subtitle_id": 223,
      "start": 493.56,
      "end": 497.599,
      "text": "था ये उतना कन्विंसिंग नहीं था जिसके बाद"
    },
    {
      "subtitle_id": 224,
      "start": 495.639,
      "end": 499.159,
      "text": "और भी चीजें देखी गई तो और फिर जैसे ही"
    },
    {
      "subtitle_id": 225,
      "start": 497.599,
      "end": 501.44,
      "text": "डिस्ट्रीब्यूटर के साइड से कंप्लेंट आने"
    },
    {
      "subtitle_id": 226,
      "start": 499.159,
      "end": 503.039,
      "text": "लगी और लोगों ने भी देखा कि हां यार जो वो"
    },
    {
      "subtitle_id": 227,
      "start": 501.44,
      "end": 504.479,
      "text": "बोल रहे हैं वो कंपनी के फाइनेंशियल"
    },
    {
      "subtitle_id": 228,
      "start": 503.039,
      "end": 507.44,
      "text": "स्टेटमेंट से कहीं ना कहीं मैच भी हो रहा"
    },
    {
      "subtitle_id": 229,
      "start": 504.479,
      "end": 509.52,
      "text": "है क्योंकि जस्ट आईपीओ आ रहा था तो उस"
    },
    {
      "subtitle_id": 230,
      "start": 507.44,
      "end": 511.68,
      "text": "क्वार्टर में फिर रिवेन्यूज और बाकी चीजें"
    },
    {
      "subtitle_id": 231,
      "start": 509.52,
      "end": 513.919,
      "text": "अच्छी खासी दिखाई गई प्रॉफिट अच्छा खासा"
    },
    {
      "subtitle_id": 232,
      "start": 511.68,
      "end": 515.839,
      "text": "था लेकिन फिर देन देन सप्टेंबर क्वार्टर"
    },
    {
      "subtitle_id": 233,
      "start": 513.919,
      "end": 518.2,
      "text": "में चीजें बैक टू पवेलियन होती हुई नजर आ"
    },
    {
      "subtitle_id": 234,
      "start": 515.839,
      "end": 521.0,
      "text": "रही है और फिर इसीज को देखते हुए फिर"
    },
    {
      "subtitle_id": 235,
      "start": 518.2,
      "end": 523.24,
      "text": "लोगों ने स्टॉक्स को सेल करना शुरू किया"
    },
    {
      "subtitle_id": 236,
      "start": 521.0,
      "end": 525.76,
      "text": "और फिर काफी मतलब लंबे टाइम से स्टॉक से"
    },
    {
      "subtitle_id": 237,
      "start": 523.24,
      "end": 528.04,
      "text": "लगातार गिर रहा है तो अगर प्रॉब्लम्स में"
    },
    {
      "subtitle_id": 238,
      "start": 525.76,
      "end": 530.0,
      "text": "अगर आपको गिना हं तो पेटेंट नहीं है नई"
    },
    {
      "subtitle_id": 239,
      "start": 528.04,
      "end": 532.0,
      "text": "कुछ चीजें यहां से इनसाइड आर एनडी"
    },
    {
      "subtitle_id": 240,
      "start": 530.0,
      "end": 533.68,
      "text": "डिपार्टमेंट से नहीं हो रही है सेकंड चीज"
    },
    {
      "subtitle_id": 241,
      "start": 532.0,
      "end": 535.04,
      "text": "सप्लाई चेन साइड से भी काफी दिक्कत आ र"
    },
    {
      "subtitle_id": 242,
      "start": 533.68,
      "end": 536.36,
      "text": "डिस्ट्रीब्यूटर से कंप्लेंट आना इज़ नॉट अ"
    },
    {
      "subtitle_id": 243,
      "start": 535.04,
      "end": 538.079,
      "text": "गुड थिंग फॉर अ ब्रांड क्योंकि एक बार"
    },
    {
      "subtitle_id": 244,
      "start": 536.36,
      "end": 539.88,
      "text": "उनको लॉस हो गया तो वापस वो प्रेफरेंस"
    },
    {
      "subtitle_id": 245,
      "start": 538.079,
      "end": 542.399,
      "text": "नहीं देंगे उस ब्रांड को दैट इज़ वेरी ऑब्"
    },
    {
      "subtitle_id": 246,
      "start": 539.88,
      "end": 544.56,
      "text": "वियस तीसरी चीज जो काफी एक शॉकिंग है"
    },
    {
      "subtitle_id": 247,
      "start": 542.399,
      "end": 546.76,
      "text": "थोड़ी कंपनी के बारे में वो यह है कि इनके"
    },
    {
      "subtitle_id": 248,
      "start": 544.56,
      "end": 548.44,
      "text": "पास रिपीट कस्टमर बेस बहुत कम है तो जिसकी"
    },
    {
      "subtitle_id": 249,
      "start": 546.76,
      "end": 550.0,
      "text": "वजह से इनका जो एडवर्टाइजमेंट कॉस्ट है वो"
    },
    {
      "subtitle_id": 250,
      "start": 548.44,
      "end": 551.72,
      "text": "लगातार बढ़ते जा रहा है नए कस्टमर्स को"
    },
    {
      "subtitle_id": 251,
      "start": 550.0,
      "end": 553.36,
      "text": "एक्वायर करने के लिए और वो नया कस्टमर"
    },
    {
      "subtitle_id": 252,
      "start": 551.72,
      "end": 554.8,
      "text": "ज्यादा पैसा बना के भी नहीं जा रहा है एक"
    },
    {
      "subtitle_id": 253,
      "start": 553.36,
      "end": 556.8,
      "text": "बार प्रोडक्ट ले रहा है दूसरी बार आ ही"
    },
    {
      "subtitle_id": 254,
      "start": 554.8,
      "end": 559.04,
      "text": "नहीं रहा है तो ब्यूटी प्रोडक्ट्स है तो"
    },
    {
      "subtitle_id": 255,
      "start": 556.8,
      "end": 561.48,
      "text": "वो कई बार इसी चीज पर राइड करते हैं कि एक"
    },
    {
      "subtitle_id": 256,
      "start": 559.04,
      "end": 563.04,
      "text": "बार दे दिया प्रोडक्ट को तो भी बेच दिया"
    },
    {
      "subtitle_id": 257,
      "start": 561.48,
      "end": 564.68,
      "text": "तो बार-बार लोग लेते रहेंगे बेसिक से"
    },
    {
      "subtitle_id": 258,
      "start": 563.04,
      "end": 567.36,
      "text": "बेसिक प्रोडक्ट ले लो हिंदुस्तान यून लिवर"
    },
    {
      "subtitle_id": 259,
      "start": 564.68,
      "end": 569.2,
      "text": "का पंड से पाउडर सो कुछ इस तरह से"
    },
    {
      "subtitle_id": 260,
      "start": 567.36,
      "end": 571.56,
      "text": "उन्होंने बेचा है कि हर बार लोग लेते रहते"
    },
    {
      "subtitle_id": 261,
      "start": 569.2,
      "end": 573.44,
      "text": "हैं फेयर एंड लवली हो गया लेते रहते लोग"
    },
    {
      "subtitle_id": 262,
      "start": 571.56,
      "end": 575.399,
      "text": "लेते रहते हैं तो कुछ इस तरह की चीजें"
    },
    {
      "subtitle_id": 263,
      "start": 573.44,
      "end": 577.12,
      "text": "मामार भी कोशिश कर रही थे कि रिकरिंग इनकम"
    },
    {
      "subtitle_id": 264,
      "start": 575.399,
      "end": 579.839,
      "text": "से ही अपना धंधा बढ़ सकता है और बन सकता"
    },
    {
      "subtitle_id": 265,
      "start": 577.12,
      "end": 582.48,
      "text": "है रिक इनकम नहीं आएगा तो यह बिजनेस मतलब"
    },
    {
      "subtitle_id": 266,
      "start": 579.839,
      "end": 584.72,
      "text": "लॉन्ग टर्म चलना इज वेरी वेरी टफ और बट"
    },
    {
      "subtitle_id": 267,
      "start": 582.48,
      "end": 587.64,
      "text": "मामार के केस में अनफॉर्चूनेटली अभी तक"
    },
    {
      "subtitle_id": 268,
      "start": 584.72,
      "end": 589.48,
      "text": "चीजें अ पर्टिकुलर रिकरिंग कस्टमर बेस की"
    },
    {
      "subtitle_id": 269,
      "start": 587.64,
      "end": 591.519,
      "text": "अगर बात करें तो वो चीज अभी तक तो कंपनी"
    },
    {
      "subtitle_id": 270,
      "start": 589.48,
      "end": 593.44,
      "text": "को फेवर नहीं दे रही है कंपनी के सपोर्ट"
    },
    {
      "subtitle_id": 271,
      "start": 591.519,
      "end": 594.839,
      "text": "में फिलहाल तो नहीं लग रही है और इसी वजह"
    },
    {
      "subtitle_id": 272,
      "start": 593.44,
      "end": 597.6,
      "text": "से इनके जो मार्केटिंग एक्सपेंसेस हैं"
    },
    {
      "subtitle_id": 273,
      "start": 594.839,
      "end": 599.519,
      "text": "इनके रेवेन्यू के 30 टू 35 पर है अगर"
    },
    {
      "subtitle_id": 274,
      "start": 597.6,
      "end": 602.0,
      "text": "₹1000000"
    },
    {
      "subtitle_id": 275,
      "start": 599.519,
      "end": 603.959,
      "text": "तो मैन्युफैक्चरिंग कॉस्ट होती है 31 पर"
    },
    {
      "subtitle_id": 276,
      "start": 602.0,
      "end": 606.279,
      "text": "बाकी 10 टू 11 पर जो कॉस्ट होती है वो"
    },
    {
      "subtitle_id": 277,
      "start": 603.959,
      "end": 608.079,
      "text": "एंप्लॉई की सैलरी और फिर बचा कुचा जो चंक"
    },
    {
      "subtitle_id": 278,
      "start": 606.279,
      "end": 609.839,
      "text": "है वह मार्केटिंग में लग जाता है इसलिए"
    },
    {
      "subtitle_id": 279,
      "start": 608.079,
      "end": 611.68,
      "text": "इन्हें नए-नए इन्फ्लुएंस से प्रमोट करवा"
    },
    {
      "subtitle_id": 280,
      "start": 609.839,
      "end": 613.48,
      "text": "के नए-नए कस्टमर्स ढूंढने पड़ते हैं अब"
    },
    {
      "subtitle_id": 281,
      "start": 611.68,
      "end": 615.24,
      "text": "रिसेंटली इन सारी चीजों को सॉर्ट आउट करने"
    },
    {
      "subtitle_id": 282,
      "start": 613.48,
      "end": 617.36,
      "text": "के लिए इन्होंने कंसल्टिंग फर्म बेन को"
    },
    {
      "subtitle_id": 283,
      "start": 615.24,
      "end": 619.0,
      "text": "हायर किया है व आशा करते हैं कि बेन ये"
    },
    {
      "subtitle_id": 284,
      "start": 617.36,
      "end": 620.56,
      "text": "सारे जो पॉइंट्स है प्रॉब्लम्स है उन्हें"
    },
    {
      "subtitle_id": 285,
      "start": 619.0,
      "end": 622.56,
      "text": "हाईलाइट करके इसका सलूशन भी उन्हें दे"
    },
    {
      "subtitle_id": 286,
      "start": 620.56,
      "end": 625.16,
      "text": "देगी जाते-जाते आपको एक चीज बताना चाहता"
    },
    {
      "subtitle_id": 287,
      "start": 622.56,
      "end": 627.0,
      "text": "हूं कि बहुत सारे आईपीओ आ रहे हैं आईपीओ"
    },
    {
      "subtitle_id": 288,
      "start": 625.16,
      "end": 628.959,
      "text": "आते हैं तो अचानक कंपनीज प्रॉफिटेबल हो"
    },
    {
      "subtitle_id": 289,
      "start": 627.0,
      "end": 632.0,
      "text": "जाती है अचानक उसके रिवेन्यूज बढ़ जाते"
    },
    {
      "subtitle_id": 290,
      "start": 628.959,
      "end": 635.16,
      "text": "हैं लेकिन फिर उसके बाद फिर अलग-अलग तरीके"
    },
    {
      "subtitle_id": 291,
      "start": 632.0,
      "end": 637.639,
      "text": "की चीजें कारण बताकर चीजें फिर डालमोथ है"
    },
    {
      "subtitle_id": 292,
      "start": 635.16,
      "end": 639.32,
      "text": "और यह काफी कॉमन हो रहा है आजकल तो इसीलिए"
    },
    {
      "subtitle_id": 293,
      "start": 637.639,
      "end": 642.0,
      "text": "जो भी आईपीओ में इन्वेस्ट करने वाले लोग"
    },
    {
      "subtitle_id": 294,
      "start": 639.32,
      "end": 644.079,
      "text": "हैं उनसे मेरी गुजारिश है दरख्वास्त है कि"
    },
    {
      "subtitle_id": 295,
      "start": 642.0,
      "end": 645.68,
      "text": "किसी भी कंपनी जो अचानक जस्ट आईपीओ से"
    },
    {
      "subtitle_id": 296,
      "start": 644.079,
      "end": 647.399,
      "text": "पहले अचानक बहुत अच्छा परफॉर्म कर रही है"
    },
    {
      "subtitle_id": 297,
      "start": 645.68,
      "end": 649.399,
      "text": "आईपीओ के अराउंड के टाइम में 6 महीना पहले"
    },
    {
      "subtitle_id": 298,
      "start": 647.399,
      "end": 651.0,
      "text": "वगैरह तो ऐसी कंपनीज पर ज्यादा ट्रस्ट ना"
    },
    {
      "subtitle_id": 299,
      "start": 649.399,
      "end": 653.6,
      "text": "करें ट्रस्ट ना करें मतलब उसके फाइनेंशियल"
    },
    {
      "subtitle_id": 300,
      "start": 651.0,
      "end": 656.68,
      "text": "को मतलब जो बढ़ा हुआ नंबर है उससे आप साइड"
    },
    {
      "subtitle_id": 301,
      "start": 653.6,
      "end": 658.639,
      "text": "में ही रहो जो एक साल पहले का या 68 महीने"
    },
    {
      "subtitle_id": 302,
      "start": 656.68,
      "end": 660.519,
      "text": "पहले के नंबर्स हैं उस हिसाब से ही कंपनी"
    },
    {
      "subtitle_id": 303,
      "start": 658.639,
      "end": 662.32,
      "text": "के प्रोजेक्शन करो तो मान लेते हैं कि अगर"
    },
    {
      "subtitle_id": 304,
      "start": 660.519,
      "end": 664.12,
      "text": "कोई कंपनी इन्फ्लेट कर दे थ नंबर आईपीओ के"
    },
    {
      "subtitle_id": 305,
      "start": 662.32,
      "end": 666.0,
      "text": "टाइम और बाद में अपना रियल पिक्चर दिखाती"
    },
    {
      "subtitle_id": 306,
      "start": 664.12,
      "end": 667.639,
      "text": "तो आपके लिए वो बहुत बड़ी प्रॉब्लम हो"
    },
    {
      "subtitle_id": 307,
      "start": 666.0,
      "end": 670.44,
      "text": "सकती है तो व्हेन एवर यू आर इन्वेस्टिंग"
    },
    {
      "subtitle_id": 308,
      "start": 667.639,
      "end": 672.079,
      "text": "इन एनी कंपनी आईपीओ के टाइम हो तो ये चीज"
    },
    {
      "subtitle_id": 309,
      "start": 670.44,
      "end": 674.68,
      "text": "जरूर ध्यान में रखें कि अचानक ज अगर"
    },
    {
      "subtitle_id": 310,
      "start": 672.079,
      "end": 676.279,
      "text": "नंबर्स बहुत अच्छे दिख रहे हैं तो मतलब"
    },
    {
      "subtitle_id": 311,
      "start": 674.68,
      "end": 678.16,
      "text": "जरूरी नहीं कि आपको उन्हें ट्रस्ट ही करना"
    },
    {
      "subtitle_id": 312,
      "start": 676.279,
      "end": 681.36,
      "text": "है ऐसे टाइम में आपके दिमाग में डाउट जरूर"
    },
    {
      "subtitle_id": 313,
      "start": 678.16,
      "end": 683.16,
      "text": "होना चाहिए तो बस इतना ही कहना चाहूंगा और"
    },
    {
      "subtitle_id": 314,
      "start": 681.36,
      "end": 684.8,
      "text": "वही है कि फंडामेंटली स्ट्रांग कंपनीज"
    },
    {
      "subtitle_id": 315,
      "start": 683.16,
      "end": 687.24,
      "text": "देखो जिसके कैश फ्लोज अच्छे हैं जिनकी"
    },
    {
      "subtitle_id": 316,
      "start": 684.8,
      "end": 689.399,
      "text": "बिजनेस मॉडल अच्छे हैं और ऐसी ढेरों सारी"
    },
    {
      "subtitle_id": 317,
      "start": 687.24,
      "end": 690.92,
      "text": "कंपनीज आपको मार्केट में मिल जाएगी तो"
    },
    {
      "subtitle_id": 318,
      "start": 689.399,
      "end": 693.519,
      "text": "फिलहाल हम यहीं पर रुकते हैं आशा करता है"
    },
    {
      "subtitle_id": 319,
      "start": 690.92,
      "end": 694.959,
      "text": "कि काफी कुछ आपको इंटरेस्टिंग चीजें माथ"
    },
    {
      "subtitle_id": 320,
      "start": 693.519,
      "end": 697.48,
      "text": "के बारे में सीखने मिली हो और यह"
    },
    {
      "subtitle_id": 321,
      "start": 694.959,
      "end": 699.16,
      "text": "लर्निंग्स अपने पास ही मत रखिए अपने"
    },
    {
      "subtitle_id": 322,
      "start": 697.48,
      "end": 700.839,
      "text": "दोस्तों के साथ अपने बाकी इन्वेस्टर"
    },
    {
      "subtitle_id": 323,
      "start": 699.16,
      "end": 703.279,
      "text": "साथियों के साथ भी शेयर कीजिए इस वीडियो"
    },
    {
      "subtitle_id": 324,
      "start": 700.839,
      "end": 705.0,
      "text": "को ज्यादा से ज्यादा शेयर करके और तो"
    },
    {
      "subtitle_id": 325,
      "start": 703.279,
      "end": 706.44,
      "text": "वीडियो को लाइक ज करना बिल्कुल ना भूलें"
    },
    {
      "subtitle_id": 326,
      "start": 705.0,
      "end": 708.839,
      "text": "मिलते हैं अगले वीडियो में और जाते-जाते"
    },
    {
      "subtitle_id": 327,
      "start": 706.44,
      "end": 712.079,
      "text": "हमारा एफएम बीएम जरूर चेक आउट कीजिए य एक"
    },
    {
      "subtitle_id": 328,
      "start": 708.839,
      "end": 713.72,
      "text": "बहुत ही अच्छी अपॉर्चुनिटी है आपको खुद"
    },
    {
      "subtitle_id": 329,
      "start": 712.079,
      "end": 715.399,
      "text": "बेहतर तरीके से कंपनी का वैल्यूएशन"
    },
    {
      "subtitle_id": 330,
      "start": 713.72,
      "end": 717.44,
      "text": "निकालने के लिए एक शेयर मार्केट में"
    },
    {
      "subtitle_id": 331,
      "start": 715.399,
      "end": 719.44,
      "text": "मास्टर बनने के लिए और फाइनेंस में करियर"
    },
    {
      "subtitle_id": 332,
      "start": 717.44,
      "end": 722.639,
      "text": "करने के लिए तो सी यू सून थैंक यू सो मच"
    },
    {
      "subtitle_id": 333,
      "start": 719.44,
      "end": 722.639,
      "text": "बाय बाटे"
    }
  ]
}