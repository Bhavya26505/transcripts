  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.16,
      "end": 5.279,
      "text": "व्हाट गोज अप कम्स डाउन एंड व्हाट गोज अप"
    },
    {
      "subtitle_id": 2,
      "start": 2.8,
      "end": 7.6,
      "text": "क्विकली कम्स डाउन क्विकली यानी कि जो चीज"
    },
    {
      "subtitle_id": 3,
      "start": 5.279,
      "end": 9.8,
      "text": "ऊपर जाती है वह नीचे आती है और जो चीज"
    },
    {
      "subtitle_id": 4,
      "start": 7.6,
      "end": 12.0,
      "text": "बहुत क्विकली ऊपर चली जाती है वह उतनी ही"
    },
    {
      "subtitle_id": 5,
      "start": 9.8,
      "end": 14.519,
      "text": "तेजी से नीचे चली आती है यह मैं नहीं"
    },
    {
      "subtitle_id": 6,
      "start": 12.0,
      "end": 16.72,
      "text": "न्यूटन कहते थे और मामार की जो रिसेंट"
    },
    {
      "subtitle_id": 7,
      "start": 14.519,
      "end": 19.119,
      "text": "न्यूज़ है उसे देखने के बाद लगता है कि"
    },
    {
      "subtitle_id": 8,
      "start": 16.72,
      "end": 21.439,
      "text": "न्यूटन सही कहते थे अब ये लास्ट टू लास्ट"
    },
    {
      "subtitle_id": 9,
      "start": 19.119,
      "end": 24.119,
      "text": "क्वार्टर ममरथ का जो प्रॉफिट था वोह 47"
    },
    {
      "subtitle_id": 10,
      "start": 21.439,
      "end": 26.439,
      "text": "करोड़ का था और सबको लग रहा था कि ममरथ अब"
    },
    {
      "subtitle_id": 11,
      "start": 24.119,
      "end": 29.0,
      "text": "टर्न अराउंड हो चुका है और यह बस अब ऊपर"
    },
    {
      "subtitle_id": 12,
      "start": 26.439,
      "end": 30.679,
      "text": "ही जाएगा पर हुआ उल्टा जितनी तेजी से"
    },
    {
      "subtitle_id": 13,
      "start": 29.0,
      "end": 33.52,
      "text": "लास्ट टू लास्ट क्वार्टर में प्रॉफिट बढ़ा"
    },
    {
      "subtitle_id": 14,
      "start": 30.679,
      "end": 35.48,
      "text": "था उससे ज्यादा तेजी से वो लास्ट क्वार्टर"
    },
    {
      "subtitle_id": 15,
      "start": 33.52,
      "end": 38.12,
      "text": "में गिर चुका है और प्रॉफिट की तो बात ही"
    },
    {
      "subtitle_id": 16,
      "start": 35.48,
      "end": 40.399,
      "text": "छोड़ी है सीधा ₹1 करोड़ का लॉस यहां पर"
    },
    {
      "subtitle_id": 17,
      "start": 38.12,
      "end": 42.92,
      "text": "महाभारत को हुआ है और सिर्फ प्रॉफिट ही"
    },
    {
      "subtitle_id": 18,
      "start": 40.399,
      "end": 45.44,
      "text": "नहीं रेवेन्यू भी डाउन है एंड दिस इज लाइक"
    },
    {
      "subtitle_id": 19,
      "start": 42.92,
      "end": 47.16,
      "text": "मोस्ट अलार्मिंग एंड मोस्ट क्रिटिकल थिंग"
    },
    {
      "subtitle_id": 20,
      "start": 45.44,
      "end": 49.399,
      "text": "और ये दोनों चीजें डाउन होने के बाद एक"
    },
    {
      "subtitle_id": 21,
      "start": 47.16,
      "end": 51.44,
      "text": "चीज का डाउन होना तय था और वो थी होनासा"
    },
    {
      "subtitle_id": 22,
      "start": 49.399,
      "end": 53.399,
      "text": "कंज्यूमर की शेयर प्राइस जो पिछले कुछ"
    },
    {
      "subtitle_id": 23,
      "start": 51.44,
      "end": 55.32,
      "text": "टाइम में बहुत तेजी से नीचे जा रही है और"
    },
    {
      "subtitle_id": 24,
      "start": 53.399,
      "end": 57.76,
      "text": "कुछ ऐसी वैसे नहीं स्क्रीन पर आप देखिए"
    },
    {
      "subtitle_id": 25,
      "start": 55.32,
      "end": 60.0,
      "text": "लास्ट एक हफ्ते में क्लोज टू 30 पर से यह"
    },
    {
      "subtitle_id": 26,
      "start": 57.76,
      "end": 62.199,
      "text": "स्टॉक गिर चुका है तो अगर आप मामा हो"
    },
    {
      "subtitle_id": 27,
      "start": 60.0,
      "end": 64.72,
      "text": "भतीजे हो या फिर चाचा हो अगर आपने मा"
    },
    {
      "subtitle_id": 28,
      "start": 62.199,
      "end": 67.28,
      "text": "मार्थी इन्वेस्ट किए थे तो आप अभी काफी"
    },
    {
      "subtitle_id": 29,
      "start": 64.72,
      "end": 69.56,
      "text": "संकट में हो काफी सारे लॉसेस में हो तो"
    },
    {
      "subtitle_id": 30,
      "start": 67.28,
      "end": 71.04,
      "text": "सवाल है कि अचानक ऐसा क्या हुआ कि कंपनी"
    },
    {
      "subtitle_id": 31,
      "start": 69.56,
      "end": 73.439,
      "text": "का रेवेन्यू और प्रॉफिट दोनों ने अपना"
    },
    {
      "subtitle_id": 32,
      "start": 71.04,
      "end": 75.32,
      "text": "ट्रेंड कंप्लीट चेंज कर दिया आपको अगर याद"
    },
    {
      "subtitle_id": 33,
      "start": 73.439,
      "end": 77.08,
      "text": "हो तो मामार का जब आईपीओ आया था तो उस"
    },
    {
      "subtitle_id": 34,
      "start": 75.32,
      "end": 79.08,
      "text": "आईपीओ का रिव्यू वीडियो हमने बनाया था और"
    },
    {
      "subtitle_id": 35,
      "start": 77.08,
      "end": 81.079,
      "text": "उस रिव्यू वीडियो में कुछ चीजों का हमने"
    },
    {
      "subtitle_id": 36,
      "start": 79.08,
      "end": 83.52,
      "text": "जिक्र किया था जो काफी एक रिस्क फैक्टर"
    },
    {
      "subtitle_id": 37,
      "start": 81.079,
      "end": 86.119,
      "text": "बड़े बनकर आने वाले थे महाभारत के और जो"
    },
    {
      "subtitle_id": 38,
      "start": 83.52,
      "end": 87.72,
      "text": "डर था धीरे-धीरे वही हो रहा है और एक और"
    },
    {
      "subtitle_id": 39,
      "start": 86.119,
      "end": 89.52,
      "text": "जो सबसे बड़ा कारण है जिसकी वजह से मा"
    },
    {
      "subtitle_id": 40,
      "start": 87.72,
      "end": 91.64,
      "text": "मर्थ फिलहाल प्रॉब्लम में है उसके बारे"
    },
    {
      "subtitle_id": 41,
      "start": 89.52,
      "end": 93.52,
      "text": "में ना ना कोई टर बात कर रहा है ना ही कोई"
    },
    {
      "subtitle_id": 42,
      "start": 91.64,
      "end": 95.479,
      "text": "न्यूज़ मीडिया तो अगर कोई भी उस चीज के"
    },
    {
      "subtitle_id": 43,
      "start": 93.52,
      "end": 98.439,
      "text": "बारे में बात नहीं करता है तो फिनो विश"
    },
    {
      "subtitle_id": 44,
      "start": 95.479,
      "end": 100.52,
      "text": "जरूर करता है क्योंकि फिश परम हमेशा प्योर"
    },
    {
      "subtitle_id": 45,
      "start": 98.439,
      "end": 103.079,
      "text": "रिसर्च बेस्ड वीडियोस लाते रहते हैं और"
    },
    {
      "subtitle_id": 46,
      "start": 100.52,
      "end": 105.28,
      "text": "ऐसे कुछ चीजें आपके सामने रखते हैं जो"
    },
    {
      "subtitle_id": 47,
      "start": 103.079,
      "end": 107.079,
      "text": "नॉर्मली जिसकी कोई बात नहीं कर रहा है ना"
    },
    {
      "subtitle_id": 48,
      "start": 105.28,
      "end": 108.68,
      "text": "ही नॉर्मली वो चीजें आपको दिख रही है"
    },
    {
      "subtitle_id": 49,
      "start": 107.079,
      "end": 110.88,
      "text": "रिसेंटली एशन पेंट के बारे में भी काफी"
    },
    {
      "subtitle_id": 50,
      "start": 108.68,
      "end": 113.84,
      "text": "अच्छी केस स्टडीज हमने बनाई थी जिसको काफी"
    },
    {
      "subtitle_id": 51,
      "start": 110.88,
      "end": 113.84,
      "text": "अच्छा रिस्पांस मिल रहा है"
    },
    {
      "subtitle_id": 52,
      "start": 115.64,
      "end": 119.68,
      "text": "डीमार्सियन गया है और बहुत ही शॉकिंग"
    },
    {
      "subtitle_id": 53,
      "start": 118.079,
      "end": 121.6,
      "text": "चीजें आज हम आपके सामने रिवील करने वाले"
    },
    {
      "subtitle_id": 54,
      "start": 119.68,
      "end": 123.759,
      "text": "हैं पर होता यह है कि इन सबको लगता है"
    },
    {
      "subtitle_id": 55,
      "start": 121.6,
      "end": 126.32,
      "text": "काफी सारा टाइम लेकिन जब हम आपके कमेंट्स"
    },
    {
      "subtitle_id": 56,
      "start": 123.759,
      "end": 127.799,
      "text": "पढ़ते हैं लाइक्स के नंबर देखते हैं तो"
    },
    {
      "subtitle_id": 57,
      "start": 126.32,
      "end": 130.44,
      "text": "हमें वो सेटिस्फेक्शन मिल जाता है कि जो"
    },
    {
      "subtitle_id": 58,
      "start": 127.799,
      "end": 132.76,
      "text": "भी मेहनत हमने करी थी उसका जो आउटपुट है"
    },
    {
      "subtitle_id": 59,
      "start": 130.44,
      "end": 134.64,
      "text": "वह अब मिल रहा है तो हमारी बस आपसे एक ही"
    },
    {
      "subtitle_id": 60,
      "start": 132.76,
      "end": 136.36,
      "text": "गुजारिश है कि मेक श्यर कीजिए कि आपने"
    },
    {
      "subtitle_id": 61,
      "start": 134.64,
      "end": 138.0,
      "text": "चैनल को सब्सक्राइब किया हो अगर नहीं किया"
    },
    {
      "subtitle_id": 62,
      "start": 136.36,
      "end": 139.8,
      "text": "है तो नीचे दिए गए सब्सक्राइब बटन पर"
    },
    {
      "subtitle_id": 63,
      "start": 138.0,
      "end": 141.56,
      "text": "क्लिक कीजिए और बेल आइकन पर भी क्लिक"
    },
    {
      "subtitle_id": 64,
      "start": 139.8,
      "end": 144.12,
      "text": "कीजिए ताकि इसी तरह के इन डेप्थ ओरिजिनल"
    },
    {
      "subtitle_id": 65,
      "start": 141.56,
      "end": 146.08,
      "text": "रिसर्च आपके सामने आते रहे तो चलिए फेस"
    },
    {
      "subtitle_id": 66,
      "start": 144.12,
      "end": 147.76,
      "text": "वॉश से मुंह धोकर वीडियो की शुरुआत करते"
    },
    {
      "subtitle_id": 67,
      "start": 146.08,
      "end": 150.12,
      "text": "हैं वीडियो में आगे बढ़ने से पहले आपको"
    },
    {
      "subtitle_id": 68,
      "start": 147.76,
      "end": 151.959,
      "text": "बता दूं कि हमारी एफएमवीए यानी फाइनेंशियल"
    },
    {
      "subtitle_id": 69,
      "start": 150.12,
      "end": 153.599,
      "text": "एंड वैल्युएशन मेंटरशिप की बैच दिसंबर से"
    },
    {
      "subtitle_id": 70,
      "start": 151.959,
      "end": 155.2,
      "text": "शुरू हो रही है अगर आपको फाइनेंस में बहुत"
    },
    {
      "subtitle_id": 71,
      "start": 153.599,
      "end": 157.319,
      "text": "डिटेल में जाकर ये चेक करना है कि कंपनी"
    },
    {
      "subtitle_id": 72,
      "start": 155.2,
      "end": 159.319,
      "text": "के फाइनेंशियल्स आगे चलकर कैसे परफॉर्म"
    },
    {
      "subtitle_id": 73,
      "start": 157.319,
      "end": 161.159,
      "text": "करेंगे आने वाले टाइम में कंपनी की ग्रोथ"
    },
    {
      "subtitle_id": 74,
      "start": 159.319,
      "end": 163.2,
      "text": "किस तरह से होगी उसकी फाइनेंशियल मॉडलिंग"
    },
    {
      "subtitle_id": 75,
      "start": 161.159,
      "end": 165.12,
      "text": "फिर कैसे करनी है और उसके बेसिस पर उसका"
    },
    {
      "subtitle_id": 76,
      "start": 163.2,
      "end": 167.159,
      "text": "डीसीएफ मेथड से यानी डिस्काउंटेड कैशफ्लो"
    },
    {
      "subtitle_id": 77,
      "start": 165.12,
      "end": 168.72,
      "text": "मेथड से वैल्युएशन निकाल के कैसे पता करें"
    },
    {
      "subtitle_id": 78,
      "start": 167.159,
      "end": 170.08,
      "text": "कि कंपनी अंडर वैल्यूड है या फिर ओवर"
    },
    {
      "subtitle_id": 79,
      "start": 168.72,
      "end": 171.92,
      "text": "वैल्यूड तो ये सारी चीजें सीखने की"
    },
    {
      "subtitle_id": 80,
      "start": 170.08,
      "end": 173.76,
      "text": "अपॉर्चुनिटी अभी आपके पास है तीन महीने की"
    },
    {
      "subtitle_id": 81,
      "start": 171.92,
      "end": 175.159,
      "text": "ये वीकेंड बैच चलती है जिसके बाद आखिरी"
    },
    {
      "subtitle_id": 82,
      "start": 173.76,
      "end": 176.48,
      "text": "चंद सीटें बची है तो अभी नीचे"
    },
    {
      "subtitle_id": 83,
      "start": 175.159,
      "end": 179.159,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में दी गई"
    },
    {
      "subtitle_id": 84,
      "start": 176.48,
      "end": 179.159,
      "text": "लिंक पर क्लिक करके"
    },
    {
      "subtitle_id": 85,
      "start": 179.8,
      "end": 183.519,
      "text": "काउंसलिंग सेशन की लिंक मिल जाएगी सो डोंट"
    },
    {
      "subtitle_id": 86,
      "start": 181.72,
      "end": 185.2,
      "text": "मिस आउट ऑन दिस अपॉर्चुनिटी आपके सारे"
    },
    {
      "subtitle_id": 87,
      "start": 183.519,
      "end": 187.799,
      "text": "डाउट्स उस काउंसलिंग सेशन में क्लियर हो"
    },
    {
      "subtitle_id": 88,
      "start": 185.2,
      "end": 190.04,
      "text": "जाएंगे फॉर्म की लिंक नीचे दी गई है और"
    },
    {
      "subtitle_id": 89,
      "start": 187.799,
      "end": 192.04,
      "text": "प्रॉब्लम की जड़ समझनी है तो मामा अर्थ की"
    },
    {
      "subtitle_id": 90,
      "start": 190.04,
      "end": 193.68,
      "text": "थोड़ी शुरुआत की बातें हमें करनी पड़ेगी"
    },
    {
      "subtitle_id": 91,
      "start": 192.04,
      "end": 195.64,
      "text": "तो जनरली क्या होता है कि मोस्ट ऑफ द"
    },
    {
      "subtitle_id": 92,
      "start": 193.68,
      "end": 197.599,
      "text": "ट्रेडिशनल ब्यूटी प्रोडक्ट्स जो होते हैं"
    },
    {
      "subtitle_id": 93,
      "start": 195.64,
      "end": 199.36,
      "text": "वो एक फिक्स सप्लाई चेन में काम करते हैं"
    },
    {
      "subtitle_id": 94,
      "start": 197.599,
      "end": 200.879,
