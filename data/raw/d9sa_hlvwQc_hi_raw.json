  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.16,
      "end": 4.48,
      "text": "जैसे आंधी आती है और सब कुछ बदल कर रख"
    },
    {
      "subtitle_id": 2,
      "start": 2.36,
      "end": 6.6,
      "text": "देती है उसी तरह बिजनेस वर्ल्ड में भी कुछ"
    },
    {
      "subtitle_id": 3,
      "start": 4.48,
      "end": 8.599,
      "text": "ऐसे ब्रांड्स आते हैं जो पूरी इंडस्ट्री"
    },
    {
      "subtitle_id": 4,
      "start": 6.6,
      "end": 10.679,
      "text": "को बदल कर रख देते हैं और रिसेंट टाइम में"
    },
    {
      "subtitle_id": 5,
      "start": 8.599,
      "end": 12.639,
      "text": "अगर एक आंधी वाली ब्रांड आई है तो वो है"
    },
    {
      "subtitle_id": 6,
      "start": 10.679,
      "end": 14.759,
      "text": "ट्रेंट ट्रेंट आया और पूरी इंडस्ट्री के"
    },
    {
      "subtitle_id": 7,
      "start": 12.639,
      "end": 16.52,
      "text": "डायनामिक्स बदल गए और वही ट्रेंट लिमिटेड"
    },
    {
      "subtitle_id": 8,
      "start": 14.759,
      "end": 19.56,
      "text": "की शेयर प्राइस की बात करें तो 2 साल पहले"
    },
    {
      "subtitle_id": 9,
      "start": 16.52,
      "end": 22.48,
      "text": "1300 टू 1400 की रेंज में वो रहा करता था"
    },
    {
      "subtitle_id": 10,
      "start": 19.56,
      "end": 25.119,
      "text": "जो आज 7000 तक पहुंच गया है यानी कि सिर्फ"
    },
    {
      "subtitle_id": 11,
      "start": 22.48,
      "end": 28.48,
      "text": "2 साल में स्टॉक ने 500 पर के रिटर्न्स"
    },
    {
      "subtitle_id": 12,
      "start": 25.119,
      "end": 30.56,
      "text": "दिए हैं और 5 साल में मोर दन 1200 पर के"
    },
    {
      "subtitle_id": 13,
      "start": 28.48,
      "end": 32.16,
      "text": "रिटर्न्स तो सवाल यह है कि ऐसा क्या हुआ"
    },
    {
      "subtitle_id": 14,
      "start": 30.56,
      "end": 34.399,
      "text": "कि ट्रेंड की शेयर प्राइस इतनी तेजी से"
    },
    {
      "subtitle_id": 15,
      "start": 32.16,
      "end": 36.48,
      "text": "बढ़ गई और साथ में बड़ा सवाल यह भी है कि"
    },
    {
      "subtitle_id": 16,
      "start": 34.399,
      "end": 39.8,
      "text": "क्या ये मोमेंटम आने वाले टाइम में भी ऐसा"
    },
    {
      "subtitle_id": 17,
      "start": 36.48,
      "end": 41.879,
      "text": "ही बना रहेगा या फिर ट्रेंड के साथ यह भी"
    },
    {
      "subtitle_id": 18,
      "start": 39.8,
      "end": 43.44,
      "text": "बदलता चला जाएगा तो इन सारी चीजों पर और"
    },
    {
      "subtitle_id": 19,
      "start": 41.879,
      "end": 45.44,
      "text": "कंपनी के फ्यूचर के बारे में डिटेल"
    },
    {
      "subtitle_id": 20,
      "start": 43.44,
      "end": 47.239,
      "text": "एनालिसिस करेंगे आज के इस वीडियो में"
    },
    {
      "subtitle_id": 21,
      "start": 45.44,
      "end": 49.079,
      "text": "नमस्कार मैं प्रसाद आपका आज के इस वीडियो"
    },
    {
      "subtitle_id": 22,
      "start": 47.239,
      "end": 51.16,
      "text": "में स्वागत करता हूं मैं आपसे पूछूं कि"
    },
    {
      "subtitle_id": 23,
      "start": 49.079,
      "end": 52.64,
      "text": "ट्रेंड का नाम आपने पहली बार कब सुना तो"
    },
    {
      "subtitle_id": 24,
      "start": 51.16,
      "end": 54.68,
      "text": "आप में से बहुत सारे लोग कहेंगे कि पिछले"
    },
    {
      "subtitle_id": 25,
      "start": 52.64,
      "end": 56.28,
      "text": "एक दो साल में इसका नाम सुना है इसलिए"
    },
    {
      "subtitle_id": 26,
      "start": 54.68,
      "end": 58.84,
      "text": "बहुत सारे लोगों को लगता है कि ये एक बहुत"
    },
    {
      "subtitle_id": 27,
      "start": 56.28,
      "end": 61.84,
      "text": "ही नई कंपनी है लेकिन अगर आप ऐसा सोच रहे"
    },
    {
      "subtitle_id": 28,
      "start": 58.84,
      "end": 64.08,
      "text": "हो तो आप बिल्कुल गलत हो 27 साल पुरानी यह"
    },
    {
      "subtitle_id": 29,
      "start": 61.84,
      "end": 65.88,
      "text": "कंपनी है जिसकी शुरुआत बड़ी ही अमेजिंग"
    },
    {
      "subtitle_id": 30,
      "start": 64.08,
      "end": 68.2,
      "text": "तरीके से हुई थी जैसे कि हमें पता है कि"
    },
    {
      "subtitle_id": 31,
      "start": 65.88,
      "end": 70.6,
      "text": "ट्रेंट फैशन और लाइफस्टाइल स्टोर्स जैसे"
    },
    {
      "subtitle_id": 32,
      "start": 68.2,
      "end": 72.84,
      "text": "कि वेस्ट साइड और जडियो ऑपरेट और ओन करते"
    },
    {
      "subtitle_id": 33,
      "start": 70.6,
      "end": 75.68,
      "text": "हैं बट ट्रेंट हैज कम अ लॉन्ग वे लेट्स"
    },
    {
      "subtitle_id": 34,
      "start": 72.84,
      "end": 77.52,
      "text": "टेक अ डाइव ऑन हाउ इट ऑल स्टार्टेड 1998"
    },
    {
      "subtitle_id": 35,
      "start": 75.68,
      "end": 79.72,
      "text": "की बात है लैक में तो सभी को पता है"
    },
    {
      "subtitle_id": 36,
      "start": 77.52,
      "end": 82.0,
      "text": "कॉस्मेटिक में काफी बड़ा नाम है तो टा"
    },
    {
      "subtitle_id": 37,
      "start": 79.72,
      "end": 83.96,
      "text": "ग्रुप का उसमें 50 पर स्टेक था और बचा हुआ"
    },
    {
      "subtitle_id": 38,
      "start": 82.0,
      "end": 86.439,
      "text": "50 पर स्टेक उसकी पेनेंट कंपनी जो थी"
    },
    {
      "subtitle_id": 39,
      "start": 83.96,
      "end": 88.32,
      "text": "फ्रांस की उसका था तो 1998 में टाटा ग्रुप"
    },
    {
      "subtitle_id": 40,
      "start": 86.439,
      "end": 90.079,
      "text": "ने डिसाइड किया कि वो अपना पूरा 50 पर"
    },
    {
      "subtitle_id": 41,
      "start": 88.32,
      "end": 92.68,
      "text": "स्टेक हिंदुस्तान यूनिलीवर को बेज बेच"
    },
    {
      "subtitle_id": 42,
      "start": 90.079,
      "end": 94.84,
      "text": "देंगे ₹ करोड़ में अब टाटा ग्रुप के पास"
    },
    {
      "subtitle_id": 43,
      "start": 92.68,
      "end": 96.079,
      "text": "ये जो 200 करोड़ आए लैक में बेचकर इसका"
    },
    {
      "subtitle_id": 44,
      "start": 94.84,
      "end": 97.64,
      "text": "उन्होंने क्या किया तो बड़े ही"
    },
    {
      "subtitle_id": 45,
      "start": 96.079,
      "end": 100.159,
      "text": "इंटरेस्टिंग तरीके से उन्होंने इस पैसों"
    },
    {
      "subtitle_id": 46,
      "start": 97.64,
      "end": 102.479,
      "text": "को ट्रेंड शुरू करने के लिए इस्तेमाल किया"
    },
    {
      "subtitle_id": 47,
      "start": 100.159,
      "end": 104.88,
      "text": "तो इस तरह से ट्रेंड की शुरुआत हुई है लकम"
    },
    {
      "subtitle_id": 48,
      "start": 102.479,
      "end": 106.68,
      "text": "के सेल से ट्रें के झडियो और वेस्ट साइड"
    },
    {
      "subtitle_id": 49,
      "start": 104.88,
      "end": 108.28,
      "text": "के बारे में सभी को पता ही है पर ट्रेंट"
    },
    {
      "subtitle_id": 50,
      "start": 106.68,
      "end": 110.52,
      "text": "एक सुपर मार्केट चेन भी चलाता है जिसका"
    },
    {
      "subtitle_id": 51,
      "start": 108.28,
      "end": 113.2,
      "text": "नाम है स्टार मार्केट तो सवाल ये है कि"
    },
    {
      "subtitle_id": 52,
      "start": 110.52,
      "end": 115.479,
      "text": "ऐसा क्या हुआ कि 27 साल पुरानी कंपनी की"
    },
    {
      "subtitle_id": 53,
      "start": 113.2,
      "end": 117.159,
      "text": "बातें नाम हमें पिछले कुछ सालों में सुनाई"
    },
    {
      "subtitle_id": 54,
      "start": 115.479,
      "end": 118.759,
      "text": "दे रहा है और बहुत ज्यादा मात्रा में"
    },
    {
      "subtitle_id": 55,
      "start": 117.159,
      "end": 120.2,
      "text": "सुनाई दे रहा है और सिर्फ बातें ही नहीं"
    },
    {
      "subtitle_id": 56,
      "start": 118.759,
      "end": 122.119,
      "text": "पिछले दो-तीन सालों में कंपनी ने"
    },
    {
      "subtitle_id": 57,
      "start": 120.2,
      "end": 123.92,
      "text": "मल्टीबैगर रिटर्न्स दिए हैं तो ऐसा क्या"
    },
    {
      "subtitle_id": 58,
      "start": 122.119,
      "end": 125.759,
      "text": "हुआ क्योंकि हम इनके नंबर्स की बात करें"
    },
    {
      "subtitle_id": 59,
      "start": 123.92,
      "end": 127.64,
      "text": "तो रेवेन्यू और नेट प्रॉफिट दोनों ही बहुत"
    },
    {
      "subtitle_id": 60,
      "start": 125.759,
      "end": 130.56,
      "text": "ज्यादा बढे हैं और जैसे कि आप देख सकते हो"
    },
    {
      "subtitle_id": 61,
      "start": 127.64,
      "end": 133.76,
      "text": "कि 2022 के अराउंड इनका रेवेन्यू 4500"
    },
    {
      "subtitle_id": 62,
      "start": 130.56,
      "end": 136.4,
      "text": "करोड़ का था जो 2023 में डबल होकर 8200"
    },
    {
      "subtitle_id": 63,
      "start": 133.76,
      "end": 139.08,
      "text": "करोड़ हो गया अगेन 2024 में वो 50 पर से"
    },
    {
      "subtitle_id": 64,
      "start": 136.4,
      "end": 140.72,
      "text": "बढ़कर 12000 करोड़ पर चला गया है और सिर्फ"
    },
    {
      "subtitle_id": 65,
      "start": 139.08,
      "end": 142.84,
      "text": "रेवेन्यू की बात नहीं आप नेट प्रॉफिट देख"
    },
    {
      "subtitle_id": 66,
      "start": 140.72,
      "end": 145.599,
      "text": "लीजिए कंपनी का नेट प्रॉफिट पिछले 1 साल"
    },
    {
      "subtitle_id": 67,
      "start": 142.84,
      "end": 148.8,
      "text": "में ही चार गुना बढ़ा है 2023 में ये 310"
    },
    {
      "subtitle_id": 68,
      "start": 145.599,
      "end": 151.68,
      "text": "करोड़ था 310 करोड़ जो कि अभी 2024 में"
    },
    {
      "subtitle_id": 69,
      "start": 148.8,
      "end": 154.0,
      "text": "1250 3 करोड़ का हो चुका है और यह एक बहुत"
    },
    {
      "subtitle_id": 70,
      "start": 151.68,
      "end": 156.879,
      "text": "बड़ी बात है ऐसी कंपनी के लिए जो 2020 में"
    },
    {
      "subtitle_id": 71,
      "start": 154.0,
      "end": 158.72,
      "text": "हार्डली ₹1 करोड़ कमाती थी तो पिक्चर बड़ी"
    },
    {
      "subtitle_id": 72,
      "start": 156.879,
      "end": 160.48,
      "text": "क्लियर है कि बहुत ही क्रेजी ग्रोथ हो रही"
    },
    {
      "subtitle_id": 73,
      "start": 158.72,
      "end": 162.28,
      "text": "है रेवेन्यू और नेट प्रॉफिट दोनों में"
    },
    {
      "subtitle_id": 74,
      "start": 160.48,
      "end": 164.36,
      "text": "जिसके चलते कंपनी की शेयर प्राइस भी बहुत"
    },
    {
      "subtitle_id": 75,
      "start": 162.28,
      "end": 166.28,
      "text": "तेजी से बढ़ रही है ट्रेंड के सक्सेस के"
    },
    {
      "subtitle_id": 76,
      "start": 164.36,
      "end": 168.64,
      "text": "पीछे एक बिहेवियरल चेंज का बहुत बड़ा"
    },
    {
      "subtitle_id": 77,
      "start": 166.28,
      "end": 170.56,
      "text": "फैक्टर है अब यह बिहेवियरल चेंज क्या है"
    },
    {
      "subtitle_id": 78,
      "start": 168.64,
      "end": 172.959,
      "text": "तो आज के अगर आप नौजवान यंगस्टर्स को"
    },
    {
      "subtitle_id": 79,
      "start": 170.56,
      "end": 175.04,
      "text": "देखेंगे तो यह लोग क्या करते हैं कि पहले"
    },
    {
      "subtitle_id": 80,
      "start": 172.959,
      "end": 177.239,
      "text": "के जमाने में क्या होता था कपड़े लिए 2"
    },
    {
      "subtitle_id": 81,
      "start": 175.04,
      "end": 179.84,
      "text": "साल 3 साल आराम से उसको यूज किया फिर सोच"
    },
    {
      "subtitle_id": 82,
      "start": 177.239,
      "end": 182.0,
      "text": "समझकर नए कपड़े लिए लेकिन आज के जो यंग"
    },
    {
      "subtitle_id": 83,
      "start": 179.84,
      "end": 184.12,
      "text": "स्टर्स हैं उनके लिए ऐसा है कि अगर यह आज"
    },
    {
      "subtitle_id": 84,
      "start": 182.0,
      "end": 185.68,
      "text": "कपड़े लेते हैं तो 6-7 महीने में उन्हें"
    },
    {
      "subtitle_id": 85,
      "start": 184.12,
      "end": 187.44,
      "text": "लगता है कि कपड़े पुराने हो गए ओल्ड"
    },
    {
      "subtitle_id": 86,
      "start": 185.68,
      "end": 189.56,
      "text": "स्टाइल हो गए हैं यह तुरंत नए कपड़ों की"
    },
    {
      "subtitle_id": 87,
      "start": 187.44,
      "end": 191.599,
      "text": "तरफ बढ़ते हैं और पर्टिकुलर अगर जेंज की"
    },
    {
      "subtitle_id": 88,
      "start": 189.56,
      "end": 194.319,
      "text": "बात करें तो इनका तो ऐसा है कि कोई कपड़ा"
    },
    {
      "subtitle_id": 89,
      "start": 191.599,
      "end": 196.08,
      "text": "लिया शर्ट लिया पैंट लिया एक बार दो बार"
    },
    {
      "subtitle_id": 90,
      "start": 194.319,
      "end": 198.12,
      "text": "यूज किया उसके बाद ये लोग यूज नहीं करते"
    },
    {
      "subtitle_id": 91,
      "start": 196.08,
      "end": 200.239,
      "text": "हैं दूसरे कपड़े ले लेते हैं और इस"
    },
    {
      "subtitle_id": 92,
      "start": 198.12,
      "end": 202.36,
      "text": "बिहेवियर को अगर सबसे पहले अगर किसी कंपनी"
    },
    {
      "subtitle_id": 93,
      "start": 200.239,
      "end": 204.64,
      "text": "ने बड़ी मात्रा में टैप किया तो वो थी"
    },
    {
      "subtitle_id": 94,
      "start": 202.36,
      "end": 206.799,
      "text": "जारा उन्होंने वेस्ट में देखा कि यह"
    },
    {
      "subtitle_id": 95,
      "start": 204.64,
      "end": 208.64,
