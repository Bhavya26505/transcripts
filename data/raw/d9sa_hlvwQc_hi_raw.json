      "start": 651.8,
      "end": 656.56,
      "text": "एक्सपेंडिंग द स्टोर्स वगैरह वगैरह लेकिन"
    },
    {
      "subtitle_id": 288,
      "start": 653.68,
      "end": 658.519,
      "text": "एक पोजीशन ही ऐसी आई है एक स्केल ही कंपनी"
    },
    {
      "subtitle_id": 289,
      "start": 656.56,
      "end": 661.04,
      "text": "का इतना बड़ा हो गया है कि यहां से अगेन"
    },
    {
      "subtitle_id": 290,
      "start": 658.519,
      "end": 662.839,
      "text": "डबल होना इज वेरी टफ स ऑफकोर्स थोड़े"
    },
    {
      "subtitle_id": 291,
      "start": 661.04,
      "end": 664.279,
      "text": "एक्सपेंसिव लेवल्स है लेकिन अगर कोई एंटर"
    },
    {
      "subtitle_id": 292,
      "start": 662.839,
      "end": 665.92,
      "text": "कर रहा है तो आपको मेक श्यर करना पड़ेगा"
    },
    {
      "subtitle_id": 293,
      "start": 664.279,
      "end": 668.68,
      "text": "कि कंपनी बहुत तेजी से यहां से बढ़े ही"
    },
    {
      "subtitle_id": 294,
      "start": 665.92,
      "end": 670.959,
      "text": "बढ़े लेकिन अगर वो नहीं बढ़ती है 8090 पर"
    },
    {
      "subtitle_id": 295,
      "start": 668.68,
      "end": 672.88,
      "text": "की स्पीड से यहां से एनुअली तो फिर आपके"
    },
    {
      "subtitle_id": 296,
      "start": 670.959,
      "end": 674.44,
      "text": "लिए बहुत बड़ी प्रॉब्लम क्रिएट हो सकती है"
    },
    {
      "subtitle_id": 297,
      "start": 672.88,
      "end": 675.959,
      "text": "तो जो भी डिसीजन लेना है उसके लिए कंपनी"
    },
    {
      "subtitle_id": 298,
      "start": 674.44,
      "end": 677.92,
      "text": "के क्वार्टरली रिजल्ट्स आप चेक कीजिए"
    },
    {
      "subtitle_id": 299,
      "start": 675.959,
      "end": 679.44,
      "text": "पिछले तीन क्वार्टर से अच्छे नहीं है"
    },
    {
      "subtitle_id": 300,
      "start": 677.92,
      "end": 681.519,
      "text": "दिसंबर क्वार्टर का रिजल्ट भी अभी थोड़े"
    },
    {
      "subtitle_id": 301,
      "start": 679.44,
      "end": 683.88,
      "text": "टाइम में आ ही जाएगा जनवरी के मिड तक तो"
    },
    {
      "subtitle_id": 302,
      "start": 681.519,
      "end": 685.639,
      "text": "उसे देखिए और कंपनी के कॉन कॉल भी सुनिए"
    },
    {
      "subtitle_id": 303,
      "start": 683.88,
      "end": 687.56,
      "text": "कि कंपनी के क्या प्लांस है किस स्पीड से"
    },
    {
      "subtitle_id": 304,
      "start": 685.639,
      "end": 689.399,
      "text": "कंपनी बढ़ सकती है कंपनी का मैनेजमेंट भी"
    },
    {
      "subtitle_id": 305,
      "start": 687.56,
      "end": 691.44,
      "text": "इसके बारे में कुछ नंबर्स बताते हैं तो तो"
    },
    {
      "subtitle_id": 306,
      "start": 689.399,
      "end": 693.959,
      "text": "वो सारी चीजें देखकर आप एक डिसीजन ले सकते"
    },
    {
      "subtitle_id": 307,
      "start": 691.44,
      "end": 695.6,
      "text": "हो तो ऑफकोर्स कंपनी विल ग्रो 3040 पर की"
    },
    {
      "subtitle_id": 308,
      "start": 693.959,
      "end": 698.0,
      "text": "ग्रोथ कंपनी के लिए उतनी टफ नहीं होगी"
    },
    {
      "subtitle_id": 309,
      "start": 695.6,
      "end": 699.639,
      "text": "लेकिन करंट जो वैल्युएशन है वो 30-40 पर"
    },
    {
      "subtitle_id": 310,
      "start": 698.0,
      "end": 701.72,
      "text": "की ग्रोथ के हिसाब से तो मुझे ज्यादा लग"
    },
    {
      "subtitle_id": 311,
      "start": 699.639,
      "end": 703.959,
      "text": "रहा है अब आपका क्या कहना है इस पर नीचे"
    },
    {
      "subtitle_id": 312,
      "start": 701.72,
      "end": 705.519,
      "text": "कमेंट करके जरूर बताइए तो क्या आप ट्रेंट"
    },
    {
      "subtitle_id": 313,
      "start": 703.959,
      "end": 707.279,
      "text": "में इन्वेस्टेड हैं ऑलरेडी आपने इन्वेस्ट"
    },
    {
      "subtitle_id": 314,
      "start": 705.519,
      "end": 708.839,
      "text": "किया था दो-तीन साल पहले अगर किया होगा तो"
    },
    {
      "subtitle_id": 315,
      "start": 707.279,
      "end": 710.8,
      "text": "कमेंट करके जरूर बताइए कि क्यों आपने"
    },
    {
      "subtitle_id": 316,
      "start": 708.839,
      "end": 712.839,
      "text": "सिलेक्ट किया था उस टाइम आपको क्या लगा था"
    },
    {
      "subtitle_id": 317,
      "start": 710.8,
      "end": 714.6,
      "text": "और कौन सा आपका एंट्री पॉइंट था तो फिलहाल"
    },
    {
      "subtitle_id": 318,
      "start": 712.839,
      "end": 716.04,
      "text": "हम यही प्रते हैं आशा करते हैं कि सारी"
    },
    {
      "subtitle_id": 319,
      "start": 714.6,
      "end": 717.76,
      "text": "चीजें आपके लिए क्रिस्टल क्लियर हो गई"
    },
    {
      "subtitle_id": 320,
      "start": 716.04,
      "end": 719.519,
      "text": "होगी नेक्स्ट वीडियो किस कंपनी पर बनाए"
    },
    {
      "subtitle_id": 321,
      "start": 717.76,
      "end": 721.24,
      "text": "नीचे कमेंट करके जरूर बताएं क्योंकि यह भी"
    },
    {
      "subtitle_id": 322,
      "start": 719.519,
      "end": 723.519,
      "text": "वीडियो का जो टॉपिक है वो आपके ही कमेंट"
    },
    {
      "subtitle_id": 323,
      "start": 721.24,
      "end": 725.399,
      "text": "के सजेशन से हमने लिया है जो कि हम जनरली"
    },
    {
      "subtitle_id": 324,
      "start": 723.519,
      "end": 729.959,
      "text": "करते रहते हैं सो मिलते हैं जल्द थैंक यू"
    },
    {
      "subtitle_id": 325,
      "start": 725.399,
      "end": 729.959,
      "text": "सो मच फॉर वाचिंग दिस टेक केयर बाय बाय"
    }
  ]
}