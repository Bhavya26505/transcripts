  "parsing_issues": [],
  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.08,
      "end": 5.04,
      "text": "व्हाट्स इन द नेम? आंसर इज एवरीथिंग। यह"
    },
    {
      "subtitle_id": 2,
      "start": 2.8,
      "end": 6.96,
      "text": "लाइन इस कंपनी पर बिल्कुल लागू होती है।"
    },
    {
      "subtitle_id": 3,
      "start": 5.04,
      "end": 8.96,
      "text": "क्योंकि जिस कंपनी की आज हम बात करने वाले"
    },
    {
      "subtitle_id": 4,
      "start": 6.96,
      "end": 10.719,
      "text": "हैं, इनके साथ जो किस्सा हुआ है, मैंने"
    },
    {
      "subtitle_id": 5,
      "start": 8.96,
      "end": 12.719,
      "text": "भाई जिंदगी भर में ऐसा किस्सा नहीं सुना"
    },
    {
      "subtitle_id": 6,
      "start": 10.719,
      "end": 14.719,
      "text": "है। एक अच्छी खासी कंपनी थी, अच्छी खासी"
    },
    {
      "subtitle_id": 7,
      "start": 12.719,
      "end": 16.4,
      "text": "स्पीड से चल रही थी। फंडिंग भी अच्छी खासी"
    },
    {
      "subtitle_id": 8,
      "start": 14.719,
      "end": 18.56,
      "text": "इनको मिली थी। फिर कुछ ऐसा होता है कि"
    },
    {
      "subtitle_id": 9,
      "start": 16.4,
      "end": 20.16,
      "text": "इनकी सेल्स सीधी जीरो हो जाती है। और ऐसा"
    },
    {
      "subtitle_id": 10,
      "start": 18.56,
      "end": 22.08,
      "text": "नहीं कि ये कस्टमर को इनके प्रोडक्ट सही"
    },
    {
      "subtitle_id": 11,
      "start": 20.16,
      "end": 24.4,
      "text": "नहीं लगे। तो रीज़न बिल्कुल ही यूनिक है और"
    },
    {
      "subtitle_id": 12,
      "start": 22.08,
      "end": 26.4,
      "text": "मुझे नहीं लगता कि दुनिया भर में किसी भी"
    },
    {
      "subtitle_id": 13,
      "start": 24.4,
      "end": 28.56,
      "text": "कंट्री में इस तरह से कंपनी कोई फेल हो"
    },
    {
      "subtitle_id": 14,
      "start": 26.4,
      "end": 30.64,
      "text": "सकती है। दिस इज वेरी यूनिक टू इंडिया। तो"
    },
    {
      "subtitle_id": 15,
      "start": 28.56,
      "end": 32.559,
      "text": "बात हो रही है बीरा 91 जो कि एक बियर"
    },
    {
      "subtitle_id": 16,
      "start": 30.64,
      "end": 34.559,
      "text": "ब्रांड है। तो अगर आप पीने का शौक रखते"
    },
    {
      "subtitle_id": 17,
      "start": 32.559,
      "end": 36.48,
      "text": "हैं तो आपने इस ब्रांड का नाम जरूर सुना"
    },
    {
      "subtitle_id": 18,
      "start": 34.559,
      "end": 38.16,
      "text": "होगा और शायद इसे टेस्ट भी किया होगा। पर"
    },
    {
      "subtitle_id": 19,
      "start": 36.48,
      "end": 40.239,
      "text": "रिसेंट टाइम में क्या आपने एक चीज ऑब्जर्व"
    },
    {
      "subtitle_id": 20,
      "start": 38.16,
      "end": 42.079,
      "text": "की है कि bरा 91 के प्रोडक्ट्स दिखने नहीं"
    },
    {
      "subtitle_id": 21,
      "start": 40.239,
      "end": 44.32,
      "text": "मिल रहे। तो वो क्या रीज़न है जिसकी वजह से"
    },
    {
      "subtitle_id": 22,
      "start": 42.079,
      "end": 46.079,
      "text": "इतना अच्छा खासा ब्रांड आज बंद हो चुका"
    },
    {
      "subtitle_id": 23,
      "start": 44.32,
      "end": 47.84,
      "text": "है। इसी के बारे में आज के इस वीडियो में"
    },
    {
      "subtitle_id": 24,
      "start": 46.079,
      "end": 49.6,
      "text": "हम डिटेल में बात करेंगे। बड़ी यूनिक केस"
    },
    {
      "subtitle_id": 25,
      "start": 47.84,
      "end": 51.36,
      "text": "स्टडी है। जरूर सभी को सुननी चाहिए और सभी"
    },
    {
      "subtitle_id": 26,
      "start": 49.6,
      "end": 53.039,
      "text": "के साथ शेयर भी करनी चाहिए। और अगर आप"
    },
    {
      "subtitle_id": 27,
      "start": 51.36,
      "end": 54.8,
      "text": "इंडिया में बिजनेस कर रहे हो या फिर करने"
    },
    {
      "subtitle_id": 28,
      "start": 53.039,
      "end": 56.559,
      "text": "का प्लान कर रहे हो तो यह चीज आपको बहुत"
    },
    {
      "subtitle_id": 29,
      "start": 54.8,
      "end": 58.32,
      "text": "काम आएगी। बस वीडियो स्टार्ट करने से पहले"
    },
    {
      "subtitle_id": 30,
      "start": 56.559,
      "end": 60.16,
      "text": "आप सभी से रिक्वेस्ट है कि जरूर मेक श्योर"
    },
    {
      "subtitle_id": 31,
      "start": 58.32,
      "end": 61.84,
      "text": "कीजिए चैनल को आपने सब्सक्राइब किया हो और"
    },
    {
      "subtitle_id": 32,
      "start": 60.16,
      "end": 64.08,
      "text": "जॉइ बटन पर भी क्लिक करके हमारी जो"
    },
    {
      "subtitle_id": 33,
      "start": 61.84,
      "end": 65.92,
      "text": "प्रीमियम कम्युनिटी है उसे जरूर चेक आउट"
    },
    {
      "subtitle_id": 34,
      "start": 64.08,
      "end": 67.2,
      "text": "कीजिए। बहुत ही अमेजिंग चीजें वहां पर हो"
    },
    {
      "subtitle_id": 35,
      "start": 65.92,
      "end": 68.96,
      "text": "रही है। अब बड़ी बात ये है कि कंपनी"
    },
    {
      "subtitle_id": 36,
      "start": 67.2,
      "end": 70.4,
      "text": "इंडिया में शुरू कैसे हुई तो इसकी एक"
    },
    {
      "subtitle_id": 37,
      "start": 68.96,
      "end": 72.159,
      "text": "क्विक स्टोरी मैं आपको बताता हूं बहुत ही"
    },
    {
      "subtitle_id": 38,
      "start": 70.4,
      "end": 73.84,
      "text": "क्विक। देखिए इस कंपनी के फाउंडर है अंकुर"
    },
    {
      "subtitle_id": 39,
      "start": 72.159,
      "end": 76.159,
      "text": "जैन जिन्होंने 2007 में न्यूयॉर्क में"
    },
    {
      "subtitle_id": 40,
      "start": 73.84,
      "end": 77.84,
      "text": "अपनी कंपनी बेच दी और फिर एक बार ड्रिंक"
    },
    {
      "subtitle_id": 41,
      "start": 76.159,
      "end": 79.28,
      "text": "कर रहे थे तो उन्होंने देखा कि इंडिया में"
    },
    {
      "subtitle_id": 42,
      "start": 77.84,
      "end": 82.159,
      "text": "जो मोस्टली बियर्स फेमस है जैसे कि"
    },
    {
      "subtitle_id": 43,
      "start": 79.28,
      "end": 84.08,
      "text": "किंगफिशर बडवाइजर हेनीकन वगैरह वो सब हैवी"
    },
    {
      "subtitle_id": 44,
      "start": 82.159,
      "end": 86.24,
      "text": "और बिटर टेस्ट वाली बियर्स हैं। अब उनका"
    },
    {
      "subtitle_id": 45,
      "start": 84.08,
      "end": 88.159,
      "text": "यह मानना था कि जो यंगस्टर्स हैं तो शायद"
    },
    {
      "subtitle_id": 46,
      "start": 86.24,
      "end": 89.759,
      "text": "उन्हें बिटर टेस्ट की बजाय कुछ और टेस्ट"
    },
    {
      "subtitle_id": 47,
      "start": 88.159,
      "end": 91.68,
      "text": "चाहिए। तो उन्होंने सोचा कि क्यों ना एक"
    },
    {
      "subtitle_id": 48,
      "start": 89.759,
      "end": 93.759,
      "text": "स्मूथ बियर ब्रांड स्टार्ट किया जाए जो"
    },
    {
      "subtitle_id": 49,
      "start": 91.68,
      "end": 95.759,
      "text": "नॉन रेगुलर ड्रिंकर्स और यंग ऑडियंस को"
    },
    {
      "subtitle_id": 50,
      "start": 93.759,
      "end": 98.24,
      "text": "अपील करें और इसी के चलते 2015 में"
    },
    {
      "subtitle_id": 51,
      "start": 95.759,
      "end": 100.159,
      "text": "उन्होंने ल्च की बीरा 91। 91 क्या? तो"
    },
    {
      "subtitle_id": 52,
      "start": 98.24,
      "end": 102.079,
      "text": "बहुत सारी कंपनी में 91 आप देखते हो तो वो"
    },
    {
      "subtitle_id": 53,
      "start": 100.159,
      "end": 103.36,
      "text": "है इंडिया का इंटरनेशनल डाइलिंग कोड।"
    },
    {
      "subtitle_id": 54,
      "start": 102.079,
      "end": 105.2,
      "text": "लेकिन प्रॉब्लम यह था कि इंडिया में तब"
    },
    {
      "subtitle_id": 55,
      "start": 103.36,
      "end": 106.88,
      "text": "ब्रवरीज ही नहीं थी। और यह जो स्मूथ बीियर"
    },
    {
      "subtitle_id": 56,
      "start": 105.2,
      "end": 109.119,
      "text": "पिया करते थे वो न्यूयॉर्क में पिया करते"
    },
    {
      "subtitle_id": 57,
      "start": 106.88,
      "end": 110.96,
      "text": "थे। जिसे वहां पर क्राफ्ट बियर भी कहा"
    },
    {
      "subtitle_id": 58,
      "start": 109.119,
      "end": 113.52,
      "text": "जाता है। तो इसके चलते उन्होंने क्या किया"
    },
    {
      "subtitle_id": 59,
      "start": 110.96,
      "end": 115.439,
      "text": "कि अपना जो पहला बियर का जो बैच था वो"
    },
    {
      "subtitle_id": 60,
      "start": 113.52,
      "end": 117.439,
      "text": "इंडियन ब्रीवरी से नहीं बनाया बल्कि"
    },
    {
      "subtitle_id": 61,
      "start": 115.439,
      "end": 119.84,
      "text": "दुनिया की बियर कैपिटल कहे जाने वाली"
    },
    {
      "subtitle_id": 62,
      "start": 117.439,
      "end": 121.68,
      "text": "कंट्री बेल्जियम से मंगवाया। बेल्जियम की"
    },
    {
      "subtitle_id": 63,
      "start": 119.84,
      "end": 123.52,
      "text": "एक खास बात यह है कि जैसे इंडिया और बाकी"
    },
    {
      "subtitle_id": 64,
      "start": 121.68,
      "end": 125.68,
      "text": "कंट्री में यूनेस्को हेरिटेज साइट्स होती"
    },
    {
      "subtitle_id": 65,
      "start": 123.52,
      "end": 128.16,
      "text": "है। वैसे ही बेल्जियम में इनका जो बियर का"
    },
    {
      "subtitle_id": 66,
      "start": 125.68,
      "end": 131.68,
      "text": "सेंचुरीज ओल्ड कल्चर है वो लिस्टेड है एज"
    },
    {
      "subtitle_id": 67,
      "start": 128.16,
      "end": 133.68,
      "text": "अ यूनेस्कोस इनटेंजिबल कल्चरल हेरिटेज। तो"
    },
    {
      "subtitle_id": 68,
      "start": 131.68,
      "end": 135.2,
      "text": "बहुत बड़ी-बड़ी ब्ररीज वहां पर है। बहुत"
    },
    {
      "subtitle_id": 69,
      "start": 133.68,
      "end": 136.959,
      "text": "बड़े-बड़े बियर ब्रांड्स वहां पर आपको"
    },
    {
      "subtitle_id": 70,
      "start": 135.2,
      "end": 139.36,
      "text": "मिलेंगे। तो यानी इन्होंने बहुत ही फेमस"
    },
    {
      "subtitle_id": 71,
      "start": 136.959,
      "end": 142.56,
      "text": "जगह से अपना बियर का पहला बैच मंगवाया और"
    },
    {
      "subtitle_id": 72,
      "start": 139.36,
      "end": 144.56,
      "text": "2015 में बीरा 91 ल्च किया। अब हुआ यह कि"
    },
    {
      "subtitle_id": 73,
      "start": 142.56,
      "end": 146.8,
      "text": "लॉन्च होते ही जो नॉन रेगुलर ड्रिंकर्स"
    },
    {
      "subtitle_id": 74,
      "start": 144.56,
      "end": 148.64,
      "text": "थे, जो यंग ऑडियंस थी, उनके पीछे यह"
    },
    {
      "subtitle_id": 75,
      "start": 146.8,
      "end": 150.48,
      "text": "प्रोडक्ट बहुत ही जल्दी फेमस होने लगा और"
    },
    {
      "subtitle_id": 76,
      "start": 148.64,
      "end": 152.879,
      "text": "इसकी सेल्स भी बहुत तेजी से बढ़ने लगी।"
    },
    {
      "subtitle_id": 77,
      "start": 150.48,
      "end": 156.239,
      "text": "इन्वेस्टर्स मानो इसके पीछे पागल थे। टोटल"
    },
    {
      "subtitle_id": 78,
      "start": 152.879,
      "end": 158.8,
      "text": "20 फंडिंग राउंड इन्होंने उठाए और 475"
    },
    {
      "subtitle_id": 79,
      "start": 156.239,
      "end": 160.72,
      "text": "मिलियन यानी 3000 करोड़ से भी ज्यादा की"
    },
    {
      "subtitle_id": 80,
      "start": 158.8,
      "end": 162.64,
      "text": "फंडिंग इन्होंने उठाई। इमेजिन कीजिए यह"
    },
    {
      "subtitle_id": 81,
      "start": 160.72,
      "end": 164.72,
      "text": "नंबर। अगर आप इसमें इन्वेस्टर्स का नाम"
    },
    {
      "subtitle_id": 82,
      "start": 162.64,
      "end": 167.2,
      "text": "देखेंगे तो आपको इसमें टॉप्स नाम मिलेंगे।"
    },
    {
      "subtitle_id": 83,
      "start": 164.72,
      "end": 169.28,
      "text": "हां, इस लिस्ट में ब्लैक रॉक जो दुनिया की"
    },
    {
      "subtitle_id": 84,
      "start": 167.2,
      "end": 171.519,
      "text": "सबसे बड़ी एसेट मैनेजमेंट कंपनी है वो"
    },
    {
      "subtitle_id": 85,
      "start": 169.28,
      "end": 173.76,
      "text": "आते-आते रह गई। वो भी क्यों? मैं आगे"
    },
    {
      "subtitle_id": 86,
      "start": 171.519,
      "end": 175.76,
      "text": "बताता हूं। 2016 से उन्होंने इंडिया पर"
    },
    {
      "subtitle_id": 87,
      "start": 173.76,
      "end": 177.76,
      "text": "फोकस करना शुरू किया बियर बनाने के लिए"
    },
    {
      "subtitle_id": 88,
      "start": 175.76,
      "end": 179.92,
      "text": "इंदौर में। फिर नागपुर में उन्होंने अपनी"
    },
    {
      "subtitle_id": 89,
      "start": 177.76,
      "end": 181.84,
      "text": "दूसरी ब्रीवरी बनाई और फिर इस तरह से बीरा"
    },
    {
      "subtitle_id": 90,
      "start": 179.92,
      "end": 185.2,
      "text": "91 इंडिया का फेवरेट क्राफ्ट बीियर बन"
    },
    {
      "subtitle_id": 91,
      "start": 181.84,
      "end": 187.44,
      "text": "गया। 2023 का इसका रेवेन्यू 800 करोड़ से"
    },
    {
      "subtitle_id": 92,
      "start": 185.2,
      "end": 189.2,
      "text": "भी ऊपर चला गया। यानी कि सवाल यह आता है"
    },
    {
      "subtitle_id": 93,
      "start": 187.44,
      "end": 191.36,
      "text": "कि प्रसाद अगर सब कुछ सही चल रहा था तो"
    },
    {
      "subtitle_id": 94,
      "start": 189.2,
      "end": 193.04,
      "text": "अचानक से बिज़नेस बंद कैसे हो गया? वीडियो"
    },
    {
      "subtitle_id": 95,
      "start": 191.36,
      "end": 194.56,
      "text": "में आगे बढ़ने से पहले आपको बता दूं कि इस"
    },
    {
      "subtitle_id": 96,
      "start": 193.04,
      "end": 196.4,
      "text": "दिवाली कुछ स्पेशल तो बनता है और इस"
    },
    {
      "subtitle_id": 97,
      "start": 194.56,
      "end": 198.8,
      "text": "दिवाली में आपके लिए लेकर आए हैं हमारी"
    },
    {
      "subtitle_id": 98,
      "start": 196.4,
      "end": 201.44,
      "text": "कॉम्बो ऑफर जो हर साल दिवाली में हम चलाते"
    },
    {
      "subtitle_id": 99,
      "start": 198.8,
      "end": 204.4,
      "text": "हैं और इस बार आपको जबरदस्त डिस्काउंट मिल"
    },
    {
      "subtitle_id": 100,
      "start": 201.44,
      "end": 205.599,
      "text": "रहा है 72% का। इस ऑफर की लिंक आपको नीचे"
    },
    {
      "subtitle_id": 101,
      "start": 204.4,
      "end": 207.36,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में मिल"
    },
    {
      "subtitle_id": 102,
      "start": 205.599,
      "end": 209.44,
      "text": "जाएगी। इसमें आपको दो का कॉम्बो मिल रहा"
    },
    {
      "subtitle_id": 103,
      "start": 207.36,
      "end": 212.159,
      "text": "है। एक है हमारा बिगिनर कोर्स और एक है"
    },
    {
      "subtitle_id": 104,
      "start": 209.44,
      "end": 213.92,
      "text": "फंडामेंटल एनालिसिस 3.0 फाउंडेशन कोर्स"
    },
    {
      "subtitle_id": 105,
      "start": 212.159,
      "end": 216.08,
      "text": "जहां पर स्टॉक मार्केट बिगिनर सिखाया जाता"
    },
    {
      "subtitle_id": 106,
      "start": 213.92,
      "end": 217.76,
      "text": "है आपको और फंडामेंटल एनालिसिस 3.0 जहां"
    },
    {
      "subtitle_id": 107,
      "start": 216.08,
      "end": 219.599,
      "text": "पर कंपनी एनालिसिस आप सीखते हो कि किसी"
    },
    {
      "subtitle_id": 108,
      "start": 217.76,
      "end": 221.04,
      "text": "कंपनी को कैसे एनालाइज करना है उसका भाई"
    },
    {
      "subtitle_id": 109,
      "start": 219.599,
      "end": 223.76,
      "text": "मैनेजमेंट एनालिसिस कैसे करना है उसका"
    },
    {
      "subtitle_id": 110,
      "start": 221.04,
      "end": 226.159,
      "text": "वैल्यू्यूएशन कैसे निकालना है सारी चीजें"
    },
    {
      "subtitle_id": 111,
      "start": 223.76,
      "end": 228.4,
      "text": "ए टू zेड तो ये सारे इस कॉम्बो में हो"
    },
    {
      "subtitle_id": 112,
      "start": 226.159,
      "end": 230.48,
      "text": "जाता है। सेकंड कॉम्बो है उसमें ये दो तो"
    },
    {
      "subtitle_id": 113,
      "start": 228.4,
      "end": 232.08,
      "text": "आएंगे ही। प्लस आपको म्यूचुअल फंड भी"
    },
    {
      "subtitle_id": 114,
      "start": 230.48,
      "end": 233.519,
      "text": "उसमें आ जाता है ए टू ज़ेड। आप सीधा"
    },
    {
      "subtitle_id": 115,
      "start": 232.08,
      "end": 235.04,
      "text": "एक्सपर्ट बन जाएंगे। खुद ही खुद के"
    },
    {
      "subtitle_id": 116,
      "start": 233.519,
      "end": 237.36,
      "text": "म्यूचुअल फंड सेलेक्ट कर पाएंगे। और चौथा"
    },
    {
      "subtitle_id": 117,
      "start": 235.04,
      "end": 239.2,
      "text": "है ऑप्शंस फॉर हैजिंग। हैजिंग यानी रिस्क"
    },
    {
      "subtitle_id": 118,
      "start": 237.36,
      "end": 240.879,
      "text": "मैनेजमेंट के लिए अगर आपको ऑप्शन सीखना है"
    },
    {
      "subtitle_id": 119,
      "start": 239.2,
      "end": 243.12,
      "text": "तो आसान भाषा में एकदम हमने वहां पर"
    },
    {
      "subtitle_id": 120,
      "start": 240.879,
      "end": 245.04,
      "text": "सिखाया है। तो ये दोनों कॉम्बोस आपके"
    },
    {
      "subtitle_id": 121,
      "start": 243.12,
      "end": 246.72,
      "text": "सामने हैं। बहुत तगड़े डिस्काउंट्स सिंपर"
    },
    {
      "subtitle_id": 122,
      "start": 245.04,
      "end": 248.56,
      "text": "चल रहे हैं। दिवाली जाने के बाद आपको नहीं"
    },
    {
      "subtitle_id": 123,
      "start": 246.72,
      "end": 250.56,
      "text": "मिलेंगे। दोनों की लिंक नीचे दी गई है।"
    },
    {
      "subtitle_id": 124,
      "start": 248.56,
      "end": 252.319,
      "text": "एकदम सिंपल आसान भाषा में मैंने समझाई है"
    },
    {
      "subtitle_id": 125,
      "start": 250.56,
      "end": 254.08,
      "text": "चीजें कि जो फोर फिफ्थ स्टैंडर्ड का"
    },
    {
      "subtitle_id": 126,
      "start": 252.319,
      "end": 256.0,
      "text": "स्टूडेंट भी बड़े आसानी से समझ पाए। ये"
    },
    {
      "subtitle_id": 127,
      "start": 254.08,
      "end": 257.84,
      "text": "लैंग्वेज मैंने यूज की है। तो नो डाउट"
    },
    {
      "subtitle_id": 128,
      "start": 256.0,
      "end": 259.84,
      "text": "आपको समझ में नहीं आएगा। ऐसा हो ही नहीं"
    },
    {
      "subtitle_id": 129,
      "start": 257.84,
      "end": 261.68,
      "text": "सकता। तो ये गोल्डन ओपोरर्चुनिटी है सभी"
    },
    {
      "subtitle_id": 130,
      "start": 259.84,
      "end": 264.0,
      "text": "के लिए शेयर मार्केट को डिटेल में सीखने"
    },
    {
      "subtitle_id": 131,
      "start": 261.68,
      "end": 266.32,
      "text": "की उसे सही ढंग से उन स्टॉक्स को एनालाइज"
    },
    {
      "subtitle_id": 132,
      "start": 264.0,
      "end": 268.0,
      "text": "करने की। जरूर इसे चेक आउट कीजिए और बहुत"
    },
    {
      "subtitle_id": 133,
      "start": 266.32,
      "end": 269.919,
      "text": "सारे स्टॉक्स जो मैं भी मुरत ट्रेडिंग"
    },
    {
      "subtitle_id": 134,
      "start": 268.0,
      "end": 272.4,
      "text": "वगैरह के लिए खरीदता हूं वो फंडामेंटल"
    },
    {
      "subtitle_id": 135,
      "start": 269.919,
      "end": 274.24,
      "text": "एनालिसिस मेथड से ही करता हूं। तो काफी"
    },
    {
      "subtitle_id": 136,
      "start": 272.4,
      "end": 276.16,
      "text": "कुछ इस मेथड से आपको सीखने मिलेगा। तो"
    },
    {
      "subtitle_id": 137,
      "start": 274.24,
      "end": 278.639,
      "text": "तुरंत इस ऑफर का फायदा लीजिए। अगले 2 दिन"
    },
    {
      "subtitle_id": 138,
      "start": 276.16,
      "end": 280.4,
      "text": "ये ऑफर वैलिड है। तो लिंक इसके इसकी आपको"
    },
    {
      "subtitle_id": 139,
      "start": 278.639,
      "end": 282.4,
      "text": "नीचे मिल जाएगी। तो चलिए बढ़ते हैं वीडियो"
    },
    {
      "subtitle_id": 140,
      "start": 280.4,
      "end": 284.639,
      "text": "की तरफ। तो देखिए जैसे मैंने बताया आपको"
    },
    {
      "subtitle_id": 141,
      "start": 282.4,
      "end": 286.8,
      "text": "थोड़ी देर पहले कि उन्होंने 3500 करोड़ तक"
    },
    {
      "subtitle_id": 142,
      "start": 284.639,
      "end": 288.4,
      "text": "का फंड रेज किया 20 फंडिंग राउंड्स में"
    },
    {
      "subtitle_id": 143,
      "start": 286.8,
      "end": 290.32,
      "text": "जिसके चलते उनके जो शेयरहोल्डर्स हैं"
    },
    {
      "subtitle_id": 144,
      "start": 288.4,
      "end": 292.08,
      "text": "इन्वेस्टर्स हैं उनका नंबर 200 के करीब"
    },
    {
      "subtitle_id": 145,
      "start": 290.32,
      "end": 294.16,
      "text": "पहुंच गया। तो इंडियन लॉ के हिसाब से अगर"
    },
    {
      "subtitle_id": 146,
      "start": 292.08,
      "end": 295.68,
      "text": "शेयर होल्डर्स का नंबर 200 के ऊपर चला जाए"
    },
    {
      "subtitle_id": 147,
      "start": 294.16,
      "end": 297.199,
      "text": "तो उस कंपनी को प्राइवेट लिमिटेड से"
    },
    {
      "subtitle_id": 148,
      "start": 295.68,
      "end": 299.6,
      "text": "पब्लिक में कन्वर्ट होना पड़ता है"
    },
    {
      "subtitle_id": 149,
      "start": 297.199,
      "end": 301.199,
      "text": "कंपलसरीली और इसी के साथ अगर आपको आईपीओ"
    },
    {
      "subtitle_id": 150,
      "start": 299.6,
      "end": 302.88,
      "text": "लाना है तो आपको सेम चीज यहां पर करनी"
    },
    {
      "subtitle_id": 151,
      "start": 301.199,
      "end": 305.199,
      "text": "पड़ती है। अगर आपने किसी आईपीओ की"
    },
    {
      "subtitle_id": 152,
      "start": 302.88,
      "end": 307.36,
      "text": "डीआरएसपी पढ़ी होगी तो सारी कंपनीज़ अपने"
    },
    {
      "subtitle_id": 153,
      "start": 305.199,
      "end": 309.28,
      "text": "आप को आईपीओ लाने से पहले पब्लिक कंपनी"
    },
    {
      "subtitle_id": 154,
      "start": 307.36,
      "end": 311.84,
      "text": "में कन्वर्ट करती है। तो यह लॉ है जो सारी"
    },
    {
      "subtitle_id": 155,
      "start": 309.28,
      "end": 313.68,
      "text": "कंपनीज़ को फॉलो करना पड़ता है। अब बीरा के"
    },
    {
      "subtitle_id": 156,
      "start": 311.84,
      "end": 316.24,
      "text": "केस में प्रॉब्लम यह आई इंडिया में"
    },
    {
      "subtitle_id": 157,
      "start": 313.68,
      "end": 318.24,
      "text": "अल्कोहल स्टेट सब्जेक्ट है। मतलब शराब से"
    },
    {
      "subtitle_id": 158,
      "start": 316.24,
      "end": 320.8,
      "text": "रिलेटेड पूरे रूल्स और परमिशन हर स्टेट"
    },
    {
      "subtitle_id": 159,
      "start": 318.24,
      "end": 323.039,
      "text": "डिसाइड करता है ना कि सेंट्रल गवर्नमेंट।"
    },
    {
      "subtitle_id": 160,
      "start": 320.8,
      "end": 324.96,
      "text": "प्रोडक्शन, सेल्स, प्राइसिंग, टैक्स,"
    },
    {
      "subtitle_id": 161,
      "start": 323.039,
      "end": 326.96,
      "text": "लाइसेंस सारे अलग-अलग स्टेट डिसाइड"
    },
    {
      "subtitle_id": 162,
      "start": 324.96,
      "end": 328.96,
      "text": "करेंगे। फॉर एग्जांपल जो लीगल ड्रिंकिंग"
    },
    {
      "subtitle_id": 163,
      "start": 326.96,
      "end": 331.759,
      "text": "एज है महाराष्ट्र में स्पिरिट्स के लिए वो"
    },
    {
      "subtitle_id": 164,
      "start": 328.96,
      "end": 334.8,
      "text": "25 इयर्स है और बियर्स के लिए 18 इयर्स"
    },
    {
      "subtitle_id": 165,
      "start": 331.759,
      "end": 336.72,
      "text": "है। वहीं केरला में ये 23 है फॉर बोथ।"
    },
    {
      "subtitle_id": 166,
      "start": 334.8,
      "end": 338.88,
      "text": "गुजरात और बिहार में तो पूरी तरह से बैन"
    },
    {
      "subtitle_id": 167,
      "start": 336.72,
      "end": 340.4,
      "text": "है। और इंटरेस्टिंग बात यह है कि हर स्टेट"
    },
    {
      "subtitle_id": 168,
      "start": 338.88,
      "end": 342.0,
      "text": "के लिए आपको अलग-अलग लाइसेंसेस भी लेने"
    },
    {
      "subtitle_id": 169,
      "start": 340.4,
      "end": 344.0,
      "text": "पड़ते हैं। यानी एक बहुत ही टफ बिनेस है"
    },
    {
      "subtitle_id": 170,
      "start": 342.0,
      "end": 346.0,
      "text": "यह। और बहुत प्रॉब्लमेटिक अगर लीगल पॉइंट"
    },
    {
      "subtitle_id": 171,
      "start": 344.0,
      "end": 347.6,
      "text": "ऑफ व्यू से देखें तो एक स्टेट का लाइसेंस"
    },
    {
      "subtitle_id": 172,
      "start": 346.0,
      "end": 349.199,
      "text": "दूसरे स्टेट में वैलिड नहीं होता है। हर"
    },
    {
      "subtitle_id": 173,
      "start": 347.6,
      "end": 351.12,
      "text": "स्टेट का अपना अप्रूवल होता है। जिसका"
    },
    {
      "subtitle_id": 174,
      "start": 349.199,
      "end": 353.12,
      "text": "मतलब यह कि बीरा को अब हर स्टेट में जहां"
    },
    {
      "subtitle_id": 175,
      "start": 351.12,
      "end": 355.52,
      "text": "अल्कोहल लीगल है वहां से अलग-अलग"
    },
    {
      "subtitle_id": 176,
      "start": 353.12,
      "end": 357.12,
      "text": "लाइसेंसेस लेने होंगे फिर से। इसीलिए हर"
    },
    {
      "subtitle_id": 177,
      "start": 355.52,
      "end": 358.96,
      "text": "स्टेट के एक्साइज डिपार्टमेंट ने इनसे"
    },
    {
      "subtitle_id": 178,
      "start": 357.12,
      "end": 361.12,
      "text": "न्यू लाइसेंसेस, लेबल अप्रूवल्स और"
    },
    {
      "subtitle_id": 179,
      "start": 358.96,
      "end": 362.96,
      "text": "परमिशंस मांगे। इस प्रोसेस में इनके 4-6"
    },
    {
      "subtitle_id": 180,
      "start": 361.12,
      "end": 364.88,
      "text": "महीने खराब हो गए। सेल्स रुक गई।"
    },
    {
      "subtitle_id": 181,
      "start": 362.96,
      "end": 366.8,
      "text": "इन्वेंटरी जो बियर पड़ी थी इनकी 80 करोड़"
    },
    {
      "subtitle_id": 182,
      "start": 364.88,
      "end": 368.319,
      "text": "का उसमें लॉस हो गया। अब यह सारी चीजें"
    },
    {
      "subtitle_id": 183,
      "start": 366.8,
      "end": 370.08,
      "text": "उनके लिए एक बड़ा फाइनेंसियल और ऑपरेशन"
    },
    {
      "subtitle_id": 184,
      "start": 368.319,
      "end": 372.16,
      "text": "इशू बन गई। दिल्ली, एनसीआर और आंध्र"
    },
    {
      "subtitle_id": 185,
      "start": 370.08,
      "end": 374.0,
      "text": "प्रदेश जैसे बड़े मार्केट में बीरा 91 के"
    },
    {
      "subtitle_id": 186,
      "start": 372.16,
      "end": 376.0,
      "text": "प्रोडक्ट शॉप से गायब हो गए। पब्लिक को जब"
    },
    {
      "subtitle_id": 187,
      "start": 374.0,
      "end": 377.44,
      "text": "बीरा नहीं मिल रही थी तो बाकी ब्रांड्स ने"
    },
    {
      "subtitle_id": 188,
      "start": 376.0,
      "end": 379.12,
      "text": "फायदा उठाया। वैसा होता भी है कि आपने"
    },
    {
      "subtitle_id": 189,
      "start": 377.44,
      "end": 380.72,
      "text": "मार्केटिंग की अपने प्रोडक्ट के लिए लेकिन"
    },
    {
      "subtitle_id": 190,
      "start": 379.12,
      "end": 382.479,
      "text": "आपका प्रोडक्ट दुकान में अवेलेबल ही नहीं"
    },
    {
      "subtitle_id": 191,
      "start": 380.72,
      "end": 384.4,
      "text": "है। तो इनडायरेक्टली आप दूसरों के लिए"
    },
    {
      "subtitle_id": 192,
      "start": 382.479,
      "end": 386.479,
      "text": "मार्केटिंग कर रहे हो। ऐसा बहुत सारे"
    },
    {
      "subtitle_id": 193,
      "start": 384.4,
      "end": 388.319,
      "text": "एंटरप्रेन्यर्स कहते भी हैं। कंपनी के"
    },
    {
      "subtitle_id": 194,
      "start": 386.479,
      "end": 391.52,
      "text": "फाइनेंसियल और ऑडिट रिपोर्ट की बात करें"
    },
    {
      "subtitle_id": 195,
      "start": 388.319,
      "end": 393.68,
      "text": "तो 2024 में इनको 2100 करोड़ का लॉस हो"
    },
    {
      "subtitle_id": 196,
      "start": 391.52,
      "end": 395.84,
      "text": "गया। नेटवर्थ इनकी खत्म ही हो गई। कंपनी"
    },
    {
      "subtitle_id": 197,
      "start": 393.68,
      "end": 398.0,
      "text": "की लायबिलिटी उसके करंट एसेट से भी ज्यादा"
    },
    {
      "subtitle_id": 198,
      "start": 395.84,
      "end": 400.0,
      "text": "हो चुकी थी और कंपनी का कैश जनरेट फ्रॉम"
    },
    {
      "subtitle_id": 199,
      "start": 398.0,
      "end": 401.84,
      "text": "ऑपरेटिंग एक्टिविटी 42 करोड़ लॉस में चला"
    },
    {
      "subtitle_id": 200,
      "start": 400.0,
      "end": 403.44,
      "text": "गया। अब ये 200 इन्वेस्टर्स से इनके"
    },
    {
      "subtitle_id": 201,
      "start": 401.84,
      "end": 405.919,
      "text": "ज्यादा हो गए। ये तो इनके लिए प्रॉब्लम बन"
    },
    {
      "subtitle_id": 202,
      "start": 403.44,
      "end": 407.44,
      "text": "गई जब उनको पब्लिकली लिस्ट होना था। स्टॉक"
    },
    {
      "subtitle_id": 203,
      "start": 405.919,
      "end": 409.199,
      "text": "मार्केट में लिस्ट होना था। लेकिन यहां पर"
    },
    {
      "subtitle_id": 204,
      "start": 407.44,
      "end": 411.12,
      "text": "एक और भी प्रॉब्लम है कि चीजें उतनी भी"
    },
    {
      "subtitle_id": 205,
      "start": 409.199,
      "end": 413.52,
      "text": "सीधी नहीं है यहां पर। जैसे मैं आपको बता"
    },
    {
      "subtitle_id": 206,
      "start": 411.12,
      "end": 416.08,
      "text": "दूं कि फाइनेंसियल ईयर 2024 में इनके जो"
    },
    {
      "subtitle_id": 207,
      "start": 413.52,
      "end": 418.16,
      "text": "मैनेजिंग डायरेक्टर हैं उनको जो रिमुनरेशन"
    },
    {
      "subtitle_id": 208,
      "start": 416.08,
      "end": 420.88,
      "text": "दिया गया जो पैसे उनको दिए गए वो कंपनीज़"
    },
    {
      "subtitle_id": 209,
      "start": 418.16,
      "end": 422.72,
      "text": "एक्ट 2013 के सेक्शन 197 और शेड्यूल फाइव"
    },
    {
      "subtitle_id": 210,
      "start": 420.88,
      "end": 424.56,
      "text": "के लिमिट से ज्यादा थे। और सबसे बड़ी बात"
    },
    {
      "subtitle_id": 211,
      "start": 422.72,
      "end": 426.72,
      "text": "यह ज्यादा अमाउंट शेयर होल्डर के अप्रूवल"
    },
    {
      "subtitle_id": 212,
      "start": 424.56,
      "end": 428.88,
      "text": "के बिना उनको दी गई। तो एक और मेजर"
    },
    {
      "subtitle_id": 213,
      "start": 426.72,
      "end": 430.4,
      "text": "कंप्लायंस इशू पर बात करते हैं जो बिरा 91"
    },
    {
      "subtitle_id": 214,
      "start": 428.88,
      "end": 432.16,
      "text": "के फाइनेंसियल स्टेटमेंट्स और ऑडिटर"
    },
    {
      "subtitle_id": 215,
      "start": 430.4,
      "end": 434.08,
      "text": "रिपोर्ट में हाईलाइट हुआ है। कंपनी अपनी"
    },
    {
      "subtitle_id": 216,
      "start": 432.16,
      "end": 436.0,
      "text": "कई सारी लीगल चीजों को प्रॉपर्ली फॉलो"
    },
    {
      "subtitle_id": 217,
      "start": 434.08,
      "end": 438.08,
      "text": "नहीं कर रही थी अलग-अलग सेक्शंस के जरिए।"
    },
    {
      "subtitle_id": 218,
      "start": 436.0,
      "end": 440.319,
      "text": "मतलब ठीक है कि एक्सटर्नल इश्यूज भी थे"
    },
    {
      "subtitle_id": 219,
      "start": 438.08,
      "end": 442.0,
      "text": "लेकिन इंटरनल इश्यूज भी यहां पर जरूर थे।"
    },
    {
      "subtitle_id": 220,
      "start": 440.319,
      "end": 443.919,
      "text": "जिसके चलते पूरा प्रॉब्लम हो गया कंपनी"
    },
    {
      "subtitle_id": 221,
      "start": 442.0,
      "end": 445.84,
      "text": "में। हुआ यह कि 4-6 महीने से एंप्लई की"
    },
    {
      "subtitle_id": 222,
      "start": 443.919,
      "end": 448.8,
      "text": "सैलरी नहीं मिली। एंप्लई ने Twitter पर"
    },
    {
      "subtitle_id": 223,
      "start": 445.84,
      "end": 451.12,
      "text": "आए, Instagram पर आए और मांग करने लगे कि"
    },
    {
      "subtitle_id": 224,
      "start": 448.8,
      "end": 452.639,
      "text": "भाई हमें अपना हमारा जो सीईओ है वह सैलरी"
    },
    {
      "subtitle_id": 225,
      "start": 451.12,
      "end": 455.28,
      "text": "नहीं दे रहा है। जिसके चलते वह मांग करने"
    },
    {
      "subtitle_id": 226,
      "start": 452.639,
      "end": 457.039,
      "text": "लगे कि हमारे सीईओ रिजाइन कर दे। फिर उसके"
    },
    {
      "subtitle_id": 227,
      "start": 455.28,
      "end": 459.199,
      "text": "चलते हुआ यह कि 250 से ज्यादा एंप्लाइजज़"
    },
    {
      "subtitle_id": 228,
      "start": 457.039,
      "end": 461.199,
      "text": "ने कंपनी के जो टॉप इन्वेस्टर्स थे किरीन"
    },
    {
      "subtitle_id": 229,
      "start": 459.199,
      "end": 463.44,
      "text": "होल्डिंग्स और पीक 15 पार्टनर्स को पिटीशन"
    },
    {
      "subtitle_id": 230,
      "start": 461.199,
      "end": 465.36,
      "text": "भेजी कि सीईओ अंकुर जैन को आप हटा दो।"
    },
    {
      "subtitle_id": 231,
      "start": 463.44,
      "end": 467.44,
      "text": "एंप्लाइजज़ ने यहां पर क्लेम किया कि भाई 6"
    },
    {
      "subtitle_id": 232,
      "start": 465.36,
      "end": 469.039,
      "text": "महीने से सैलरी नहीं मिल रही हमको। 50 से"
    },
    {
      "subtitle_id": 233,
      "start": 467.44,
      "end": 470.639,
      "text": "ज्यादा एंप्लाइजज़ ने कहा कि कंपनी ने उनका"
    },
    {
      "subtitle_id": 234,
      "start": 469.039,
      "end": 472.479,
      "text": "टीडीएस डिपॉजिट नहीं किया है लास्ट"
    },
    {
      "subtitle_id": 235,
      "start": 470.639,
      "end": 474.56,
      "text": "फाइनेंसियल ईयर का। जिसके चलते बाद में"
    },
    {
      "subtitle_id": 236,
      "start": 472.479,
      "end": 477.039,
      "text": "अंकुर जैन ने भी एक्सेप्ट किया कि हां"
    },
    {
      "subtitle_id": 237,
      "start": 474.56,
      "end": 478.879,
      "text": "मतलब हमने सैलरी नहीं पे की है और यह भी"
    },
    {
      "subtitle_id": 238,
      "start": 477.039,
      "end": 480.879,
      "text": "कहा है कि कंपनी फिर से अब फंड रेिंग पर"
    },
    {
      "subtitle_id": 239,
      "start": 478.879,
      "end": 482.639,
      "text": "काम कर रही है। अभी पिछले महीने ब्लैक रॉक"
    },
    {
      "subtitle_id": 240,
      "start": 480.879,
      "end": 484.16,
      "text": "इनको 500 करोड़ की फंडिंग देने वाला था"
    },
    {
      "subtitle_id": 241,
      "start": 482.639,
      "end": 485.759,
      "text": "लेकिन वो डील भी कैंसिल हो गई क्योंकि"
    },
    {
      "subtitle_id": 242,
      "start": 484.16,
      "end": 487.199,
      "text": "इतने सारे प्रॉब्लम इंटरनल और एक्सटर्नल"
    },
    {
      "subtitle_id": 243,
      "start": 485.759,
      "end": 489.199,
      "text": "इनके चल रहे हैं जिसमें ब्लैक रॉक भी"
    },
    {
      "subtitle_id": 244,
      "start": 487.199,
      "end": 490.72,
      "text": "घुसना नहीं चाहता। तो फिलहाल सिचुएशन कुछ"
    },
    {
      "subtitle_id": 245,
      "start": 489.199,
      "end": 492.639,
      "text": "ऐसी है कि लॉसेस बढ़ते जा रहे हैं।"
    },
    {
      "subtitle_id": 246,
      "start": 490.72,
      "end": 494.879,
      "text": "लाइसेंसेस इनके कई सारे स्टेट्स में अटके"
    },
    {
      "subtitle_id": 247,
      "start": 492.639,
      "end": 497.12,
      "text": "पड़े हैं और फंडिंग इन्हें और उठाने में"
    },
    {
      "subtitle_id": 248,
      "start": 494.879,
      "end": 498.96,
      "text": "प्रॉब्लम आ रही है। अब सवाल यह है कि दोष"
    },
    {
      "subtitle_id": 249,
      "start": 497.12,
      "end": 500.72,
      "text": "किसे दिया जाए? तो दोष इसमें कई सारी"
    },
    {
      "subtitle_id": 250,
      "start": 498.96,
      "end": 502.16,
      "text": "चीजों का है। जैसे अगर अल्कोहल बिजनेस है"
    },
    {
      "subtitle_id": 251,
      "start": 500.72,
      "end": 503.599,
      "text": "तो इसमें ई ऑफ डूइंग का तो सही में"
    },
    {
      "subtitle_id": 252,
      "start": 502.16,
      "end": 505.68,
      "text": "प्रॉब्लम है ही। अलग-अलग स्टेट्स के"
    },
    {
      "subtitle_id": 253,
      "start": 503.599,
      "end": 507.44,
      "text": "अलग-अलग रूल है। तो प्रॉब्लम तो आएगा ही"
    },
    {
      "subtitle_id": 254,
      "start": 505.68,
      "end": 509.44,
      "text": "और साथ ही इंटरनली भी कई सारे रूल्स को"
    },
    {
      "subtitle_id": 255,
      "start": 507.44,
      "end": 511.599,
      "text": "इन्होंने भी वायलेट किया है। तो सिर्फ यू"
    },
    {
      "subtitle_id": 256,
      "start": 509.44,
      "end": 513.44,
      "text": "नो ई ऑफ डूइंग पर हम आरोप नहीं कर सकते।"
    },
    {
      "subtitle_id": 257,
      "start": 511.599,
      "end": 514.719,
      "text": "इंटरनल भी प्रॉब्लम्स थी। तो फिलहाल दोनों"
    },
    {
      "subtitle_id": 258,
      "start": 513.44,
      "end": 516.8,
      "text": "साइड से ये प्रॉब्लम थी। तो अगर आप कोई"
    },
    {
      "subtitle_id": 259,
      "start": 514.719,
      "end": 518.24,
      "text": "अल्कोहल बिज़नेस स्टार्ट करना चाहते हैं या"
    },
    {
      "subtitle_id": 260,
      "start": 516.8,
      "end": 520.08,
      "text": "फिर ऑलरेडी रन कर रहे हैं तो मेक श्योर"
    },
    {
      "subtitle_id": 261,
      "start": 518.24,
      "end": 521.839,
      "text": "कीजिए कि आपके सारे कंप्लायसेस और लीगल"
    },
    {
      "subtitle_id": 262,
      "start": 520.08,
      "end": 523.919,
      "text": "चीजें सही है क्योंकि दिस इज़ कंप्लायंस"
    },
    {
      "subtitle_id": 263,
      "start": 521.839,
      "end": 525.6,
      "text": "एंगल से। ये बहुत ही टफ बिज़नेस है हर एक"
    },
    {
      "subtitle_id": 264,
      "start": 523.919,
      "end": 527.44,
      "text": "स्टेट के अलग-अलग रूल्स होने की वजह से।"
    },
    {
      "subtitle_id": 265,
      "start": 525.6,
      "end": 529.12,
      "text": "और इसी का फटका पड़े बिरान 81 को लेकिन"
    },
    {
      "subtitle_id": 266,
      "start": 527.44,
      "end": 530.64,
      "text": "इंटरनल चीजें भी है क्योंकि और भी बियर"
    },
    {
      "subtitle_id": 267,
      "start": 529.12,
      "end": 532.64,
      "text": "कंपनीज़ इंडिया में ऑपरेट कर रही है। लेकिन"
    },
    {
      "subtitle_id": 268,
      "start": 530.64,
      "end": 534.24,
      "text": "आप देखोगे तो उनमें कंपटीशन नहीं है। वही"
    },
    {
      "subtitle_id": 269,
      "start": 532.64,
      "end": 536.08,
      "text": "टॉप प्लेयर्स हैं क्योंकि ये प्रोसेस ही"
    },
    {
      "subtitle_id": 270,
      "start": 534.24,
      "end": 538.48,
      "text": "इतनी है। उन्होंने एक बार प्रोसेस कर दी"
    },
    {
      "subtitle_id": 271,
      "start": 536.08,
      "end": 540.8,
      "text": "तो वो आराम से बैठे। नया किसी को घुसना है"
    },
    {
      "subtitle_id": 272,
      "start": 538.48,
      "end": 543.12,
      "text": "तो दे विल नीड अ लॉट ऑफ़ फंडिंग। बहुत सारा"
    },
    {
      "subtitle_id": 273,
      "start": 540.8,
      "end": 544.8,
      "text": "टाइम इसमें खराब होगा। तो अगर आप इसमें"
    },
    {
      "subtitle_id": 274,
      "start": 543.12,
      "end": 546.64,
      "text": "एंटर करना चाहते हो तो ये सारी चीजें आप"
    },
    {
      "subtitle_id": 275,
      "start": 544.8,
      "end": 548.16,
      "text": "जरूर दिमाग में रखिए। और अगर आप किसी नई"
    },
    {
      "subtitle_id": 276,
      "start": 546.64,
      "end": 549.6,
      "text": "लिस्टेड ड्रवरी कंपनी में इन्वेस्ट कर रहे"
    },
    {
      "subtitle_id": 277,
      "start": 548.16,
      "end": 551.279,
      "text": "हो तो मेक श्योर कीजिए कि कंप्लायंस और"
    },
    {
      "subtitle_id": 278,
      "start": 549.6,
      "end": 553.36,
      "text": "बाकी एंगल उनका कैसा है। चैट जेपीटी से"
    },
    {
      "subtitle_id": 279,
      "start": 551.279,
      "end": 555.04,
      "text": "पूछो भाई कि इनके कुछ लीगल किस्से हुए हैं"
    },
    {
      "subtitle_id": 280,
      "start": 553.36,
      "end": 556.64,
      "text": "क्या? अभी क्या-क्या चल रहे हैं ताकि आपको"
    },
    {
      "subtitle_id": 281,
      "start": 555.04,
      "end": 558.48,
      "text": "एक आईडिया क्योंकि इसमें लीगल झंझट बहुत"
    },
    {
      "subtitle_id": 282,
      "start": 556.64,
      "end": 560.24,
      "text": "ज्यादा है। तो आशा करता हूं कि बीरा 91 की"
    },
    {
      "subtitle_id": 283,
      "start": 558.48,
      "end": 562.16,
      "text": "स्टोरी आपको समझ में आ गई होगी और आपको यह"
    },
    {
      "subtitle_id": 284,
      "start": 560.24,
      "end": 563.92,
      "text": "भी समझ में आ गया होगा कि यार ये इस तरह"
    },
    {
      "subtitle_id": 285,
      "start": 562.16,
      "end": 565.44,
      "text": "की चीजें इंडिया में ही हो सकती है। बाहर"
    },
    {
      "subtitle_id": 286,
      "start": 563.92,
      "end": 567.6,
      "text": "होना तो मुश्किल है। यहां पर रूल्स भी"
    },
    {
      "subtitle_id": 287,
      "start": 565.44,
      "end": 569.36,
      "text": "इजीली वायलेट हो रहे हैं। यहां पर अलग-अलग"
    },
    {
      "subtitle_id": 288,
      "start": 567.6,
      "end": 571.279,
      "text": "स्टेट्स के रूल्स भी कहीं के कहीं चल रहे"
    },
    {
      "subtitle_id": 289,
      "start": 569.36,
      "end": 573.519,
      "text": "हैं। कोई सिंक नहीं है। कोई प्रॉपर"
    },
    {
      "subtitle_id": 290,
      "start": 571.279,
      "end": 574.72,
      "text": "ऑथॉरिटी नहीं है। लॉट्स ऑफ़ प्रॉब्लम। तो"
    },
    {
      "subtitle_id": 291,
      "start": 573.519,
      "end": 576.08,
      "text": "फिलहाल हम यहीं पर रुकते हैं। मिलते हैं"
    },
    {
      "subtitle_id": 292,
      "start": 574.72,
      "end": 577.76,
      "text": "अगले वीडियो में और जाते-जाते हमारी"
    },
    {
      "subtitle_id": 293,
      "start": 576.08,
      "end": 579.519,
      "text": "दिवाली ऑफर को जरूर चेक आउट कीजिए। यह जो"
    },
    {
      "subtitle_id": 294,
      "start": 577.76,
      "end": 581.44,
      "text": "फैबुलस कॉम्बो है, आपको बहुत ही"
    },
    {
      "subtitle_id": 295,
      "start": 579.519,
      "end": 583.6,
      "text": "डिस्काउंटेड प्राइस पर मिल रहा है विद 72%"
    },
    {
      "subtitle_id": 296,
      "start": 581.44,
      "end": 585.12,
      "text": "का डिस्काउंट फिर नहीं मिलेगा। तो ऑफर"
    },
    {
      "subtitle_id": 297,
      "start": 583.6,
      "end": 586.48,
      "text": "खत्म होने से जरूर इसका फायदा ले। इसकी"
    },
    {
      "subtitle_id": 298,
      "start": 585.12,
      "end": 588.0,
      "text": "लिंक आपको नीचे डिस्क्रिप्शन और कमेंट"
    },
    {
      "subtitle_id": 299,
      "start": 586.48,
      "end": 590.08,
      "text": "बॉक्स में मिल जाएगी। तुरंत एक्सेस मिल"
    },
    {
      "subtitle_id": 300,
      "start": 588.0,
      "end": 592.16,
      "text": "जाएगा 24 आवर्स के अंदर। दिवाली दिवाली"
    },
    {
      "subtitle_id": 301,
      "start": 590.08,
      "end": 594.64,
      "text": "में सीख लो, खत्म करो और अपनी इन्वेस्टिंग"
    },
    {
      "subtitle_id": 302,
      "start": 592.16,
      "end": 596.399,
      "text": "जर्नी शुरू करो इंटेलिजेंटली। इसके फीडबैक"
    },
    {
      "subtitle_id": 303,
      "start": 594.64,
      "end": 598.88,
      "text": "हमारे बहुत ज्यादा प्यारे हैं। सो डोंट"
    },
    {
      "subtitle_id": 304,
      "start": 596.399,
      "end": 601.44,
      "text": "मिस आउट ऑन दिस ऑफर। यह परफेक्ट कोर्स है।"
    },
    {
      "subtitle_id": 305,
      "start": 598.88,
      "end": 602.8,
      "text": "मतलब ओवरऑल इंडिया का बेस्ट कोर्स मैं कह"
    },
    {
      "subtitle_id": 306,
      "start": 601.44,
      "end": 607.12,
      "text": "सकता हूं फंडामेंटल एनालिसिस का। तो डोंट"
    },
    {
      "subtitle_id": 307,
      "start": 602.8,
      "end": 607.12,
      "text": "मिस आउट ऑन दिस ऑफर। सी यू।"
    }
  ]
}