  "segments": [
    {
      "subtitle_id": 1,
      "start": 2.72,
      "end": 6.48,
      "text": "इंडिया का सोलर सेक्टर आज बहुत ट्रेंडिंग"
    },
    {
      "subtitle_id": 2,
      "start": 4.72,
      "end": 8.559,
      "text": "में चल रहा है और इस ट्रेंडिंग सेक्टर में"
    },
    {
      "subtitle_id": 3,
      "start": 6.48,
      "end": 10.719,
      "text": "एक ऐसी कंपनी है जो भी आज ट्रेंडिंग में"
    },
    {
      "subtitle_id": 4,
      "start": 8.559,
      "end": 12.8,
      "text": "है और उसका नाम है विक्रम सोलर जो लेकर आई"
    },
    {
      "subtitle_id": 5,
      "start": 10.719,
      "end": 14.88,
      "text": "है अपना 1500 करोड़ का आईपीओ। देखिए"
    },
    {
      "subtitle_id": 6,
      "start": 12.8,
      "end": 17.199,
      "text": "विक्रम सोलर की बात करूं तो यह इंडिया की"
    },
    {
      "subtitle_id": 7,
      "start": 14.88,
      "end": 19.359,
      "text": "वन ऑफ द बिगेस्ट सोलर फोटो उल्टा एक"
    },
    {
      "subtitle_id": 8,
      "start": 17.199,
      "end": 21.84,
      "text": "मॉड्यूल बनाने वाली कंपनी है। अगर आप"
    },
    {
      "subtitle_id": 9,
      "start": 19.359,
      "end": 23.6,
      "text": "देखेंगे सोलर मॉड्यूल में तो कुछ तीनचार"
    },
    {
      "subtitle_id": 10,
      "start": 21.84,
      "end": 25.6,
      "text": "नाम आते हैं जिसकी आजकल बहुत ज्यादा"
    },
    {
      "subtitle_id": 11,
      "start": 23.6,
      "end": 27.76,
      "text": "डिमांड है। adानी है उसके बाद वारी आती"
    },
    {
      "subtitle_id": 12,
      "start": 25.6,
      "end": 29.439,
      "text": "है, लम है और विक्रम है। ये चार प्लेयर्स"
    },
    {
      "subtitle_id": 13,
      "start": 27.76,
      "end": 31.359,
      "text": "काफी तेजी से अपना मार्केट यहां पर बढ़ा"
    },
    {
      "subtitle_id": 14,
      "start": 29.439,
      "end": 33.52,
      "text": "रहे हैं और सरकार की जो स्कीम चल रही है"
    },
    {
      "subtitle_id": 15,
      "start": 31.359,
      "end": 35.28,
      "text": "सोलार के लिए घर पे सोलर लगाओ। 3 किलोवाट"
    },
    {
      "subtitle_id": 16,
      "start": 33.52,
      "end": 37.84,
      "text": "तक अच्छी खासी सब्सिडी यहां पर मिल रही"
    },
    {
      "subtitle_id": 17,
      "start": 35.28,
      "end": 39.84,
      "text": "है। तो उसके चलते भी इन कंपनीज़ को काफी"
    },
    {
      "subtitle_id": 18,
      "start": 37.84,
      "end": 42.32,
      "text": "ज्यादा फायदा मिल रहा है और उसमें से एक"
    },
    {
      "subtitle_id": 19,
      "start": 39.84,
      "end": 44.079,
      "text": "बेनिफिशियरी है विक्रम सोलर। तो आज इस"
    },
    {
      "subtitle_id": 20,
      "start": 42.32,
      "end": 46.8,
      "text": "विक्रम सोलर के बारे में डिटेल में बात"
    },
    {
      "subtitle_id": 21,
      "start": 44.079,
      "end": 49.12,
      "text": "करेंगे कि क्या यह कंपनी एक्सजेक्टली करती"
    },
    {
      "subtitle_id": 22,
      "start": 46.8,
      "end": 50.559,
      "text": "क्या है? अ कंपनी के मैनेजमेंट के बारे"
    },
    {
      "subtitle_id": 23,
      "start": 49.12,
      "end": 51.92,
      "text": "में डिटेल में बात करेंगे क्योंकि वो भी"
    },
    {
      "subtitle_id": 24,
      "start": 50.559,
      "end": 54.0,
      "text": "बात करना आज की डेट में इंडिया में बहुत"
    },
    {
      "subtitle_id": 25,
      "start": 51.92,
      "end": 55.6,
      "text": "ज्यादा जरूरी है। तीसरी चीज कंपनी के"
    },
    {
      "subtitle_id": 26,
      "start": 54.0,
      "end": 57.199,
      "text": "ग्रोथ पोटेंशियल और कंपनी के फाइनेंसियल"
    },
    {
      "subtitle_id": 27,
      "start": 55.6,
      "end": 59.12,
      "text": "स्टेटमेंट्स का एनालिसिस करेंगे और लास्ट"
    },
    {
      "subtitle_id": 28,
      "start": 57.199,
      "end": 61.28,
      "text": "में हम बात करेंगे कंपनी का वैल्यू्यूएशन"
    },
    {
      "subtitle_id": 29,
      "start": 59.12,
      "end": 63.199,
      "text": "क्या है और क्या कंपनी में सही में दम है"
    },
    {
      "subtitle_id": 30,
      "start": 61.28,
      "end": 65.04,
      "text": "या नहीं है। नमस्कार मैं प्रसाद आपका आज"
    },
    {
      "subtitle_id": 31,
      "start": 63.199,
      "end": 66.72,
      "text": "के इस वीडियो में स्वागत करता हूं। तो"
    },
    {
      "subtitle_id": 32,
      "start": 65.04,
      "end": 68.4,
      "text": "शुरुआत करते हैं कंपनी के मैनेजमेंट"
    },
    {
      "subtitle_id": 33,
      "start": 66.72,
      "end": 70.08,
      "text": "एनालिसिस से। अब मैं मैनेजमेंट एनालिसिस"
    },
    {
      "subtitle_id": 34,
      "start": 68.4,
      "end": 71.92,
      "text": "से शुरुआत क्यों कर रहा हूं आपको अगले 2"
    },
    {
      "subtitle_id": 35,
      "start": 70.08,
      "end": 73.76,
      "text": "मिनट में पता चल जाएगा। देखिए ये वेस्ट"
    },
    {
      "subtitle_id": 36,
      "start": 71.92,
      "end": 75.36,
      "text": "बंगाल बेस्ड कंपनी है और इसकी"
    },
    {
      "subtitle_id": 37,
      "start": 73.76,
      "end": 77.2,
      "text": "मैन्युफैक्चरिंग फैसिलिटी आपको वेस्ट"
    },
    {
      "subtitle_id": 38,
      "start": 75.36,
      "end": 79.28,
      "text": "बंगाल में मिलेगी। साथ ही तमिलनाडु में भी"
    },
    {
      "subtitle_id": 39,
      "start": 77.2,
      "end": 82.08,
      "text": "मिल जाएगी और कंपनी के जो प्रमोटर्स हैं"
    },
    {
      "subtitle_id": 40,
      "start": 79.28,
      "end": 83.68,
      "text": "वो है ज्ञान चौधरी ज्ञान चौधरी फैमिली"
    },
    {
      "subtitle_id": 41,
      "start": 82.08,
      "end": 85.68,
      "text": "ट्रस्ट और विक्रम कैपिटल मैनेजमेंट"
    },
    {
      "subtitle_id": 42,
      "start": 83.68,
      "end": 87.36,
      "text": "प्राइवेट लिमिटेड। और यह जो आईपीओ है यह"
    },
    {
      "subtitle_id": 43,
      "start": 85.68,
      "end": 89.52,
      "text": "पूरा आईपीओ नहीं है। यहां पर ओएफएस यानी"
    },
    {
      "subtitle_id": 44,
      "start": 87.36,
      "end": 91.28,
      "text": "ऑफर फॉर सेल का भी एक सेगमेंट है। जहां पर"
    },
    {
      "subtitle_id": 45,
      "start": 89.52,
      "end": 92.96,
      "text": "कंपनी के प्रमोटर्स अपना स्टेक बेच रहे"
    },
    {
      "subtitle_id": 46,
      "start": 91.28,
      "end": 95.2,
      "text": "हैं। अपने शेयर्स बेच रहे हैं। जिसमें"
    },
    {
      "subtitle_id": 47,
      "start": 92.96,
      "end": 97.2,
      "text": "ज्ञानेश चौधरी, अनिल चौधरी और विक्रम"
    },
    {
      "subtitle_id": 48,
      "start": 95.2,
      "end": 99.36,
      "text": "कैपिटल मैनेजमेंट प्राइवेट लिमिटेड। तो यह"
    },
    {
      "subtitle_id": 49,
      "start": 97.2,
      "end": 101.04,
      "text": "तीनों करीब 2.5 करोड़ शेयर्स विक्रम सोलार"
    },
    {
      "subtitle_id": 50,
      "start": 99.36,
      "end": 102.64,
      "text": "के बेच रहे हैं। प्रमोटर्स की बात करें तो"
    },
    {
      "subtitle_id": 51,
      "start": 101.04,
      "end": 105.2,
      "text": "इन्होंने ऑलरेडी अपने अच्छे खासे शेयर्स"
    },
    {
      "subtitle_id": 52,
      "start": 102.64,
      "end": 107.36,
      "text": "बैंक के पास गिरवी रखे हैं। कंपनी के 30%"
    },
    {
      "subtitle_id": 53,
      "start": 105.2,
      "end": 110.159,
      "text": "शेयर्स ऑन बिहाफ ऑफ इंडिया बैंक प्लेस्ड"
    },
    {
      "subtitle_id": 54,
      "start": 107.36,
      "end": 112.479,
      "text": "है यानी गिरवी रखे गए हैं और 12% विद Axis"
    },
    {
      "subtitle_id": 55,
      "start": 110.159,
      "end": 114.56,
      "text": "Bank LMT और यहां पर मैनेजमेंट एनालिसिस"
    },
    {
      "subtitle_id": 56,
      "start": 112.479,
      "end": 116.72,
      "text": "से शुरुआत करने के मेन दो कारण हैं। पहला"
    },
    {
      "subtitle_id": 57,
      "start": 114.56,
      "end": 118.96,
      "text": "मेन कारण यह है कि प्लेस्ड तो था बट ठीक"
    },
    {
      "subtitle_id": 58,
      "start": 116.72,
      "end": 120.96,
      "text": "है दैट इज ओके कि कंपनी के साथ कई सारे"
    },
    {
      "subtitle_id": 59,
      "start": 118.96,
      "end": 122.88,
      "text": "बड़े-बड़े लीगल इशूज़ हैं। आप यहां पर देख"
    },
    {
      "subtitle_id": 60,
      "start": 120.96,
      "end": 125.759,
      "text": "सकते हो कि कंपनी इज़ फाइटिंग मल्टीपल"
    },
    {
      "subtitle_id": 61,
      "start": 122.88,
      "end": 127.759,
      "text": "केसेस जिसमें क्रिमिनल केसेस हैं, टैक्स"
    },
    {
      "subtitle_id": 62,
      "start": 125.759,
      "end": 130.64,
      "text": "केसेस है, रेगुलेटरी है और सिविल केसेस भी"
    },
    {
      "subtitle_id": 63,
      "start": 127.759,
      "end": 132.8,
      "text": "हैं। इनके ऊपर चार क्रिमिनल केसेस हैं। 40"
    },
    {
      "subtitle_id": 64,
      "start": 130.64,
      "end": 134.56,
      "text": "टैक्स प्रोसीडिंग्स हैं और एक में तो इनके"
    },
    {
      "subtitle_id": 65,
      "start": 132.8,
      "end": 136.64,
      "text": "ऊपर रेट भी पड़ी थी टैक्स डिपार्टमेंट की"
    },
    {
      "subtitle_id": 66,
      "start": 134.56,
      "end": 138.56,
      "text": "रिसेंटली। इसके बाद दो रेगुलेटरी"
    },
    {
      "subtitle_id": 67,
      "start": 136.64,
      "end": 141.36,
      "text": "प्रोसीडिंग्स इनके ऊपर चल रही है। जिसका"
    },
    {
      "subtitle_id": 68,
      "start": 138.56,
      "end": 143.36,
      "text": "टोटल एक्सपोज़र निकल कर आता है 42 करोड़"
    },
    {
      "subtitle_id": 69,
      "start": 141.36,
      "end": 144.879,
      "text": "का। साथ ही इनके जो डायरेक्टर्स हैं उनके"
    },
    {
      "subtitle_id": 70,
      "start": 143.36,
      "end": 146.8,
      "text": "खिलाफ चार क्रिमिनल केसेस हैं और"
    },
    {
      "subtitle_id": 71,
      "start": 144.879,
      "end": 148.48,
      "text": "प्रमोटर्स के खिलाफ चार क्रिमिनल केसेस"
    },
    {
      "subtitle_id": 72,
      "start": 146.8,
      "end": 151.04,
      "text": "हैं। इसके अलावा इन्होंने भी और कुछ"
    },
    {
      "subtitle_id": 73,
      "start": 148.48,
      "end": 153.92,
      "text": "कंपनीज़ के ऊपर कुछ केसेस फाइल की है जिसका"
    },
    {
      "subtitle_id": 74,
      "start": 151.04,
      "end": 155.84,
      "text": "मटेरियल इंपैक्ट निकल कर आता है 333 करोड़"
    },
    {
      "subtitle_id": 75,
      "start": 153.92,
      "end": 157.599,
      "text": "का। यानी कि कंपनी के ऊपर जो लीगल केसेस"
    },
    {
      "subtitle_id": 76,
      "start": 155.84,
      "end": 159.28,
      "text": "हैं वो मुझे थोड़े ज्यादा लगे इस केस में"
    },
    {
      "subtitle_id": 77,
      "start": 157.599,
      "end": 161.28,
      "text": "और मैनेजमेंट की बात यहीं पर खत्म नहीं"
    },
    {
      "subtitle_id": 78,
      "start": 159.28,
      "end": 163.04,
      "text": "होती है। दूसरा एक कारण है जिसकी वजह से"
    },
    {
      "subtitle_id": 79,
      "start": 161.28,
      "end": 165.599,
      "text": "अगेन मैंने मैनेजमेंट एनालिसिस से शुरुआत"
    },
    {
      "subtitle_id": 80,
      "start": 163.04,
      "end": 167.04,
      "text": "की और वो है रिलेटेड पार्टी ट्रांजैक्शंस।"
    },
    {
      "subtitle_id": 81,
      "start": 165.599,
      "end": 169.599,
      "text": "यहां पर जब हमने कंपनी का रेड हियरिंग"
    },
    {
      "subtitle_id": 82,
      "start": 167.04,
      "end": 171.12,
      "text": "प्रोस्पेक्टस देखा काफी सारी शॉकिंग चीजें"
    },
    {
      "subtitle_id": 83,
      "start": 169.599,
      "end": 172.48,
      "text": "हमें यहां पर नजर आई। वीडियो में आगे"
    },
    {
      "subtitle_id": 84,
      "start": 171.12,
      "end": 174.8,
      "text": "बढ़ने से पहले आपको बता दूं कि हमारे"
    },
    {
      "subtitle_id": 85,
      "start": 172.48,
      "end": 176.72,
      "text": "फंडामेंटल एनालिसिस 3.0 ऑफर के बस आखिरी 2"
    },
    {
      "subtitle_id": 86,
      "start": 174.8,
      "end": 178.8,
      "text": "दिन बाकी है। जिसके बाद इस प्राइस में यह"
    },
    {
      "subtitle_id": 87,
      "start": 176.72,
      "end": 180.959,
      "text": "ऑफर आपको बाद में कभी नहीं मिलेगी। अगर आप"
    },
    {
      "subtitle_id": 88,
      "start": 178.8,
      "end": 182.56,
      "text": "स्टॉक मार्केट बेसिक से लेके एडवांस तक"
    },
    {
      "subtitle_id": 89,
      "start": 180.959,
      "end": 184.8,
      "text": "कंपनी के फाइनेंसियल स्टेटमेंट से लेकर"
    },
    {
      "subtitle_id": 90,
      "start": 182.56,
      "end": 186.72,
      "text": "फॉरेंसिक एनालिसिस तक सारी चीजें सीख के"
    },
    {
      "subtitle_id": 91,
      "start": 184.8,
      "end": 188.56,
      "text": "क्वालिटी कंपनीज़ ढूंढना चाहते हैं तो यह"
    },
    {
      "subtitle_id": 92,
      "start": 186.72,
      "end": 190.4,
      "text": "प्रोग्राम आपके लिए है। और इस ऑफर में"
    },
    {
      "subtitle_id": 93,
      "start": 188.56,
      "end": 192.239,
      "text": "आपको यह फंडामेंटल एसेस 3.0 मिल रहा है"
    },
    {
      "subtitle_id": 94,
      "start": 190.4,
      "end": 194.64,
