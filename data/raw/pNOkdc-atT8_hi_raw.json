  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.12,
      "end": 5.16,
      "text": "बेरोजगारी दहाई के आंकड़े में पहुंच गई है"
    },
    {
      "subtitle_id": 2,
      "start": 2.72,
      "end": 7.799,
      "text": "नौकरियां उपलब्ध नहीं है करीब दो करोड़ से"
    },
    {
      "subtitle_id": 3,
      "start": 5.16,
      "end": 11.24,
      "text": "ज्यादा श्रमिकों ने काम छोड़ दिया ये"
    },
    {
      "subtitle_id": 4,
      "start": 7.799,
      "end": 15.28,
      "text": "हमारे देश में बेरोजगारी की सच्चाई है"
    },
    {
      "subtitle_id": 5,
      "start": 11.24,
      "end": 18.4,
      "text": "बेरोजगारी सबसे बड़ी समस्या और दूसरा यह"
    },
    {
      "subtitle_id": 6,
      "start": 15.28,
      "end": 20.92,
      "text": "कि नौकरियां तो हैं लेकिन योग्यता नहीं कि"
    },
    {
      "subtitle_id": 7,
      "start": 18.4,
      "end": 23.279,
      "text": "भारत में ऐसे लोगों की तादाद बढ़ गई है"
    },
    {
      "subtitle_id": 8,
      "start": 20.92,
      "end": 26.08,
      "text": "जिन्होंने नौकरी ढूंढने की कोशिश करनी ही"
    },
    {
      "subtitle_id": 9,
      "start": 23.279,
      "end": 30.359,
      "text": "बंद कर दी है एआई के एडवांस होने के कारण"
    },
    {
      "subtitle_id": 10,
      "start": 26.08,
      "end": 30.359,
      "text": "कई लोगों की नौकरी जा रही है"
    },
    {
      "subtitle_id": 11,
      "start": 31.759,
      "end": 36.2,
      "text": "लास्ट ईयर इंडिया की जीडीपी 8 पर से ग्रो"
    },
    {
      "subtitle_id": 12,
      "start": 34.04,
      "end": 39.079,
      "text": "हुई है और यही नहीं आईएमएफ की रिपोर्ट के"
    },
    {
      "subtitle_id": 13,
      "start": 36.2,
      "end": 41.079,
      "text": "अनुसार इस साल वह 7 पर से ग्रो करेगी अगले"
    },
    {
      "subtitle_id": 14,
      "start": 39.079,
      "end": 43.64,
      "text": "ती सालों में इंडिया 5 ट्रिलियन डॉलर की"
    },
    {
      "subtitle_id": 15,
      "start": 41.079,
      "end": 46.76,
      "text": "इकॉनमी बनने जा रही है और 2030 तक 7"
    },
    {
      "subtitle_id": 16,
      "start": 43.64,
      "end": 49.44,
      "text": "ट्रिलियन डॉलर की तो क्या सब सही है नहीं"
    },
    {
      "subtitle_id": 17,
      "start": 46.76,
      "end": 52.32,
      "text": "द रियल क्वेश्चन स्टिल स्टैंड्स ग्रोथ इज"
    },
    {
      "subtitle_id": 18,
      "start": 49.44,
      "end": 54.96,
      "text": "देयर बट वयर आर द जॉब्स क्योंकि एक तरफ"
    },
    {
      "subtitle_id": 19,
      "start": 52.32,
      "end": 56.68,
      "text": "इंडिया की जीडीपी 7 टू 8 पर से बढ़ रही है"
    },
    {
      "subtitle_id": 20,
      "start": 54.96,
      "end": 58.879,
      "text": "और इंडिया द फास्टेस्ट ग्रोइंग मेजर"
    },
    {
      "subtitle_id": 21,
      "start": 56.68,
      "end": 61.12,
      "text": "इकोनॉमी इन द वर्ल्ड बन चुकी है पर वही"
    },
    {
      "subtitle_id": 22,
      "start": 58.879,
      "end": 63.16,
      "text": "दूसरी तरफ फास्ट ग्रोइंग मेजर इकॉनमी इन द"
    },
    {
      "subtitle_id": 23,
      "start": 61.12,
      "end": 66.24,
      "text": "वर्ल्ड नाम मात्र जॉब्स क्रिएट कर पा रही"
    },
    {
      "subtitle_id": 24,
      "start": 63.16,
      "end": 69.28,
      "text": "है मे 2024 में जो अन एंप्लॉयमेंट रेट 7"
    },
    {
      "subtitle_id": 25,
      "start": 66.24,
      "end": 71.799,
      "text": "पर की थी वो विद इन वन मंथ बढ़कर 99.2"
    },
    {
      "subtitle_id": 26,
      "start": 69.28,
      "end": 74.64,
      "text": "पहुंच जाती है एंड सम रिपोर्ट सेज दैट यूथ"
    },
    {
      "subtitle_id": 27,
      "start": 71.799,
      "end": 77.36,
      "text": "अनइंप्लॉयमेंट रेट इज ऑल टाइम हाई एट 40"
    },
    {
      "subtitle_id": 28,
      "start": 74.64,
      "end": 79.159,
      "text": "पर सेकंड और थर्ड यर कॉलेजेस की तो बात ही"
    },
    {
      "subtitle_id": 29,
      "start": 77.36,
      "end": 81.28,
      "text": "छोड़ी है आईआईटी ग्रेजुएट्स को भी जॉब्स"
    },
    {
      "subtitle_id": 30,
      "start": 79.159,
      "end": 83.799,
      "text": "नहीं मिल रही है स्क्रीन पर दी गई रिपोर्ट"
    },
    {
      "subtitle_id": 31,
      "start": 81.28,
      "end": 86.64,
      "text": "की माने तो 36 आईआईटी बॉम्बे ग्रेजुएट्स"
    },
    {
      "subtitle_id": 32,
      "start": 83.799,
      "end": 89.04,
      "text": "वर लेफ्ट विदाउट जॉब्स यही नहीं आप यह"
    },
    {
      "subtitle_id": 33,
      "start": 86.64,
      "end": 91.64,
      "text": "वीडियो देख लीजिए यह वीडियो है गुजरात के"
    },
    {
      "subtitle_id": 34,
      "start": 89.04,
      "end": 93.88,
      "text": "कंपनी की जहां पर मात्र 10 पोस्ट के लिए"
    },
    {
      "subtitle_id": 35,
      "start": 91.64,
      "end": 96.479,
      "text": "हजारों की भीड़ आ गई और वहां पर स्टैंप"
    },
    {
      "subtitle_id": 36,
      "start": 93.88,
      "end": 98.04,
      "text": "पेड होने लगी यूजुअली जीडीपी और जॉब ग्रोथ"
    },
    {
      "subtitle_id": 37,
      "start": 96.479,
      "end": 100.04,
      "text": "दोनों साथ में चलते हैं लेकिन इंडिया में"
    },
    {
      "subtitle_id": 38,
      "start": 98.04,
      "end": 101.92,
      "text": "ये बिल्कुल उल्टा हो रहा है जितनी तेजी से"
    },
    {
      "subtitle_id": 39,
      "start": 100.04,
      "end": 104.159,
      "text": "जीडीपी बढ़ रही है उतनी ही तेजी से जो"
    },
    {
      "subtitle_id": 40,
      "start": 101.92,
      "end": 106.32,
      "text": "जॉब्स है वो कम होती जा रही है इकोनॉमिक्स"
    },
    {
      "subtitle_id": 41,
      "start": 104.159,
      "end": 108.68,
      "text": "में इस फिनोमेना को जॉबज ग्रोथ कहते हैं"
    },
    {
      "subtitle_id": 42,
      "start": 106.32,
      "end": 110.88,
      "text": "तो क्यों होती है ये जॉबज ग्रोथ इसके कारण"
    },
    {
      "subtitle_id": 43,
      "start": 108.68,
      "end": 113.079,
      "text": "क्या है और इसका सलूशन क्या है इस जॉब"
    },
    {
      "subtitle_id": 44,
      "start": 110.88,
      "end": 114.719,
      "text": "ग्रोथ को कैसे वापस लाया जा सकता है इन"
    },
    {
      "subtitle_id": 45,
      "start": 113.079,
      "end": 116.56,
      "text": "सारी चीजों पर आज के इस वीडियो में हम"
    },
    {
      "subtitle_id": 46,
      "start": 114.719,
      "end": 118.039,
      "text": "डिटेल में बात करेंगे एक बात क्लियर करना"
    },
    {
      "subtitle_id": 47,
      "start": 116.56,
      "end": 120.6,
      "text": "चाहता हूं कि ये कोई पॉलिटिकल वीडियो नहीं"
    },
    {
      "subtitle_id": 48,
      "start": 118.039,
      "end": 122.88,
      "text": "है ये पोरली एक रिसर्च बेस वीडियो है जहां"
    },
    {
      "subtitle_id": 49,
      "start": 120.6,
      "end": 124.759,
      "text": "पर हम जॉबज ग्रोथ की बात करने वाले हैं"
    },
    {
      "subtitle_id": 50,
      "start": 122.88,
      "end": 126.92,
      "text": "नमस्कार मैं प्रसाद आपका आज के इस वीडियो"
    },
    {
      "subtitle_id": 51,
      "start": 124.759,
      "end": 128.92,
      "text": "में स्वागत करता हूं सो य जॉब्स ग्रोथ का"
    },
    {
      "subtitle_id": 52,
      "start": 126.92,
      "end": 130.92,
      "text": "सबसे बड़ा रीजन इंडिया में यह है कि जो"
    },
    {
      "subtitle_id": 53,
      "start": 128.92,
      "end": 133.959,
      "text": "ग्रोथ आ रही है वो मेनली उन सेक्टर्स में"
    },
    {
      "subtitle_id": 54,
      "start": 130.92,
      "end": 135.76,
      "text": "आ रही है जो लेबर इंटेंसिव नहीं है जैसे"
    },
    {
      "subtitle_id": 55,
      "start": 133.959,
      "end": 138.08,
      "text": "कि यह ग्रोथ इलेक्ट्रिक व्हीकल सेक्टर्स"
    },
    {
      "subtitle_id": 56,
      "start": 135.76,
      "end": 140.12,
      "text": "बैटरीज सेमीकंडक्टर सोलर पैनल ऐसी"
    },
    {
      "subtitle_id": 57,
      "start": 138.08,
      "end": 141.56,
      "text": "इंडस्ट्रीज से आ रही है हां यहां पर जॉब्स"
    },
    {
      "subtitle_id": 58,
      "start": 140.12,
      "end": 144.16,
      "text": "तो जनरेट होते हैं लेकिन उस मात्रा में"
    },
    {
      "subtitle_id": 59,
      "start": 141.56,
      "end": 146.519,
      "text": "जनरेट नहीं होते जितने के लोग सोचते हैं"
    },
    {
      "subtitle_id": 60,
      "start": 144.16,
      "end": 148.599,
      "text": "एक सोलर पैनल बनाने वाली कंपनी लाखों को"
    },
    {
      "subtitle_id": 61,
      "start": 146.519,
      "end": 150.519,
      "text": "एंप्लॉयमेंट नहीं दे पाती सेम फॉर"
    },
    {
      "subtitle_id": 62,
      "start": 148.599,
      "end": 152.239,
      "text": "सेमीकंडक्टर बिजनेस ब ब ये मोस्टली"
    },
    {
      "subtitle_id": 63,
      "start": 150.519,
      "end": 154.319,
      "text": "ऑटोमेशन से चलते हैं जैसे आप स्क्रीन पर"
    },
    {
      "subtitle_id": 64,
      "start": 152.239,
      "end": 156.12,
      "text": "देख सकते हो बड़ी-बड़ी मशीनस यहां पर यूज"
    },
    {
      "subtitle_id": 65,
      "start": 154.319,
      "end": 158.4,
      "text": "की जाती है और ह्यूमन रिक्वायरमेंट्स बस"
    },
    {
      "subtitle_id": 66,
      "start": 156.12,
      "end": 160.159,
      "text": "सर्वेस के लिए यूज की जाती हैं वही दूसरी"
    },
    {
      "subtitle_id": 67,
      "start": 158.4,
      "end": 161.599,
      "text": "तरफ जो लेबर इंटेंसिव इंडस्ट्रीज है जैसे"
    },
    {
      "subtitle_id": 68,
      "start": 160.159,
      "end": 163.959,
      "text": "कि टेक्सटाइल इंडस्ट्रीज गारमेंट"
    },
    {
      "subtitle_id": 69,
      "start": 161.599,
      "end": 165.8,
      "text": "इंडस्ट्रीज लेदर एप्रिल ज्वेलरी"
    },
    {
      "subtitle_id": 70,
      "start": 163.959,
      "end": 167.28,
      "text": "इलेक्ट्रॉनिक्स ये वो इंडस्ट्रीज है"
    },
    {
      "subtitle_id": 71,
      "start": 165.8,
      "end": 168.879,
      "text": "जिसमें बहुत ज्यादा एंप्लॉयमेंट क्रिएट"
    },
    {
      "subtitle_id": 72,
      "start": 167.28,
      "end": 170.599,
      "text": "होती है फॉर एग्जांपल चाइना में ऐसी कई"
    },
    {
      "subtitle_id": 73,
      "start": 168.879,
      "end": 172.959,
      "text": "सारी टेक्सटाइल फैक्ट्रीज हैं जहां पर छछ"
    },
    {
      "subtitle_id": 74,
      "start": 170.599,
      "end": 175.2,
      "text": "7-7 लाख लोग काम करते हैं और जब चाइना की"
    },
    {
      "subtitle_id": 75,
      "start": 172.959,
      "end": 177.0,
      "text": "ग्रोथ शुरू हुई तब उस टाइम भी जो काफी"
    },
    {
      "subtitle_id": 76,
      "start": 175.2,
      "end": 178.68,
      "text": "सारी एंप्लॉयमेंट आ रही थी वो टेक्सटाइल"
    },
    {
      "subtitle_id": 77,
      "start": 177.0,
      "end": 180.519,
      "text": "बिजनेसेस और मैन्युफैक्चरिंग बिजनेस से आ"
    },
    {
      "subtitle_id": 78,
      "start": 178.68,
      "end": 182.08,
      "text": "रही थी लेकिन फिलहाल अगर बात करें तो"
    },
    {
      "subtitle_id": 79,
      "start": 180.519,
      "end": 183.959,
      "text": "इसमें से मैन्युफैक्चरिंग हटाए तो बाकी"
    },
    {
      "subtitle_id": 80,
      "start": 182.08,
      "end": 185.84,
      "text": "सारी जो इंडस्ट्रीज है उनकी हालत इंडिया"
    },
    {
      "subtitle_id": 81,
      "start": 183.959,
      "end": 187.84,
      "text": "में बहुत खराब है जैसे कि आप देख सकते हैं"
    },
    {
      "subtitle_id": 82,
      "start": 185.84,
      "end": 189.84,
      "text": "एप्रिल और टेक्सटाइल प्रोडक्शन बहुत तेजी"
    },
    {
      "subtitle_id": 83,
      "start": 187.84,
      "end": 191.12,
      "text": "से गिर रहा है अप्रैल अगस्ट इस क्वार्टर"
    },
    {
      "subtitle_id": 84,
      "start": 189.84,
      "end": 193.959,
      "text": "में इंडिया का गारमेंट मैन्युफैक्चरिंग"
    },
    {
      "subtitle_id": 85,
      "start": 191.12,
      "end": 195.48,
      "text": "प्रोडक्शन 22 पर से गिर गया है इससे भी"
    },
    {
      "subtitle_id": 86,
      "start": 193.959,
      "end": 198.319,
      "text": "बुरी खबर यह है कि इंडिया का टेक्सटाइल"
    },
    {
      "subtitle_id": 87,
      "start": 195.48,
      "end": 200.799,
      "text": "एक्सपोर्ट 40 पर से गिरा हुआ है वेस्टर्न"
    },
    {
      "subtitle_id": 88,
      "start": 198.319,
      "end": 202.64,
      "text": "कंपनीज लाइक एचएनएम गैप टॉमी हिलफिगर जैसी"
    },
    {
      "subtitle_id": 89,
      "start": 200.799,
      "end": 205.0,
      "text": "कंपनीज जो इंडिया से बहुत भारी मात्रा में"
    },
    {
      "subtitle_id": 90,
      "start": 202.64,
      "end": 206.76,
      "text": "ऑर्डर्स देती थी वो अब नहीं दे रही है"
    },
    {
      "subtitle_id": 91,
      "start": 205.0,
      "end": 209.0,
      "text": "क्योंकि वेस्टर्न कंट्रीज में रिसेशन चल"
    },
    {
      "subtitle_id": 92,
      "start": 206.76,
      "end": 211.36,
      "text": "रहा है यह तो वो रीजन है जो हमारे बस में"
    },
    {
      "subtitle_id": 93,
      "start": 209.0,
      "end": 213.92,
      "text": "नहीं है एक और रीजन है जिसकी वजह से स्मॉल"
    },
    {
      "subtitle_id": 94,
      "start": 211.36,
      "end": 217.12,
      "text": "मैन्युफैक्चरर्स बहुत परेशान हैं और वो है"
    },
    {
      "subtitle_id": 95,
      "start": 213.92,
      "end": 219.36,
      "text": "इनपुट टैक्स क्रेडिट यानी आईटीसी यह जो"
    },
    {
      "subtitle_id": 96,
      "start": 217.12,
      "end": 221.76,
      "text": "आईटीसी यानी इनपुट टैक्स क्रेडिट है एक"
    },
    {
      "subtitle_id": 97,
      "start": 219.36,
      "end": 224.0,
      "text": "टैक्स बेनिफिट है जिससे आप अपने खरीदे हुए"
    },
    {
      "subtitle_id": 98,
      "start": 221.76,
      "end": 225.92,
      "text": "रॉ मटेरियल पे दिए गए टैक्स को फाइनल"
    },
    {
      "subtitle_id": 99,
      "start": 224.0,
      "end": 229.4,
      "text": "प्रोडक्ट पे लगने वाले टैक्स से एडजस्ट कर"
    },
    {
      "subtitle_id": 100,
      "start": 225.92,
      "end": 231.599,
      "text": "सकते हो लेकिन आईटीसी के"
    },
    {
      "subtitle_id": 101,
      "start": 229.4,
      "end": 233.48,
      "text": "कॉम्प्लेक्टेड छोटे मैन्युफैक्चरर्स को"
    },
    {
      "subtitle_id": 102,
      "start": 231.599,
      "end": 235.159,
      "text": "ऑर्डर देने से डरते हैं क्योंकि उन्हें डर"
    },
    {
      "subtitle_id": 103,
      "start": 233.48,
      "end": 237.159,
      "text": "रहता है कि उन्हें क्लेम मिलने में देरी"
    },
    {
      "subtitle_id": 104,
      "start": 235.159,
      "end": 239.239,
      "text": "हो सकती है अब जब से आईटीसी के नए"
    },
    {
      "subtitle_id": 105,
      "start": 237.159,
      "end": 241.079,
      "text": "कंप्लायंसेज आए हैं तब से जो बड़े-बड़े"
    },
    {
      "subtitle_id": 106,
      "start": 239.239,
      "end": 242.56,
      "text": "ब्रांड से बड़ी-बड़ी फैक्ट्रीज हैं"
    },
    {
      "subtitle_id": 107,
      "start": 241.079,
      "end": 244.4,
      "text": "उन्होंने छोटे मैन्युफैक्चरर छोटे"
    },
    {
      "subtitle_id": 108,
      "start": 242.56,
      "end": 246.239,
      "text": "ट्रेडर्स को काम देना बहुत कम किया तो"
    },
    {
      "subtitle_id": 109,
      "start": 244.4,
      "end": 247.879,
      "text": "टैक्सेस और कंप्लायंसेज की वजह से छोटे"
    },
    {
      "subtitle_id": 110,
      "start": 246.239,
      "end": 249.64,
      "text": "ट्रेडर्स को नुकसान तो हुआ है पर क्या"
    },
    {
      "subtitle_id": 111,
      "start": 247.879,
      "end": 251.879,
      "text": "करें इंडिया में बड़ी से बड़ी चीजों से"
    },
    {
      "subtitle_id": 112,
      "start": 249.64,
      "end": 253.959,
      "text": "लेकर छोटी से छोटी चीजों पर आपको टैक्स"
    },
    {
      "subtitle_id": 113,
      "start": 251.879,
      "end": 256.12,
      "text": "देना पड़ता है यही नहीं इंडिया में हेल्थ"
    },
    {
      "subtitle_id": 114,
      "start": 253.959,
      "end": 258.12,
      "text": "इंश्योरेंस पर भी 18 पर का टैक्स है पर"
    },
    {
      "subtitle_id": 115,
      "start": 256.12,
      "end": 260.239,
      "text": "क्या करें हेल्थ इंश्योरेंस एक ऐसी चीज है"
    },
    {
      "subtitle_id": 116,
      "start": 258.12,
      "end": 262.36,
      "text": "जो हर किसी के पास होनी चाहिए और अगर आपने"
    },
    {
      "subtitle_id": 117,
      "start": 260.239,
      "end": 264.28,
      "text": "अभी तक नहीं ली है तो ट एक बहुत अच्छा"
    },
    {
      "subtitle_id": 118,
      "start": 262.36,
      "end": 266.32,
      "text": "प्लेटफार्म है जहां पर आप स्पैम फ्री"
    },
    {
      "subtitle_id": 119,
      "start": 264.28,
      "end": 268.24,
      "text": "इंश्योरेंस एडवाइस लेकर अपने लिए और अपनी"
    },
    {
      "subtitle_id": 120,
      "start": 266.32,
      "end": 270.24,
      "text": "फैमिली के लिए इंश्योरेंस बाय कर सकते हैं"
    },
    {
      "subtitle_id": 121,
      "start": 268.24,
      "end": 272.28,
      "text": "ट की खास बात यह है कि आपको बार-बार कॉल"
    },
    {
      "subtitle_id": 122,
      "start": 270.24,
      "end": 274.199,
      "text": "कर कर परेशान नहीं करते हैं ना ही किसी"
    },
    {
      "subtitle_id": 123,
      "start": 272.28,
      "end": 276.4,
      "text": "पर्टिकुलर प्रोडक्ट या इंश्योरेंस खरीदने"
    },
    {
      "subtitle_id": 124,
      "start": 274.199,
      "end": 277.919,
      "text": "के लिए आप पर प्रेशर डालते हैं वो बड़े ही"
    },
    {
      "subtitle_id": 125,
      "start": 276.4,
      "end": 279.639,
      "text": "आसान भाषा में समझा देंगे कि आपके"
    },
    {
      "subtitle_id": 126,
      "start": 277.919,
      "end": 281.639,
      "text": "रिक्वायरमेंट के हिसाब से आपको कितने"
    },
    {
      "subtitle_id": 127,
      "start": 279.639,
      "end": 283.84,
      "text": "अमाउंट का और कौन सा प्लान लेना चाहिए"
    },
    {
      "subtitle_id": 128,
      "start": 281.639,
      "end": 285.32,
      "text": "लेना नहीं लेना आपकी मर्जी मेरी माने तो"
    },
    {
      "subtitle_id": 129,
      "start": 283.84,
      "end": 287.44,
      "text": "आपको अर्ली 20 में ही अपना हेल्थ"
    },
    {
      "subtitle_id": 130,
      "start": 285.32,
      "end": 288.8,
      "text": "इंश्योरेंस लेना चाहिए जनरली लोग जॉब लगने"
    },
    {
      "subtitle_id": 131,
      "start": 287.44,
      "end": 290.24,
      "text": "के बाद पहले इन्वेस्टमेंट करते हैं फिर"
    },
    {
      "subtitle_id": 132,
      "start": 288.8,
      "end": 291.56,
      "text": "हेल्थ इंश्योरेंस लेते हैं मेरे हिसाब से"
    },
    {
      "subtitle_id": 133,
      "start": 290.24,
      "end": 293.28,
      "text": "ये उल्टा होना चाहिए पहले आपको हेल्थ"
    },
    {
      "subtitle_id": 134,
      "start": 291.56,
      "end": 294.84,
      "text": "इंश्योरेंस लेनी ही चाहिए और आपको तो पता"
    },
    {
      "subtitle_id": 135,
      "start": 293.28,
      "end": 296.52,
      "text": "ही है कि आजकल स्ट्रेस की वजह से जो"
    },
    {
      "subtitle_id": 136,
      "start": 294.84,
      "end": 298.68,
      "text": "बीमारियां पहले 60 साल की उम्र में होती"
    },
    {
      "subtitle_id": 137,
      "start": 296.52,
      "end": 300.84,
      "text": "थी अभी 40 की उम्र में हो रही है सो जितना"
    },
    {
      "subtitle_id": 138,
      "start": 298.68,
      "end": 302.4,
      "text": "जल्दी लेंगे उतना बेटर और जल्दी लेने से"
    },
    {
      "subtitle_id": 139,
      "start": 300.84,
      "end": 304.28,
      "text": "आपका जो वेटिंग पीरियड है वो भी जल्दी"
    },
    {
      "subtitle_id": 140,
      "start": 302.4,
      "end": 306.16,
      "text": "खत्म हो जाएगा तो अगर आपने अभी तक हेल्थ"
    },
    {
      "subtitle_id": 141,
      "start": 304.28,
      "end": 307.6,
      "text": "इंश्योरेंस नहीं लिया है तो वेट मत करो"
    },
    {
      "subtitle_id": 142,
      "start": 306.16,
      "end": 309.88,
      "text": "अभी डिस्क्रिप्शन और कमेंट बॉक्स में दी"
    },
    {
      "subtitle_id": 143,
      "start": 307.6,
      "end": 311.8,
      "text": "गए लिंक पर क्लिक करके ट पर कॉल बुक करो"
    },
    {
      "subtitle_id": 144,
      "start": 309.88,
      "end": 314.28,
      "text": "और अपने और अपनी फैमिली का फ्यूचर सिक्योर"
    },
    {
      "subtitle_id": 145,
      "start": 311.8,
      "end": 315.68,
      "text": "करो सो नाउ लेट्स गेट बैक टू द वीडियो"
    },
    {
      "subtitle_id": 146,
      "start": 314.28,
      "end": 317.24,
      "text": "इसके अलावा हम फॉरेन डायरेक्ट"
    },
    {
      "subtitle_id": 147,
      "start": 315.68,
      "end": 320.479,
      "text": "इन्वेस्टमेंट यानी एफडीआई के नंबर्स की"
    },
    {
      "subtitle_id": 148,
      "start": 317.24,
      "end": 322.68,
      "text": "बात करें तो वो 2016 में जीडीपी के 1.7 पर"
    },
    {
      "subtitle_id": 149,
      "start": 320.479,
      "end": 324.639,
      "text": "थी यानी ऑलरेडी बहुत कम थी अब वो कम होकर"
    },
    {
      "subtitle_id": 150,
      "start": 322.68,
      "end": 327.6,
      "text": "और कितना हो सकता है तो अभी वो हो गए हैं"
    },
    {
      "subtitle_id": 151,
      "start": 324.639,
      "end": 329.36,
      "text": "मात्र 0.5 अब चाइना की ग्रोथ स्टोरी से"
    },
    {
      "subtitle_id": 152,
      "start": 327.6,
      "end": 332.199,
      "text": "अगर इसे कंपेयर करें तो चाइना ने कई दशकों"
    },
    {
      "subtitle_id": 153,
      "start": 329.36,
      "end": 334.639,
      "text": "तक एफडीआई को 4 पर ऑफ जीडीपी मेंटेन किया"
    },
    {
      "subtitle_id": 154,
      "start": 332.199,
      "end": 336.479,
      "text": "तब जाके चाइना चाइना बना सेम चीज साउथ"
    },
    {
      "subtitle_id": 155,
      "start": 334.639,
      "end": 338.68,
      "text": "कोरिया में हुई पर इंडिया में वैसा कुछ"
    },
    {
      "subtitle_id": 156,
      "start": 336.479,
      "end": 340.6,
      "text": "होते हुए नजर नहीं आ रहा है कुछ बड़ी"
    },
    {
      "subtitle_id": 157,
      "start": 338.68,
      "end": 342.639,
      "text": "कंपनीज इन इलेक्ट्रॉनिक्स एंड सेमीकंडक्टर"
    },
    {
      "subtitle_id": 158,
      "start": 340.6,
      "end": 344.36,
      "text": "को छोड़ दें तो इंडिया में बाकी बिजनेसेस"
    },
    {
      "subtitle_id": 159,
      "start": 342.639,
      "end": 346.52,
      "text": "में इन्वेस्ट करने को कोई राजी नहीं है"
    },
    {
      "subtitle_id": 160,
      "start": 344.36,
      "end": 348.56,
      "text": "उल्टा जो वेस्टर्न नेशंस के चाइना प्लस वन"
    },
    {
      "subtitle_id": 161,
      "start": 346.52,
      "end": 350.52,
      "text": "स्ट्रेटेजी है जो वेस्टर्न नेशंस ने बनाई"
    },
    {
      "subtitle_id": 162,
      "start": 348.56,
      "end": 352.52,
      "text": "थी ताकि उनकी इकोनॉमी बहुत ज्यादा चाइना"
    },
    {
      "subtitle_id": 163,
      "start": 350.52,
      "end": 354.319,
      "text": "पर डिपेंड ना हो इस स्ट्रेटेजी का फायदा"
    },
    {
      "subtitle_id": 164,
      "start": 352.52,
      "end": 356.24,
      "text": "इंडिया से ज्यादा तो वियतनाम ने लिया है"
    },
    {
      "subtitle_id": 165,
      "start": 354.319,
      "end": 357.68,
      "text": "और वही अगर टेक्सटाइल की बात करें तो व"
    },
    {
      "subtitle_id": 166,
      "start": 356.24,
      "end": 359.759,
      "text": "इंडस्ट्री भी बहुत बड़ी मात्रा में"
    },
    {
      "subtitle_id": 167,
      "start": 357.68,
      "end": 361.28,
      "text": "बांग्लादेश की तरफ शिफ्ट हुई है अब"
    },
    {
      "subtitle_id": 168,
      "start": 359.759,
      "end": 363.199,
      "text": "बांग्लादेश में फिलहाल बहुत बड़ा क्राइसिस"
    },
    {
      "subtitle_id": 169,
      "start": 361.28,
      "end": 365.28,
      "text": "चल रहा है तो क्या इस अपॉर्चुनिटी का"
    },
    {
      "subtitle_id": 170,
      "start": 363.199,
      "end": 367.24,
      "text": "इंडिया फायदा ले पाती है यह तो वक्त ही"
    },
    {
      "subtitle_id": 171,
      "start": 365.28,
      "end": 369.36,
      "text": "बताएगा अब यह तो उन इंडस्ट्रीज की बात हुई"
    },
    {
      "subtitle_id": 172,
      "start": 367.24,
      "end": 371.759,
      "text": "जहां पर सेमी स्किल्ड या फिर कम पढ़े लिखे"
    },
    {
      "subtitle_id": 173,
      "start": 369.36,
      "end": 373.919,
      "text": "लोग काम कर सकते हैं पर वही अगर एजुकेटेड"
    },
    {
      "subtitle_id": 174,
      "start": 371.759,
      "end": 376.199,
      "text": "यूथ की बात करें तो वहां पर तो पिक्चर और"
    },
    {
      "subtitle_id": 175,
      "start": 373.919,
      "end": 377.8,
      "text": "भी भयानक है अगर करंट डटा को आप देखते हो"
    },
    {
      "subtitle_id": 176,
      "start": 376.199,
      "end": 379.759,
      "text": "तो इंडिया में आप जितने ज्यादा पढ़े लिखे"
    },
    {
      "subtitle_id": 177,
      "start": 377.8,
      "end": 381.759,
      "text": "हो उतने ज्यादा आपके अनइंप्लॉयमेंट के"
    },
    {
      "subtitle_id": 178,
      "start": 379.759,
      "end": 383.599,
      "text": "चांसेस हैं इस स्टेटमेंट पे आप गौर करिए"
    },
    {
      "subtitle_id": 179,
      "start": 381.759,
      "end": 385.56,
      "text": "क्योंकि ये एक बहुत ही डीप स्टेटमेंट है"
    },
    {
      "subtitle_id": 180,
      "start": 383.599,
      "end": 387.24,
      "text": "क्योंकि अगर आप इस डाटा को देखिए कि"
    },
    {
      "subtitle_id": 181,
      "start": 385.56,
      "end": 390.039,
      "text": "इंडिया में जो इलिटरेट है उनकी जो अन"
    },
    {
      "subtitle_id": 182,
      "start": 387.24,
      "end": 392.44,
      "text": "एंप्लॉयमेंट रेट है वो मात्र 1 टू 2 पर है"
    },
    {
      "subtitle_id": 183,
      "start": 390.039,
      "end": 394.88,
      "text": "और वही ग्रेजुएट्स की बात करें तो वह 15"
    },
    {
      "subtitle_id": 184,
      "start": 392.44,
      "end": 396.88,
      "text": "पर तक है और अगर आप वमन है तो वहां तो"
    },
    {
      "subtitle_id": 185,
      "start": 394.88,
      "end": 401.16,
      "text": "अनइंप्लॉयमेंट सिचुएशन और भी ज्यादा खराब"
    },
    {
      "subtitle_id": 186,
      "start": 396.88,
      "end": 403.039,
      "text": "है वहां पर यह नंबर चला जाता है 18.5 पर"
    },
    {
      "subtitle_id": 187,
      "start": 401.16,
      "end": 404.44,
      "text": "यानी जो इलिटरेट लोग हैं वहां पर महिलाएं"
    },
    {
      "subtitle_id": 188,
      "start": 403.039,
      "end": 406.08,
      "text": "को अच्छी जॉब्स मिलती है लेकिन अगर आप"
    },
    {
      "subtitle_id": 189,
      "start": 404.44,
      "end": 408.319,
