    },
    {
      "subtitle_id": 285,
      "start": 603.88,
      "end": 606.959,
      "text": "कोर्सेस करने पड़ते हैं ताकि वह"
    },
    {
      "subtitle_id": 286,
      "start": 605.16,
      "end": 608.92,
      "text": "टेक्नोलॉजी से अपडेट रहे और उसके बाद"
    },
    {
      "subtitle_id": 287,
      "start": 606.959,
      "end": 610.72,
      "text": "उन्हें जॉब मिले और जो ज्यादातर कॉलेजेस"
    },
    {
      "subtitle_id": 288,
      "start": 608.92,
      "end": 612.56,
      "text": "खुले जा रहे हैं उनका किसी का एक फोकस"
    },
    {
      "subtitle_id": 289,
      "start": 610.72,
      "end": 614.72,
      "text": "नहीं कि हम इनोवेशन या इन्वेंशन पे फोकस"
    },
    {
      "subtitle_id": 290,
      "start": 612.56,
      "end": 616.04,
      "text": "करें उनका फोकस यह है कि कैसे हम ज्यादा"
    },
    {
      "subtitle_id": 291,
      "start": 614.72,
      "end": 617.68,
      "text": "से ज्यादा फीस चार्ज करके ज्यादा से"
    },
    {
      "subtitle_id": 292,
      "start": 616.04,
      "end": 619.36,
      "text": "ज्यादा पैसा कमाएं ताकि हमारे लिए एक"
    },
    {
      "subtitle_id": 293,
      "start": 617.68,
      "end": 621.079,
      "text": "प्रॉफिटेबल बिजनेस बने और फिर इसकी 10"
    },
    {
      "subtitle_id": 294,
      "start": 619.36,
      "end": 623.16,
      "text": "ब्रांचेस हम खोले और हमारे नाम के 10"
    },
    {
      "subtitle_id": 295,
      "start": 621.079,
      "end": 625.6,
      "text": "कॉलेजेस खोले सो अगर रूट कॉज इस चीज का"
    },
    {
      "subtitle_id": 296,
      "start": 623.16,
      "end": 627.16,
      "text": "कोई है तो वो है एजुकेशन सिस्टम और उसके"
    },
    {
      "subtitle_id": 297,
      "start": 625.6,
      "end": 629.36,
      "text": "बाद गवर्नमेंट को फिर रिफॉर्म्स और"
    },
    {
      "subtitle_id": 298,
      "start": 627.16,
      "end": 630.839,
      "text": "कंप्लायंस पर काम करना पड़ेगा और दूसरी"
    },
    {
      "subtitle_id": 299,
      "start": 629.36,
      "end": 632.76,
      "text": "चीज यह है कि रेगुलेटरी कंप्ला सेस को"
    },
    {
      "subtitle_id": 300,
      "start": 630.839,
      "end": 634.64,
      "text": "आसान बनाना पड़ेगा जो गवर्नमेंट के बाबू"
    },
    {
      "subtitle_id": 301,
      "start": 632.76,
      "end": 636.72,
      "text": "रूल्स और रेगुलेशन बनाते हैं वो कई बार"
    },
    {
      "subtitle_id": 302,
      "start": 634.64,
      "end": 638.72,
      "text": "छोटे व्यापर के लिए समझना बहुत टफ हो जाता"
    },
    {
      "subtitle_id": 303,
      "start": 636.72,
      "end": 640.16,
      "text": "है और इसके चलते पूरा बिजनेस चलाना ही"
    },
    {
      "subtitle_id": 304,
      "start": 638.72,
      "end": 642.56,
      "text": "उनके लिए भारी हो जाता है जस्ट बिकॉज़ ऑफ"
    },
    {
      "subtitle_id": 305,
      "start": 640.16,
      "end": 644.639,
      "text": "द कंप्लायंसेज एंड रेगुलेशंस एक डाटा के"
    },
    {
      "subtitle_id": 306,
      "start": 642.56,
      "end": 647.56,
      "text": "माने तो एक आम व्यापारी एक छोटा व्यापारी"
    },
    {
      "subtitle_id": 307,
      "start": 644.639,
      "end": 649.48,
      "text": "अपना 16 पर ऑफ द टाइम इन रेगुलेशंस इन"
    },
    {
      "subtitle_id": 308,
      "start": 647.56,
      "end": 651.44,
      "text": "कंप्लायंसेज में ही लगा देता है तो इन"
    },
    {
      "subtitle_id": 309,
      "start": 649.48,
      "end": 653.92,
      "text": "कंप्लायंसेज को बहुत आसान करने की यहां पर"
    },
    {
      "subtitle_id": 310,
      "start": 651.44,
      "end": 655.639,
      "text": "जरूरत है इनफैक्ट कई सारे बिजनेसेस तो ऐसे"
    },
    {
      "subtitle_id": 311,
      "start": 653.92,
      "end": 657.639,
      "text": "हैं कि जिन्हें कई बार अलग-अलग चीजों के"
    },
    {
      "subtitle_id": 312,
      "start": 655.639,
      "end": 659.72,
      "text": "लिए गवर्नमेंट अप्रूवल लेने पड़ते हैं और"
    },
    {
      "subtitle_id": 313,
      "start": 657.639,
      "end": 661.76,
      "text": "उसमें इतना टाइम चला जाता है और इतनी"
    },
    {
      "subtitle_id": 314,
      "start": 659.72,
      "end": 663.48,
      "text": "क्रेजी रिक्वायरमेंट्स होती है जिसके चलते"
    },
    {
      "subtitle_id": 315,
      "start": 661.76,
      "end": 665.44,
      "text": "जो काम आज शुरू हो सकता है व शुरू होने"
    },
    {
      "subtitle_id": 316,
      "start": 663.48,
      "end": 667.48,
      "text": "में 2 साल लग जाता है बीच में कई सारे लोग"
    },
    {
      "subtitle_id": 317,
      "start": 665.44,
      "end": 668.76,
      "text": "गिव अप कर देते हैं और यही फीडबैक और"
    },
    {
      "subtitle_id": 318,
      "start": 667.48,
      "end": 670.839,
      "text": "रिस्पांस आपको इंडिया के कई सारे"
    },
    {
      "subtitle_id": 319,
      "start": 668.76,
      "end": 672.8,
      "text": "बिजनेसमैन का आज दिखेगा तो पॉइंट ये है कि"
    },
    {
      "subtitle_id": 320,
      "start": 670.839,
      "end": 674.839,
      "text": "अगर इंडिया में एजुकेशनल और बिजनेस"
    },
    {
      "subtitle_id": 321,
      "start": 672.8,
      "end": 677.44,
      "text": "रिलेटेड बड़े रिफॉर्म्स नहीं आते हैं तो"
    },
    {
      "subtitle_id": 322,
      "start": 674.839,
      "end": 679.639,
      "text": "ये चीजें ऐसे ही चलती रहेगी और आगे चलके"
    },
    {
      "subtitle_id": 323,
      "start": 677.44,
      "end": 681.399,
      "text": "डाटा और भी वर्स होगा और 2 साल बाद फिर"
    },
    {
      "subtitle_id": 324,
      "start": 679.639,
      "end": 683.519,
      "text": "मुझे इससे भी ज्यादा भयानक नंबर्स लेकर"
    },
    {
      "subtitle_id": 325,
      "start": 681.399,
      "end": 684.959,
      "text": "आपके सामने आना पड़ेगा हम नहीं चाहते कि"
    },
    {
      "subtitle_id": 326,
      "start": 683.519,
      "end": 686.88,
      "text": "इस टॉपिक पर हमें वीडियो बनाना पड़े और"
    },
    {
      "subtitle_id": 327,
      "start": 684.959,
      "end": 689.279,
      "text": "बनाना भी पड़े तो अच्छे नंबर्स के साथ एक"
    },
    {
      "subtitle_id": 328,
      "start": 686.88,
      "end": 690.6,
      "text": "पॉजिटिविटी के साथ बनाना पड़े इनफैक्ट नया"
    },
    {
      "subtitle_id": 329,
      "start": 689.279,
      "end": 692.2,
      "text": "रिफॉर्म आता है तो उसे समझाने के लिए"
    },
    {
      "subtitle_id": 330,
      "start": 690.6,
      "end": 694.24,
      "text": "बनाना पड़े जो बिजनेसमैन के लिए और"
    },
    {
      "subtitle_id": 331,
      "start": 692.2,
      "end": 696.399,
      "text": "ग्रेजुएट्स के लिए बहुत हेल्पफुल हो तो"
    },
    {
      "subtitle_id": 332,
      "start": 694.24,
      "end": 698.44,
      "text": "आपके क्या विचार हैं जॉब्स ज्यादा क्रिएट"
    },
    {
      "subtitle_id": 333,
      "start": 696.399,
      "end": 700.36,
      "text": "करने के लिए आपके क्या सॉल्यूशंस है नीचे"
    },
    {
      "subtitle_id": 334,
      "start": 698.44,
      "end": 702.2,
      "text": "कमेंट करके जरूर बताइए और उस सॉल्यूशन को"
    },
    {
      "subtitle_id": 335,
      "start": 700.36,
      "end": 704.0,
      "text": "हम कैसे इंप्लीमेंट कर सकते हैं यह भी"
    },
    {
      "subtitle_id": 336,
      "start": 702.2,
      "end": 706.24,
      "text": "जरूर बताइए हम उन चीजों से जरूर कुछ"
    },
    {
      "subtitle_id": 337,
      "start": 704.0,
      "end": 708.12,
      "text": "पॉजिटिव पॉइंट्स उठाकर एक वीडियो बनाने की"
    },
    {
      "subtitle_id": 338,
      "start": 706.24,
      "end": 710.399,
      "text": "कोशिश करेंगे ताकि इसके और डिटेल"
    },
    {
      "subtitle_id": 339,
      "start": 708.12,
      "end": 712.68,
      "text": "सॉल्यूशंस हम सबके सामने रहे सो यहीं पर"
    },
    {
      "subtitle_id": 340,
      "start": 710.399,
      "end": 714.44,
      "text": "रुकते हैं इस जैसे डिटेल वीडियोस बनाने के"
    },
    {
      "subtitle_id": 341,
      "start": 712.68,
      "end": 716.24,
      "text": "लिए बहुत ज्यादा रिसर्च हमारी रिसर्च टीम"
    },
    {
      "subtitle_id": 342,
      "start": 714.44,
      "end": 718.24,
      "text": "को करनी पड़ती है तो आपका एक लाइक हमें"
    },
    {
      "subtitle_id": 343,
      "start": 716.24,
      "end": 720.12,
      "text": "बहुत ज्यादा मोटिवेट करता है और इस तरह के"
    },
    {
      "subtitle_id": 344,
      "start": 718.24,
      "end": 721.639,
      "text": "वीडियोस बनाने के लिए और अगर आपने चैनल को"
    },
    {
      "subtitle_id": 345,
      "start": 720.12,
      "end": 723.36,
      "text": "सब्सक्राइब नहीं किया है तो चैनल को"
    },
    {
      "subtitle_id": 346,
      "start": 721.639,
      "end": 726.32,
      "text": "सब्सक्राइब करके बेल आइकन पर जरूर क्लिक"
    },
    {
      "subtitle_id": 347,
      "start": 723.36,
      "end": 728.88,
      "text": "करें इसी तरह के अनबाय नॉन पॉलिटिकल"
    },
    {
      "subtitle_id": 348,
      "start": 726.32,
      "end": 730.839,
      "text": "रिसर्च वीडियोस हम आपके लिए हर हफ्ते लेकर"
    },
    {
      "subtitle_id": 349,
      "start": 728.88,
      "end": 733.6,
      "text": "आते हैं मिलते हैं अगली वीडियो में थैंक"
    },
    {
      "subtitle_id": 350,
      "start": 730.839,
      "end": 736.48,
      "text": "यू सो मच फॉर वाचिंग दिस वीडियो थैंक"
    },
    {
      "subtitle_id": 351,
      "start": 733.6,
      "end": 737.959,
      "text": "यू जाते-जाते टो को जरूर चेक आउट कीजिए"
    },
    {
      "subtitle_id": 352,
      "start": 736.48,
      "end": 739.72,
      "text": "लिंक नीचे डिस्क्रिप्शन और कमेंट बॉक्स"
    },
    {
      "subtitle_id": 353,
      "start": 737.959,
      "end": 741.44,
      "text": "में दी गई है और जल्दी हेल्थ इंश्योरेंस"
    },
    {
      "subtitle_id": 354,
      "start": 739.72,
      "end": 744.8,
      "text": "लेकर अपने और अपने फैमिली का फ्यूचर"
    },
    {
      "subtitle_id": 355,
      "start": 741.44,
      "end": 744.8,
      "text": "सिक्योर बनाइए"
    }
  ]
}