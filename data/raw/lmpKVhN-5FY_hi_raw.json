    {
      "subtitle_id": 135,
      "start": 287.12,
      "end": 290.639,
      "text": "मिलेगा पर आपको इस दुनिया में फ्री में"
    },
    {
      "subtitle_id": 136,
      "start": 288.68,
      "end": 292.32,
      "text": "कुछ नहीं मिलता लेकिन यहां पर आपको फ्री"
    },
    {
      "subtitle_id": 137,
      "start": 290.639,
      "end": 293.8,
      "text": "में कैसे मिलेगा तो उसके लिए आपको जो"
    },
    {
      "subtitle_id": 138,
      "start": 292.32,
      "end": 296.08,
      "text": "प्रीमियम है वो थोड़ा एक्स्ट्रा पे करना"
