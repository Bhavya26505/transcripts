    {
      "subtitle_id": 147,
      "start": 309.52,
      "end": 312.96,
      "text": "नहीं लेना चाहिए जबकि बाकी सारे"
    },
    {
      "subtitle_id": 148,
      "start": 311.199,
      "end": 314.639,
      "text": "इनफ्लुएंसर कह रहे हैं कि आप वो ले लीजिए"
    },
    {
      "subtitle_id": 149,
      "start": 312.96,
      "end": 316.56,
      "text": "मैं थोड़ा कंफ्यूज हूं तो मेरी आपसे बस एक"
