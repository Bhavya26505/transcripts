    {
      "subtitle_id": 164,
      "start": 342.639,
      "end": 345.919,
      "text": "इस वीडियो में मिल जाएंगे नीरज का सवाल है"
    },
    {
      "subtitle_id": 165,
      "start": 344.36,
      "end": 348.039,
      "text": "कि टर्म इंश्योरेंस लेने से पहले हेल्थ"
    },
    {
      "subtitle_id": 166,
      "start": 345.919,
      "end": 350.199,
      "text": "इंश्योरेंस खुद चेकअप करवाना होता है या"
    },
    {
      "subtitle_id": 167,
      "start": 348.039,
      "end": 352.0,
      "text": "फिर कंपनीज करवाती है कंपनीज करवाती है"
    },
    {
      "subtitle_id": 168,
      "start": 350.199,
      "end": 353.72,
      "text": "मोस्ट ऑफ द केसेस में आपको घर के बाहर भी"
