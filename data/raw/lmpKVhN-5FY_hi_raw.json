    {
      "subtitle_id": 190,
      "start": 394.44,
      "end": 398.0,
      "text": "करने की जरूरत नहीं है वो सीधा आपके"
    },
    {
      "subtitle_id": 191,
      "start": 396.0,
      "end": 399.599,
      "text": "अकाउंट में आ जाएगा अगला सवाल पूछा गया है"
    },
    {
      "subtitle_id": 192,
      "start": 398.0,
      "end": 401.56,
      "text": "कि हाय सर थैंक यू फॉर दिस वीडियो"
    },
    {
      "subtitle_id": 193,
      "start": 399.599,
      "end": 403.4,
      "text": "क्वेश्चन ये है कि व्हाई टू टेक द टर्म"
    },
    {
      "subtitle_id": 194,
      "start": 401.56,
      "end": 405.36,
      "text": "इंश्योरेंस प्लान इफ वी कैन इन्वेस्ट इन"
    },
    {
      "subtitle_id": 195,
      "start": 403.4,
      "end": 407.24,
      "text": "एफडी एंड एसआईपी अगर हम एफडी एसआईपी में"
    },
    {
      "subtitle_id": 196,
      "start": 405.36,
      "end": 409.0,
      "text": "इन्वेस्ट कर रहे हैं कर सकते हैं तो फिर"
    },
    {
      "subtitle_id": 197,
      "start": 407.24,
      "end": 411.199,
      "text": "इंश्योरेंस अलग से लेने की जरूरत क्या है"
    },
    {
      "subtitle_id": 198,
      "start": 409.0,
      "end": 412.88,
      "text": "ऐसा ही कुछ मदन लाल ने भी सोचा था कि"
    },
    {
      "subtitle_id": 199,
      "start": 411.199,
      "end": 414.44,
      "text": "इंश्योरेंस में प्रीमियम भरने से पहले"
    },
    {
      "subtitle_id": 200,
      "start": 412.88,
      "end": 416.08,
      "text": "बेटर है कि उसके एसआईपी कर देते तो"
    },
    {
      "subtitle_id": 201,
      "start": 414.44,
      "end": 417.84,
      "text": "उन्होंने रेगुलर एसआईपी करना शुरू किया और"
    },
    {
      "subtitle_id": 202,
      "start": 416.08,
      "end": 419.56,
      "text": "तीन-चार साल में लगभग ₹ लाख उन्होंने"
    },
    {
      "subtitle_id": 203,
      "start": 417.84,
      "end": 420.96,
      "text": "इकट्ठा किए अच्छे खासे रिटर्न्स भी उस पर"
    },
    {
      "subtitle_id": 204,
      "start": 419.56,
      "end": 423.039,
      "text": "उन्हें मिल गए फिर अचानक एक दिन उनकी"
    },
    {
      "subtitle_id": 205,
      "start": 420.96,
      "end": 424.72,
      "text": "तबीयत खराब हुई हॉस्पिटलाइज हुए तो पता"
    },
    {
      "subtitle_id": 206,
      "start": 423.039,
      "end": 427.319,
      "text": "चला कि हार्ट में ब्लॉकेजेस है डॉक्टर ने"
    },
    {
      "subtitle_id": 207,
      "start": 424.72,
      "end": 429.68,
      "text": "बिल निकाला ₹ लाख का तो जो भी एसआईपी से"
    },
    {
      "subtitle_id": 208,
      "start": 427.319,
      "end": 431.639,
      "text": "अमाउंट बनी थी ₹ लाख सारी डॉक्टर को देनी"
    },
    {
      "subtitle_id": 209,
      "start": 429.68,
      "end": 433.919,
      "text": "पड़ी और इस तरह से उनकी इन्वेस्टमेंट पूरी"
    },
    {
      "subtitle_id": 210,
      "start": 431.639,
      "end": 435.8,
      "text": "तरह से चली गई तो देखिए दो चीजें जिसे"
    },
    {
      "subtitle_id": 211,
      "start": 433.919,
      "end": 438.68,
      "text": "आपको हमेशा सेपरेट रखना है अलग रखना है"
    },
    {
      "subtitle_id": 212,
      "start": 435.8,
      "end": 440.44,
      "text": "इंश्योरेंस जो आपकी सेफ्टी के लिए होता है"
    },
    {
      "subtitle_id": 213,
      "start": 438.68,
      "end": 442.44,
      "text": "रिस्क मैनेजमेंट के लिए होता है और दूसरा"
    },
    {
      "subtitle_id": 214,
      "start": 440.44,
      "end": 444.479,
      "text": "होता है आपका इन्वेस्टमेंट जो आपका वेल्थ"
    },
    {
      "subtitle_id": 215,
      "start": 442.44,
      "end": 446.4,
      "text": "क्रिएशन के लिए होता है अगला सवाल अमित"
    },
    {
      "subtitle_id": 216,
      "start": 444.479,
      "end": 448.28,
      "text": "पूछ रहे हैं इनका सवाल है कि सर टर्म"
    },
    {
      "subtitle_id": 217,
      "start": 446.4,
      "end": 450.68,
      "text": "इंश्योरेंस का प्रीमियम पूरी लाइफ सेम"
    },
    {
      "subtitle_id": 218,
      "start": 448.28,
      "end": 452.68,
      "text": "रहता है क्या जनरली यस अगर आपकी हेल्थ में"
    },
    {
      "subtitle_id": 219,
      "start": 450.68,
      "end": 454.56,
      "text": "कुछ चेंजेज नहीं आते हैं तो आपके जो टर्म"
    },
    {
      "subtitle_id": 220,
      "start": 452.68,
      "end": 456.56,
      "text": "इंश्योरेंस पॉलिसी का प्रीमियम है वो"
    },
    {
      "subtitle_id": 221,
      "start": 454.56,
      "end": 458.319,
      "text": "कंटीन्यूअसली सेम ही रहेगा बट कुछ केसेस"
    },
    {
      "subtitle_id": 222,
      "start": 456.56,
      "end": 460.52,
      "text": "में जैसे कि आप स्क्रीन पर देख सकते हो तो"
    },
    {
      "subtitle_id": 223,
      "start": 458.319,
      "end": 462.44,
      "text": "ये मटेरियल क्लॉस के हिसाब से अगर आपका"
    },
    {
      "subtitle_id": 224,
      "start": 460.52,
      "end": 464.36,
      "text": "ऑक्यूपेशन चेंज हो जाता है और जो नया काम"
    },
    {
      "subtitle_id": 225,
      "start": 462.44,
      "end": 466.479,
      "text": "है वो रिस्की है फॉर एग्जांपल अक्षय कुमार"
    },
    {
      "subtitle_id": 226,
      "start": 464.36,
      "end": 469.12,
      "text": "पहले कुक का काम करते थे बाद में वो एक्शन"
    },
    {
      "subtitle_id": 227,
      "start": 466.479,
      "end": 471.039,
      "text": "हीरो बन गए तो रिज बढ़ गई ना अब काम में"
    },
    {
      "subtitle_id": 228,
      "start": 469.12,
      "end": 473.159,
      "text": "रिज बढ़ गई तो इंश्योरेंस का प्रीमियम भी"
    },
    {
      "subtitle_id": 229,
      "start": 471.039,
      "end": 475.28,
      "text": "बढ़ेगा तो आपको ईमेल या कॉल करके ये सारी"
    },
    {
      "subtitle_id": 230,
      "start": 473.159,
      "end": 477.0,
      "text": "चीजें इंश्योरेंस कंपनीज को बतानी होती है"
    },
    {
      "subtitle_id": 231,
      "start": 475.28,
      "end": 478.759,
      "text": "कि अगर आपके काम में सडन चेंज आ जाता और"
    },
    {
      "subtitle_id": 232,
      "start": 477.0,
      "end": 480.52,
      "text": "वो काम थोड़ा रिस्की है पहले वाले से तो"
    },
    {
      "subtitle_id": 233,
      "start": 478.759,
      "end": 482.159,
      "text": "बेटर है कि आप पहले ही इंश्योरेंस कंपनीज"
    },
    {
      "subtitle_id": 234,
      "start": 480.52,
      "end": 484.0,
      "text": "को यह सारी चीजें बता दीजिए वीरेंद्र पूछ"
    },
    {
      "subtitle_id": 235,
      "start": 482.159,
      "end": 485.8,
      "text": "रहे हैं कि सीआरपीएफ का जॉब है गोली लगने"
    },
    {
      "subtitle_id": 236,
      "start": 484.0,
      "end": 487.56,
      "text": "से डेथ होने से क्लेम मिल जाएगा अब जनरली"
    },
    {
      "subtitle_id": 237,
      "start": 485.8,
      "end": 489.44,
      "text": "टर्म इंश्योरेंस कंपनीज आपका प्रोफेशन"
    },
    {
      "subtitle_id": 238,
      "start": 487.56,
      "end": 490.96,
      "text": "देखकर आपको इंश्योरेंस देती है तो अगर आप"
    },
    {
      "subtitle_id": 239,
      "start": 489.44,
      "end": 492.599,
      "text": "आर्मी में काम कर रहे तो ऑफकोर्स हाई"
    },
    {
      "subtitle_id": 240,
      "start": 490.96,
      "end": 494.44,
      "text": "रिस्की काम है तो इसलिए गवर्नमेंट ने"
    },
    {
      "subtitle_id": 241,
      "start": 492.599,
      "end": 496.56,
      "text": "स्कीम निकाली है स्पेसिफिकली फॉर आर्मी"
    },
    {
      "subtitle_id": 242,
      "start": 494.44,
      "end": 499.28,
      "text": "पर्सनल जिसमें एक तो है आर्मी ग्रुफ"
    },
    {
      "subtitle_id": 243,
      "start": 496.56,
      "end": 501.4,
      "text": "इंश्योरेंस फंड इसके अंडर आपको 20 से 40"
    },
    {
      "subtitle_id": 244,
      "start": 499.28,
      "end": 505.199,
      "text": "लाख तक का कवरेज आपको गवर्नमेंट देती है"
    },
    {
      "subtitle_id": 245,
      "start": 501.4,
      "end": 505.199,
      "text": "प्रीमियम भी अराउंड ₹2000000"
    },
    {
      "subtitle_id": 246,
      "start": 509.479,
      "end": 514.039,
      "text": "कि उन्होंने एक टर्म इंश्योरेंस खरीदा टिल"
    },
    {
      "subtitle_id": 247,
      "start": 511.36,
      "end": 515.68,
      "text": "द एज ऑफ 90 और 100 एंड उन्होंने कहा कि तब"
    },
    {
      "subtitle_id": 248,
      "start": 514.039,
      "end": 517.399,
      "text": "तक तो ऑफकोर्स मैं जिंदा नहीं रहूंगा"
    },
    {
      "subtitle_id": 249,
      "start": 515.68,
      "end": 519.279,
      "text": "लेकिन फिर भी मुझे इंश्योरेंस की अमाउंट"
    },
    {
      "subtitle_id": 250,
      "start": 517.399,
      "end": 521.76,
      "text": "मिल जाएगी कुछ लोग सोचते हैं कि 60 तक का"
    },
    {
      "subtitle_id": 251,
      "start": 519.279,
      "end": 523.76,
      "text": "टर्म इंश्योरेंस लूंगा तो जरूरी नहीं कि"
    },
    {
      "subtitle_id": 252,
      "start": 521.76,
      "end": 525.8,
      "text": "पैसा मिलेगा ही फैमिली को अगर मैं 100 तक"
    },
    {
      "subtitle_id": 253,
      "start": 523.76,
      "end": 527.32,
      "text": "का लेता हूं 90 100 तक का तब तो हाई"
    },
    {
      "subtitle_id": 254,
      "start": 525.8,
      "end": 529.56,
      "text": "प्रोबेबिलिटी है कि घर वालों को पैसा"
    },
    {
      "subtitle_id": 255,
      "start": 527.32,
      "end": 531.24,
      "text": "मिलना ही मिलना है तो बेटर है कि मैं 900"
    },
    {
      "subtitle_id": 256,
      "start": 529.56,
      "end": 533.48,
      "text": "वाला इंश्योरेंस लूं जहां पर पैसा मिलना"
    },
    {
      "subtitle_id": 257,
      "start": 531.24,
      "end": 535.6,
      "text": "लगभग तय है तो देखिए अब ये प्रैक्टिकली"
    },
    {
      "subtitle_id": 258,
      "start": 533.48,
      "end": 537.24,
      "text": "पॉसिबल तो है लेकिन एक थोड़ी सी दिक्कत है"
    },
    {
      "subtitle_id": 259,
      "start": 535.6,
      "end": 539.24,
      "text": "दिक्कत क्या है कि आप स्क्रीन पर देख सकते"
    },
    {
      "subtitle_id": 260,
      "start": 537.24,
      "end": 542.8,
      "text": "हैं 1 करोड़ का 60 की एज तक का प्रीमियम"
    },
    {
      "subtitle_id": 261,
      "start": 539.24,
      "end": 544.64,
      "text": "है अराउंड ₹1 181 जैसे मैंने यहां पर 99"
    },
    {
      "subtitle_id": 262,
      "start": 542.8,
      "end": 547.959,
      "text": "किया एज को अब आप देख सकते हैं कि कितना"
    },
    {
      "subtitle_id": 263,
      "start": 544.64,
      "end": 550.24,
      "text": "प्रीमियम आपको लगेगा ₹ 3887 मतलब कि आपको"
    },
    {
      "subtitle_id": 264,
      "start": 547.959,
      "end": 550.24,
      "text": "लगभग"
    },
    {
      "subtitle_id": 265,
      "start": 551.88,
      "end": 556.32,
      "text": "₹2500000 के एज में आप ऊपर चले जाते हो तो"
    },
    {
      "subtitle_id": 266,
      "start": 554.64,
      "end": 558.8,
      "text": "उस केस में आपको कितना प्रीमियम पे करना"
    },
    {
      "subtitle_id": 267,
      "start": 556.32,
      "end": 563.64,
      "text": "पड़ेगा चलो एक बेसिक कैलकुलेशन दिखाता हूं"
    },
    {
      "subtitle_id": 268,
      "start": 558.8,
      "end": 565.32,
      "text": "₹ 706 * 12 * 70 बीच में मतलब 70 साल आपको"
    },
    {
      "subtitle_id": 269,
      "start": 563.64,
      "end": 566.48,
      "text": "प्रीमियम पे करना पड़ेगा तो टोटल हो जाती"
    },
    {
      "subtitle_id": 270,
      "start": 565.32,
      "end": 568.959,
      "text": "है"
    },
    {
      "subtitle_id": 271,
      "start": 566.48,
      "end": 571.6,
      "text": "227304 तो कहा था ना छोटी सी प्रॉब्लम है"
    },
    {
      "subtitle_id": 272,
      "start": 568.959,
      "end": 573.44,
      "text": "छोटी सी प्रॉब्लम है ₹ लाख की उसके बाद"
    },
    {
      "subtitle_id": 273,
      "start": 571.6,
      "end": 575.399,
      "text": "हिमांशु का सवाल है कि कैन यू प्लीज"
    },
    {
      "subtitle_id": 274,
      "start": 573.44,
      "end": 577.079,
      "text": "एक्सप्लेन कि यूलिप स्कीम क्यों"
    },
    {
      "subtitle_id": 275,
      "start": 575.399,
      "end": 578.44,
      "text": "बेनिफिशियल नहीं है तो जैसे कि मैंने आपको"
    },
    {
      "subtitle_id": 276,
      "start": 577.079,
      "end": 580.8,
      "text": "जस्ट बताया कि आपको इंश्योरेंस और"
    },
    {
      "subtitle_id": 277,
      "start": 578.44,
      "end": 582.839,
      "text": "इन्वेस्टमेंट को अलग रखना है लेकिन यूलिप"
    },
    {
      "subtitle_id": 278,
      "start": 580.8,
      "end": 584.56,
      "text": "एगजैक्टली इसके अपोजिट करता है वो"
    },
    {
      "subtitle_id": 279,
      "start": 582.839,
      "end": 586.44,
      "text": "इंश्योरेंस और इन्वेस्टमेंट दोनों को"
    },
    {
      "subtitle_id": 280,
      "start": 584.56,
      "end": 587.92,
      "text": "मिक्स कर देता है तो पहली दिक्कत इसमें कि"
    },
    {
      "subtitle_id": 281,
      "start": 586.44,
      "end": 590.44,
      "text": "इसमें चार से पांच टाइप के बहुत बड़े-बड़े"
    },
    {
      "subtitle_id": 282,
      "start": 587.92,
      "end": 592.32,
      "text": "चार्जेस हैं जैसे कि आप ही पढ़िए प्रीमियम"
    },
    {
      "subtitle_id": 283,
      "start": 590.44,
      "end": 594.76,
      "text": "एलोकेशन चार्जेस पॉलिसी एडमिनिस्ट्रेशन"
    },
    {
      "subtitle_id": 284,
      "start": 592.32,
      "end": 596.76,
      "text": "चार्जेस फंड मैनेजमेंट चार्जेस मोर्टालिटी"
    },
    {
      "subtitle_id": 285,
      "start": 594.76,
      "end": 598.6,
      "text": "चार्जेस सरेंडर चार्जेस वगैरह वगैरह"
    },
    {
      "subtitle_id": 286,
      "start": 596.76,
      "end": 600.279,
      "text": "चार्जेस लेगी अगर आप सिंपली निफ्टी या"
    },
    {
      "subtitle_id": 287,
      "start": 598.6,
      "end": 601.88,
      "text": "सेंसेस का इंड एकस फंड खरीद लेते हो तो"
    },
    {
      "subtitle_id": 288,
      "start": 600.279,
      "end": 603.6,
      "text": "वहां से आपको कंपैरेटिव काफी बेहतर"
    },
    {
      "subtitle_id": 289,
      "start": 601.88,
      "end": 605.24,
      "text": "रिटर्न्स मिलेंगे इसी से रिलेटेड एक और"
    },
    {
      "subtitle_id": 290,
      "start": 603.6,
      "end": 607.36,
      "text": "सवाल है रंजीता का कि माय फ्रेंड हैज"
    },
    {
      "subtitle_id": 291,
      "start": 605.24,
      "end": 609.44,
      "text": "इन्वेस्टेड इन लाइफ इंश्योरेंस और ₹ लाख"
    },
    {
      "subtitle_id": 292,
      "start": 607.36,
      "end": 611.76,
      "text": "पे करने हैं 20 साल की एज तक और जो कवर"
    },
    {
      "subtitle_id": 293,
      "start": 609.44,
      "end": 614.56,
      "text": "उन्हें मिल रहा है ढ करोड़ का है 21 साल"
    },
    {
      "subtitle_id": 294,
      "start": 611.76,
      "end": 616.399,
      "text": "की एज से उन्हें ा लाख हर साल मिलना शुरू"
    },
    {
      "subtitle_id": 295,
      "start": 614.56,
      "end": 618.48,
      "text": "हो जाएंगे और उनके दोस्त ने उन्हें बताया"
    },
    {
      "subtitle_id": 296,
      "start": 616.399,
      "end": 620.6,
      "text": "कि एफडी से भी बेटर है सो क्या ये गुड"
    },
    {
      "subtitle_id": 297,
      "start": 618.48,
      "end": 622.2,
      "text": "ऑप्शन है तो रंजीत आपको बता दूं कि आपके"
    },
    {
      "subtitle_id": 298,
      "start": 620.6,
      "end": 624.2,
      "text": "फ्रेंड ने जिस स्कीम में इन्वेस्ट किया है"
    },
    {
      "subtitle_id": 299,
      "start": 622.2,
      "end": 625.8,
      "text": "उसका नाम है होल लाइफ इंश्योरेंस इस पर हम"
    },
    {
      "subtitle_id": 300,
      "start": 624.2,
      "end": 627.48,
      "text": "ऑलरेडी डेडिकेटेड वीडियो बना चुके हैं"
    },
    {
      "subtitle_id": 301,
      "start": 625.8,
      "end": 628.839,
      "text": "जिसे आप अगेन यहां पर क्लिक करके देख सकते"
    },
    {
      "subtitle_id": 302,
      "start": 627.48,
      "end": 630.92,
      "text": "हो अगेन रिटर्न्स आप देख रहे हो तो आप"
    },
    {
      "subtitle_id": 303,
      "start": 628.839,
      "end": 632.56,
      "text": "इन्वेस्ट ऑप्शन देखो और बहुत सेफ जाना है"
    },
    {
      "subtitle_id": 304,
      "start": 630.92,
      "end": 634.04,
      "text": "तो पीएफ आप कंसीडर कर सकते हैं थोड़ा"
    },
    {
      "subtitle_id": 305,
      "start": 632.56,
      "end": 635.44,
      "text": "रिस्क लेना है तो इंडेक्स फंड देख सकते"
    },
    {
      "subtitle_id": 306,
      "start": 634.04,
      "end": 637.16,
      "text": "हैं और रिस्क लेना है तो म्यूचुअल फंड है"
    },
    {
      "subtitle_id": 307,
      "start": 635.44,
      "end": 638.72,
      "text": "एक्टिव म्यूचुअल फंड्स और ज्यादा रिस्क"
    },
    {
      "subtitle_id": 308,
      "start": 637.16,
      "end": 640.279,
      "text": "में जाना है और समझ में आती है तो शेयर"
    },
    {
      "subtitle_id": 309,
      "start": 638.72,
      "end": 642.24,
      "text": "मार्केट की तरफ आप जा सकते हो ईश्वर का"
    },
    {
      "subtitle_id": 310,
      "start": 640.279,
      "end": 644.36,
      "text": "अगला सवाल यह है कि एक वीडियो सरल जीवन"
    },
    {
      "subtitle_id": 311,
      "start": 642.24,
      "end": 646.279,
      "text": "बीमा योजना पर भी बना दीजिए जो लोग टर्म"
    },
    {
      "subtitle_id": 312,
      "start": 644.36,
      "end": 648.0,
      "text": "इंश्योरेंस नहीं ले सकते वो लोग यह प्लान"
    },
    {
      "subtitle_id": 313,
      "start": 646.279,
      "end": 649.72,
      "text": "कैसे ले अगर कमेंट में और भी लोगों की ये"
    },
    {
      "subtitle_id": 314,
      "start": 648.0,
      "end": 651.639,
      "text": "रिक्वेस्ट आती है तो जरूर इसे हम कुछ ही"
    },
    {
      "subtitle_id": 315,
      "start": 649.72,
      "end": 653.8,
      "text": "दिन के अंदर कवर करेंगे एक आखिरी कमेंट"
    },
    {
      "subtitle_id": 316,
      "start": 651.639,
      "end": 655.76,
      "text": "में पढ़ रहा हूं पंकज की कि थैंक यू सो मच"
    },
    {
      "subtitle_id": 317,
      "start": 653.8,
      "end": 657.399,
      "text": "सर मैं कल ही लेने वाला था टर्म"
    },
    {
      "subtitle_id": 318,
      "start": 655.76,
      "end": 660.04,
      "text": "इंश्योरेंस प्लान अब सब कुछ क्लियर कर"
    },
    {
      "subtitle_id": 319,
      "start": 657.399,
      "end": 661.92,
      "text": "दिया है आपने सो आई लव योर चैनल सो ऐसे ही"
    },
    {
      "subtitle_id": 320,
      "start": 660.04,
      "end": 663.32,
      "text": "जो कमेंट्स है हमारा काफी मनोबल बढ़ाती है"
    },
    {
      "subtitle_id": 321,
      "start": 661.92,
      "end": 665.079,
      "text": "क्योंकि हर एक वीडियो के पीछे काफी सारा"
    },
    {
      "subtitle_id": 322,
      "start": 663.32,
      "end": 666.48,
      "text": "रिसर्च जाता है छोटी-छोटी चीजें देखने में"
    },
    {
      "subtitle_id": 323,
      "start": 665.079,
      "end": 668.44,
      "text": "उनका रिसर्च करने में क्योंकि इंश्योरेंस"
    },
    {
      "subtitle_id": 324,
      "start": 666.48,
      "end": 670.12,
      "text": "की इस इंडस्ट्री में डेटा काफी रेयर है"
    },
    {
      "subtitle_id": 325,
      "start": 668.44,
      "end": 672.2,
      "text": "जल्दी मिलता नहीं है तो कई बार हमें"
    },
    {
      "subtitle_id": 326,
      "start": 670.12,
      "end": 673.44,
      "text": "इंश्योरेंस कंपनीज के टॉप मैनेजमेंट के"
    },
    {
      "subtitle_id": 327,
      "start": 672.2,
      "end": 675.12,
      "text": "लोगों से बात करनी पड़ती है ऐसे-ऐसे"
    },
    {
      "subtitle_id": 328,
      "start": 673.44,
      "end": 677.16,
      "text": "डॉक्यूमेंट पढ़ने पड़ते हैं जो कि रेयरली"
    },
    {
      "subtitle_id": 329,
      "start": 675.12,
      "end": 678.92,
      "text": "अवेलेबल है तो ये कुछ सवाल है जिसमें आई"
    },
    {
      "subtitle_id": 330,
      "start": 677.16,
      "end": 680.6,
      "text": "होप आपकी सारी क्वेरीज सॉल्व हो चुकी"
    },
    {
      "subtitle_id": 331,
      "start": 678.92,
      "end": 682.88,
      "text": "होंगी अगर कोई भी क्वेरी आपकी सॉल्व नहीं"
    },
    {
      "subtitle_id": 332,
      "start": 680.6,
      "end": 684.68,
      "text": "हुई है अभी कमेंट कर दीजिए दो दिन के अंदर"
    },
    {
      "subtitle_id": 333,
      "start": 682.88,
      "end": 686.32,
      "text": "विद इन 48 आवर्स मैं खुद बेट पर इस पर"
    },
    {
      "subtitle_id": 334,
      "start": 684.68,
      "end": 688.12,
      "text": "रिप्लाई करूंगा ताकि आपकी क्वेरी सॉल्व हो"
    },
    {
      "subtitle_id": 335,
      "start": 686.32,
      "end": 689.839,
      "text": "जाए और अगर आपने अभी तक टर्म इंश्योरेंस"
    },
    {
      "subtitle_id": 336,
      "start": 688.12,
      "end": 691.32,
      "text": "नहीं लिया है तो आप अभी डिस्क्रिप्शन में"
    },
    {
      "subtitle_id": 337,
      "start": 689.839,
      "end": 693.04,
      "text": "दिए गई लिंक पर क्लिक करके अपने लिए टर्म"
    },
    {
      "subtitle_id": 338,
      "start": 691.32,
      "end": 695.0,
      "text": "इंश्योरेंस जरूर खरीद लीजिए क्योंकि आप"
    },
    {
      "subtitle_id": 339,
      "start": 693.04,
      "end": 696.72,
      "text": "जितना लेट करेंगे उतना प्रीमियम बढ़ता"
    },
    {
      "subtitle_id": 340,
      "start": 695.0,
      "end": 698.079,
      "text": "जाएगा जहां तक बात आती है कि मैंने कौन सा"
    },
    {
      "subtitle_id": 341,
      "start": 696.72,
      "end": 699.92,
      "text": "टर्म इंश्योरेंस प्लान लिया है तो मैक्स"
    },
    {
      "subtitle_id": 342,
      "start": 698.079,
      "end": 702.079,
      "text": "लेफ मैंने लिया है और मेरे फैमिली के कुछ"
    },
    {
      "subtitle_id": 343,
      "start": 699.92,
      "end": 703.56,
      "text": "मेंबर्स ने टा एआईए का प्लान लिया है टर्म"
    },
    {
      "subtitle_id": 344,
      "start": 702.079,
      "end": 705.2,
      "text": "इंश्योरेंस तो फिलहाल हम यहीं रुक जाते"
    },
    {
      "subtitle_id": 345,
      "start": 703.56,
      "end": 706.56,
      "text": "हैं थैंक यू सो मच फॉर वाचिंग दिस वीडियो"
    },
    {
      "subtitle_id": 346,
      "start": 705.2,
      "end": 707.959,
      "text": "मिलते हैं अगले वीडियो में अभी तक आपने"
    },
    {
      "subtitle_id": 347,
      "start": 706.56,
      "end": 711.8,
      "text": "चैनल को सब्सक्राइब नहीं किया है तो जरूर"
    },
    {
      "subtitle_id": 348,
      "start": 707.959,
      "end": 711.8,
      "text": "सब्सक्राइब कीजिए चलो बाय बाय"
    }
  ]
}