    {
      "subtitle_id": 99,
      "start": 220.159,
      "end": 223.2,
      "text": "हो जैसे मैं डिस्क्रिप्शन और कमेंट बॉक्स"
    },
    {
      "subtitle_id": 100,
      "start": 221.72,
      "end": 225.12,
      "text": "में दी गई लिंक पर क्लिक करके ये फॉर्म"
    },
    {
      "subtitle_id": 101,
      "start": 223.2,
      "end": 226.84,
      "text": "फिल करता हूं आपको दर्जनों टर्म प्लांस"
    },
    {
      "subtitle_id": 102,
      "start": 225.12,
      "end": 228.2,
      "text": "दिख जाते हैं और वहां से फिर आप आपके लिए"
    },
    {
      "subtitle_id": 103,
      "start": 226.84,
      "end": 229.84,
      "text": "जो सूटेबल है वो ढूंढ सकते हैं कैसे"
    },
    {
      "subtitle_id": 104,
      "start": 228.2,
      "end": 231.4,
      "text": "ढूंढना है इस पर ऑलरेडी हम कई बार बात कर"
    },
    {
      "subtitle_id": 105,
      "start": 229.84,
      "end": 233.2,
      "text": "चुके हैं इस वीडियो को अगेन आप देख सकते"
    },
    {
      "subtitle_id": 106,
      "start": 231.4,
      "end": 234.799,
      "text": "हो कि कैसे टर्म इंश्योरेंस ढूंढना है या"
    },
    {
      "subtitle_id": 107,
      "start": 233.2,
      "end": 236.68,
      "text": "फिर हेल्थ इंश्योरेंस अगर आपको ढूंढना है"
    },
    {
      "subtitle_id": 108,
      "start": 234.799,
      "end": 238.599,
      "text": "तो इनका जो पॉलिसी डॉक्यूमेंट है सारी"
    },
    {
      "subtitle_id": 109,
      "start": 236.68,
      "end": 240.36,
      "text": "चीजें आपको इसी वेबसाइट पर मिल जाती है 10"
    },
    {
      "subtitle_id": 110,
      "start": 238.599,
      "end": 242.0,
      "text": "जगह पर जाने की जरूरत नहीं पड़ती है यहां"
    },
    {
      "subtitle_id": 111,
      "start": 240.36,
      "end": 243.68,
      "text": "पर कंपैरिजन का ऑप्शन है साइड बाय साइड आप"
    },
    {
      "subtitle_id": 112,
      "start": 242.0,
      "end": 245.36,
      "text": "कंपेयर कर सकते हैं मल्टीपल इंश्योरेंस"
    },
    {
      "subtitle_id": 113,
      "start": 243.68,
      "end": 247.36,
      "text": "कंपनीज को और यहां पर एक फिल्टर का भी"
    },
    {
      "subtitle_id": 114,
      "start": 245.36,
      "end": 249.079,
      "text": "ऑप्शन है कि आपको क्या चाहिए क्या नहीं"
    },
    {
      "subtitle_id": 115,
      "start": 247.36,
      "end": 250.64,
      "text": "चाहिए वो भी आप अपनी रिक्वायरमेंट के"
    },
    {
      "subtitle_id": 116,
      "start": 249.079,
      "end": 252.519,
      "text": "हिसाब से कंपेयर कर सकते हो तो अगर आपने"
    },
    {
      "subtitle_id": 117,
      "start": 250.64,
      "end": 255.04,
      "text": "अभी तक टर्म इंश्योरेंस नहीं लिया है तो"
    },
    {
      "subtitle_id": 118,
      "start": 252.519,
      "end": 257.0,
      "text": "अभी जाइए और फॉर्म फिल कीजिए और बेस्ट"
    },
    {
      "subtitle_id": 119,
      "start": 255.04,
      "end": 258.799,
      "text": "अपने लिए जो टर्म इंश्योरेंस है वो खरीद"
    },
    {
      "subtitle_id": 120,
      "start": 257.0,
      "end": 261.199,
      "text": "लीजिए लिंक नीचे डिस्क्रिप्शन और कमेंट"
    },
    {
      "subtitle_id": 121,
      "start": 258.799,
      "end": 263.6,
      "text": "बॉक्स में दी गई अब अगला सवाल है कि ये"
    },
    {
      "subtitle_id": 122,
      "start": 261.199,
      "end": 265.4,
      "text": "आपने कई बार ऐड भी देखा होगा कि सर इज रो"
    },
    {
      "subtitle_id": 123,
      "start": 263.6,
      "end": 267.36,
      "text": "कॉस्ट टर्म इंश्योरेंस प्लान गुड और नॉट"
    },
    {
      "subtitle_id": 124,
      "start": 265.4,
      "end": 269.199,
      "text": "आजकल इंश्योरेंस कंपनीज नए-नए नाम से"
