    {
      "subtitle_id": 188,
      "start": 390.759,
      "end": 394.44,
      "text": "टैक्स फ्री है सो जो भी ₹ करोड़ ₹ करोड़"
    },
    {
      "subtitle_id": 189,
      "start": 393.0,
      "end": 396.0,
      "text": "आपको मिलेंगे उस पर आपको कोई टैक्स पे"
