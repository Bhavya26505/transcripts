  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.04,
      "end": 3.12,
      "text": "चाहे टर्म इंश्योरेंस हो या फिर हेल्थ"
    },
    {
      "subtitle_id": 2,
      "start": 1.52,
      "end": 5.12,
      "text": "इंश्योरेंस उन्हें खरीदने से पहले हमारे"
    },
    {
      "subtitle_id": 3,
      "start": 3.12,
      "end": 7.0,
      "text": "दिमाग में कुछ ऐसे यूनिक सवाल आते हैं"
    },
    {
      "subtitle_id": 4,
      "start": 5.12,
      "end": 8.679,
      "text": "जिनका जवाब हमें कहीं नहीं मिल पाता जैसे"
    },
    {
      "subtitle_id": 5,
      "start": 7.0,
      "end": 10.4,
      "text": "कई बार यह सवाल आता है कि नॉमिनी किसे"
    },
    {
      "subtitle_id": 6,
      "start": 8.679,
      "end": 12.0,
      "text": "रखें वाइफ को रखें या फिर मां को और फिर"
    },
    {
      "subtitle_id": 7,
      "start": 10.4,
      "end": 13.839,
      "text": "हार्दिक पांडे का केस सुनने के बाद फिर"
    },
    {
      "subtitle_id": 8,
      "start": 12.0,
      "end": 15.679,
      "text": "दिमाग में आता है कि क्या दोनों को नॉमिनी"
    },
    {
      "subtitle_id": 9,
      "start": 13.839,
      "end": 17.279,
      "text": "रख सकते हैं अगर हां तो उसकी प्रोसेस क्या"
    },
    {
      "subtitle_id": 10,
      "start": 15.679,
      "end": 19.199,
      "text": "है उसके बाद सवाल ये आता है कि कौन सी"
    },
    {
      "subtitle_id": 11,
      "start": 17.279,
      "end": 20.88,
      "text": "इंश्योरेंस कंपनी से इंश्योरेंस खरीदें"
    },
    {
      "subtitle_id": 12,
      "start": 19.199,
      "end": 22.84,
      "text": "कौन से राइडर ले क्या टर्म इंश्योरेंस"
    },
    {
      "subtitle_id": 13,
      "start": 20.88,
      "end": 24.76,
      "text": "लेने के लिए कोई एजुकेशनल क्वालिफिकेशन की"
    },
    {
      "subtitle_id": 14,
      "start": 22.84,
      "end": 26.48,
      "text": "जरूरत होती है उसके बाद आजकल ज़ीरो कॉस्ट"
    },
    {
      "subtitle_id": 15,
      "start": 24.76,
      "end": 28.08,
      "text": "टर्म इंश्योरेंस की काफी सारी ऐड्स चल रही"
    },
    {
      "subtitle_id": 16,
      "start": 26.48,
      "end": 29.679,
      "text": "है तो क्या सही में ऐसा कुछ एजिस्ट करता"
    },
    {
      "subtitle_id": 17,
      "start": 28.08,
      "end": 31.199,
      "text": "है और आखिर में मैं यह भी बता दूंगा कि"
    },
    {
      "subtitle_id": 18,
      "start": 29.679,
      "end": 32.92,
      "text": "मैंने कौन सा इंश्योरेंस लिया है कौन सी"
    },
    {
      "subtitle_id": 19,
      "start": 31.199,
      "end": 34.92,
      "text": "कंपनी से लिया है इसके अलावा और भी कई"
    },
    {
      "subtitle_id": 20,
      "start": 32.92,
      "end": 37.12,
      "text": "सारे यूनिक और एंटिक सवाल हैं जिसके जवाब"
    },
    {
      "subtitle_id": 21,
      "start": 34.92,
      "end": 38.6,
      "text": "आपको आज मिल जाएंगे और अगर कोई सवाल आपका"
    },
    {
      "subtitle_id": 22,
      "start": 37.12,
      "end": 40.64,
      "text": "ऐसा है जिसका जवाब इस वीडियो में आपको"
    },
    {
      "subtitle_id": 23,
      "start": 38.6,
      "end": 42.48,
      "text": "नहीं मिलता है नीचे कमेंट करके बताइए मैं"
    },
    {
      "subtitle_id": 24,
      "start": 40.64,
      "end": 44.68,
      "text": "पर्सनली उसका भी कमेंट करके आपको वही के"
    },
    {
      "subtitle_id": 25,
      "start": 42.48,
      "end": 46.44,
      "text": "वही जवाब दूंगा तो आज के इस वीडियो के बाद"
    },
    {
      "subtitle_id": 26,
      "start": 44.68,
      "end": 48.399,
      "text": "आपका कोई भी ऐसा सवाल नहीं रहेगा जिसका"
    },
    {
      "subtitle_id": 27,
      "start": 46.44,
      "end": 50.079,
      "text": "जवाब आपको ना मिले नमस्कार मैं प्रसाद"
    },
    {
      "subtitle_id": 28,
      "start": 48.399,
      "end": 52.92,
      "text": "आपका आज के इस वीडियो में स्वागत करता हूं"
    },
    {
      "subtitle_id": 29,
      "start": 50.079,
      "end": 54.68,
      "text": "शुरुआत करते हैं पहले सवाल से जो कि सबसे"
    },
    {
      "subtitle_id": 30,
      "start": 52.92,
      "end": 56.52,
      "text": "ज्यादा कॉमन तो दया पूछती है कि क्या"
    },
    {
      "subtitle_id": 31,
      "start": 54.68,
      "end": 58.44,
      "text": "पांचवी फेल को टर्म इंश्योरेंस मिल सकता"
    },
    {
      "subtitle_id": 32,
      "start": 56.52,
      "end": 60.44,
      "text": "है पांचवीं फेल को भी टर्म इंश्योरेंस मिल"
    },
    {
      "subtitle_id": 33,
      "start": 58.44,
      "end": 62.079,
      "text": "सकता है तो मोस्ट प्रैक्टिकली आप को इनकम"
    },
    {
      "subtitle_id": 34,
      "start": 60.44,
      "end": 64.04,
      "text": "प्रूफ देना पड़ता है वो आपके पास होना"
    },
    {
      "subtitle_id": 35,
      "start": 62.079,
      "end": 65.88,
      "text": "चाहिए क्योंकि अल्टीमेटली आपको प्रीमियम"
    },
    {
      "subtitle_id": 36,
      "start": 64.04,
      "end": 67.68,
      "text": "तो भरना पड़ेगा अगर आप सैलरीड एंप्लॉयड"
    },
    {
      "subtitle_id": 37,
      "start": 65.88,
      "end": 69.4,
      "text": "हैं तो आपको पिछले न महीने की सैलरी स्लिप"
    },
    {
      "subtitle_id": 38,
      "start": 67.68,
      "end": 71.32,
      "text": "सबमिट करनी पड़ेगी और अगर आप सेल्फ"
    },
    {
      "subtitle_id": 39,
      "start": 69.4,
      "end": 73.32,
      "text": "एंप्लॉयड हैं तो आपको पिछले 2 साल का"
    },
    {
      "subtitle_id": 40,
      "start": 71.32,
      "end": 75.6,
      "text": "आईटीआर देना पड़ेगा अगला सवाल पूछा है"
    },
    {
      "subtitle_id": 41,
      "start": 73.32,
      "end": 77.56,
      "text": "हार्दिक ने कि नॉमिनी किसे रख सकते हैं और"
    },
    {
      "subtitle_id": 42,
      "start": 75.6,
      "end": 79.119,
      "text": "क्या दो लोगों को नॉमिनी रख सकते हैं क्या"
    },
    {
      "subtitle_id": 43,
      "start": 77.56,
      "end": 80.72,
      "text": "अब ये दो लोगों का सवाल हार्दिक ने क्यों"
    },
    {
      "subtitle_id": 44,
      "start": 79.119,
      "end": 82.24,
      "text": "पूछा ये मुझे पता नहीं बट उसका जवाब मैं"
    },
    {
      "subtitle_id": 45,
      "start": 80.72,
      "end": 84.24,
      "text": "आपको दे देता हूं देखिए जनरली लोगों को"
    },
    {
      "subtitle_id": 46,
      "start": 82.24,
      "end": 86.0,
      "text": "लगता है कि नॉमिनी आप अपनी माता को पिता"
    },
    {
      "subtitle_id": 47,
      "start": 84.24,
      "end": 87.759,
      "text": "को हस्बैंड वाइफ उनको रख सकते हैं उनको तो"
    },
    {
      "subtitle_id": 48,
      "start": 86.0,
      "end": 90.119,
      "text": "रख ही सकते हैं लेकिन अगर आप लीगली बात"
    },
    {
      "subtitle_id": 49,
      "start": 87.759,
      "end": 92.399,
      "text": "करें तो आप हर उस इंसान को नॉमिनी रख सकते"
    },
    {
      "subtitle_id": 50,
      "start": 90.119,
      "end": 94.92,
      "text": "हैं जो आप पर फाइनेंशली डिपेंडेंट है जैसे"
    },
    {
      "subtitle_id": 51,
      "start": 92.399,
      "end": 96.96,
      "text": "कि आप इंश्योरेंस एक्ट 1938 का यह पार्ट"
    },
    {
      "subtitle_id": 52,
      "start": 94.92,
      "end": 99.04,
      "text": "स्क्रीन पर देख सकते हो इसके तहत आप उस"
    },
    {
      "subtitle_id": 53,
      "start": 96.96,
      "end": 101.36,
      "text": "किसी भी शख्स को नॉमिनी बना सकते हैं जो"
    },
    {
      "subtitle_id": 54,
      "start": 99.04,
      "end": 101.36,
      "text": "आप पर"
    },
    {
      "subtitle_id": 55,
      "start": 112.88,
      "end": 115.88,
      "text": "फाइनेंशियलीईएक्सप्रेस"
    },
    {
      "subtitle_id": 56,
      "start": 118.719,
      "end": 123.2,
      "text": "वाइफ को को दे देता है और फिर अगेन अपनी"
    },
    {
      "subtitle_id": 57,
      "start": 121.24,
      "end": 125.64,
      "text": "मां को वो नॉमिनी बनाता है सेकंड नॉमिनी"
    },
    {
      "subtitle_id": 58,
      "start": 123.2,
      "end": 128.399,
      "text": "और उन्हें 30 पर वेटेज देता है यानी कि"
    },
    {
      "subtitle_id": 59,
      "start": 125.64,
      "end": 130.64,
      "text": "अगर हार्दिक की डेथ होती है तो 70 पर कवर"
    },
    {
      "subtitle_id": 60,
      "start": 128.399,
      "end": 132.72,
      "text": "जो है वो हार्दिक की वाइफ को मिलेगा और 30"
    },
    {
      "subtitle_id": 61,
      "start": 130.64,
      "end": 134.44,
      "text": "पर हरदीप की मां को अब ये जो वेटेज है कि"
    },
    {
      "subtitle_id": 62,
      "start": 132.72,
      "end": 135.72,
      "text": "मां को कितना वेटेज देना है वाइफ को कितना"
    },
    {
      "subtitle_id": 63,
      "start": 134.44,
      "end": 137.56,
      "text": "देना है यह आप बदल सकते हैं अपनी"
    },
    {
      "subtitle_id": 64,
      "start": 135.72,
      "end": 139.36,
      "text": "रिक्वायरमेंट के हिसाब से 50-50 रख सकते"
    },
    {
      "subtitle_id": 65,
      "start": 137.56,
      "end": 141.0,
      "text": "हैं या जो भी प्रॉब्लम यह है कि बहुत सारे"
    },
    {
      "subtitle_id": 66,
      "start": 139.36,
      "end": 143.12,
      "text": "लोगों को यह पता नहीं है लेकिन ये ऑप्शन"
    },
    {
      "subtitle_id": 67,
      "start": 141.0,
      "end": 145.76,
      "text": "है और इसका बिल्कुल इस्तेमाल कीजिए राहुल"
    },
    {
      "subtitle_id": 68,
      "start": 143.12,
      "end": 148.36,
      "text": "का एक सवाल है जो सबसे ज्यादा सबसे ज्यादा"
    },
    {
      "subtitle_id": 69,
      "start": 145.76,
      "end": 150.48,
      "text": "मतलब सबसे ज्यादा पूछा जाता है वो यह है"
    },
    {
      "subtitle_id": 70,
      "start": 148.36,
      "end": 153.28,
      "text": "कि कौन सी कंपनी ट इंश्योरेंस के लिए"
    },
    {
      "subtitle_id": 71,
      "start": 150.48,
      "end": 155.16,
      "text": "बेस्ट है 2024 में आपका ओपिनियन बताइए अगर"
    },
    {
      "subtitle_id": 72,
      "start": 153.28,
      "end": 157.16,
      "text": "पोरली क्लेम सेटलमेंट रेशो की अगर मैं बात"
    },
    {
      "subtitle_id": 73,
      "start": 155.16,
      "end": 158.48,
      "text": "करूं टॉप जो फाइव कंपनीज है उसके नाम में"
    },
    {
      "subtitle_id": 74,
      "start": 157.16,
      "end": 159.36,
      "text": "आपके सामने रख देता हूं मैक्स लाइफ"
    },
    {
      "subtitle_id": 75,
      "start": 158.48,
      "end": 162.36,
      "text": "इंश्योरेंस"
    },
    {
      "subtitle_id": 76,
      "start": 159.36,
      "end": 162.36,
      "text": "99.5"
    },
    {
      "subtitle_id": 77,
      "start": 178.84,
      "end": 183.08,
      "text": "hdfc.com चीजें हम ऑलरेडी एक वीडियो में"
    },
    {
      "subtitle_id": 78,
      "start": 181.12,
      "end": 184.64,
      "text": "कवर कर चुके हैं तो इस वीडियो को देखकर"
    },
    {
      "subtitle_id": 79,
      "start": 183.08,
      "end": 186.239,
      "text": "आपको कौन सा टर्म इंश्योरेंस लेना है यह"
    },
    {
      "subtitle_id": 80,
      "start": 184.64,
      "end": 188.84,
      "text": "बड़ा क्लियर हो जाएंगे यहां पर तुप के"
    },
    {
      "subtitle_id": 81,
      "start": 186.239,
      "end": 190.64,
      "text": "कमेंट है कि बड़ा विवेक छोटा संदीप देखिए"
    },
    {
      "subtitle_id": 82,
      "start": 188.84,
      "end": 192.48,
      "text": "इसमें मेरा एक डिस्क्लेमर है कि इस वीडियो"
    },
    {
      "subtitle_id": 83,
      "start": 190.64,
      "end": 194.799,
      "text": "में या फिर पिछले हमारे कुछ वीडियो में जो"
    },
    {
      "subtitle_id": 84,
      "start": 192.48,
      "end": 197.4,
      "text": "भी एग्जांपल हम लेते हैं उनका किसी भी"
    },
    {
      "subtitle_id": 85,
      "start": 194.799,
      "end": 199.36,
      "text": "जीवित या मृत व्यक्ति से कोई भी लेना देना"
    },
    {
      "subtitle_id": 86,
      "start": 197.4,
      "end": 200.92,
      "text": "नहीं है अगला सवाल है सोमन दीप का जो कि"
    },
    {
      "subtitle_id": 87,
      "start": 199.36,
      "end": 202.72,
      "text": "हर एक आम आदमी का सवाल है शुरुआत में"
    },
    {
      "subtitle_id": 88,
      "start": 200.92,
      "end": 204.56,
      "text": "थोड़ी बहुत तारीफ की है ठीक है फिर वो आगे"
    },
    {
      "subtitle_id": 89,
      "start": 202.72,
      "end": 206.239,
      "text": "पूछते हैं कि पॉलिसी बाजार से लेना सही है"
    },
    {
      "subtitle_id": 90,
      "start": 204.56,
      "end": 208.68,
      "text": "कोई भी इंश्योरेंस और अगर आप टॉप फाइव"
    },
    {
      "subtitle_id": 91,
      "start": 206.239,
      "end": 210.4,
      "text": "कंपनीज बता दें जो सही है टर्म इंश्योरेंस"
    },
    {
      "subtitle_id": 92,
      "start": 208.68,
      "end": 211.84,
      "text": "के लिए कम प्रीमियम वाली कंपनीज देख रहा"
    },
    {
      "subtitle_id": 93,
      "start": 210.4,
      "end": 213.48,
      "text": "हूं ऐसा वो पूछ रहे हैं तो टॉप फाइव"
    },
    {
      "subtitle_id": 94,
      "start": 211.84,
      "end": 215.04,
      "text": "कंपनीज तो मैंने ऑलरेडी ऊपर बता दी जहां"
    },
    {
      "subtitle_id": 95,
      "start": 213.48,
      "end": 216.72,
      "text": "तक बात रही पॉलिसी बाजार की तो इंश्योरेंस"
    },
    {
      "subtitle_id": 96,
      "start": 215.04,
      "end": 218.36,
      "text": "से रिलेटेड लगभग हर वीडियो बनाने के लिए"
    },
    {
      "subtitle_id": 97,
      "start": 216.72,
      "end": 220.159,
      "text": "मैंने पॉलिसी बाजार वेबसाइट की काफी सारी"
    },
    {
      "subtitle_id": 98,
      "start": 218.36,
      "end": 221.72,
      "text": "मदद ली है जैसे कि आप स्क्रीन पर देख रहे"
