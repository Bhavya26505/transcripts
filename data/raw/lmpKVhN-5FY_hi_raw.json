    {
      "subtitle_id": 162,
      "start": 339.0,
      "end": 342.639,
      "text": "व्वर ऑफ प्रीमियम टर्मिनल इलनेस"
    },
    {
      "subtitle_id": 163,
      "start": 340.639,
      "end": 344.36,
      "text": "एक्सीडेंटल डेथ और इन सभी के डिटेल्स आपको"
