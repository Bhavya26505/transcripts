    {
      "subtitle_id": 125,
      "start": 267.36,
      "end": 271.0,
      "text": "इंश्योरेंस बेच रही है जैसे कि जीरो कॉस्ट"
    },
    {
      "subtitle_id": 126,
      "start": 269.199,
      "end": 273.08,
      "text": "टर्म रिटर्न ऑन मैच्योरिटी मैच्योरिटी"
    },
    {
      "subtitle_id": 127,
      "start": 271.0,
      "end": 275.36,
      "text": "बेनिफिट रिटर्न ऑफ प्रीमियम वगैरह वगैरह"
    },
    {
      "subtitle_id": 128,
      "start": 273.08,
      "end": 277.28,
      "text": "ये नाम अलग-अलग है वैसे ही जैसे शाहरुख"
    },
    {
      "subtitle_id": 129,
      "start": 275.36,
      "end": 279.72,
      "text": "खान के नाम अलग-अलग होते हैं जैसे कि एसआर"
    },
    {
      "subtitle_id": 130,
      "start": 277.28,
      "end": 282.32,
      "text": "के किंग खान बादशाह डॉन वगैरह वगैरह पर"
    },
    {
      "subtitle_id": 131,
      "start": 279.72,
      "end": 284.24,
      "text": "इंसान एक ही है वैसे ही मतलब ये जो चारों"
    },
    {
      "subtitle_id": 132,
      "start": 282.32,
      "end": 285.72,
      "text": "चीजें हैं इनका नाम अलग-अलग है अब इन"
