    {
      "subtitle_id": 177,
      "start": 367.36,
      "end": 371.24,
      "text": "सेक्शन एटीसी के अंडर आपको 5 लाख तक का"
    },
    {
      "subtitle_id": 178,
      "start": 369.4,
      "end": 373.4,
      "text": "टैक्स डिडक्शन मिलता है मान लीजिए आपकी"
    },
    {
      "subtitle_id": 179,
      "start": 371.24,
      "end": 375.96,
      "text": "टैक्सेबल इनकम ₹10 लाख की है और आप साल के"
    },
    {
      "subtitle_id": 180,
      "start": 373.4,
      "end": 378.36,
      "text": "₹5000000 का प्रीमियम पे करते हो तब आपका"
    },
    {
      "subtitle_id": 181,
      "start": 375.96,
      "end": 380.4,
      "text": "टैक्सेबल इनकम जो है वो 9.5 लाख हो जाएगा"
    },
    {
      "subtitle_id": 182,
      "start": 378.36,
      "end": 382.28,
      "text": "50000 डिडक्ट हो जाएंगे अगर आप 30 पर"
    },
    {
      "subtitle_id": 183,
      "start": 380.4,
      "end": 384.56,
      "text": "टैक्स लैब में हो तो बड़ी आसानी से आपको"
    },
    {
      "subtitle_id": 184,
      "start": 382.28,
      "end": 386.599,
      "text": "15000 तक का फायदा यहां पर मिल सकता है और"
    },
    {
      "subtitle_id": 185,
      "start": 384.56,
      "end": 388.319,
      "text": "सबसे मजेदार बात है कि इसके अलावा क्लेम"
    },
    {
      "subtitle_id": 186,
      "start": 386.599,
      "end": 390.759,
      "text": "अमाउंट में भी आपको टैक्स बेनिफिट मिलता"
    },
    {
      "subtitle_id": 187,
      "start": 388.319,
      "end": 393.0,
      "text": "है क्लेम अमाउंट भी सेक्शन 10 डी के अंडर"
