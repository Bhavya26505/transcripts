    {
      "subtitle_id": 142,
      "start": 300.16,
      "end": 303.56,
      "text": "क्लिक करके देख सकते हो जहां पर हमने"
    },
    {
      "subtitle_id": 143,
      "start": 301.639,
      "end": 305.919,
      "text": "कैलकुलेशन के साथ सारी चीजें बताई है तो"
