    {
      "subtitle_id": 145,
      "start": 305.919,
      "end": 309.52,
      "text": "है तुषार का कि आप पहले ऐसे शख्स है जो"
    },
    {
      "subtitle_id": 146,
      "start": 307.84,
      "end": 311.199,
      "text": "बोल रहे हैं कि क्रिटिकल इलनेस राइडर हमें"
