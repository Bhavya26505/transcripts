  "parsing_issues": [],
  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.04,
      "end": 4.799,
      "text": "रिसेंटली हमने देखा कि एक गवर्नमेंट कंपनी"
    },
    {
      "subtitle_id": 2,
      "start": 2.159,
      "end": 6.759,
      "text": "का आईओ आया ₹ 332 उसकी इशू प्राइस थी"
    },
    {
      "subtitle_id": 3,
      "start": 4.799,
      "end": 8.76,
      "text": "कंपनी के लिस्टिंग ही 100% से ज्यादा पर"
    },
    {
      "subtitle_id": 4,
      "start": 6.759,
      "end": 10.32,
      "text": "हुई और उसके बाद कंपनी के शेयर प्राइस"
    },
    {
      "subtitle_id": 5,
      "start": 8.76,
      "end": 12.719,
      "text": "रुकने का नाम ही नहीं ले रही है फिलहाल"
    },
    {
      "subtitle_id": 6,
      "start": 10.32,
      "end": 15.24,
      "text": "कंपनी के शेयर प्राइस ₹10 के करीब चल रही"
    },
    {
      "subtitle_id": 7,
      "start": 12.719,
      "end": 17.52,
      "text": "है मतलब कि ₹ 332 के आईपीओ प्राइस पर आने"
    },
    {
      "subtitle_id": 8,
      "start": 15.24,
      "end": 19.52,
      "text": "वाली एक कंपनी ₹10 पर चली जाती है कुछ ही"
    },
    {
      "subtitle_id": 9,
      "start": 17.52,
      "end": 22.199,
      "text": "दिनों में तो सवाल यह आता है कि क्या यह"
    },
    {
      "subtitle_id": 10,
      "start": 19.52,
      "end": 24.76,
      "text": "ग्रोथ सस्टेनेबल है यहां से कंपनी इसी तरह"
    },
    {
      "subtitle_id": 11,
      "start": 22.199,
      "end": 26.56,
      "text": "से आगे बढ़ती रहेगी या फिर यह कुछ बबल चल"
    },
    {
      "subtitle_id": 12,
      "start": 24.76,
      "end": 28.439,
      "text": "रहा है और जो भी मैं रीजनिंग दूंगा उसके"
    },
    {
      "subtitle_id": 13,
      "start": 26.56,
      "end": 30.48,
      "text": "पीछे बहुत ही स्ट्रांग लॉजिक दूंगा तो इस"
    },
    {
      "subtitle_id": 14,
      "start": 28.439,
      "end": 32.68,
      "text": "वीडियो को अंत तक जरूर देखें ताकि आपको"
    },
    {
      "subtitle_id": 15,
      "start": 30.48,
      "end": 34.6,
      "text": "सारी चीजें अच्छे से पता चले और हां बहुत"
    },
    {
      "subtitle_id": 16,
      "start": 32.68,
      "end": 36.92,
      "text": "सारे लोग इस कंपनी को आईआरएफसी से जनरली"
    },
    {
      "subtitle_id": 17,
      "start": 34.6,
      "end": 39.64,
      "text": "कंपेयर कर रहे हैं तो क्या वो कंपैरिजन"
    },
    {
      "subtitle_id": 18,
      "start": 36.92,
      "end": 41.559,
      "text": "सही है इसके बारे में भी हम चर्चा करेंगे"
    },
    {
      "subtitle_id": 19,
      "start": 39.64,
      "end": 43.6,
      "text": "नमस्कार मैं प्रसाद आपका आज के इस वीडियो"
    },
    {
      "subtitle_id": 20,
      "start": 41.559,
      "end": 46.0,
      "text": "में स्वागत करता हूं देखिए आईआईडीए अब"
    },
    {
      "subtitle_id": 21,
      "start": 43.6,
      "end": 47.8,
      "text": "लंबी रेस का घोड़ा है या नहीं यह समझने के"
    },
    {
      "subtitle_id": 22,
      "start": 46.0,
      "end": 50.199,
      "text": "लिए थोड़ा हमें यह समझना पड़ेगा कि सरकार"
    },
    {
      "subtitle_id": 23,
      "start": 47.8,
      "end": 52.96,
      "text": "ने आखिर आईआरडीए को शुरू क्यों किया और"
    },
    {
      "subtitle_id": 24,
      "start": 50.199,
      "end": 56.12,
      "text": "उसका मेन पर्पस क्या है 1970 में अब तक का"
    },
    {
      "subtitle_id": 25,
      "start": 52.96,
      "end": 58.12,
      "text": "सबसे बड़ा ऑयल क्राइसिस हुआ जिसमें इंडिया"
    },
    {
      "subtitle_id": 26,
      "start": 56.12,
      "end": 60.28,
      "text": "को काफी कुछ झेलना पड़ा अब आपको पता है कि"
    },
    {
      "subtitle_id": 27,
      "start": 58.12,
      "end": 62.0,
      "text": "इंडिया तो ऑयल इंपोर्ट करता है तो 197 23"
    },
    {
      "subtitle_id": 28,
      "start": 60.28,
      "end": 64.72,
      "text": "में इंडिया का जो ऑयल बिल था वो 500"
    },
    {
      "subtitle_id": 29,
      "start": 62.0,
      "end": 67.119,
      "text": "मिलियन डॉलर था अगले ही साल वो चला गया"
    },
    {
      "subtitle_id": 30,
      "start": 64.72,
      "end": 68.92,
      "text": "1.3 बिलियन डॉलर पर अब इससे इंडिया को"
    },
    {
      "subtitle_id": 31,
      "start": 67.119,
      "end": 70.64,
      "text": "काफी बड़ा नुकसान हुआ अब इंडिया को इससे"
    },
    {
      "subtitle_id": 32,
      "start": 68.92,
      "end": 73.32,
      "text": "एक अच्छी सीख मिली कि हम ऑयल पर ज्यादा"
    },
    {
      "subtitle_id": 33,
      "start": 70.64,
      "end": 75.28,
      "text": "निर्भर नहीं रह सकते तो इसीलिए हमें कोई"
    },
    {
      "subtitle_id": 34,
      "start": 73.32,
      "end": 78.04,
      "text": "और सोर्स ढूंढना पड़ेगा और वो सोर्स क्या"
    },
    {
      "subtitle_id": 35,
      "start": 75.28,
      "end": 80.36,
      "text": "था कोल यानी कोयला कोयले पर इन्होंने काम"
    },
    {
      "subtitle_id": 36,
      "start": 78.04,
      "end": 81.92,
      "text": "करना शुरू किया लेकिन पूरी दुनिया में आज"
    },
    {
      "subtitle_id": 37,
      "start": 80.36,
      "end": 83.56,
      "text": "की डेट में हम देखते हैं कि हर कोई कार्बन"
    },
    {
      "subtitle_id": 38,
      "start": 81.92,
      "end": 85.64,
      "text": "एमिशन की बात करता है लेकिन पूरी दुनिया"
    },
    {
      "subtitle_id": 39,
      "start": 83.56,
      "end": 87.96,
      "text": "में अगर कोई ऐसी पहली कंट्री थी जिसने"
    },
    {
      "subtitle_id": 40,
      "start": 85.64,
      "end": 90.36,
      "text": "इसके बारे में तब सोचा था तो वो था हमारा"
    },
    {
      "subtitle_id": 41,
      "start": 87.96,
      "end": 92.159,
      "text": "भारत और इसीलिए उसी टाइम से से हमारे देश"
    },
    {
      "subtitle_id": 42,
      "start": 90.36,
      "end": 94.399,
      "text": "की जो प्रायोरिटी थी वो थी कि जल्द से"
    },
    {
      "subtitle_id": 43,
      "start": 92.159,
      "end": 96.64,
      "text": "जल्द रिन्यूएबल पावर को डेवलप करना है अब"
    },
    {
      "subtitle_id": 44,
      "start": 94.399,
      "end": 99.84,
      "text": "इसीलिए उन्होंने 1970 में ही एक कमीशन"
    },
    {
      "subtitle_id": 45,
      "start": 96.64,
      "end": 102.159,
      "text": "बनाई जिसके तहत 1982 में मिनिस्ट्री ऑफ"
    },
    {
      "subtitle_id": 46,
      "start": 99.84,
      "end": 104.479,
      "text": "एनर्जी के अंडर एक और डिपार्टमेंट बनाया"
    },
    {
      "subtitle_id": 47,
      "start": 102.159,
      "end": 106.6,
      "text": "गया जिसका नाम रखा गया डिपार्टमेंट ऑफ नॉन"
    },
    {
      "subtitle_id": 48,
      "start": 104.479,
      "end": 108.759,
      "text": "कन्वेंशनल एनर्जी सोर्सेस जिसका नाम बाद"
    },
    {
      "subtitle_id": 49,
      "start": 106.6,
      "end": 110.719,
      "text": "में चेंज करके मिनिस्ट्री ऑफ नॉन एंड"
    },
    {
      "subtitle_id": 50,
      "start": 108.759,
      "end": 112.2,
      "text": "रिन्यूएबल एनर्जी किया गया अब ऐसा करने"
    },
    {
      "subtitle_id": 51,
      "start": 110.719,
      "end": 114.24,
      "text": "वाली यानी रिन्यूएबल एनर्जी के लिए"
    },
    {
      "subtitle_id": 52,
      "start": 112.2,
      "end": 116.799,
      "text": "डिपार्टमेंट बनाने वाली पूरी दुनिया में"
    },
    {
      "subtitle_id": 53,
      "start": 114.24,
      "end": 118.479,
      "text": "भारत पहली कंट्री थी अब सवाल यह आता है कि"
    },
    {
      "subtitle_id": 54,
      "start": 116.799,
      "end": 120.52,
      "text": "जो भी प्राइवेट कंपनीज हो या फिर"
    },
    {
      "subtitle_id": 55,
      "start": 118.479,
      "end": 122.399,
      "text": "गवर्नमेंट कंपनीज हो जो रिन्यूएबल एनर्जी"
    },
    {
      "subtitle_id": 56,
      "start": 120.52,
      "end": 124.0,
      "text": "सेक्टर में काम करना चाहती हैं उन्हें फंड"
    },
    {
      "subtitle_id": 57,
      "start": 122.399,
      "end": 126.119,
      "text": "कौन करेगा तो इसी प्रॉब्लम को सॉल्व करने"
    },
    {
      "subtitle_id": 58,
      "start": 124.0,
      "end": 127.68,
      "text": "के लिए आईआरडीए की शुरुआत की गई जिसका काम"
    },
    {
      "subtitle_id": 59,
      "start": 126.119,
      "end": 130.239,
      "text": "था कि रिन्यूएबल एनर्जी में जो भी अलग-अलग"
    },
    {
      "subtitle_id": 60,
      "start": 127.68,
      "end": 132.599,
      "text": "एनर्जी सेक्टर्स है जैसे कि सोलर विंड"
    },
    {
      "subtitle_id": 61,
      "start": 130.239,
      "end": 134.8,
      "text": "हाइड्रो बायोमास एटस उन सब प्रोजेक्ट्स को"
    },
    {
      "subtitle_id": 62,
      "start": 132.599,
      "end": 136.68,
      "text": "फंडिंग करना ताकि हम रिन्यूएबल एनर्जी को"
    },
    {
      "subtitle_id": 63,
      "start": 134.8,
      "end": 138.28,
      "text": "और बढ़ावा दे सके लेकिन अब इंपॉर्टेंट"
    },
    {
      "subtitle_id": 64,
      "start": 136.68,
      "end": 140.44,
      "text": "सवाल ये आता है कि इंडिया में अगर कोई"
    },
    {
      "subtitle_id": 65,
      "start": 138.28,
      "end": 142.76,
      "text": "रिन्यूएबल एनर्जी प्रोजेक्ट है प्राइवेट"
    },
    {
      "subtitle_id": 66,
      "start": 140.44,
      "end": 145.68,
      "text": "हो या फिर सरकारी हो क्या सिर्फ आईआरडीए"
    },
    {
      "subtitle_id": 67,
      "start": 142.76,
      "end": 147.44,
      "text": "ही उसको फंड कर सकती है तो जवाब है नहीं"
    },
    {
      "subtitle_id": 68,
      "start": 145.68,
      "end": 149.319,
      "text": "तो बहुत सारे लोग देखिए अलग-अलग तौर पर"
    },
    {
      "subtitle_id": 69,
      "start": 147.44,
      "end": 150.92,
      "text": "आईआरएफसी से इस कंपनी को कंपेयर कर रहे थे"
    },
    {
      "subtitle_id": 70,
      "start": 149.319,
      "end": 153.36,
      "text": "लेकिन आपको कुछ डायरेक्ट फर्क मैं आपको"
    },
    {
      "subtitle_id": 71,
      "start": 150.92,
      "end": 155.76,
      "text": "बता देता हूं पहला फर्क तो यही है कि"
    },
    {
      "subtitle_id": 72,
      "start": 153.36,
      "end": 157.519,
      "text": "आईआरएफसी क्लियर इंडियन रेलवेज को लोन"
    },
    {
      "subtitle_id": 73,
      "start": 155.76,
      "end": 159.599,
      "text": "देती है और एक ही एंटिटी को लोन देती है"
    },
    {
      "subtitle_id": 74,
      "start": 157.519,
      "end": 162.56,
      "text": "इंडियन रेलवेज को और कोई लोन नहीं दे सकता"
    },
    {
      "subtitle_id": 75,
      "start": 159.599,
      "end": 164.44,
      "text": "तो आईआरडीए के अलावा आरईसी और पीएफसी यानी"
    },
    {
      "subtitle_id": 76,
      "start": 162.56,
      "end": 166.2,
      "text": "पावर फाइनेंस कॉरपोरेशन ये दोनों भी"
    },
    {
      "subtitle_id": 77,
      "start": 164.44,
      "end": 168.12,
      "text": "रिन्यूएबल एनर्जी के जो भी प्रोजेक्ट से"
    },
    {
      "subtitle_id": 78,
      "start": 166.2,
      "end": 170.04,
      "text": "उन्हें फंड करते हैं हालांकि आरईसी और"
    },
    {
      "subtitle_id": 79,
      "start": 168.12,
      "end": 172.959,
      "text": "पीएफसी का जो शेयर है रिन्यूएबल एनर्जी का"
    },
    {
      "subtitle_id": 80,
      "start": 170.04,
      "end": 174.76,
      "text": "वो कम है कंपेयर्ड टू आईआरडीए बट है जरूर"
    },
    {
      "subtitle_id": 81,
      "start": 172.959,
      "end": 176.68,
      "text": "तो यहां पर हम ये नहीं कह सकते कि आईआरडी"
    },
    {
      "subtitle_id": 82,
      "start": 174.76,
      "end": 178.72,
      "text": "के पास कोई मोनोपोली है कि वो अकेले इस"
    },
    {
      "subtitle_id": 83,
      "start": 176.68,
      "end": 180.76,
      "text": "फील्ड में काम कर सकते हैं तो कंपटीशन है"
    },
    {
      "subtitle_id": 84,
      "start": 178.72,
      "end": 183.0,
      "text": "और आने वाले टाइम में भी आ सकती है अब"
    },
    {
      "subtitle_id": 85,
      "start": 180.76,
      "end": 184.72,
      "text": "दूसरी चीज आईआरडीए की और आईआरएफसी की आती"
    },
    {
      "subtitle_id": 86,
      "start": 183.0,
      "end": 186.4,
      "text": "है वो है एनपीए से रिलेटेड अब देखिए"
    },
    {
      "subtitle_id": 87,
      "start": 184.72,
      "end": 188.84,
      "text": "आईआरएफसी सिर्फ इंडियन रेलवेज को लोन"
    },
    {
      "subtitle_id": 88,
      "start": 186.4,
      "end": 190.64,
      "text": "चुकाते है और इसीलिए उनका जो एनपीए है वो"
    },
    {
      "subtitle_id": 89,
      "start": 188.84,
      "end": 192.2,
      "text": "जरो है और उनका मॉडल भी बहुत अलग है लीज"
    },
    {
      "subtitle_id": 90,
      "start": 190.64,
      "end": 193.84,
      "text": "मॉडल जनरली वो फॉलो करते हैं जिसमें उनका"
    },
    {
      "subtitle_id": 91,
      "start": 192.2,
      "end": 195.599,
      "text": "डिफॉल्ट कंपलीटली ज़ीरो है और आगे चलके भी"
    },
    {
      "subtitle_id": 92,
      "start": 193.84,
      "end": 197.0,
      "text": "वो ज़ीरो ही रहेगा लेकिन यहां पर आईआरडीए"
    },
    {
      "subtitle_id": 93,
      "start": 195.599,
      "end": 199.04,
      "text": "बहुत सारे प्राइवेट प्लेयर्स को भी लोन"
    },
    {
      "subtitle_id": 94,
      "start": 197.0,
      "end": 200.68,
      "text": "देती है जहां पर सरकार इसकी गारंटी नहीं"
    },
    {
      "subtitle_id": 95,
      "start": 199.04,
      "end": 203.159,
      "text": "लेती उन्होंने डिफॉल्ट किया तो आईआरडी को"
    },
    {
      "subtitle_id": 96,
      "start": 200.68,
      "end": 206.08,
      "text": "नुकसान झेलना पड़ेगा अब इसी चीज के चलते"
    },
    {
      "subtitle_id": 97,
      "start": 203.159,
      "end": 208.959,
      "text": "2021 में आईआरडीए का जो एनपीए था ग्रॉस"
    },
    {
      "subtitle_id": 98,
      "start": 206.08,
      "end": 211.239,
      "text": "एनपीए वो 8 पर के भी ऊपर चला गया जो कि एक"
    },
    {
      "subtitle_id": 99,
      "start": 208.959,
      "end": 212.84,
      "text": "काफी हाई गर मानी जाती है बाद में उसे"
    },
    {
      "subtitle_id": 100,
      "start": 211.239,
      "end": 214.519,
      "text": "कंट्रोल में लाया गया तो इस तरह से हम कह"
    },
    {
      "subtitle_id": 101,
      "start": 212.84,
      "end": 216.599,
      "text": "सकते हैं कि आईआरएफसी से इस कंपनी का हम"
    },
    {
      "subtitle_id": 102,
      "start": 214.519,
      "end": 218.72,
      "text": "डायरेक्ट कंपैरिजन नहीं कर सकते जनरली"
    },
    {
      "subtitle_id": 103,
      "start": 216.599,
      "end": 220.72,
      "text": "हमसे एक सवाल बहुत कॉमनली पूछा जाता है और"
    },
    {
      "subtitle_id": 104,
      "start": 218.72,
      "end": 222.84,
      "text": "यह है कि आप किसी भी कंपनी का रिसर्च कैसे"
    },
    {
      "subtitle_id": 105,
      "start": 220.72,
      "end": 224.599,
      "text": "करते हैं और यह कैसे डिसाइड करते हैं कि"
    },
    {
      "subtitle_id": 106,
      "start": 222.84,
      "end": 226.12,
      "text": "कौन सी कंपनी में इन्वेस्ट करना चाहिए और"
    },
    {
      "subtitle_id": 107,
      "start": 224.599,
      "end": 228.519,
      "text": "ऐसे कौन से फाइनेंशियल रेश्योस और"
    },
    {
      "subtitle_id": 108,
      "start": 226.12,
      "end": 230.56,
      "text": "मैट्रिक्स है जो हमें उस कंपनी को एनालाइज"
    },
    {
      "subtitle_id": 109,
      "start": 228.519,
      "end": 232.4,
      "text": "करने के लिए देखने हैं देखिए हर एक कंपनी"
    },
    {
      "subtitle_id": 110,
      "start": 230.56,
      "end": 234.56,
      "text": "यूनिक होती है आप किसी भी कंपनी को"
    },
    {
      "subtitle_id": 111,
      "start": 232.4,
      "end": 236.36,
      "text": "डायरेक्टली कंपेयर नहीं कर सकते उस कंपनी"
    },
    {
      "subtitle_id": 112,
      "start": 234.56,
      "end": 238.2,
      "text": "के यूएस पीस आपको देखने हैं और उसके लिए"
    },
    {
      "subtitle_id": 113,
      "start": 236.36,
      "end": 240.799,
      "text": "कुछ पर्टिकुलर फाइनेंशियल रेश्योस पर आपको"
    },
    {
      "subtitle_id": 114,
      "start": 238.2,
      "end": 242.68,
      "text": "फोकस करना पड़ेगा और ये सारी चीजें हमने"
    },
    {
      "subtitle_id": 115,
      "start": 240.799,
      "end": 244.799,
      "text": "सिखाई है हमारे फंडामेंटल एनालिसिस कोर्स"
    },
    {
      "subtitle_id": 116,
      "start": 242.68,
      "end": 247.2,
      "text": "में बहुत ही स्टेप बाय स्टेप मैनर में"
    },
    {
      "subtitle_id": 117,
      "start": 244.799,
      "end": 248.76,
      "text": "जिससे कोई भी बिगनर बड़ी आसानी से बहुत"
    },
    {
      "subtitle_id": 118,
      "start": 247.2,
      "end": 251.159,
      "text": "अच्छे तरीके से किसी भी कंपनी का"
    },
    {
      "subtitle_id": 119,
      "start": 248.76,
      "end": 254.76,
      "text": "फंडामेंटल एनालिसिस कर सकता है और यह पता"
    },
    {
      "subtitle_id": 120,
      "start": 251.159,
      "end": 257.76,
      "text": "कर सकता है कि वो कंपनी सही में"
    },
    {
      "subtitle_id": 121,
      "start": 254.76,
      "end": 257.76,
      "text": "फाइनेंशियलीईएक्सप्रेस"
    },
    {
      "subtitle_id": 122,
      "start": 265.44,
      "end": 271.08,
      "text": "पर फ्लैट ₹ 7700 का डिस्काउंट मिल रहा है"
    },
    {
      "subtitle_id": 123,
      "start": 268.6,
      "end": 273.12,
      "text": "यह ऑफर सिर्फ अगले 48 घंटे के लिए हैं तो"
    },
    {
      "subtitle_id": 124,
      "start": 271.08,
      "end": 274.6,
      "text": "इस ऑफर को बिल्कुल भी मिस ना होने दें इस"
    },
    {
      "subtitle_id": 125,
      "start": 273.12,
      "end": 276.479,
      "text": "कोर्स की लिंक आपको नीचे डिस्क्रिप्शन और"
    },
    {
      "subtitle_id": 126,
      "start": 274.6,
      "end": 278.28,
      "text": "कमेंट बॉक्स में दी गई है और आपको बता दूं"
    },
    {
      "subtitle_id": 127,
      "start": 276.479,
      "end": 279.96,
      "text": "कि पूरे इंडिया का एक अकेला शेयर मार्केट"
    },
    {
      "subtitle_id": 128,
      "start": 278.28,
      "end": 281.96,
      "text": "कोर्स है जहां पर आपको दी जाती है नो"
    },
    {
      "subtitle_id": 129,
      "start": 279.96,
      "end": 284.199,
      "text": "क्वेश्चन आस रिफंड पॉलिसी पांच दिनों के"
    },
    {
      "subtitle_id": 130,
      "start": 281.96,
      "end": 286.36,
      "text": "लिए और हमारे जो रिफंड रेट है वो लेस दन 1"
    },
    {
      "subtitle_id": 131,
      "start": 284.199,
      "end": 288.6,
      "text": "पर है तो वापस आते हैं आईआरडीए के"
    },
    {
      "subtitle_id": 132,
      "start": 286.36,
      "end": 290.44,
      "text": "एनालिसिस पर तो सवाल ये आता है कि अभी लोग"
    },
    {
      "subtitle_id": 133,
      "start": 288.6,
      "end": 292.639,
      "text": "इतने बुलिश क्यों है स्टॉक पर तो इसका"
    },
    {
      "subtitle_id": 134,
      "start": 290.44,
      "end": 294.32,
      "text": "जवाब आपको दो चीजों में मिल जाएगा पहला तो"
    },
    {
      "subtitle_id": 135,
      "start": 292.639,
      "end": 296.32,
      "text": "यह है कि इंडिया बहुत ज्यादा बुलिश है"
    },
    {
      "subtitle_id": 136,
      "start": 294.32,
      "end": 299.68,
      "text": "रिन्यूएबल एनर्जी सेक्टर पर हमारा यह"
    },
    {
      "subtitle_id": 137,
      "start": 296.32,
      "end": 301.479,
      "text": "टारगेट है कि 2030 तक हमारी 50 पर पावर की"
    },
    {
      "subtitle_id": 138,
      "start": 299.68,
      "end": 303.32,
      "text": "जो रिक्वायरमेंट है वो रिन्यूएबल एनर्जी"
    },
    {
      "subtitle_id": 139,
      "start": 301.479,
      "end": 305.919,
      "text": "फुलफिल करें ऐसा इंडिया का एक बहुत ही"
    },
    {
      "subtitle_id": 140,
      "start": 303.32,
      "end": 307.52,
      "text": "एंबिशियस मिशन है और इसीलिए गवर्नमेंट"
    },
    {
      "subtitle_id": 141,
      "start": 305.919,
      "end": 309.68,
      "text": "काफी पुश कर रही है रिन्यूएबल एनर्जी को"
    },
    {
      "subtitle_id": 142,
      "start": 307.52,
      "end": 311.56,
      "text": "इसीलिए आप रिन्यूएबल एनर्जी रिलेटेड जितने"
    },
    {
      "subtitle_id": 143,
      "start": 309.68,
      "end": 313.4,
      "text": "भी स्टॉक्स देखेंगे जो रिन्यूएबल एनर्जी"
    },
    {
      "subtitle_id": 144,
      "start": 311.56,
      "end": 316.44,
      "text": "पर बहुत फोकस कर रहे चाहे वो टा पावर हो"
    },
    {
      "subtitle_id": 145,
      "start": 313.4,
      "end": 318.919,
      "text": "लेक्ट्रा ग्रीनटेक हो टा मोटर्स है सुज डन"
    },
    {
      "subtitle_id": 146,
      "start": 316.44,
      "end": 320.84,
      "text": "एनर्जी है एनटीपीसी है एनएचपीसी है उन"
    },
    {
      "subtitle_id": 147,
      "start": 318.919,
      "end": 323.0,
      "text": "सबकी शेयर प्राइस आप देख लीजिए वो बहुत"
    },
    {
      "subtitle_id": 148,
      "start": 320.84,
      "end": 324.319,
      "text": "तेजी से आगे बढ़ रही है सो यह भी एक रीज़न"
    },
    {
      "subtitle_id": 149,
      "start": 323.0,
      "end": 325.84,
      "text": "है कि लोग बहुत ज्यादा बुलिश है बिकॉज़"
    },
    {
      "subtitle_id": 150,
      "start": 324.319,
      "end": 327.6,
      "text": "क्योंकि जो पूरी थीम है यह बहुत ज्यादा"
    },
    {
      "subtitle_id": 151,
      "start": 325.84,
      "end": 329.68,
      "text": "हॉट है उसके अलावा जो दूसरा रीज़न है वो"
    },
    {
      "subtitle_id": 152,
      "start": 327.6,
      "end": 330.919,
      "text": "है पीएसयू का कि फिलहाल पीएसयू बहुत"
    },
    {
      "subtitle_id": 153,
      "start": 329.68,
      "end": 332.6,
      "text": "ज्यादा दौड़ रहे हैं और किस तरह से दौड़"
    },
    {
      "subtitle_id": 154,
      "start": 330.919,
      "end": 334.199,
      "text": "रहे हैं आप इस ग्राफ से देख सकते हैं अब"
    },
    {
      "subtitle_id": 155,
      "start": 332.6,
      "end": 335.96,
      "text": "क्योंकि पीएसओ इतने ज्यादा दौड़ रहे है तो"
    },
    {
      "subtitle_id": 156,
      "start": 334.199,
      "end": 338.16,
      "text": "यह भी सरकारी कंपनीज है तो यह भी दौड़ रही"
    },
    {
      "subtitle_id": 157,
      "start": 335.96,
      "end": 339.88,
      "text": "है अब सवाल ये आता है कि क्या ये ग्रोथ"
    },
    {
      "subtitle_id": 158,
      "start": 338.16,
      "end": 341.4,
      "text": "सस्टेनेबल है या नहीं सबसे इंपॉर्टेंट"
    },
    {
      "subtitle_id": 159,
      "start": 339.88,
      "end": 343.16,
      "text": "सवाल देखिए अगर हम कंपनी की रेवेन्यू"
    },
    {
      "subtitle_id": 160,
      "start": 341.4,
      "end": 345.68,
      "text": "ग्रोथ की बात करें तो पिछले चार सालों में"
    },
    {
      "subtitle_id": 161,
      "start": 343.16,
      "end": 347.28,
      "text": "वो कंपाउंडेड सालाना 14 पर से बढ़ रही है"
    },
    {
      "subtitle_id": 162,
      "start": 345.68,
      "end": 349.479,
      "text": "अब देखिए यहां पर कंपनी का प्रॉफिट जरूर"
    },
    {
      "subtitle_id": 163,
      "start": 347.28,
      "end": 351.08,
      "text": "बढ़ा है और इसके पीछे एक मेन कारण यह भी"
    },
    {
      "subtitle_id": 164,
      "start": 349.479,
      "end": 353.68,
      "text": "है कि कंपनी के एक्सपेंसेस अचानक से कम"
    },
    {
      "subtitle_id": 165,
      "start": 351.08,
      "end": 355.6,
      "text": "हुए अब इसमें एक अहम रोल यह है कि कंपनी"
    },
    {
      "subtitle_id": 166,
      "start": 353.68,
      "end": 357.639,
      "text": "का जो बैड डेट है वो कंपनी ने क्लियर किया"
    },
    {
      "subtitle_id": 167,
      "start": 355.6,
      "end": 360.28,
      "text": "तो इसके पीछे दो रीजन है एक तो कंपनी के"
    },
    {
      "subtitle_id": 168,
      "start": 357.639,
      "end": 362.319,
      "text": "डिफॉल्ट कम हुए और पीछे के जो बैड डेट"
    },
    {
      "subtitle_id": 169,
      "start": 360.28,
      "end": 364.24,
      "text": "कंपनी के थे डिफॉल्टेड लोंस थे वो कंपनी"
    },
    {
      "subtitle_id": 170,
      "start": 362.319,
      "end": 366.0,
      "text": "ने बेज दिए इसके चलते अभी अगर देखें तो"
    },
    {
      "subtitle_id": 171,
      "start": 364.24,
      "end": 367.96,
      "text": "कंपनी की बैलेंस शीट भी अच्छी खासी क्लियर"
    },
    {
      "subtitle_id": 172,
      "start": 366.0,
      "end": 370.28,
      "text": "है और कंपनी की जो मार्जिन है वो भी बढ़ी"
    },
    {
      "subtitle_id": 173,
      "start": 367.96,
      "end": 372.8,
      "text": "हुई है लेकिन क्या ये आने वाले टाइम में"
    },
    {
      "subtitle_id": 174,
      "start": 370.28,
      "end": 375.16,
      "text": "भी सस्टेन करेगा इस पर एक बहुत बड़ा सवाल"
    },
    {
      "subtitle_id": 175,
      "start": 372.8,
      "end": 377.16,
      "text": "है क्योंकि हमने देखा है कि जब वर्स्ट"
    },
    {
      "subtitle_id": 176,
      "start": 375.16,
      "end": 378.96,
      "text": "कंडीशन आती है तो इस कंपनी के जो डिफॉल्ट"
    },
    {
      "subtitle_id": 177,
      "start": 377.16,
      "end": 380.759,
      "text": "रेट है वो बढ़ जाते हैं अब अगला सवाल आते"
    },
    {
      "subtitle_id": 178,
      "start": 378.96,
      "end": 382.56,
      "text": "है कि वैल्युएशन कहां तक सस्टेन करेंगे अब"
    },
    {
      "subtitle_id": 179,
      "start": 380.759,
      "end": 384.0,
      "text": "14 पर की आपकी रेवेन्यू ग्रोथ है प्रॉफिट"
    },
    {
      "subtitle_id": 180,
      "start": 382.56,
      "end": 386.039,
      "text": "ग्रोथ आपकी ज्यादा है पिछले 3 साल में"
    },
    {
      "subtitle_id": 181,
      "start": 384.0,
      "end": 388.24,
      "text": "इनका कंपाउंड रेड सालाना प्रॉफिट 59 पर से"
    },
    {
      "subtitle_id": 182,
      "start": 386.039,
      "end": 391.039,
      "text": "बढ़ा है लेकिन देखिए ये एक लिमिट तक"
    },
    {
      "subtitle_id": 183,
      "start": 388.24,
      "end": 393.28,
      "text": "बढ़ेगा अगर आपका रेवेन्यू 131 बढ़ रहा है"
    },
    {
      "subtitle_id": 184,
      "start": 391.039,
      "end": 396.08,
      "text": "प्रॉफिट 5960 बढ़ रहा है तो ये ज्यादा देर"
    },
    {
      "subtitle_id": 185,
      "start": 393.28,
      "end": 397.88,
      "text": "तक नहीं टिकता है दोनों को साइमल नियस"
    },
    {
      "subtitle_id": 186,
      "start": 396.08,
      "end": 399.52,
      "text": "बढ़ना होता है तो रेवेन्यू जब तक बहुत"
    },
    {
      "subtitle_id": 187,
      "start": 397.88,
      "end": 401.16,
      "text": "ज्यादा नहीं बढ़ेगा अब अगले दो-तीन सालों"
    },
    {
      "subtitle_id": 188,
      "start": 399.52,
      "end": 402.84,
      "text": "में आपको ये देखने मिलेगा कि धीरे-धीरे"
    },
    {
      "subtitle_id": 189,
      "start": 401.16,
      "end": 404.68,
      "text": "इनकी रेवेन्यू ग्रोथ कम होती जाएगी अगर"
    },
    {
      "subtitle_id": 190,
      "start": 402.84,
      "end": 406.479,
      "text": "इनका रेवेन्यू नहीं बढ़ा तो तो रेवेन्यू"
    },
    {
      "subtitle_id": 191,
      "start": 404.68,
      "end": 408.039,
      "text": "बढ़ना यहां पर बहुत इंपोर्टेंट है लेकिन"
    },
    {
      "subtitle_id": 192,
      "start": 406.479,
      "end": 410.0,
      "text": "यहां पर इस इंडस्ट्री में कंपटीशन भी"
    },
    {
      "subtitle_id": 193,
      "start": 408.039,
      "end": 411.919,
      "text": "अच्छी खासी है तो इसीलिए अगर करंट रन रेट"
    },
    {
      "subtitle_id": 194,
      "start": 410.0,
      "end": 413.8,
      "text": "से कंपनी रेवेन्यू बढ़ाती है तो अभी का जो"
    },
    {
      "subtitle_id": 195,
      "start": 411.919,
      "end": 415.919,
      "text": "वैल्युएशन है वो बिल्कुल भी सस्टेनेबल"
    },
    {
      "subtitle_id": 196,
      "start": 413.8,
      "end": 417.96,
      "text": "नहीं है और बिल्कुल ओवर वैल्यूड आप कह"
    },
    {
      "subtitle_id": 197,
      "start": 415.919,
      "end": 420.36,
      "text": "सकते हैं कंपनी की जो बाकी की दो पियर"
    },
    {
      "subtitle_id": 198,
      "start": 417.96,
      "end": 422.72,
      "text": "कंपनीज है चाहे वो पीएफसी हो या फिर आरईसी"
    },
    {
      "subtitle_id": 199,
      "start": 420.36,
      "end": 425.12,
      "text": "हो उनका अगर हम पी रेशो देखें 7-8 के करीब"
    },
    {
      "subtitle_id": 200,
      "start": 422.72,
      "end": 427.599,
      "text": "है पूरी इंडस्ट्री का पी रेशो देखें 14 के"
    },
    {
      "subtitle_id": 201,
      "start": 425.12,
      "end": 429.08,
      "text": "करीब है और कंपनी का है 34 का तो यह चीज"
    },
    {
      "subtitle_id": 202,
      "start": 427.599,
      "end": 430.919,
      "text": "तो बड़ी क्लियर है कि कंपनी बहुत ओवर"
    },
    {
      "subtitle_id": 203,
      "start": 429.08,
      "end": 433.0,
      "text": "वैल्यूड है अब इस वैल्युएशन को कंपनी को"
    },
    {
      "subtitle_id": 204,
      "start": 430.919,
      "end": 435.759,
      "text": "सस्टेन करना है तो अगले साल से कंपनी को"
    },
    {
      "subtitle_id": 205,
      "start": 433.0,
      "end": 437.28,
      "text": "एटलीस्ट 25 टू 27 पर से बढ़ना पड़ेगा अब"
    },
    {
      "subtitle_id": 206,
      "start": 435.759,
      "end": 439.28,
      "text": "उसके चांसेस भी कम है क्योंकि यहां पर"
    },
    {
      "subtitle_id": 207,
      "start": 437.28,
      "end": 441.319,
      "text": "कंपटीशन जो है वो बढ़ती जा रही है और जो"
    },
    {
      "subtitle_id": 208,
      "start": 439.28,
      "end": 443.24,
      "text": "बाकी है पीएफसी और आरईसी वो भी धीरे-धीरे"
    },
    {
      "subtitle_id": 209,
      "start": 441.319,
      "end": 444.84,
      "text": "रिन्यूएबल एनर्जी सेक्टर पर फोकस कर रहे"
    },
    {
      "subtitle_id": 210,
      "start": 443.24,
      "end": 446.44,
      "text": "हैं तो अगर इसे"
    },
    {
      "subtitle_id": 211,
      "start": 444.84,
      "end": 449.639,
      "text": "कंक्लूजन"
    },
    {
      "subtitle_id": 212,
      "start": 446.44,
      "end": 451.16,
      "text": "करने की गलती मत कीजिए दूसरी चीज कंपनी"
    },
    {
      "subtitle_id": 213,
      "start": 449.639,
      "end": 453.12,
      "text": "कोई मोनोपोली नहीं है बहुत सारे प्लेयर्स"
    },
    {
      "subtitle_id": 214,
      "start": 451.16,
      "end": 454.84,
      "text": "इस इंडस्ट्री में हैं और ऐसा कुछ खास नहीं"
    },
    {
      "subtitle_id": 215,
      "start": 453.12,
      "end": 456.4,
      "text": "कि कंपनी के लिए आप इतना स्पेशल पी दे"
    },
    {
      "subtitle_id": 216,
      "start": 454.84,
      "end": 458.639,
      "text": "सकते हैं या इतना ज्यादा वैल्यूएशन दे"
    },
    {
      "subtitle_id": 217,
      "start": 456.4,
      "end": 460.479,
      "text": "सकते हैं तो अगर आप नए इन्वेस्टर्स हैं और"
    },
    {
      "subtitle_id": 218,
      "start": 458.639,
      "end": 462.12,
      "text": "कंपनी की पास्ट शेयर प्राइस को देखकर बहुत"
    },
    {
      "subtitle_id": 219,
      "start": 460.479,
      "end": 463.84,
      "text": "इंप्रेस हुए हैं तो आप इसमें इन्वेस्ट"
    },
    {
      "subtitle_id": 220,
      "start": 462.12,
      "end": 465.639,
      "text": "करने से पहले जरूर कंपनी का वैल्युएशन फिर"
    },
    {
      "subtitle_id": 221,
      "start": 463.84,
      "end": 467.4,
      "text": "से कीजिए और उसके बाद ही अपनी डिसीजन"
    },
    {
      "subtitle_id": 222,
      "start": 465.639,
      "end": 469.84,
      "text": "लीजिए क्योंकि अगले वीडियो में हम बात"
    },
    {
      "subtitle_id": 223,
      "start": 467.4,
      "end": 471.72,
      "text": "करने वाले हैं पीएसयू बबल की जो कि फिलहाल"
    },
    {
      "subtitle_id": 224,
      "start": 469.84,
      "end": 473.639,
      "text": "बहुत बड़े तौर पर चल रहा है और उसमें हम"
    },
    {
      "subtitle_id": 225,
      "start": 471.72,
      "end": 477.159,
      "text": "बहुत डिटेल में जाएंगे कि क्यों पीएससी"
    },
    {
      "subtitle_id": 226,
      "start": 473.639,
      "end": 477.159,
      "text": "स्टॉक्स इतनी तेजी से बढ़ रहे हैं"
    }
  ]
}