  "parsing_issues": [],
  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.08,
      "end": 4.56,
      "text": "मोतीलाल ओसल फाइनेंसियल सर्विसेज की हालत"
    },
    {
      "subtitle_id": 2,
      "start": 2.159,
      "end": 6.4,
      "text": "पिछले कुछ टाइम से कुछ ऐसी हो गई है कि आज"
    },
    {
      "subtitle_id": 3,
      "start": 4.56,
      "end": 8.96,
      "text": "वो यह कहने पर मजबूर हो गए हैं।"
    },
    {
      "subtitle_id": 4,
      "start": 6.4,
      "end": 10.719,
      "text": "पता नहीं ऐसे डेंजरस सिचुएशन में मैं"
    },
    {
      "subtitle_id": 5,
      "start": 8.96,
      "end": 12.96,
      "text": "ऑटोमेटिकली आगे कैसे आ जाता हूं।"
    },
    {
      "subtitle_id": 6,
      "start": 10.719,
      "end": 15.2,
      "text": "अभी जनवरी की बात करते हैं तो ऐसा रूमर"
    },
    {
      "subtitle_id": 7,
      "start": 12.96,
      "end": 16.96,
      "text": "फैलने लगा सोशल मीडिया पर कि कल्याण"
    },
    {
      "subtitle_id": 8,
      "start": 15.2,
      "end": 19.6,
      "text": "ज्वेलर के एक एंप्लई ने नोटों का"
    },
    {
      "subtitle_id": 9,
      "start": 16.96,
      "end": 21.76,
      "text": "पूरा-पूरा गट्ठा बंडल मोतीलाल ओसवाल के"
    },
    {
      "subtitle_id": 10,
      "start": 19.6,
      "end": 23.68,
      "text": "एंप्लई को दे दिया और उनसे यह कहा कि आप"
    },
    {
      "subtitle_id": 11,
      "start": 21.76,
      "end": 25.439,
      "text": "हमारे शेयर प्राइसेस पंप करो यानी और"
    },
    {
      "subtitle_id": 12,
      "start": 23.68,
      "end": 27.119,
      "text": "ज्यादा ऊपर बढ़ाओ। अब जैसे ही रूमर्स"
    },
    {
      "subtitle_id": 13,
      "start": 25.439,
      "end": 30.48,
      "text": "मार्केट में फैलने लगे, कल्याण ज्वेलर के"
    },
    {
      "subtitle_id": 14,
      "start": 27.119,
      "end": 32.8,
      "text": "शेयर्स धना धन गिरने लगे। गिरते-गिरते 37%"
    },
    {
      "subtitle_id": 15,
      "start": 30.48,
      "end": 35.04,
      "text": "तक यह गिर गए। उसी के साथ मोतीलाल ओसवाल"
    },
    {
      "subtitle_id": 16,
      "start": 32.8,
      "end": 37.12,
      "text": "के खुद के शेयर्स भी 9% तक गिर गए थे। फिर"
    },
    {
      "subtitle_id": 17,
      "start": 35.04,
      "end": 39.12,
      "text": "क्लेरिफिकेशन आया कि यह बस रूमर्स थे।"
    },
    {
      "subtitle_id": 18,
      "start": 37.12,
      "end": 41.36,
      "text": "लेकिन तब तक जो नुकसान होना था वो हो चुका"
    },
    {
      "subtitle_id": 19,
      "start": 39.12,
      "end": 43.04,
      "text": "था। इमेज जो खराब होनी थी वो हो चुकी थी।"
    },
    {
      "subtitle_id": 20,
      "start": 41.36,
      "end": 45.12,
      "text": "मतलब इंटरेस्टिंग चीज तो यह है कि कल्याण"
    },
    {
      "subtitle_id": 21,
      "start": 43.04,
      "end": 47.28,
      "text": "ज्वेलर के जो शेयर्स हैं वो उस शौक से आज"
    },
    {
      "subtitle_id": 22,
      "start": 45.12,
      "end": 49.76,
      "text": "तक उभर नहीं पाए। अभी भी उनके शेयर प्राइस"
    },
    {
      "subtitle_id": 23,
      "start": 47.28,
      "end": 52.239,
      "text": "₹500 के करीब है जो जनवरी के प्राइस से"
    },
    {
      "subtitle_id": 24,
      "start": 49.76,
      "end": 54.16,
      "text": "30% अभी भी डाउन है। और मोतीलाल ओसोल के"
    },
    {
      "subtitle_id": 25,
      "start": 52.239,
      "end": 56.16,
      "text": "खुद के शेयर्स भी अभी उसी लेवल पर है जिस"
    },
    {
      "subtitle_id": 26,
      "start": 54.16,
      "end": 58.32,
      "text": "पर वह जनवरी में थे। इसी बीच मार्केट में"
    },
    {
      "subtitle_id": 27,
      "start": 56.16,
      "end": 61.92,
      "text": "अभी एक और रूमर फैलने लगा है और वह यह है"
    },
    {
      "subtitle_id": 28,
      "start": 58.32,
      "end": 64.08,
      "text": "कि मोतीलाल ओसवाल की दो कंपनीज़ ने मिलकर"
    },
    {
      "subtitle_id": 29,
      "start": 61.92,
      "end": 66.0,
      "text": "केस टेक्नोलॉजी के शेयर्स को मैनिपुलेट"
    },
    {
      "subtitle_id": 30,
      "start": 64.08,
      "end": 68.159,
      "text": "किया है। इसका असर क्या हुआ? तो मोतीलाल"
    },
    {
      "subtitle_id": 31,
      "start": 66.0,
      "end": 70.799,
      "text": "ओसवाल एक हफ्ते में 5% डाउन है और केंस"
    },
    {
      "subtitle_id": 32,
      "start": 68.159,
      "end": 72.56,
      "text": "टेक्नोलॉजी 7% है। यानी कि ये जो साल है"
    },
    {
      "subtitle_id": 33,
      "start": 70.799,
      "end": 74.4,
      "text": "2025 ये मोतीलाल ओसवाल के लिए तो अच्छा"
    },
    {
      "subtitle_id": 34,
      "start": 72.56,
      "end": 76.0,
      "text": "शुरू नहीं हुआ और लगता है कि अच्छे से"
    },
    {
      "subtitle_id": 35,
      "start": 74.4,
      "end": 77.759,
      "text": "खत्म भी नहीं होने वाला। अब क्या है यह"
    },
    {
      "subtitle_id": 36,
      "start": 76.0,
      "end": 79.759,
      "text": "रूमर्स और एलगेशन जिसकी वजह से यह"
    },
    {
      "subtitle_id": 37,
      "start": 77.759,
      "end": 81.6,
      "text": "कंट्रोवर्सी हो रही है और इस बार क्या यह"
    },
    {
      "subtitle_id": 38,
      "start": 79.759,
      "end": 83.68,
      "text": "सिर्फ रूमर्स है या फिर इसमें कुछ सच्चाई"
    },
    {
      "subtitle_id": 39,
      "start": 81.6,
      "end": 86.0,
      "text": "भी है इस पर हमने डीप में जाकर रिसर्च"
    },
    {
      "subtitle_id": 40,
      "start": 83.68,
      "end": 87.92,
      "text": "किया और जो चीजें पता चली वो आपके सामने"
    },
    {
      "subtitle_id": 41,
      "start": 86.0,
      "end": 89.28,
      "text": "अभी रखने वाले हैं। नमस्कार मैं प्रसाद"
    },
    {
      "subtitle_id": 42,
      "start": 87.92,
      "end": 90.88,
      "text": "आपका आज के इस वीडियो में स्वागत करता"
    },
    {
      "subtitle_id": 43,
      "start": 89.28,
      "end": 92.64,
      "text": "हूं। एंड थैंक्स टू ग्रो फॉर बीइंग आवर"
    },
    {
      "subtitle_id": 44,
      "start": 90.88,
      "end": 94.4,
      "text": "पार्टनर बिकॉज़ उन्हीं की वजह से हम ज्यादा"
    },
    {
      "subtitle_id": 45,
      "start": 92.64,
      "end": 96.0,
      "text": "से ज्यादा वीडियोस लेकर आ पा रहे हैं। सो"
    },
    {
      "subtitle_id": 46,
      "start": 94.4,
      "end": 97.28,
      "text": "थैंक्स टू देम और उनके साथ डीमेट अकाउंट"
    },
    {
      "subtitle_id": 47,
      "start": 96.0,
      "end": 99.04,
      "text": "खुलने के लिए आप नीचे डिस्क्रिप्शन में"
    },
    {
      "subtitle_id": 48,
      "start": 97.28,
      "end": 100.4,
      "text": "दिए गए लिंक पर क्लिक कर सकते हो। और हां"
    },
    {
      "subtitle_id": 49,
      "start": 99.04,
      "end": 102.24,
      "text": "वीडियो स्टार्ट करने से पहले एक बहुत"
    },
    {
      "subtitle_id": 50,
      "start": 100.4,
      "end": 104.079,
      "text": "इंपॉर्टेंट चीज आप सभी के साथ शेयर करना"
    },
    {
      "subtitle_id": 51,
      "start": 102.24,
      "end": 105.759,
      "text": "चाहता हूं कि वैल्यू इन्वेस्टिंग की जनवरी"
    },
    {
      "subtitle_id": 52,
      "start": 104.079,
      "end": 107.52,
      "text": "बैच की एडमिशन स्टार्ट हो चुकी है।"
    },
    {
      "subtitle_id": 53,
      "start": 105.759,
      "end": 109.92,
      "text": "जिन्हें नहीं पता उनको बता दूं कि वैल्यू"
    },
    {
      "subtitle_id": 54,
      "start": 107.52,
      "end": 111.68,
      "text": "इन्वेस्टिंग कोहर्ट हमारा 12 हफ्तों का एक"
    },
    {
      "subtitle_id": 55,
      "start": 109.92,
      "end": 113.52,
      "text": "ऑनलाइन मेंटोरशिप प्रोग्राम है जो"
    },
    {
      "subtitle_id": 56,
      "start": 111.68,
      "end": 115.28,
      "text": "वीकेंड्स में कंडक्ट होता है। इन 12"
    },
    {
      "subtitle_id": 57,
      "start": 113.52,
      "end": 116.88,
      "text": "हफ्तों में आपको सेवन एक्सक्लूसिव वैल्यू"
    },
    {
      "subtitle_id": 58,
      "start": 115.28,
      "end": 118.96,
      "text": "इन्वेस्टिंग स्ट्रेटजीज़ सिखाई जाती है।"
    },
    {
      "subtitle_id": 59,
      "start": 116.88,
      "end": 120.799,
      "text": "जिसमें डीसीएफ से लेकर ग्रोथ स्ट्रेटजी तक"
    },
    {
      "subtitle_id": 60,
      "start": 118.96,
      "end": 123.119,
      "text": "सारी डिटेल स्ट्रेटजीज़ आपको डिटेल में"
    },
    {
      "subtitle_id": 61,
      "start": 120.799,
      "end": 124.88,
      "text": "सिखाई जाती है। जिन्हें आप सीखकर खुद अपने"
    },
    {
      "subtitle_id": 62,
      "start": 123.119,
      "end": 126.799,
      "text": "लिए अंडरवैल्यूड स्टॉक्स आइडेंटिफाई कर"
    },
    {
      "subtitle_id": 63,
      "start": 124.88,
      "end": 128.08,
      "text": "सकते हैं। और ये जो सेवन स्ट्रेटजीस यहां"
    },
    {
      "subtitle_id": 64,
      "start": 126.799,
      "end": 129.84,
      "text": "पर मैं सिखाता हूं, इसमें सारी"
    },
    {
      "subtitle_id": 65,
      "start": 128.08,
      "end": 131.36,
      "text": "वैल्यू्यूएशन स्ट्रेटजीस कवर हो जाती है।"
    },
    {
      "subtitle_id": 66,
      "start": 129.84,
      "end": 133.28,
      "text": "और ऐसी भी कई सारी स्ट्रेटजीस इसमें"
    },
    {
      "subtitle_id": 67,
      "start": 131.36,
      "end": 135.2,
      "text": "इनवॉल्वड हैं जो मैंने पिछले 12 सालों में"
    },
    {
      "subtitle_id": 68,
      "start": 133.28,
      "end": 137.2,
      "text": "इन्वेस्ट करते-करते पता की है। यानी कि"
    },
    {
      "subtitle_id": 69,
      "start": 135.2,
      "end": 138.72,
      "text": "अगर आपको वैल्यू्यूएशन में पानी है कि कौन"
    },
    {
      "subtitle_id": 70,
      "start": 137.2,
      "end": 141.28,
      "text": "सा स्टॉक अंडरवैल्यूड है, कौन सा"
    },
    {
      "subtitle_id": 71,
      "start": 138.72,
      "end": 143.2,
      "text": "ओवरवैल्यूड है। ये सारी चीजें आप खुद कर"
    },
    {
      "subtitle_id": 72,
      "start": 141.28,
      "end": 144.8,
      "text": "पाएंगे इन दिस वीआईसी यानी कि वैल्यू"
    },
    {
      "subtitle_id": 73,
      "start": 143.2,
      "end": 146.56,
      "text": "इन्वेस्टिंग कोहर्ट में। तो फर्स्ट कम"
    },
    {
      "subtitle_id": 74,
      "start": 144.8,
      "end": 148.08,
      "text": "फर्स्ट शो बेसिस पर यहां पर सीट्स एलोकेट"
    },
    {
      "subtitle_id": 75,
      "start": 146.56,
      "end": 150.16,
      "text": "होते हैं। यहां पर बैचेस अच्छे खासे"
    },
    {
      "subtitle_id": 76,
      "start": 148.08,
      "end": 152.0,
      "text": "अंतराल के बाद आती है और साथ ही सीट्स भी"
    },
    {
      "subtitle_id": 77,
      "start": 150.16,
      "end": 153.92,
      "text": "लिमिटेड रहती है ताकि सब पर एक स्पेशल"
    },
    {
      "subtitle_id": 78,
      "start": 152.0,
      "end": 155.12,
      "text": "अटेंशन रखा जाए। इस मेंटोरशिप प्रोग्राम"
    },
    {
      "subtitle_id": 79,
      "start": 153.92,
      "end": 156.4,
      "text": "में एनरोल होने के लिए आपको नीचे"
    },
    {
      "subtitle_id": 80,
      "start": 155.12,
      "end": 158.08,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में दी गई"
    },
    {
      "subtitle_id": 81,
      "start": 156.4,
      "end": 160.08,
      "text": "लिंक पर क्लिक करके फॉर्म फिल करना है और"
    },
    {
      "subtitle_id": 82,
      "start": 158.08,
      "end": 162.16,
      "text": "उसके बाद हमारी टीम आपसे कांटेक्ट करेगी।"
    },
    {
      "subtitle_id": 83,
      "start": 160.08,
      "end": 164.4,
      "text": "तो वैल्यू्यूएशन में पाने का यह मौका"
    },
    {
      "subtitle_id": 84,
      "start": 162.16,
      "end": 168.0,
      "text": "बिल्कुल भी मत गवाइए। अभी एनरोल कीजिए।"
    },
    {
      "subtitle_id": 85,
      "start": 164.4,
      "end": 170.239,
      "text": "चलिए अब बढ़ते हैं वीडियो की तरफ।"
    },
    {
      "subtitle_id": 86,
      "start": 168.0,
      "end": 172.56,
      "text": "सीसी है यह 18th नवंबर की है। लेकिन इसकी"
    },
    {
      "subtitle_id": 87,
      "start": 170.239,
      "end": 174.0,
      "text": "शुरुआत फोर्थ नवंबर को हुई है। किस"
    },
    {
      "subtitle_id": 88,
      "start": 172.56,
      "end": 175.84,
      "text": "टेक्नोलॉजी के बारे में थोड़ा सा आपको बता"
    },
    {
      "subtitle_id": 89,
      "start": 174.0,
      "end": 177.44,
      "text": "दूं कि यह जो कंपनी है, यह एंड टू एंड"
    },
    {
      "subtitle_id": 90,
      "start": 175.84,
      "end": 179.519,
      "text": "मैन्युफैक्चरिंग सर्विज ऑफर करती है"
    },
    {
      "subtitle_id": 91,
      "start": 177.44,
      "end": 181.36,
      "text": "ऑटोमोटिव, डिफेंस, इंडस्ट्रियल, एरोस्पेस"
    },
    {
      "subtitle_id": 92,
      "start": 179.519,
      "end": 182.879,
      "text": "और कंज्यूमर इलेक्ट्रॉनिक्स कंपनीज़ को।"
    },
    {
      "subtitle_id": 93,
      "start": 181.36,
      "end": 184.56,
      "text": "यानी कि हाई एंड इलेक्ट्रॉनिक्स"
    },
    {
      "subtitle_id": 94,
      "start": 182.879,
      "end": 186.64,
