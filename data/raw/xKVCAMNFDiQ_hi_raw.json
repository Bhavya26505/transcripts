    {
      "subtitle_id": 190,
      "start": 386.08,
      "end": 390.319,
      "text": "रिसर्च टीम को लेकर, उनके फंड मैनेजर्स को"
    },
    {
      "subtitle_id": 191,
      "start": 388.16,
      "end": 392.88,
      "text": "लेकर, यह बिल्कुल गलत है, बेसलेस है और"
    },
    {
      "subtitle_id": 192,
      "start": 390.319,
      "end": 394.96,
      "text": "इरिस्पांसिबल है। उन्होंने आगे यह भी कहा"
    },
    {
      "subtitle_id": 193,
      "start": 392.88,
      "end": 397.199,
      "text": "कि उनकी रिसर्च फर्म यानी सेल साइड रिसर्च"
    },
    {
      "subtitle_id": 194,
      "start": 394.96,
      "end": 399.44,
      "text": "फर्म और एसेट मैनेजमेंट कंपनी दोनों"
    },
    {
      "subtitle_id": 195,
      "start": 397.199,
      "end": 401.68,
      "text": "कंप्लीटली अलग है। फंड मैनेजमेंट टीम"
    },
    {
      "subtitle_id": 196,
      "start": 399.44,
      "end": 403.68,
      "text": "स्ट्रिक्टली इंटरनल रूल्स को फॉलो करती है"
    },
    {
      "subtitle_id": 197,
      "start": 401.68,
      "end": 405.6,
      "text": "जो इन्वेस्टर्स के फायदे के हैं। और"
    },
    {
      "subtitle_id": 198,
      "start": 403.68,
      "end": 408.08,
      "text": "उन्होंने आगे यह भी कहा कि दे रिजर्व द"
    },
    {
      "subtitle_id": 199,
      "start": 405.6,
      "end": 410.56,
      "text": "राइट टू टेक लीगल एक्शन ऐसे लोगों पर जो"
    },
    {
      "subtitle_id": 200,
      "start": 408.08,
      "end": 412.319,
      "text": "यह फॉल्स इंफॉर्मेशन स्प्रेड कर रहे हैं।"
    },
    {
      "subtitle_id": 201,
      "start": 410.56,
      "end": 414.319,
      "text": "अब सफाई तो यहां पर हो गई लेकिन इसके"
    },
    {
      "subtitle_id": 202,
      "start": 412.319,
      "end": 416.4,
      "text": "बावजूद भी मोतीलाल ओसवाल की शेयर प्राइस"
    },
    {
      "subtitle_id": 203,
      "start": 414.319,
      "end": 418.08,
      "text": "की गिरावट जारी रही। तो ओवरऑल देखा जाए तो"
    },
    {
      "subtitle_id": 204,
      "start": 416.4,
      "end": 420.0,
      "text": "इस पूरी कंट्रोवर्सी में दो कंपनीज़"
    },
    {
      "subtitle_id": 205,
      "start": 418.08,
      "end": 421.919,
      "text": "इन्वॉल्वड हैं। एक सेल साइड रिसर्च कंपनी"
    },
    {
      "subtitle_id": 206,
      "start": 420.0,
      "end": 423.84,
      "text": "है जो कंपनीज़ पर रिसर्च करके रिपोर्ट्स"
    },
    {
      "subtitle_id": 207,
      "start": 421.919,
      "end": 425.68,
      "text": "निकालती है विद टारगेट प्राइस और एक है"
    },
    {
      "subtitle_id": 208,
      "start": 423.84,
      "end": 428.16,
      "text": "एसेट मैनेजमेंट कंपनी जो म्यूच्यूल फंड का"
    },
    {
      "subtitle_id": 209,
      "start": 425.68,
      "end": 430.0,
      "text": "बिज़नेस चलाती है। अब जैसे मिस्टर मोतीलाल"
    },
    {
      "subtitle_id": 210,
      "start": 428.16,
      "end": 432.4,
      "text": "ओसवाल ने कहा कि ये दोनों कंपनी की रिसर्च"
    },
    {
      "subtitle_id": 211,
      "start": 430.0,
      "end": 434.24,
      "text": "टीम अलग-अलग है। एक रिसर्च टीम सेल साइड"
    },
    {
      "subtitle_id": 212,
      "start": 432.4,
      "end": 435.759,
      "text": "है तो दूसरी बाय साइड है। और इन दोनों"
    },
    {
      "subtitle_id": 213,
      "start": 434.24,
      "end": 437.28,
      "text": "टीम्स का इंटरेक्शन बिल्कुल भी नहीं होता"
    },
    {
      "subtitle_id": 214,
      "start": 435.759,
      "end": 439.12,
      "text": "है और सेबी के हिसाब से भी ये दोनों"
    },
    {
      "subtitle_id": 215,
      "start": 437.28,
      "end": 440.88,
      "text": "कंपनीज़ को इंडिपेंडेंटली काम करना होता"
    },
    {
      "subtitle_id": 216,
      "start": 439.12,
      "end": 442.88,
      "text": "है। तो यहां पर एक और दिक्कत इन्वेस्टर्स"
    },
    {
      "subtitle_id": 217,
      "start": 440.88,
      "end": 445.039,
      "text": "और सेबी के दिमाग में जरूर आई होगी कि अगर"
    },
    {
      "subtitle_id": 218,
      "start": 442.88,
      "end": 447.52,
      "text": "कोई कंपनी म्यूच्यूल फंड कंपनी चला रही है"
    },
    {
      "subtitle_id": 219,
      "start": 445.039,
      "end": 449.759,
      "text": "तो क्या उसी ग्रुप को रिसर्च फर्म चलाने"
    },
    {
      "subtitle_id": 220,
      "start": 447.52,
      "end": 451.68,
      "text": "देना चाहिए क्योंकि फिर ऐसा बार-बार हो"
    },
    {
      "subtitle_id": 221,
      "start": 449.759,
      "end": 453.599,
      "text": "सकता है क्योंकि वो दोनों अलग-अलग काम कर"
    },
    {
      "subtitle_id": 222,
      "start": 451.68,
      "end": 455.52,
      "text": "रही है। अब हो सकता है कई बार कि जाने"
    },
    {
      "subtitle_id": 223,
      "start": 453.599,
      "end": 457.28,
      "text": "अनजाने में हो लेकिन कई बार ऐसा भी हो"
    },
    {
      "subtitle_id": 224,
      "start": 455.52,
      "end": 458.88,
      "text": "सकता है कि जानबूझकर भी किया हो। अब इस"
    },
    {
      "subtitle_id": 225,
      "start": 457.28,
      "end": 461.12,
      "text": "केस में आपको क्या लगता है? आप कमेंट करके"
    },
    {
      "subtitle_id": 226,
      "start": 458.88,
      "end": 463.12,
      "text": "बताइए। और मुझे लगता है और एक इंटरेस्टिंग"
    },
    {
      "subtitle_id": 227,
      "start": 461.12,
      "end": 465.44,
      "text": "चीज अगर एक ही ग्रुप म्यूच्यूल फंड कंपनी"
    },
    {
      "subtitle_id": 228,
      "start": 463.12,
      "end": 467.039,
      "text": "और रिसर्च फर्म चला रही है तो उस रिसर्च"
    },
    {
      "subtitle_id": 229,
      "start": 465.44,
      "end": 468.639,
      "text": "फर्म के रिसर्च रिपोर्ट में यह भी लिखना"
    },
    {
      "subtitle_id": 230,
      "start": 467.039,
      "end": 470.88,
      "text": "चाहिए कि जो भी शेयर्स की वो बात कर रहे"
    },
    {
      "subtitle_id": 231,
      "start": 468.639,
      "end": 473.36,
      "text": "हैं उनके शेयर्स उनकी म्यूच्यूल फंड कंपनी"
    },
    {
      "subtitle_id": 232,
      "start": 470.88,
      "end": 475.12,
      "text": "ने खरीदे हैं क्या? खरीदे हैं तो कितनी"
    },
    {
      "subtitle_id": 233,
      "start": 473.36,
      "end": 477.28,
      "text": "मात्रा में खरीदे हैं या कितनी होल्डिंग्स"
    },
    {
      "subtitle_id": 234,
      "start": 475.12,
      "end": 478.879,
      "text": "हैं। इसके डिस्क्लेमर जरूर होने चाहिए। जब"
    },
    {
      "subtitle_id": 235,
      "start": 477.28,
      "end": 480.639,
      "text": "मैंने इनका रिसर्च रिपोर्ट देखा केस"
    },
    {
      "subtitle_id": 236,
      "start": 478.879,
      "end": 482.319,
      "text": "टेक्नोलॉजी का तो उसमें कहीं पर भी यह"
    },
    {
      "subtitle_id": 237,
      "start": 480.639,
      "end": 484.4,
      "text": "मेंशन नहीं किया गया कि हमारी म्यूच्यूल"
    },
    {
      "subtitle_id": 238,
      "start": 482.319,
      "end": 486.479,
      "text": "फंड कंपनी है जो दूसरी उसने केस"
    },
    {
      "subtitle_id": 239,
      "start": 484.4,
      "end": 488.08,
      "text": "टेक्नोलॉजी के शेयर्स खरीदे हैं। अब यह जो"
    },
    {
      "subtitle_id": 240,
      "start": 486.479,
      "end": 490.879,
      "text": "चीज है कि एक ग्रुप के अंडर मल्टीपल"
    },
    {
      "subtitle_id": 241,
      "start": 488.08,
      "end": 492.4,
      "text": "कंपनीज़ जो अपोजिट सर्विज प्रोवाइड कर रही"
    },
    {
      "subtitle_id": 242,
      "start": 490.879,
      "end": 493.919,
      "text": "है यह सिर्फ मोतीलाल ओसवाल में नहीं हो"
    },
    {
      "subtitle_id": 243,
      "start": 492.4,
      "end": 496.08,
      "text": "रहा है। यह आपको नवामा में होते हुए"
    },
    {
      "subtitle_id": 244,
      "start": 493.919,
      "end": 497.919,
      "text": "दिखेगा। वह कंपनी पीएमएस की सर्विस देती"
    },
    {
      "subtitle_id": 245,
      "start": 496.08,
      "end": 500.08,
      "text": "है और उसी के साथ रिसर्च रिपोर्ट भी"
    },
    {
      "subtitle_id": 246,
      "start": 497.919,
      "end": 501.759,
      "text": "निकालती है। अब रिसर्च रिपोर्ट इशू करने"
    },
    {
      "subtitle_id": 247,
      "start": 500.08,
      "end": 503.44,
      "text": "की बात आती है तो वहां पर क्रेडिबिलिटी की"
    },
    {
      "subtitle_id": 248,
      "start": 501.759,
      "end": 504.96,
      "text": "बात आती है कि कितनी सच्चाई उन रिपोर्ट्स"
    },
    {
      "subtitle_id": 249,
      "start": 503.44,
      "end": 506.8,
      "text": "में है। तो कई सारे जो रिसर्च रिपोर्ट्स"
    },
    {
      "subtitle_id": 250,
      "start": 504.96,
      "end": 508.479,
      "text": "हैं वो इंट्राडे वगैरह की रिसर्च रिपोर्ट"
    },
    {
      "subtitle_id": 251,
      "start": 506.8,
      "end": 510.16,
      "text": "निकालते हैं। तो प्रैक्टिकली अगर सोचा इट"
    },
    {
      "subtitle_id": 252,
      "start": 508.479,
      "end": 512.159,
      "text": "इज़ इंपॉसिबल कि एक दिन में उस शेयर में"
    },
    {
      "subtitle_id": 253,
      "start": 510.16,
      "end": 513.839,
      "text": "क्या होगा? 1 दिन में धंधा तो नहीं बदल"
    },
    {
      "subtitle_id": 254,
      "start": 512.159,
      "end": 515.599,
      "text": "रहा है। 1 दिन में अचानक से ग्रोथ तो नहीं"
    },
    {
      "subtitle_id": 255,
      "start": 513.839,
      "end": 517.599,
      "text": "हो रही है। तो 1 दिन में शेयर प्राइस में"
    },
    {
      "subtitle_id": 256,
      "start": 515.599,
      "end": 519.12,
      "text": "अचानक नोबडी कैन प्रेडिक्ट कि क्या हुआ?"
    },
    {
      "subtitle_id": 257,
      "start": 517.599,
      "end": 520.8,
      "text": "और बहुत सारी रिसर्च रिपोर्ट ये जो कंपनीज़"
    },
    {
      "subtitle_id": 258,
      "start": 519.12,
      "end": 522.719,
      "text": "इशू करती है इसमें से बहुत सारे तो सिर्फ"
    },
    {
      "subtitle_id": 259,
      "start": 520.8,
      "end": 524.0,
      "text": "शॉर्ट टर्म इंट्राडे वगैरह होते हैं। मेरे"
    },
    {
      "subtitle_id": 260,
      "start": 522.719,
      "end": 526.0,
      "text": "हिसाब से रिसर्च रिपोर्ट में एक ही चीज"
    },
    {
      "subtitle_id": 261,
      "start": 524.0,
      "end": 527.44,
      "text": "सेंस बनाती है वो है लॉन्ग टर्म के रिसर्च"
    },
    {
      "subtitle_id": 262,
      "start": 526.0,
      "end": 529.12,
      "text": "रिपोर्ट कि लॉन्ग टर्म में भाई क्या होगा?"
    },
    {
      "subtitle_id": 263,
      "start": 527.44,
      "end": 530.64,
      "text": "एक्चुअली वी आर आल्सो आर लेकिन हम शॉर्ट"
    },
    {
      "subtitle_id": 264,
      "start": 529.12,
      "end": 532.24,
      "text": "टर्म में कभी भी रिसर्च रिपोर्ट नहीं"
    },
    {
      "subtitle_id": 265,
      "start": 530.64,
      "end": 534.08,
      "text": "प्रोवाइड करते। हमारे जो भी रिसर्च"
    },
    {
      "subtitle_id": 266,
      "start": 532.24,
      "end": 535.92,
      "text": "रिपोर्ट्स हैं वो भी लॉन्ग टर्म ही है जो"
    },
    {
      "subtitle_id": 267,
      "start": 534.08,
      "end": 538.0,
      "text": "हमारी कम्युनिटी प्रोमियम प्रोवाइड करते"
    },
    {
      "subtitle_id": 268,
      "start": 535.92,
      "end": 539.68,
      "text": "हैं। और जहां तक बात आती है कस टेक्नोलॉजी"
    },
    {
      "subtitle_id": 269,
      "start": 538.0,
      "end": 541.839,
      "text": "के वैल्यू्यूएशन की तो देखिए 4 नवंबर के"
    },
    {
      "subtitle_id": 270,
      "start": 539.68,
      "end": 543.519,
      "text": "क्वार्टरली रिजल्ट्स अच्छे आए थे। मोतीलाल"
    },
    {
      "subtitle_id": 271,
      "start": 541.839,
      "end": 545.36,
      "text": "की रिपोर्ट भी अच्छे आई थी। लेकिन आप"
    },
    {
      "subtitle_id": 272,
      "start": 543.519,
      "end": 548.08,
      "text": "देखिए शेयर्स के हालात ये 4 नवंबर से ही"
    },
    {
      "subtitle_id": 273,
      "start": 545.36,
      "end": 549.92,
      "text": "गिर रहे हैं। रीजन 100 के ऊपर इसका पीई चल"
    },
    {
      "subtitle_id": 274,
      "start": 548.08,
      "end": 551.279,
      "text": "रहा था और लेकिन जिस हिसाब से क्रेजी"
    },
    {
      "subtitle_id": 275,
      "start": 549.92,
      "end": 553.44,
      "text": "वैल्यू्यूएशन कंपनी का बढ़ा है वो"
    },
    {
      "subtitle_id": 276,
      "start": 551.279,
      "end": 555.44,
      "text": "वैल्यू्यूएशन लंबे समय तक सस्टेन रहना"
    },
    {
      "subtitle_id": 277,
      "start": 553.44,
      "end": 557.519,
      "text": "काफी मुश्किल हो जाता है। तो इसलिए जो भी"
    },
    {
      "subtitle_id": 278,
      "start": 555.44,
      "end": 558.959,
      "text": "लोग रिसर्च रिपोर्ट पर डिपेंड करते हैं"
    },
    {
      "subtitle_id": 279,
      "start": 557.519,
      "end": 561.12,
      "text": "मैं उनसे सजेस्ट करूंगा भाई शॉर्ट टर्म"
    },
    {
      "subtitle_id": 280,
      "start": 558.959,
      "end": 562.959,
      "text": "में तो बिल्कुल भी ध्यान मत दो। लॉन्ग"
    },
    {
      "subtitle_id": 281,
      "start": 561.12,
      "end": 564.88,
      "text": "टर्म का रहेगा तो थोड़ा बहुत रेफरेंस लो"
    },
    {
      "subtitle_id": 282,
      "start": 562.959,
      "end": 566.72,
      "text": "और खुद का भी एनालिसिस करो। तो बाकी आपकी"
    },
    {
      "subtitle_id": 283,
      "start": 564.88,
      "end": 568.88,
      "text": "क्या राय है इस केस पर? नीचे कमेंट करके"
    },
    {
      "subtitle_id": 284,
      "start": 566.72,
      "end": 571.2,
      "text": "जरूर बताइए। और क्या एक ग्रुप में सेल"
    },
    {
      "subtitle_id": 285,
      "start": 568.88,
      "end": 573.279,
      "text": "साइड और बाय साइड दोनों होने चाहिए? यह भी"
    },
    {
      "subtitle_id": 286,
      "start": 571.2,
      "end": 574.88,
      "text": "कमेंट करके जरूर बताइए। सो, मिलते हैं"
    },
    {
      "subtitle_id": 287,
      "start": 573.279,
      "end": 576.399,
      "text": "अगले वीडियो में। एंड थैंक यू सो मच फॉर"
    },
    {
      "subtitle_id": 288,
      "start": 574.88,
      "end": 578.0,
      "text": "वाचिंग दिस। और हां, जाते-जाते वैल्यू"
    },
    {
      "subtitle_id": 289,
      "start": 576.399,
      "end": 580.0,
      "text": "इंस्टिंग कोहर्ट को जरूर चेक आउट कीजिए।"
    },
    {
      "subtitle_id": 290,
      "start": 578.0,
      "end": 582.0,
      "text": "सीट्स बहुत जल्दी फील हो रही है। तो, बैच"
    },
    {
      "subtitle_id": 291,
      "start": 580.0,
      "end": 583.2,
      "text": "फील होने से पहले जरूर एनरोल कीजिए। लिंक"
    },
    {
      "subtitle_id": 292,
      "start": 582.0,
      "end": 585.6,
      "text": "नीचे डिस्क्रिप्शन और कमेंट बॉक्स में"
    },
    {
      "subtitle_id": 293,
      "start": 583.2,
      "end": 585.6,
      "text": "आपको मिल जाएगी।"
    }
  ]
}