  "parsing_issues": [],
  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.16,
      "end": 5.2,
      "text": "सच में ग्लोबलाइजेशन का जमाना आ चुका है"
    },
    {
      "subtitle_id": 2,
      "start": 2.56,
      "end": 7.2,
      "text": "क्योंकि पहले इंडियंस के साथ इंडियन सिटीज"
    },
    {
      "subtitle_id": 3,
      "start": 5.2,
      "end": 9.599,
      "text": "जैसे कि मुंबई, पुणे, दिल्ली, बेंगलुरु"
    },
    {
      "subtitle_id": 4,
      "start": 7.2,
      "end": 11.92,
      "text": "में स्कैम्स हुआ करते थे। लेकिन अब मामला"
    },
    {
      "subtitle_id": 5,
      "start": 9.599,
      "end": 14.08,
      "text": "इंटरनेशनल पहुंच चुका है। क्योंकि आज जिस"
    },
    {
      "subtitle_id": 6,
      "start": 11.92,
      "end": 16.72,
      "text": "स्कैम की मैं बात कर रहा हूं वो हुआ है"
    },
    {
      "subtitle_id": 7,
      "start": 14.08,
      "end": 19.6,
      "text": "मोस्ट डेवलप्ड इंडियन सिटी आउटसाइड इंडिया"
    },
    {
      "subtitle_id": 8,
      "start": 16.72,
      "end": 21.76,
      "text": "यानी कि दुबई में। जहां पर एक सो कॉल्ड"
    },
    {
      "subtitle_id": 9,
      "start": 19.6,
      "end": 23.92,
      "text": "ब्रोकर ने काफी लोगों को जिनमें मोस्टली"
    },
    {
      "subtitle_id": 10,
      "start": 21.76,
      "end": 27.039,
      "text": "इंडियंस थे उनसे बड़े-बड़े रिटर्न्स के"
    },
    {
      "subtitle_id": 11,
      "start": 23.92,
      "end": 29.359,
      "text": "वादे किए। और हुआ क्या? वही जो टोरिस्ट के"
    },
    {
      "subtitle_id": 12,
      "start": 27.039,
      "end": 31.039,
      "text": "मामले में मुंबई में हुआ था। डीबी स्टॉक"
    },
    {
      "subtitle_id": 13,
      "start": 29.359,
      "end": 33.2,
      "text": "ब्रोकिंग के नाम से आसाम में हुआ था।"
    },
    {
      "subtitle_id": 14,
      "start": 31.039,
      "end": 35.6,
      "text": "शारदा चिट फंड के नाम पर बंगाल में हुआ था"
    },
    {
      "subtitle_id": 15,
      "start": 33.2,
      "end": 37.92,
      "text": "और स्पीक एशिया के नाम से दिल्ली और बाकी"
    },
    {
      "subtitle_id": 16,
      "start": 35.6,
      "end": 40.399,
      "text": "बड़े शहरों में हुआ था। और लोगों के पैसे"
    },
    {
      "subtitle_id": 17,
      "start": 37.92,
      "end": 42.239,
      "text": "लेकर यह भाग गए। क्या है यह पूरा मामला?"
    },
    {
      "subtitle_id": 18,
      "start": 40.399,
      "end": 44.32,
      "text": "जिसमें कई न्यूज़ आउटलेट्स के रिपोर्ट के"
    },
    {
      "subtitle_id": 19,
      "start": 42.239,
      "end": 46.719,
      "text": "हिसाब से लगभग 1000 करोड़ तक का यह बड़ा"
    },
    {
      "subtitle_id": 20,
      "start": 44.32,
      "end": 48.8,
      "text": "स्कैम होने की आशंका है। कैसे किया गया यह"
    },
    {
      "subtitle_id": 21,
      "start": 46.719,
      "end": 50.719,
      "text": "पूरा स्कैम? बात करते हैं आज के इस वीडियो"
    },
    {
      "subtitle_id": 22,
      "start": 48.8,
      "end": 52.64,
      "text": "में और एक इंपॉर्टेंट चीज भी आपको समझनी"
    },
    {
      "subtitle_id": 23,
      "start": 50.719,
      "end": 55.039,
      "text": "चाहिए कि यह स्कैम दुबई में हुआ है। तो"
    },
    {
      "subtitle_id": 24,
      "start": 52.64,
      "end": 56.719,
      "text": "दुबई के लॉ के हिसाब से क्या कुछ कड़ी सजा"
    },
    {
      "subtitle_id": 25,
      "start": 55.039,
      "end": 58.64,
      "text": "उन लोगों को मिल सकती है? यह समझना भी"
    },
    {
      "subtitle_id": 26,
      "start": 56.719,
      "end": 60.239,
      "text": "बड़ा इंटरेस्टिंग होने वाला है। और साथ ही"
    },
    {
      "subtitle_id": 27,
      "start": 58.64,
      "end": 62.399,
      "text": "हम वीडियो में बात करेंगे कि चाहे आप"
    },
    {
      "subtitle_id": 28,
      "start": 60.239,
      "end": 65.119,
      "text": "इंडिया में हो या फिर इंडिया के बाहर कैसे"
    },
    {
      "subtitle_id": 29,
      "start": 62.399,
      "end": 67.28,
      "text": "ऐसे स्कैम से बचाया जाए और कैसे दूसरों को"
    },
    {
      "subtitle_id": 30,
      "start": 65.119,
      "end": 69.28,
      "text": "इस तरह के स्कैम से बचाया जाए क्योंकि जो"
    },
    {
      "subtitle_id": 31,
      "start": 67.28,
      "end": 71.2,
      "text": "फिनोवेशंस के सब्सक्राइबर्स हैं वो तो इस"
    },
    {
      "subtitle_id": 32,
      "start": 69.28,
      "end": 73.76,
      "text": "तरह के स्कैम्स में नहीं फंसते हैं। पर जो"
    },
    {
      "subtitle_id": 33,
      "start": 71.2,
      "end": 76.24,
      "text": "नहीं हैं जैसे कि आपके दोस्त, आपके परिजन"
    },
    {
      "subtitle_id": 34,
      "start": 73.76,
      "end": 77.92,
      "text": "उनको आप कैसे बचाएं? यह भी फिनोशंस के"
    },
    {
      "subtitle_id": 35,
      "start": 76.24,
      "end": 80.0,
      "text": "सब्सक्राइबर के होने के चलते आपकी"
    },
    {
      "subtitle_id": 36,
      "start": 77.92,
      "end": 82.08,
      "text": "जिम्मेदारी है। तो चलिए सीधे आते हैं"
    },
    {
      "subtitle_id": 37,
      "start": 80.0,
      "end": 83.6,
      "text": "मुद्दे पर। नमस्कार, मैं प्रसाद आपका आज"
    },
    {
      "subtitle_id": 38,
      "start": 82.08,
      "end": 86.0,
      "text": "के इस वीडियो में स्वागत करता हूं। चलिए"
    },
    {
      "subtitle_id": 39,
      "start": 83.6,
      "end": 88.08,
      "text": "शुरू से शुरू करते हैं। यह स्कैमर्स क्या"
    },
    {
      "subtitle_id": 40,
      "start": 86.0,
      "end": 90.08,
      "text": "करते हैं? एक कंपनी बनाते हैं जिसका नाम"
    },
    {
      "subtitle_id": 41,
      "start": 88.08,
      "end": 92.56,
      "text": "रख देते हैं गल्फ फर्स्ट कमर्शियल"
    },
    {
      "subtitle_id": 42,
      "start": 90.08,
      "end": 94.64,
      "text": "ब्रोकर्स। अब यह सेम तरीका जो डीबी स्टॉक"
    },
    {
      "subtitle_id": 43,
      "start": 92.56,
      "end": 96.56,
      "text": "ब्रोकिंग में था। नाम में ब्रोकिंग वगैरह"
    },
    {
      "subtitle_id": 44,
      "start": 94.64,
      "end": 98.72,
      "text": "लगा दिया पर ना डीबी स्टॉक ब्रोकिंग का"
    },
    {
      "subtitle_id": 45,
      "start": 96.56,
      "end": 100.4,
      "text": "ब्रोकिंग से कोई लेना देना था ना ही गल्फ"
    },
    {
      "subtitle_id": 46,
      "start": 98.72,
      "end": 102.64,
      "text": "फर्स्ट कमर्शियल ब्रोकर्स का ब्रोकरेज"
    },
    {
      "subtitle_id": 47,
      "start": 100.4,
      "end": 105.84,
      "text": "बिज़नेस से कोई लेना देना था। इनका लेना"
    },
    {
      "subtitle_id": 48,
      "start": 102.64,
      "end": 108.079,
      "text": "देना है बस एक चीज से और वो है स्कैम से।"
    },
    {
      "subtitle_id": 49,
      "start": 105.84,
      "end": 111.52,
      "text": "इनके दुबई के मशहूर कैपिटल गोल्डन टावर"
    },
    {
      "subtitle_id": 50,
      "start": 108.079,
      "end": 113.92,
      "text": "में दो स्वीट थे। 302 और 305 जहां से यह"
    },
    {
      "subtitle_id": 51,
      "start": 111.52,
      "end": 116.159,
      "text": "400 बीसी का काम चला रहे थे। अगर स्कैम"
    },
    {
      "subtitle_id": 52,
      "start": 113.92,
      "end": 118.32,
      "text": "करने का तरीका देखें तो 40-50 लोगों की"
    },
    {
      "subtitle_id": 53,
      "start": 116.159,
      "end": 120.32,
      "text": "इनकी एक टीम थी। दिखावा करने के लिए मान"
    },
    {
      "subtitle_id": 54,
      "start": 118.32,
      "end": 122.479,
      "text": "लो या जो भी है जिसमें इंडियंस थे,"
    },
    {
      "subtitle_id": 55,
      "start": 120.32,
      "end": 124.719,
      "text": "पाकिस्तानी थे, बांग्लादेशी थे, फिलीपींस"
    },
    {
      "subtitle_id": 56,
      "start": 122.479,
      "end": 126.799,
      "text": "के लोग थे जो वहां पर काम करने के लिए आए"
    },
    {
      "subtitle_id": 57,
      "start": 124.719,
      "end": 128.8,
      "text": "थे। अब ये जो 40-50 लोगों की इनकी टीम है"
    },
    {
      "subtitle_id": 58,
      "start": 126.799,
      "end": 131.039,
      "text": "यह कोल्ड कॉल करती थी दुबई के लोगों को जो"
    },
    {
      "subtitle_id": 59,
      "start": 128.8,
      "end": 132.64,
      "text": "भी डेटाबेस उनके पास आता था और फिर बोलती"
    },
    {
      "subtitle_id": 60,
      "start": 131.039,
      "end": 134.56,
      "text": "थी कि फॉरेक्स इन्वेस्टमेंट की एक बहुत"
    },
    {
      "subtitle_id": 61,
      "start": 132.64,
      "end": 136.08,
      "text": "बड़ी अपॉर्चुनिटी हमारे पास है। अब आप"
    },
    {
      "subtitle_id": 62,
      "start": 134.56,
      "end": 137.84,
      "text": "पूछेंगे कि ये फॉरेक्स इन्वेस्टमेंट्स"
    },
    {
      "subtitle_id": 63,
      "start": 136.08,
      "end": 139.2,
      "text": "आखिर क्या होती है? चलो तो उसे भी क्विकली"
    },
    {
      "subtitle_id": 64,
      "start": 137.84,
      "end": 140.56,
      "text": "मैं समझा देता हूं। तो फॉरेक्स"
    },
    {
      "subtitle_id": 65,
      "start": 139.2,
      "end": 142.56,
      "text": "इन्वेस्टमेंट्स में क्या होता है? अलग-अलग"
    },
    {
      "subtitle_id": 66,
      "start": 140.56,
      "end": 144.4,
      "text": "करेंसीज का लेनदेन करना। यह एक काफी"
    },
    {
      "subtitle_id": 67,
      "start": 142.56,
      "end": 146.56,
      "text": "स्पेकुलेटिव सेक्टर है। इंडिया में भी"
    },
    {
      "subtitle_id": 68,
      "start": 144.4,
      "end": 148.239,
      "text": "फॉरेक्स ट्रेडिंग हेवली रेगुलेटेड है। अगर"
    },
    {
      "subtitle_id": 69,
      "start": 146.56,
      "end": 150.239,
      "text": "आप इंडिया में अनऑथराइज्ड फॉरेक्स"
    },
    {
      "subtitle_id": 70,
      "start": 148.239,
      "end": 152.4,
      "text": "ट्रेडिंग करवा रहे हो तो फेमा एक्ट के"
    },
    {
      "subtitle_id": 71,
      "start": 150.239,
      "end": 153.84,
      "text": "अंडर आप पर कानूनी कारवाई होगी। क्योंकि"
    },
    {
      "subtitle_id": 72,
      "start": 152.4,
      "end": 155.44,
      "text": "यहां पर स्पेकुलेशन ज्यादा होता है तो"
    },
    {
      "subtitle_id": 73,
      "start": 153.84,
      "end": 157.84,
      "text": "इंडियन करेंसी पर भी उसका बहुत बड़ा"
    },
    {
      "subtitle_id": 74,
      "start": 155.44,
      "end": 159.92,
      "text": "इंपैक्ट होता है। आपको याद होगा कि 1990"
    },
    {
      "subtitle_id": 75,
      "start": 157.84,
      "end": 162.4,
      "text": "में कुछ इसी तरह की चीजें जॉर्ज सोररोस ने"
    },
    {
      "subtitle_id": 76,
      "start": 159.92,
      "end": 164.48,
      "text": "की थी इंग्लैंड में जहां पर उन्होंने उनका"
    },
    {
      "subtitle_id": 77,
      "start": 162.4,
      "end": 166.8,
      "text": "जो पाउंड है उसमें स्पेकुलेटिव ट्रेड्स"
    },
    {
      "subtitle_id": 78,
      "start": 164.48,
      "end": 168.959,
      "text": "लिए थे और उसका करेंसी की वैल्यू पर बहुत"
    },
    {
      "subtitle_id": 79,
      "start": 166.8,
      "end": 171.2,
      "text": "बड़ा इंपैक्ट था। तो सिर्फ इंडिया ही नहीं"
    },
    {
      "subtitle_id": 80,
      "start": 168.959,
      "end": 173.12,
      "text": "बल्कि ईरान और इवन यूरोपियन यूनियन के"
    },
    {
      "subtitle_id": 81,
      "start": 171.2,
      "end": 175.44,
      "text": "बहुत सारे देशों में यह चीज बहुत ही"
    },
    {
      "subtitle_id": 82,
      "start": 173.12,
      "end": 177.44,
      "text": "हैवीली रेगुलेटेड है। यानी कि यहां पर भी"
    },
    {
      "subtitle_id": 83,
      "start": 175.44,
      "end": 179.84,
      "text": "अगर आसान भाषा में बता दूं तो यहां पर भी"
    },
    {
      "subtitle_id": 84,
      "start": 177.44,
      "end": 181.92,
      "text": "ऑप्शंस ट्रेडिंग जैसे ही पैसा बनाना बड़ा"
    },
    {
      "subtitle_id": 85,
      "start": 179.84,
      "end": 184.8,
      "text": "मुश्किल है। वीडियो में आगे बढ़ने से पहले"
    },
    {
      "subtitle_id": 86,
      "start": 181.92,
      "end": 186.4,
      "text": "एक नहीं दो खुशखबरी आपको सुनाना चाहता"
    },
    {
      "subtitle_id": 87,
      "start": 184.8,
      "end": 188.239,
      "text": "हूं। यानी कि फाइनेंसियल मॉडलिंग एंड"
    },
    {
      "subtitle_id": 88,
      "start": 186.4,
      "end": 190.72,
      "text": "वैल्यूएशन मेंटोरशिप के नेक्स्ट कोहर्ट की"
    },
    {
      "subtitle_id": 89,
      "start": 188.239,
      "end": 192.8,
      "text": "एडमिशंस स्टार्ट हो गई है। और दूसरा हमने"
    },
    {
      "subtitle_id": 90,
      "start": 190.72,
      "end": 194.72,
      "text": "एफएमवीएम के लिए बीएसई इंस्टट्यूट यानी"
    },
    {
      "subtitle_id": 91,
      "start": 192.8,
      "end": 196.879,
      "text": "बॉम्बे स्टॉक एक्सचेंज इंस्टट्यूट के साथ"
    },
    {
      "subtitle_id": 92,
      "start": 194.72,
      "end": 198.959,
      "text": "टाई अप किया है। और इस एफएमवीएम मेंटोरशिप"
    },
    {
      "subtitle_id": 93,
      "start": 196.879,
      "end": 200.959,
      "text": "को सक्सेसफुली कंप्लीट करने पर आपको बीएस"
    },
    {
      "subtitle_id": 94,
      "start": 198.959,
      "end": 203.12,
      "text": "इंस्टट्यूट का सर्टिफिकेट भी मिलेगा। तो"
    },
    {
      "subtitle_id": 95,
      "start": 200.959,
      "end": 205.12,
      "text": "सवाल यह है कि यह एफएमवीएम किन के लिए है?"
    },
    {
      "subtitle_id": 96,
      "start": 203.12,
      "end": 206.8,
      "text": "तो आपको बता दूं कि यह मेंटोरशिप उन सबके"
    },
    {
      "subtitle_id": 97,
      "start": 205.12,
      "end": 208.48,
      "text": "लिए है जिन्हें एक अच्छा इन्वेस्टर बनना"
    },
    {
      "subtitle_id": 98,
      "start": 206.8,
      "end": 210.56,
      "text": "है और उन स्टूडेंट्स के लिए भी यह बहुत ही"
    },
    {
      "subtitle_id": 99,
      "start": 208.48,
      "end": 212.64,
      "text": "फायदेमंद होगा जिन्हें फाइनेंस के फील्ड"
    },
    {
      "subtitle_id": 100,
      "start": 210.56,
      "end": 214.799,
      "text": "में अपना करियर बनाना है। जैसे कि रिसर्च"
    },
    {
      "subtitle_id": 101,
      "start": 212.64,
      "end": 216.799,
      "text": "एनालिस्ट, फंड मैनेजर, पोर्टफोलियो मैनेजर"
    },
    {
      "subtitle_id": 102,
      "start": 214.799,
      "end": 218.56,
      "text": "इस तरह के जॉब्स की तरफ आपको जाना है तो"
    },
    {
      "subtitle_id": 103,
      "start": 216.799,
      "end": 220.4,
      "text": "यह मेंटोरशिप प्रोग्राम आपके लिए एक बहुत"
    },
    {
      "subtitle_id": 104,
      "start": 218.56,
      "end": 222.159,
      "text": "आइडियल प्रोग्राम है। और जरूरी नहीं है कि"
    },
    {
      "subtitle_id": 105,
      "start": 220.4,
      "end": 223.519,
      "text": "इस कोहर्ट को ज्वाइन करने के लिए आपके पास"
    },
    {
      "subtitle_id": 106,
      "start": 222.159,
      "end": 225.04,
      "text": "फाइनेंस का बैकग्राउंड होना चाहिए।"
    },
    {
      "subtitle_id": 107,
      "start": 223.519,
      "end": 227.519,
      "text": "इनफैक्ट हमारे पास्ट के बैचेस में"
    },
    {
      "subtitle_id": 108,
      "start": 225.04,
      "end": 229.36,
      "text": "इंजीनियर से लेकर लॉयर्स, डॉक्टर्स, हर"
    },
    {
      "subtitle_id": 109,
      "start": 227.519,
      "end": 231.28,
      "text": "प्रोफेशंस के लोग एनरोल कर चुके हैं।"
    },
    {
      "subtitle_id": 110,
      "start": 229.36,
      "end": 232.799,
      "text": "इनफैक्ट कुछ हाउसवाइफ्स भी एफएमवीएम"
    },
    {
      "subtitle_id": 111,
      "start": 231.28,
      "end": 234.56,
      "text": "मेंटोरशिप प्रोग्राम में एनरोल कर चुकी"
    },
    {
      "subtitle_id": 112,
      "start": 232.799,
      "end": 236.879,
      "text": "है। तो आप किसी भी बैकग्राउंड के हो आप"
    },
    {
      "subtitle_id": 113,
      "start": 234.56,
      "end": 238.56,
      "text": "बेझिझक इसमें एनरोल कर सकते हो। यह 3"
    },
    {
      "subtitle_id": 114,
      "start": 236.879,
      "end": 240.72,
      "text": "महीने का एक ऑनलाइन कोहर्ट है जो कि"
    },
    {
      "subtitle_id": 115,
      "start": 238.56,
      "end": 242.48,
      "text": "वीकेंड ऑनलाइन प्रोग्राम है। जहां पर मेरे"
    },
    {
      "subtitle_id": 116,
      "start": 240.72,
      "end": 244.72,
      "text": "साथ-साथ कुछ इंडस्ट्री एक्सपर्ट्स आपके"
    },
    {
      "subtitle_id": 117,
      "start": 242.48,
      "end": 246.319,
      "text": "साथ रहेंगे और हम आपको सिखाएंगे कि किस"
    },
    {
      "subtitle_id": 118,
      "start": 244.72,
      "end": 247.92,
      "text": "तरह से कंपनी की फाइनेंसियल मॉडलिंग करनी"
    },
    {
      "subtitle_id": 119,
      "start": 246.319,
      "end": 249.92,
      "text": "है। किस तरह से कंपनी के ग्रोथ रेट्स"
    },
    {
      "subtitle_id": 120,
      "start": 247.92,
      "end": 252.0,
      "text": "प्रोजेक्ट करने हैं और किस तरह किसी भी"
    },
    {
      "subtitle_id": 121,
      "start": 249.92,
      "end": 253.68,
      "text": "कंपनी का डीसीएफ मेथड से यानी डिस्काउंटेड"
    },
    {
      "subtitle_id": 122,
      "start": 252.0,
      "end": 255.76,
      "text": "कैश फ्लो मेथड से वैल्यू्यूएशन निकालना है"
    },
    {
      "subtitle_id": 123,
      "start": 253.68,
      "end": 258.0,
      "text": "और कैसे पता करें कि कौन सी कंपनी डीसीएफ"
    },
    {
      "subtitle_id": 124,
      "start": 255.76,
      "end": 260.0,
      "text": "मेथड के अनुसार ओवरवैल्यूड है या फिर"
    },
    {
      "subtitle_id": 125,
      "start": 258.0,
      "end": 261.6,
      "text": "अंडरवैल्यूड यानी सस्ती है या महंगी। तो"
    },
    {
      "subtitle_id": 126,
      "start": 260.0,
      "end": 263.36,
      "text": "एनरोल करने के लिए नीचे डिस्क्रिप्शन और"
    },
    {
      "subtitle_id": 127,
      "start": 261.6,
      "end": 264.96,
      "text": "कमेंट बॉक्स में एक लिंक दी है। उस पर"
    },
    {
      "subtitle_id": 128,
      "start": 263.36,
      "end": 266.88,
      "text": "क्लिक करने के बाद वन आवर का काउंसलिंग"
    },
    {
      "subtitle_id": 129,
      "start": 264.96,
      "end": 268.72,
      "text": "सेशन है जो आपको ज्वाइन करना है। जहां पर"
    },
    {
      "subtitle_id": 130,
      "start": 266.88,
      "end": 270.32,
      "text": "एफएमवीएम के बारे में और इस कोहर्ट के"
    },
    {
      "subtitle_id": 131,
      "start": 268.72,
      "end": 271.759,
      "text": "बारे में सारी डिटेल्स मैं आपके साथ शेयर"
    },
    {
      "subtitle_id": 132,
      "start": 270.32,
      "end": 273.28,
      "text": "करूंगा। तो इस अपोरर्चुनिटी को मिस ना"
    },
    {
      "subtitle_id": 133,
      "start": 271.759,
      "end": 275.199,
      "text": "होने दें क्योंकि हमारे कोहर्ट बहुत जल्दी"
    },
    {
      "subtitle_id": 134,
      "start": 273.28,
      "end": 277.44,
      "text": "फिल हो जाते हैं और फिर नेक्स्ट कोहर्ट भी"
    },
    {
      "subtitle_id": 135,
      "start": 275.199,
      "end": 279.44,
      "text": "काफी टाइम बाद आता है। सो डोंट मिस आउट ऑन"
    },
    {
      "subtitle_id": 136,
      "start": 277.44,
      "end": 281.199,
      "text": "दिस ओपोरर्चुनिटी। चलिए अब आगे बढ़ते हैं।"
    },
    {
      "subtitle_id": 137,
      "start": 279.44,
      "end": 283.68,
      "text": "लेकिन गल्फस्ट वालों को उससे कोई फर्क"
    },
    {
      "subtitle_id": 138,
      "start": 281.199,
      "end": 285.36,
      "text": "नहीं पड़ता कि 70% लोग यहां पर पैसा गवा"
    },
    {
      "subtitle_id": 139,
      "start": 283.68,
      "end": 287.68,
      "text": "रहे हैं। यह लोग कोल्ड कॉलिंग पर क्या"
    },
    {
      "subtitle_id": 140,
      "start": 285.36,
      "end": 290.56,
      "text": "बोलते हैं लोगों को कि अगर आप हमारे जरिए"
    },
    {
      "subtitle_id": 141,
      "start": 287.68,
      "end": 293.36,
      "text": "फॉरेक्स ट्रेडिंग करेंगे तो 100% आपका"
    },
    {
      "subtitle_id": 142,
      "start": 290.56,
      "end": 295.04,
      "text": "पैसा बनेगा ही बनेगा। आपको करना कुछ नहीं"
    },
    {
      "subtitle_id": 143,
      "start": 293.36,
      "end": 298.0,
      "text": "है। हमारा एक प्लेटफार्म है जिसका नाम है"
    },
    {
      "subtitle_id": 144,
      "start": 295.04,
      "end": 300.24,
      "text": "सिग्मा वन कैपिटल उसके जरिए आपको यहां पर"
    },
    {
      "subtitle_id": 145,
      "start": 298.0,
      "end": 302.16,
      "text": "पैसा इन्वेस्ट करना है। अब जो बहुत सारे"
    },
    {
      "subtitle_id": 146,
      "start": 300.24,
      "end": 304.0,
      "text": "इंडिया में स्कैम हुए और यह जो स्कैम है"
    },
    {
      "subtitle_id": 147,
      "start": 302.16,
      "end": 305.759,
      "text": "इसमें बड़ा अंतर यह है कि डीबी स्टॉक"
    },
    {
      "subtitle_id": 148,
      "start": 304.0,
      "end": 308.24,
      "text": "ब्रोकिंग हो या फिर torरेस हो उसमें"
    },
    {
      "subtitle_id": 149,
      "start": 305.759,
      "end": 310.479,
      "text": "प्रॉमिससेस बहुत बड़े किए गए थे। 200%"
    },
    {
      "subtitle_id": 150,
      "start": 308.24,
      "end": 312.32,
      "text": "300% के जिससे बहुत सारे लोगों को आईडिया"
    },
    {
      "subtitle_id": 151,
      "start": 310.479,
      "end": 314.88,
      "text": "आ गई थी कि यह स्कैम है और बाद में उनको"
    },
    {
      "subtitle_id": 152,
      "start": 312.32,
      "end": 317.199,
      "text": "पकड़ा भी गया लेकिन यह स्कैम अलग था। यहां"
    },
    {
      "subtitle_id": 153,
      "start": 314.88,
      "end": 319.12,
      "text": "पर इन्होंने 200300% के प्रॉमिससेस नहीं"
    },
    {
      "subtitle_id": 154,
      "start": 317.199,
      "end": 322.16,
      "text": "दिए। इन्होंने यहां पर क्या दिमाग लगाया"
    },
    {
      "subtitle_id": 155,
      "start": 319.12,
      "end": 324.32,
      "text": "कि आप मिनिमम $10,000 यानी लगभग ₹89 लाख"
    },
    {
      "subtitle_id": 156,
      "start": 322.16,
      "end": 326.4,
      "text": "इन्वेस्ट कीजिए जो कि इनकी एक मिनिमम"
    },
    {
      "subtitle_id": 157,
      "start": 324.32,
      "end": 329.199,
      "text": "इन्वेस्टमेंट थी जो यह लोग लेते थे सामने"
    },
    {
      "subtitle_id": 158,
      "start": 326.4,
      "end": 331.72,
      "text": "वालों से और उसके बदले में आपको मिलेगा 3%"
    },
    {
      "subtitle_id": 159,
      "start": 329.199,
      "end": 334.479,
      "text": "पर मंथ। यानी साल का कितना हुआ?"
    },
    {
      "subtitle_id": 160,
      "start": 331.72,
      "end": 336.639,
      "text": "36%। सिंपल था। किसी को डाउट नहीं आया।"
    },
    {
      "subtitle_id": 161,
      "start": 334.479,
      "end": 338.88,
      "text": "बहुत बड़े-बड़े वादे भी नहीं किए गए। तो"
    },
    {
      "subtitle_id": 162,
      "start": 336.639,
      "end": 340.56,
      "text": "लोगों को भी यहां पर लगाया कि हां 36% तो"
    },
    {
      "subtitle_id": 163,
      "start": 338.88,
      "end": 342.479,
      "text": "मिल सकते हैं। इसलिए उन्होंने वहां पर"
    },
    {
      "subtitle_id": 164,
      "start": 340.56,
      "end": 344.479,
      "text": "पैसा डालना शुरू किया। अब फिर लोगों ने"
    },
    {
      "subtitle_id": 165,
      "start": 342.479,
      "end": 346.08,
      "text": "यहां पर ऐसा वैसा पैसा नहीं लगाया। कई"
    },
    {
      "subtitle_id": 166,
      "start": 344.479,
      "end": 348.24,
      "text": "सारे लोगों ने यहां पर अपनी पूरी लाइफ"
    },
    {
      "subtitle_id": 167,
      "start": 346.08,
      "end": 351.08,
      "text": "सेविंग्स इसमें लगा दी। जैसे दो लोग"
    },
    {
      "subtitle_id": 168,
      "start": 348.24,
      "end": 353.759,
      "text": "मोहम्मद और फयाज़ ने इस स्कीम में"
    },
    {
      "subtitle_id": 169,
      "start": 351.08,
      "end": 356.08,
      "text": "$75,000 यानी कि ₹60 लाख से ज्यादा"
    },
    {
      "subtitle_id": 170,
      "start": 353.759,
      "end": 358.32,
      "text": "इन्वेस्ट किए। मार्च महीने तक इनको"
    },
    {
      "subtitle_id": 171,
      "start": 356.08,
      "end": 359.84,
      "text": "रेगुलरली पैसे मिलते रहे। जैसे कि हर पोंज़"
    },
    {
      "subtitle_id": 172,
      "start": 358.32,
      "end": 362.16,
      "text": "स्कीम में होता है कि शुरुआत में सबको"
    },
    {
      "subtitle_id": 173,
      "start": 359.84,
      "end": 363.919,
      "text": "पैसा मिलता है ताकि स्कीम की बातें हर जगह"
    },
    {
      "subtitle_id": 174,
      "start": 362.16,
      "end": 365.919,
      "text": "पहुंचे और ज्यादा से ज्यादा लोग उस स्कीम"
    },
    {
      "subtitle_id": 175,
      "start": 363.919,
      "end": 368.88,
      "text": "में इन्वेस्ट करें। लेकिन मार्च के बाद"
    },
    {
      "subtitle_id": 176,
      "start": 365.919,
      "end": 371.6,
      "text": "पैसा आना बंद हुआ और फिर जब यह लोग उस"
    },
    {
      "subtitle_id": 177,
      "start": 368.88,
      "end": 374.639,
      "text": "कंपनी के ऑफिस में गए तो उन्होंने कुछ ऐसा"
    },
    {
      "subtitle_id": 178,
      "start": 371.6,
      "end": 376.72,
      "text": "देखा। सब कुछ साफ वॉचमैन से पूछा गया तो"
    },
    {
      "subtitle_id": 179,
      "start": 374.639,
      "end": 378.639,
      "text": "उन्होंने बताया कि यह लोग हड़बड़ी में"
    },
    {
      "subtitle_id": 180,
      "start": 376.72,
      "end": 380.72,
      "text": "सारा अपना सामान लेकर लास्ट वीक ही निकल"
    },
    {
      "subtitle_id": 181,
      "start": 378.639,
      "end": 382.4,
      "text": "गए। अब दुबई में क्या है कि आपके ब्रोकिंग"
    },
    {
      "subtitle_id": 182,
      "start": 380.72,
      "end": 384.88,
      "text": "बिजनेस के लिए सर्टिफिकेट्स लेने पड़ते"
    },
    {
      "subtitle_id": 183,
      "start": 382.4,
      "end": 387.199,
      "text": "हैं। जैसे कि एससीए यानी सिक्योरिटीज एंड"
    },
    {
      "subtitle_id": 184,
      "start": 384.88,
      "end": 388.88,
      "text": "कमोडिटीज अथॉरिटी। तो इन लोगों ने क्या"
    },
    {
      "subtitle_id": 185,
      "start": 387.199,
      "end": 391.199,
      "text": "किया था कि ऐसे कोई सर्टिफिकेट भी नहीं"
    },
    {
      "subtitle_id": 186,
      "start": 388.88,
      "end": 393.36,
      "text": "लिए। फेक सर्टिफिकेट बना के वही लोगों को"
    },
    {
      "subtitle_id": 187,
      "start": 391.199,
      "end": 395.6,
      "text": "दिखा दिए। सब कुछ यहां पर इतना लेजिट दिख"
    },
    {
      "subtitle_id": 188,
      "start": 393.36,
      "end": 397.6,
      "text": "रहा था कि लोगों ने मिलियंस ऑफ डॉलर्स इन"
    },
    {
      "subtitle_id": 189,
      "start": 395.6,
      "end": 399.44,
      "text": "स्कीम्स में डाल दिए। लेकिन जैसे ही यह"
    },
    {
      "subtitle_id": 190,
      "start": 397.6,
      "end": 402.319,
      "text": "स्कैम पब्लिक हुआ तो लोगों को पता चला कि"
    },
    {
      "subtitle_id": 191,
      "start": 399.44,
      "end": 404.8,
      "text": "हम फंस गए हैं और हमारा पूरा पैसा अब डूब"
    },
    {
      "subtitle_id": 192,
      "start": 402.319,
      "end": 406.639,
      "text": "गया है। अब सबसे बड़े विक्टिम्स ऐसे स्कैम"
    },
    {
      "subtitle_id": 193,
      "start": 404.8,
      "end": 408.319,
      "text": "में कौन होते हैं? वो लोग जो बिना रिसर्च"
    },
    {
      "subtitle_id": 194,
      "start": 406.639,
      "end": 410.72,
      "text": "किए, बिना स्टडी किए, बिना इन्वेस्टमेंट"
    },
    {
      "subtitle_id": 195,
      "start": 408.319,
      "end": 412.88,
      "text": "की समझ रखे इन जैसे स्कीम्स में अपनी पूरी"
    },
    {
      "subtitle_id": 196,
      "start": 410.72,
      "end": 415.28,
      "text": "लाइफ की सेविंग्स लगा देते हैं। अब एक और"
    },
    {
      "subtitle_id": 197,
      "start": 412.88,
      "end": 417.36,
      "text": "एग्जांपल ले लो। दुबई बेस्ड ब्लूचिप"
    },
    {
      "subtitle_id": 198,
      "start": 415.28,
      "end": 420.0,
      "text": "ग्रुप। इनका भी वही फार्मूला था इन्वेस्ट"
    },
    {
      "subtitle_id": 199,
      "start": 417.36,
      "end": 422.4,
      "text": "करो और गारंटी के साथ मंथली रिटर्न्स पाओ।"
    },
    {
      "subtitle_id": 200,
      "start": 420.0,
      "end": 424.08,
      "text": "इनफैक्ट हम सब दुबई को एक सेफ प्लेस के"
    },
    {
      "subtitle_id": 201,
      "start": 422.4,
      "end": 426.24,
      "text": "रूप में देखते हैं सिक्योरिटी और सेफ्टी"
    },
    {
      "subtitle_id": 202,
      "start": 424.08,
      "end": 428.0,
      "text": "के मामले में। लेकिन सच यह भी है कि दुबई"
    },
    {
      "subtitle_id": 203,
      "start": 426.24,
      "end": 430.0,
      "text": "में फाइनेंसियल फ्रॉड्स रिसेंट टाइम में"
    },
    {
      "subtitle_id": 204,
      "start": 428.0,
      "end": 432.4,
      "text": "थोड़े बढ़ रहे हैं। जैसे कि आप स्क्रीन पर"
    },
    {
      "subtitle_id": 205,
      "start": 430.0,
      "end": 434.24,
      "text": "देख सकते हो डट एफएक्स और ईवीएम प्राइम"
    },
    {
      "subtitle_id": 206,
      "start": 432.4,
      "end": 436.0,
      "text": "सपोर्ट स्कैम। अप्रैल में दुबई में एक"
    },
    {
      "subtitle_id": 207,
      "start": 434.24,
      "end": 438.479,
      "text": "सोशल मीडिया जॉब स्कैम सामने आया।"
    },
    {
      "subtitle_id": 208,
      "start": 436.0,
      "end": 440.479,
      "text": "फ्रॉडस्टर्स ने फेक जॉब एड्स के थ्रू"
    },
    {
      "subtitle_id": 209,
      "start": 438.479,
      "end": 442.639,
      "text": "लोगों को सेल्स जॉब देने का वादा किया और"
    },
    {
      "subtitle_id": 210,
      "start": 440.479,
      "end": 445.36,
      "text": "फिर गायब हो गए। फिर अभी मई महीने में"
    },
    {
      "subtitle_id": 211,
      "start": 442.639,
      "end": 447.599,
      "text": "दुबई पुलिस ने तीन फोन स्कैम गैंग्स को"
    },
    {
      "subtitle_id": 212,
      "start": 445.36,
      "end": 449.28,
      "text": "पकड़ लिया। जिनमें 13 लोग शामिल थे। यह"
    },
    {
      "subtitle_id": 213,
      "start": 447.599,
      "end": 451.36,
      "text": "गैंग अपने आप को पुलिस और बैंक के"
    },
    {
      "subtitle_id": 214,
      "start": 449.28,
      "end": 453.68,
      "text": "ऑफिशियल्स बताकर लोगों से सेंसिटिव"
    },
    {
      "subtitle_id": 215,
      "start": 451.36,
      "end": 456.0,
      "text": "बैंकिंग इंफॉर्मेशन जैसे कि सीवीवी और"
    },
    {
      "subtitle_id": 216,
      "start": 453.68,
      "end": 457.919,
      "text": "ओटीपी लेकर उनके अकाउंट से पैसे निकाला"
    },
    {
      "subtitle_id": 217,
      "start": 456.0,
      "end": 459.599,
      "text": "करते थे। अभी अप्रैल महीने में भी दुबई"
    },
    {
      "subtitle_id": 218,
      "start": 457.919,
      "end": 461.759,
      "text": "में एक बहुत ज्यादा इंटरेस्टिंग स्कैम"
    },
    {
      "subtitle_id": 219,
      "start": 459.599,
      "end": 464.16,
      "text": "सामने आया। ये स्कैमर्स क्या करते थे कि"
    },
    {
      "subtitle_id": 220,
      "start": 461.759,
      "end": 466.479,
      "text": "लोगों को WhatsApp पर मीम्स भेजते थे जो"
    },
    {
      "subtitle_id": 221,
      "start": 464.16,
      "end": 468.639,
      "text": "असली में मालवेयर या फिर स्पाईवेयर से भरे"
    },
    {
      "subtitle_id": 222,
      "start": 466.479,
      "end": 471.039,
      "text": "होते थे। जैसे ही आप इन इमेजेस को डाउनलोड"
    },
    {
      "subtitle_id": 223,
      "start": 468.639,
      "end": 473.44,
      "text": "या ओपन करते हो, आपका फोन इनफेक्ट हो जाता"
    },
    {
      "subtitle_id": 224,
      "start": 471.039,
      "end": 475.759,
      "text": "है। इससे हैकर्स आपका पर्सनल डाटा, बैंक"
    },
    {
      "subtitle_id": 225,
      "start": 473.44,
      "end": 477.84,
      "text": "डिटेल्स, ओटीपीस और सोशल मीडिया अकाउंट्स"
    },
    {
      "subtitle_id": 226,
      "start": 475.759,
      "end": 479.12,
      "text": "तक एक्सेस कर लेते थे। यह स्कैम रिसेंट"
    },
    {
      "subtitle_id": 227,
      "start": 477.84,
      "end": 481.44,
      "text": "टाइम में इंडिया में भी फैल रहा है। तो"
    },
    {
      "subtitle_id": 228,
      "start": 479.12,
      "end": 483.44,
      "text": "अगर अननोन नंबर से आपको इस तरह के कोई आए"
    },
    {
      "subtitle_id": 229,
      "start": 481.44,
      "end": 485.84,
      "text": "कोई वीडियो भेजें, कोई फोटो भेजें या मीम"
    },
    {
      "subtitle_id": 230,
      "start": 483.44,
      "end": 487.919,
      "text": "भेजें ओपन मत कीजिए। अनलेस एंड अंटिल आपको"
    },
    {
      "subtitle_id": 231,
      "start": 485.84,
      "end": 490.08,
      "text": "पता है कि वह व्यक्ति कौन है। अब बात करते"
    },
    {
      "subtitle_id": 232,
      "start": 487.919,
      "end": 492.4,
      "text": "हैं लीगलिटी की कि इंडिया में स्कैम होता"
    },
    {
      "subtitle_id": 233,
      "start": 490.08,
      "end": 494.639,
      "text": "है तो पकड़ लो कि पैसा मिलता ही नहीं है।"
    },
    {
      "subtitle_id": 234,
      "start": 492.4,
      "end": 496.24,
      "text": "वहां पर स्कैम हुआ है तो क्या चीज है? तो"
    },
    {
      "subtitle_id": 235,
      "start": 494.639,
      "end": 498.879,
      "text": "वहां के कोर्ट ने इस पर्टिकुलर स्कैम में"
    },
    {
      "subtitle_id": 236,
      "start": 496.24,
      "end": 501.039,
      "text": "कहा था कि आपका पैसा कंपनी को 7 दिन में"
    },
    {
      "subtitle_id": 237,
      "start": 498.879,
      "end": 503.039,
      "text": "वापस करना है। लेकिन बाद में पता चला कि"
    },
    {
      "subtitle_id": 238,
      "start": 501.039,
      "end": 504.96,
      "text": "कंपनी का फाउंडर यह पैसे लेकर दुबई छोड़कर"
    },
    {
      "subtitle_id": 239,
      "start": 503.039,
      "end": 507.28,
      "text": "भाग गया है। और यह जो कंपनी है गल्फ"
    },
    {
      "subtitle_id": 240,
      "start": 504.96,
      "end": 509.44,
      "text": "कमर्शियल यह रजिस्टर्ड हुई थी सिग्मा वन"
    },
    {
      "subtitle_id": 241,
      "start": 507.28,
      "end": 511.36,
      "text": "नाम से सेंट लुसिया में। अब देखिए दुबई जो"
    },
    {
      "subtitle_id": 242,
      "start": 509.44,
      "end": 513.76,
      "text": "है वहां पर अगर आप कोई क्राइम करते हो तो"
    },
    {
      "subtitle_id": 243,
      "start": 511.36,
      "end": 515.76,
      "text": "बचना बहुत मुश्किल है। वहां पर बहुत"
    },
    {
      "subtitle_id": 244,
      "start": 513.76,
      "end": 517.839,
      "text": "ज्यादा स्ट्रिक्ट सजा है। लेकिन रिसेंटली"
    },
    {
      "subtitle_id": 245,
      "start": 515.76,
      "end": 519.68,
      "text": "ऐसा पाया गया है कि दुबई को ब्लैक मनी के"
    },
    {
      "subtitle_id": 246,
      "start": 517.839,
      "end": 521.919,
      "text": "लिए काफी लोग सेफ हेवन के तौर पर भी यूज"
    },
    {
      "subtitle_id": 247,
      "start": 519.68,
      "end": 523.919,
      "text": "कर रहे हैं। इवन कई केसेस में माफिया भी"
    },
    {
      "subtitle_id": 248,
      "start": 521.919,
      "end": 525.76,
      "text": "वहां से ऑपरेट करते हुए नजर आए हैं। और कई"
    },
    {
      "subtitle_id": 249,
      "start": 523.919,
      "end": 528.0,
      "text": "सारे स्कैमर्स जैसे कि एक रिपोर्ट आई थी"
    },
    {
      "subtitle_id": 250,
      "start": 525.76,
      "end": 530.48,
      "text": "नीरव मोदी की जहां पर यह पता चला कि उसकी"
    },
    {
      "subtitle_id": 251,
      "start": 528.0,
      "end": 532.24,
      "text": "दुबई में 11 प्रॉपर्टीज हैं। तो बेशक दुबई"
    },
    {
      "subtitle_id": 252,
      "start": 530.48,
      "end": 534.88,
      "text": "एक बहुत ही सेफ प्लेस है। लास्ट ईयर जब"
    },
    {
      "subtitle_id": 253,
      "start": 532.24,
      "end": 537.6,
      "text": "मैं गया था तो मैंने ऑफ कोर्स जो सुना था"
    },
    {
      "subtitle_id": 254,
      "start": 534.88,
      "end": 539.2,
      "text": "वही पाया और उससे बेटर ही चीजें पाई। पर"
    },
    {
      "subtitle_id": 255,
      "start": 537.6,
      "end": 541.68,
      "text": "यह भी सच है कि दुबई में भी रिसेंट टाइम"
    },
    {
      "subtitle_id": 256,
      "start": 539.2,
      "end": 543.68,
      "text": "में स्कैमर्स और माफियाज काफी सारा पैसा"
    },
    {
      "subtitle_id": 257,
      "start": 541.68,
      "end": 545.12,
      "text": "अपना रियलस्टेट में लगा रहे हैं। और यह जो"
    },
    {
      "subtitle_id": 258,
      "start": 543.68,
      "end": 546.8,
      "text": "गल्फ कमर्शियल का केस है इस तरह के"
    },
    {
      "subtitle_id": 259,
      "start": 545.12,
      "end": 548.72,
      "text": "स्कैम्स भी अब वहां पर बढ़ रहे हैं और"
    },
    {
      "subtitle_id": 260,
      "start": 546.8,
      "end": 550.56,
      "text": "पर्टिकुलरली वहां के इंडियन लोगों को ही"
    },
    {
      "subtitle_id": 261,
      "start": 548.72,
      "end": 552.959,
      "text": "टारगेट किया जा रहा है। तो देखिए इंडियन"
    },
    {
      "subtitle_id": 262,
      "start": 550.56,
      "end": 554.72,
      "text": "हो या फिर बाकी एशियन कंट्रीज हैं ये लोग"
    },
    {
      "subtitle_id": 263,
      "start": 552.959,
      "end": 556.8,
      "text": "फाइनेंसियल स्कैम्स में इसलिए भी बहुत"
    },
    {
      "subtitle_id": 264,
      "start": 554.72,
      "end": 559.12,
      "text": "जल्दी फंस जाते हैं क्योंकि इन कंट्रीज"
    },
    {
      "subtitle_id": 265,
      "start": 556.8,
      "end": 561.68,
      "text": "में फाइनेंसियल लिटरेसी की बहुत कमी है और"
    },
    {
      "subtitle_id": 266,
      "start": 559.12,
      "end": 563.6,
      "text": "26 से 27% का हार्डली फाइनेंसियल लिटरेसी"
    },
    {
      "subtitle_id": 267,
      "start": 561.68,
      "end": 565.76,
      "text": "इंडिया और बाकी आजूबाजू की कंट्रीज में"
    },
    {
      "subtitle_id": 268,
      "start": 563.6,
      "end": 567.279,
      "text": "है। जबकि यूरोप और बाकी जो एडवांस कंट्रीज"
    },
    {
      "subtitle_id": 269,
      "start": 565.76,
      "end": 570.24,
      "text": "हैं वहां पर यह फाइनेंसियल लिटरेसी का"
    },
    {
      "subtitle_id": 270,
      "start": 567.279,
      "end": 572.32,
      "text": "रेशियो 75% तक चला जाता है। और दुबई में"
    },
    {
      "subtitle_id": 271,
      "start": 570.24,
      "end": 574.959,
      "text": "जो साउथ एशिया के लोग हैं वह ज्यादा"
    },
    {
      "subtitle_id": 272,
      "start": 572.32,
      "end": 576.56,
      "text": "मजदूरी वगैरह करते हैं। जैसे जब मैं दुबई"
    },
    {
      "subtitle_id": 273,
      "start": 574.959,
      "end": 578.399,
      "text": "गया तो वहां पर जितने भी ड्राइवर्स मैंने"
    },
    {
      "subtitle_id": 274,
      "start": 576.56,
      "end": 580.8,
      "text": "देखे या तो वो पाकिस्तानी थे या फिर"
    },
    {
      "subtitle_id": 275,
      "start": 578.399,
      "end": 583.12,
      "text": "बांग्लादेशी। तो अगर आपके जान पहचान वाला"
    },
    {
      "subtitle_id": 276,
      "start": 580.8,
      "end": 585.6,
      "text": "कोई है दुबई में तो उनसे भी यह वीडियो"
    },
    {
      "subtitle_id": 277,
      "start": 583.12,
      "end": 587.519,
      "text": "जरूर शेयर कीजिए। ताकि अगर फाउंडर्स और"
    },
    {
      "subtitle_id": 278,
      "start": 585.6,
      "end": 589.839,
      "text": "बाकी सारे लोग ही कंट्री छोड़कर भाग जाए"
    },
    {
      "subtitle_id": 279,
      "start": 587.519,
      "end": 591.44,
      "text": "तो उनसे पैसा वापस लाना इस वेरी टफ। और जो"
    },
    {
      "subtitle_id": 280,
      "start": 589.839,
      "end": 592.88,
      "text": "आपके दोस्त या फिर अगर आप दुबई में"
    },
    {
      "subtitle_id": 281,
      "start": 591.44,
      "end": 594.64,
      "text": "रियलस्टेट में इन्वेस्ट करने की प्लानिंग"
    },
    {
      "subtitle_id": 282,
      "start": 592.88,
      "end": 597.2,
      "text": "कर रहे हैं तो यह सारी चीजें दिमाग में"
    },
    {
      "subtitle_id": 283,
      "start": 594.64,
      "end": 599.44,
      "text": "रखें कि आपको भी शायद फंसाया जा सकता है।"
    },
    {
      "subtitle_id": 284,
      "start": 597.2,
      "end": 601.76,
      "text": "एकदम प्रॉपर चेक करके प्रॉपर सारी चीजें"
    },
    {
      "subtitle_id": 285,
      "start": 599.44,
      "end": 603.6,
      "text": "वेरीफाई करके ही इन्वेस्टमेंट करें। फिर"
    },
    {
      "subtitle_id": 286,
      "start": 601.76,
      "end": 605.2,
      "text": "चाहे वहां की रियलस्टेट हो या फिर बाकी"
    },
    {
      "subtitle_id": 287,
      "start": 603.6,
      "end": 606.72,
      "text": "कोई इन्वेस्टमेंट। इसी तरह के फाइनेंस"
    },
    {
      "subtitle_id": 288,
      "start": 605.2,
      "end": 608.24,
      "text": "अवेयरनेस वीडियोस के लिए चैनल को जरूर"
    },
    {
      "subtitle_id": 289,
      "start": 606.72,
      "end": 609.36,
      "text": "सब्सक्राइब करें और बेल आइकॉन पर भी क्लिक"
    },
    {
      "subtitle_id": 290,
      "start": 608.24,
      "end": 610.88,
      "text": "करें। मैं देखता हूं कि आप में से"
    },
    {
      "subtitle_id": 291,
      "start": 609.36,
      "end": 612.16,
      "text": "ज्यादातर लोग सब्सक्राइब नहीं करते। सिर्फ"
    },
    {
      "subtitle_id": 292,
      "start": 610.88,
      "end": 613.68,
      "text": "वीडियो देखकर चले जाते हैं। तो अच्छे"
    },
    {
      "subtitle_id": 293,
      "start": 612.16,
      "end": 615.6,
      "text": "वीडियोस मिस मत कीजिए। बहुत ही इन डेप्थ"
    },
    {
      "subtitle_id": 294,
      "start": 613.68,
      "end": 617.44,
      "text": "रिसर्च वाले ही हमारे वीडियोस सारे आपको"
    },
    {
      "subtitle_id": 295,
      "start": 615.6,
      "end": 619.76,
      "text": "मिलेंगे। कोई नहीं मिलता है तो आप कमेंट"
    },
    {
      "subtitle_id": 296,
      "start": 617.44,
      "end": 621.519,
      "text": "करके बता दो क्योंकि ऐसा आपको नहीं मिलेगा"
    },
    {
      "subtitle_id": 297,
      "start": 619.76,
      "end": 624.0,
      "text": "कभी और इस वीडियो को सभी के साथ शेयर"
    },
    {
      "subtitle_id": 298,
      "start": 621.519,
      "end": 626.48,
      "text": "कीजिए दनादन एकदम ताकत से ताकि वह लोग बचे"
    },
    {
      "subtitle_id": 299,
      "start": 624.0,
      "end": 630.92,
      "text": "यह आपका धर्म है यह आपकी रिस्पांसिबिलिटी"
    },
    {
      "subtitle_id": 300,
      "start": 626.48,
      "end": 630.92,
      "text": "है सी यू देन बाय टेक केयर"
    }
  ]
}