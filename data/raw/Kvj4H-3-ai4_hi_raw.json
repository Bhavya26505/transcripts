    {
      "subtitle_id": 6,
      "start": 10.88,
      "end": 15.599,
      "text": "इतनी बड़ी गिरावट के पीछे कारण क्या है?"
    },
    {
      "subtitle_id": 7,
      "start": 12.8,
      "end": 17.44,
      "text": "और उस कारण को समझने के लिए आपको एक कहानी"
