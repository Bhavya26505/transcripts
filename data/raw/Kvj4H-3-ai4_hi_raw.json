      "start": 211.599,
      "end": 216.48,
      "text": "रीच आउट करें और उन्हें रिक्वेस्ट करें कि"
    },
    {
      "subtitle_id": 95,
      "start": 213.519,
      "end": 218.117,
      "text": "आप हमसे ज्यादा कॉस्ट में पावर खरीदें तो"
    },
    {
      "subtitle_id": 96,
      "start": 216.48,
      "end": 219.84,
      "text": "हमें काफी ज्यादा फायदा मिल सकता है।"
    },
    {
      "subtitle_id": 97,
      "start": 218.117,
      "end": 221.76,
      "text": "[संगीत] लेकिन सवाल ये आता है कि स्टेट की"
    },
    {
      "subtitle_id": 98,
      "start": 219.84,
      "end": 224.159,
      "text": "जो डिस्कॉम कंपनीज़ हैं वो ज्यादा रेट में"
    },
    {
      "subtitle_id": 99,
      "start": 221.76,
      "end": 226.56,
      "text": "आपसे पावर लेगी क्यों? तो फिर सिलसिला"
    },
    {
      "subtitle_id": 100,
      "start": 224.159,
      "end": 228.64,
      "text": "शुरू हो जाता है घुस देने का कि घुस देंगे"
    },
    {
      "subtitle_id": 101,
      "start": 226.56,
      "end": 230.72,
      "text": "मान जाएंगे। वीडियो में आगे बढ़ने से पहले"
    },
    {
      "subtitle_id": 102,
      "start": 228.64,
      "end": 232.08,
      "text": "आपको बता दूं कि अगर आप कंपनी का किसी भी"
    },
    {
      "subtitle_id": 103,
      "start": 230.72,
      "end": 233.84,
      "text": "स्टॉक का वैल्यू्यूएशन निकालने में"
    },
    {
      "subtitle_id": 104,
      "start": 232.08,
      "end": 235.04,
      "text": "स्ट्रगल कर रहे हैं। जैसे कि आप यह पता"
    },
    {
      "subtitle_id": 105,
      "start": 233.84,
      "end": 237.04,
      "text": "नहीं कर पा रहे कि कौन सा स्टॉक"
    },
    {
      "subtitle_id": 106,
      "start": 235.04,
      "end": 238.879,
      "text": "अंडरवैल्यूड है, सस्ते में मिल रहा है।"
    },
    {
      "subtitle_id": 107,
      "start": 237.04,
      "end": 241.28,
      "text": "कौन सा ओवरवैल्यूड है जिसे आपको अवॉइड"
    },
    {
      "subtitle_id": 108,
      "start": 238.879,
      "end": 242.879,
      "text": "करना चाहिए। तो फिनोवेशंस का वीआईसी यानी"
    },
    {
      "subtitle_id": 109,
      "start": 241.28,
      "end": 244.799,
      "text": "वैल्यू इन्वेस्टिंग कोहट प्रोग्राम जो कि"
    },
    {
      "subtitle_id": 110,
      "start": 242.879,
      "end": 245.76,
      "text": "3 मंथ्स का वीकेंड प्रोग्राम है वो आपके"
    },
    {
      "subtitle_id": 111,
      "start": 244.799,
      "end": 247.519,
      "text": "लिए है। क्योंकि यहां पर वैल्यू"
    },
    {
      "subtitle_id": 112,
      "start": 245.76,
      "end": 249.84,
      "text": "इन्वेस्टिंग की सातों की सातों स्ट्रेटजीस"
    },
    {
      "subtitle_id": 113,
      "start": 247.519,
      "end": 251.92,
      "text": "आपको इतनी आसान भाषा में समझाई जाती है कि"
    },
    {
      "subtitle_id": 114,
      "start": 249.84,
      "end": 253.599,
      "text": "कोई भी व्यक्ति बड़े आसानी से उसे डिटेल"
    },
    {
      "subtitle_id": 115,
      "start": 251.92,
      "end": 255.76,
      "text": "में समझ सकती है और वैल्यू इन्वेस्टिंग"
    },
    {
      "subtitle_id": 116,
      "start": 253.599,
      "end": 258.0,
      "text": "मेंस्ट हासिल कर सकती है। इस रिपब्लिक डे"
    },
    {
      "subtitle_id": 117,
      "start": 255.76,
      "end": 259.84,
      "text": "इस वैल्यू इन्वेस्टिंग कोहट पर फ्लैट 52%"
    },
    {
      "subtitle_id": 118,
      "start": 258.0,
      "end": 261.04,
      "text": "का डिस्काउंट चल रहा है। जिसका आप जरूर"
    },
    {
      "subtitle_id": 119,
      "start": 259.84,
      "end": 263.04,
      "text": "फायदा लीजिए और साथ ही इस वैल्यू"
    },
    {
      "subtitle_id": 120,
      "start": 261.04,
      "end": 264.88,
      "text": "इन्वेस्टिंग कोहट का 40 मिनट का फ्री सेशन"
    },
    {
      "subtitle_id": 121,
      "start": 263.04,
      "end": 266.4,
      "text": "आपके लिए रखा गया है। जिसमें आप यहां"
    },
    {
      "subtitle_id": 122,
      "start": 264.88,
      "end": 268.32,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में दी गई"
    },
    {
      "subtitle_id": 123,
      "start": 266.4,
      "end": 270.24,
      "text": "लिंक पर क्लिक करके एनरोल कर सकते हो। तो"
    },
    {
      "subtitle_id": 124,
      "start": 268.32,
      "end": 271.919,
      "text": "सी यू देयर। अभी मार्केट ऑलरेडी काफी गिरा"
    },
    {
      "subtitle_id": 125,
      "start": 270.24,
      "end": 274.56,
      "text": "हुआ है। तो यह एक बहुत अच्छा टाइम है"
    },
    {
      "subtitle_id": 126,
      "start": 271.919,
      "end": 276.639,
      "text": "वैल्यू लिस्टिंग को बेसिक से सीखने का। तो"
    },
    {
      "subtitle_id": 127,
      "start": 274.56,
      "end": 278.32,
      "text": "सी यू देयर और बढ़ते हैं वीडियो की तरफ।"
    },
    {
      "subtitle_id": 128,
      "start": 276.639,
      "end": 280.56,
      "text": "अभी ऐसे में यूएस एजेंसी के पास कुछ"
    },
    {
      "subtitle_id": 129,
      "start": 278.32,
      "end": 282.479,
      "text": "इंफॉर्मेशन तो आ गई थी लेकिन अभी भी काफी"
    },
    {
      "subtitle_id": 130,
      "start": 280.56,
      "end": 285.04,
      "text": "कुछ इंफॉर्मेशन आना बाकी थी। तो ऐसे में"
    },
    {
      "subtitle_id": 131,
      "start": 282.479,
      "end": 286.639,
      "text": "यूएस एजेंसी ने aur पावर की तरफ अपना रुख"
    },
    {
      "subtitle_id": 132,
      "start": 285.04,
      "end": 288.56,
      "text": "मोड़ लिया। उन्होंने वहां के जो सीनियर"
    },
    {
      "subtitle_id": 133,
      "start": 286.639,
      "end": 290.56,
      "text": "एग्जीक्यूटिव्स हैं aur पावर के उनसे"
    },
    {
      "subtitle_id": 134,
      "start": 288.56,
      "end": 293.04,
      "text": "इंक्वायरी शुरू की। कुछ लोग जो अज्यूर"
    },
    {
      "subtitle_id": 135,
      "start": 290.56,
      "end": 294.96,
      "text": "पावर छोड़ के गए थे उनसे भी डाटा कलेक्ट"
    },
    {
      "subtitle_id": 136,
      "start": 293.04,
      "end": 296.88,
      "text": "करना शुरू किया। तो इसी बीच उन्हें रूपेश"
    },
    {
      "subtitle_id": 137,
      "start": 294.96,
      "end": 299.68,
      "text": "अग्रवाल जो कि एग्जीक्यूटिव थे अजीर पावर"
    },
    {
      "subtitle_id": 138,
      "start": 296.88,
      "end": 301.759,
      "text": "से उन्होंने बनाई हुई पीपीटी और एक एक्सेल"
    },
    {
      "subtitle_id": 139,
      "start": 299.68,
      "end": 303.44,
      "text": "शीट मिल गई। उस पीपीटी में क्या था कि उस"
    },
    {
      "subtitle_id": 140,
      "start": 301.759,
      "end": 305.04,
      "text": "पीपीटी में सारी चीजें लिखी गई थी कि ये"
    },
    {
      "subtitle_id": 141,
      "start": 303.44,
      "end": 307.12,
      "text": "ब्राइव्स जो हम दे रहे हैं इसका फ्लो कैसा"
    },
    {
      "subtitle_id": 142,
      "start": 305.04,
      "end": 309.759,
      "text": "होगा। अब देखिए यार अगर कोई कंपनी ब्राइव"
    },
    {
      "subtitle_id": 143,
      "start": 307.12,
      "end": 311.6,
      "text": "दे रही है तो कुछ ट्रांजैक्शंस होंगे। तो"
    },
    {
      "subtitle_id": 144,
      "start": 309.759,
      "end": 312.96,
      "text": "अकाउंटिंग में भी कुछ करना पड़ेगा, कुछ"
    },
    {
      "subtitle_id": 145,
      "start": 311.6,
      "end": 314.8,
      "text": "दिखाना पड़ेगा। तो कुछ-कुछ जगह पर"
    },
    {
      "subtitle_id": 146,
      "start": 312.96,
      "end": 317.44,
      "text": "इन्होंने डेवलपमेंट फी के नाम पर कुछ"
    },
    {
      "subtitle_id": 147,
      "start": 314.8,
      "end": 320.08,
      "text": "चीजें चिपका दी। ऐसा यूएस का दावा है।"
    },
    {
      "subtitle_id": 148,
      "start": 317.44,
      "end": 321.919,
      "text": "अलग-अलग चीजों पर इन्होंने अलग-अलग यू नो"
    },
    {
      "subtitle_id": 149,
      "start": 320.08,
      "end": 324.32,
      "text": "डिटेल्स उस प्रेजेंटेशन में कि किस तरह से"
    },
    {
      "subtitle_id": 150,
      "start": 321.919,
      "end": 327.52,
      "text": "यह फ्लो रहेगा। किसको कितना देना है, कैसे"
    },
    {
      "subtitle_id": 151,
      "start": 324.32,
      "end": 330.32,
      "text": "देना है। यू नो यूएस का तो यह तक दावा है"
    },
    {
      "subtitle_id": 152,
      "start": 327.52,
      "end": 332.639,
      "text": "कि गौतम अडानी भी यहां पर कुछ लोगों से"
    },
    {
      "subtitle_id": 153,
      "start": 330.32,
      "end": 334.479,
      "text": "मिले थे इस पूरे सिलसिले में। तो यहां पर"
    },
    {
      "subtitle_id": 154,
      "start": 332.639,
      "end": 336.639,
      "text": "जो पब्लिकली अवेलेबल डॉक्यूमेंट इस केस से"
    },
    {
      "subtitle_id": 155,
      "start": 334.479,
      "end": 338.479,
      "text": "जुड़े जो हमने पढ़े तो उसके बाद पता चला"
    },
    {
      "subtitle_id": 156,
      "start": 336.639,
      "end": 341.039,
      "text": "कि ब्राइप किस-किस को दी गई? तो उड़ीसा"
    },
    {
      "subtitle_id": 157,
      "start": 338.479,
      "end": 344.16,
      "text": "स्टेट के काफी सारे ऑफिशियल्स को दी गई और"
    },
    {
      "subtitle_id": 158,
      "start": 341.039,
      "end": 346.0,
      "text": "इसके बदले में उड़ीसा ने 500 मेगावाट पावर"
    },
    {
      "subtitle_id": 159,
      "start": 344.16,
      "end": 347.6,
      "text": "एग्रीमेंट इनके साथ कर लिया। सबसे बड़ी"
    },
    {
      "subtitle_id": 160,
      "start": 346.0,
      "end": 349.44,
      "text": "घुस अगर किसी स्टेट को दी गई है इस"
    },
    {
      "subtitle_id": 161,
      "start": 347.6,
      "end": 351.039,
      "text": "रिपोर्ट के अनुसार तो वह दी गई है आंध्र"
    },
    {
      "subtitle_id": 162,
      "start": 349.44,
      "end": 354.0,
      "text": "प्रदेश को। तो वहां के मिनिस्टर्स और"
    },
    {
      "subtitle_id": 163,
      "start": 351.039,
      "end": 356.0,
      "text": "ऑफिशियल्स को इन्होंने 1600 करोड़ की घुस"
    },
    {
      "subtitle_id": 164,
      "start": 354.0,
      "end": 359.12,
      "text": "दी। जिसके बदले में एक एग्रीमेंट हुआ।"
    },
    {
      "subtitle_id": 165,
      "start": 356.0,
      "end": 361.28,
      "text": "एग्रीमेंट था 7000 मेगावाट पावर का। और यह"
    },
    {
      "subtitle_id": 166,
      "start": 359.12,
      "end": 362.72,
      "text": "आप देखेंगे तो दिसंबर 202 में ये"
    },
    {
      "subtitle_id": 167,
      "start": 361.28,
      "end": 363.919,
      "text": "एग्रीमेंट साइन भी हुआ। अब ये जो"
    },
    {
      "subtitle_id": 168,
      "start": 362.72,
      "end": 365.52,
      "text": "एग्रीमेंट थे ये सारे वहां के"
    },
    {
      "subtitle_id": 169,
      "start": 363.919,
      "end": 367.36,
      "text": "इलेक्ट्रिसिटी डिस्ट्रीब्यूशन कंपनीज़ के"
    },
    {
      "subtitle_id": 170,
      "start": 365.52,
      "end": 369.84,
      "text": "साथ थे। जैसे आंध्र प्रदेश के लिए इट वाज़"
    },
    {
      "subtitle_id": 171,
      "start": 367.36,
      "end": 372.08,
      "text": "एपी, सीपी, डीसीएल वगैरह के साथ थे। अब"
    },
    {
      "subtitle_id": 172,
      "start": 369.84,
      "end": 374.319,
      "text": "इसी बीच रिसर्च के बीच हमने यह भी देखा कि"
    },
    {
      "subtitle_id": 173,
      "start": 372.08,
      "end": 376.319,
      "text": "यह जो कम डिस्ट्रीब्यूशन कंपनीज़ के साथ यह"
    },
    {
      "subtitle_id": 174,
      "start": 374.319,
      "end": 379.12,
      "text": "डील हुई है, यह डिस्ट्रीब्यूशन कंपनीज़"
    },
    {
      "subtitle_id": 175,
      "start": 376.319,
      "end": 381.12,
      "text": "ऑलरेडी बड़े-बड़े लॉसेस में है। जैसे अगर"
    },
    {
      "subtitle_id": 176,
      "start": 379.12,
      "end": 384.08,
      "text": "मैं बात करूं आंध्र प्रदेश के डिस्ककोम"
    },
    {
      "subtitle_id": 177,
      "start": 381.12,
      "end": 386.479,
      "text": "कंपनी की, सो इट इज़ इन द लॉस ऑफ़ 1.29 लाख"
    },
    {
      "subtitle_id": 178,
      "start": 384.08,
      "end": 388.4,
      "text": "करोड़। यह पैसा किसका है यह बताने की मुझे"
    },
    {
      "subtitle_id": 179,
      "start": 386.479,
      "end": 390.319,
      "text": "नहीं लगता मुझे जरूरत है। इस रिपोर्ट में"
    },
    {
      "subtitle_id": 180,
      "start": 388.4,
      "end": 392.4,
      "text": "रिपीटेडली यह तक कहा गया कि ये जो"
    },
    {
      "subtitle_id": 181,
      "start": 390.319,
      "end": 394.479,
      "text": "ब्राइव्स है यह न्यूमरस इंडियन स्टेट्स को"
    },
    {
      "subtitle_id": 182,
      "start": 392.4,
      "end": 396.16,
      "text": "यानी कई सारी इंडियन स्टेट्स को दी गई। अब"
    },
    {
      "subtitle_id": 183,
      "start": 394.479,
      "end": 397.759,
      "text": "हालांकि जो डिस्ट्रीब्यूशन कंपनीज़ हैं"
    },
    {
      "subtitle_id": 184,
      "start": 396.16,
      "end": 399.36,
      "text": "उनके किसी ऑफिशियल का इन्होंने नाम नहीं"
    },
    {
      "subtitle_id": 185,
      "start": 397.759,
      "end": 400.88,
      "text": "लिया लेकिन इन्होंने इस रिपोर्ट में कहा"
    },
    {
      "subtitle_id": 186,
      "start": 399.36,
      "end": 403.039,
      "text": "कि कुछ स्टेट के सीएम से इन्होंने"
    },
    {
      "subtitle_id": 187,
      "start": 400.88,
      "end": 405.44,
      "text": "डायरेक्टली बात की adानी ग्रुप ने और अजीर"
    },
    {
      "subtitle_id": 188,
      "start": 403.039,
      "end": 406.96,
      "text": "ने। अब जब यह सारे प्रूफ यूएस के पास आ गए"
    },
    {
      "subtitle_id": 189,
      "start": 405.44,
      "end": 409.12,
      "text": "तो उन्होंने न्यूयॉर्क के डिस्ट्रिक्ट केस"
    },
    {
      "subtitle_id": 190,
      "start": 406.96,
      "end": 413.199,
      "text": "में इस पर मुकदमा चलाया। मुकदमा चलने के"
    },
    {
      "subtitle_id": 191,
      "start": 409.12,
      "end": 415.84,
      "text": "बाद फिर नवंबर 2024 को इसका रिजल्ट आया और"
    },
    {
      "subtitle_id": 192,
      "start": 413.199,
      "end": 418.72,
      "text": "निकल के आया सीधा अरेस्ट वारंट ऑफ मिस्टर"
    },
    {
      "subtitle_id": 193,
      "start": 415.84,
      "end": 420.8,
      "text": "गौतम अडानी, सागर अडानी और कई सारे लोग।"
    },
    {
      "subtitle_id": 194,
      "start": 418.72,
      "end": 423.44,
      "text": "सागर अडानी आपकी जानकारी के लिए भतीजे हैं"
    },
    {
      "subtitle_id": 195,
      "start": 420.8,
      "end": 425.28,
      "text": "मिस्टर गौतम अडानी के और उसके साथ विनीत"
    },
    {
      "subtitle_id": 196,
      "start": 423.44,
      "end": 427.44,
      "text": "जैन करके भी एक व्यक्ति हैं जिनके खिलाफ"
    },
    {
      "subtitle_id": 197,
      "start": 425.28,
      "end": 429.68,
      "text": "भी ये वारंट निकला। अब विनीत जैन भी भतीजे"
    },
    {
      "subtitle_id": 198,
      "start": 427.44,
      "end": 432.0,
      "text": "हैं मिस्टर गौतम अडानी के। विनीत जैन पहले"
    },
    {
      "subtitle_id": 199,
      "start": 429.68,
      "end": 433.84,
      "text": "एमडी थे अडानी ग्रीन के। तो यूएस कोर्ट का"
    },
    {
      "subtitle_id": 200,
      "start": 432.0,
      "end": 435.599,
      "text": "जब जजमेंट आया था लास्ट ईयर तब भी शेयर"
    },
    {
      "subtitle_id": 201,
      "start": 433.84,
      "end": 437.599,
      "text": "प्राइस काफी ज्यादा गिरी थी। लेकिन मामला"
    },
    {
      "subtitle_id": 202,
      "start": 435.599,
      "end": 439.199,
      "text": "बाद में शांत हुआ। मामला इसलिए शांत हुआ"
    },
    {
      "subtitle_id": 203,
      "start": 437.599,
      "end": 440.88,
      "text": "क्योंकि जो लोग हैं जिसमें जिनके खिलाफ ये"
    },
    {
      "subtitle_id": 204,
      "start": 439.199,
      "end": 442.72,
      "text": "अरेस्ट वारंट निकला है वो तो इंडिया में"
    },
    {
      "subtitle_id": 205,
      "start": 440.88,
      "end": 444.72,
      "text": "है। वो यूएस में है नहीं। तो यूएस उन पर"
    },
    {
      "subtitle_id": 206,
      "start": 442.72,
      "end": 446.8,
      "text": "डायरेक्टली एक्शन नहीं ले सकती। और नंबर"
    },
    {
      "subtitle_id": 207,
      "start": 444.72,
      "end": 449.599,
      "text": "टू कि यह मामला तब इतना बड़ा क्यों नहीं"
    },
    {
      "subtitle_id": 208,
      "start": 446.8,
      "end": 452.16,
      "text": "बना? क्योंकि डॉनल्ड ट्रंप ने यह जो एक्ट"
    },
    {
      "subtitle_id": 209,
      "start": 449.599,
      "end": 454.96,
      "text": "था ब्राइबरी वाला उसे ही हटाने की बात"
    },
    {
      "subtitle_id": 210,
      "start": 452.16,
      "end": 457.28,
      "text": "अपने इलेक्शन प्रॉमिस में की थी कि ये"
    },
    {
      "subtitle_id": 211,
      "start": 454.96,
      "end": 459.68,
      "text": "बिनेसेस को काफी तकलीफ जाती है इससे। हम"
    },
    {
      "subtitle_id": 212,
      "start": 457.28,
      "end": 461.28,
      "text": "यह एक्ट ही हटा देंगे। तो इससे कहीं ना"
    },
    {
      "subtitle_id": 213,
      "start": 459.68,
      "end": 463.759,
      "text": "कहीं adानी ग्रुप को और इन्वेस्टर्स को भी"
    },
    {
      "subtitle_id": 214,
      "start": 461.28,
      "end": 465.52,
      "text": "एक राहत थी कि ठीक है डॉन्ड ट्रंप जीत गए"
    },
    {
      "subtitle_id": 215,
      "start": 463.759,
      "end": 467.599,
      "text": "हैं तो आने वाले टाइम में हटा देंगे।"
    },
    {
      "subtitle_id": 216,
      "start": 465.52,
      "end": 469.68,
      "text": "लेकिन उन्होंने ये एक्ट हटाया नहीं। जिससे"
    },
    {
      "subtitle_id": 217,
      "start": 467.599,
      "end": 471.68,
      "text": "प्रॉब्लम अभी वही की वही है। अब हटाया"
    },
    {
      "subtitle_id": 218,
      "start": 469.68,
      "end": 473.84,
      "text": "नहीं। यह तो अलग चीज है। अब यूएस के जो"
    },
    {
      "subtitle_id": 219,
      "start": 471.68,
      "end": 476.08,
      "text": "कैपिटल मार्केट रेगुलेटर हैं एससीसी मतलब"
    },
    {
      "subtitle_id": 220,
      "start": 473.84,
      "end": 478.639,
      "text": "इंडिया में जैसे सेबी है वैसे वहां पर"
    },
    {
      "subtitle_id": 221,
      "start": 476.08,
      "end": 480.879,
      "text": "एससीसी है सिक्योरिटीज एंड एक्सचेंज कमीशन"
    },
    {
      "subtitle_id": 222,
      "start": 478.639,
      "end": 483.44,
      "text": "उन्होंने अब यह कहा है कि हम ईमेल करके"
    },
    {
      "subtitle_id": 223,
      "start": 480.879,
      "end": 485.36,
      "text": "समन करना चाहते हैं मिस्टर गौतम अडानी को"
    },
    {
      "subtitle_id": 224,
      "start": 483.44,
      "end": 487.28,
      "text": "सागर अडानी को और बाकी लोगों को और यह भी"
    },
    {
      "subtitle_id": 225,
      "start": 485.36,
      "end": 490.16,
      "text": "हम समन करना चाहते हैं इंडियन गवर्नमेंट"
    },
    {
      "subtitle_id": 226,
      "start": 487.28,
      "end": 492.16,
      "text": "को बाईपास करके सीधा हम उनको ईमेल करेंगे"
    },
    {
      "subtitle_id": 227,
      "start": 490.16,
      "end": 494.72,
      "text": "ताकि हम आगे की इन्वेस्टिगेशन जारी रखें"
    },
    {
      "subtitle_id": 228,
      "start": 492.16,
      "end": 496.4,
      "text": "और उसमें अगर वह पकड़े गए तो फिर उन पर"
    },
    {
      "subtitle_id": 229,
      "start": 494.72,
      "end": 498.4,
      "text": "क्रिमिनल चार्जेस और जो भी चार्जेस है"
    },
    {
      "subtitle_id": 230,
      "start": 496.4,
      "end": 500.479,
      "text": "अलग-अलग जैसे मैं अगर बता दूं कि इस केस"
    },
    {
      "subtitle_id": 231,
      "start": 498.4,
      "end": 502.319,
      "text": "में अगर वह गिल्टी पाते हैं तो डिपार्ट"
    },
    {
      "subtitle_id": 232,
      "start": 500.479,
      "end": 504.319,
      "text": "डिपार्टमेंट ऑफ जस्टिस का क्रिमिनल केस उन"
    },
    {
      "subtitle_id": 233,
      "start": 502.319,
      "end": 506.479,
      "text": "पर लग सकता है। चार्जेस उन पर लग सकते"
    },
    {
      "subtitle_id": 234,
      "start": 504.319,
      "end": 509.12,
      "text": "हैं। सिक्योरिटीज फ्रॉड, वायर फ्रॉड और भी"
    },
    {
      "subtitle_id": 235,
      "start": 506.479,
      "end": 512.08,
      "text": "कई सारे। पॉसिबल पनिशमेंट क्या होगी? तो"
    },
    {
      "subtitle_id": 236,
      "start": 509.12,
      "end": 514.399,
      "text": "अप टू 20 टू 25 इयर्स पर काउंट उन पर"
    },
    {
      "subtitle_id": 237,
      "start": 512.08,
      "end": 516.24,
      "text": "एक्शन हो सकती है। ब्राइबरी कास्परेंसी"
    },
    {
      "subtitle_id": 238,
      "start": 514.399,
      "end": 518.32,
      "text": "में फाइव इयर्स तक की सजा हो सकती है।"
    },
    {
      "subtitle_id": 239,
      "start": 516.24,
      "end": 520.24,
      "text": "ऑब्स्ट्रक्शन ऑफ जस्टिस के तहत अप टू 20"
    },
    {
      "subtitle_id": 240,
      "start": 518.32,
      "end": 522.8,
      "text": "इयर्स। उसके साथ ही क्रिमिनल फाइंस इन पर"
    },
    {
      "subtitle_id": 241,
      "start": 520.24,
      "end": 525.12,
      "text": "अप टू $50,000 के इन पर लग सकते हैं पर"
    },
    {
      "subtitle_id": 242,
      "start": 522.8,
      "end": 526.88,
      "text": "काउंट के। और कंपनीज़ के खिलाफ अगर यह"
    },
    {
      "subtitle_id": 243,
      "start": 525.12,
      "end": 528.48,
      "text": "प्रूव हो जाता है तो मिलियंस एंड बिलियंस"
    },
    {
      "subtitle_id": 244,
      "start": 526.88,
      "end": 530.399,
      "text": "ऑफ डॉलर्स में यहां पर इन्हें क्रिमिनल"
    },
    {
      "subtitle_id": 245,
      "start": 528.48,
      "end": 532.48,
      "text": "फाइन पे करना पड़ सकता है। साथ ही कंपनी"
    },
    {
      "subtitle_id": 246,
      "start": 530.399,
      "end": 534.48,
      "text": "के सीईओ एमडी चेयरमैन इनकी यूएस में जो"
    },
    {
      "subtitle_id": 247,
      "start": 532.48,
      "end": 537.279,
      "text": "एंट्री है वो परमानेंटली बार की जा सकती"
    },
    {
      "subtitle_id": 248,
      "start": 534.48,
      "end": 539.36,
      "text": "है। अब हुआ क्या था कि नवंबर 2024 में"
    },
    {
      "subtitle_id": 249,
      "start": 537.279,
      "end": 541.12,
      "text": "मतलब डॉन्ड ट्रंप का जो अब रूप है वो नहीं"
    },
    {
      "subtitle_id": 250,
      "start": 539.36,
      "end": 544.32,
      "text": "पता था किसी को। उनको लगा कि ठीक है डॉन्ड"
    },
    {
      "subtitle_id": 251,
      "start": 541.12,
      "end": 546.0,
      "text": "ट्रंप वो एक्ट को हटा देंगे या फिर यूएस"
    },
    {
      "subtitle_id": 252,
      "start": 544.32,
      "end": 548.32,
      "text": "के इंडिया के साथ एक अच्छे रिलेशन है"
    },
    {
      "subtitle_id": 253,
      "start": 546.0,
      "end": 549.839,
      "text": "जिसके चलते शायद वो कुछ कदम ना उठाए।"
    },
    {
      "subtitle_id": 254,
      "start": 548.32,
      "end": 551.76,
      "text": "लेकिन फिर यूएस ने अभी क्लियरली एक"
    },
    {
      "subtitle_id": 255,
      "start": 549.839,
      "end": 553.76,
      "text": "इंडिकेशन दे दिया है कि वी आर प्रोसीडिंग"
    },
    {
      "subtitle_id": 256,
      "start": 551.76,
      "end": 555.839,
      "text": "अहेड। हम एक्शन लेने के लिए आगे जा रहे"
    },
    {
      "subtitle_id": 257,
      "start": 553.76,
      "end": 557.68,
      "text": "हैं। अब यहां पर यह समन देने की बात"
    },
    {
      "subtitle_id": 258,
      "start": 555.839,
      "end": 560.24,
      "text": "इन्होंने कोर्ट में रखी है। अगर कोर्ट इसे"
    },
    {
      "subtitle_id": 259,
      "start": 557.68,
      "end": 562.24,
      "text": "हां कहता है तो यह समन दे देगा या ईमेल के"
    },
    {
      "subtitle_id": 260,
      "start": 560.24,
      "end": 564.48,
      "text": "जरिए और आगे की इन्वेस्टिगेशन जारी करेगा।"
    },
    {
      "subtitle_id": 261,
      "start": 562.24,
      "end": 566.72,
      "text": "उसके बाद और ज्यादा तकलीफ अडानी ग्रुप को"
    },
    {
      "subtitle_id": 262,
      "start": 564.48,
      "end": 570.16,
      "text": "हो सकती है। अब कई सारे लोग इस पर ऐसा भी"
    },
    {
      "subtitle_id": 263,
      "start": 566.72,
      "end": 571.92,
      "text": "सोच रहे हैं कि डॉनल्ड ट्रंप इस प्रकार"
    },
    {
      "subtitle_id": 264,
      "start": 570.16,
      "end": 574.399,
      "text": "इंडिया पर और ज्यादा प्रेशर बनाना चाहते"
    },
    {
      "subtitle_id": 265,
      "start": 571.92,
      "end": 576.24,
      "text": "हैं ताकि वो टेरिफ अपने फेवर में लाएं।"
    },
    {
      "subtitle_id": 266,
      "start": 574.399,
      "end": 578.16,
      "text": "कुछ लोगों का यह कहना है, कुछ रिपोर्ट्स"
    },
    {
      "subtitle_id": 267,
      "start": 576.24,
      "end": 580.399,
      "text": "का यह कहना है कि सभी को पता है कि adानी"
    },
    {
      "subtitle_id": 268,
      "start": 578.16,
      "end": 582.72,
      "text": "ग्रुप इज क्लोज टू द गवर्नमेंट। तो उन पर"
    },
    {
      "subtitle_id": 269,
      "start": 580.399,
      "end": 586.0,
      "text": "अगर कोई एक्शन होती है यूएस की तरफ से तो"
    },
    {
      "subtitle_id": 270,
      "start": 582.72,
      "end": 587.92,
      "text": "वो एक अलार्मिंग एंगल होगा सभी के लिए और"
    },
    {
      "subtitle_id": 271,
      "start": 586.0,
      "end": 589.6,
      "text": "उसके बाद कुछ टर्म्स पर शायद इंडिया एग्री"
    },
    {
      "subtitle_id": 272,
      "start": 587.92,
      "end": 590.88,
      "text": "करे। ऐसा कुछ लोगों का कहना है। तो ओवरऑल"
    },
    {
      "subtitle_id": 273,
      "start": 589.6,
      "end": 592.959,
      "text": "देखा जाए तो मामला काफी ज्यादा"
    },
    {
      "subtitle_id": 274,
      "start": 590.88,
      "end": 594.64,
      "text": "इंटरेस्टिंग ये बन गया है। इसलिए अगर आप"
    },
    {
      "subtitle_id": 275,
      "start": 592.959,
      "end": 596.64,
      "text": "adानी ग्रुप से रिलेटेड किसी कंपनी में"
    },
    {
      "subtitle_id": 276,
      "start": 594.64,
      "end": 598.24,
      "text": "इन्वेस्टेड हो तो मतलब हमेशा से कुछ ना"
    },
    {
      "subtitle_id": 277,
      "start": 596.64,
      "end": 600.56,
      "text": "कुछ चलता आ रहा है। पहले हिंडनबर्ग था।"
    },
    {
      "subtitle_id": 278,
      "start": 598.24,
      "end": 602.8,
      "text": "देन लास्ट ईयर इस न्यूयॉर्क डिस्ट्रिक्ट"
    },
    {
      "subtitle_id": 279,
      "start": 600.56,
      "end": 605.2,
      "text": "कोर्ट का जजमेंट आया था। अब यह समन का केस"
    },
    {
      "subtitle_id": 280,
      "start": 602.8,
      "end": 606.56,
      "text": "आ गया है। कुछ ना कुछ यहां पर चलता है। तो"
    },
    {
      "subtitle_id": 281,
      "start": 605.2,
      "end": 608.16,
      "text": "वही है कि एज एन इन्वेस्टर आपको"
    },
    {
      "subtitle_id": 282,
      "start": 606.56,
      "end": 610.0,
      "text": "स्टेबिलिटी भी देखनी चाहिए। जहां पर"
    },
    {
      "subtitle_id": 283,
      "start": 608.16,
      "end": 612.0,
      "text": "प्रमोटर स्टेबल है और इन सारी चीजों में"
    },
    {
      "subtitle_id": 284,
      "start": 610.0,
      "end": 613.92,
      "text": "नहीं फंसते हैं। अब यूएस की बात कितनी सच,"
    },
    {
      "subtitle_id": 285,
      "start": 612.0,
      "end": 616.24,
      "text": "कितनी झूठ यह तो टाइम ही बताएगा। लेकिन"
    },
    {
      "subtitle_id": 286,
      "start": 613.92,
      "end": 618.16,
      "text": "फिलहाल एक चीज तो [संगीत] क्लियर है कि"
    },
    {
      "subtitle_id": 287,
      "start": 616.24,
      "end": 620.72,
      "text": "adानी ग्रुप के लिए ट्रबल्स स्टार्ट हो"
    },
    {
      "subtitle_id": 288,
      "start": 618.16,
      "end": 622.88,
      "text": "रही है और यह अगर समन आ जाता है तो उसके"
    },
    {
      "subtitle_id": 289,
      "start": 620.72,
      "end": 624.64,
      "text": "बाद तकलीफें और ज्यादा बढ़ सकती है। तो ये"
    },
    {
      "subtitle_id": 290,
      "start": 622.88,
      "end": 627.519,
      "text": "सारी चीज जो adानी ग्रुप के शेयरहोल्डर्स"
    },
    {
      "subtitle_id": 291,
      "start": 624.64,
      "end": 629.04,
      "text": "हैं उन्हें नोट करनी चाहिए और एज अ"
    },
    {
      "subtitle_id": 292,
      "start": 627.519,
      "end": 630.399,
      "text": "इन्वेस्टर अगर आप मार्केट में नए हो तो"
    },
    {
      "subtitle_id": 293,
      "start": 629.04,
      "end": 632.079,
      "text": "आपको मेक श्योर करना चाहिए कि आपको ऐसी"
    },
    {
      "subtitle_id": 294,
      "start": 630.399,
      "end": 633.76,
      "text": "कंपनीज़ में इन्वेस्ट करना चाहिए जिसमें"
    },
    {
      "subtitle_id": 295,
      "start": 632.079,
      "end": 635.68,
      "text": "मैनेजमेंट स्टेबल हो और जनरली किसी भी"
    },
    {
      "subtitle_id": 296,
      "start": 633.76,
      "end": 637.68,
      "text": "कॉनस्पेरेंसी में किसी भी चीज में"
    },
    {
      "subtitle_id": 297,
      "start": 635.68,
      "end": 639.68,
      "text": "इन्वॉल्व ना हो। उनका टैक रिकॉर्ड क्लीन"
    },
    {
      "subtitle_id": 298,
      "start": 637.68,
      "end": 641.2,
      "text": "हो, क्लियर हो। यह कहानी समझने के बाद अब"
    },
    {
      "subtitle_id": 299,
      "start": 639.68,
      "end": 643.839,
      "text": "आशा करता हूं कि आपको अब समझ में आ गया"
    },
    {
      "subtitle_id": 300,
      "start": 641.2,
      "end": 645.44,
      "text": "होगा कि क्यों adानी ग्रुप के शेयर्स"
    },
    {
      "subtitle_id": 301,
      "start": 643.839,
      "end": 647.12,
      "text": "फ्राइडे को गिर गए। तो मिलते हैं अगले"
    },
    {
      "subtitle_id": 302,
      "start": 645.44,
      "end": 648.64,
      "text": "वीडियो में। कुछ इसी तरह के एक्सप्लेनेशंस"
    },
    {
      "subtitle_id": 303,
      "start": 647.12,
      "end": 650.32,
      "text": "के लिए हमें जरूर फॉलो कीजिए और जाते-जाते"
    },
    {
      "subtitle_id": 304,
      "start": 648.64,
      "end": 652.0,
      "text": "हमारे वैल्यू इन कोहर्ट को भी जरूर चेक"
    },
    {
      "subtitle_id": 305,
      "start": 650.32,
      "end": 654.079,
      "text": "आउट कीजिए। जो 3 मंथ्स का वीकेंड"
    },
    {
      "subtitle_id": 306,
      "start": 652.0,
      "end": 656.88,
      "text": "प्रोग्राम है जिसमें आप एक्सपर्टीज हासिल"
    },
    {
      "subtitle_id": 307,
      "start": 654.079,
      "end": 658.48,
      "text": "करेंगेस्ट हासिल करेंगे वैल्यू्यूएशन में।"
    },
    {
      "subtitle_id": 308,
      "start": 656.88,
      "end": 660.16,
      "text": "जैसे कि अंडरवैल्यूड स्टॉक्स कैसे [संगीत]"
    },
    {
      "subtitle_id": 309,
      "start": 658.48,
      "end": 662.079,
      "text": "ढूंढने हैं और ओवरवैल्यूड स्टॉक्स कैसे"
    },
    {
      "subtitle_id": 310,
      "start": 660.16,
      "end": 663.76,
      "text": "अवॉयड करने हैं। तो उसका 40 मिनट का फ्री"
    },
    {
      "subtitle_id": 311,
      "start": 662.079,
      "end": 664.959,
      "text": "सेशन हमने रखा है जिसे आप नीचे"
    },
    {
      "subtitle_id": 312,
      "start": 663.76,
      "end": 666.64,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में दिए गए"
    },
    {
      "subtitle_id": 313,
      "start": 664.959,
      "end": 668.32,
      "text": "लिंक पर क्लिक करके चेक आउट कर सकते हैं।"
    },
    {
      "subtitle_id": 314,
      "start": 666.64,
      "end": 672.36,
      "text": "तो फिलहाल इतना ही मिलते हैं अगले वीडियो"
    },
    {
      "subtitle_id": 315,
      "start": 668.32,
      "end": 672.36,
      "text": "में। थैंक यू सो मच एंड बाय-ब।"
    }
  ]
}