    {
      "subtitle_id": 31,
      "start": 70.2,
      "end": 73.72,
      "text": "चलिए बढ़ते हैं वीडियो की तरफ तो सबसे"
    },
    {
      "subtitle_id": 32,
      "start": 71.92,
      "end": 75.28,
      "text": "पहले इस इंडस्ट्री का एक ओवरव्यू ले लेते"
    },
    {
      "subtitle_id": 33,
      "start": 73.72,
      "end": 77.36,
      "text": "हैं वैसे तो इस इंडस्ट्री में डिफरेंट"
    },
    {
      "subtitle_id": 34,
      "start": 75.28,
      "end": 79.08,
      "text": "कैटेगरी की कंपनीज काम करती है जैसे कि"
    },
    {
      "subtitle_id": 35,
      "start": 77.36,
      "end": 81.24,
      "text": "बैंक भी हाउसिंग लोन देती है उसके अलावा"
    },
    {
      "subtitle_id": 36,
      "start": 79.08,
      "end": 83.04,
      "text": "एनबीएफसी भी हाउसिंग लोन देती है इसमें भी"
    },
    {
      "subtitle_id": 37,
      "start": 81.24,
      "end": 84.799,
      "text": "दो टाइप्स है एक तो वो एनबीएफसी जो"
    },
    {
      "subtitle_id": 38,
      "start": 83.04,
      "end": 86.759,
      "text": "हाउसिंग लोन के साथ साथ डिपॉजिट भी"
    },
    {
      "subtitle_id": 39,
      "start": 84.799,
      "end": 88.439,
      "text": "एक्सेप्ट करती है और दूसरी वो जो हाउसिंग"
    },
    {
      "subtitle_id": 40,
      "start": 86.759,
      "end": 90.439,
      "text": "लोन देती है लेकिन किसी भी तरह का डिपॉजिट"
    },
    {
      "subtitle_id": 41,
      "start": 88.439,
      "end": 92.119,
      "text": "एक्सेप्ट नहीं करती है और पज हाउसिंग"
    },
    {
      "subtitle_id": 42,
      "start": 90.439,
      "end": 94.2,
      "text": "फाइनेंस नॉन डिपॉजिट टेकिंग हाउसिंग"
    },
    {
      "subtitle_id": 43,
      "start": 92.119,
      "end": 95.479,
      "text": "फाइनेंस कंपनी है अब अगर हाउसिंग फाइनेंस"
    },
    {
      "subtitle_id": 44,
      "start": 94.2,
      "end": 98.439,
      "text": "मार्केट की ग्रोथ की बात करें तो आप"
    },
    {
      "subtitle_id": 45,
      "start": 95.479,
      "end": 101.0,
      "text": "स्क्रीन पर देख सकते हो 2019 से 2024 के"
    },
    {
      "subtitle_id": 46,
      "start": 98.439,
      "end": 103.079,
      "text": "बीच इस इंडस्ट्री की कंपाउंडेड सालाना 13"
    },
    {
      "subtitle_id": 47,
      "start": 101.0,
      "end": 104.84,
      "text": "पर की स्ट्रांग स्टर्डी ग्रोथ रही है इन"
    },
    {
      "subtitle_id": 48,
      "start": 103.079,
      "end": 106.799,
      "text": "सालों में क्या कुछ नहीं हुआ कोविड आया"
    },
    {
      "subtitle_id": 49,
      "start": 104.84,
      "end": 108.719,
      "text": "फिर इंटरेस्ट रेट कम हुए फिर इंटरेस्ट रेट"
    },
    {
      "subtitle_id": 50,
      "start": 106.799,
      "end": 110.719,
      "text": "ज्यादा हुए और भी बहुत कुछ हुआ लेकिन फिर"
    },
    {
      "subtitle_id": 51,
      "start": 108.719,
      "end": 112.84,
      "text": "भी इस इंडस्ट्री की जो ग्रोथ है वो लगातार"
    },
    {
      "subtitle_id": 52,
      "start": 110.719,
      "end": 114.56,
      "text": "बढ़ती चली गई और अगर फ्यूचर प्रोजेक्शन की"
    },
    {
      "subtitle_id": 53,
      "start": 112.84,
      "end": 116.96,
      "text": "भी बात करें तो वो भी इसी तरह बढ़ने का"
    },
    {
      "subtitle_id": 54,
      "start": 114.56,
      "end": 118.719,
      "text": "अनुमान है हां 2008 जैसा हाउसिंग मार्केट"
    },
    {
      "subtitle_id": 55,
      "start": 116.96,
      "end": 120.6,
      "text": "क्रैश अगर होता है तो ऑफकोर्स इंपैक्ट"
    },
    {
      "subtitle_id": 56,
      "start": 118.719,
      "end": 122.159,
      "text": "पड़ेगा लेकिन वैसा होने के चांसेस बहुत कम"
    },
    {
      "subtitle_id": 57,
      "start": 120.6,
      "end": 123.88,
      "text": "है क्योंकि अभी तक ये इंडस्ट्री उतनी भी"
    },
    {
      "subtitle_id": 58,
      "start": 122.159,
      "end": 125.719,
      "text": "ज्यादा ग्रो नहीं हुई है कि वहां पर बबल"
    },
    {
      "subtitle_id": 59,
      "start": 123.88,
      "end": 127.36,
      "text": "क्रिएट होके क्रैश हो तो सिंपल सी बात ये"
    },
    {
      "subtitle_id": 60,
      "start": 125.719,
      "end": 129.08,
      "text": "कि बहुत सारे लोग इंडिया में पुअर से लोअर"
    },
    {
      "subtitle_id": 61,
      "start": 127.36,
      "end": 130.399,
      "text": "मिडिल क्लास में जा रहे हैं और लोअर मिडिल"
    },
    {
      "subtitle_id": 62,
      "start": 129.08,
      "end": 131.8,
      "text": "क्लास से अप्पर मिडिल क्लास में जा रहे"
    },
    {
      "subtitle_id": 63,
      "start": 130.399,
      "end": 133.48,
      "text": "हैं जिसके चलते हरर कोई चाहता है कि मेरा"
    },
    {
      "subtitle_id": 64,
      "start": 131.8,
      "end": 135.239,
      "text": "अपना घर हो जिसके चलते इन लोंस की"
    },
    {
      "subtitle_id": 65,
      "start": 133.48,
      "end": 137.0,
      "text": "डिमांड्स काफी ज्यादा बढ़ रही है अब घर"
    },
