    {
      "subtitle_id": 68,
      "start": 138.84,
      "end": 142.519,
      "text": "कई घर होते हैं जो 50 लाख उससे ज्यादा"
    },
    {
      "subtitle_id": 69,
      "start": 140.44,
      "end": 144.599,
      "text": "अमाउंट लगती है उसमें तो बजज हाउसिंग"
    },
    {
      "subtitle_id": 70,
      "start": 142.519,
      "end": 147.28,
      "text": "फाइनेंस पर्टिकुलर उस कैटेगरी को टैप करती"
    },
    {
      "subtitle_id": 71,
      "start": 144.599,
      "end": 149.92,
      "text": "है जिसे कहते हैं प्राइम हाउसिंग यानी कि"
    },
    {
      "subtitle_id": 72,
      "start": 147.28,
      "end": 151.599,
      "text": "50 लाख या उससे महंगे घर इसी सेगमेंट में"
    },
    {
      "subtitle_id": 73,
      "start": 149.92,
      "end": 153.519,
      "text": "में सबसे ज्यादा ग्रोथ देखने मिल रही है"
    },
    {
      "subtitle_id": 74,
      "start": 151.599,
      "end": 155.12,
      "text": "जैसे कि आप स्क्रीन पर देख सकते हो तीन"
    },
    {
      "subtitle_id": 75,
      "start": 153.519,
      "end": 157.2,
      "text": "कैटेगरी में सबसे ज्यादा ग्रोथ प्राइम"
    },
    {
      "subtitle_id": 76,
      "start": 155.12,
      "end": 159.879,
      "text": "हाउसिंग स्पेस में है जो कि पिछले 5 साल"
    },
    {
      "subtitle_id": 77,
      "start": 157.2,
      "end": 162.159,
      "text": "में कंपाउंडेड सालना 20 पर से भी ज्यादा"
    },
    {
      "subtitle_id": 78,
      "start": 159.879,
      "end": 163.959,
      "text": "है बहुत बड़ा नंबर है ये और इस स्पीड से"
    },
    {
      "subtitle_id": 79,
      "start": 162.159,
      "end": 165.44,
      "text": "हाउसिंग फाइनेंस की एक दो कंपनी नहीं पूरा"
    },
    {
      "subtitle_id": 80,
      "start": 163.959,
      "end": 167.36,
      "text": "सेक्टर बढ़ रहा है तो आप समझ सकते हो कि"
    },
    {
      "subtitle_id": 81,
      "start": 165.44,
      "end": 169.04,
      "text": "सेक्टर का पोटेंशियल कितना है क्योंकि बजज"
    },
    {
      "subtitle_id": 82,
      "start": 167.36,
      "end": 171.08,
      "text": "हाउसिंग इसी सेक्टर में काम करे तो उनके"
    },
    {
      "subtitle_id": 83,
      "start": 169.04,
      "end": 173.12,
      "text": "लिए पहला प्लस पॉइंट हुआ अब सवाल ये आता"
    },
    {
      "subtitle_id": 84,
      "start": 171.08,
      "end": 175.28,
      "text": "है कि क्या कंपनी बढ़ रही है तो इंडस्ट्री"
    },
    {
      "subtitle_id": 85,
      "start": 173.12,
      "end": 177.64,
      "text": "तो 13 14 पर से पूरी बढ़ रही है प्राइम"
    },
    {
      "subtitle_id": 86,
      "start": 175.28,
      "end": 180.04,
      "text": "हाउसिंग 20 पर से बढ़ रही है कंपनी की"
    },
    {
      "subtitle_id": 87,
      "start": 177.64,
      "end": 182.159,
      "text": "ग्रोथ रेट क्या है तो पिछले कुछ साल सालो"
    },
    {
      "subtitle_id": 88,
      "start": 180.04,
      "end": 183.84,
      "text": "का डाटा देखें तो कंपनी का जो एयूएम है"
    },
    {
      "subtitle_id": 89,
      "start": 182.159,
      "end": 186.48,
      "text": "यानी जो लोन कंपनी बांट रही है वो"
    },
    {
      "subtitle_id": 90,
      "start": 183.84,
      "end": 188.36,
      "text": "कंपाउंडेड सालाना 24 पर से बढ़ रहे हैं"
    },
    {
      "subtitle_id": 91,
      "start": 186.48,
      "end": 190.56,
      "text": "व्हिच इज हाईएस्ट अमंग इट्स कंपीटीटर्स"
    },
    {
      "subtitle_id": 92,
      "start": 188.36,
      "end": 192.04,
      "text": "उसके आसपास भी कोई नहीं है अब आपके दिमाग"
    },
    {
      "subtitle_id": 93,
      "start": 190.56,
      "end": 193.44,
      "text": "में एक सवाल आ सकता है कि अगर कंपनी इतनी"
    },
    {
      "subtitle_id": 94,
      "start": 192.04,
      "end": 194.92,
      "text": "तेजी से ग्रो कर रही है तो शायद आने वाले"
    },
    {
      "subtitle_id": 95,
      "start": 193.44,
      "end": 197.0,
      "text": "टाइम में ये एलआईजी हाउसिंग फाइनेंस को"
    },
    {
      "subtitle_id": 96,
      "start": 194.92,
      "end": 199.44,
      "text": "बीट कर सकते हैं इतना जल्दी नहीं होने"
    },
    {
      "subtitle_id": 97,
      "start": 197.0,
      "end": 201.319,
      "text": "वाला क्योंकि एलआईजी हाउसिंग फाइनेंस बजज"
    },
    {
      "subtitle_id": 98,
      "start": 199.44,
      "end": 204.08,
      "text": "हाउसिंग फाइनेंस से पांच गुना ज्यादा बड़ी"
    },
    {
      "subtitle_id": 99,
      "start": 201.319,
      "end": 205.959,
      "text": "है तो आने वाले लंबे टाइम के लिए यह कंपनी"
    },
    {
      "subtitle_id": 100,
      "start": 204.08,
      "end": 207.56,
      "text": "दूसरे नंबर पर ही रहेगी अब यहां से आगे"
    },
    {
      "subtitle_id": 101,
      "start": 205.959,
      "end": 210.08,
      "text": "मैं बजज हाउसिंग फाइनेंस को बीएचएफ"
    },
    {
      "subtitle_id": 102,
      "start": 207.56,
      "end": 211.64,
      "text": "बोलूंगा ताकि मेरे लिए थोड़ा इजी और आपके"
    },
    {
      "subtitle_id": 103,
      "start": 210.08,
      "end": 213.48,
      "text": "लिए भी थोड़ा इजी जाए बार-बार नहीं तो नाम"
    },
    {
      "subtitle_id": 104,
      "start": 211.64,
      "end": 215.799,
      "text": "रिपीट होगा तो बीएचएफ ये चीज जानती है कि"
    },
    {
      "subtitle_id": 105,
      "start": 213.48,
      "end": 218.08,
      "text": "जल्द से जल्द पहले पायदान पर जाना है तो"
    },
    {
      "subtitle_id": 106,
      "start": 215.799,
      "end": 219.68,
      "text": "हमें प्राइम सेगमेंट पर फोकस करना पड़ेगा"
    },
    {
      "subtitle_id": 107,
      "start": 218.08,
      "end": 221.319,
      "text": "जहां से बड़े-बड़े लोन हमारे पास जल्दी"
    },
    {
      "subtitle_id": 108,
      "start": 219.68,
      "end": 223.64,
      "text": "आएंगे और हम जल्दी ग्रो कर पाएंगे अब"
    },
    {
      "subtitle_id": 109,
      "start": 221.319,
      "end": 225.72,
      "text": "इंटरेस्टिंग बीएचएफ यह आईपीओ ऐसे टाइम में"
    },
    {
      "subtitle_id": 110,
      "start": 223.64,
      "end": 227.64,
      "text": "ला रहा है जहां पर इंटरेस्ट ट ऑलरेडी काफी"
    },
    {
      "subtitle_id": 111,
      "start": 225.72,
      "end": 229.08,
      "text": "ज्यादा हाई है और ऐसे अनुमान लगाए जा रहे"
    },
    {
      "subtitle_id": 112,
      "start": 227.64,
      "end": 231.04,
      "text": "हैं कि इंटरेस्ट रेट आने वाले टाइम में कम"
    },
    {
      "subtitle_id": 113,
      "start": 229.08,
      "end": 232.92,
      "text": "हो सकते हैं जिसका फायदा इन्हें जरूर होगा"
    },
    {
      "subtitle_id": 114,
      "start": 231.04,
      "end": 235.079,
      "text": "और वैसे तो ये होम लोन लोन अगेंस्ट"
    },
    {
      "subtitle_id": 115,
      "start": 232.92,
      "end": 237.2,
      "text": "प्रॉपर्टी लीज रेंटल डिस्काउंटिंग डेवलपर"
    },
    {
      "subtitle_id": 116,
      "start": 235.079,
      "end": 239.439,
      "text": "फाइनेंसिंग इन सब सेगमेंट में काम करती है"
    },
    {
      "subtitle_id": 117,
      "start": 237.2,
      "end": 241.519,
      "text": "पर इनका क्लोज टू 80 पर ऑफ द लोन बुक होम"
    },
    {
      "subtitle_id": 118,
      "start": 239.439,
      "end": 243.92,
      "text": "लोन सेगमेंट में ही है व्हिच इज कंसीडर्ड"
    },
    {
      "subtitle_id": 119,
      "start": 241.519,
      "end": 245.92,
      "text": "एज लेस रिस्की अब देखिए लोन देना एक बात"
    },
    {
      "subtitle_id": 120,
      "start": 243.92,
      "end": 247.76,
      "text": "है लेकिन लोन रिकवर करना अलग बात है जो कि"
    },
    {
      "subtitle_id": 121,
      "start": 245.92,
      "end": 250.64,
      "text": "सबसे इंपॉर्टेंट है तो यहां पर अगर हम"
    },
    {
      "subtitle_id": 122,
      "start": 247.76,
      "end": 252.56,
      "text": "ग्रॉस एनपीए देखें तो वो मात्र 0.28 का है"
    },
    {
      "subtitle_id": 123,
      "start": 250.64,
      "end": 254.36,
      "text": "और काफी अच्छा है अब इनका ग्रॉस एनपीए"
    },
    {
      "subtitle_id": 124,
      "start": 252.56,
      "end": 256.919,
      "text": "क्यों कम है उसका कारण भी आपको जानना"
    },
    {
      "subtitle_id": 125,
      "start": 254.36,
      "end": 260.199,
      "text": "पड़ेगा इन्होंने जो भी हाउसिंग लोन दिए"
    },
    {
      "subtitle_id": 126,
      "start": 256.919,
      "end": 261.88,
      "text": "हैं 88 पर उन्हीं को दिए हैं जो सैलरीड है"
    },
    {
      "subtitle_id": 127,
      "start": 260.199,
      "end": 263.44,
      "text": "जिसकी वजह से इनकी रिकवरी अच्छी रही है अब"
    },
    {
      "subtitle_id": 128,
      "start": 261.88,
      "end": 265.6,
      "text": "तक और दूसरी चीज जो इनके बिजनेस के लिए"
    },
    {
      "subtitle_id": 129,
      "start": 263.44,
      "end": 267.28,
      "text": "थोड़ी पॉजिटिव है वो यह है कि इनकी जो"
    },
    {
      "subtitle_id": 130,
      "start": 265.6,
      "end": 268.759,
      "text": "क्रेडिट रेटिंग है शॉर्ट टर्म लोंस की और"
    },
    {
      "subtitle_id": 131,
      "start": 267.28,
      "end": 270.52,
      "text": "लॉन्ग टर्म लोंस की वो इनकी पूरी"
    },
    {
      "subtitle_id": 132,
      "start": 268.759,
      "end": 272.16,
      "text": "इंडस्ट्री में सबसे ज्यादा ज्यादा है"
    },
    {
      "subtitle_id": 133,
      "start": 270.52,
      "end": 274.52,
      "text": "जिसकी वजह से कम इंटरेस्ट में इन्हें पैसा"
    },
    {
      "subtitle_id": 134,
      "start": 272.16,
      "end": 276.56,
      "text": "मिलने में मदद होती है जिसके चलते ज्यादा"
    },
    {
      "subtitle_id": 135,
      "start": 274.52,
      "end": 278.24,
      "text": "मार्जिंस ये लोग अपने पास रख सकते हैं और"
    },
    {
      "subtitle_id": 136,
      "start": 276.56,
      "end": 280.12,
      "text": "उसके बाद फाइनेंशियल नंबर्स भी आप स्क्रीन"
    },
    {
      "subtitle_id": 137,
      "start": 278.24,
      "end": 282.68,
      "text": "पर देख सकते हो रिवेन्यू 4 साल में डबल से"
    },
    {
      "subtitle_id": 138,
      "start": 280.12,
      "end": 285.88,
      "text": "ज्यादा बढ़ा है और 7600 करोड़ तक पहुंच"
    },
    {
      "subtitle_id": 139,
      "start": 282.68,
      "end": 287.479,
      "text": "गया है नेट प्रॉफिट भी 420 करोड़ से 1730"
    },
    {
      "subtitle_id": 140,
      "start": 285.88,
      "end": 289.16,
      "text": "करोड़ तक पहुंच गया है विद इन जस्ट फोर"
    },
    {
      "subtitle_id": 141,
      "start": 287.479,
      "end": 291.68,
      "text": "इयर्स तो रिवेन्यू का कंपाउंडेड सालाना"
    },
    {
      "subtitle_id": 142,
      "start": 289.16,
      "end": 293.28,
      "text": "रिटर्न्स देखें तो क्रेजी नंबर है 30 का"
    },
    {
      "subtitle_id": 143,
      "start": 291.68,
      "end": 295.96,
      "text": "और प्रॉफिट का जो कंपाउंडेड सालाना"
    },
    {
      "subtitle_id": 144,
      "start": 293.28,
      "end": 297.84,
      "text": "रिटर्न्स है पिछले 4 साल के दैट इज 42 पर"
    },
    {
      "subtitle_id": 145,
      "start": 295.96,
      "end": 299.44,
      "text": "तो ओवरऑल सारे फाइनेंशियल नंबर काफी"
    },
    {
      "subtitle_id": 146,
      "start": 297.84,
      "end": 301.4,
      "text": "स्ट्रांग है और जिन आईपीओ का हम रिव्यू"
    },
    {
      "subtitle_id": 147,
      "start": 299.44,
      "end": 303.479,
      "text": "करते उसमें जनरली ऐसा होता नहीं है लगभग"
    },
    {
      "subtitle_id": 148,
      "start": 301.4,
      "end": 305.44,
      "text": "सारी की सारी चीजें पॉजिटिव आई है लेट्स"
    },
    {
      "subtitle_id": 149,
      "start": 303.479,
      "end": 307.479,
      "text": "से कुछ नेगेटिव आता हैगा अब दुनिया का एक"
    },
    {
      "subtitle_id": 150,
      "start": 305.44,
      "end": 309.56,
      "text": "नियम है कि हर एक जो अच्छी चीज है वो"
    },
    {
      "subtitle_id": 151,
      "start": 307.479,
      "end": 311.44,
      "text": "प्रीमियम चार्ज करती है तो यहां पर क्या"
    },
    {
      "subtitle_id": 152,
      "start": 309.56,
      "end": 313.88,
      "text": "बीएचएफ अपनी वैल्यूएशन पर प्रीमियम लगा"
    },
    {
      "subtitle_id": 153,
      "start": 311.44,
      "end": 316.24,
      "text": "रही है बात करते हैं बीएचएफ के प्राइस टू"
    },
    {
      "subtitle_id": 154,
      "start": 313.88,
      "end": 318.88,
      "text": "बुक वैल्यू पर अगर नजर डाले तो वो 3.72 है"
    },
    {
      "subtitle_id": 155,
      "start": 316.24,
      "end": 320.479,
      "text": "जबकि इंडस्ट्री एवरेज 2.86 है तो यहां पर"
    },
    {
      "subtitle_id": 156,
      "start": 318.88,
      "end": 322.36,
      "text": "कंपनी जो है अपना वैल्युएशन थोड़ा ज्यादा"
    },
    {
      "subtitle_id": 157,
      "start": 320.479,
      "end": 324.08,
      "text": "मांग रही है और वहीं पर अगर आप पी रेशो की"
    },
    {
      "subtitle_id": 158,
      "start": 322.36,
      "end": 326.4,
      "text": "बात करें तो बजज हाउसिंग फाइनेंस का जो पी"
    },
    {
      "subtitle_id": 159,
      "start": 324.08,
      "end": 328.0,
      "text": "रेशो है वो 30 के करीब आ रहा है वही एलजी"
    },
    {
      "subtitle_id": 160,
      "start": 326.4,
      "end": 330.6,
      "text": "हाउसिंग फाइनेंस का जो पी रेशो है मात्र"
    },
    {
      "subtitle_id": 161,
      "start": 328.0,
      "end": 332.4,
      "text": "आठ का है पर यहां पर देख वाली बात यह है"
    },
    {
      "subtitle_id": 162,
      "start": 330.6,
      "end": 334.039,
      "text": "कि एलआईसी हाउसिंग फाइनेंस को जो रेवेन्यू"
    },
    {
      "subtitle_id": 163,
      "start": 332.4,
      "end": 337.36,
      "text": "है पिछले 5 साल में मात्र कंपाउंडेड"
    },
    {
      "subtitle_id": 164,
      "start": 334.039,
      "end": 339.479,
      "text": "सालाना 9 पर से और प्रॉफिट 14 पर से बढ़ा"
    },
    {
      "subtitle_id": 165,
      "start": 337.36,
      "end": 341.199,
      "text": "है तो ग्रोथ भी कम है लेकिन अगर हम नई"
    },
    {
      "subtitle_id": 166,
      "start": 339.479,
      "end": 343.199,
      "text": "हाउसिंग फाइनेंस कंपनीज की बात करें तो"
    },
    {
      "subtitle_id": 167,
      "start": 341.199,
      "end": 345.28,
      "text": "उनके पी रेशो 25 तक मिलेंगे तो यहां पर"
    },
    {
      "subtitle_id": 168,
      "start": 343.199,
      "end": 347.08,
      "text": "बीएचएफ उससे भी ज्यादा का वैल्यूएशन मांग"
    },
    {
      "subtitle_id": 169,
      "start": 345.28,
      "end": 349.08,
      "text": "रही है अब देखिए फिलहाल तो कंपनी का"
    },
    {
      "subtitle_id": 170,
      "start": 347.08,
      "end": 351.56,
      "text": "वैल्यूएशन जस्टिफाई कर रहा है लेकिन आने"
    },
    {
      "subtitle_id": 171,
      "start": 349.08,
      "end": 353.84,
      "text": "वाले टाइम में इन केस अगर कंपनी ग्रो नहीं"
    },
    {
      "subtitle_id": 172,
      "start": 351.56,
      "end": 355.88,
      "text": "कर पाती स्पीड से तो आपके लिए वो चीज दो"
    },
    {
      "subtitle_id": 173,
      "start": 353.84,
      "end": 357.759,
      "text": "धारी तलवार साबित हो सकती है अब आते हैं"
    },
    {
      "subtitle_id": 174,
      "start": 355.88,
      "end": 359.72,
      "text": "आप लोगों के सबसे फेवरेट पॉइंट पर"
    },
    {
      "subtitle_id": 175,
      "start": 357.759,
      "end": 361.36,
      "text": "लिस्टिंग गेन के क्या चांसेस हैं अभी अभी"
    },
    {
      "subtitle_id": 176,
      "start": 359.72,
      "end": 365.319,
      "text": "फिलहाल इस आईपीओ का ग्रे मार्केट प्रीमियम"
    },
    {
      "subtitle_id": 177,
      "start": 361.36,
      "end": 367.4,
      "text": "चल रहा है 52 टू 555 यानी 75 यानी कि ग्रे"
    },
    {
      "subtitle_id": 178,
      "start": 365.319,
      "end": 369.319,
      "text": "मार्केट प्रीमियम के अनुसार अराउंड 50 पर"
    },
    {
      "subtitle_id": 179,
      "start": 367.4,
      "end": 371.0,
      "text": "के लिस्टिंग गेन के चांसेस है अब देखिए"
    },
    {
      "subtitle_id": 180,
      "start": 369.319,
      "end": 372.88,
      "text": "लिस्टिंग गेन में एक चीज बहुत इंपॉर्टेंट"
    },
    {
      "subtitle_id": 181,
      "start": 371.0,
      "end": 374.44,
      "text": "है लास्ट टाम हमने एक डटा निकाला था पूरा"
    },
    {
      "subtitle_id": 182,
      "start": 372.88,
      "end": 375.96,
      "text": "मतलब जितने भी आईपीओ है उनका डेटा और"
    },
    {
      "subtitle_id": 183,
      "start": 374.44,
      "end": 377.84,
      "text": "लिस्टिंग गेन का डटा निकाला था उसमें एक"
    },
    {
      "subtitle_id": 184,
      "start": 375.96,
      "end": 379.759,
      "text": "चीज हमें नजर आई थी बड़ी इंटरेस्टिंग चीज"
    },
    {
      "subtitle_id": 185,
      "start": 377.84,
      "end": 381.84,
      "text": "है कि अगर कोई भी आईपीओ जो पहले दो दिन"
    },
    {
      "subtitle_id": 186,
      "start": 379.759,
      "end": 384.199,
      "text": "में 10 गुना सब्सक्राइब होता है तो उसमें"
    },
    {
      "subtitle_id": 187,
      "start": 381.84,
      "end": 386.72,
      "text": "लिस्टिंग गेन के चांसेस आपके 95 पर से"
    },
    {
      "subtitle_id": 188,
      "start": 384.199,
      "end": 389.28,
      "text": "ज्यादा बढ़ जाते हैं मतलब 99 पर ही पकड़"
    },
    {
      "subtitle_id": 189,
      "start": 386.72,
      "end": 390.72,
      "text": "लो तो इस तरह का अब तक का डाटा है तो आप"
    },
    {
      "subtitle_id": 190,
      "start": 389.28,
      "end": 392.8,
      "text": "पह ले दो दिन में आईपीओ किस तरह से"
    },
    {
      "subtitle_id": 191,
      "start": 390.72,
      "end": 395.759,
      "text": "सब्सक्राइब होता है इस चीज को जरूर ध्यान"
    },
    {
      "subtitle_id": 192,
      "start": 392.8,
      "end": 397.319,
      "text": "में रखें बिफोर अप्लाइड एनी सिंगल आईपीओ"
    },
    {
      "subtitle_id": 193,
      "start": 395.759,
      "end": 398.96,
      "text": "क्योंकि यहां पर पहले दिन अप्लाई करके ऐसा"
    },
    {
      "subtitle_id": 194,
      "start": 397.319,
      "end": 401.0,
      "text": "नहीं कि आपको जल्दी आईपीओ मिल जाएगा ये"
    },
    {
      "subtitle_id": 195,
      "start": 398.96,
      "end": 403.84,
      "text": "अल्टीमेटली लॉटरी बेसिस से ही मिलता है तो"
    },
    {
      "subtitle_id": 196,
      "start": 401.0,
      "end": 406.88,
      "text": "यहां पर इशू साइज इस आईपीओ के 6560 करोड़"
    },
    {
      "subtitle_id": 197,
      "start": 403.84,
      "end": 408.68,
      "text": "की जिसमें फ्रेश इशू है 3560 करोड़ का और"
    },
    {
      "subtitle_id": 198,
      "start": 406.88,
      "end": 410.479,
      "text": "ऑफर फॉर सेल है 3000 करोड़ का जहां पर"
    },
    {
      "subtitle_id": 199,
      "start": 408.68,
      "end": 413.639,
      "text": "प्रमोटर्स अपना स्टेक बेच रहे हैं अब सवाल"
    },
    {
      "subtitle_id": 200,
      "start": 410.479,
      "end": 413.639,
      "text": "आता है कि इनके प्रमोटर कौन है"
    },
    {
      "subtitle_id": 201,
      "start": 419.56,
      "end": 423.52,
      "text": "इन्वेस्टर्स मोर एंड मोर बिकॉज़ रिटेल"
    },
    {
      "subtitle_id": 202,
      "start": 421.68,
      "end": 425.4,
      "text": "इन्वेस्टर्स और छोटे इन्वेस्टर्स उन स्टॉक"
    },
    {
      "subtitle_id": 203,
      "start": 423.52,
      "end": 427.199,
      "text": "को ज्यादा प्रेफरेंस देते हैं जो ₹1 के"
    },
    {
      "subtitle_id": 204,
      "start": 425.4,
      "end": 428.8,
      "text": "नीचे ट्रेड करते हैं तो यहां पर भी यही"
    },
    {
      "subtitle_id": 205,
      "start": 427.199,
      "end": 430.36,
      "text": "स्ट्रैटेजी जो इन्वेस्टमेंट बैंकर्स है"
    },
    {
      "subtitle_id": 206,
      "start": 428.8,
      "end": 432.599,
      "text": "इन्होंने लगाई है टू अट्रैक्ट द रिटेल"
    },
    {
      "subtitle_id": 207,
      "start": 430.36,
      "end": 435.039,
      "text": "इन्वेस्टर्स इस आईपीओ की बीडिंग आपकी 9 से"
    },
    {
      "subtitle_id": 208,
      "start": 432.599,
      "end": 436.4,
      "text": "11 तारीख के बीच आईपीओ रहेगा और 16 सितंबर"
    },
    {
      "subtitle_id": 209,
      "start": 435.039,
      "end": 438.12,
      "text": "को शेयर्स की लिस्टिंग होगी और"
    },
    {
      "subtitle_id": 210,
      "start": 436.4,
      "end": 440.199,
      "text": "इंटरेस्टिंग चीज ये है कि यहां पर 500"
    },
    {
      "subtitle_id": 211,
      "start": 438.12,
      "end": 442.199,
      "text": "करोड़ का जो कोटा है वो रिजर्व रखा गया है"
    },
    {
      "subtitle_id": 212,
      "start": 440.199,
      "end": 445.08,
      "text": "शेयर होल्डर्स के लिए किस कंपनी के शेयर"
    },
    {
      "subtitle_id": 213,
      "start": 442.199,
      "end": 445.08,
      "text": "होल्डर्स के लिए तो"
    },
    {
      "subtitle_id": 214,
      "start": 449.599,
      "end": 453.199,
      "text": "अप्लाई कर सकते हो मिलने के चांसेस आपके"
    },
    {
      "subtitle_id": 215,
      "start": 451.56,
      "end": 454.8,
      "text": "बढ़ सकते हैं डिपेंडिंग ऑन कितना"
    },
    {
      "subtitle_id": 216,
      "start": 453.199,
      "end": 457.919,
      "text": "सब्सक्रिप्शन आता है अब इस वीडियो को"
    },
    {
      "subtitle_id": 217,
      "start": 454.8,
      "end": 457.919,
      "text": "देखने के बाद आप सोचोगे कि मैं"
    },
    {
      "subtitle_id": 218,
      "start": 460.22,
      "end": 463.309,
      "text": "[संगीत]"
    },
    {
      "subtitle_id": 219,
      "start": 466.14,
      "end": 469.2,
      "text": "[संगीत]"
    },
    {
      "subtitle_id": 220,
      "start": 479.479,
      "end": 482.56,
      "text": "देखते हैं ओवर पीरियड ऑफ टाइम क्वार्टरली"
    },
    {
      "subtitle_id": 221,
      "start": 480.919,
      "end": 485.199,
      "text": "ट्रैक करते रहिए लिस्ट होने के बाद"
    },
    {
      "subtitle_id": 222,
      "start": 482.56,
      "end": 486.36,
      "text": "कॉन्फ्रेंस कॉल सुनिए क्योंकि फंडामेंटल"
    },
    {
      "subtitle_id": 223,
      "start": 485.199,
      "end": 488.52,
      "text": "तो कंपनी स्ट्रांग है बहुत ज्यादा"
    },
    {
      "subtitle_id": 224,
      "start": 486.36,
      "end": 490.159,
      "text": "स्ट्रांग है लिस्टिंग गेन भी मुझे लगता है"
    },
    {
      "subtitle_id": 225,
      "start": 488.52,
      "end": 491.599,
      "text": "कि काफी अच्छा दो दिन में सब्सक्रिप्शन आ"
    },
    {
      "subtitle_id": 226,
      "start": 490.159,
      "end": 493.4,
      "text": "जाएगा तो लिस्टिंग गेन के चांसेस भी बहुत"
    },
    {
      "subtitle_id": 227,
      "start": 491.599,
      "end": 495.4,
      "text": "ज्यादा है ग्रे मार्केट प्रीमियम बहुत"
    },
    {
      "subtitle_id": 228,
      "start": 493.4,
      "end": 497.319,
      "text": "ज्यादा स्ट्रांग है 70 पर के आसपास चल रहा"
    },
    {
      "subtitle_id": 229,
      "start": 495.4,
      "end": 499.0,
      "text": "है धीरे-धीरे कम होके मुझे लगता है 50 पर"
    },
    {
      "subtitle_id": 230,
      "start": 497.319,
      "end": 501.039,
      "text": "के आसपास आ जाएगा तो लिस्टिंग इनका तो"
    },
    {
      "subtitle_id": 231,
      "start": 499.0,
      "end": 502.919,
      "text": "क्लियर है अगर लॉन्ग टर्म की बात करें तो"
    },
    {
      "subtitle_id": 232,
      "start": 501.039,
      "end": 504.96,
      "text": "फिलहाल वैल्यूएशन थोड़ा ज्यादा कंपनी मांग"
    },
    {
      "subtitle_id": 233,
      "start": 502.919,
      "end": 506.84,
      "text": "रही है और लिस्ट होने के बाद और भी ज्यादा"
    },
    {
      "subtitle_id": 234,
      "start": 504.96,
      "end": 508.639,
      "text": "ही वैल्युएशन ऑफकोर्स हो ही जाएगा इसको और"
    },
    {
      "subtitle_id": 235,
      "start": 506.84,
      "end": 510.24,
      "text": "बेटर तरीके से एनालिसिस करने का तरीका है"
    },
    {
      "subtitle_id": 236,
      "start": 508.639,
      "end": 511.8,
      "text": "कि कंपनी की फ्यूचर प्रोजेक्शन को ध्यान"
    },
    {
      "subtitle_id": 237,
      "start": 510.24,
      "end": 513.919,
      "text": "में रखते हुए अगर इसकी फाइनेंशियल मॉडलिंग"
    },
    {
      "subtitle_id": 238,
      "start": 511.8,
      "end": 515.839,
      "text": "आप करते हो तो आप डीसीएफ की मदद से बेटर"
    },
    {
      "subtitle_id": 239,
      "start": 513.919,
      "end": 517.8,
      "text": "तरीके से इसका वैल्यूएशन निकाल पाओगे तो"
    },
    {
      "subtitle_id": 240,
      "start": 515.839,
      "end": 519.88,
      "text": "ओवरऑल अगर बोले तो बहुत टाइम बाद बहुत"
    },
    {
      "subtitle_id": 241,
      "start": 517.8,
      "end": 521.8,
      "text": "ज्यादा टाइम बाद ऐसे कोई कंपनी का रिव्यू"
    },
    {
      "subtitle_id": 242,
      "start": 519.88,
      "end": 523.76,
      "text": "मैं कर रहा हूं जिसमें पॉजिटिव ज्यादा है"
    },
    {
      "subtitle_id": 243,
      "start": 521.8,
      "end": 525.8,
      "text": "नेगेटिव से व्हिच इज एक्चुअली अ गुड थिंग"
    },
    {
      "subtitle_id": 244,
      "start": 523.76,
      "end": 527.48,
      "text": "अब देखिए हमारे चैनल पर हम कई बार आपने"
    },
    {
      "subtitle_id": 245,
      "start": 525.8,
      "end": 529.68,
      "text": "देखा होगा हम अलग-अलग कंपनीज को एक्सपोज"
    },
    {
      "subtitle_id": 246,
      "start": 527.48,
      "end": 531.519,
      "text": "करते आए हैं अलग-अलग फ्रॉड को एक्सपोज"
    },
    {
      "subtitle_id": 247,
      "start": 529.68,
      "end": 533.0,
      "text": "करते आए हैं तो कई सारे लोग कहते भी है"
    },
    {
      "subtitle_id": 248,
      "start": 531.519,
      "end": 534.8,
      "text": "बीच-बीच में कि आप नेगेटिव चीजें ज्यादा"
    },
    {
      "subtitle_id": 249,
      "start": 533.0,
      "end": 536.24,
      "text": "कवर करते हैं तो जो भी पॉजिटिव चीजें होती"
    },
    {
      "subtitle_id": 250,
      "start": 534.8,
      "end": 538.32,
      "text": "है उन्हें भी हम कवर करते हैं जैसा कि"
    },
    {
      "subtitle_id": 251,
      "start": 536.24,
      "end": 540.519,
      "text": "आईपीओ सो नथिंग लाइक दैट जहां पर आपका"
    },
    {
      "subtitle_id": 252,
      "start": 538.32,
      "end": 542.68,
      "text": "पैसा बन सके और किसी स्कैम में या फिर"
    },
    {
      "subtitle_id": 253,
      "start": 540.519,
      "end": 544.839,
      "text": "किसी कंपनी में पैसा बच सके तो वही दो"
    },
    {
      "subtitle_id": 254,
      "start": 542.68,
      "end": 546.36,
      "text": "हमारे मेन मकसद है आप हमारे वीडियोस काफी"
    },
    {
      "subtitle_id": 255,
      "start": 544.839,
      "end": 548.24,
      "text": "लंबे टाइम से देख रहे होंगे और आप में से"
    },
    {
      "subtitle_id": 256,
      "start": 546.36,
      "end": 550.279,
      "text": "काफी सारे लोगों को लगता होगा कि फिनो शस"
    },
    {
      "subtitle_id": 257,
      "start": 548.24,
      "end": 552.64,
      "text": "की टीम के साथ मैं कैसे काम कर सकता हूं"
    },
    {
      "subtitle_id": 258,
      "start": 550.279,
      "end": 554.6,
      "text": "तो अभी ये अपॉर्चुनिटी आई है जहां पर फिनो"
    },
    {
      "subtitle_id": 259,
      "start": 552.64,
      "end": 556.399,
      "text": "शस की कई सारी जॉब ओपनिंग फिलहाल चल रही"
    },
    {
      "subtitle_id": 260,
      "start": 554.6,
      "end": 558.44,
      "text": "है और इसकी पूरी लिस्ट डिस्क्रिप्शन में"
    },
    {
      "subtitle_id": 261,
      "start": 556.399,
      "end": 559.959,
      "text": "आपको मिल जाएगी जहां पर हमारा करियर पेज"
    },
    {
      "subtitle_id": 262,
      "start": 558.44,
      "end": 561.959,
      "text": "का लिंक आपको मिल जाएगा वहां जाकर आप"
    },
    {
      "subtitle_id": 263,
      "start": 559.959,
      "end": 564.079,
      "text": "अलग-अलग पोजीशंस के लिए अप्लाई कर सकते हो"
    },
    {
      "subtitle_id": 264,
      "start": 561.959,
      "end": 566.12,
      "text": "जॉब की लोकेशन रहेगी मलकापुर महाराष्ट्र"
    },
    {
      "subtitle_id": 265,
      "start": 564.079,
      "end": 567.88,
      "text": "जो कि जलगांव के करीब आता है सो मिलते हैं"
    },
    {
      "subtitle_id": 266,
      "start": 566.12,
      "end": 571.48,
      "text": "अगले वीडियो में थैंक यू सो मच फॉर वाचिंग"
    },
    {
      "subtitle_id": 267,
      "start": 567.88,
      "end": 571.48,
      "text": "दिस वीडियो बाय बाय h"
    }
  ]
}