  "parsing_issues": [],
  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.12,
      "end": 3.56,
      "text": "दो ऐसी चीजें हैं जिनका शेयर मार्केट पर"
    },
    {
      "subtitle_id": 2,
      "start": 2.08,
      "end": 5.4,
      "text": "एक बहुत बड़ा इंपैक्ट होता है और"
    },
    {
      "subtitle_id": 3,
      "start": 3.56,
      "end": 7.359,
      "text": "इन्वेस्टर्स के लिए भी ये समझना बहुत"
    },
    {
      "subtitle_id": 4,
      "start": 5.4,
      "end": 8.96,
      "text": "जरूरी है कि कौन से ये दो फैक्टर्स है और"
    },
    {
      "subtitle_id": 5,
      "start": 7.359,
      "end": 10.519,
      "text": "कैसे इन दोनों चीजों का मार्केट पर"
    },
    {
      "subtitle_id": 6,
      "start": 8.96,
      "end": 12.28,
      "text": "इंपैक्ट होता है और जैसे कि हमें पता है"
    },
    {
      "subtitle_id": 7,
      "start": 10.519,
      "end": 14.92,
      "text": "कि मिस्टर झुनझुन वाला ने यूनियन बजट का"
    },
    {
      "subtitle_id": 8,
      "start": 12.28,
      "end": 17.359,
      "text": "सही इस्तेमाल करके अपने ₹ करोड़ 20 करोड़"
    },
    {
      "subtitle_id": 9,
      "start": 14.92,
      "end": 19.359,
      "text": "में तब्दील किए थे तो पहला है यूनियन बजट"
    },
    {
      "subtitle_id": 10,
      "start": 17.359,
      "end": 21.199,
      "text": "और दूसरा है इलेक्शन और जैसे कि आपको"
    },
    {
      "subtitle_id": 11,
      "start": 19.359,
      "end": 23.039,
      "text": "बताया कि भारत में जब भी इलेक्शन होते हैं"
    },
    {
      "subtitle_id": 12,
      "start": 21.199,
      "end": 24.48,
      "text": "शेयर मार्केट में हलचल होना शुरू हो जाती"
    },
    {
      "subtitle_id": 13,
      "start": 23.039,
      "end": 26.84,
      "text": "है और होगी भी क्यों ना क्योंकि कौन सी"
    },
    {
      "subtitle_id": 14,
      "start": 24.48,
      "end": 29.119,
      "text": "सरकार आएगी इस पर यह डिपेंड करता है कि"
    },
    {
      "subtitle_id": 15,
      "start": 26.84,
      "end": 30.84,
      "text": "कौन सी बिजनेस पॉलिसीज वो लाएंगे और उस"
    },
    {
      "subtitle_id": 16,
      "start": 29.119,
      "end": 32.68,
      "text": "बिजनेस पॉलिसी पर डिपेंड करता है कि"
    },
    {
      "subtitle_id": 17,
      "start": 30.84,
      "end": 35.239,
      "text": "बिजनेसेस किस तेजी से बढ़ेंगे इकोनॉमी"
    },
    {
      "subtitle_id": 18,
      "start": 32.68,
      "end": 37.36,
      "text": "कैसे बढ़ेगी तो ओवरऑल किसी एक सरकार का"
    },
    {
      "subtitle_id": 19,
      "start": 35.239,
      "end": 39.36,
      "text": "बहुत इंपॉर्टेंट रोल होता है ओवरऑल पूरी"
    },
    {
      "subtitle_id": 20,
      "start": 37.36,
      "end": 41.239,
      "text": "इकॉनमी पर और शेयर मार्केट पर और इसलिए जब"
    },
    {
      "subtitle_id": 21,
      "start": 39.36,
      "end": 43.6,
      "text": "भी लोकसभा इलेक्शन आते हैं मार्केट में"
    },
    {
      "subtitle_id": 22,
      "start": 41.239,
      "end": 45.96,
      "text": "वोलेट आ जाती है लेकिन इसमें भी कुछ ऐसे"
    },
    {
      "subtitle_id": 23,
      "start": 43.6,
      "end": 47.48,
      "text": "पैटर्स हैं जिसके बारे में आज हम बात"
    },
    {
      "subtitle_id": 24,
      "start": 45.96,
      "end": 49.16,
      "text": "करेंगे ऐसे डेटा पॉइंट्स के बारे में बात"
    },
    {
      "subtitle_id": 25,
      "start": 47.48,
      "end": 50.96,
      "text": "करेंगे जिसका इस्तेमाल हम अपने लिए कर"
    },
    {
      "subtitle_id": 26,
      "start": 49.16,
      "end": 52.84,
      "text": "सकते हैं एक बेटर इन्वेस्टमेंट स्ट्रेटेजी"
    },
    {
      "subtitle_id": 27,
      "start": 50.96,
      "end": 54.28,
      "text": "बनाने के लिए यहां पर हम ऐसे कुछ सेक्टर्स"
    },
    {
      "subtitle_id": 28,
      "start": 52.84,
      "end": 56.239,
      "text": "के बारे में बात करने वाले हैं ऐसे कुछ"
    },
    {
      "subtitle_id": 29,
      "start": 54.28,
      "end": 58.199,
      "text": "इंडा इसस के बारे में बात करने वाले हैं"
    },
    {
      "subtitle_id": 30,
      "start": 56.239,
      "end": 60.0,
      "text": "जो कुछ अलग तरीके से इस दौरान परफॉर्म"
    },
    {
      "subtitle_id": 31,
      "start": 58.199,
      "end": 62.359,
      "text": "करते हैं तो काफी कुछ डाटा क्रंचिंग करके"
    },
    {
      "subtitle_id": 32,
      "start": 60.0,
      "end": 64.119,
      "text": "के आज हम यहां पर आए हैं और यहां से आप"
    },
    {
      "subtitle_id": 33,
      "start": 62.359,
      "end": 65.84,
      "text": "काफी कुछ इन्वेस्टमेंट स्ट्रेटेजी बना"
    },
    {
      "subtitle_id": 34,
      "start": 64.119,
      "end": 67.56,
      "text": "सकते हैं तो वीडियो के एंड में कमेंट करके"
    },
    {
      "subtitle_id": 35,
      "start": 65.84,
      "end": 69.68,
      "text": "जरूर बता देना कि जो भी डाटा है उसके"
    },
    {
      "subtitle_id": 36,
      "start": 67.56,
      "end": 70.64,
      "text": "बेसिस पर आप कौन सी स्ट्रेटेजी अप्लाई"
    },
    {
      "subtitle_id": 37,
      "start": 69.68,
      "end": 73.28,
      "text": "करना चाहते"
    },
    {
      "subtitle_id": 38,
      "start": 70.64,
      "end": 74.64,
      "text": "हैं नमस्कार मैं प्रसाद आपका आज के इस"
    },
    {
      "subtitle_id": 39,
      "start": 73.28,
      "end": 76.4,
      "text": "वीडियो में स्वागत करता हूं और आज के इस"
    },
    {
      "subtitle_id": 40,
      "start": 74.64,
      "end": 77.799,
      "text": "वीडियो के प्रायोजक है गैप अप बाय रिकी"
    },
    {
      "subtitle_id": 41,
      "start": 76.4,
      "end": 79.799,
      "text": "जिनके बारे में हम वीडियो में आगे बात"
    },
    {
      "subtitle_id": 42,
      "start": 77.799,
      "end": 82.119,
      "text": "करेंगे यहां पर हम काफी कुछ डाटा क्रंचिंग"
    },
    {
      "subtitle_id": 43,
      "start": 79.799,
      "end": 85.079,
      "text": "करके आपके सामने आए हैं अब इस डाटा में"
    },
    {
      "subtitle_id": 44,
      "start": 82.119,
      "end": 87.2,
      "text": "हमने इलेक्शन के पहले का एक साल इलेक्शन"
    },
    {
      "subtitle_id": 45,
      "start": 85.079,
      "end": 89.4,
      "text": "के पहले के 6 महीने इलेक्शन के पहले का एक"
    },
    {
      "subtitle_id": 46,
      "start": 87.2,
      "end": 91.04,
      "text": "महीना और बाद का सिमिलर टाइम पीरियड हमने"
    },
    {
      "subtitle_id": 47,
      "start": 89.4,
      "end": 93.479,
      "text": "एनालाइज कि किया और काफी कुछ इंपॉर्टेंट"
    },
    {
      "subtitle_id": 48,
      "start": 91.04,
      "end": 96.119,
      "text": "चीजें यहां से पता चले एक चीज जो आपको"
    },
    {
      "subtitle_id": 49,
      "start": 93.479,
      "end": 98.96,
      "text": "ऑब्जर्व करनी है थ्रू आउट दिस वीडियो वो"
    },
    {
      "subtitle_id": 50,
      "start": 96.119,
      "end": 101.56,
      "text": "यह है कि यहां पर फॉर एग्जांपल इस बार के"
    },
    {
      "subtitle_id": 51,
      "start": 98.96,
      "end": 103.799,
      "text": "केस में 4 जून 2024 को इलेक्शन का रिजल्ट"
    },
    {
      "subtitle_id": 52,
      "start": 101.56,
      "end": 105.32,
      "text": "आ रहा है तो एज एन इन्वेस्टर आपके लिए जो"
    },
    {
      "subtitle_id": 53,
      "start": 103.799,
      "end": 108.52,
      "text": "टाइम पीरियड है एनालिसिस के लिए वो सबसे"
    },
    {
      "subtitle_id": 54,
      "start": 105.32,
      "end": 112.52,
      "text": "इंपोर्टेंट कौन सा है जून 2023 से लेकर"
    },
    {
      "subtitle_id": 55,
      "start": 108.52,
      "end": 114.719,
      "text": "जून 2024 और 4 जून के बाद के दो-चार दिन"
    },
    {
      "subtitle_id": 56,
      "start": 112.52,
      "end": 116.799,
      "text": "क्योंकि रिजल्ट आने के बाद दो-चार दिन में"
    },
    {
      "subtitle_id": 57,
      "start": 114.719,
      "end": 118.759,
      "text": "ही वोलेट रहती है क्योंकि पहले ज्यादा"
    },
    {
      "subtitle_id": 58,
      "start": 116.799,
      "end": 120.6,
      "text": "वोलेट रहती है बिकॉज़ एंटीसिपेशन हर किसी"
    },
    {
      "subtitle_id": 59,
      "start": 118.759,
      "end": 122.159,
      "text": "के अलग-अलग है कोई कोई बोलेगा यह पार्टी"
    },
    {
      "subtitle_id": 60,
      "start": 120.6,
      "end": 123.84,
      "text": "आएगी कोई बोलेगा वो पार्टी आएगी कोई"
    },
    {
      "subtitle_id": 61,
      "start": 122.159,
      "end": 125.28,
      "text": "बोलेगा इस पार्टी की इतनी सीटें आएंगी कोई"
    },
    {
      "subtitle_id": 62,
      "start": 123.84,
      "end": 126.68,
      "text": "बोलेगा उससे ज्यादा सीटें आगी और उसका भी"
    },
    {
      "subtitle_id": 63,
      "start": 125.28,
      "end": 129.92,
      "text": "इंपैक्ट होता है वो भी मैं आगे आपको"
    },
    {
      "subtitle_id": 64,
      "start": 126.68,
      "end": 132.28,
      "text": "बताऊंगा लेकिन एक बार रिजल्ट आ गए तो पता"
    },
    {
      "subtitle_id": 65,
      "start": 129.92,
      "end": 134.879,
      "text": "है कि कौन सी पार्टी आ रही है किस तरह की"
    },
    {
      "subtitle_id": 66,
      "start": 132.28,
      "end": 136.68,
      "text": "उनकी थिंकिंग है वो प्रो बिजनेस है या फिर"
    },
    {
      "subtitle_id": 67,
      "start": 134.879,
      "end": 139.76,
      "text": "नहीं ये सारी चीज एक बार पता चल गई तो"
    },
    {
      "subtitle_id": 68,
      "start": 136.68,
      "end": 141.84,
      "text": "दो-तीन दिन में फिर वो वोलेट पूरी तरह से"
    },
    {
      "subtitle_id": 69,
      "start": 139.76,
      "end": 144.12,
      "text": "सॉफ्ट हो जाती है और यहां पर हमने आपके"
    },
    {
      "subtitle_id": 70,
      "start": 141.84,
      "end": 145.959,
      "text": "लिए पूरे 25 इयर्स पिछले 25 साल का"
    },
    {
      "subtitle_id": 71,
      "start": 144.12,
      "end": 147.879,
      "text": "एनालिसिस किया है और वही सारा डाटा अब"
    },
    {
      "subtitle_id": 72,
      "start": 145.959,
      "end": 149.48,
      "text": "आपके सामने रखते हैं तो अभी मैं सेंसेक्स"
    },
    {
      "subtitle_id": 73,
      "start": 147.879,
      "end": 151.519,
      "text": "और निफ्टी के डाटा की बात करता हूं बाद"
    },
    {
      "subtitle_id": 74,
      "start": 149.48,
      "end": 153.56,
      "text": "में मैं बाकी इंडेक्सेस की बात करूंगा"
    },
    {
      "subtitle_id": 75,
      "start": 151.519,
      "end": 155.48,
      "text": "उसके बाद सेक्टर्स की भी बात करूंगा तो"
    },
    {
      "subtitle_id": 76,
      "start": 153.56,
      "end": 158.28,
      "text": "स्टेप बाय स्टेप हम आगे बढ़ेंगे यहां पर"
    },
    {
      "subtitle_id": 77,
      "start": 155.48,
      "end": 160.76,
      "text": "अगर देखते हैं 1999 में एनडीए की सरकार आई"
    },
    {
      "subtitle_id": 78,
      "start": 158.28,
      "end": 163.12,
      "text": "थी अटल बिहारी वाजपेई की और उस टाइम"
    },
    {
      "subtitle_id": 79,
      "start": 160.76,
      "end": 165.44,
      "text": "इलेक्शन के 1 साल पहले 50 पर के रिटर्न"
    },
    {
      "subtitle_id": 80,
      "start": 163.12,
      "end": 167.12,
      "text": "मिले अ लोग काफी ऑप्टिमिस्टिक थे उस सरकार"
    },
    {
      "subtitle_id": 81,
      "start": 165.44,
      "end": 169.319,
      "text": "को लेकर तो उस साल इलेक्शन से पहले"
    },
    {
      "subtitle_id": 82,
      "start": 167.12,
      "end": 171.44,
      "text": "मार्केट काफी चढ़ा उसके बाद काफी स्टेबल"
    },
    {
      "subtitle_id": 83,
      "start": 169.319,
      "end": 173.599,
      "text": "हो गया और उसके बाद में बढ़ता रहा फिर"
    },
    {
      "subtitle_id": 84,
      "start": 171.44,
      "end": 175.4,
      "text": "2004 में लोगों का ये एक्सपेक्टेशन था कि"
    },
    {
      "subtitle_id": 85,
      "start": 173.599,
      "end": 177.519,
      "text": "एनडीए की सरकार ही फिर से आएगी लेकिन ऐसा"
    },
    {
      "subtitle_id": 86,
      "start": 175.4,
      "end": 180.08,
      "text": "नहीं हुआ यूपीए की सरकार आई डॉक्टर मनमोहन"
    },
    {
      "subtitle_id": 87,
      "start": 177.519,
      "end": 182.12,
      "text": "सिंह की उस साल भी इलेक्शन के पहले 96 6"
    },
    {
      "subtitle_id": 88,
      "start": 180.08,
      "end": 183.799,
      "text": "पर से मार्केट बढ़ गया था लेकिन लोगों के"
    },
    {
      "subtitle_id": 89,
      "start": 182.12,
      "end": 185.879,
      "text": "एक्सपेक्टेशन थे कि एनडीए की सरकार आएगी"
    },
    {
      "subtitle_id": 90,
      "start": 183.799,
      "end": 188.72,
      "text": "लेकिन ऐसा हुआ इसलिए रिजल्ट दिन से लेकर"
    },
    {
      "subtitle_id": 91,
      "start": 185.879,
      "end": 190.239,
      "text": "अगले दो-तीन दिनों तक मार्केट % से गिर"
    },
    {
      "subtitle_id": 92,
      "start": 188.72,
      "end": 192.92,
      "text": "गया लेकिन अगेन उसके बाद मार्केट में"
    },
    {
      "subtitle_id": 93,
      "start": 190.239,
      "end": 195.36,
      "text": "अच्छी खासी रिकवरी देखने मिली फिर 2009"
    },
    {
      "subtitle_id": 94,
      "start": 192.92,
      "end": 197.12,
      "text": "में अगेन डॉ मनमोहन सिंह की सरकार आई यहां"
    },
    {
      "subtitle_id": 95,
      "start": 195.36,
      "end": 200.0,
