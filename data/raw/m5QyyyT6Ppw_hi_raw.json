      "text": "अच्छे परफॉर्मेंस देते हैं वो है प्राइवेट"
    },
    {
      "subtitle_id": 193,
      "start": 435.039,
      "end": 439.84,
      "text": "बैंक्स और सीपीएससी सेक्टर्स और ऐसे कुछ"
    },
    {
      "subtitle_id": 194,
      "start": 437.56,
      "end": 442.039,
      "text": "सेक्टर्स जो बिल्कुल भी अच्छा परफॉर्म"
    },
    {
      "subtitle_id": 195,
      "start": 439.84,
      "end": 444.319,
      "text": "नहीं करते हैं इलेक्शन के टाइम उसमें पहला"
    },
    {
      "subtitle_id": 196,
      "start": 442.039,
      "end": 446.16,
      "text": "आता है मेटल सेक्टर और दूसरा है रियलिटी"
    },
    {
      "subtitle_id": 197,
      "start": 444.319,
      "end": 447.72,
      "text": "सेक्टर अगर मैं बहुत स्टेबिलिटी की बात"
    },
    {
      "subtitle_id": 198,
      "start": 446.16,
      "end": 449.479,
      "text": "करूं बिफोर इलेक्शन आफ्टर इलेक्शन जो"
    },
    {
      "subtitle_id": 199,
      "start": 447.72,
      "end": 451.56,
      "text": "सेक्टर बहुत स्टेबल होते हैं ज्यादा"
    },
    {
      "subtitle_id": 200,
      "start": 449.479,
      "end": 453.36,
      "text": "वोलेटाइल नहीं होते तो उसमें एफएमसीजी आता"
    },
    {
      "subtitle_id": 201,
      "start": 451.56,
      "end": 455.72,
      "text": "है और इंफ्रास्ट्रक्चर आता है ये तो हो"
    },
    {
      "subtitle_id": 202,
      "start": 453.36,
      "end": 457.639,
      "text": "गया इंडा इस का और सेक्टर्स का कंक्लूजन"
    },
    {
      "subtitle_id": 203,
      "start": 455.72,
      "end": 459.039,
      "text": "में हम इसके बारे में बात करेंगे लेकिन"
    },
    {
      "subtitle_id": 204,
      "start": 457.639,
      "end": 461.4,
      "text": "उससे पहले मैं एक स्टॉक के बारे में भी"
    },
    {
      "subtitle_id": 205,
      "start": 459.039,
      "end": 463.68,
      "text": "आपसे बात करना चाहता हूं जिसका बिहेवियर"
    },
    {
      "subtitle_id": 206,
      "start": 461.4,
      "end": 466.84,
      "text": "जब-जब बीजेपी गवर्नमेंट आती है तब काफी"
    },
    {
      "subtitle_id": 207,
      "start": 463.68,
      "end": 468.52,
      "text": "ज्यादा वोलेटाइल हो जाता है और वो है"
    },
    {
      "subtitle_id": 208,
      "start": 466.84,
      "end": 470.44,
      "text": "अदानी ग्रुप की लीडिंग कंपनी अदानी"
    },
    {
      "subtitle_id": 209,
      "start": 468.52,
      "end": 473.08,
      "text": "एंटरप्राइजेस अदानी एंटरप्राइजेस की बात"
    },
    {
      "subtitle_id": 210,
      "start": 470.44,
      "end": 474.68,
      "text": "करूं तो 2009 के इलेक्शन में भी यह स्टॉक"
    },
    {
      "subtitle_id": 211,
      "start": 473.08,
      "end": 476.44,
      "text": "काफी अच्छा ही परफॉर्म कर रहा था बहुत"
    },
    {
      "subtitle_id": 212,
      "start": 474.68,
      "end": 478.8,
      "text": "सारे लोगों को शायद यह प नहीं पता होगा"
    },
    {
      "subtitle_id": 213,
      "start": 476.44,
      "end": 481.24,
      "text": "जैसे कि 2009 के इलेक्शन के पहले एक साल"
    },
    {
      "subtitle_id": 214,
      "start": 478.8,
      "end": 483.12,
      "text": "में माइनस 14 पर की परफॉर्मेंस थी इलेक्शन"
    },
    {
      "subtitle_id": 215,
      "start": 481.24,
      "end": 485.24,
      "text": "के 6 महीने पहले अचानक से यह अदानी"
    },
    {
      "subtitle_id": 216,
      "start": 483.12,
      "end": 488.12,
      "text": "एंटरप्राइजेस बहुत चलने लगा बाद 2009 की"
    },
    {
      "subtitle_id": 217,
      "start": 485.24,
      "end": 490.199,
      "text": "है 124 के पॉजिटिव रिटर्न्स थे फिर एक"
    },
    {
      "subtitle_id": 218,
      "start": 488.12,
      "end": 493.24,
      "text": "महीना पहले इसने और अच्छा परफॉर्मेंस दिया"
    },
    {
      "subtitle_id": 219,
      "start": 490.199,
      "end": 495.12,
      "text": "और 30 पर रिटर्न्स दिए तो इस तरह के"
    },
    {
      "subtitle_id": 220,
      "start": 493.24,
      "end": 497.96,
      "text": "क्रेजी रिटर्न्स अदानी एंटरप्राइजेस ने"
    },
    {
      "subtitle_id": 221,
      "start": 495.12,
      "end": 500.68,
      "text": "दिए 2009 में और इलेक्शन के एक महीने बाद"
    },
    {
      "subtitle_id": 222,
      "start": 497.96,
      "end": 503.199,
      "text": "भी स्टॉक ने 50 पर का रिटर्न दिया है और"
    },
    {
      "subtitle_id": 223,
      "start": 500.68,
      "end": 505.0,
      "text": "इलेक्शन के 1 साल बाद 60 का रिटर्न यानी"
    },
    {
      "subtitle_id": 224,
      "start": 503.199,
      "end": 507.4,
      "text": "2009 में भी इस स्टॉक ने बहुत अच्छा"
    },
    {
      "subtitle_id": 225,
      "start": 505.0,
      "end": 508.96,
      "text": "परफॉर्म किया 2014 में अगर मैं बात करूं"
    },
    {
      "subtitle_id": 226,
      "start": 507.4,
      "end": 511.36,
      "text": "जिसमें स्टॉक की काफी बातें हो गई जब"
    },
    {
      "subtitle_id": 227,
      "start": 508.96,
      "end": 515.0,
      "text": "बीजेपी गवर्मेंट आ गई तो इलेक्शन के 1 साल"
    },
    {
      "subtitle_id": 228,
      "start": 511.36,
      "end": 517.839,
      "text": "पहले 126 पर के रिटर्न थे 6 महीना पहले 81"
    },
    {
      "subtitle_id": 229,
      "start": 515.0,
      "end": 520.039,
      "text": "पर रिटर्न 1 महीना पहले 19 पर के रिटर्न"
    },
    {
      "subtitle_id": 230,
      "start": 517.839,
      "end": 522.839,
      "text": "थे एक महीना बाद स्टॉक नेगेटिव में चला"
    },
    {
      "subtitle_id": 231,
      "start": 520.039,
      "end": 526.36,
      "text": "गया -6 पर के रिटर्न दिए थे रिजल्ट से 1"
    },
    {
      "subtitle_id": 232,
      "start": 522.839,
      "end": 529.24,
      "text": "महीने बाद 6 मंथ्स बाद -4 पर और 1 साल बाद"
    },
    {
      "subtitle_id": 233,
      "start": 526.36,
      "end": 530.88,
      "text": "47 पर के पॉजिटिव रिजल्ट थे 2019 के"
    },
    {
      "subtitle_id": 234,
      "start": 529.24,
      "end": 533.16,
      "text": "इलेक्शन की मैं बात करूं तो अगेन अदानी"
    },
    {
      "subtitle_id": 235,
      "start": 530.88,
      "end": 536.76,
      "text": "एंटरप्राइजेस इलेक्शन के पहले एक साल में"
    },
    {
      "subtitle_id": 236,
      "start": 533.16,
      "end": 539.399,
      "text": "79 पर से बढ़ा 6 महीनों में -6 पर था और"
    },
    {
      "subtitle_id": 237,
      "start": 536.76,
      "end": 541.6,
      "text": "इलेक्शन से जस्ट एक महीना पहले 16 पर से"
    },
    {
      "subtitle_id": 238,
      "start": 539.399,
      "end": 545.079,
      "text": "स्टॉक बढ़ा था 1 साल बाद की मैं बात करूं"
    },
    {
      "subtitle_id": 239,
      "start": 541.6,
      "end": 548.079,
      "text": "तो 7 पर डाउन था 6 महीने बाद 36 पर अप और"
    },
    {
      "subtitle_id": 240,
      "start": 545.079,
      "end": 549.6,
      "text": "1 साल बाद -4 पर तो अगर मैं अदानी"
    },
    {
      "subtitle_id": 241,
      "start": 548.079,
      "end": 552.04,
      "text": "एंटरप्राइजेस की बात करूं तो इलेक्शन का"
    },
    {
      "subtitle_id": 242,
      "start": 549.6,
      "end": 554.959,
      "text": "पर्टिकुलर टाइम रिजल्ट के जो दो-चार दिन"
    },
    {
      "subtitle_id": 243,
      "start": 552.04,
      "end": 557.839,
      "text": "होते हैं इसमें ये स्टॉक जनरली बहुत"
    },
    {
      "subtitle_id": 244,
      "start": 554.959,
      "end": 560.76,
      "text": "वोलेटाइल होता है और अगर हमने देखा कि"
    },
    {
      "subtitle_id": 245,
      "start": 557.839,
      "end": 563.44,
      "text": "2009 में कांग्रेस आई फिर भी अप ही था और"
    },
    {
      "subtitle_id": 246,
      "start": 560.76,
      "end": 565.72,
      "text": "बीजेपी आई तब भी यह अप था लेकिन ऐसा माना"
    },
    {
      "subtitle_id": 247,
      "start": 563.44,
      "end": 567.56,
      "text": "जाता है कि जब बीजेपी गवर्नमेंट आती है तो"
    },
    {
      "subtitle_id": 248,
      "start": 565.72,
      "end": 570.44,
      "text": "यह स्टॉक जनरली काफी अच्छा परफॉर्म करने"
    },
    {
      "subtitle_id": 249,
      "start": 567.56,
      "end": 572.839,
      "text": "लगता है तो ऐसे भी कई सारे स्टॉक्स हैं जो"
    },
    {
      "subtitle_id": 250,
      "start": 570.44,
      "end": 575.24,
      "text": "रिजल्ट के बाद कुछ दिनों तक थोड़ी रहती है"
    },
    {
      "subtitle_id": 251,
      "start": 572.839,
      "end": 578.36,
      "text": "इसमें मोमेंटम देखिए इलेक्शन में अगर आप"
    },
    {
      "subtitle_id": 252,
      "start": 575.24,
      "end": 581.079,
      "text": "यह पता कर सकते हो कि कौन सी सरकार आ सकती"
    },
    {
      "subtitle_id": 253,
      "start": 578.36,
      "end": 583.8,
      "text": "है तो उससे भी आप काफी अच्छे तरीके से"
    },
    {
      "subtitle_id": 254,
      "start": 581.079,
      "end": 586.44,
      "text": "मार्केट को समझ सकते हो 2004 में लोगों को"
    },
    {
      "subtitle_id": 255,
      "start": 583.8,
      "end": 588.839,
      "text": "लग रहा था कि एनडी आईग लेकिन आई कांग्रेस"
    },
    {
      "subtitle_id": 256,
      "start": 586.44,
      "end": 591.04,
      "text": "मार्केट गिर गया 2009 के इलेक्शन में लोग"
    },
    {
      "subtitle_id": 257,
      "start": 588.839,
      "end": 594.16,
      "text": "यह मान रहे थे कि कांग्रेस आएगी कांग्रेस"
    },
    {
      "subtitle_id": 258,
      "start": 591.04,
      "end": 596.44,
      "text": "आई एंड मार्केट 17 पर से अब था उसी दिन"
    },
    {
      "subtitle_id": 259,
      "start": 594.16,
      "end": 599.519,
      "text": "जिस दिन रिजल्ट आया 2014 में लोगों के"
    },
    {
      "subtitle_id": 260,
      "start": 596.44,
      "end": 601.64,
      "text": "एक्सपेक्टशंस थे कि बीजेपी की सरकार आएगी"
    },
    {
      "subtitle_id": 261,
      "start": 599.519,
      "end": 604.56,
      "text": "बीजेपी सरकार आई मार्केट बहुत ऊपर चला गया"
    },
    {
      "subtitle_id": 262,
      "start": 601.64,
      "end": 606.44,
      "text": "2019 में भी लोगों की यही लोगों की यही"
    },
    {
      "subtitle_id": 263,
      "start": 604.56,
      "end": 609.959,
      "text": "एक्सपेक्टशंस थी कि बीजेपी की सरकार आएगी"
    },
    {
      "subtitle_id": 264,
      "start": 606.44,
      "end": 611.6,
      "text": "मार्केट अगेन बहुत ऊपर चला गया और 2024 की"
    },
    {
      "subtitle_id": 265,
      "start": 609.959,
      "end": 614.32,
      "text": "अगर मैं बात समझूं अभी तक इन्वेस्टर्स"
    },
    {
      "subtitle_id": 266,
      "start": 611.6,
      "end": 616.92,
      "text": "कम्युनिटी की तो यह लोग सोच रहे हैं कि"
    },
    {
      "subtitle_id": 267,
      "start": 614.32,
      "end": 619.079,
      "text": "शायद बीजेपी फिर से आएगी और अगर ऐसा होता"
    },
    {
      "subtitle_id": 268,
      "start": 616.92,
      "end": 621.32,
      "text": "है तो मेरे हिसाब से मार्केट अगेन ऊपर"
    },
    {
      "subtitle_id": 269,
      "start": 619.079,
      "end": 623.44,
      "text": "जाएगा अगर सीटें कम आती है उनकी तो"
    },
    {
      "subtitle_id": 270,
      "start": 621.32,
      "end": 625.44,
      "text": "मार्केट न्यूट्रल रहेगा और अगर सरकार बदल"
    },
    {
      "subtitle_id": 271,
      "start": 623.44,
      "end": 628.24,
      "text": "जाती है कांग्रेस आ जाती है तो फिर"
    },
    {
      "subtitle_id": 272,
      "start": 625.44,
      "end": 630.04,
      "text": "मार्केट नीचे जा सकता है कि लोगों को जो"
    },
    {
      "subtitle_id": 273,
      "start": 628.24,
      "end": 631.68,
      "text": "लगता है कि कौन सी पार्टी कि इसका रिजल्ट"
    },
    {
      "subtitle_id": 274,
      "start": 630.04,
      "end": 633.6,
      "text": "डे के शेयर मार्केट परफॉर्मेंस पर बहुत"
    },
    {
      "subtitle_id": 275,
      "start": 631.68,
      "end": 635.76,
      "text": "बड़ा इंपैक्ट होता है अगर वो सोचते हैं"
    },
    {
      "subtitle_id": 276,
      "start": 633.6,
      "end": 637.32,
      "text": "वैसा होता है तो मार्केट जनरली बहुत अच्छा"
    },
    {
      "subtitle_id": 277,
      "start": 635.76,
      "end": 640.04,
      "text": "परफॉर्म करता है उस दिन और अगले दो-तीन"
    },
    {
      "subtitle_id": 278,
      "start": 637.32,
      "end": 642.279,
      "text": "दिन अगर ऐसा नहीं होता है तो मार्केट खराब"
    },
    {
      "subtitle_id": 279,
      "start": 640.04,
      "end": 644.44,
      "text": "परफॉर्म करता है रिजल्ट के दिन और रिजल्ट"
    },
    {
      "subtitle_id": 280,
      "start": 642.279,
      "end": 646.76,
      "text": "के एक दो दिन बाद इंसेस की बात करूं तो"
    },
    {
      "subtitle_id": 281,
      "start": 644.44,
      "end": 648.639,
      "text": "मिडकैप 100 एक सेक्टर है जो काफी"
    },
    {
      "subtitle_id": 282,
      "start": 646.76,
      "end": 650.36,
      "text": "कंसिस्टेंटली अच्छा परफॉर्म करते आया है"
    },
    {
      "subtitle_id": 283,
      "start": 648.639,
      "end": 652.839,
      "text": "इलेक्शन के टाइम में और सेक्टर की बात"
    },
    {
      "subtitle_id": 284,
      "start": 650.36,
      "end": 654.839,
      "text": "करें तो बैंकिंग ऐसा सेक्टर है कि जो काफी"
    },
    {
      "subtitle_id": 285,
      "start": 652.839,
      "end": 656.6,
      "text": "एक बेहतरीन परफॉर्मर रहा है थ्रू आउट तो"
    },
    {
      "subtitle_id": 286,
      "start": 654.839,
      "end": 658.6,
      "text": "जैसे हमने अदानी एंटरप्राइजेस की बात की"
    },
    {
      "subtitle_id": 287,
      "start": 656.6,
      "end": 661.2,
      "text": "वैसे आप बाकी स्टॉक्स का भी एनालिसिस कर"
    },
    {
      "subtitle_id": 288,
      "start": 658.6,
      "end": 663.68,
      "text": "सकते हैं जो बीजेपी या कांग्रेस से जुड़े"
    },
    {
      "subtitle_id": 289,
      "start": 661.2,
      "end": 665.88,
      "text": "हो बट कंडीशन ये कि वो स्टॉक्स ऐसे हो"
    },
    {
      "subtitle_id": 290,
      "start": 663.68,
      "end": 667.399,
      "text": "जिनका उन पार्टी से ज्यादा लेना देना हो"
    },
    {
      "subtitle_id": 291,
      "start": 665.88,
      "end": 669.88,
      "text": "जिसकी वजह से अगर वो पार्टी आती है तो"
    },
    {
      "subtitle_id": 292,
      "start": 667.399,
      "end": 671.8,
      "text": "स्टॉक अप जाए नहीं आती तो डाउन जाए इस तरह"
    },
    {
      "subtitle_id": 293,
      "start": 669.88,
      "end": 674.079,
      "text": "की अगर चीजें रहे तो आप और इस तरह के"
    },
    {
      "subtitle_id": 294,
      "start": 671.8,
      "end": 675.76,
      "text": "स्टॉक्स एनालाइज कर सकते हो यहां पर एक और"
    },
    {
      "subtitle_id": 295,
      "start": 674.079,
      "end": 677.56,
      "text": "डेटा पॉइंट है जिसका आप एनालिसिस कर सकते"
    },
    {
      "subtitle_id": 296,
      "start": 675.76,
      "end": 679.36,
      "text": "हो फि वो डेटा पॉइंट है कि एग्जिट डे से"
    },
    {
      "subtitle_id": 297,
      "start": 677.56,
      "end": 682.36,
      "text": "एक दो दिन पहले की टाइमलाइन ले लीजिए आप"
    },
    {
      "subtitle_id": 298,
      "start": 679.36,
      "end": 683.92,
      "text": "जैसे एग्जिट पोल आपका मान लीजिए 5 तारीख"
    },
    {
      "subtitle_id": 299,
      "start": 682.36,
      "end": 686.12,
      "text": "को आ रहा है तो आप 3 तारीख पकड़ लीजिए और"
    },
    {
      "subtitle_id": 300,
      "start": 683.92,
      "end": 687.88,
      "text": "रिजल्ट आ र है 15 तारीख को तो न से 15 के"
    },
    {
      "subtitle_id": 301,
      "start": 686.12,
      "end": 690.2,
      "text": "बीच शेयर प्राइसेस ने कैसे परफॉर्म किया"
    },
    {
      "subtitle_id": 302,
      "start": 687.88,
      "end": 692.16,
      "text": "है अलग-अलग इंडेक्सेस में अलग-अलग स्टॉक्स"
    },
    {
      "subtitle_id": 303,
      "start": 690.2,
      "end": 694.04,
      "text": "में उसका आप एनालिसिस कर सकते हैं स्टॉक"
    },
    {
      "subtitle_id": 304,
      "start": 692.16,
      "end": 696.8,
      "text": "ऐसे ही लीजिए इलेक्शन टाइम में जो पार्टी"
    },
    {
      "subtitle_id": 305,
      "start": 694.04,
      "end": 698.8,
      "text": "से रिलेटेड हो जनरल स्टॉक्स ना हो उस तरह"
    },
    {
      "subtitle_id": 306,
      "start": 696.8,
      "end": 700.2,
      "text": "से आप थोड़ा और डीप जा सकते हैं तो आशा"
    },
    {
      "subtitle_id": 307,
      "start": 698.8,
      "end": 702.48,
      "text": "करता हूं इस डेटा से आपको काफी कुछ"
    },
    {
      "subtitle_id": 308,
      "start": 700.2,
      "end": 704.16,
      "text": "क्लेरिटी आ गई होगी कि जनरली इलेक्शन टाइम"
    },
    {
      "subtitle_id": 309,
      "start": 702.48,
      "end": 705.959,
      "text": "में मार्केट किस तरह से परफॉर्म करता है"
    },
    {
      "subtitle_id": 310,
      "start": 704.16,
      "end": 707.56,
      "text": "इस डाटा की मदद से आप क्या प्लान कर रहे"
    },
    {
      "subtitle_id": 311,
      "start": 705.959,
      "end": 709.639,
      "text": "हो नीचे कमेंट करके जरूर बताएं और"
    },
    {
      "subtitle_id": 312,
      "start": 707.56,
      "end": 712.12,
      "text": "जाते-जाते गैप अप बाय ी को जरूर चेक आउट"
    },
    {
      "subtitle_id": 313,
      "start": 709.639,
      "end": 712.12,
      "text": "कीजिए उनके"
    },
    {
      "subtitle_id": 314,
      "start": 719.2,
      "end": 723.72,
      "text": "मिते अगले वीडियो में थैंक यू सो मच फॉर"
    },
    {
      "subtitle_id": 315,
      "start": 720.639,
      "end": 723.72,
      "text": "वाचिंग दिस वीडियो"
    }
  ]
}