  "segments": [
    {
      "subtitle_id": 1,
      "start": 0.32,
      "end": 3.84,
      "text": "जब भी हमसे कोई पूछता है कि भारत का सबसे"
    },
    {
      "subtitle_id": 2,
      "start": 2.159,
      "end": 6.04,
      "text": "महंगा स्टॉक कौन सा है हमारी मुंह से"
    },
    {
      "subtitle_id": 3,
      "start": 3.84,
      "end": 7.64,
      "text": "तुरंत जवाब आता है एमआर ₹1 लाख के ऊपर की"
    },
    {
      "subtitle_id": 4,
      "start": 6.04,
      "end": 9.639,
      "text": "जो शेयर प्राइस है लेकिन अब ये जवाब बदल"
    },
    {
      "subtitle_id": 5,
      "start": 7.64,
      "end": 11.599,
      "text": "गया है और बहुत इंटरेस्टिंग तरीके से बदल"
    },
    {
      "subtitle_id": 6,
      "start": 9.639,
      "end": 14.28,
      "text": "गया है अब जवाब है एलसीडी इन्वेस्टमेंट"
    },
    {
      "subtitle_id": 7,
      "start": 11.599,
      "end": 16.119,
      "text": "जिसकी करंट शेयर प्राइस ₹ 36000 है तो"
    },
    {
      "subtitle_id": 8,
      "start": 14.28,
      "end": 17.76,
      "text": "अगेन दूसरा सवाल आता है कि क्या इस स्टॉक"
    },
    {
      "subtitle_id": 9,
      "start": 16.119,
      "end": 19.68,
      "text": "ने पिछले एक दो दिन में ही एमआरएफ को बीट"
    },
    {
      "subtitle_id": 10,
      "start": 17.76,
      "end": 21.76,
      "text": "किया है यस एक दो दिन में यानी कि क्या"
    },
    {
      "subtitle_id": 11,
      "start": 19.68,
      "end": 23.76,
      "text": "उसने एक दो दिन में ही 100% से ज्यादा के"
    },
    {
      "subtitle_id": 12,
      "start": 21.76,
      "end": 26.199,
      "text": "रिटर्न्स दिए जवाब है नहीं इस स्टॉक ने एक"
    },
    {
      "subtitle_id": 13,
      "start": 23.76,
      "end": 27.84,
      "text": "दिन में 100% नहीं बल्कि"
    },
    {
      "subtitle_id": 14,
      "start": 26.199,
      "end": 30.599,
      "text": "6692"
    },
    {
      "subtitle_id": 15,
      "start": 27.84,
      "end": 32.8,
      "text": "535 के रिटर्न्स दिए सिर्फ और सिर्फ एक"
    },
    {
      "subtitle_id": 16,
      "start": 30.599,
      "end": 35.44,
      "text": "दिन में यानी कि 1 दिन में ₹ से ये स्टॉक"
    },
    {
      "subtitle_id": 17,
      "start": 32.8,
      "end": 35.44,
      "text": "सीधा चला गया"
    },
    {
      "subtitle_id": 18,
      "start": 36.8,
      "end": 43.079,
      "text": "₹2500000 के शेयर्स होते तो उसकी वैल्यू"
    },
    {
      "subtitle_id": 19,
      "start": 39.68,
      "end": 44.879,
      "text": "एक दिन में बन जाती ₹ 70 करोड़ अब देखिए"
    },
    {
      "subtitle_id": 20,
      "start": 43.079,
      "end": 46.68,
      "text": "ये जो चीजें मैंने बताई उसमें कुछ सस्पेंस"
    },
    {
      "subtitle_id": 21,
      "start": 44.879,
      "end": 49.079,
      "text": "भी है ये कुछ उतना ही आसान नहीं है कि कोई"
    },
    {
      "subtitle_id": 22,
      "start": 46.68,
      "end": 51.48,
      "text": "भी इसमें पैसा बना लेता थोड़ी कुछ इसमें"
    },
    {
      "subtitle_id": 23,
      "start": 49.079,
      "end": 53.16,
      "text": "कॉम्प्लेक्टेड जरूरी है क्योंकि ये कोई आम"
    },
    {
      "subtitle_id": 24,
      "start": 51.48,
      "end": 54.96,
      "text": "कंपनी नहीं है ये एक होल्डिंग कंपनी है"
    },
    {
      "subtitle_id": 25,
      "start": 53.16,
      "end": 56.44,
      "text": "जिसका स्ट्रक्चर अलग है जिसका काम करने का"
    },
    {
      "subtitle_id": 26,
      "start": 54.96,
      "end": 58.0,
      "text": "तरीका अलग है और जिसमें काफी कुछ"
    },
    {
      "subtitle_id": 27,
      "start": 56.44,
      "end": 59.44,
      "text": "कॉम्प्लेक्शन भी है तो आज के इस वीडियो"
    },
    {
      "subtitle_id": 28,
      "start": 58.0,
      "end": 60.719,
      "text": "में हम बात करेंगे कि एलसीडी इन्वेस्टमेंट"
    },
    {
      "subtitle_id": 29,
      "start": 59.44,
      "end": 62.039,
      "text": "के बारे में ऐसा क्या हुआ कि इसकी शेयर"
    },
    {
      "subtitle_id": 30,
      "start": 60.719,
      "end": 65.479,
      "text": "प्राइस अचानक से इतनी ज्यादा बढ़ गई"
    },
    {
      "subtitle_id": 31,
      "start": 62.039,
      "end": 67.28,
      "text": "क्योंकि ये अकेला ऐसा स्टॉक है जिसकी शेयर"
    },
    {
      "subtitle_id": 32,
      "start": 65.479,
      "end": 69.439,
      "text": "प्राइस इंडियन शेयर मार्केट की हिस्ट्री"
    },
    {
      "subtitle_id": 33,
      "start": 67.28,
      "end": 71.56,
      "text": "में एक दिन में इतनी ज्यादा बड़ी है अकेला"
    },
    {
      "subtitle_id": 34,
      "start": 69.439,
      "end": 73.439,
      "text": "और इसके पीछे जो मेन कारण है वो कोई"
    },
    {
      "subtitle_id": 35,
      "start": 71.56,
      "end": 75.159,
      "text": "इन्वेस्टर्स नहीं है वो है सेबी जो कि"
    },
    {
      "subtitle_id": 36,
      "start": 73.439,
      "end": 76.96,
      "text": "हमारा सिक्योरिटीज मार्केट रेगुलेटर है तो"
    },
    {
      "subtitle_id": 37,
      "start": 75.159,
      "end": 78.72,
      "text": "सेबी ने ऐसा क्या किया कि ये सारी"
    },
    {
      "subtitle_id": 38,
      "start": 76.96,
      "end": 80.36,
      "text": "प्राइसेस इतनी ज्यादा बढ़ गई सो बहुत सारी"
    },
    {
      "subtitle_id": 39,
      "start": 78.72,
      "end": 82.36,
      "text": "इंटरेस्टिंग चीजें आज आपको पता चलने वाली"
    },
    {
      "subtitle_id": 40,
      "start": 80.36,
      "end": 84.36,
      "text": "है सेबी के बारे में एक्सचेंज के बारे में"
    },
    {
      "subtitle_id": 41,
      "start": 82.36,
      "end": 86.2,
      "text": "एलसीडी जैसी कंपनीज के बारे में और आखिर"
    },
    {
      "subtitle_id": 42,
      "start": 84.36,
      "end": 88.04,
      "text": "में यह भी बात करेंगे कि क्या आप अभी भी"
    },
    {
      "subtitle_id": 43,
      "start": 86.2,
      "end": 89.439,
      "text": "इस तरह के अपॉर्चुनिटी ढूंढ सकते हैं जहां"
    },
    {
      "subtitle_id": 44,
      "start": 88.04,
      "end": 91.36,
      "text": "पर एक दिन में इतने क्रेजी रिटर्न्स बन"
    },
    {
      "subtitle_id": 45,
      "start": 89.439,
      "end": 92.88,
      "text": "सकते हैं तो तो जवाब है हां लेकिन रास्ता"
    },
    {
      "subtitle_id": 46,
      "start": 91.36,
      "end": 94.2,
      "text": "मुश्किल है डिफिकल्ट है तो आज के इस"
    },
    {
      "subtitle_id": 47,
      "start": 92.88,
      "end": 96.079,
      "text": "वीडियो में इन सारी चीजों के बारे में हम"
    },
    {
      "subtitle_id": 48,
      "start": 94.2,
      "end": 97.52,
      "text": "बात करेंगे नमस्कार मैं प्रसाद आपका आज के"
    },
    {
      "subtitle_id": 49,
      "start": 96.079,
      "end": 98.84,
      "text": "इस वीडियो में स्वागत करता हूं देखिए"
    },
    {
      "subtitle_id": 50,
      "start": 97.52,
      "end": 100.96,
      "text": "एलसीडी के बारे में मैंने बहुत पहले"
    },
    {
      "subtitle_id": 51,
      "start": 98.84,
      "end": 102.799,
      "text": "वीडियो बनाया था जब हमारा चैनल काफी छोटा"
    },
    {
      "subtitle_id": 52,
      "start": 100.96,
      "end": 104.28,
      "text": "हुआ करता था और आप में से मुझे लगता है"
    },
    {
      "subtitle_id": 53,
      "start": 102.799,
      "end": 105.84,
      "text": "काफी सारे लोग होंगे जिन्होंने उस टाइम भी"
    },
    {
      "subtitle_id": 54,
      "start": 104.28,
      "end": 107.799,
      "text": "वीडियोस देखी होगी जिन-जिन लोगों ने देखी"
    },
    {
      "subtitle_id": 55,
      "start": 105.84,
      "end": 110.36,
      "text": "थी नीचे कमेंट करके जरूर बताइए ताकि मुझे"
    },
    {
      "subtitle_id": 56,
      "start": 107.799,
      "end": 112.2,
      "text": "पता चले कि कौन-कौन फिनो फैमिली के काफी"
    },
    {
      "subtitle_id": 57,
      "start": 110.36,
      "end": 114.0,
      "text": "पुराने सब्सक्राइबर्स हैं उस वीडियो में"
    },
    {
      "subtitle_id": 58,
      "start": 112.2,
      "end": 116.88,
      "text": "मैंने बताया था कि ये जो कंपनी है इसके"
    },
    {
      "subtitle_id": 59,
      "start": 114.0,
      "end": 118.28,
      "text": "पास 2.95 पर का स्टेक है एयन पेंट का छोटी"
    },
    {
      "subtitle_id": 60,
      "start": 116.88,
      "end": 120.52,
      "text": "सी कंपनी है मतलब कुछ ही दिनों पहले"
    },
    {
      "subtitle_id": 61,
      "start": 118.28,
      "end": 122.52,
      "text": "एलसीडी का जो मार्केट कैप के बराबर था"
    },
    {
      "subtitle_id": 62,
      "start": 120.52,
      "end": 125.079,
      "text": "लेकिन उसके पास जो एशियन पेन का स्टेक था"
    },
    {
      "subtitle_id": 63,
      "start": 122.52,
      "end": 127.2,
      "text": "2.95 का उसकी वैल्यू 8000 करोड़ से भी"
    },
    {
      "subtitle_id": 64,
      "start": 125.079,
      "end": 129.08,
      "text": "ज्यादा थी मतलब है तो सवाल ये आता था कि"
    },
    {
      "subtitle_id": 65,
      "start": 127.2,
      "end": 130.84,
      "text": "एक कंपनी जिसके बास 8000 करोड़ के शेयर्स"
    },
    {
      "subtitle_id": 66,
      "start": 129.08,
      "end": 132.48,
      "text": "हैं वो 10 करोड़ से भी कम मार्केट कैप पर"
    },
    {
      "subtitle_id": 67,
      "start": 130.84,
      "end": 135.12,
      "text": "कैसे ट्रेड हो रही है तो उसके पीछे कारण"
    },
    {
      "subtitle_id": 68,
      "start": 132.48,
      "end": 136.68,
      "text": "यह था कि लिक्विडिटी नहीं थी बाय सिल्क ₹"
    },
    {
      "subtitle_id": 69,
      "start": 135.12,
      "end": 138.28,
      "text": "पर ये शेयर पड़ा हुआ था कोई मतलब"
    },
    {
      "subtitle_id": 70,
      "start": 136.68,
      "end": 140.16,
      "text": "लिक्विडिटी नहीं थी कोई बेचने को तैयार"
    },
    {
      "subtitle_id": 71,
      "start": 138.28,
      "end": 142.56,
      "text": "नहीं था बिकॉज़ यू नो जिस कंपनी की फेयर"
    },
    {
      "subtitle_id": 72,
      "start": 140.16,
      "end": 144.36,
      "text": "वैल्यू नहीं कुछ तो कम से कम 45000 करोड़"
    },
    {
      "subtitle_id": 73,
      "start": 142.56,
      "end": 146.0,
      "text": "के करीब आती है उस उन शेयर्स को कोई 10"
    },
    {
      "subtitle_id": 74,
      "start": 144.36,
      "end": 147.36,
      "text": "करोड़ के कम वैल्यूएशन पर कैसे बेचे तो"
    },
    {
      "subtitle_id": 75,
      "start": 146.0,
      "end": 149.4,
      "text": "लोगों ने सोचा कभी ना कभी इसकी शेयर"
    },
    {
      "subtitle_id": 76,
      "start": 147.36,
      "end": 152.08,
      "text": "प्राइस बढ़ेगी तो वेट करते रहे वेट करते"
    },
    {
      "subtitle_id": 77,
      "start": 149.4,
      "end": 153.4,
      "text": "रहे आखिरकार सही समय आ गया जब सेबी ने एक"
    },
    {
      "subtitle_id": 78,
      "start": 152.08,
      "end": 154.76,
      "text": "एक्शन यहां पर मैं आपको एलसीडी"
    },
    {
      "subtitle_id": 79,
      "start": 153.4,
      "end": 156.519,
      "text": "इन्वेस्टमेंट के बारे में कुछ बताना चाहता"
    },
    {
      "subtitle_id": 80,
      "start": 154.76,
      "end": 158.72,
      "text": "हूं ये एक एनबीएफसी कंपनी है आरबीआई से"
    },
    {
      "subtitle_id": 81,
      "start": 156.519,
      "end": 160.68,
      "text": "रजिस्टर्ड लेकिन ये एक होल्डिंग कंपनी है"
    },
    {
      "subtitle_id": 82,
      "start": 158.72,
      "end": 162.239,
      "text": "यानी इस कंपनी के पास अलग-अलग कंपनीज के"
    },
    {
      "subtitle_id": 83,
      "start": 160.68,
      "end": 164.04,
      "text": "शेयर्स हैं तो यहां पर कंपनी का जो मेन"
    },
    {
      "subtitle_id": 84,
      "start": 162.239,
      "end": 166.239,
      "text": "रिवेन्यू आता है डिविडेंड वगैरह से आता है"
    },
    {
      "subtitle_id": 85,
      "start": 164.04,
      "end": 168.56,
      "text": "अपने आप में कंपनी कोई कोई भी बिजनेस नहीं"
    },
    {
      "subtitle_id": 86,
      "start": 166.239,
      "end": 170.68,
      "text": "है यहां पर आप देखेंगे फिर भी अ क्योंकि"
    },
    {
      "subtitle_id": 87,
      "start": 168.56,
      "end": 173.2,
      "text": "जो अंडरलाइन कंपनी एयन पेंट्स एंड ऑल दे"
    },
    {
      "subtitle_id": 88,
      "start": 170.68,
      "end": 174.84,
      "text": "आर परफॉर्मिंग रियली रियली वेल जिसके चलते"
    },
    {
      "subtitle_id": 89,
      "start": 173.2,
      "end": 176.0,
      "text": "कंपनी की जो परफॉर्मेंस है रेवेन्यू"
    },
    {
      "subtitle_id": 90,
      "start": 174.84,
      "end": 178.879,
      "text": "प्रॉफिट में वो काफी अच्छी रही है"
    },
    {
      "subtitle_id": 91,
      "start": 176.0,
      "end": 180.64,
      "text": "कंपाउंडेड सांड 26 पर का रेवेन्यू है"
    },
    {
      "subtitle_id": 92,
      "start": 178.879,
      "end": 182.8,
      "text": "कंपनी का पिछले 10 10 साल में और कंपाउंड"
    },
    {
      "subtitle_id": 93,
      "start": 180.64,
      "end": 184.799,
      "text": "सालना 23 पर की प्रॉफिट में ग्रोथ है"
    },
    {
      "subtitle_id": 94,
      "start": 182.8,
      "end": 186.959,
      "text": "व्हिच इज रियली आउटस्टैंडिंग यहां पर आप"
    },
    {
      "subtitle_id": 95,
      "start": 184.799,
      "end": 188.36,
      "text": "देखेंगे तो कंपनी के पास 12000 करोड़ की"
    },
    {
      "subtitle_id": 96,
      "start": 186.959,
