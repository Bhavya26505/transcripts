      "start": 384.08,
      "end": 387.8,
      "text": "करवाई कि चलो इसकी नई फेयर प्राइस फिगर"
    },
    {
      "subtitle_id": 194,
      "start": 386.0,
      "end": 389.759,
      "text": "आउट करते हैं और यह जो कॉल ऑक्शन होगा"
    },
    {
      "subtitle_id": 195,
      "start": 387.8,
      "end": 391.039,
      "text": "इसकी खासियत यह थी कि यहां पर कोई अपर"
    },
    {
      "subtitle_id": 196,
      "start": 389.759,
      "end": 392.68,
      "text": "लोअर सर्किट नहीं रहेगा यहां पर जो भी"
    },
    {
      "subtitle_id": 197,
      "start": 391.039,
      "end": 394.44,
      "text": "प्राइस डिस्कवर होगी जो भी प्राइस पर लोग"
    },
    {
      "subtitle_id": 198,
      "start": 392.68,
      "end": 396.199,
      "text": "बाय करेंगे वही प्राइस फाइनल प्राइस पकड़"
    },
    {
      "subtitle_id": 199,
      "start": 394.44,
      "end": 397.8,
      "text": "के हम आगे चलेंगे तो वही कॉल ऑक्शन शुरू"
    },
    {
      "subtitle_id": 200,
      "start": 396.199,
      "end": 400.0,
      "text": "हो गया लोगों ने बहुत बड़े-बड़े ट्रेड्स"
    },
    {
      "subtitle_id": 201,
      "start": 397.8,
      "end": 401.68,
      "text": "मारे कुछ-कुछ ने तो 4-4 लाख पर भी शेयर्स"
    },
    {
      "subtitle_id": 202,
      "start": 400.0,
      "end": 404.16,
      "text": "खरीदने की बोली लगाई लेकिन एक्चुअल में जो"
    },
    {
      "subtitle_id": 203,
      "start": 401.68,
      "end": 406.36,
      "text": "प्राइस डिस्क हुई वो हुई ₹ लाख की और उसी"
    },
    {
      "subtitle_id": 204,
      "start": 404.16,
      "end": 409.24,
      "text": "पर फिर ये शेयर्स लिस्ट हो गए और फिर अगले"
    },
    {
      "subtitle_id": 205,
      "start": 406.36,
      "end": 412.199,
      "text": "दिन 236000 पर और शेयर की प्राइस 45 पर से"
    },
    {
      "subtitle_id": 206,
      "start": 409.24,
      "end": 413.68,
      "text": "बढ़कर फिर शेयर प्राइस 236000 पर चले गई"
    },
    {
      "subtitle_id": 207,
      "start": 412.199,
      "end": 415.24,
      "text": "लेकिन पॉइंट ये है कि होल्डिंग कंपनी"
    },
    {
      "subtitle_id": 208,
      "start": 413.68,
      "end": 418.0,
      "text": "जनरली थोड़े डिस्काउंट पर चलती है बहुत"
    },
    {
      "subtitle_id": 209,
      "start": 415.24,
      "end": 419.639,
      "text": "सारे लोग चाहते हैं कि एलसीडी को चलो 225"
    },
    {
      "subtitle_id": 210,
      "start": 418.0,
      "end": 421.8,
      "text": "हो इस पर भी हम खरीद लेते हैं क्योंकि"
    },
    {
      "subtitle_id": 211,
      "start": 419.639,
      "end": 423.8,
      "text": "इनके पास 8500 करोड़ के शेयर्स हैं एन पट"
    },
    {
      "subtitle_id": 212,
      "start": 421.8,
      "end": 425.039,
      "text": "के और अदर इन्वेस्टमेंट्स भी है 34000"
    },
    {
      "subtitle_id": 213,
      "start": 423.8,
      "end": 426.56,
      "text": "करोड़ के टोटल 12000 करोड़ के"
    },
    {
      "subtitle_id": 214,
      "start": 425.039,
      "end": 428.039,
      "text": "इन्वेस्टमेंट्स हैं आप अगर इसकी बैलेंस"
    },
    {
      "subtitle_id": 215,
      "start": 426.56,
      "end": 429.919,
      "text": "शीट में देखेंगे तो कोई बरो इंग नहीं है"
    },
    {
      "subtitle_id": 216,
      "start": 428.039,
      "end": 432.84,
      "text": "कर्जा वगैरह कुछ नहीं है और करंट मार्केट"
    },
    {
      "subtitle_id": 217,
      "start": 429.919,
      "end": 435.28,
      "text": "कैप अगर आप देखेंगे तो 4700 का है तो"
    },
    {
      "subtitle_id": 218,
      "start": 432.84,
      "end": 437.039,
      "text": "कंपनी की बुक वैल्यू को देखा जाए तो 56000"
    },
    {
      "subtitle_id": 219,
      "start": 435.28,
      "end": 437.84,
      "text": "करोड़ की बुक वैल्यू है और कंपनी आपको मिल"
    },
    {
      "subtitle_id": 220,
      "start": 437.039,
      "end": 440.8,
      "text": "रही है"
    },
    {
      "subtitle_id": 221,
      "start": 437.84,
      "end": 442.24,
      "text": "4725 करोड़ में तो लोगों ने सोचा कि चलो"
    },
    {
      "subtitle_id": 222,
      "start": 440.8,
      "end": 444.96,
      "text": "यहां पर भी थोड़ा बहुत डिस्काउंट है तो"
    },
    {
      "subtitle_id": 223,
      "start": 442.24,
      "end": 446.919,
      "text": "लेट्स यू नो कैपिट आइज ऑन दैट लेकिन अभी"
    },
    {
      "subtitle_id": 224,
      "start": 444.96,
      "end": 448.919,
      "text": "भी प्रॉब्लम यह है कि अभी भी आज की डेट"
    },
    {
      "subtitle_id": 225,
      "start": 446.919,
      "end": 450.96,
      "text": "में मतलब जब मैं ये वीडियो शूट कर रहा हूं"
    },
    {
      "subtitle_id": 226,
      "start": 448.919,
      "end": 452.919,
      "text": "सो आज की आज की डेट में कोई यहां पर बाइंग"
    },
    {
      "subtitle_id": 227,
      "start": 450.96,
      "end": 455.12,
      "text": "नहीं हुई लास्ट बाइंग जो हुई है वो 29th"
    },
    {
      "subtitle_id": 228,
      "start": 452.919,
      "end": 456.759,
      "text": "अक्टूबर को हुई है जब 18 से शेयर प्राइस"
    },
    {
      "subtitle_id": 229,
      "start": 455.12,
      "end": 458.96,
      "text": "बढ़ी है उसके बाद शेयर प्राइस नहीं बढ़ी"
    },
    {
      "subtitle_id": 230,
      "start": 456.759,
      "end": 461.28,
      "text": "तो अभी भी इस कॉल ऑक्शन के बाद भी"
    },
    {
      "subtitle_id": 231,
      "start": 458.96,
      "end": 463.12,
      "text": "प्रॉब्लम जैसा का वैसा है लेकिन अच्छी बात"
    },
    {
      "subtitle_id": 232,
      "start": 461.28,
      "end": 465.28,
      "text": "ये है जो सेलर्स हैं वो कंसीडर कर सकते"
    },
    {
      "subtitle_id": 233,
      "start": 463.12,
      "end": 467.159,
      "text": "हैं कि चलो यार बहुत 10 सालों से हम फंसे"
    },
    {
      "subtitle_id": 234,
      "start": 465.28,
      "end": 469.0,
      "text": "पड़े बेचना है तो आप बेच के निकल सकते हैं"
    },
    {
      "subtitle_id": 235,
      "start": 467.159,
      "end": 471.199,
      "text": "तो धीरे-धीरे थोड़ी बहुत लिक्विडिटी आएगी"
    },
    {
      "subtitle_id": 236,
      "start": 469.0,
      "end": 472.759,
      "text": "लेकिन सेबी का इनिशिएटिव है तो कुछ कंपनीज"
    },
    {
      "subtitle_id": 237,
      "start": 471.199,
      "end": 474.52,
      "text": "के काम में जरूरी आएगा तो ऑनलाइन में देख"
    },
    {
      "subtitle_id": 238,
      "start": 472.759,
      "end": 476.08,
      "text": "रहा था कि बहुत सारी कुछ पोस्ट इसके बारे"
    },
    {
      "subtitle_id": 239,
      "start": 474.52,
      "end": 477.879,
      "text": "में चल रही थी जहां पर लोग बोल रहे थे कि"
    },
    {
      "subtitle_id": 240,
      "start": 476.08,
      "end": 479.52,
      "text": "आप एक दिन में कमा पाते थे उतना आसान"
    },
    {
      "subtitle_id": 241,
      "start": 477.879,
      "end": 480.879,
      "text": "बिल्कुल भी नहीं था इसलिए नहीं था क्योंकि"
    },
    {
      "subtitle_id": 242,
      "start": 479.52,
      "end": 482.68,
      "text": "लिक्विडिटी नहीं थी सो पीपल आर नॉट"
    },
    {
      "subtitle_id": 243,
      "start": 480.879,
      "end": 484.4,
      "text": "अंडरस्टैंडिंग कि एक लिक्विडिटी भी पार्ट"
    },
    {
      "subtitle_id": 244,
      "start": 482.68,
      "end": 485.96,
      "text": "होता है कि बायर सेलर सेलर अवेलेबल नहीं"
    },
    {
      "subtitle_id": 245,
      "start": 484.4,
      "end": 487.28,
      "text": "है तो शेयर्स बाय कैसे होंगे विलिंग्स"
    },
    {
      "subtitle_id": 246,
      "start": 485.96,
      "end": 489.08,
      "text": "आपकी है खरीदने की बेचने वाला तैयार ही"
    },
    {
      "subtitle_id": 247,
      "start": 487.28,
      "end": 492.0,
      "text": "नहीं ₹ की क्यों बेचेगा वो जब वो शेयर की"
    },
    {
      "subtitle_id": 248,
      "start": 489.08,
      "end": 493.96,
      "text": "फेयर प्राइस नहीं कुछ तो 4 45 5 लाख पर"
    },
    {
      "subtitle_id": 249,
      "start": 492.0,
      "end": 496.159,
      "text": "शेयर के करीब आती है तब जाके आपका मार्केट"
    },
    {
      "subtitle_id": 250,
      "start": 493.96,
      "end": 497.52,
      "text": "कैप कंपनी का 78000 करोड़ के करीब चला"
    },
    {
      "subtitle_id": 251,
      "start": 496.159,
      "end": 499.199,
      "text": "जाएगा अब अगला सवाल ये आता है कि क्या"
    },
    {
      "subtitle_id": 252,
      "start": 497.52,
      "end": 501.36,
      "text": "एलसीडी जैसे अदर अपॉर्चुनिटी भी मार्केट"
    },
    {
      "subtitle_id": 253,
      "start": 499.199,
      "end": 503.44,
      "text": "में है देयर आर एलसीडी जैसे और भी कई सारी"
    },
    {
      "subtitle_id": 254,
      "start": 501.36,
      "end": 505.8,
      "text": "कंपनीज आपको मिलेगी जहां पर सिमिलर तरीके"
    },
    {
      "subtitle_id": 255,
      "start": 503.44,
      "end": 507.639,
      "text": "की सिचुएशन जहां पर उनकी फेयर प्राइस बहुत"
    },
    {
      "subtitle_id": 256,
      "start": 505.8,
      "end": 509.879,
      "text": "ज्यादा है लेकिन मार्केट कैप बहुत कम है"
    },
    {
      "subtitle_id": 257,
      "start": 507.639,
      "end": 511.319,
      "text": "खरीदना आप चाहोगे आपको पता है की वैल्यू"
    },
    {
      "subtitle_id": 258,
      "start": 509.879,
      "end": 512.839,
      "text": "बहुत ज्यादा है कंपनी में लेकिन बेचने"
    },
    {
      "subtitle_id": 259,
      "start": 511.319,
      "end": 514.919,
      "text": "वाला कोई नहीं तो सेबी धीरे-धीरे उन"
    },
    {
      "subtitle_id": 260,
      "start": 512.839,
      "end": 516.76,
      "text": "कंपनीज को भी टारगेट करके कॉल ऑक्शन करके"
    },
    {
      "subtitle_id": 261,
      "start": 514.919,
      "end": 518.36,
      "text": "उनकी फेयर प्राइस निकालने की कोशिश करेगा"
    },
    {
      "subtitle_id": 262,
      "start": 516.76,
      "end": 520.279,
      "text": "ये जो कंपनीज होती हैं जनरली फिगर आउट"
    },
    {
      "subtitle_id": 263,
      "start": 518.36,
      "end": 522.0,
      "text": "करते हैं पल फार्मिंग अप्रोच के जरिए जहां"
    },
    {
      "subtitle_id": 264,
      "start": 520.279,
      "end": 523.64,
      "text": "पर कंपनी के हिडन एसेट्स बहुत ज्यादा होते"
    },
    {
      "subtitle_id": 265,
      "start": 522.0,
      "end": 525.68,
      "text": "हैं वहीं पर कंपनी का मार्केट कैप के"
    },
    {
      "subtitle_id": 266,
      "start": 523.64,
      "end": 527.76,
      "text": "एसेट्स के कंपेरटिवली बहुत कम होता है और"
    },
    {
      "subtitle_id": 267,
      "start": 525.68,
      "end": 529.72,
      "text": "ये सारी चीजें हमने अपने फंडामेंटल 2.0"
    },
    {
      "subtitle_id": 268,
      "start": 527.76,
      "end": 531.399,
      "text": "में कवर की है तो उसे सीखने का बहुत ही"
    },
    {
      "subtitle_id": 269,
      "start": 529.72,
      "end": 532.92,
      "text": "सही टाइम है क्योंकि अभी हमारी दिवाली ऑफर"
    },
    {
      "subtitle_id": 270,
      "start": 531.399,
      "end": 535.76,
      "text": "चल रही है जहां पर हमारा स्टॉक मार्केट"
    },
    {
      "subtitle_id": 271,
      "start": 532.92,
      "end": 538.64,
      "text": "फाउंडेशन प्लस फंडामेंटल एनालिसिस 2.0 ये"
    },
    {
      "subtitle_id": 272,
      "start": 535.76,
      "end": 540.04,
      "text": "जो कॉन्बो है ये आपको फ्लैट 50 पर ऑफ में"
    },
    {
      "subtitle_id": 273,
      "start": 538.64,
      "end": 541.6,
      "text": "मिल रहा है इस दिवाली में में तो इस ऑफर"
    },
    {
      "subtitle_id": 274,
      "start": 540.04,
      "end": 543.279,
      "text": "को बिल्कुल भी मिस ना करें जहां पर शेयर"
    },
    {
      "subtitle_id": 275,
      "start": 541.6,
      "end": 545.24,
      "text": "मार्केट की बेसिक से लेकर एकदम एडवांस"
    },
    {
      "subtitle_id": 276,
      "start": 543.279,
      "end": 546.839,
      "text": "लेवल तक फॉरेंसिक एनालिसिस वैल्यूएशन यानी"
    },
    {
      "subtitle_id": 277,
      "start": 545.24,
      "end": 548.519,
      "text": "कौन सा स्टॉक अंडर वैल्यूड है कौन सा ओवर"
    },
    {
      "subtitle_id": 278,
      "start": 546.839,
      "end": 550.399,
      "text": "वैल्यूड है वो फिगर आउट करना मैनेजमेंट"
    },
    {
      "subtitle_id": 279,
      "start": 548.519,
      "end": 552.279,
      "text": "एनालिसिस करना पर्ल फार्मिंग अप्रोच ये"
    },
    {
      "subtitle_id": 280,
      "start": 550.399,
      "end": 554.92,
      "text": "सारी चीजें आपको सीखने मिलेंगी फोर"
    },
    {
      "subtitle_id": 281,
      "start": 552.279,
      "end": 556.8,
      "text": "कोर्सेस को कमो सिर्फ 8994 में मिल रहा है"
    },
    {
      "subtitle_id": 282,
      "start": 554.92,
      "end": 559.12,
      "text": "जिसमें आपको फाउंडेशन कोर्स फंडामेंटल एस"
    },
    {
      "subtitle_id": 283,
      "start": 556.8,
      "end": 560.6,
      "text": "2.0 ऑप्शंस ट्रेडिंग फॉर हेजिंग और एडवांस"
    },
    {
      "subtitle_id": 284,
      "start": 559.12,
      "end": 561.959,
      "text": "म्यूचुअल फंड ये चारों कोर्सेस मिलते हैं"
    },
    {
      "subtitle_id": 285,
      "start": 560.6,
      "end": 563.839,
      "text": "विथ लाइफ टाइम एक्सेस एंड फोर"
    },
    {
      "subtitle_id": 286,
      "start": 561.959,
      "end": 565.519,
      "text": "सर्टिफिकेट्स तो इस ऑफर को बिल्कुल भी मिस"
    },
    {
      "subtitle_id": 287,
      "start": 563.839,
      "end": 567.079,
      "text": "ना होने दें क्योंकि इस दिवाली के बाद इस"
    },
    {
      "subtitle_id": 288,
      "start": 565.519,
      "end": 569.04,
      "text": "प्राइस पर आपको यह कॉम्बोस कभी नहीं"
    },
    {
      "subtitle_id": 289,
      "start": 567.079,
      "end": 570.8,
      "text": "मिलेंगे तो यह दिवाली एक बेस्ट टाइम है"
    },
    {
      "subtitle_id": 290,
      "start": 569.04,
      "end": 572.839,
      "text": "अपने शेयर मार्केट नॉलेज को अपग्रेड करने"
    },
    {
      "subtitle_id": 291,
      "start": 570.8,
      "end": 574.92,
      "text": "का और इन हॉलीडेज का सही इस्तेमाल करने का"
    },
    {
      "subtitle_id": 292,
      "start": 572.839,
      "end": 576.72,
      "text": "हमारी कंबोज आपको पूरी तरह से इंडिपेंडेंट"
    },
    {
      "subtitle_id": 293,
      "start": 574.92,
      "end": 578.32,
      "text": "बनाएंगे आत्मनिर्भर बनाएंगे ताकि आपको"
    },
    {
      "subtitle_id": 294,
      "start": 576.72,
      "end": 580.04,
      "text": "किसी पर भी डिपेंड रहने की जरूरत ही नहीं"
    },
    {
      "subtitle_id": 295,
      "start": 578.32,
      "end": 581.32,
      "text": "पड़ेगी इन कॉम्बोस के ऑफर लिंक आपको नीचे"
    },
    {
      "subtitle_id": 296,
      "start": 580.04,
      "end": 583.12,
      "text": "डिस्क्रिप्शन और कमेंट बॉक्स में मिल"
    },
    {
      "subtitle_id": 297,
      "start": 581.32,
      "end": 585.72,
      "text": "जाएगी तो अभी इस ऑफर का फायदा ले क्योंकि"
    },
    {
      "subtitle_id": 298,
      "start": 583.12,
      "end": 587.68,
      "text": "इस ऑफर के आखिरी बस तीन दिन ही बाकी है तो"
    },
    {
      "subtitle_id": 299,
      "start": 585.72,
      "end": 589.44,
      "text": "चलिए अब बढ़ते हैं वीडियो की तरफ अभी कल"
    },
    {
      "subtitle_id": 300,
      "start": 587.68,
      "end": 591.279,
      "text": "ही हमारा एक मोरे ट्रेडिंग का वीडियो गया"
    },
    {
      "subtitle_id": 301,
      "start": 589.44,
      "end": 592.959,
      "text": "मतलब मैं बहुत लंबे टाइम से इस पल"
    },
    {
      "subtitle_id": 302,
      "start": 591.279,
      "end": 595.32,
      "text": "फार्मिंग अप्रोच को फॉलो कर रहा हूं इसको"
    },
    {
      "subtitle_id": 303,
      "start": 592.959,
      "end": 597.519,
      "text": "हमने अपने फंडामेंटल सस 2.0 में भी कवर"
    },
    {
      "subtitle_id": 304,
      "start": 595.32,
      "end": 599.56,
      "text": "किया था कि हाउ टू फाइंड आउट दिस कंपनीज"
    },
    {
      "subtitle_id": 305,
      "start": 597.519,
      "end": 601.72,
      "text": "अब देखिए फेयर प्राइस कॉल ऑक्शन तो अभी"
    },
    {
      "subtitle_id": 306,
      "start": 599.56,
      "end": 603.64,
      "text": "शुरू हुआ बट वी हैव टट दिस कांसेप्ट अ"
    },
    {
      "subtitle_id": 307,
      "start": 601.72,
      "end": 605.279,
      "text": "लॉन्ग अगो और लंबे टाइम से मैं फॉलो कर"
    },
    {
      "subtitle_id": 308,
      "start": 603.64,
      "end": 607.36,
      "text": "रहा हूं तो अगर आप सही तरीके से एसेट"
    },
    {
      "subtitle_id": 309,
      "start": 605.279,
      "end": 608.959,
      "text": "एनालिसिस करते हैं किसी भी कंपनी का तो"
    },
    {
      "subtitle_id": 310,
      "start": 607.36,
      "end": 610.92,
      "text": "आपको इस तरह की अपॉर्चुनिटी मिल सकती है"
    },
    {
      "subtitle_id": 311,
      "start": 608.959,
      "end": 612.839,
      "text": "बट अगेन इतना डिस्काउंट आपको नहीं मिलेगा"
    },
    {
      "subtitle_id": 312,
      "start": 610.92,
      "end": 614.68,
      "text": "बट थोड़ा बहुत डिस्काउंट आप फिगर आउट जरूर"
    },
    {
      "subtitle_id": 313,
      "start": 612.839,
      "end": 615.959,
      "text": "कर सकते हो काफी इजली कर सकते हो उसके लिए"
    },
    {
      "subtitle_id": 314,
      "start": 614.68,
      "end": 617.68,
      "text": "आप हमारा कल का वीडियो भी देख सकते हो"
    },
    {
      "subtitle_id": 315,
      "start": 615.959,
      "end": 619.839,
      "text": "मुहर ट्रेडिंग का जहां पर मैंने बात की है"
    },
    {
      "subtitle_id": 316,
      "start": 617.68,
      "end": 621.68,
      "text": "कि कौन सी कंपनीज को मैं कंसीडर कर रहा था"
    },
    {
      "subtitle_id": 317,
      "start": 619.839,
      "end": 623.16,
      "text": "इस मुहूर ट्रेडिंग डे पर हर साल काफी"
    },
    {
      "subtitle_id": 318,
      "start": 621.68,
      "end": 624.76,
      "text": "इंटरेस्टिंग एक वीडियो रहता है ये तो उस"
    },
    {
      "subtitle_id": 319,
      "start": 623.16,
      "end": 626.399,
      "text": "वीडियो को आप यहां क्लिक करके देख सकते हो"
    },
    {
      "subtitle_id": 320,
      "start": 624.76,
      "end": 627.839,
      "text": "या फिर सिंपली आप मोहरे ट्रेडिंग फिशन"
    },
    {
      "subtitle_id": 321,
      "start": 626.399,
      "end": 629.6,
      "text": "सर्च करोगे तो भी आपको मिल जाएगा तो"
    },
    {
      "subtitle_id": 322,
      "start": 627.839,
      "end": 631.56,
      "text": "फिलहाल हम यहीं पर रुकते हैं और और मेरा"
    },
    {
      "subtitle_id": 323,
      "start": 629.6,
      "end": 633.279,
      "text": "आपके लिए एक सवाल है कि अभी भी मार्केट"
    },
    {
      "subtitle_id": 324,
      "start": 631.56,
      "end": 634.72,
      "text": "में ऐसी कुछ कंपनीज है जिनमें बहुत ज्यादा"
    },
    {
      "subtitle_id": 325,
      "start": 633.279,
      "end": 636.16,
      "text": "डिस्काउंट है लेकिन वहां पर लिक्विडिटी"
    },
    {
      "subtitle_id": 326,
      "start": 634.72,
      "end": 637.8,
      "text": "नहीं है तो मुझे बस पता करना है कि क्या"
    },
    {
      "subtitle_id": 327,
      "start": 636.16,
      "end": 639.639,
      "text": "आप में से किसी को उन कंपनीज के बारे में"
    },
    {
      "subtitle_id": 328,
      "start": 637.8,
      "end": 641.2,
      "text": "पता है पता है तो कमेंट करके जरूर बताइए"
    },
    {
      "subtitle_id": 329,
      "start": 639.639,
      "end": 642.56,
      "text": "तो ये आपके लिए क्विज है एक असाइनमेंट है"
    },
    {
      "subtitle_id": 330,
      "start": 641.2,
      "end": 643.8,
      "text": "मिलते हैं अगली वीडियो में थैंक यू सो मच"
    },
    {
      "subtitle_id": 331,
      "start": 642.56,
      "end": 645.32,
      "text": "फॉर वाचिंग दिस वीडियो अगर आप शेयर"
    },
    {
      "subtitle_id": 332,
      "start": 643.8,
      "end": 647.079,
      "text": "मार्केट में बहुत इंटरेस्ट रखते हैं रुचि"
    },
    {
      "subtitle_id": 333,
      "start": 645.32,
      "end": 648.8,
      "text": "रखते हैं तो चैनल को जरूर सब्सक्राइब"
    },
    {
      "subtitle_id": 334,
      "start": 647.079,
      "end": 650.12,
      "text": "कीजिए और बेल आइकन पर भी क्लिक कीजिए"
    },
    {
      "subtitle_id": 335,
      "start": 648.8,
      "end": 651.92,
      "text": "क्योंकि शेयर मार्केट से जुड़े सारे"
    },
    {
      "subtitle_id": 336,
      "start": 650.12,
      "end": 653.24,
      "text": "वैल्युएबल वीडियोस आपको फिनो शस पर मिल"
    },
    {
      "subtitle_id": 337,
      "start": 651.92,
      "end": 655.079,
      "text": "जाएंगे मिलते हैं अगली वीडियो में थैंक यू"
    },
    {
      "subtitle_id": 338,
      "start": 653.24,
      "end": 657.92,
      "text": "सो मच फॉर वाचिंग दिस एंड हैप्पी दिवाली"
    },
    {
      "subtitle_id": 339,
      "start": 655.079,
      "end": 660.32,
      "text": "टू ऑल बहुत-बहुत एंजॉय कीजिए खुश रहिए बाय"
    },
    {
      "subtitle_id": 340,
      "start": 657.92,
      "end": 660.32,
      "text": "बाय"
    }
  ]
}